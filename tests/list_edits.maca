edit_all(dst: int[]) -> int[] {
    dst = dst.insert(0, 9)
    dst = dst.set(1, 8)
    dst = dst.remove(2)

    dst
}

test_set_replaces_one_element() {
    xs = [1, 2, 3]

    assert_eq("{xs.set(1, 9).get(1)}", "9", "the middle one")
    assert_eq("{xs.set(-1, 9).get(0)}", "1", "a negative index changes nothing")
    assert_eq("{xs.set(7, 9).get(2)}", "3", "and neither does one past the end")
    assert_eq("{xs.get(1)}", "2", "the list it was asked about is untouched")
}

test_insert_shifts_the_rest_along() {
    xs = [1, 2, 3]

    assert_eq("{xs.insert(0, 9).get(0)}", "9", "at the front")
    assert_eq("{xs.insert(0, 9).get(1)}", "1", "pushing the old first along")
    assert_eq("{xs.insert(1, 9).get(1)}", "9", "in the middle")
    assert_eq("{xs.insert(3, 9).get(3)}", "9", "at the end")
    assert_eq("{xs.insert(99, 9).get(3)}", "9", "past the end is at the end")
    assert_eq("{xs.insert(-4, 9).get(0)}", "9", "before the start is at it")
    assert_eq("{xs.insert(-1, 9).get(0)}", "9", "and so is just before it")
    assert_eq("{xs.length()}", "3", "and the original did not grow")
}

test_remove_closes_the_gap() {
    xs = [1, 2, 3]

    assert_eq("{xs.remove(1).get(1)}", "3", "the middle one goes")
    assert_eq("{xs.remove(1).length()}", "2", "one shorter")
    assert_eq("{xs.remove(9).length()}", "3", "an index it does not have")
    assert_eq("{xs.remove(-1).length()}", "3", "and a negative one")
    assert_eq("{xs.length()}", "3", "the original is still whole")
}

test_a_second_holder_costs_a_copy_a_round() {
    base: int[] = []
    keep = base
    before = alloc_count() + reuse_count()
    for i in 1..201 {
        base = base.insert(0, i)
    }
    spent = alloc_count() + reuse_count() - before

    assert_eq("{base.length()}", "200", "the one written to grew")
    assert_eq("{keep.length()}", "0", "and the other name did not move")
    assert(spent > 200, "copied every round: {spent} for 200 elements")
}

test_an_edit_of_a_list_someone_else_holds_leaves_theirs_alone() {
    a = [1, 2, 3]
    b = a
    a = a.set(0, 9)
    a = a.remove(2)

    assert_eq("{a.get(0)}", "9", "the one edited was written")
    assert_eq("{a.length()}", "2", "and shortened")
    assert_eq("{b.get(0)}", "1", "the other still reads its own first")
    assert_eq("{b.length()}", "3", "and is still whole")
}

test_a_parameter_is_the_callers_list() {
    a = [1, 2, 3]
    b = edit_all(a)

    assert_eq("{b.get(0)}", "9", "the helper edited its own copy")
    assert_eq("{b.get(1)}", "8", "all three edits landed")
    assert_eq("{b.length()}", "3", "one in, one out")
    assert_eq("{a.get(0)}", "1", "and the caller's list is untouched")
    assert_eq("{a.get(2)}", "3", "all of it")
    assert_eq("{a.length()}", "3", "including its length")
}
