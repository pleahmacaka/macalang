import { conf_value } from apps/tomo/conf

Toml = """title = "The Maca Handbook"
site = "Maca"

# languages = ["fr"] was the old list
languages = ["en", "ko"]

chapters = [
    "00-introduction",
    "01-installing",
]
"""

test_a_commented_out_key_is_a_comment() {
    assert_eq(conf_value(Toml, "languages"), "en, ko",
              "the live key, not the commented-out one above it")
}

test_a_plain_value_is_unquoted() {
    assert_eq(conf_value(Toml, "title"), "The Maca Handbook", "the title")
    assert_eq(conf_value(Toml, "site"), "Maca", "the site name")
}

test_an_array_may_span_lines() {
    got = conf_value(Toml, "chapters")
    assert_eq(got, "00-introduction,01-installing",
              "gathered across lines, trailing comma dropped")
}

test_an_absent_key_is_empty() {
    assert_eq(conf_value(Toml, "playground"), "", "not in this config")
    assert_eq(conf_value("", "title"), "", "nothing to read")
}

test_a_key_is_matched_whole() {
    src = """site_name = "wrong"
site = "right"
"""
    assert_eq(conf_value(src, "site"), "right", "not the longer key above it")
}

test_the_real_book_declares_two_languages() {
    got = conf_value(read_file("apps/tomo/book.toml"), "languages")
    codes = got.split(",").map(c => c.trim()).filter(c => c != "")
    assert_eq(codes.join("|"), "en|ko", "the book ships English and Korean")
}

main() -> int => 0
