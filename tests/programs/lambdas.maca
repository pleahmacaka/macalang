Point = {
    x: int
    y: int
}

twice = (n) -> int => n * 2

origin = () -> Point => Point { x = 0, y = 0 }

shifted = (p: Point, dx: int) -> Point =>
    p with { x = p.x + dx }

test_a_top_level_lambda_is_callable() {
    assert_eq(str(twice(21)), "42", "called by name like any function")
}

test_a_top_level_lambda_can_return_a_record() {
    assert_eq(str(origin().x), "0", "and its fields are readable")
    assert_eq(str(shifted(origin(), 7).x), "7", "including through a parameter")
}

test_a_top_level_lambda_is_a_value() {
    doubled = [1, 2, 3].map(twice)

    assert_eq(doubled.map(v => str(v)).join(","), "2,4,6", "passed by name")
}

test_a_local_lambda_captures() {
    step = 10
    bump = (n) => n + step

    assert_eq(str(bump(32)), "42", "the enclosing scope came along")
}

test_a_local_lambda_can_declare_its_types() {
    join_pair = (a: int, b: int) -> str => "{a}-{b}"

    assert_eq(join_pair(4, 2), "4-2", "annotations on both ends")
}

test_a_lambda_body_can_be_a_block() {
    classify = (n) -> str => {
        doubled = n * 2
        big = doubled > 10

        big ? "big" : "small"
    }

    assert_eq(classify(6), "big", "two statements and a value")
    assert_eq(classify(2), "small", "the other branch")
}

test_a_closure_can_return_a_record() {
    make = (n) => (Point { x = n, y = 0 })

    assert_eq(str(make(9).x), "9", "the record survives the call boundary")
}

test_a_closure_can_return_an_anonymous_record() {
    make = (n) => ({ x = n })

    assert_eq(str(make(4).x), "4", "parenthesized, so it is a record")
}

at(parts: str[], i: int) -> str =>
    parts.get(i)

prefixed(at: str, text: str) -> str =>
    text.split("\n").map(l => at ++ l).join("\n")

test_a_lambda_captures_the_local_over_a_global_of_the_same_name() {
    assert_eq(prefixed("> ", "a\nb"), "> a\n> b", "the parameter came along")
    assert_eq(at(["z"], 0), "z", "and the function is still itself")
}

twice_of(n: int) -> int =>
    n * 2

test_a_lambda_captures_a_local_over_a_global_of_the_same_name() {
    twice_of = 20

    assert_eq(str([1, 2].map(n => n + twice_of).sum()), "43", "20 twice, + 3")
    assert_eq(str(twice_of), "20", "the local is still the local")
}

mark = "GLOBAL"

tagged(mark: str, xs: str[]) -> str =>
    xs.map(x => mark ++ x).join(",")

test_a_lambda_captures_a_local_over_a_top_level_binding() {
    assert_eq(tagged("<", ["a", "b"]), "<a,<b", "the parameter, not the module")
    assert_eq(mark, "GLOBAL", "and the module's own is untouched")
}
