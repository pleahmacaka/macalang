import alpha
import beta
import top
import capture
import pick

test_each_module_keeps_its_own_private_helper() {
    assert_eq(str(alpha_reading("abc")), "4", "alpha's own reading")
    assert_eq(beta_reading(7), "b7", "beta's own reading")
}

test_a_captured_parameter_beats_another_modules_top_level() {
    assert_eq(indent_lines("a\nb", ">"), ">a|>b", "the parameter won")
}

test_the_shadowed_top_level_still_answers() {
    assert_eq(column("ab", 4), "ab  ", "top's own column")
    assert_eq(column("abcd", 2), "abcd", "already wide enough")
}

test_a_third_module_reaches_the_published_definition() {
    assert_eq(str(picked()), "4", "pick meant the gauge")
    assert_eq(str(snug_use()), "6", "and snug still has its own")
}
