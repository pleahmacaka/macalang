Row = { label: str, note: str }

Holder = { s: str }

Shape = Circle(float) | Square(int)

lent(s: str) -> str => s

built(n: int) -> str => "row-" + str(n)

pick(a: str, b: str, first: bool) -> str => first ? a : b

maybe_bang(s: str, yes: bool) -> str {
    if yes {
        s = s + "!"
    }
    s
}

wrap(s: str) -> Holder => Holder { s = s }

show(s: Shape) -> str {
    match s {
        Circle(r) => "circle {r:.1}"
        Square(n) => "square {n}"
    }
}

page(n: int) -> str {
    out = ""
    for i in 1..n + 1 {
        out = out + built(i) + ";"
    }
    out
}

check_an_accumulator_survives_the_loop_that_built_it() {
    p = page(3)

    assert_eq(p, "row-1;row-2;row-3;", "every round is in the result")
}

check_a_lent_string_is_not_released_by_the_borrower() {
    mine = "kept-" + "value"
    copy = lent(mine)

    assert_eq(copy, "kept-value", "the borrower sees it")
    assert_eq(mine, "kept-value", "and the owner still has it")
}

check_a_returned_parameter_is_not_released_twice() {
    x = "x-" + "one"
    y = "y-" + "two"
    got = pick(x, y, true)

    assert_eq(got, "x-one", "the chosen one")
    assert_eq(x, "x-one", "and the original is still there")
    assert_eq(y, "y-two", "as is the one not chosen")
}

check_a_string_put_in_a_list_outlives_the_block_that_built_it() {
    names: str[] = []
    for i in 1..6 {
        names = names.push(built(i))
    }

    assert_eq(str(names.length()), "5", "every name was kept")
    assert_eq(names.get(0), "row-1", "the first is intact")
    assert_eq(names.get(4), "row-5", "and so is the last")
}

check_a_record_keeps_its_fields() {
    r = Row { label = "a" + "b", note = built(7) }

    assert_eq(r.label, "ab", "the field built in place")
    assert_eq(r.note, "row-7", "the field built by a call")
}

check_an_alias_keeps_both_names_alive() {
    a = "one-" + "two"
    b = a

    assert_eq(a, "one-two", "the original")
    assert_eq(b, "one-two", "the alias")
}

check_a_string_survives_a_nested_block_that_builds_its_own() {
    outer = "outer-" + "value"
    n = 0
    for i in 1..11 {
        inner = "inner-" + str(i)
        n = n + inner.length()
    }

    assert_eq(outer, "outer-value", "the outer string is untouched")
    assert_eq(str(n), "71", "nine seven-byte rows and one of eight")
}

check_a_method_result_is_the_callers_and_the_receiver_is_not() {
    raw = "  padded  "
    s = raw.trim()

    assert_eq(s, "padded", "the method built a new string")
    assert_eq(str(raw.length()), "10", "and left the receiver alone")
}

check_a_conditional_string_belongs_to_whichever_branch_made_it() {
    hot = true
    label = hot ? "hot-" + "path" : "cold-" + "path"

    assert_eq(label, "hot-path", "the chosen branch")
}

check_interpolation_reads_its_pieces_without_keeping_them() {
    name = "maca"
    n = 3
    line = "{name}/{n}/{name}"

    assert_eq(line, "maca/3/maca", "every piece is in place")
    assert_eq(name, "maca", "and the piece it read twice is still there")
}

check_rows_are_reused_without_losing_the_one_kept() {
    kept = ""
    for round in 1..201 {
        row = ""
        for i in 1..9 {
            row = row + "{i}."
        }
        if round == 100 {
            kept = row + "!"
        }
    }

    assert_eq(kept, "1.2.3.4.5.6.7.8.!", "the row lifted out of the loop")
}

check_rendering_a_string_does_not_take_it_from_its_owner() {
    s = "hello" + "-world"
    shown = "[" + str(s) + "]"
    other = "AAAAA" + "AAAAAA"

    assert_eq(shown, "[hello-world]", "the rendering")
    assert_eq(other, "AAAAAAAAAAA", "the string built afterwards")
    assert_eq(s, "hello-world", "and the one that was rendered")
}

check_a_conditionally_rewritten_parameter_belongs_to_the_caller() {
    a = "hi" + " there"
    for i in 1..4 {
        untouched = maybe_bang(a, false)
        assert_eq(untouched, "hi there", "the path that changed nothing")
    }
    filler = "BBBBBBBB"

    assert_eq(maybe_bang(a, true), "hi there!", "the path that built a string")
    assert_eq(filler, "BBBBBBBB", "the string built afterwards")
    assert_eq(a, "hi there", "and the caller's own")
}

check_a_receiver_is_kept_by_whatever_keeps_an_argument() {
    held = Holder { s = "" }
    for i in 1..4 {
        s = "payload-" + "abc"
        held = s.wrap()
    }
    filler = "zzzzzzzzzz" + "yyy"

    assert_eq(held.s, "payload-abc", "what the receiver was")
    assert_eq(filler, "zzzzzzzzzzyyy", "the string built afterwards")
}

check_a_shorthand_field_keeps_its_string() {
    held = Holder { s = "" }
    for i in 1..4 {
        s = "payload-" + "abc"
        boxed = [Holder { s }]
        held = boxed.get(0)
    }
    filler = "zzzzzzzzzz" + "yyy"

    assert_eq(held.s, "payload-abc", "what the shorthand named")
    assert_eq(filler, "zzzzzzzzzzyyy", "the string built afterwards")
}

check_splitting_on_nothing_answers_with_its_own_string() {
    parts: str[] = []
    for i in 1..3 {
        s = "abc" + "def"
        parts = s.split("")
    }

    assert_eq(str(parts.length()), "1", "one piece")
    assert_eq(parts.get(0), "abcdef", "holding the whole string")
}

check_a_list_of_payload_variants_can_be_indexed() {
    ss = [Circle(1.0), Square(2)]

    assert_eq(show(ss.get(0)), "circle 1.0", "by index")
    assert_eq(show(ss.first()), "circle 1.0", "the first")
    assert_eq(show(ss.last()), "square 2", "the last")
}

main() -> int {
    check_an_accumulator_survives_the_loop_that_built_it()
    check_rendering_a_string_does_not_take_it_from_its_owner()
    check_a_conditionally_rewritten_parameter_belongs_to_the_caller()
    check_a_receiver_is_kept_by_whatever_keeps_an_argument()
    check_a_shorthand_field_keeps_its_string()
    check_splitting_on_nothing_answers_with_its_own_string()
    check_a_list_of_payload_variants_can_be_indexed()
    check_a_lent_string_is_not_released_by_the_borrower()
    check_a_returned_parameter_is_not_released_twice()
    check_a_string_put_in_a_list_outlives_the_block_that_built_it()
    check_a_record_keeps_its_fields()
    check_an_alias_keeps_both_names_alive()
    check_a_string_survives_a_nested_block_that_builds_its_own()
    check_a_method_result_is_the_callers_and_the_receiver_is_not()
    check_a_conditional_string_belongs_to_whichever_branch_made_it()
    check_interpolation_reads_its_pieces_without_keeping_them()
    check_rows_are_reused_without_losing_the_one_kept()

    failures()
}
