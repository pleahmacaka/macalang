render(i: int) -> str => "<li>" + str(i) + "</li>"

main() -> int {
    total = 0
    for round in 1..501 {
        for i in 1..41 {
            line = render(i)
            total = total + line.length()
        }
    }

    assert_eq(str(total), "215500", "every row was built and measured")

    reused = reuse_count() * 100 / (reuse_count() + alloc_count())
    info("reused={reused}%")
    assert(reused > 95, "almost every string came off the free-list")

    failures()
}
