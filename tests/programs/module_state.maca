count = 0
label = "start"
seen: int[] = []
const Step = 2

Mode = Idle | Busy

mode = Idle

bump() {
    count = count + Step
    label = "bumped {count}"
}

remember(n: int) {
    seen = seen.push(n)
}

start_work() {
    mode = Busy
}

reading() -> str => "{count}/{label}"

test_a_write_from_a_function_is_seen_by_the_next_call() {
    count = 0
    label = "start"

    bump()
    assert_eq("{count}", "2", "one bump")

    bump()
    assert_eq("{count}", "4", "and the second sees the first")
    assert_eq(label, "bumped 4", "a string is written too")
}

test_a_write_is_seen_by_another_function_that_reads_it() {
    count = 10
    label = "ten"

    assert_eq(reading(), "10/ten", "the reader sees what the writer left")
}

test_a_list_grows_across_calls() {
    seen = []

    remember(1)
    remember(2)
    remember(3)

    assert_eq("{seen.length()}", "3", "every element stayed")
    assert_eq("{seen.get(0)}{seen.get(1)}{seen.get(2)}", "123", "and in order")
}

test_a_sum_variant_is_written_like_anything_else() {
    mode = Idle

    start_work()

    assert_eq(str(mode), "Busy", "the variant was written")
}

shadowed(count: int) -> int {
    count = count + 1

    count
}

test_a_parameter_of_the_same_name_is_the_parameter() {
    count = 100

    assert_eq("{shadowed(1)}", "2", "the parameter was written, not the module")
    assert_eq("{count}", "100", "the module's own value is untouched")
}

test_a_constant_is_still_the_value_it_was_declared_as() {
    assert_eq("{Step}", "2", "nothing writes it, so nothing changes it")
}

main() -> int {
    test_a_write_from_a_function_is_seen_by_the_next_call()
    test_a_write_is_seen_by_another_function_that_reads_it()
    test_a_list_grows_across_calls()
    test_a_sum_variant_is_written_like_anything_else()
    test_a_parameter_of_the_same_name_is_the_parameter()
    test_a_constant_is_still_the_value_it_was_declared_as()

    failures()
}
