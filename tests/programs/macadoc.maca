import std/fs
import std/path
import std/text
import std/list
import std/proc
import { flat, of_kind, cross_linked, declared, kind_label, is_union,
         item_href, signature, is_plain_comment, opens_block,
         comment_body, first_sentence } from apps/macadoc/macadoc

maca() -> str =>
    env_or("MACA", "target/release/maca")

Out = "/tmp/maca-macadoc"

test_every_line_comment_is_plain_and_only_a_block_is_doc() {
    assert(is_plain_comment("// a note"), "two slashes is a plain comment")
    assert(is_plain_comment("/// what it was"),
           "three slashes stopped being special when docs became blocks")
    assert(is_plain_comment("//// a rule"), "and a rule someone drew is one too")
    assert(opens_block("/** what it is */"), "a doc is a block now")
    assert(!opens_block("/* an ordinary aside */"),
           "and a block without the second star is an ordinary comment")
}

test_a_comment_body_keeps_the_indent_past_the_first_space() {
    assert_eq(comment_body("// a sentence"), "a sentence", "one space eaten")
    assert_eq(comment_body("//     import std/text"), "    import std/text",
              "the rest of the indent kept")
    assert_eq(comment_body("//no space at all"), "no space at all", "no space")
}

test_a_wrapped_signature_is_read_whole() {
    src = ["shift(p: Point,", "      dx: int) -> Point =>", "    p"]

    assert_eq(signature(src, 0), "shift(p: Point, dx: int) -> Point",
              "joined and cut")
    assert_eq(signature(["plot(p: Point) -> str \{", "    \"x\""], 0),
              "plot(p: Point) -> str", "a block body is cut too")
}

test_a_signature_flattens_onto_one_line() {
    assert_eq(flat("Roomy = \{\n    first:  str\n    second: str\n\}"),
              "Roomy = \{ first: str second: str \}", "one line, one space")
    assert_eq(flat("lines(s: str) -> str[]"), "lines(s: str) -> str[]",
              "already one line")
}

test_a_declaration_is_labelled_and_located() {
    src = ["Point = \{", "    x: int", "\}", "", "Facing = Up | Down", "",
           "Origin = 0", "", "shift(p: Point) -> Point =>", "    p"]

    assert_eq(declared(src, 0, []).kind, "record", "a record")
    assert_eq(declared(src, 4, []).kind, "sum", "a sum")
    assert_eq(declared(src, 6, []).kind, "const", "a constant")
    assert_eq(declared(src, 8, []).kind, "fn", "a function")
    assert_eq(declared(src, 8, []).name, "shift", "named by its head")
    assert_eq(str(declared(src, 8, []).line), "9", "one-based")
}

test_items_group_by_kind() {
    items = [item("fn", "shift"), item("record", "Point"),
             item("sum", "Facing"), item("fn", "plot")]

    assert_eq(names(of_kind(items, 0, "fn", []), 0, []).join(" "),
              "shift plot", "the functions, in source order")
    assert_eq(names(of_kind(items, 0, "record", []), 0, []).join(" "), "Point",
              "the records")
    assert_eq(str(of_kind(items, 0, "const", []).length()), "0",
              "a kind the module has none of")
    assert_eq(kind_label("fn"), "Functions", "functions")
    assert_eq(kind_label("record"), "Records", "records")
    assert_eq(kind_label("sum"), "Sum types", "sums")
    assert_eq(kind_label("const"), "Constants", "constants")
}

test_a_row_links_within_its_page_and_across_the_others() {
    assert_eq(item_href("list", "sort_by", true), "#sort_by", "same page")
    assert_eq(item_href("list", "sort_by", false), "list.html#sort_by",
              "another page")
}

TySpan = "<span class=\"tok-ty\">"

test_a_type_in_a_signature_becomes_a_link() {
    got = cross_linked(ty("Point") + " -&gt; " + ty("Facing"), fixture(),
                       "shapes", "shift")

    assert(links_to(got, "Point", "#Point"), "the parameter's type")
    assert(links_to(got, "Facing", "#Facing"), "the return type")
}

test_a_type_from_another_module_carries_its_page() {
    got = cross_linked(ty("Point"), fixture(), "draw", "plot")

    assert(links_to(got, "Point", "shapes.html#Point"),
           "the page it is declared on")
    assert(got.contains("data-mod=\"shapes\" data-item=\"Point\""),
           "and it names the item, which is what the hover card reads")
}

links_to(html: str, name: str, href: str) -> bool {
    at = html.index_of("href=\"" + href + "\"")

    if at < 0 {
        false
    } else {
        text = split_once(html.slice(at, html.length()), ">").get(1)
        text.starts_with(name + "</a>")
    }
}

test_only_a_documented_type_is_linked() {
    prim = cross_linked(ty("int"), fixture(), "shapes", "shift")
    unknown = cross_linked(ty("Plot"), fixture(), "shapes", "shift")
    konst = cross_linked(ty("Origin"), fixture(), "shapes", "shift")

    assert_eq(prim, ty("int"), "a primitive is left alone")
    assert_eq(unknown, ty("Plot"), "so is a name nothing declares")
    assert_eq(konst, ty("Origin"), "and a constant, which is not a type")
}

test_an_item_does_not_link_to_itself() {
    got = cross_linked(ty("Point"), fixture(), "shapes", "Point")

    assert_eq(got, ty("Point"), "its own name is not a link")
}

ty(name: str) -> str =>
    TySpan + name + "</span>"

fixture() -> Module[] =>
    [Module { path = "fx/shapes.maca", name = "shapes", blurb = [],
              items = [item("record", "Point"), item("sum", "Facing"),
                       item("const", "Origin"), item("fn", "shift")] },
     Module { path = "fx/draw.maca", name = "draw", blurb = [],
              items = [item("fn", "plot")] }]

item(kind: str, name: str) -> Item =>
    Item { kind = kind, name = name, sig = name, line = 1, doc = [] }

names(items: Item[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else {
        names(items, i + 1, acc.push(items.get(i).name))
    }
}

Shapes = """// Shapes on a grid.
//
// A module with one of every kind of declaration in it.
//
//     import fx/shapes

/** A point on the grid. */
Point = {
    x: int
    y: int
}

/** Which way up a point is read. */
Facing = Up | Down

/** Where a fresh grid starts. */
Origin = 0

/** Move a point along x. */
shift(p: Point,
      dx: int) -> Point =>
    p with { x = p.x + dx }

/** Which way a point faces. */
facing_of(p: Point) -> Facing =>
    p.y > 0 ? Up : Down
"""

Draw = """// Drawing, which names another module's types and declares none.

/** Render a `Point` as text. */
plot(p: Point) -> str =>
    "{p.x},{p.y}"
"""

Corner = """// Corner cases the reader is entitled to have right.

/** A constant whose value holds a pipe. Reading the right-hand side for a `|`
 * filed this under sum types and made it a link target for every mention of
 * the name, which is a wrong answer twice over.
 */
Pipe = "a|b"

/** A real sum, so the fix cannot be to stop recognising them. */
Facing = North | South

/** An item named after the search box. */
q(n: int) -> int => n

/** An item named after the no-matches line. */
empty() -> bool => true
"""

Overlay = """// Overlay, which declares a Point of its own.
//
//     import fx/overlay

/** A point in pixels, which is not the grid's. */
Point = {
    px: int
    py: int
}

/** Place an overlay point. */
place(p: Point) -> str =>
    "{p.px}"
"""

built() -> str {
    src = join(Out, "fx")
    dir = join(Out, "api")

    make_dir(src)
    write_file(join(src, "shapes.maca"), Shapes)
    write_file(join(src, "draw.maca"), Draw)
    write_file(join(src, "overlay.maca"), Overlay)
    write_file(join(src, "corner.maca"), Corner)
    remove_dir(dir)
    run(maca(), ["run", "apps/macadoc/macadoc.maca", dir,
                 join(src, "shapes.maca"), join(src, "draw.maca"),
                 join(src, "overlay.maca"), join(src, "corner.maca")])
    dir
}

test_every_item_appears_in_its_own_sidebar_branch() {
    dir = built()

    assert_eq(missing_rows(dir, "shapes"), "", "fx/shapes")
    assert_eq(missing_rows(dir, "draw"), "", "fx/draw")
    assert_eq(missing_rows(dir, "overlay"), "", "fx/overlay")
}

own_branch(page: str, name: str) -> str =>
    between(page, "data-mod=\"" + name + "\" open>", "</details>")

missing_rows(dir: str, name: str) -> str {
    page = read_file(join(dir, name + ".html"))
    branch = own_branch(page, name)

    absent(branch, values_of(page, "<article id=\""), 0, []).join(", ")
}

absent(branch: str, ids: str[], i: int, acc: str[]) -> str[] {
    if i >= ids.length() {
        acc
    } else if branch.contains("data-item=\"" + ids.get(i) + "\"") {
        absent(branch, ids, i + 1, acc)
    } else {
        absent(branch, ids, i + 1, acc.push(ids.get(i)))
    }
}

test_the_sidebar_reaches_every_module_from_every_page() {
    dir = built()

    assert(sidebar_of(dir, "draw.html").contains("data-mod=\"shapes\""),
           "the other module, from draw")
    assert(sidebar_of(dir, "shapes.html").contains("data-mod=\"draw\""),
           "and back again")
    assert(sidebar_of(dir, "index.html").contains("data-mod=\"shapes\""),
           "from the index too")
    assert(sidebar_of(dir, "index.html").contains("id=\"macadoc-search\""),
           "and the search box is on every page")
}

sidebar_of(dir: str, page: str) -> str =>
    between(read_file(join(dir, page)), "data-doc=\"nav\"", "</main>")

test_the_markup_and_the_script_agree_on_what_they_drive() {
    page = read_file(join(built(), "shapes.html"))
    js = between(page, "<script>", "</script>")
    side = split_once(page, "<main>").get(0)

    assert(js.length() > 0, "the page carries its script")
    assert(both(side, js, "data-doc=\"nav\"", "data-doc=\"nav\""),
           "the disclosure a phone collapses")
    assert(both(side, js, "data-mod=", "data-mod"), "the module branches")
    assert(both(side, js, "data-item=", "data-item"), "the rows")
    assert(both(side, js, "data-group=", "data-group"), "the kind headings")
    assert(both(side, js, "data-sig=", "dataset.sig"), "the search key")
    assert(both(side, js, "id=\"macadoc-search\"", "\"macadoc-search\""),
           "the field")
    assert(both(side, js, "id=\"macadoc-empty\"", "\"macadoc-empty\""),
           "the answer line")
}

both(side: str, js: str, attr: str, in_js: str) -> bool =>
    side.contains(attr) && js.contains(in_js)

test_the_search_ships_in_its_resting_state() {
    dir = built()
    index = read_file(join(dir, "index.html"))

    assert(index.contains("id=\"macadoc-empty\" hidden"),
           "no page says \"No matches.\" before a query misses")
    assert_eq(open_mods(read_file(join(dir, "shapes.html"))), "shapes",
              "one branch ships open, the page's own")
    assert_eq(open_mods(read_file(join(dir, "overlay.html"))), "overlay",
              "and it is the page's own on every page")
    assert_eq(open_mods(index), "", "the index is nobody's module")
}

open_mods(page: str) -> str =>
    opened(page.split("data-mod=\""), 1, []).join(" ")

opened(parts: str[], i: int, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else {
        tag = split_once(parts.get(i), ">").get(0)
        name = split_once(parts.get(i), "\"").get(0)

        opened(parts, i + 1, tag.contains(" open") ? acc.push(name) : acc)
    }
}

test_every_in_page_anchor_resolves() {
    dir = built()

    assert_eq(broken(dir, "shapes.html"), "", "shapes.html")
    assert_eq(broken(dir, "draw.html"), "", "draw.html")
    assert_eq(broken(dir, "overlay.html"), "", "overlay.html")
    assert_eq(broken(dir, "index.html"), "", "index.html")
}

broken(dir: str, page: str) -> str =>
    unresolved(dir, page, values_of(read_file(join(dir, page)), "href=\""), 0,
               []).join(", ")

unresolved(dir: str, page: str, hs: str[], i: int, acc: str[]) -> str[] {
    if i >= hs.length() {
        acc
    } else if resolves(dir, page, hs.get(i)) {
        unresolved(dir, page, hs, i + 1, acc)
    } else {
        unresolved(dir, page, hs, i + 1, acc.push(hs.get(i)))
    }
}

resolves(dir: str, page: str, href: str) -> bool {
    if href.starts_with("..") || href.starts_with("http") {
        true
    } else {
        cut = split_once(href, "#")
        file = cut.get(0) == "" ? page : cut.get(0)
        anchor = cut.get(1)

        if !file_exists(join(dir, file)) {
            false
        } else if anchor == "" {
            true
        } else {
            read_file(join(dir, file)).contains("id=\"" + anchor + "\"")
        }
    }
}

test_a_type_in_a_signature_links_to_its_declaration() {
    dir = built()
    sig = sig_of(read_file(join(dir, "draw.html")), "plot")

    assert(links_to(sig, "Point", "shapes.html#Point"),
           "the parameter's type is a link")
    assert(read_file(join(dir, "shapes.html")).contains("id=\"Point\""),
           "and the declaration is there to land on")
}

test_a_type_declared_twice_links_to_the_one_at_hand() {
    dir = built()
    sig = sig_of(read_file(join(dir, "overlay.html")), "place")

    assert(links_to(sig, "Point", "#Point"), "overlay's own Point")
    assert(!sig.contains("shapes.html#Point"), "not the other module's")
    assert(sig.contains("data-mod=\"overlay\""),
           "and the link resolves against overlay, not the other module")
    assert(links_to(sig_of(read_file(join(dir, "draw.html")), "plot"),
                    "Point", "shapes.html#Point"),
           "and a module declaring none still reaches the other page")
}

test_a_signature_is_highlighted_and_carries_its_own_text() {
    sig = sig_of(read_file(join(built(), "shapes.html")), "facing_of")

    assert(sig.contains("<span class=\"tok-fn\">facing_of</span>"),
           "the name is a definition token")
    assert(sig.contains("<span class=\"tok-op\">-&gt;</span>"),
           "and the arrow an operator, escaped")
    assert(sig.contains("data-sig=\"facing_of(p: Point) -&gt; Facing\""),
           "and the whole declaration is there as text")
}

sig_of(page: str, name: str) -> str =>
    between(between(page, "<article id=\"" + name + "\"", "</article>"),
            "<pre", "</pre>")

test_a_kind_heading_appears_only_for_a_kind_that_is_there() {
    dir = built()
    shapes = own_branch(read_file(join(dir, "shapes.html")), "shapes")
    draw = own_branch(read_file(join(dir, "draw.html")), "draw")

    assert(shapes.contains("Records"), "shapes declares a record")
    assert(shapes.contains("Sum types"), "and a sum")
    assert(shapes.contains("Constants"), "and a constant")
    assert(draw.contains("Functions"), "draw declares functions")
    assert(!draw.contains("Records"), "and no record")
    assert(!draw.contains("Constants"), "and no constant")
}

test_the_entries_sit_in_a_column_that_can_shrink() {
    dir = built()

    assert(read_file(join(dir, "shapes.html")).contains("grid grid-cols-1"),
           "the entry stream constrains its column")
    assert(read_file(join(dir, "index.html")).contains("grid grid-cols-1"),
           "and so does the card list")
}

test_each_item_links_to_its_own_source_line() {
    page = read_file(join(built(), "shapes.html"))

    assert(page.contains("/fx/shapes.maca#L8"), "Point, at its declaration")
    assert(page.contains("/fx/shapes.maca#L20"), "shift, past the blank lines")
    assert(page.contains("/fx/shapes.maca#L25"), "and the last item too")
    assert(!page.contains("#L0"), "and no item claims line zero")
}

test_a_module_card_says_what_the_module_is() {
    index = read_file(join(built(), "index.html"))

    assert(index.contains("Shapes on a grid."), "shapes' first sentence")
    assert_eq(first_sentence(["One thing. And another.", "", "A paragraph."]),
              "One thing.", "cut at the first sentence")
    assert_eq(first_sentence(["No blank line here at all"]),
              "No blank line here at all", "a blurb of one paragraph")
}

values_of(page: str, marker: str) -> str[] =>
    firsts(page.split(marker), 1, [])

firsts(parts: str[], i: int, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else {
        firsts(parts, i + 1, acc.push(split_once(parts.get(i), "\"").get(0)))
    }
}

test_no_two_elements_on_a_page_share_an_id() {
    page = read_file(join(built(), "corner.html"))
    ids = values_of(page, "id=\"")

    assert_eq(duplicate(ids.sort(), 1), "", "every id on the page is its own")
    assert(ids.contains("q"), "the item still anchors under its own name")
    assert(ids.contains("empty"), "and so does the other one")
}

kind_of(page: str, name: str) -> str {
    at = page.index_of("id=\"" + name + "\"")

    if at < 0 {
        ""
    } else {
        between(page.slice(at, page.length()), "<span data-kind=\"", "\"")
    }
}

duplicate(ids: str[], i: int) -> str {
    if i >= ids.length() {
        ""
    } else if ids.get(i) == ids.get(i - 1) {
        ids.get(i)
    } else {
        duplicate(ids, i + 1)
    }
}

test_a_constant_holding_a_pipe_is_not_a_sum() {
    page = read_file(join(built(), "corner.html"))

    assert(is_union("North | South"), "a union of two variants")
    assert(is_union("Circle(float) | Rect(float, float)"), "with payloads")
    assert(!is_union("\"a|b\""), "a string that contains one")
    assert(!is_union("\{ x: int \}"), "a record")
    assert(!is_union("41"), "a number")

    assert_eq(kind_of(page, "Pipe"), "const", "filed as a constant")
    assert_eq(kind_of(page, "Facing"), "sum", "and a real sum still is one")
}
