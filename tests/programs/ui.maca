test_a_tag_call_renders_its_children_in_order() {
    html = div(class="wrap",
        h1("Title")
        p("text")
        a(href="x.html", "link")
        hr()
    )

    assert_eq(html,
              "<div class=\"wrap\"><h1>Title</h1><p>text</p>" +
                  "<a href=\"x.html\">link</a><hr></div>",
              "attributes, children and a void element")
}

test_an_attribute_value_is_escaped() {
    html = p(title="a \"q\" & <b>", "x")

    assert(html.contains("title=\"a &quot;q&quot; &amp; &lt;b&gt;\""),
           "quotes and angle brackets escaped")
}

test_a_child_is_not_re_escaped() {
    html = p("already &lt;escaped&gt;")

    assert_eq(html, "<p>already &lt;escaped&gt;</p>", "passed through as given")
}

test_elements_compose_through_functions_and_interpolation() {
    n = 2
    body = ul(item("one") item("two"))

    assert_eq(section(p("{n} items") body),
              "<section><p>2 items</p><ul><li>one</li><li>two</li></ul></section>",
              "a function-built child inside an interpolated parent")
}

item(s: str) -> str => li(s)

test_styles_generates_a_rule_per_utility_used() {
    sheet = styles()

    assert(sheet.contains(".max-w-2xl \{ max-width:42rem; \}"), "max-width")
    assert(sheet.contains(".mx-auto \{ margin-left:auto;margin-right:auto; \}"),
           "centring")
    assert(sheet.contains(".font-bold \{ font-weight:700; \}"), "font weight")
}

test_styles_ships_nothing_the_module_never_mentions() {
    assert(!styles().contains(".text-2xl"), "an unused utility is not emitted")
}

use_the_utilities_the_stylesheet_is_asked_about() -> str =>
    div(class="max-w-2xl mx-auto font-bold", "x")

test_a_hyphenated_attribute_name_needs_no_workaround() {
    assert_eq(nav(data-tomo="toc", aria-label="Contents", "x"),
              "<nav data-tomo=\"toc\" aria-label=\"Contents\">x</nav>",
              "data- and aria-")
    assert_eq(meta(http-equiv="refresh", content="0"),
              "<meta http-equiv=\"refresh\" content=\"0\">",
              "http-equiv on a void element")
}

test_an_attribute_name_may_keep_a_literal_underscore() {
    assert_eq(div(data-my_thing="1", "u"), "<div data-my_thing=\"1\">u</div>",
              "the underscore is not rewritten to a hyphen")
}

test_a_spaced_minus_is_still_subtraction() {
    a = 10
    b = 3

    assert_eq(span("{a - b}"), "<span>7</span>", "arithmetic, not an attribute")
}

test_a_true_flag_is_the_bare_attribute() {
    assert_eq(details(open=true, summary("s") "body"),
              "<details open><summary>s</summary>body</details>",
              "no value, just the name")
}

test_a_false_flag_is_no_attribute() {
    assert_eq(div(hidden=false, "seen"), "<div>seen</div>", "nothing emitted")
}

test_a_computed_flag_is_evaluated() {
    n = 3

    assert_eq(div(hidden=n > 5, "computed"), "<div>computed</div>", "false")
    assert_eq(div(hidden=n < 5, "computed"), "<div hidden>computed</div>", "true")
}

test_element_takes_its_tag_as_a_value() {
    assert_eq(head_at(1, "Top"), "<h1 id=\"s\">Top</h1>", "a shallow heading")
    assert_eq(head_at(3, "Deep"), "<h3 id=\"s\">Deep</h3>", "a deep one")
}

test_a_tag_chosen_at_runtime_works_as_a_child() {
    cell = "th"

    assert_eq(tr(element(cell, "name")), "<tr><th>name</th></tr>", "a header cell")
}

test_a_void_tag_chosen_at_runtime_still_self_closes() {
    assert_eq(element("br"), "<br>", "no closing tag")
}

head_at(level: int, text: str) -> str =>
    element("h{level}", id="s", text)

test_a_user_function_shadows_the_tag_of_the_same_name() {
    assert_eq(label(true), "side: right", "`label` is the user's function")
    assert_eq(str(code(21)), "42", "so is `code`")
}

test_a_tag_nothing_shadows_still_works() {
    assert_eq(span("tag"), "<span>tag</span>", "no definition in the way")
}

test_a_local_named_like_a_function_is_still_a_value_in_an_attribute() {
    code = "note"

    assert_eq(a(data-kind=code, "x"), "<a data-kind=\"note\">x</a>",
              "the local, not the function of the same name")
}

test_a_hyphenated_name_is_a_custom_element() {
    assert_eq(iconify-icon(class="big", icon="lucide:lock"),
              "<iconify-icon class=\"big\" icon=\"lucide:lock\"></iconify-icon>",
              "a hyphen is what makes a tag a custom element")
    assert_eq(my-card(span("in")), "<my-card><span>in</span></my-card>",
              "and it closes, because no custom element is void")
}

label(pos: bool) -> str {
    pos ? "side: right" : "side: left"
}

code(n: int) -> int => n * 2

test_a_local_shadows_the_tag_of_the_same_name() {
    assert_eq(str(apply(n => n + 1, 41)), "42", "`n` is the lambda's parameter")
}

apply(f, x: int) -> int => f(x)

Row = { title: str, icon: str }

pencil(on: bool) -> Element[] {
    if !on {
        return []
    }

    [button(class="pencil", "edit")]
}

row(link: Row, on: bool) -> Element =>
    li(class="row",
       [i(class="icon", link.icon), span(class="title", link.title)] +
           pencil(on))

test_a_view_that_renders_nothing_adds_no_node() {
    assert_eq(section(pencil(false)), "<section></section>",
              "an empty list contributes nothing at all")
    assert_eq(section(pencil(true)),
              "<section><button class=\"pencil\">edit</button></section>",
              "and a full one contributes its element")
}

test_a_list_of_children_is_spliced_into_the_parent() {
    link = Row { title = "Docs", icon = "book" }

    assert_eq(row(link, false),
              "<li class=\"row\"><i class=\"icon\">book</i>" +
                  "<span class=\"title\">Docs</span></li>",
              "two children and no pencil")
    assert_eq(row(link, true),
              "<li class=\"row\"><i class=\"icon\">book</i>" +
                  "<span class=\"title\">Docs</span>" +
                  "<button class=\"pencil\">edit</button></li>",
              "and three when the pencil is there")
}

test_a_mapped_list_is_one_child_per_element() {
    ls = [Row { title = "a", icon = "x" }, Row { title = "b", icon = "y" }]

    assert_eq(ul(ls.map(l => li(l.title))), "<ul><li>a</li><li>b</li></ul>",
              "one element per row")
    assert_eq(ul(ls.filter(l => l.title == "z").map(l => li(l.title))),
              "<ul></ul>", "and none when nothing is left")
}

test_a_list_literal_is_a_child_where_it_is_written() {
    assert_eq(div([span("a"), span("b")], "tail"),
              "<div><span>a</span><span>b</span>tail</div>",
              "in the order the arguments are in")
}

board(taps: int) -> Element {
    grip = "idle"

    grab(index: int) {
        grip = "held {index}"
    }

    if taps > 0 {
        grab(taps)
    }

    div(span(grip))
}

test_a_view_local_a_nested_function_writes_renders_where_it_ended() {
    assert_eq(board(0), "<div><span>idle</span></div>", "nothing wrote it")
    assert_eq(board(2), "<div><span>held 2</span></div>",
              "the write reached the markup")
}

test_two_calls_to_the_same_view_do_not_share_a_local() {
    assert_eq(board(1) + board(0),
              "<div><span>held 1</span></div><div><span>idle</span></div>",
              "the second call starts over")
}
