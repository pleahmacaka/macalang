import std/text

test_lines_does_not_invent_a_final_empty_line() {
    assert_eq(lines("a\nb\nc\n").join("|"), "a|b|c", "trailing newline")
    assert_eq(lines("a\nb").join("|"), "a|b", "no trailing newline")
    assert_eq(lines("").join("|"), "", "empty input")
}

test_lines_accepts_windows_endings() {
    assert_eq(lines("a\r\nb\r\n").join("|"), "a|b", "CRLF")
}

test_words_drops_empty_runs() {
    assert_eq(words("  a  b\tc\n").join("|"), "a|b|c", "runs of whitespace")
    assert_eq(words("").join("|"), "", "nothing to split")
}

test_split_once_splits_on_the_first_separator_only() {
    assert_eq(split_once("a=b=c", "=").join("|"), "a|b=c", "only the first")
    assert_eq(split_once("x", "=").join("|"), "x|", "separator absent")
}

test_strip_prefix_and_suffix_only_touch_the_ends() {
    assert_eq(strip_prefix("foobar", "foo"), "bar", "prefix present")
    assert_eq(strip_prefix("bar", "foo"), "bar", "prefix absent")
    assert_eq(strip_suffix("foobar", "bar"), "foo", "suffix present")
    assert_eq(strip_suffix("foo", "bar"), "foo", "suffix absent")
    assert_eq(strip_prefix("aXa", "a"), "Xa", "not a global replace")
}

test_count_counts_non_overlapping_occurrences() {
    assert_eq(str(count("aXbXc", "X")), "2", "two separate hits")
    assert_eq(str(count("aaaa", "aa")), "2", "non-overlapping")
    assert_eq(str(count("abc", "z")), "0", "no hits")
    assert_eq(str(count("abc", "")), "0", "an empty needle matches nothing")
}

test_title_case_capitalizes_each_word() {
    assert_eq(title_case("hello wide world"), "Hello Wide World", "three words")
    assert_eq(title_case("gREETings"), "Greetings", "the rest is lowered")
}

test_indent_leaves_empty_lines_alone() {
    assert_eq(indent("a\n\nb", "  "), "  a\n\n  b", "no trailing whitespace")
}

test_dedent_removes_the_common_indent() {
    assert_eq(dedent("    a\n      b\n    c"), "a\n  b\nc", "relative shape kept")
    assert_eq(dedent("a\n  b"), "a\n  b", "nothing common to remove")
}

test_wrap_breaks_between_words() {
    assert_eq(wrap("the quick brown fox jumps over", 12),
              "the quick\nbrown fox\njumps over",
              "each line within the width")
}

test_wrap_gives_a_long_word_its_own_line() {
    wrapped = wrap("a supercalifragilistic b", 6)
    assert_eq(wrapped, "a\nsupercalifragilistic\nb", "never cut mid-word")
}

test_index_of_from_returns_an_absolute_index() {
    assert_eq(str(index_of_from("a=b=c", "=", 0)), "1", "the first")
    assert_eq(str(index_of_from("a=b=c", "=", 2)), "3", "the second")
    assert_eq(str(index_of_from("a=b=c", "=", 4)), "-1", "none after")
    assert_eq(str(index_of_from("abc", "z", 0)), "-1", "absent")
}

test_index_of_from_clamps_its_start() {
    assert_eq(str(index_of_from("abc", "a", -5)), "0", "a negative start")
    assert_eq(str(index_of_from("abc", "a", 99)), "-1", "a start past the end")
}

test_last_index_of_finds_the_last_one() {
    assert_eq(str(last_index_of("a/b/c", "/")), "3", "the last separator")
    assert_eq(str(last_index_of("abc", "/")), "-1", "absent")
    assert_eq(str(last_index_of("///", "/")), "2", "overlapping runs")
}

test_between_needs_both_markers() {
    assert_eq(between("<b>hi</b>", "<b>", "</b>"), "hi", "the text between")
    assert_eq(between("<b>hi", "<b>", "</b>"), "", "no closing marker")
    assert_eq(between("hi</b>", "<b>", "</b>"), "", "no opening marker")
    assert_eq(between("<b></b>", "<b>", "</b>"), "", "empty between")
}

test_escape_html_covers_the_attribute_case_too() {
    assert_eq(escape_html("a < b & c > d"), "a &lt; b &amp; c &gt; d", "elements")
    assert_eq(escape_html("say \"hi\""), "say &quot;hi&quot;", "attributes")
}

test_escape_html_does_not_double_escape() {
    assert_eq(escape_html("&lt;"), "&amp;lt;", "the ampersand goes first")
}
