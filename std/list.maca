// std/list — the list operations that aren't builtins.
//
// `map`, `filter`, `reduce`, `sort`, `slice` and friends are UFCS methods on
// any `T[]`. This module is the next layer: the shapes you reach for once you
// have those, written as ordinary functions because they need types the method
// set can't spell (a pair of lists, a predicate that answers about the whole
// list rather than an element).
//
//   import std/list
//   import { any_of, chunk } from std/list
//
// The element type is a variable, so one definition serves `int[]`, `str[]` and
// anything else — the backend emits a copy per element type it is actually
// called with. `zip_add` and `range` are the two that stay `int`, because they
// do arithmetic rather than moving elements around.

/// Does any element satisfy `pred`? Short of a `break`, this is the readable
/// way to ask — `.filter(pred).length() > 0` walks the whole list and
/// allocates.
any_of(xs: a[], pred) -> bool =>
    scan_any(xs, 0, pred)

scan_any(xs: a[], i: int, pred) -> bool {
    if i >= xs.length() {
        false
    } else if pred(xs.get(i)) {
        true
    } else {
        scan_any(xs, i + 1, pred)
    }
}

/// Does every element satisfy `pred`? An empty list passes, which is what
/// makes `all_of(rules, ok)` behave when there are no rules yet.
all_of(xs: a[], pred) -> bool =>
    scan_all(xs, 0, pred)

scan_all(xs: a[], i: int, pred) -> bool {
    if i >= xs.length() {
        true
    } else if !pred(xs.get(i)) {
        false
    } else {
        scan_all(xs, i + 1, pred)
    }
}

/// The index of the first element satisfying `pred`, or -1. `index_of`
/// matches a value; this matches a question.
find_index(xs: a[], pred) -> int =>
    scan_find(xs, 0, pred)

scan_find(xs: a[], i: int, pred) -> int {
    if i >= xs.length() {
        -1
    } else if pred(xs.get(i)) {
        i
    } else {
        scan_find(xs, i + 1, pred)
    }
}

/// How many elements satisfy `pred`.
count_if(xs: a[], pred) -> int =>
    xs.filter(pred).length()

/// The first `n` elements. `n` clamps rather than failing, so `take(xs, 100)`
/// on a short list is the short list.
take(xs: a[], n: int) -> a[] =>
    xs.slice(0, clamp(n, xs.length()))

/// Everything after the first `n` elements — the other half of `take`, and
/// clamping the same way.
drop(xs: a[], n: int) -> a[] =>
    xs.slice(clamp(n, xs.length()), xs.length())

// An index brought into `0..len`, so a caller's arithmetic can't walk off
// either end of the list.
clamp(n: int, len: int) -> int {
    if n < 0 {
        0
    } else if n > len {
        len
    } else {
        n
    }
}

/// Fixed-size groups, the last one short if the length doesn't divide.
chunk(xs: a[], size: int) -> a[][] {
    if size <= 0 {
        []
    } else {
        chunk_from(xs, 0, size, [])
    }
}

chunk_from(xs: a[], at: int, size: int, acc: a[][]) -> a[][] {
    if at >= xs.length() {
        acc
    } else {
        group = xs.slice(at, clamp(at + size, xs.length()))
        chunk_from(xs, at + size, size, acc.push(group))
    }
}

/// One list of the pairwise sums, stopping at the shorter input. The language
/// has no tuple, so `zip` proper needs a record; this is the arithmetic case,
/// which is the one that comes up.
zip_add(xs: int[], ys: int[]) -> int[] =>
    zip_add_from(xs, ys, 0, [])

zip_add_from(xs: int[], ys: int[], i: int, acc: int[]) -> int[] {
    if i >= xs.length() || i >= ys.length() {
        acc
    } else {
        zip_add_from(xs, ys, i + 1, acc.push(xs.get(i) + ys.get(i)))
    }
}

/// Flatten one level.
flatten(xss: a[][]) -> a[] =>
    flatten_from(xss, 0, [])

flatten_from(xss: a[][], i: int, acc: a[]) -> a[] {
    if i >= xss.length() {
        acc
    } else {
        flatten_from(xss, i + 1, acc ++ xss.get(i))
    }
}

/// Values in first-seen order, duplicates dropped. Order is preserved on
/// purpose: sorting first would be faster and would also throw away the one
/// property that makes the result useful for output.
unique(xs: a[]) -> a[] =>
    unique_from(xs, 0, [])

unique_from(xs: a[], i: int, acc: a[]) -> a[] {
    if i >= xs.length() {
        acc
    } else if acc.contains(xs.get(i)) {
        unique_from(xs, i + 1, acc)
    } else {
        unique_from(xs, i + 1, acc.push(xs.get(i)))
    }
}

/// `[lo, lo+1, …, hi]`, empty when `hi < lo`. The `lo..hi` range is a loop
/// header; this is the value.
range(lo: int, hi: int) -> int[] {
    if hi < lo {
        []
    } else {
        range_from(lo, hi, [])
    }
}

range_from(at: int, hi: int, acc: int[]) -> int[] {
    if at > hi {
        acc
    } else {
        range_from(at + 1, hi, acc.push(at))
    }
}

