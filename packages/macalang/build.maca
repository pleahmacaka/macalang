import std/proc
import std/path

Wasm = "target/wasm32-unknown-unknown/release/maca_wasm.wasm"
Package = "packages/macalang"

main() -> int {
    run("cargo", ["build", "-p", "maca-wasm",
                  "--target", "wasm32-unknown-unknown", "--release"])

    dest = join(Package, "maca_wasm.wasm")

    if !copy_bytes(Wasm, dest) {
        fail "no wasm at {Wasm}"
    }

    info("copied maca_wasm.wasm ({file_size(dest)} bytes) into {Package}")
    0
}
