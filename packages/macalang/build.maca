// build: compile the wasm compiler and copy it into the npm package.
//
// Run before publishing or testing `packages/macalang`. `index.js` reads
// `maca_wasm.wasm` from beside itself, so the package is only publishable once
// this has put a current one there.
//
//   maca run packages/macalang/build.maca         # from the repository root
//
// The wasm it writes is a build artifact and the repository does not carry one:
// a checked-in binary drifts from the crates it was built out of, and a
// front-end that answers last month's questions is a worse thing to ship than
// no front-end at all. `test.mjs` says so instead of passing quietly, by
// checking the export list before it checks anything else.

import std/proc
import std/path

Wasm = "target/wasm32-unknown-unknown/release/maca_wasm.wasm"
Package = "packages/macalang"

main() -> int {
    run("cargo", ["build", "-p", "maca-wasm",
                  "--target", "wasm32-unknown-unknown", "--release"])

    dest = join(Package, "maca_wasm.wasm")

    if !copy_bytes(Wasm, dest) {
        fail "no wasm at {Wasm}"
    }

    info("copied maca_wasm.wasm ({file_size(dest)} bytes) into {Package}")
    0
}
