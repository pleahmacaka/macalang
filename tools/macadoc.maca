// macadoc: API documentation from Maca source, written in Maca.
//
// What TSDoc is to TypeScript and rustdoc is to Rust: read the declarations a
// module exports, pair each with the comment written above it, and render a
// reference page. Nothing is inferred that the source does not say.
//
//   maca run tools/macadoc.maca <out-dir> <file.maca>…
//   maca run tools/macadoc.maca site/api std/text.maca std/list.maca
//
// **`///` is what makes an item API.** Maca has no export keyword, and a
// module is mostly helpers: `scan_any`, `keep_nonempty`, the recursion an
// exported function is written in terms of. So a doc comment is spelled with a
// third slash, exactly as `///` is rustdoc's and `/** */` is TSDoc's: an item
// with a `///` block directly above it is API and is listed, and an item with
// an ordinary `//` comment is a helper being explained to the next reader of
// the source, which is a different audience and belongs in a different place.
//
// The alternative, "any comment above an item means API", was tried first,
// and measuring it against what `std/README.md` advertises found it wrong 18
// times in 60: nine helpers listed as API because they needed explaining, and
// nine public functions missing because they were obvious enough not to.

import std/fs
import std/path
import std/text
import apps/site/shell
import { highlight, code_css } from apps/tomo/highlight
import std/list
import { command, arg, rest } from cli/spec
import { parse, value, from } from cli/parse
import { help } from cli/help
import { bold, dim, ok, bad } from cli/style

// ---- the model ------------------------------------------------------------

// One documented declaration. `kind` is what it is, `sig` is how it is written
// in the source, and `doc` is the `///` block above it, still a list of lines
// because the blank ones in it are paragraph breaks. `line` is where the
// declaration sits in the file, which is what the source link points at.
Item = {
    kind: str
    name: str
    sig:  str
    line: int
    doc:  str[]
}

// One source file's worth of them.
Module = {
    path:  str
    name:  str
    blurb: str[]
    items: Item[]
}

// ---- reading a module -----------------------------------------------------

// A path that doesn't resolve used to read as an empty file, which produced a
// module with no items and a full page of chrome around it, and the site
// check, which only asks whether a page is non-empty, published it.
read_module(p: str) -> Module {
    if !file_exists(p) {
        fail "no such module: {p}"
    }

    lines = read_lines(p)
    items = scan(lines, 0, [], [])

    if items.length() == 0 {
        fail "{p} documents nothing. Is every item missing its `///` block?"
    }

    require_distinct_items(p, items, 0)

    Module {
        path = p,
        name = stem(p),
        blurb = module_blurb(lines, 0, []),
        items = items
    }
}

// A name is the item's `id` and the target of its jump link, so two of them on
// a page means a duplicate id and a link that lands on whichever the browser
// picks.
require_distinct_items(p: str, items: Item[], i: int) -> bool {
    if i >= items.length() {
        true
    } else if item_taken(items, 0, i) {
        fail "{p} documents {items.get(i).name} twice"
    } else {
        require_distinct_items(p, items, i + 1)
    }
}

item_taken(items: Item[], i: int, before: int) -> bool {
    if i >= before {
        false
    } else if items.get(i).name == items.get(before).name {
        true
    } else {
        item_taken(items, i + 1, before)
    }
}

// The plain `//` block at the top of the file. It describes the module rather
// than any one thing in it, which is why it is not spelled `///`.
module_blurb(lines: str[], i: int, acc: str[]) -> str[] {
    if i >= lines.length() || !is_plain_comment(lines.get(i)) {
        acc
    } else {
        module_blurb(lines, i + 1, acc ++ [comment_body(lines.get(i))])
    }
}

// A fourth slash means it isn't one. `//// ----` is a section rule someone
// drew, and rustdoc excludes it for the same reason: publishing a private
// helper because a rule happened to sit above it is exactly what `///` is here
// to prevent.
is_doc(line: str) -> bool =>
    line.starts_with("///") && !line.starts_with("////")

is_plain_comment(line: str) -> bool =>
    line.starts_with("//") && !is_doc(line)

// A comment line with its marker gone and one space after it eaten. Any
// further indent is kept: an indented run inside a block is an example, and
// the renderer needs to be able to see that.
comment_body(line: str) -> str {
    body = drop_slashes(line, 0)

    if body.starts_with(" ") {
        body.slice(1, body.length())
    } else {
        body
    }
}

drop_slashes(line: str, i: int) -> str {
    if i < line.length() && line.at(i) == "/" {
        drop_slashes(line, i + 1)
    } else {
        line.slice(i, line.length())
    }
}

// Walk the file, gathering a `///` run and attaching it to the declaration
// directly below it. Anything else (a blank line, an ordinary comment, a line
// that declares nothing) throws the run away, so a doc block can never drift
// onto whatever happens to follow it.
scan(lines: str[], i: int, doc: str[], acc: Item[]) -> Item[] {
    if i >= lines.length() {
        warn_orphan(doc, i)
        acc
    } else if is_doc(lines.get(i)) {
        scan(lines, i + 1, doc ++ [comment_body(lines.get(i))], acc)
    } else if doc.length() == 0 {
        scan(lines, i + 1, [], acc)
    } else if !is_decl(lines.get(i)) {
        warn_orphan(doc, i)
        scan(lines, i + 1, [], acc)
    } else {
        scan(lines, i + 1, [], acc ++ [declared(lines, i, doc)])
    }
}

// Dropping the block is what stops it drifting onto whatever follows. Dropping
// it in silence is how an item goes missing from the reference with nobody the
// wiser, so it is dropped out loud.
warn_orphan(doc: str[], at: int) -> bool {
    if doc.length() == 0 {
        true
    } else {
        warn("line {at + 1}: doc comment attached to nothing: {doc.get(0)}")
        false
    }
}

is_decl(line: str) -> bool =>
    is_fn(line) || is_binding(line)

// What this line declares. A record and a sum both begin `Name = `, and what
// follows decides which.
declared(lines: str[], i: int, doc: str[]) -> Item {
    line = lines.get(i)
    at = i + 1

    if is_fn(line) {
        Item { kind = "fn", name = before(line, "("),
               sig = signature(lines, i), line = at, doc = doc }
    } else if rhs(line).starts_with("\{") {
        Item { kind = "record", name = before(line, " ="),
               sig = record_sig(lines, i), line = at, doc = doc }
    } else if is_union(rhs(line)) {
        Item { kind = "sum", name = before(line, " ="), sig = line.trim(),
               line = at, doc = doc }
    } else {
        Item { kind = "const", name = before(line, " ="),
               sig = line.trim(), line = at, doc = doc }
    }
}

// A union of variant names, which is what a sum declaration is.
//
// Asking whether the right-hand side merely contains a `|` called
// `Pipe = "a|b"` a sum. That was cosmetic until a type could be linked to from
// a signature, at which point a string constant became a link target for every
// mention of its name.
is_union(r: str) -> bool {
    parts = split_top(r, 0, 0, false, "", [])

    parts.length() > 1 && all_variants(parts, 0)
}

// Split on `|` outside a string literal. A sum's variants cannot contain one,
// so anything that does is not a union however it is punctuated.
split_top(r: str, i: int, depth: int, in_str: bool, cur: str,
          acc: str[]) -> str[] {
    if i >= r.length() {
        acc.push(cur)
    } else {
        c = r.at(i)

        if c == "\"" {
            split_top(r, i + 1, depth, !in_str, cur ++ c, acc)
        } else if in_str {
            split_top(r, i + 1, depth, in_str, cur ++ c, acc)
        } else if c == "(" {
            split_top(r, i + 1, depth + 1, in_str, cur ++ c, acc)
        } else if c == ")" {
            split_top(r, i + 1, depth - 1, in_str, cur ++ c, acc)
        } else if c == "|" && depth == 0 {
            split_top(r, i + 1, depth, in_str, "", acc.push(cur))
        } else {
            split_top(r, i + 1, depth, in_str, cur ++ c, acc)
        }
    }
}

all_variants(parts: str[], i: int) -> bool {
    if i >= parts.length() {
        true
    } else if is_variant_name(parts.get(i).trim()) {
        all_variants(parts, i + 1)
    } else {
        false
    }
}

// `Red` or `Circle(int, int)`: a capitalised name, optionally with a payload.
is_variant_name(p: str) -> bool {
    head = p.contains("(") ? before(p, "(") : p

    head.length() > 0 && !is_lower(head.at(0)) && is_ident(head.trim())
}

// `name(params) -> R` at column zero. Indented means it is inside something.
is_fn(line: str) -> bool {
    if line.starts_with(" ") || !line.contains("(") {
        false
    } else {
        head = before(line, "(")
        head.length() > 0 && is_lower(head.at(0)) && is_ident(head)
    }
}

// `Name = …` at column zero: a type or a constant.
is_binding(line: str) -> bool {
    if line.starts_with(" ") || !line.contains(" = ") {
        false
    } else {
        head = before(line, " =")
        head.length() > 0 && !is_lower(head.at(0)) && is_ident(head)
    }
}

is_lower(c: str) -> bool =>
    c.is_alpha() && c.lower() == c

is_ident(s: str) -> bool =>
    all_chars_ident(s.chars(), 0)

all_chars_ident(cs: str[], i: int) -> bool {
    if i >= cs.length() {
        true
    } else if cs.get(i).is_alpha() || cs.get(i).is_ascii_digit() {
        all_chars_ident(cs, i + 1)
    } else if cs.get(i) == "_" {
        all_chars_ident(cs, i + 1)
    } else {
        false
    }
}

before(s: str, sep: str) -> str {
    at = s.index_of(sep)

    if at < 0 {
        s.trim()
    } else {
        s.slice(0, at).trim()
    }
}

rhs(line: str) -> str {
    at = line.index_of(" = ")

    if at < 0 {
        ""
    } else {
        line.slice(at + 3, line.length())
    }
}

// A function's signature is everything before the body (the `{` of a block or
// the `=>` of an arrow), so the reader sees the types and nothing else.
//
// A parameter list that wraps is joined back up first. Reading one line and
// stopping published `wrapped(alpha: int,` as the signature: an unbalanced
// paren, no return type, and no complaint.
signature(lines: str[], i: int) -> str =>
    cut_body(whole_head(lines, i, ""))

whole_head(lines: str[], i: int, acc: str) -> str {
    if i >= lines.length() {
        acc
    } else {
        so_far = appended(acc, lines.get(i))

        if paren_depth(so_far.chars(), 0, 0) > 0 {
            whole_head(lines, i + 1, so_far)
        } else {
            so_far
        }
    }
}

appended(acc: str, line: str) -> str {
    if acc == "" {
        line.trim()
    } else {
        acc ++ " " ++ line.trim()
    }
}

paren_depth(cs: str[], i: int, n: int) -> int {
    if i >= cs.length() {
        n
    } else if cs.get(i) == "(" {
        paren_depth(cs, i + 1, n + 1)
    } else if cs.get(i) == ")" {
        paren_depth(cs, i + 1, n - 1)
    } else {
        paren_depth(cs, i + 1, n)
    }
}

cut_body(head: str) -> str {
    cut = first_of(head.index_of("=>"), head.index_of("\{"))

    if cut < 0 {
        head
    } else {
        head.slice(0, cut).trim()
    }
}

first_of(a: int, b: int) -> int {
    if a < 0 {
        b
    } else if b < 0 {
        a
    } else if a < b {
        a
    } else {
        b
    }
}

// A record's declaration is usually several lines, and the fields are the
// point of it. One written on a single line closes on that line, and looking
// for a `}` of its own would swallow the rest of the file.
record_sig(lines: str[], i: int) -> str {
    if lines.get(i).trim().ends_with("\}") {
        lines.get(i).trim()
    } else {
        gather(lines, i, i + 1)
    }
}

gather(lines: str[], from: int, i: int) -> str {
    if i >= lines.length() || lines.get(i).trim() == "\}" {
        lines.slice(from, i + 1).join("\n")
    } else {
        gather(lines, from, i + 1)
    }
}

// ---- prose ----------------------------------------------------------------
//
// A comment block is not one paragraph. Blank lines separate it into blocks,
// and a block that is indented in the source is an example. The module
// headers all end with the `import` line you need, and running that together
// with the sentence above it would be the one thing a reference must not do.
//
// An example is code, so it is coloured by the scanner the handbook uses,
// exactly as the signature above it is. A signature in ten colours over a grey
// wall of text read as two different languages on one page, and the grey half
// was the half a reader came to copy.

prose(ls: str[]) -> str =>
    blocks(ls, 0, [], "")

// A fence is taken whole, blank lines included: the run belongs to the block,
// not to the paragraphs around it.
blocks(ls: str[], i: int, cur: str[], out: str) -> str {
    if i >= ls.length() {
        out ++ block(cur)
    } else if is_fence(ls.get(i)) {
        stop = fence_end(ls, i + 1)
        fenced = code_block(fence_tag(ls.get(i)),
                            ls.slice(i + 1, stop).join("\n"))
        blocks(ls, stop + 1, [], out ++ block(cur) ++ fenced)
    } else if ls.get(i).trim() == "" {
        blocks(ls, i + 1, [], out ++ block(cur))
    } else {
        blocks(ls, i + 1, cur ++ [ls.get(i)], out)
    }
}

block(ls: str[]) -> str {
    if ls.length() == 0 {
        ""
    } else if ls.get(0).starts_with(" ") {
        code_block("maca", dedent(ls.join("\n")))
    } else {
        p(class=ProseClass, inline(ls.join(" ")))
    }
}

// One block of code, tokenized by `apps/tomo/highlight.maca`.
//
// The scanner escapes every token it emits, which is why nothing here escapes
// again: doing both turns a `str[]` in an example into `&amp;lt;`.
code_block(lang: str, src: str) -> str =>
    pre(class=PreClass, code(class=Mono, highlight(lang, src)))

is_fence(line: str) -> bool =>
    line.trim().starts_with("```")

fence_end(ls: str[], i: int) -> int {
    if i >= ls.length() || is_fence(ls.get(i)) {
        i
    } else {
        fence_end(ls, i + 1)
    }
}

// The language a fence declares. A tag the highlighter doesn't know falls
// through to escaped plain text, which is the handbook's rule too: a block
// rendered unstyled is honest, and one mangled by rules written for another
// language is not.
//
// A fence with no tag is Maca, because the default language of a comment in a
// `.maca` file is the language of the file. That is the same reason an
// indented run, which cannot carry a tag at all, is read as Maca.
fence_tag(line: str) -> str {
    t = line.trim()
    tag = t.slice(3, t.length()).trim()

    if tag == "" {
        "maca"
    } else {
        tag
    }
}

// Backtick spans become `<code>` and `*starred*` runs become `<em>`. Nothing
// else is markup, because nothing else is what these comments use, and a
// marker that renders as itself is worse than no marker at all.
inline(s: str) -> str =>
    spans(paired(s.split("`"), "`"), 0, "")

spans(parts: str[], i: int, out: str) -> str {
    if i >= parts.length() {
        out
    } else if i % 2 == 1 {
        span = code(class=CodeSpan, escape_html(parts.get(i)))
        spans(parts, i + 1, out ++ span)
    } else {
        starred = paired(parts.get(i).split("*"), "*")
        spans(parts, i + 1, out ++ emphasis(starred, 0, ""))
    }
}

emphasis(parts: str[], i: int, out: str) -> str {
    if i >= parts.length() {
        out
    } else if i % 2 == 0 {
        emphasis(parts, i + 1, out ++ escape_html(parts.get(i)))
    } else if is_emphasis(parts.get(i)) {
        emphasis(parts, i + 1, out ++ em(escape_html(parts.get(i))))
    } else {
        emphasis(parts, i + 1, out ++ "*" ++ escape_html(parts.get(i)) ++ "*")
    }
}

// Markdown's rule, and the one that tells emphasis from arithmetic: a `*` opens
// only when something follows it immediately and closes only when something
// precedes it immediately. Without it, `2 * 3 * 4` italicised the space between
// the operators and `a * b` italicised the rest of the sentence.
is_emphasis(body: str) -> bool =>
    body != "" && !body.starts_with(" ") && !body.ends_with(" ")

// An odd number of delimiters means the last one opened something that never
// closed: a multiplication sign in prose, or a backtick someone forgot. The
// tail is joined back onto the part before it, so it stays plain text instead
// of italicising the rest of the paragraph.
paired(parts: str[], sep: str) -> str[] {
    if parts.length() % 2 == 1 {
        parts
    } else {
        n = parts.length()
        str_take(parts, n - 2)
            .push(parts.get(n - 2) ++ sep ++ parts.get(n - 1))
    }
}

// ---- rendering ------------------------------------------------------------

// The top bar spans the whole layout below it, sidebar included, so its own
// width is the grid's: two tracks and the gap between them.
Wrap = "max-w-[78rem] mx-auto px-6"

// The reading column with the navigation beside it. Below the `md` breakpoint
// the grid becomes one column and the sidebar, being first in the document,
// lands above the text as a disclosure.
Shell = "grid grid-cols-[16rem_minmax(0,52rem)] gap-10 justify-center px-6"
    ++ " py-10 max-md:block max-md:max-w-[52rem] max-md:mx-auto max-md:px-5"

// A code block: an outlined panel rather than a grey slab, so it reads as a
// thing on the page instead of a hole in it. The token colours are checked
// against a light and a dark surface in `code_css()`, and both of these are
// inside that range.
PreClass = "mt-3 bg-zinc-50 dark:bg-zinc-900 rounded-lg border"
    ++ " border-zinc-200 dark:border-zinc-800 p-4 overflow-x-auto"
    ++ " text-[0.85rem] m-0"

// The signature, which is the thing a reader came for: the same panel, a
// little larger and a little tighter to the heading above it.
SigClass = "mt-3 bg-zinc-50 dark:bg-zinc-900 rounded-lg border"
    ++ " border-zinc-200 dark:border-zinc-800 px-4 py-3 overflow-x-auto"
    ++ " text-[0.9rem] m-0"

// Prose in a reference is read one paragraph at a time, so it is set at a
// measure rather than at the width of whatever is beside it.
ProseClass = "mt-3 text-[0.95rem] leading-relaxed text-zinc-600"
    ++ " dark:text-zinc-400 m-0"

Measure = "max-w-[42rem]"

// A column of evenly spaced blocks, and the reason it is not a bare `grid`.
//
// A grid's implicit column is `auto`, which means "as wide as your widest
// child", and a child here is a signature in a `<pre>`. So the track grew past
// the viewport, and a phone scrolled sideways with the prose cut off at the
// right edge: `overflow-x-auto` on the block cannot help, because by then the
// track it sits in is already too wide. `minmax(0,1fr)` is what lets it shrink,
// and `grid-cols-1` is how that is spelled.
Stack = "grid grid-cols-1"


// Every page in the reference sits directly in the output directory, so there
// is one level to climb to reach the site root and no parameter to carry it.
// That is the `../` the font link is given: the rest of the site is set in
// Pretendard, and a reference in a different face reads as a different site.
//
// `code_css()` is here beside the generated utilities because the token colours
// cannot be utilities: `text-…` takes a named colour, and the named set that
// clears 4.5:1 on a code block is one hue. `apps/tomo/highlight.maca` writes
// them out and both this and the handbook include them.
page(title: str, side: str, body: str) -> str =>
    "<!doctype html>\n"
        ++ html(lang="en",
            head(
                meta(charset="utf-8")
                meta(name="viewport",
                     content="width=device-width,initial-scale=1")
                title_tag(title)
                font_link("../")
                style(base_css() ++ code_css() ++ doc_css() ++ styles())
            )
            body_tag(page_class("font-sans"),
                top_bar(title)
                    ++ div(class=Shell, side ++ element("main", body))
                    ++ hover_card()
                    ++ nav_script()))
        ++ "\n"

// The script is last on purpose, and it used to sit inside the sidebar. A
// `<script>` runs where it is parsed, so from there it looked for the card and
// for the items and found neither: both are written after the sidebar, and
// `getElementById` on an element the parser has not reached yet answers null.
// The search worked, which is why it read as fine.

// The bar stays put, because a reference is read by scrolling a long page and
// the way back to the index should not be at the top of it. Anything it can
// cover is offset by `scroll-mt-…`, or an `#anchor` lands underneath it.
top_bar(title: str) -> str =>
    header(class="sticky top-0 z-40 bg-white dark:bg-zinc-950 border-b"
                 ++ " border-zinc-200 dark:border-zinc-800",
        div(class=Wrap ++ " flex flex-wrap items-center justify-between"
                  ++ " gap-x-4 gap-y-2 py-3",
            nav(aria-label="Reference",
                class="flex items-center gap-2 text-[0.9rem]",
                a(class="font-bold no-underline text-inherit focus:underline",
                  href="../index.html", "Maca")
                span(class="text-zinc-300 dark:text-zinc-700", "/")
                a(class="no-underline text-zinc-600 dark:text-zinc-400"
                        ++ " hover:text-black dark:hover:text-white"
                        ++ " focus:underline",
                  href="index.html", "API reference"))
            span(class="font-mono text-[0.85rem] text-zinc-500"
                       ++ " dark:text-zinc-400",
                 escape_html(title))))

// The card the hover script fills in and puts under whatever is being pointed
// at or focused.
//
// It is written here as markup, and that is the whole reason it exists as an
// element rather than as three lines of `createElement`. `styles()` generates a
// rule for exactly the utilities a `class=` in this module names, and it does
// not look inside a raw `"""…"""` block, so a card assembled in the script
// would carry classes with no rules and arrive unstyled and unpositioned.
//
// It ships empty and `hidden`. With no script it is a `<div>` that never shows
// and the link it would have described still works, which is the whole
// requirement: the card is an affordance, not the content.
hover_card() -> str =>
    div(id="macadoc-card", hidden=true,
        class="absolute z-50 max-w-[26rem] pointer-events-none rounded-lg"
              ++ " border border-zinc-200 dark:border-zinc-700 shadow-lg"
              ++ " bg-white dark:bg-zinc-900 p-3",
        pre(class="m-0 overflow-x-auto text-[0.8rem]",
            code(class=Mono, ""))
        p(class="mt-2 mb-0 text-[0.8rem] text-zinc-600 dark:text-zinc-400",
          ""))

// The index: every module, its blurb, and how many things it documents.
index_page(ms: Module[]) -> str =>
    page("API reference", sidebar(ms, ""),
         section(class="py-2",
             p(class="text-[0.75rem] uppercase tracking-widest text-zinc-500"
                     ++ " dark:text-zinc-400 m-0",
               "Reference")
             h1(class="mt-1 font-bold text-[2.1rem] tracking-tight m-0",
                "API reference")
             p(class=ProseClass ++ " " ++ Measure,
               "Every module of the standard library, generated from the"
                   ++ " source by " ++ code(class=CodeSpan,
                                            "tools/macadoc.maca") ++ ". Press "
                   ++ element("kbd", class=KbdClass, "/") ++ " to search.")
             div(class=Stack ++ " mt-8 gap-4", module_cards(ms, 0))))

Mono = "font-mono text-[0.9em]"

// A key, drawn as one. It is the search hint on the index and again in the
// sidebar, so it is named once.
KbdClass = "font-mono text-[0.7rem] px-1 py-[0.05rem] rounded border"
    ++ " border-zinc-300 dark:border-zinc-700 text-zinc-500"
    ++ " dark:text-zinc-400"

module_cards(ms: Module[], i: int) -> str {
    if i >= ms.length() {
        ""
    } else {
        module_card(ms.get(i)) ++ module_cards(ms, i + 1)
    }
}

module_card(m: Module) -> str =>
    a(class="block no-underline text-inherit rounded-xl border"
            ++ " border-zinc-200 dark:border-zinc-800 p-5 hover:bg-zinc-50"
            ++ " dark:hover:bg-zinc-900 hover:border-zinc-300"
            ++ " dark:hover:border-zinc-700",
      href=m.name ++ ".html",
      div(class="flex items-baseline justify-between gap-4",
          span(class="font-mono font-semibold", escape_html(m.path))
          span(class="text-[0.8rem] text-zinc-500 dark:text-zinc-400",
               counted(m.items.length())))
      p(class=ProseClass, inline(first_sentence(m.blurb))))

counted(n: int) -> str {
    if n == 1 {
        "1 item"
    } else {
        "{n} items"
    }
}

// A module's card gets one line: the first sentence of the first paragraph.
//
// Not called `summary`, though that is what it is, because `<summary>` is the
// label of a disclosure and the sidebar needs one per module: a top-level
// definition shadows a tag of the same name for the whole file, and there is no
// way to write past it.
//
// `str_find_index` answers -1 when no line is blank, and `str_take(ls, -1)`
// clamps to zero, so a blurb written as one paragraph produced an empty card
// rather than its first sentence. The std modules all happen to have a blank
// line; nothing made them.
first_sentence(ls: str[]) -> str {
    blank = str_find_index(ls, l => l.trim() == "")
    end = if blank < 0 { ls.length() } else { blank }
    para = str_take(ls, end).join(" ")
    at = para.index_of(". ")

    if at < 0 {
        para
    } else {
        para.slice(0, at + 1)
    }
}

module_page(ms: Module[], m: Module) -> str =>
    page(m.path, sidebar(ms, m.name),
         section(class="py-2",
             p(class="text-[0.75rem] uppercase tracking-widest text-zinc-500"
                     ++ " dark:text-zinc-400 m-0",
               "Module")
             div(class="mt-1 flex flex-wrap items-baseline justify-between"
                       ++ " gap-3",
                 h1(class="font-mono font-bold text-[1.7rem] tracking-tight"
                          ++ " m-0",
                    escape_html(m.path))
                 span(class="flex items-center gap-3",
                      span(class="text-[0.8rem] text-zinc-500"
                                 ++ " dark:text-zinc-400",
                           counted(m.items.length()))
                      source_link(m.path, 0, "source")))
             div(class=Measure, prose(m.blurb))
             div(class=Stack ++ " mt-10 gap-6", entries(ms, m, m.items, 0))))

entries(ms: Module[], m: Module, items: Item[], i: int) -> str {
    if i >= items.length() {
        ""
    } else {
        entry(ms, m, items.get(i)) ++ entries(ms, m, items, i + 1)
    }
}

// One item, as a panel of its own: a header line, the signature set apart, and
// the prose at a measure. Running them together is what made the old page one
// undifferentiated column, where the only way to find where an item began was
// to read until something stopped making sense.
//
// The heading is its own jump link, which is what makes a signature something a
// reader can send to somebody else: the name in the heading and the name in the
// sidebar address the same `id`. `#` beside it is the same link again, spelled
// the way a reader recognises "copy this address".
entry(ms: Module[], m: Module, it: Item) -> str =>
    article(id=it.name, class=ItemClass,
        div(class="flex flex-wrap items-center justify-between gap-x-3"
                  ++ " gap-y-2",
            div(class="flex items-center gap-3",
                h2(class="font-mono font-semibold text-[1.05rem] m-0",
                   a(class="no-underline text-inherit hover:underline",
                     href="#" ++ it.name, escape_html(it.name)))
                span(data-kind=it.kind, class=badge_class(it.kind),
                     kind_word(it.kind)))
            div(class="flex items-center gap-3",
                anchor_link(it.name)
                source_link(m.path, it.line, "source")))
        signature_block(ms, m, it)
        div(class=Measure, prose(it.doc)))

// The item's own address, offered as something to copy. `scroll-mt-…` on the
// panel is what keeps the sticky bar off whatever it lands on.
ItemClass = "scroll-mt-20 rounded-xl border border-zinc-200"
    ++ " dark:border-zinc-800 p-5 max-sm:p-4"

anchor_link(name: str) -> str =>
    a(class="no-underline font-mono text-[0.8rem] text-zinc-400"
            ++ " dark:text-zinc-600 hover:text-violet-600"
            ++ " dark:hover:text-violet-300 focus:underline",
      href="#" ++ name, title="Link to " ++ name, "#")

// The signature twice over: as tokens for a reader, and as text in `data-sig`.
//
// Highlighting turns `-> str[]` into four spans, and a span is not text: the
// search box above matches names and types out of `data-sig`, and anything else
// reading the page gets the declaration without reassembling markup. The tokens
// come from `apps/tomo/highlight.maca`, the scanner the handbook uses, so a
// signature here is coloured by the same rules as a signature in a chapter.
signature_block(ms: Module[], m: Module, it: Item) -> str =>
    pre(class=SigClass, data-sig=flat(it.sig),
        code(class=Mono,
             cross_linked(highlight("maca", it.sig), ms, m.name, it.name)))

// ---- cross-links ----------------------------------------------------------

// A type named in a signature, linked to the declaration it names.
//
// This reads the highlighter's *output* rather than the source. The scanner has
// already decided which words are types, following the lexer to do it; deciding
// again here, with a second set of rules, is how the two answers drift apart.
// So every `tok-ty` span whose text is a documented record or sum becomes a
// link, and nothing else is touched.
TySpan = "<span class=\"tok-ty\">"

// `here` is the module being written and `own` the item being written, which is
// excluded: a record's declaration opens with its own name, and linking that to
// the heading directly above it is a link with nowhere to go.
cross_linked(html: str, ms: Module[], here: str, own: str) -> str {
    parts = html.split(TySpan)

    linked_spans(parts, 1, ms, here, own, parts.get(0))
}

linked_spans(parts: str[], i: int, ms: Module[], here: str, own: str,
             out: str) -> str {
    if i >= parts.length() {
        out
    } else {
        linked_spans(parts, i + 1, ms, here, own,
                     out ++ TySpan ++ linked_span(parts.get(i), ms, here, own))
    }
}

// One span's worth: the type's name, then `</span>`, then whatever followed it.
//
// A span always closes, because `tok` writes both halves or neither. If one ever
// did not, `index_of` answers -1 and `slice(0, -1)` is "", which is the name of
// nothing documented, so the part goes back out as it came in. There is no
// branch for it because there is nothing for the branch to do differently.
linked_span(part: str, ms: Module[], here: str, own: str) -> str {
    at = part.index_of("</span>")
    name = part.slice(0, at)
    where = declaring_module(ms, here, name)

    if name == own || where == "" {
        part
    } else {
        a(class="no-underline text-inherit underline-offset-2"
                ++ " hover:underline focus:underline",
          href=item_href(where, name, where == here),
          data-mod=where, data-item=name, name)
            ++ part.slice(at, part.length())
    }
}

// The module documenting a record or a sum of this name, or "".
//
// A function or a constant is not a type, and a `tok-ty` span in a signature is
// in type position, so those two kinds cannot be what it names however well the
// name matches.
//
// `here`, the module being written, is asked first. Two modules may each
// declare a `Point`, and a signature written in one of them means its own:
// taking the first match in the list sent every one of those links to whichever
// module happened to be documented first, so the reader landed on a record with
// different fields and nothing on the page said so.
declaring_module(ms: Module[], here: str, name: str) -> str {
    if declares_in(ms, 0, here, name) {
        here
    } else {
        first_declaring(ms, 0, name)
    }
}

declares_in(ms: Module[], i: int, here: str, name: str) -> bool {
    if i >= ms.length() {
        false
    } else if ms.get(i).name == here {
        declares_type(ms.get(i).items, 0, name)
    } else {
        declares_in(ms, i + 1, here, name)
    }
}

first_declaring(ms: Module[], i: int, name: str) -> str {
    if i >= ms.length() {
        ""
    } else if declares_type(ms.get(i).items, 0, name) {
        ms.get(i).name
    } else {
        first_declaring(ms, i + 1, name)
    }
}

declares_type(items: Item[], i: int, name: str) -> bool {
    if i >= items.length() {
        false
    } else if items.get(i).name != name {
        declares_type(items, i + 1, name)
    } else {
        items.get(i).kind == "record" || items.get(i).kind == "sum"
    }
}

// A declaration on one line. A record's spans several, and a reader searching
// for `second: str` should find it however the source laid it out.
flat(s: str) -> str =>
    squeezed(s.replace("\n", " ").chars(), 0, "").trim()

squeezed(cs: str[], i: int, out: str) -> str {
    if i >= cs.length() {
        out
    } else if cs.get(i) == " " && out.ends_with(" ") {
        squeezed(cs, i + 1, out)
    } else {
        squeezed(cs, i + 1, out ++ cs.get(i))
    }
}

// The kind, said in the word a reader knows it by. `data-kind` beside it keeps
// the short form the source uses, so anything reading the page reads structure
// rather than a label that is free to change.
kind_word(kind: str) -> str {
    if kind == "fn" {
        "function"
    } else if kind == "record" {
        "record"
    } else if kind == "sum" {
        "sum type"
    } else {
        "constant"
    }
}

// Shape from the utilities, hue from `doc_css()`. The colour is the reason a
// reader can tell a record from a function without reading either, which is
// what a page of forty items needs.
badge_class(kind: str) -> str =>
    "px-2 py-[0.1rem] rounded-full text-[0.7rem] uppercase tracking-wide"
        ++ " border font-semibold kind-" ++ kind

// The two rules on this page a utility cannot express, and why each is here.
//
// The kind hues, first. Colour is otherwise a Tailwind utility, but `text-…`
// takes a *named* colour, and the named set in the engine that clears 4.5:1 on
// a white background is one hue: four kinds cannot be told apart in one. This
// is the same wall `code_css()` hit, so it is written the same way, and each of
// the eight is contrast-checked against white in light and `bg-zinc-950` in
// dark. Only `color` and `border-color` are set, and no utility on the badge
// touches either, so the two never race.
//
// Then the row the reader is currently at, which the script marks with
// `aria-current` because that is what the attribute means. No variant in the
// utility engine reaches an attribute. The selector carries a tag name so it
// outranks the single-class `text-zinc-600` already on the link, whichever way
// round the stylesheet happens to be assembled.
doc_css() -> str =>
    """.kind-fn { color: #6d28d9; border-color: #ddd6fe }
.kind-record { color: #0e7490; border-color: #a5f3fc }
.kind-sum { color: #b45309; border-color: #fde68a }
.kind-const { color: #047857; border-color: #a7f3d0 }
a[aria-current="true"] { background-color: #f4f4f5; color: #18181b }
@media (prefers-color-scheme: dark) {
.kind-fn { color: #c4b5fd; border-color: #5b21b6 }
.kind-record { color: #67e8f9; border-color: #155e75 }
.kind-sum { color: #fcd34d; border-color: #92400e }
.kind-const { color: #6ee7b7; border-color: #065f46 }
a[aria-current="true"] { background-color: #27272a; color: #fafafa }
}
"""

// The declaration in the repository, at its line. A generated page is a summary
// of source, and the question it cannot answer is "how".
source_link(path: str, line: int, label: str) -> str =>
    a(class="no-underline text-zinc-500 dark:text-zinc-400 text-[0.75rem]"
            ++ " hover:underline",
      href=source_url(path, line), label)

// Line 0 means the file rather than a place in it.
source_url(path: str, line: int) -> str {
    if line <= 0 {
        Repo ++ "/blob/main/" ++ path
    } else {
        Repo ++ "/blob/main/" ++ path ++ "#L{line}"
    }
}

// ---- the sidebar ----------------------------------------------------------
//
// Every module and every item of every module, on every page. A reference is
// read by looking one thing up and then a second thing, and going back to an
// index between them is the whole cost this is here to remove: from
// `text.html` a reader reaches `list/sort_by` in one click.
//
// It is also the search index. Filtering markup that is already on the page
// needs no separate index file, no `fetch` (so the reference still searches
// when opened straight off disk), and no markup built by script, which is what
// would otherwise carry classes the compiler never sees and never styles.

SideClass = "text-[0.85rem] sticky top-[4.5rem] self-start"
    ++ " max-h-[calc(100vh_-_6rem)]"
    ++ " overflow-y-auto overscroll-contain max-md:static max-md:max-h-none"
    ++ " max-md:mb-6 max-md:border-b max-md:border-zinc-200"
    ++ " max-md:dark:border-zinc-800"

// `cur` is the module whose page this is, or "" on the index. Its disclosure
// ships open and its items link within the page; every other module's link
// carries its file.
sidebar(ms: Module[], cur: str) -> str =>
    div(class=SideClass,
        details(data-doc="nav", open=true,
            summary(class="hidden max-md:block cursor-pointer py-2 list-none"
                          ++ " details-marker:hidden text-zinc-500",
                    "☰ Modules")
            search_box()
            div(class="mt-2", module_trees(ms, 0, cur))))

// The field, and the line that answers when nothing matches. Without it a query
// with no hits looks identical to a query the box never received.
//
// The `/` sitting in the field is a promise the script keeps: a reference is
// searched far more often than it is scrolled, and reaching for the mouse to
// start is the difference between looking something up and deciding not to.
// The key is drawn whether or not the script loads, and it is only a drawing,
// so a page with no script loses the shortcut and keeps the field.
search_box() -> str =>
    div(class="relative my-2",
        input(id="macadoc-search", type="search",
              placeholder="Search names and types",
              aria-label="Search names and types", autocomplete="off",
              class="w-full px-2 py-1 pr-7 border border-zinc-200"
                    ++ " dark:border-zinc-700 rounded bg-white"
                    ++ " dark:bg-zinc-900 text-[0.85rem]")
        span(class="absolute right-2 top-[0.35rem] pointer-events-none",
             element("kbd", class=KbdClass, "/")))
        ++ p(id="macadoc-empty", hidden=true,
             class="text-zinc-500 text-[0.8rem] my-1", "No matches.")

module_trees(ms: Module[], i: int, cur: str) -> str {
    if i >= ms.length() {
        ""
    } else {
        module_tree(ms.get(i), cur) ++ module_trees(ms, i + 1, cur)
    }
}

// The module whose page this is says so: its disclosure is open, and its name
// is the one thing in the column wearing the accent colour. Without it every
// module reads the same and the sidebar answers "what exists" but never "where
// am I".
module_tree(m: Module, cur: str) -> str {
    here = m.name == cur

    details(data-mod=m.name, open=here,
        summary(class="cursor-pointer py-1 rounded font-mono font-semibold"
                      ++ " text-[0.82rem] " ++ summary_class(here),
                escape_html(m.name))
        div(class="pb-2", kind_groups(m, here, 0)))
}

summary_class(here: bool) -> str {
    if here {
        "text-violet-600 dark:text-violet-300"
    } else {
        "hover:text-black dark:hover:text-white"
    }
}

// ---- grouping -------------------------------------------------------------

// The kinds in the order a reader scans for them. A module with none of a kind
// gets no heading for it.
Kinds = "fn record sum const"

kind_label(kind: str) -> str {
    if kind == "fn" {
        "Functions"
    } else if kind == "record" {
        "Records"
    } else if kind == "sum" {
        "Sum types"
    } else {
        "Constants"
    }
}

kind_groups(m: Module, here: bool, i: int) -> str {
    kinds = Kinds.split(" ")

    if i >= kinds.length() {
        ""
    } else {
        kind_group(m, here, kinds.get(i)) ++ kind_groups(m, here, i + 1)
    }
}

// The group carries `data-group` so the search can hide a heading whose rows
// have all gone.
kind_group(m: Module, here: bool, kind: str) -> str {
    got = of_kind(m.items, 0, kind, [])

    if got.length() == 0 {
        ""
    } else {
        div(data-group=kind,
            p(class="mt-3 mb-1 px-1 text-[0.7rem] uppercase tracking-wide"
                    ++ " text-zinc-500 dark:text-zinc-400",
              kind_label(kind))
            ul(class="list-none m-0 p-0", side_rows(m, got, here, 0)))
    }
}

of_kind(items: Item[], i: int, kind: str, acc: Item[]) -> Item[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind == kind {
        of_kind(items, i + 1, kind, acc ++ [items.get(i)])
    } else {
        of_kind(items, i + 1, kind, acc)
    }
}

side_rows(m: Module, items: Item[], here: bool, i: int) -> str {
    if i >= items.length() {
        ""
    } else {
        side_row(m, items.get(i), here)
            ++ side_rows(m, items, here, i + 1)
    }
}

// `data-sig` is what the search matches, so a query reaches a parameter or a
// return type and not only a name. It is on the row rather than the link
// because the row is what gets hidden.
//
// `data-brief` is the sentence the hover card reads. The row is the only place
// on the page that holds every module's items, so it is the only place a card
// over a link into *another* module can read from: the alternative is a second
// copy of the whole index, on every page, for the script alone.
side_row(m: Module, it: Item, here: bool) -> str =>
    li(data-item=it.name, data-sig=flat(it.sig),
       data-brief=plain(first_sentence(it.doc)), class="m-0",
       a(class="block px-2 py-[0.15rem] rounded no-underline font-mono"
               ++ " text-[0.8rem] text-zinc-600 dark:text-zinc-400"
               ++ " hover:bg-zinc-100 dark:hover:bg-zinc-800"
               ++ " hover:text-black dark:hover:text-white",
         href=item_href(m.name, it.name, here),
         data-mod=m.name, data-item=it.name, escape_html(it.name)))

// A card shows a sentence, not markup. The two markers prose uses would
// otherwise arrive in it as themselves, which is worse than no marker at all.
plain(s: str) -> str =>
    flat(s).replace("`", "").replace("*", "")

item_href(module: str, name: str, here: bool) -> str {
    if here {
        "#" ++ name
    } else {
        module ++ ".html#" ++ name
    }
}

// ---- behaviour ------------------------------------------------------------

// The four things the page cannot do as markup: collapse the sidebar on a
// phone, filter it, say which item the reader is currently at, and describe a
// linked name without going to it. Every one of them degrades to a working
// page: the disclosure ships open, the rows ship visible, no row is marked
// current, and the card stays hidden while the link it would have described
// still works.
//
// A module matching by name shows all of its items, because "what is in
// std/path" is the other question a reader types a module name to ask. That is
// why the match is computed per module and pushed down to its rows, rather than
// per row with the module inferred afterwards.
//
// The card reads the sidebar rather than a table of its own. The sidebar is the
// one thing on every page that holds every module's items, so a link into
// another module is answered from data already there; the alternative is
// shipping the index twice.
nav_script() -> str =>
    script("""
(function(){
  var nav=document.querySelector('details[data-doc="nav"]');
  if(nav&&window.matchMedia("(max-width:48rem)").matches)
    nav.removeAttribute("open");
  var q=document.getElementById("macadoc-search");
  var empty=document.getElementById("macadoc-empty");
  var mods=document.querySelectorAll('details[data-mod]');
  var was=[],i;
  for(i=0;i<mods.length;i++) was.push(mods[i].hasAttribute("open"));
  if(q) q.addEventListener("input",function(){
    var t=q.value.trim().toLowerCase(),shown=0,j;
    for(i=0;i<mods.length;i++){
      var m=mods[i],hits=0;
      var all=t===""||m.dataset.mod.toLowerCase().indexOf(t)>=0;
      var rows=m.querySelectorAll('li[data-item]');
      for(j=0;j<rows.length;j++){
        var hit=all||rows[j].dataset.sig.toLowerCase().indexOf(t)>=0;
        rows[j].hidden=!hit;
        if(hit) hits++;
      }
      var groups=m.querySelectorAll('div[data-group]');
      for(j=0;j<groups.length;j++)
        groups[j].hidden=!groups[j].querySelector('li[data-item]:not([hidden])');
      m.hidden=hits===0;
      m.open=t===""?was[i]:true;
      shown+=hits;
    }
    if(empty) empty.hidden=shown>0;
  });

  var card=document.getElementById("macadoc-card");
  var sig=card?card.querySelector("code"):null;
  var brief=card?card.querySelector("p"):null;
  function hide(){ if(card) card.hidden=true; }
  function rowFor(a){
    var m=a.getAttribute("data-mod"),n=a.getAttribute("data-item");
    if(!m||!n) return null;
    return document.querySelector(
      'details[data-mod="'+m+'"] li[data-item="'+n+'"]');
  }
  function show(a){
    var li=rowFor(a);
    if(!li||!card){ hide(); return; }
    sig.textContent=li.getAttribute("data-sig")||"";
    brief.textContent=li.getAttribute("data-brief")||"";
    card.hidden=false;
    var r=a.getBoundingClientRect();
    card.style.top=(r.bottom+window.pageYOffset+8)+"px";
    var room=window.pageXOffset+document.documentElement.clientWidth
      -card.offsetWidth-12;
    card.style.left=Math.max(window.pageXOffset+8,
      Math.min(r.left+window.pageXOffset,room))+"px";
  }
  function linkAt(e){
    return e.target&&e.target.closest?e.target.closest("a[data-item]"):null;
  }
  document.addEventListener("mouseover",function(e){
    var a=linkAt(e);
    if(a) show(a); else hide();
  });
  document.addEventListener("focusin",function(e){
    var a=linkAt(e);
    if(a) show(a); else hide();
  });

  var arts=document.querySelectorAll("article[id]");
  var own=document.querySelectorAll('li[data-item] a[href^="#"]');
  function spy(){
    var at="",k;
    for(k=0;k<arts.length;k++)
      if(arts[k].getBoundingClientRect().top<140) at=arts[k].id;
    for(k=0;k<own.length;k++){
      if(own[k].getAttribute("href")==="#"+at)
        own[k].setAttribute("aria-current","true");
      else own[k].removeAttribute("aria-current");
    }
  }
  window.addEventListener("scroll",function(){ hide(); spy(); },
    {passive:true});
  spy();

  document.addEventListener("keydown",function(e){
    var tag=e.target?e.target.tagName:"";
    if(e.key==="/"&&q&&tag!=="INPUT"&&tag!=="TEXTAREA"){
      e.preventDefault();
      if(nav) nav.open=true;
      q.focus();
      q.select();
    }else if(e.key==="Escape"){
      hide();
      if(q&&document.activeElement===q){
        q.value="";
        q.dispatchEvent(new Event("input"));
        q.blur();
      }
    }
  });
})();
""")




// ---- entry ----------------------------------------------------------------

Spec = command("macadoc", "an API reference, rendered from Maca source")
    .arg("out", "the directory to write the reference into")
    .rest("module", "the .maca files to document")

main(argv: str[]) -> int {
    got = parse(Spec, argv)

    if got.wants_help {
        info(help(Spec))
        0
    } else if got.error != "" {
        err(bad(got.error))
        1
    } else if from(got, 1).length() == 0 {
        // `rest` is satisfied by nothing, so the count is checked here: a run
        // with only an output directory otherwise wrote an index of no modules
        // and reported success.
        err(bad("macadoc: no modules given, so there is nothing to document"))
        1
    } else {
        generate(value(got, "out", ""), from(got, 1))
    }
}

generate(out: str, sources: str[]) -> int {
    modules = read_all(sources, 0, [])
    require_distinct_names(modules, 0)

    // Cleared, not merged into. A module that is renamed or dropped otherwise
    // leaves its old page behind, and the site build copies that page out and
    // publishes it forever.
    remove_dir(out)
    make_dir(out)

    write_file(join(out, "index.html"), index_page(modules))
    written = write_modules(out, modules, 0)

    info(ok("{written} modules, {total_items(modules, 0)} items → "
            ++ dim(out)))
    0
}

// Two modules with the same stem would claim the same page and the same card
// link, and the first would simply be gone. `a/text.maca b/text.maca` reported
// "2 modules" and wrote one file.
require_distinct_names(ms: Module[], i: int) -> bool {
    if i >= ms.length() {
        true
    } else if name_taken(ms, 0, i) {
        fail "two modules named {ms.get(i).name}: {ms.get(i).path}"
    } else {
        require_distinct_names(ms, i + 1)
    }
}

name_taken(ms: Module[], i: int, before: int) -> bool {
    if i >= before {
        false
    } else if ms.get(i).name == ms.get(before).name {
        true
    } else {
        name_taken(ms, i + 1, before)
    }
}

read_all(sources: str[], i: int, acc: Module[]) -> Module[] {
    if i >= sources.length() {
        acc
    } else {
        read_all(sources, i + 1, acc ++ [read_module(sources.get(i))])
    }
}

write_modules(out: str, ms: Module[], i: int) -> int {
    if i >= ms.length() {
        0
    } else {
        write_file(join(out, ms.get(i).name ++ ".html"),
                   module_page(ms, ms.get(i)))
        1 + write_modules(out, ms, i + 1)
    }
}

total_items(ms: Module[], i: int) -> int {
    if i >= ms.length() {
        0
    } else {
        ms.get(i).items.length() + total_items(ms, i + 1)
    }
}
