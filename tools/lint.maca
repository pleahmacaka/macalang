// lint — the Maca style linter, written in Maca.
//
// A port of the style half of `maca lint` (crates/driver/src/main.rs) into the
// language itself, extended to walk a directory so it can check a whole tree.
// The semantic half (type/effect diagnostics) stays in the compiler, which owns
// the checker; everything here is line-level style that Maca can judge for
// itself.
//
// Rules:
//   - a line over 80 columns (comments exempt — prose wraps differently)
//   - a single-line `if … { … }` block, which the style guide breaks apart
//   - trailing whitespace
//   - a hard tab (Maca indents with four spaces)
//
// Run it with:  maca run tools/lint.maca [path…]
// With no path it lints the repository's own Maca sources.


// ---- one file -------------------------------------------------------------

// Does this line hold a whole `if` block, opened and closed? The line must
// *start* with the keyword — an `if ` in the middle is a string or a comment
// (this very file mentions one), and a ternary `c ? a : b` legitimately fits
// on one line, so both are exempt.
single_line_if(line: str) -> bool {
    t = line.trim()
    opens = t.starts_with("if ") || t.starts_with("} else if ")
    opens && t.contains("\{") && t.ends_with("\}") && !t.contains("? ")
}

// The width rule exists so *code* stays readable at 80 columns. A long string
// literal is like a long comment — a C template, a URL, a test program — and
// rewrapping it would change or disfigure it. So the line is measured with its
// string literals collapsed: `info("…200 chars…")` counts as `info("")` and
// passes, while genuinely wide code still fails.
//
// `str.length()` counts bytes, so a UTF-8 comment would over-count; comments
// are exempt outright.
too_wide(line: str) -> bool =>
    !line.trim().starts_with("//") && collapse_strings(line).length() > 80

// Replace the contents of every `"…"` literal with nothing, keeping the quotes.
collapse_strings(line: str) -> str =>
    collapse(line.chars(), 0, false, "")

// `quoted` says whether we are inside a literal; the quote characters
// themselves are always kept, so an unterminated quote can't hide the line.
collapse(cs: str[], i: int, quoted: bool, acc: str) -> str {
    if i >= cs.length() {
        acc
    } else if cs.get(i) == "\\" && quoted {
        collapse(cs, i + 2, quoted, acc)           // an escape, e.g. `\"`
    } else if cs.get(i) == "\"" {
        collapse(cs, i + 1, !quoted, acc ++ "\"")
    } else if quoted {
        collapse(cs, i + 1, quoted, acc)           // the collapsed contents
    } else {
        collapse(cs, i + 1, quoted, acc ++ cs.get(i))
    }
}

has_trailing_space(line: str) -> bool =>
    line.length() > 0 && (line.ends_with(" ") || line.ends_with("\t"))

// Every complaint about one line, as text (empty when the line is clean).
line_issues(path: str, no: int, line: str) -> str =>
    say(path, no, too_wide(line), "line exceeds 80 columns")
        ++ say(path, no, single_line_if(line),
               "single-line `if` block; break it across lines")
        ++ space_issues(path, no, line)

// The rules that apply to any text, Maca or foreign.
space_issues(path: str, no: int, line: str) -> str =>
    say(path, no, has_trailing_space(line), "trailing whitespace")
        ++ say(path, no, line.contains("\t"),
               "hard tab; Maca indents with four spaces")

// One complaint, or nothing at all.
say(path: str, no: int, hit: bool, what: str) -> str {
    if hit {
        at(path, no) ++ what ++ "\n"
    } else {
        ""
    }
}

at(path: str, no: int) -> str =>
    path ++ ":" ++ str(no) ++ ": "

// Walk the file, threading whether we are inside a raw `"""…"""` block. Those
// hold foreign text — the CSS and JS a `.maca` UI carries inline — so the two
// rules about *Maca* code shape (width, single-line `if`) are suspended there,
// for the same reason a long string literal is exempt. Whitespace hygiene
// still applies: a trailing space is noise in any language.
scan_lines(path: str, lines: str[], i: int, raw: bool, acc: str) -> str {
    if i >= lines.length() {
        acc
    } else {
        line = lines.get(i)
        fence = odd_fence(line)
        found = if raw || fence {
            space_issues(path, i + 1, line)
        } else {
            line_issues(path, i + 1, line)
        }
        scan_lines(path, lines, i + 1, raw != fence, acc ++ found)
    }
}

// Does this line open or close a raw block? An odd number of `"""` flips the
// state; a one-line `"""x"""` has two and leaves it alone.
odd_fence(line: str) -> bool =>
    count_fences(line.chars(), 0, 0) % 2 == 1

count_fences(cs: str[], i: int, n: int) -> int {
    if i + 2 >= cs.length() {
        n
    } else if fence_at(cs, i) {
        count_fences(cs, i + 3, n + 1)
    } else {
        count_fences(cs, i + 1, n)
    }
}

fence_at(cs: str[], i: int) -> bool =>
    cs.get(i) == "\"" && cs.get(i + 1) == "\"" && cs.get(i + 2) == "\""

lint_file(path: str) -> str =>
    scan_lines(path, read_file(path).split("\n"), 0, false, "")

// ---- a directory tree -----------------------------------------------------

ends_with_maca(name: str) -> bool =>
    name.ends_with(".maca")

// Lint every `.maca` file under `dir`, recursively — `apps/` keeps each
// capstone in its own subdirectory, so one level isn't enough.
lint_dir(dir: str) -> str =>
    lint_entries(dir, list_dir(dir), 0, "")

lint_entries(dir: str, names: str[], i: int, acc: str) -> str {
    if i >= names.length() {
        acc
    } else {
        found = lint_entry(dir ++ "/" ++ names.get(i))
        lint_entries(dir, names, i + 1, acc ++ found)
    }
}

// A path is a directory exactly when `list_dir` finds something in it — there
// is no `is_dir` primitive, and an empty directory has nothing to lint anyway.
lint_entry(path: str) -> str {
    if ends_with_maca(path) {
        lint_file(path)
    } else if list_dir(path).length() > 0 {
        lint_dir(path)
    } else {
        ""
    }
}

// ---- counting -------------------------------------------------------------

// Issues are newline-terminated, so the count is the number of non-empty lines.
count_issues(report: str) -> int {
    if report.length() == 0 {
        0
    } else {
        count_nonempty(report.split("\n"), 0)
    }
}

count_nonempty(lines: str[], i: int) -> int {
    if i >= lines.length() {
        0
    } else if lines.get(i).length() > 0 {
        1 + count_nonempty(lines, i + 1)
    } else {
        count_nonempty(lines, i + 1)
    }
}

// ---- entry point ----------------------------------------------------------

// The repository's own Maca sources, when no path is given — Maca linting Maca.
// Every directory holding Maca source. Nothing is exempt: a style the codebase
// doesn't hold to isn't a style.
default_dirs() -> str[] =>
    ["examples", "selfhost", "tools", "std", "apps", "playground", "bench",
     "crates/driver/tests/programs"]

lint_all(dirs: str[], i: int, acc: str) -> str {
    if i >= dirs.length() {
        acc
    } else if !file_exists(dirs.get(i)) {
        lint_all(dirs, i + 1, acc)
    } else {
        lint_all(dirs, i + 1, acc ++ lint_dir(dirs.get(i)))
    }
}

main(args: str[]) -> int {
    report = report_for(args)
    n = count_issues(report)

    if n > 0 {
        report_issues(report, n)
    } else {
        clean()
    }
}

report_for(args: str[]) -> str {
    if args.length() == 0 {
        lint_all(default_dirs(), 0, "")
    } else if !file_exists(args.get(0)) {
        missing(args.get(0))
    } else {
        pick(args.get(0))
    }
}

// A path may be a single file or a directory; `list_dir` returns nothing for a
// file, so a `.maca` suffix decides.
pick(path: str) -> str {
    if ends_with_maca(path) {
        lint_file(path)
    } else {
        lint_dir(path)
    }
}

missing(path: str) -> str =>
    "lint: cannot read " ++ path ++ "\n"

report_issues(report: str, n: int) -> int {
    plural = if n == 1 { "" } else { "s" }

    print(report)
    info(str(n) ++ " issue" ++ plural)
    1
}

clean() -> int {
    info("clean")
    0
}
