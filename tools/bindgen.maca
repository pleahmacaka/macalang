// bindgen — generate Maca FFI declarations from a C header, written in Maca.
//
// A port of the stage-0 Rust implementation (crates/driver/src/bindgen.rs) into
// Maca itself: the compiler's tooling should be written in the language it
// compiles. It is a lightweight prototype scanner (no libclang) — strip
// comments and preprocessor lines, split what's left into `;`-terminated
// declarations, and turn each `RET NAME(PARAMS)` prototype into a Maca extern
// declaration `name(arg: T, …) -> R`.
//
// Type mapping: `char*` → `str`, other pointers → `int` (an opaque handle),
// `double`/`float` → `float`, and the integer family → `int`.
//
// Run it with:  maca run tools/bindgen.maca

import std/str

// ---- small string helpers -------------------------------------------------

// `index_of` from an offset — an absolute index, or -1.
index_from(s: str, pat: str, start: int) -> int {
    idx = s.substr(start, s.length() - start).index_of(pat)
    idx < 0 ? -1 : idx + start
}

// The index just past the last occurrence of `pat`, or -1 if absent.
last_index_of(s: str, pat: str) -> int =>
    scan_last(s, pat, 0, -1)

scan_last(s: str, pat: str, at: int, best: int) -> int {
    hit = index_from(s, pat, at)
    hit < 0 ? best : scan_last(s, pat, hit + 1, hit)
}

is_ident_char(c: str) -> bool =>
    c.is_alpha() || c.is_ascii_digit() || c == "_"

// ---- comment / preprocessor stripping -------------------------------------

// Drop `/* … */` blocks. Recurses on the remainder so several blocks go.
strip_blocks(s: str) -> str {
    open = s.index_of("/*")
    close = open < 0 ? -1 : index_from(s, "*/", open)
    close < 0
        ? s
        : s.substr(0, open) ++ " " ++ strip_blocks(s.substr(close + 2, s.length() - close - 2))
}

// Drop `//` line comments and `#` preprocessor lines.
strip_lines(lines: str[], i: int, acc: str) -> str =>
    i >= lines.length()
        ? acc
        : strip_lines(lines, i + 1, acc ++ clean_line(lines.get(i)) ++ "\n")

clean_line(line: str) -> str {
    cut = line.index_of("//")
    body = cut < 0 ? line : line.substr(0, cut)
    body.trim().starts_with("#") ? "" : body
}

strip(src: str) -> str =>
    strip_lines(strip_blocks(src).split("\n"), 0, "")

// ---- type mapping ---------------------------------------------------------

map_type(c: str) -> str {
    t = c.trim()
    t.contains("*")
        ? (t.contains("char") && !t.contains("char**") ? "str" : "int")
        : (t.contains("double") || t.contains("float") ? "float" : "int")
}

// A bare type keyword must not be mistaken for a parameter name — an unnamed
// `int` parameter's "last identifier" is `int` itself.
is_c_type_word(w: str) -> bool =>
    w == "void" || w == "int" || w == "char" || w == "short" || w == "long"
        || w == "float" || w == "double" || w == "unsigned" || w == "signed"
        || w == "size_t" || w == "bool"
        || w == "int8_t" || w == "int16_t" || w == "int32_t" || w == "int64_t"
        || w == "uint8_t" || w == "uint16_t" || w == "uint32_t" || w == "uint64_t"

// ---- identifier extraction ------------------------------------------------

// The trailing C identifier of a string (`const char *sqlite3_libversion` →
// `sqlite3_libversion`), skipping trailing `*` and spaces. "" when there is
// none, or when it starts with a digit.
last_ident(s: str) -> str {
    t = trim_trailing(s.trim())
    start = ident_start(t, t.length())
    id = t.substr(start, t.length() - start)
    id.length() == 0 || id.at(0).is_ascii_digit() ? "" : id
}

// Strip trailing `*` and whitespace.
trim_trailing(s: str) -> str =>
    s.length() == 0
        ? s
        : (s.ends_with("*") || s.ends_with(" ") || s.ends_with("\t")
            ? trim_trailing(s.substr(0, s.length() - 1))
            : s)

// Walk back over identifier characters to find where the last one starts.
ident_start(s: str, at: int) -> int =>
    at <= 0 || !is_ident_char(s.at(at - 1))
        ? at
        : ident_start(s, at - 1)

// ---- parameters -----------------------------------------------------------

map_params(params: str) -> str {
    p = params.trim()
    p.length() == 0 || p == "void" ? "" : join_params(p.split(","), 0)
}

join_params(ps: str[], i: int) -> str =>
    i >= ps.length()
        ? ""
        : (i == ps.length() - 1
            ? one_param(ps.get(i), i)
            : one_param(ps.get(i), i) ++ ", " ++ join_params(ps, i + 1))

one_param(raw_in: str, i: int) -> str {
    raw = raw_in.trim()
    id = last_ident(raw)
    // a bare type keyword isn't a name — synthesize `a0`, `a1`, …
    named = id.length() > 0 && !is_c_type_word(id)
    ty = named ? map_type(raw.substr(0, raw.length() - id.length())) : map_type(raw)
    name = named ? id : "a" ++ str(i)
    name ++ ": " ++ ty
}

// ---- prototypes -----------------------------------------------------------

// Is this declaration something other than a plain function prototype?
skip_decl(head: str, params: str, decl: str) -> bool =>
    head.contains("typedef") || head.contains("struct") || head.contains("enum")
        || head.contains("union") || params.contains("(*") || decl.contains("=")

// The Maca declaration for one `;`-separated chunk, or "" when it isn't a
// prototype.
prototype(chunk: str) -> str {
    decl = chunk.trim()
    open = decl.index_of("(")
    close = last_index_of(decl, ")")
    decl.length() == 0 || open < 0 || close < 0 || close < open
        ? ""
        : proto_parts(decl, open, close)
}

proto_parts(decl: str, open: int, close: int) -> str {
    head = decl.substr(0, open)
    params = decl.substr(open + 1, close - open - 1)
    name = last_ident(head)
    skip_decl(head, params, decl) || name.length() == 0
        ? ""
        : name ++ "(" ++ map_params(params) ++ ") -> "
              ++ map_type(head.substr(0, head.length() - name.length()))
}

// ---- generation -----------------------------------------------------------

// Every prototype in the cleaned source, one declaration per line.
decls(chunks: str[], i: int, acc: str) -> str {
    line = i >= chunks.length() ? "" : prototype(chunks.get(i))
    i >= chunks.length()
        ? acc
        : decls(chunks, i + 1, line.length() == 0 ? acc : acc ++ line ++ "\n")
}

generate(src: str, header_name: str) -> str {
    body = decls(strip(src).split(";"), 0, "")
    "// Generated by `bindgen " ++ header_name ++ "` — Maca FFI declarations.\n"
        ++ "// Pointers become opaque `int` handles; `char*` becomes `str`.\n"
        ++ "import c \"" ++ header_name ++ "\"\n\n"
        ++ (body.length() == 0 ? "// (no function prototypes found)\n" : body)
}

// ---- entry point ----------------------------------------------------------

main() -> int {
    // A sample header, so `maca run tools/bindgen.maca` demonstrates the tool
    // without needing an argument. Point `generate` at `read_file(path)` to
    // process a real header.
    sample = "/* a sample C header */\n"
        ++ "#include <stddef.h>\n"
        ++ "typedef struct sqlite3 sqlite3;\n"
        ++ "const char* sqlite3_libversion(void);\n"
        ++ "int sqlite3_open(const char *filename, sqlite3 **ppDb);\n"
        ++ "double sqlite3_column_double(sqlite3_stmt*, int iCol);\n"
        ++ "int sqlite3_close(sqlite3*);\n"

    info(generate(sample, "sqlite3.h"))
    0
}
