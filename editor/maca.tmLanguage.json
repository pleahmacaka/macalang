{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Maca",
  "scopeName": "source.maca",
  "fileTypes": ["maca"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#paths" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#function-def" },
    { "include": "#identifiers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "A doc comment is what makes an item API to macadoc, so it gets its own scope and a theme can set it apart from an ordinary remark.",
          "name": "comment.line.documentation.maca",
          "match": "///.*$"
        },
        { "name": "comment.line.double-slash.maca", "match": "//.*$" },
        {
          "name": "comment.block.maca",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.maca",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.maca", "match": "\\\\." },
        { "name": "constant.character.escape.maca", "match": "\\{\\{|\\}\\}" },
        {
          "name": "meta.embedded.interpolation.maca",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.maca" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.maca" } },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#keywords" },
            { "include": "#operators" },
            { "name": "variable.other.maca", "match": "[A-Za-z_][A-Za-z0-9_]*" }
          ]
        }
      ]
    },
    "paths": {
      "name": "string.other.path.maca",
      "match": "(?:\\.\\./|\\./|~/|/)[A-Za-z0-9_][A-Za-z0-9_./-]*"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.maca",
          "match": "\\b(if|else|for|in|while|break|continue|match|with|try|fail|await|spawn)\\b"
        },
        {
          "name": "keyword.other.maca",
          "match": "\\b(const|as|import|from|alias)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.maca",
      "match": "\\b(true|false)\\b"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.maca", "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b" },
        { "name": "constant.numeric.binary.maca", "match": "\\b0[bB][01][01_]*\\b" },
        { "name": "constant.numeric.octal.maca", "match": "\\b0[oO][0-7][0-7_]*\\b" },
        { "name": "constant.numeric.float.maca", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b" },
        { "name": "constant.numeric.integer.maca", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.maca",
          "match": "\\b(int|float|str|bool|bytes|unit|f32|f64|i8|i16|i32|i64|u8|u16|u32|u64)\\b"
        },
        {
          "name": "support.type.simd.maca",
          "match": "\\b[iuf](?:8|16|32|64)x(?:2|4|8|16|32|64)\\b"
        },
        {
          "name": "entity.name.type.maca",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "function-def": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.maca" } }
    },
    "identifiers": {
      "comment": "Idents may carry Nix-style internal hyphens (rust-analyzer, home-manager); matching them as one token keeps the '-' from reading as an operator.",
      "name": "variable.other.maca",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:-[A-Za-z0-9_]+)*\\b"
    },
    "operators": {
      "name": "keyword.operator.maca",
      "match": "->|=>|\\+\\+|\\|>|==|!=|<=|>=|&&|\\|\\||[-+*/<>=|?:.]"
    }
  }
}
