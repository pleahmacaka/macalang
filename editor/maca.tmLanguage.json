{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Maca",
  "scopeName": "source.maca",
  "fileTypes": ["maca"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#paths" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#function-def" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.maca", "match": "//.*$" },
        {
          "name": "comment.block.maca",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.maca",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.maca", "match": "\\\\." },
        { "name": "constant.character.escape.maca", "match": "\\{\\{|\\}\\}" },
        {
          "name": "meta.embedded.interpolation.maca",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.maca" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.maca" } },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#keywords" },
            { "include": "#operators" },
            { "name": "variable.other.maca", "match": "[A-Za-z_][A-Za-z0-9_]*" }
          ]
        }
      ]
    },
    "paths": {
      "name": "string.other.path.maca",
      "match": "(?:\\.\\./|\\./|~/|/)[A-Za-z0-9_][A-Za-z0-9_./-]*"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.maca",
          "match": "\\b(if|else|for|in|match|with|try|fail|return)\\b"
        },
        {
          "name": "keyword.other.maca",
          "match": "\\b(let|import|from|alias)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.maca",
      "match": "\\b(true|false)\\b"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.maca", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.maca", "match": "\\b[0-9]+\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.maca",
          "match": "\\b(int|float|str|bool|bytes|unit|f32|f64|i8|i16|i32|i64|u8|u16|u32|u64)\\b"
        },
        {
          "name": "support.type.simd.maca",
          "match": "\\b[iuf](?:8|16|32|64)x(?:2|4|8|16|32|64)\\b"
        },
        {
          "name": "entity.name.type.maca",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "function-def": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.maca" } }
    },
    "operators": {
      "name": "keyword.operator.maca",
      "match": "->|=>|\\+\\+|\\|>|==|!=|<=|>=|&&|\\|\\||[-+*/<>=|?:.]"
    }
  }
}
