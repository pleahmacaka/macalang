// std/fs: the filesystem work a build step keeps rewriting.
//
// `read_file`, `write_file`, `list_dir`, `is_dir` and the rest are builtins.
// This module is what you build out of them: walking a tree, copying, reading a
// file as lines, writing one only when its contents changed.
//
//   import std/fs

import std/text
import std/path

/// Every file under `root`, recursively, in a stable order. `list_dir` sorts,
/// and this preserves that, so a generated manifest doesn't churn between runs.
walk(root: str) -> str[] =>
    walk_entries(root, list_dir(root), 0, [])

walk_entries(root: str, names: str[], i: int, acc: str[]) -> str[] {
    if i >= names.length() {
        acc
    } else {
        found = walk_one(join(root, names.get(i)))
        walk_entries(root, names, i + 1, acc ++ found)
    }
}

walk_one(p: str) -> str[] {
    if is_dir(p) {
        walk(p)
    } else {
        [p]
    }
}

/// Directories under `root`, recursively.
walk_dirs(root: str) -> str[] =>
    dir_entries(root, list_dir(root), 0, [])

dir_entries(root: str, names: str[], i: int, acc: str[]) -> str[] {
    if i >= names.length() {
        acc
    } else {
        found = dir_one(join(root, names.get(i)))
        dir_entries(root, names, i + 1, acc ++ found)
    }
}

dir_one(p: str) -> str[] {
    if is_dir(p) {
        [p] ++ walk_dirs(p)
    } else {
        []
    }
}

/// Files under `root` whose name ends with `suffix`: `walk(root)` filtered,
/// but the filter is the reason you were walking.
find(root: str, suffix: str) -> str[] =>
    walk(root).filter(p => p.ends_with(suffix))

/// A file's lines, without terminators. "" for a file that isn't there, which
/// `read_file` already decided.
read_lines(p: str) -> str[] =>
    lines(read_file(p))

/// Write `text` to `p`, creating the parent directory. Returns whether it
/// changed anything: a build step that rewrites an identical file makes every
/// downstream timestamp lie.
write_if_changed(p: str, text: str) -> bool {
    unchanged = file_exists(p) && read_file(p) == text

    if unchanged {
        false
    } else {
        force_write(p, text)
    }
}

force_write(p: str, text: str) -> bool {
    make_dir(dirname(p))
    write_file(p, text)
}

/// Append, creating the file if it isn't there.
append_file(p: str, text: str) -> bool {
    existing = if file_exists(p) { read_file(p) } else { "" }

    write_file(p, existing ++ text)
}

/// A byte-for-byte copy, not `write_file(to, read_file(from))`, which stops at
/// the first NUL and so turns copying a wasm module or an image into silently
/// truncating it.
copy_file(from: str, to: str) -> bool {
    make_dir(dirname(to))
    copy_bytes(from, to)
}

/// Copy a tree, preserving the layout under `to`.
copy_tree(from: str, to: str) -> int =>
    copy_all(from, to, walk(from), 0, 0)

copy_all(from: str, to: str, files: str[], i: int, n: int) -> int {
    if i >= files.length() {
        n
    } else {
        copied = if copy_one(files.get(i), from, to) { 1 } else { 0 }
        copy_all(from, to, files, i + 1, n + copied)
    }
}

copy_one(p: str, from: str, to: str) -> bool {
    rel = strip_prefix(strip_prefix(p, from), "/")
    copy_file(p, join(to, rel))
}

/// The size of a whole tree, in bytes.
tree_size(root: str) -> int =>
    walk(root).map(p => file_size(p)).sum()
