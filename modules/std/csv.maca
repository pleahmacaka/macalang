// std/csv: comma-separated values, RFC 4180 as far as it is worth going.

import std/text

/** One field, quoted only when it has to be. */
field(s: str) -> str {
    if needs_quotes(s) {
        "\"" ++ s.replace("\"", "\"\"") ++ "\""
    } else {
        s
    }
}

needs_quotes(s: str) -> bool =>
    s.contains(",") || s.contains("\"") || s.contains("\n")
        || s.contains("\r")

/** One record, terminated with `\r\n`. */
row(cells: str[]) -> str =>
    cells.map(field).join(",") ++ "\r\n"

/** A whole document from a header and its rows. */
document(header: str[], rows: str[][]) -> str =>
    row(header) ++ join_rows(rows, 0, "")

join_rows(rows: str[][], i: int, acc: str) -> str {
    if i >= rows.length() {
        acc
    } else {
        join_rows(rows, i + 1, acc ++ row(rows.get(i)))
    }
}

/** The fields of one record. */
parse_row(line: str) -> str[] =>
    scan_fields(line.chars(), 0, "", [])

scan_fields(cs: str[], i: int, cur: str, acc: str[]) -> str[] {
    if i >= cs.length() {
        acc.push(cur)
    } else {
        next_field(cs, i, cur, acc)
    }
}

next_field(cs: str[], i: int, cur: str, acc: str[]) -> str[] {
    c = cs.get(i)

    if c == "\"" {
        read_quoted_field(cs, i + 1, cur, acc)
    } else if c == "," {
        scan_fields(cs, i + 1, "", acc.push(cur))
    } else if c == "\r" {
        scan_fields(cs, i + 1, cur, acc)
    } else {
        scan_fields(cs, i + 1, cur ++ c, acc)
    }
}

read_quoted_field(cs: str[], i: int, cur: str, acc: str[]) -> str[] {
    if i >= cs.length() {
        acc.push(cur)
    } else if cs.get(i) != "\"" {
        read_quoted_field(cs, i + 1, cur ++ cs.get(i), acc)
    } else if i + 1 < cs.length() && cs.get(i + 1) == "\"" {
        read_quoted_field(cs, i + 2, cur ++ "\"", acc)
    } else {
        scan_fields(cs, i + 1, cur, acc)
    }
}

/** Every record in a document. */
parse(src: str) -> str[][] =>
    parse_rows(split_records(src.chars(), 0, false, "", []), 0, [])

parse_rows(ls: str[], i: int, acc: str[][]) -> str[][] {
    if i >= ls.length() {
        acc
    } else if ls.get(i).trim() == "" {
        parse_rows(ls, i + 1, acc)
    } else {
        parse_rows(ls, i + 1, acc.push(parse_row(ls.get(i))))
    }
}

split_records(cs: str[], i: int, in_q: bool, cur: str, acc: str[]) -> str[] {
    if i < cs.length() {
        record_step(cs, i, in_q, cur, acc)
    } else if cur == "" {
        acc
    } else {
        acc.push(cur)
    }
}

record_step(cs: str[], i: int, in_q: bool, cur: str, acc: str[]) -> str[] {
    c = cs.get(i)

    if c == "\"" {
        split_records(cs, i + 1, !in_q, cur ++ c, acc)
    } else if c == "\n" && !in_q {
        split_records(cs, i + 1, in_q, "", acc.push(cur))
    } else {
        split_records(cs, i + 1, in_q, cur ++ c, acc)
    }
}

/** The value under `name` in `row`, using `header` for the column order. */
column(header: str[], row: str[], name: str) -> str {
    at = header.index_of(name)

    if at < 0 || at >= row.length() {
        ""
    } else {
        row.get(at)
    }
}
