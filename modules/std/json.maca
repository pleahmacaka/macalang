// std/json: JSON, written in Maca.
//
// Two halves. `encode` and `decode` are the typed pair: the compiler writes
// them from the record and sum types the program declares, so a page never
// spells a field twice. Everything else here reads and writes JSON as text,
// for the shapes no type describes.

import std/text

/// The JSON text for `value`, written from the record and sum types it is built out of.
encode(value: a) -> str

/// `text` read into the type the binding declares, failing with the field that did not match.
decode(text: str) -> a

/// A JSON string literal, with the five escapes the format requires.
quote(s: str) -> str =>
    "\"" ++ s.replace("\\", "\\\\")
             .replace("\"", "\\\"")
             .replace("\n", "\\n")
             .replace("\r", "\\r")
             .replace("\t", "\\t") ++ "\""

/// `["a", "b"]` from a `str[]`.
array_of_str(xs: str[]) -> str =>
    "[" ++ xs.map(quote).join(",") ++ "]"

/// `[1, 2]` from an `int[]`.
array_of_int(xs: int[]) -> str =>
    "[" ++ xs.map(v => str(v)).join(",") ++ "]"

/// `{"k":v}` from parallel key and (already-encoded) value lists.
object_of(keys: str[], values: str[]) -> str =>
    "\{" ++ pairs(keys, values, 0, []).join(",") ++ "\}"

pairs(ks: str[], vs: str[], i: int, acc: str[]) -> str[] {
    if i >= ks.length() || i >= vs.length() {
        acc
    } else {
        pair = quote(ks.get(i)) ++ ":" ++ vs.get(i)
        pairs(ks, vs, i + 1, acc.push(pair))
    }
}

/// The raw text of `key`'s value in a JSON object, or "" when it isn't there.
get(src: str, key: str) -> str {
    marker = quote(key) ++ ":"
    at = src.index_of(marker)

    if at < 0 {
        ""
    } else {
        value_at(src, at + marker.length())
    }
}

/// `get`, parsed as an integer, with `dflt` when the key is absent.
get_int(src: str, key: str, dflt: int) -> int {
    v = get(src, key)

    if v == "" {
        dflt
    } else {
        int(v)
    }
}

/// `get`, read as a boolean.
get_bool(src: str, key: str) -> bool =>
    get(src, key) == "true"

/// The elements of a JSON array, each as raw text (strings unquoted).
items(src: str) -> str[] {
    body = src.trim()

    if !body.starts_with("[") {
        []
    } else {
        split_items(body.slice(1, body.length() - 1).chars(), 0, 0, "", [])
    }
}

split_items(cs: str[], i: int, depth: int, cur: str, acc: str[]) -> str[] {
    if i < cs.length() {
        next_item(cs, i, depth, cur, acc)
    } else if cur.trim() == "" {
        acc
    } else {
        acc.push(unwrap(cur))
    }
}

next_item(cs: str[], i: int, depth: int, cur: str, acc: str[]) -> str[] {
    c = cs.get(i)

    if c == "\"" {
        copy_string(cs, i + 1, depth, cur ++ c, acc)
    } else if c == "," && depth == 0 {
        split_items(cs, i + 1, depth, "", acc.push(unwrap(cur)))
    } else {
        split_items(cs, i + 1, depth + nesting(c), cur ++ c, acc)
    }
}

nesting(c: str) -> int {
    if c == "[" || c == "\{" {
        1
    } else if c == "]" || c == "\}" {
        -1
    } else {
        0
    }
}

copy_string(cs: str[], i: int, depth: int, cur: str, acc: str[]) -> str[] {
    if i >= cs.length() {
        split_items(cs, i, depth, cur, acc)
    } else if cs.get(i) == "\\" {
        split_items_after_escape(cs, i, depth, cur, acc)
    } else if cs.get(i) == "\"" {
        split_items(cs, i + 1, depth, cur ++ "\"", acc)
    } else {
        copy_string(cs, i + 1, depth, cur ++ cs.get(i), acc)
    }
}

split_items_after_escape(cs: str[], i: int, depth: int, cur: str,
                         acc: str[]) -> str[] {
    escaped = if i + 1 < cs.length() { cs.get(i + 1) } else { "" }

    copy_string(cs, i + 2, depth, cur ++ cs.get(i) ++ escaped, acc)
}

value_at(src: str, at: int) -> str {
    rest = src.slice(at, src.length()).trim()

    if rest.starts_with("\"") {
        unescape(rest.slice(1, quote_end(rest.chars(), 1)))
    } else if rest.starts_with("[") || rest.starts_with("\{") {
        rest.slice(0, balanced_end(rest.chars(), 0, 0))
    } else {
        rest.slice(0, bare_end(rest.chars(), 0))
    }
}

balanced_end(cs: str[], i: int, depth: int) -> int {
    if i >= cs.length() {
        i
    } else {
        balanced_step(cs, i, depth)
    }
}

balanced_step(cs: str[], i: int, depth: int) -> int {
    c = cs.get(i)

    if c == "\"" {
        balanced_end(cs, skip_string(cs, i + 1), depth)
    } else if c == "[" || c == "\{" {
        balanced_end(cs, i + 1, depth + 1)
    } else if c != "]" && c != "\}" {
        balanced_end(cs, i + 1, depth)
    } else if depth <= 1 {
        i + 1
    } else {
        balanced_end(cs, i + 1, depth - 1)
    }
}

skip_string(cs: str[], i: int) -> int {
    end = quote_end(cs, i)

    end >= cs.length() ? cs.length() : end + 1
}

quote_end(cs: str[], i: int) -> int {
    if i >= cs.length() {
        cs.length()
    } else if cs.get(i) == "\\" {
        quote_end(cs, i + 2)
    } else if cs.get(i) == "\"" {
        i
    } else {
        quote_end(cs, i + 1)
    }
}

bare_end(cs: str[], i: int) -> int {
    if i >= cs.length() {
        i
    } else if cs.get(i) == "," || cs.get(i) == "\}" || cs.get(i) == "]" {
        i
    } else {
        bare_end(cs, i + 1)
    }
}

unwrap(s: str) -> str {
    t = s.trim()

    if t.length() >= 2 && t.starts_with("\"") && t.ends_with("\"") {
        unescape(t.slice(1, t.length() - 1))
    } else {
        t
    }
}

unescape(s: str) -> str =>
    s.replace("\\n", "\n")
     .replace("\\r", "\r")
     .replace("\\t", "\t")
     .replace("\\\"", "\"")
     .replace("\\\\", "\\")
