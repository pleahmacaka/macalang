import std/text

Readme = "modules/std/README.md"

readme_rows() -> str[] =>
    lines(read_file(Readme)).filter(l => l.starts_with("| `std/"))

module_of(row: str) -> str =>
    split_once(strip_prefix(row, "| `std/"), "` | ").get(0)

body_of(row: str) -> str =>
    split_once(strip_prefix(row, "| `std/"), "` | ").get(1)

plain_name(s: str) -> bool =>
    s.length() > 0 && !s.ends_with("_") && all_plain(s.chars(), 0)

all_plain(cs: str[], i: int) -> bool {
    if i >= cs.length() {
        true
    } else if plain_char(cs.get(i)) {
        all_plain(cs, i + 1)
    } else {
        false
    }
}

plain_char(c: str) -> bool =>
    c == "_" || c.is_ascii_digit() || (c.is_alpha() && c.lower() == c)

backticked(cell: str) -> str[] =>
    odd_spans(cell.split("`"), 1, [])

odd_spans(parts: str[], i: int, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else if plain_name(parts.get(i)) {
        odd_spans(parts, i + 2, acc + [parts.get(i)])
    } else {
        odd_spans(parts, i + 2, acc)
    }
}

defines(src: str, name: str) -> bool =>
    lines(src).filter(l => l.starts_with(name + "(")).length() > 0

test_the_readme_names_functions_that_exist() {
    checked = 0

    for row in readme_rows() {
        module = module_of(row)
        src = read_file("modules/std/" + module + ".maca")

        for name in backticked(body_of(row)) {
            assert(defines(src, name),
                   "the README lists {name} under std/{module}, which does " +
                       "not define it")
            checked = checked + 1
        }
    }

    assert(checked > 40, "the table stopped being parsed: {checked} names")
}

test_every_module_the_readme_lists_has_a_source_file() {
    assert(readme_rows().length() > 5, "the table lists the modules")

    for row in readme_rows() {
        assert(file_exists("modules/std/" + module_of(row) + ".maca"),
               "the README lists std/{module_of(row)}, which has no source")
    }
}

test_the_cell_reader_reads_a_cell() {
    assert_eq(backticked("`lines`, `words`, `strip_prefix`/`strip_suffix`")
                  .join(" "),
              "lines words strip_prefix strip_suffix",
              "a slashed pair is two names")
    assert_eq(backticked("and for `str[]`: `str_take`").join(" "), "str_take",
              "a type is not a function name")
    assert_eq(backticked("plain prose with no spans").join(" "), "",
              "and prose names nothing")
}
