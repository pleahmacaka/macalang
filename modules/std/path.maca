// std/path: filesystem paths as strings, handled the way a build tool needs.

/// Join two segments with exactly one separator, whatever each side brought.
join(a: str, b: str) -> str {
    left = drop_trailing_sep(a)
    right = drop_leading_sep(b)

    if left == "" {
        right
    } else if right == "" {
        left
    } else {
        left ++ "/" ++ right
    }
}

drop_trailing_sep(s: str) -> str {
    if s.ends_with("/") {
        s.slice(0, s.length() - 1)
    } else {
        s
    }
}

drop_leading_sep(s: str) -> str {
    if s.starts_with("/") {
        s.slice(1, s.length())
    } else {
        s
    }
}

/// Everything after the last separator.
basename(p: str) -> str {
    at = last_sep(p)

    if at < 0 {
        p
    } else {
        p.slice(at + 1, p.length())
    }
}

/// Everything before the last separator.
dirname(p: str) -> str {
    at = last_sep(p)

    if at < 0 {
        "."
    } else if at == 0 {
        "/"
    } else {
        p.slice(0, at)
    }
}

/// The extension without its dot, or "".
extension(p: str) -> str {
    name = basename(p)
    at = last_dot(name)

    if at <= 0 {
        ""
    } else {
        name.slice(at + 1, name.length())
    }
}

/// The basename with its extension removed.
stem(p: str) -> str {
    name = basename(p)
    at = last_dot(name)

    if at <= 0 {
        name
    } else {
        name.slice(0, at)
    }
}

/// Replace the extension (with or without a leading dot on `ext`).
with_extension(p: str, ext: str) -> str {
    bare_ext = drop_leading_dot(ext)
    dir = dirname(p)

    name = if bare_ext == "" {
        stem(p)
    } else {
        stem(p) ++ "." ++ bare_ext
    }

    if dir == "." && !p.starts_with("./") {
        name
    } else {
        join(dir, name)
    }
}

drop_leading_dot(ext: str) -> str {
    if ext.starts_with(".") {
        ext.slice(1, ext.length())
    } else {
        ext
    }
}

/// Does `p` start from the root?
is_absolute(p: str) -> bool =>
    p.starts_with("/")

/// Collapse `.` and `..` segments textually.
normalize(p: str) -> str {
    kept = walk_segments(p.split("/"), 0, []).join("/")

    if is_absolute(p) {
        "/" ++ kept
    } else if kept == "" {
        "."
    } else {
        kept
    }
}

walk_segments(segs: str[], i: int, acc: str[]) -> str[] {
    if i >= segs.length() {
        acc
    } else {
        walk_segments(segs, i + 1, step(acc, segs.get(i)))
    }
}

step(acc: str[], seg: str) -> str[] {
    if seg == "" || seg == "." {
        acc
    } else if seg != ".." {
        acc.push(seg)
    } else if acc.length() > 0 {
        acc.pop()
    } else {
        acc
    }
}

last_sep(p: str) -> int =>
    scan_back(p.chars(), p.length() - 1, "/")

last_dot(s: str) -> int =>
    scan_back(s.chars(), s.length() - 1, ".")

scan_back(cs: str[], i: int, want: str) -> int {
    if i < 0 {
        -1
    } else if cs.get(i) == want {
        i
    } else {
        scan_back(cs, i - 1, want)
    }
}
