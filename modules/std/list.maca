// std/list — the list operations that aren't builtins.
//
// `map`, `filter`, `reduce`, `sort`, `slice` and friends are UFCS methods on
// any `T[]`. This module is the next layer: the shapes you reach for once you
// have those, written as ordinary functions because they need types the method
// set can't spell (a pair of lists, a predicate that answers about the whole
// list rather than an element).
//
//   import std/list
//   import { any_of, chunk } from std/list

/// Does any element satisfy `pred`? Short of a `break`, this is the readable
/// way to ask — `.filter(pred).length() > 0` walks the whole list and
/// allocates.
any_of(xs: int[], pred) -> bool =>
    scan_any(xs, 0, pred)

scan_any(xs: int[], i: int, pred) -> bool {
    if i >= xs.length() {
        false
    } else if pred(xs.get(i)) {
        true
    } else {
        scan_any(xs, i + 1, pred)
    }
}

/// Does every element satisfy `pred`? An empty list passes, which is what
/// makes `all_of(rules, ok)` behave when there are no rules yet.
all_of(xs: int[], pred) -> bool =>
    scan_all(xs, 0, pred)

scan_all(xs: int[], i: int, pred) -> bool {
    if i >= xs.length() {
        true
    } else if !pred(xs.get(i)) {
        false
    } else {
        scan_all(xs, i + 1, pred)
    }
}

/// The index of the first element satisfying `pred`, or -1. `index_of`
/// matches a value; this matches a question.
find_index(xs: int[], pred) -> int =>
    scan_find(xs, 0, pred)

scan_find(xs: int[], i: int, pred) -> int {
    if i >= xs.length() {
        -1
    } else if pred(xs.get(i)) {
        i
    } else {
        scan_find(xs, i + 1, pred)
    }
}

/// How many elements satisfy `pred`.
count_if(xs: int[], pred) -> int =>
    xs.filter(pred).length()

/// The first `n` elements. `n` clamps rather than failing, so `take(xs, 100)`
/// on a short list is the short list.
take(xs: int[], n: int) -> int[] =>
    xs.slice(0, clamp(n, xs.length()))

/// Everything after the first `n` elements — the other half of `take`, and
/// clamping the same way.
drop(xs: int[], n: int) -> int[] =>
    xs.slice(clamp(n, xs.length()), xs.length())

// An index brought into `0..len`, so a caller's arithmetic can't walk off
// either end of the list.
clamp(n: int, len: int) -> int {
    if n < 0 {
        0
    } else if n > len {
        len
    } else {
        n
    }
}

/// Fixed-size groups, the last one short if the length doesn't divide.
chunk(xs: int[], size: int) -> int[][] {
    if size <= 0 {
        []
    } else {
        chunk_from(xs, 0, size, [])
    }
}

chunk_from(xs: int[], at: int, size: int, acc: int[][]) -> int[][] {
    if at >= xs.length() {
        acc
    } else {
        group = xs.slice(at, clamp(at + size, xs.length()))
        chunk_from(xs, at + size, size, acc.push(group))
    }
}

/// One list of the pairwise sums, stopping at the shorter input. The language
/// has no tuple, so `zip` proper needs a record; this is the arithmetic case,
/// which is the one that comes up.
zip_add(a: int[], b: int[]) -> int[] =>
    zip_add_from(a, b, 0, [])

zip_add_from(a: int[], b: int[], i: int, acc: int[]) -> int[] {
    if i >= a.length() || i >= b.length() {
        acc
    } else {
        zip_add_from(a, b, i + 1, acc.push(a.get(i) + b.get(i)))
    }
}

/// Flatten one level.
flatten(xss: int[][]) -> int[] =>
    flatten_from(xss, 0, [])

flatten_from(xss: int[][], i: int, acc: int[]) -> int[] {
    if i >= xss.length() {
        acc
    } else {
        flatten_from(xss, i + 1, acc ++ xss.get(i))
    }
}

/// Values in first-seen order, duplicates dropped. Order is preserved on
/// purpose: sorting first would be faster and would also throw away the one
/// property that makes the result useful for output.
unique(xs: int[]) -> int[] =>
    unique_from(xs, 0, [])

unique_from(xs: int[], i: int, acc: int[]) -> int[] {
    if i >= xs.length() {
        acc
    } else if acc.contains(xs.get(i)) {
        unique_from(xs, i + 1, acc)
    } else {
        unique_from(xs, i + 1, acc.push(xs.get(i)))
    }
}

/// `[lo, lo+1, …, hi]`, empty when `hi < lo`. The `lo..hi` range is a loop
/// header; this is the value.
range(lo: int, hi: int) -> int[] {
    if hi < lo {
        []
    } else {
        range_from(lo, hi, [])
    }
}

range_from(at: int, hi: int, acc: int[]) -> int[] {
    if at > hi {
        acc
    } else {
        range_from(at + 1, hi, acc.push(at))
    }
}

// ---- the same, for `str[]` ------------------------------------------------
//
// A second copy, not a type variable. `a[]` here does compile, and it is worse
// than this — measured, not assumed:
//
//   * an unannotated `pred` has no declared type for the call site to
//     substitute into, so its closure lowers with an `int` parameter whatever
//     the element type is. `count_if(floats, v => big(v))` then answered 3
//     where `floats.filter(v => big(v)).length()` answered 2, in one program,
//     exit 0. A `str[]` survives it by accident — the lambda's type is inferred
//     from the body — which is exactly why a suite testing `int[]` and `str[]`
//     said the change was fine.
//   * `chunk` and `flatten` name `a[][]`, whose concrete form doesn't exist
//     until a call site picks the element type, which is after the C typedefs
//     are written. `chunk(chunk(xs, 2), 1)` emits a type the file never
//     defines.
//   * a record element reaches `cc` as a raw error where `int[]` gave a clean
//     `TypeMismatch`.
//
// Deleting these five bought five deleted functions and cost a silent wrong
// answer. Generic element types belong here once the closure ABI carries the
// element type and array typedefs are emitted after instantiation — both are
// stage-1 work.

/// `unique` for a `str[]`.
str_unique(xs: str[]) -> str[] =>
    str_unique_from(xs, 0, [])

str_unique_from(xs: str[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else if acc.contains(xs.get(i)) {
        str_unique_from(xs, i + 1, acc)
    } else {
        str_unique_from(xs, i + 1, acc.push(xs.get(i)))
    }
}

/// `take` for a `str[]`.
str_take(xs: str[], n: int) -> str[] =>
    xs.slice(0, clamp(n, xs.length()))

/// `drop` for a `str[]`.
str_drop(xs: str[], n: int) -> str[] =>
    xs.slice(clamp(n, xs.length()), xs.length())

/// `find_index` for a `str[]`.
str_find_index(xs: str[], pred) -> int =>
    str_scan_find(xs, 0, pred)

str_scan_find(xs: str[], i: int, pred) -> int {
    if i >= xs.length() {
        -1
    } else if pred(xs.get(i)) {
        i
    } else {
        str_scan_find(xs, i + 1, pred)
    }
}

/// `flatten` for a `str[][]`.
str_flatten(xss: str[][]) -> str[] =>
    str_flatten_from(xss, 0, [])

str_flatten_from(xss: str[][], i: int, acc: str[]) -> str[] {
    if i >= xss.length() {
        acc
    } else {
        str_flatten_from(xss, i + 1, acc ++ xss.get(i))
    }
}
