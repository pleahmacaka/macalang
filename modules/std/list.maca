// std/list: the list operations that aren't builtins.

/** Does any element satisfy `pred`? */
any_of(xs: int[], pred) -> bool =>
    scan_any(xs, 0, pred)

scan_any(xs: int[], i: int, pred) -> bool {
    if i >= xs.length() {
        false
    } else if pred(xs.get(i)) {
        true
    } else {
        scan_any(xs, i + 1, pred)
    }
}

/** Does every element satisfy `pred`? */
all_of(xs: int[], pred) -> bool =>
    scan_all(xs, 0, pred)

scan_all(xs: int[], i: int, pred) -> bool {
    if i >= xs.length() {
        true
    } else if !pred(xs.get(i)) {
        false
    } else {
        scan_all(xs, i + 1, pred)
    }
}

/** The index of the first element satisfying `pred`, or -1. */
find_index(xs: int[], pred) -> int =>
    scan_find(xs, 0, pred)

scan_find(xs: int[], i: int, pred) -> int {
    if i >= xs.length() {
        -1
    } else if pred(xs.get(i)) {
        i
    } else {
        scan_find(xs, i + 1, pred)
    }
}

/** How many elements satisfy `pred`. */
count_if(xs: int[], pred) -> int =>
    xs.filter(pred).length()

/** The first `n` elements. */
take(xs: int[], n: int) -> int[] =>
    xs.slice(0, clamp(n, xs.length()))

/** Everything after the first `n` elements: the other half of `take`, and
 * clamping the same way.
 */
drop(xs: int[], n: int) -> int[] =>
    xs.slice(clamp(n, xs.length()), xs.length())

clamp(n: int, len: int) -> int {
    if n < 0 {
        0
    } else if n > len {
        len
    } else {
        n
    }
}

/** Fixed-size groups, the last one short if the length doesn't divide. */
chunk(xs: int[], size: int) -> int[][] {
    if size <= 0 {
        []
    } else {
        chunk_from(xs, 0, size, [])
    }
}

chunk_from(xs: int[], at: int, size: int, acc: int[][]) -> int[][] {
    if at >= xs.length() {
        acc
    } else {
        group = xs.slice(at, clamp(at + size, xs.length()))
        chunk_from(xs, at + size, size, acc.push(group))
    }
}

/** One list of the pairwise sums, stopping at the shorter input. */
zip_add(a: int[], b: int[]) -> int[] =>
    zip_add_from(a, b, 0, [])

zip_add_from(a: int[], b: int[], i: int, acc: int[]) -> int[] {
    if i >= a.length() || i >= b.length() {
        acc
    } else {
        zip_add_from(a, b, i + 1, acc.push(a.get(i) + b.get(i)))
    }
}

/** Flatten one level. */
flatten(xss: int[][]) -> int[] =>
    flatten_from(xss, 0, [])

flatten_from(xss: int[][], i: int, acc: int[]) -> int[] {
    if i >= xss.length() {
        acc
    } else {
        flatten_from(xss, i + 1, acc ++ xss.get(i))
    }
}

/** Values in first-seen order, duplicates dropped. */
unique(xs: int[]) -> int[] =>
    unique_from(xs, 0, [])

unique_from(xs: int[], i: int, acc: int[]) -> int[] {
    if i >= xs.length() {
        acc
    } else if acc.contains(xs.get(i)) {
        unique_from(xs, i + 1, acc)
    } else {
        unique_from(xs, i + 1, acc.push(xs.get(i)))
    }
}

/** `[lo, lo+1, …, hi]`, empty when `hi < lo`. */
range(lo: int, hi: int) -> int[] {
    if hi < lo {
        []
    } else {
        range_from(lo, hi, [])
    }
}

range_from(at: int, hi: int, acc: int[]) -> int[] {
    if at > hi {
        acc
    } else {
        range_from(at + 1, hi, acc.push(at))
    }
}

/** `unique` for a `str[]`. */
str_unique(xs: str[]) -> str[] =>
    str_unique_from(xs, 0, [])

str_unique_from(xs: str[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else if acc.contains(xs.get(i)) {
        str_unique_from(xs, i + 1, acc)
    } else {
        str_unique_from(xs, i + 1, acc.push(xs.get(i)))
    }
}

/** `take` for a `str[]`. */
str_take(xs: str[], n: int) -> str[] =>
    xs.slice(0, clamp(n, xs.length()))

/** `drop` for a `str[]`. */
str_drop(xs: str[], n: int) -> str[] =>
    xs.slice(clamp(n, xs.length()), xs.length())

/** `find_index` for a `str[]`. */
str_find_index(xs: str[], pred) -> int =>
    str_scan_find(xs, 0, pred)

str_scan_find(xs: str[], i: int, pred) -> int {
    if i >= xs.length() {
        -1
    } else if pred(xs.get(i)) {
        i
    } else {
        str_scan_find(xs, i + 1, pred)
    }
}

/** `flatten` for a `str[][]`. */
str_flatten(xss: str[][]) -> str[] =>
    str_flatten_from(xss, 0, [])

str_flatten_from(xss: str[][], i: int, acc: str[]) -> str[] {
    if i >= xss.length() {
        acc
    } else {
        str_flatten_from(xss, i + 1, acc ++ xss.get(i))
    }
}
