import { dim, ok, bad } from cli/style
import { find, read_lines } from std/fs

Issue = {
    path: str,
    line: int,
    what: str,
}

single_line_if(line: str) -> bool {
    t = line.trim()
    opens = t.starts_with("if ") || t.starts_with("} else if ")
    opens && t.contains("\{") && t.ends_with("\}") && !t.contains("? ")
}

too_wide(line: str) -> bool =>
    !line.trim().starts_with("//") && !line.trim().starts_with("/*")
        && !line.trim().starts_with("*")
        && collapse_strings(line).length() > 80

collapse_strings(line: str) -> str =>
    collapse(line.chars(), 0, false, "")

collapse(cs: str[], i: int, quoted: bool, acc: str) -> str {
    if i >= cs.length() {
        acc
    } else if cs.get(i) == "\\" && quoted {
        collapse(cs, i + 2, quoted, acc)
    } else if cs.get(i) == "\"" {
        collapse(cs, i + 1, !quoted, acc + "\"")
    } else if quoted {
        collapse(cs, i + 1, quoted, acc)
    } else {
        collapse(cs, i + 1, quoted, acc + cs.get(i))
    }
}

has_trailing_space(line: str) -> bool =>
    line.length() > 0 && (line.ends_with(" ") || line.ends_with("\t"))

line_issues(path: str, no: int, line: str) -> Issue[] =>
    say(path, no, too_wide(line), "line exceeds 80 columns") +
        say(path, no, single_line_if(line),
               "single-line `if` block; break it across lines") +
        say(path, no, unordered_classes(line),
               "tailwind classes out of order; layout before paint," +
                   " spacing before border, text before cursor") +
        space_issues(path, no, line)

/** The canonical order a class list is written in: where a box sits, what it
 * is, how it flexes, its size, its spacing, its skin, its text, its cursor.
 */
class_rank(word: str) -> int {
    if word.starts_with("absolute") || word.starts_with("relative") ||
            word.starts_with("fixed") || word.starts_with("top-") ||
            word.starts_with("left-") || word.starts_with("right-") ||
            word.starts_with("bottom-") || word.starts_with("z-") {
        1
    } else if word == "flex" || word == "grid" || word == "hidden" ||
            word == "block" {
        2
    } else if word.starts_with("flex-") {
        3
    } else if word.starts_with("items-") || word.starts_with("justify-") ||
            word.starts_with("content-") || word.starts_with("self-") {
        4
    } else if word == "grow" || word == "shrink" {
        5
    } else if word.starts_with("size-") || word.starts_with("w-") ||
            word.starts_with("h-") || word.starts_with("min-") ||
            word.starts_with("max-") {
        6
    } else if word.starts_with("m-") || word.starts_with("mx-") ||
            word.starts_with("my-") || word.starts_with("p-") ||
            word.starts_with("px-") || word.starts_with("py-") ||
            word.starts_with("pl-") || word.starts_with("pr-") ||
            word.starts_with("pt-") || word.starts_with("pb-") ||
            word.starts_with("gap-") {
        7
    } else if word.starts_with("overflow-") {
        8
    } else if word.starts_with("border") || word.starts_with("rounded") {
        9
    } else if word.starts_with("text-") || word.starts_with("font-") ||
            word == "italic" || word.starts_with("leading-") {
        10
    } else if word.starts_with("cursor-") {
        11
    } else {
        12
    }
}

unordered_classes(line: str) -> bool {
    words = class_words(line)
    i = 1

    while i < words.length() {
        if class_rank(words.get(i)) < class_rank(words.get(i - 1)) {
            return true
        }

        i = i + 1
    }

    false
}

/** The words of a `class=\"…\"` on this line, as far as the line carries
 * them; a list wrapped by a string continuation is checked line by line.
 */
class_words(line: str) -> str[] {
    at = line.index_of("class=\"")

    if at < 0 {
        return []
    }

    rest = line.slice(at + 7, line.length())
    shut = rest.index_of("\"")
    inside = shut < 0 ? rest : rest.slice(0, shut)

    kept_words(inside.split(" "), 0, [])
}

kept_words(xs: str[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else if xs.get(i).trim() == "" {
        kept_words(xs, i + 1, acc)
    } else {
        kept_words(xs, i + 1, acc.push(xs.get(i).trim()))
    }
}

space_issues(path: str, no: int, line: str) -> Issue[] =>
    say(path, no, has_trailing_space(line), "trailing whitespace") +
        say(path, no, line.contains("\t"),
               "hard tab; Maca indents with four spaces")

say(path: str, no: int, hit: bool, what: str) -> Issue[] {
    if hit {
        [Issue { path = path, line = no, what = what }]
    } else {
        []
    }
}

scan_lines(path: str, ls: str[], i: int, raw: bool, acc: Issue[]) -> Issue[] {
    if i >= ls.length() {
        acc
    } else {
        line = ls.get(i)
        fence = odd_fence(line)
        found = if raw || fence {
            space_issues(path, i + 1, line)
        } else {
            line_issues(path, i + 1, line)
        }
        scan_lines(path, ls, i + 1, raw != fence, acc + found)
    }
}

odd_fence(line: str) -> bool =>
    count_fences(line.chars(), 0, 0) % 2 == 1

count_fences(cs: str[], i: int, n: int) -> int {
    if i + 2 >= cs.length() {
        n
    } else if fence_at(cs, i) {
        count_fences(cs, i + 3, n + 1)
    } else {
        count_fences(cs, i + 1, n)
    }
}

fence_at(cs: str[], i: int) -> bool =>
    cs.get(i) == "\"" && cs.get(i + 1) == "\"" && cs.get(i + 2) == "\""

lint_file(path: str) -> Issue[] =>
    scan_lines(path, read_lines(path), 0, false, [])

lint_tree(dir: str) -> Issue[] =>
    lint_each(find(dir, ".maca"), 0, [])

lint_each(paths: str[], i: int, acc: Issue[]) -> Issue[] {
    if i >= paths.length() {
        acc
    } else {
        lint_each(paths, i + 1, acc + lint_path(paths.get(i)))
    }
}

lint_path(path: str) -> Issue[] {
    if is_dir(path) {
        lint_tree(path)
    } else if file_exists(path) {
        lint_file(path)
    } else {
        []
    }
}

default_paths() -> str[] =>
    ["modules", "apps", "tests/programs", "dev.maca"]

lint(paths: str[]) -> int {
    if paths.length() == 0 {
        report(lint_each(default_paths(), 0, []))
    } else {
        lint_given(paths)
    }
}

lint_given(paths: str[]) -> int {
    absent = paths.filter(p => !file_exists(p))

    if absent.length() > 0 {
        err(bad("lint: cannot read " + absent.join(", ")))
        1
    } else {
        report(lint_each(paths, 0, []))
    }
}

report(issues: Issue[]) -> int {
    for it in issues {
        info(dim("{it.path}:{it.line}:") + " " + it.what)
    }

    if issues.length() == 0 {
        info(ok("clean"))
        0
    } else {
        info(bad(counted(issues.length())))
        1
    }
}

counted(n: int) -> str {
    if n == 1 {
        "1 issue"
    } else {
        "{n} issues"
    }
}
