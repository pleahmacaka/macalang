import { escape_html, index_of_from } from std/text
import { Store, get, changed } from signal/store

/** One node to update: the key that changed, its new value, and the selector
 * that finds every node bound to it.
 */
Op = {
    key: str,
    value: str,
    selector: str,
}

/** A `<tag>` whose text is `key`'s value. */
text_node(s: Store, tag: str, key: str) -> str =>
    element(tag, data-signal=key, escape_html(get(s, key)))

/** A `<tag>` whose `class` attribute is `key`'s value, with `body` inside it.
 */
class_node(s: Store, tag: str, key: str, body: str) -> str =>
    element(tag, data-signal=key, data-signal-as="class", class=get(s, key),
        body)

/** An `<input>` whose value is `key`'s value. */
value_input(s: Store, key: str) -> str =>
    element("input", data-signal=key, data-signal-as="value",
        value=get(s, key), "")

/** A `<tag>` whose *inner markup* is `key`'s value: a region of the page that a
 * rebuild replaces whole.
 */
html_node(s: Store, tag: str, key: str) -> str =>
    element(tag, data-signal=key, data-signal-as="html", get(s, key))

/** The selector matching every node bound to `key`. */
selector(key: str) -> str => "[data-signal=\"" ++ css_escaped(key) ++ "\"]"

css_escaped(key: str) -> str =>
    key.replace("\\", "\\\\").replace("\"", "\\\"")

/** One op per key that changed since the last `clear_changed`, in the order
 * they changed.
 */
patch(s: Store) -> Op[] => ops_from(s, changed(s), 0, [])

ops_from(s: Store, ks: str[], i: int, acc: Op[]) -> Op[] {
    if i >= ks.length() {
        acc
    } else {
        op = Op {
            key = ks.get(i),
            value = get(s, ks.get(i)),
            selector = selector(ks.get(i)),
        }
        ops_from(s, ks, i + 1, acc.push(op))
    }
}

/** One op as a line of text: what a native build prints instead of patching. */
describe(op: Op) -> str =>
    "{op.key} {op.selector} <- {shown(op.value)}"

/** The whole patch as lines, one per op. */
describe_all(ops: Op[]) -> str[] => lines_from(ops, 0, [])

lines_from(ops: Op[], i: int, acc: str[]) -> str[] {
    if i >= ops.length() {
        acc
    } else {
        lines_from(ops, i + 1, acc.push(describe(ops.get(i))))
    }
}

/** The JavaScript that applies the current patch, or "" when nothing changed.
 */
patch_script(s: Store) -> str {
    ops = patch(s)

    if ops.length() == 0 {
        ""
    } else {
        "macaSignal(" ++ ops_json(ops) ++ ");"
    }
}

/** The current patch as a JSON array, `[]` when nothing changed. */
patch_json(s: Store) -> str => ops_json(patch(s))

ops_json(ops: Op[]) -> str => "[" ++ encode(ops, 0, []).join(",") ++ "]"

encode(ops: Op[], i: int, acc: str[]) -> str[] {
    if i >= ops.length() {
        acc
    } else {
        op = ops.get(i)
        obj = "\{\"key\":" ++ quoted(op.key) ++ ",\"value\":"
            ++ quoted(op.value) ++ "\}"
        encode(ops, i + 1, acc.push(obj))
    }
}

escaped_value(v: str) -> str =>
    v.replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")

shown(v: str) -> str => "\"" ++ escaped_value(v) ++ "\""

quoted(v: str) -> str =>
    "\"" ++ escaped_value(v).replace("<", "\\u003c") ++ "\""

/** `ops` applied to the markup they were computed against. */
apply_patch(page: str, ops: Op[]) -> str => applied(page, ops, 0)

applied(page: str, ops: Op[], i: int) -> str {
    if i >= ops.length() {
        page
    } else {
        applied(apply_from(page, ops.get(i), 0), ops, i + 1)
    }
}

apply_from(page: str, op: Op, at: int) -> str {
    found = index_of_from(page, marker(op.key), at)

    if found < 0 {
        page
    } else {
        patch_node(page, op, tag_open(page, found))
    }
}

patch_node(page: str, op: Op, lt: int) -> str {
    gt = index_of_from(page, ">", lt)
    tag = tag_name(page, lt)
    shows = attr_in(page.slice(lt, gt + 1), "data-signal-as")

    if shows == "" || shows == "html" {
        patch_children(page, op, tag, gt + 1, shows == "html")
    } else {
        patch_attr(page, op, lt, gt, shows)
    }
}

patch_children(page: str, op: Op, tag: str, from: int, raw: bool) -> str {
    close = close_at(page, tag, from)
    shown = raw ? op.value : escape_html(op.value)
    next = page.slice(0, from) ++ shown ++ page.slice(close, page.length())

    apply_from(next, op, from + shown.length())
}

patch_attr(page: str, op: Op, lt: int, gt: int, name: str) -> str {
    rebuilt = with_attr(page.slice(lt, gt + 1), name, op.value)
    next = page.slice(0, lt) ++ rebuilt ++ page.slice(gt + 1, page.length())

    apply_from(next, op, lt + rebuilt.length())
}

marker(key: str) -> str => "data-signal=\"" ++ escape_html(key) ++ "\""

tag_open(page: str, at: int) -> int {
    if at <= 0 {
        0
    } else if page.at(at) == "<" {
        at
    } else {
        tag_open(page, at - 1)
    }
}

tag_name(page: str, lt: int) -> str => name_from(page, lt + 1, "")

name_from(page: str, i: int, acc: str) -> str {
    if i >= page.length() || !is_name_char(page.at(i)) {
        acc
    } else {
        name_from(page, i + 1, acc ++ page.at(i))
    }
}

is_name_char(ch: str) -> bool => ch.is_alpha() || ch.is_ascii_digit()

close_at(page: str, tag: str, from: int) -> int =>
    close_scan(page, tag, from, 0)

close_scan(page: str, tag: str, at: int, depth: int) -> int {
    closing = index_of_from(page, "</" ++ tag ++ ">", at)
    opening = next_open(page, tag, at)

    if closing < 0 {
        page.length()
    } else if opening >= 0 && opening < closing {
        close_scan(page, tag, opening + tag.length() + 1, depth + 1)
    } else if depth == 0 {
        closing
    } else {
        close_scan(page, tag, closing + tag.length() + 3, depth - 1)
    }
}

next_open(page: str, tag: str, at: int) -> int {
    found = index_of_from(page, "<" ++ tag, at)
    after = found + tag.length() + 1

    if found < 0 {
        -1
    } else if after >= page.length() || !is_name_char(page.at(after)) {
        found
    } else {
        next_open(page, tag, found + 1)
    }
}

with_attr(open: str, name: str, v: str) -> str {
    pat = " " ++ name ++ "=\""
    at = open.index_of(pat)
    end = index_of_from(open, "\"", at + pat.length())

    if at < 0 {
        open.slice(0, open.length() - 1) ++ pat ++ escape_html(v) ++ "\">"
    } else {
        open.slice(0, at + pat.length()) ++ escape_html(v)
            ++ open.slice(end, open.length())
    }
}

attr_in(open: str, name: str) -> str {
    pat = " " ++ name ++ "=\""
    at = open.index_of(pat)

    if at < 0 {
        ""
    } else {
        open.slice(at + pat.length(),
                   index_of_from(open, "\"", at + pat.length()))
    }
}

/** `runtime()` inside a `<script>`, ready to drop into a page's `<head>`. */
runtime_script() -> str => element("script", runtime())

/** The patcher, as JavaScript source. */
runtime() -> str => """
window.macaSignal = function (ops) {
  for (var i = 0; i < ops.length; i++) {
    var op = ops[i];
    var key = op.key.replace(/[\\"]/g, "\\$&");
    var nodes = document.querySelectorAll('[data-signal="' + key + '"]');
    for (var j = 0; j < nodes.length; j++) {
      var el = nodes[j];
      var as = el.getAttribute("data-signal-as");
      if (!as) el.textContent = op.value;
      else if (as === "html") el.innerHTML = op.value;
      else if (as === "value") el.value = op.value;
      else el.setAttribute(as, op.value);
    }
  }
};
"""

/** An HTML comment saying the page was rendered once and is not live. */
static_note() -> str =>
    "<!-- rendered once by a native build; no DOM to patch -->"
