/// Should output carry escape codes right now?
enabled() -> bool {
    if env("NO_COLOR") != "" {
        false
    } else if env("FORCE_COLOR") != "" {
        true
    } else {
        is_tty()
    }
}

/// `s` wrapped in an SGR code, or `s` unchanged where colour is off.
paint(code: str, s: str) -> str {
    if !enabled() || s == "" {
        s
    } else {
        chr(27) ++ "[" ++ code ++ "m" ++ s ++ chr(27) ++ "[0m"
    }
}

/// How many columns `s` takes on screen.
width(s: str) -> int {
    n = s.length()
    out = 0
    i = 0
    while i < n {
        b = ord(s.at(i))
        if b == 27 {
            i = skip_escape(s, i + 1)
        } else if b < 128 {
            out = out + 1
            i = i + 1
        } else {
            len = utf8_len(b)
            out = out + columns(codepoint(s, i, len))
            i = i + len
        }
    }
    out
}

utf8_len(b: int) -> int {
    if b >= 240 {
        4
    } else if b >= 224 {
        3
    } else if b >= 192 {
        2
    } else {
        1
    }
}

codepoint(s: str, i: int, len: int) -> int {
    lead = ord(s.at(i))
    cp = lead - lead_base(len)
    at = 1
    while at < len {
        cp = cp * 64 + tail(s, i + at)
        at = at + 1
    }
    cp
}

lead_base(len: int) -> int {
    if len == 4 {
        240
    } else if len == 3 {
        224
    } else if len == 2 {
        192
    } else {
        0
    }
}

tail(s: str, i: int) -> int {
    b = ord(s.at(i))
    b >= 128 ? b - 128 : 0
}

columns(cp: int) -> int {
    if cp >= 768 && cp <= 879 {
        0
    } else if cp == 8203 {
        0
    } else if cp >= 4352 && cp <= 4447 {
        2
    } else if cp >= 11904 && cp <= 42191 {
        2
    } else if cp >= 44032 && cp <= 55203 {
        2
    } else if cp >= 63744 && cp <= 64255 {
        2
    } else if cp >= 65072 && cp <= 65135 {
        2
    } else if cp >= 65280 && cp <= 65376 {
        2
    } else if cp >= 127744 && cp <= 129791 {
        2
    } else {
        1
    }
}

skip_escape(s: str, from: int) -> int {
    n = s.length()
    i = from
    while i < n && !s.at(i).is_alpha() {
        i = i + 1
    }
    i + 1
}

/// Pad `s` to `w` columns, counting what shows rather than what is stored.
pad(s: str, w: int) -> str {
    short = w - width(s)
    short > 0 ? s ++ " ".repeat(short) : s
}

/// Right-align `s` within `w` columns, for a column of numbers.
pad_left(s: str, w: int) -> str {
    short = w - width(s)
    short > 0 ? " ".repeat(short) ++ s : s
}

/// Drop every escape sequence, leaving the text a file should get.
plain(s: str) -> str {
    n = s.length()
    out = ""
    i = 0
    while i < n {
        if s.at(i) == chr(27) {
            i = skip_escape(s, i + 1)
        } else {
            out = out ++ s.at(i)
            i = i + 1
        }
    }
    out
}

bold(s: str) -> str => paint("1", s)
dim(s: str) -> str => paint("2", s)
italic(s: str) -> str => paint("3", s)
underline(s: str) -> str => paint("4", s)

red(s: str) -> str => paint("31", s)
green(s: str) -> str => paint("32", s)
yellow(s: str) -> str => paint("33", s)
blue(s: str) -> str => paint("34", s)
magenta(s: str) -> str => paint("35", s)
cyan(s: str) -> str => paint("36", s)
grey(s: str) -> str => paint("90", s)

/// The four things a command line says about what happened, each with the marker and colour it always has.
ok(s: str) -> str => green("✓") ++ " " ++ s
warn(s: str) -> str => yellow("!") ++ " " ++ s
bad(s: str) -> str => red("✗") ++ " " ++ s
note(s: str) -> str => grey("-") ++ " " ++ grey(s)
