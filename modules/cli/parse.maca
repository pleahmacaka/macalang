// cli/parse — a command line, read against what the command said it accepts.
//
// A refusal is a value, not an exit. The command decides what to do about a
// bad argument — print help, suggest a fix, carry on with a default — and a
// parser that called `exit` for it would take that decision away and make the
// whole thing untestable besides.
//
//   got = parse(Greet, args)
//   if got.error != "" {
//       err(got.error)
//       info(help(Greet))
//       1
//   } else {
//       greet(got.value("name", ""), got.count("times", 1))
//   }
//
// What is accepted:
//
//   --long value    --long=value    -s value    -s=value
//   --flag          -f              -abc        (flags, bundled)
//   --              everything after this is positional, whatever it looks like
//
// What is refused, by name: an option the command does not declare, a value
// missing from an option that takes one, a positional too many, and a
// positional missing. Each says what was wrong; the first three also say what
// would have worked.

import { find_long, find_short, found, long_names } from cli/spec

Parsed = {
    /// Every option given, by long name. A flag that was given is "true".
    opts: Map str str,
    /// The positionals, in order.
    args: str[],
    /// Empty when the line was understood. Otherwise one line saying what was
    /// wrong with it.
    error: str,
    /// Was `--help` or `-h` asked for? A command checks this before its
    /// arguments, because `cmd --help` should work when the arguments do not.
    wants_help: bool,
}

/// Read `argv` against `c`.
parse(c: Cmd, argv: str[]) -> Parsed {
    empty: Map str str = map()
    out = Parsed { opts = empty, args = [], error = "", wants_help = false }
    n = argv.length()
    i = 0
    only_args = false

    while i < n {
        a = argv.get(i)

        if only_args {
            out = out with { args = out.args.push(a) }
            i = i + 1
        } else if a == "--" {
            only_args = true
            i = i + 1
        } else if a == "--help" || a == "-h" {
            out = out with { wants_help = true }
            i = i + 1
        } else if a.starts_with("--") {
            step = take_long(c, out, a.substr(2, a.length() - 2), argv, i)
            out = step.parsed
            i = step.next
        } else if a.starts_with("-") && a != "-" {
            step = take_short(c, out, a.substr(1, a.length() - 1), argv, i)
            out = step.parsed
            i = step.next
        } else {
            out = out with { args = out.args.push(a) }
            i = i + 1
        }

        if out.error != "" {
            i = n
        }
    }

    out.error != "" || out.wants_help ? out : check_args(c, out)
}

// Where reading one argument got to, and what it made of it. Two answers from
// one step, which a record says and a return value cannot.
Step = { parsed: Parsed, next: int }

// Stop here, with a reason. The index still advances so the caller's loop can
// end normally rather than on a special case.
refuse(p: Parsed, why: str, i: int) -> Step =>
    Step { parsed = p with { error = why }, next = i + 1 }

// `--name`, `--name value`, or `--name=value`.
take_long(c: Cmd, p: Parsed, body: str, argv: str[], i: int) -> Step {
    cut = body.index_of("=")
    name = cut >= 0 ? body.substr(0, cut) : body
    inline = cut >= 0 ? body.substr(cut + 1, body.length() - cut - 1) : ""
    o = find_long(c, name)

    if !found(o) {
        refuse(p, unknown(c, "--" ++ name), i)
    } else if !o.takes {
        if cut >= 0 {
            why = "`--{name}` is a flag and takes no value"
            refuse(p, why ++ " — write `--{name}` on its own", i)
        } else {
            Step { parsed = set(p, name, "true"), next = i + 1 }
        }
    } else if cut >= 0 {
        Step { parsed = set(p, name, inline), next = i + 1 }
    } else if i + 1 < argv.length() {
        Step { parsed = set(p, name, argv.get(i + 1)), next = i + 2 }
    } else {
        refuse(p, needs_value("--" ++ name, o.help), i)
    }
}

// `-s`, `-s value`, `-s=value`, or a bundle of flags like `-abc`.
take_short(c: Cmd, p: Parsed, body: str, argv: str[], i: int) -> Step {
    cut = body.index_of("=")
    name = cut >= 0 ? body.substr(0, cut) : body.substr(0, 1)
    inline = cut >= 0 ? body.substr(cut + 1, body.length() - cut - 1) : ""
    o = find_short(c, name)

    if !found(o) {
        refuse(p, unknown(c, "-" ++ name), i)
    } else if o.takes && cut >= 0 {
        Step { parsed = set(p, o.long, inline), next = i + 1 }
    } else if o.takes && body.length() > 1 {
        // `-n3` is not `-n 3`. Two spellings for one thing is how `-n3` and
        // `-n 3` end up meaning different numbers in the same program.
        why = "`-{name}` takes a value"
        refuse(p, why ++ " — write `-{name} <value>` or `-{name}=<value>`", i)
    } else if o.takes {
        if i + 1 < argv.length() {
            Step { parsed = set(p, o.long, argv.get(i + 1)), next = i + 2 }
        } else {
            refuse(p, needs_value("-" ++ name, o.help), i)
        }
    } else {
        Step { parsed = bundle(c, p, body, 0), next = i + 1 }
    }
}

// `-abc` is three flags. A short that takes a value cannot be one of them: it
// would need an argument, and there is nowhere in a bundle to put one.
bundle(c: Cmd, p: Parsed, body: str, at: int) -> Parsed {
    if at >= body.length() || p.error != "" {
        p
    } else {
        s = body.at(at)
        o = find_short(c, s)

        if !found(o) {
            p with { error = unknown(c, "-" ++ s) }
        } else if o.takes {
            bundle(c, p with {
                error = "`-{s}` takes a value, so it cannot be bundled — write it on its own"
            }, body, at + 1)
        } else {
            bundle(c, set(p, o.long, "true"), body, at + 1)
        }
    }
}

set(p: Parsed, name: str, value: str) -> Parsed =>
    p with { opts = p.opts.set(name, value) }

unknown(c: Cmd, given: str) -> str {
    near = nearest(given.replace("-", ""), long_names(c), 0, "", 3)
    near == ""
        ? "unknown option `{given}`"
        : "unknown option `{given}` — did you mean `--{near}`?"
}

needs_value(given: str, what: str) -> str =>
    what == ""
        ? "`{given}` needs a value"
        : "`{given}` needs a value — {what}"

// The closest name within `best` edits, or "" when nothing is close. Bounded so
// a wild typo gets no suggestion rather than a confusing one.
nearest(want: str, names: str[], i: int, found: str, best: int) -> str {
    if i >= names.length() {
        found
    } else {
        d = distance(want, names.get(i))
        d < best
            ? nearest(want, names, i + 1, names.get(i), d)
            : nearest(want, names, i + 1, found, best)
    }
}

// Levenshtein, one row at a time — enough for `--verbsoe`.
distance(a: str, b: str) -> int {
    prev = row(b.length() + 1, 0, [])
    i = 0
    while i < a.length() {
        cur = [i + 1]
        j = 0
        while j < b.length() {
            cost = a.at(i) == b.at(j) ? 0 : 1
            sub = prev.get(j) + cost
            best = least(sub, prev.get(j + 1) + 1, cur.get(j) + 1)
            cur = cur.push(best)
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    prev.get(b.length())
}

row(n: int, at: int, acc: int[]) -> int[] =>
    at >= n ? acc : row(n, at + 1, acc.push(at))

least(a: int, b: int, c: int) -> int {
    m = a < b ? a : b
    m < c ? m : c
}

// Too few positionals, or too many. Then each one is filed under the name the
// command gave it, so `value("name", …)` reads a positional and an option the
// same way — the command declared both, and which is which is a spelling
// decision the reader of the command's body should not have to remember.
check_args(c: Cmd, p: Parsed) -> Parsed {
    want = c.args.length()
    got = p.args.length()
    takes_rest = want > 0 && c.args.get(want - 1).many

    if got < want && !(takes_rest && got >= want - 1) {
        p with { error = "missing <{c.args.get(got).name}> — {c.args.get(got).help}" }
    } else if got > want && !takes_rest {
        p with {
            error = "too many arguments: `{p.args.get(want)}` — {c.name} takes {want}"
        }
    } else {
        name_args(c, p, 0)
    }
}

name_args(c: Cmd, p: Parsed, i: int) -> Parsed {
    if i >= c.args.length() || i >= p.args.length() {
        p
    } else if c.args.get(i).many {
        // the last one holds everything left, joined by a space for the name
        // and reachable one at a time through `from(i)`
        set(p, c.args.get(i).name, p.args.slice(i, p.args.length()).join(" "))
    } else {
        name_args(c, set(p, c.args.get(i).name, p.args.get(i)), i + 1)
    }
}

/// The value given for `name`, or `fallback`. A command reads its options
/// through this rather than through the map, so a name that was never declared
/// reads as its default instead of as "".
value(p: Parsed, name: str, fallback: str) -> str => p.opts.get(name, fallback)

/// Whether a flag was given.
on(p: Parsed, name: str) -> bool => p.opts.get(name, "") == "true"

/// A numeric option, or `fallback` when it was not given. A value that is not a
/// number reads as 0, which `int` already does — validating it is the command's
/// business, since only the command knows what range is sensible.
count(p: Parsed, name: str, fallback: int) -> int {
    v = p.opts.get(name, "")
    v == "" ? fallback : int(v)
}

/// The positional at `i`, or "" past the end.
at(p: Parsed, i: int) -> str => p.args.get(i)

/// Everything from `i` on — what a trailing `rest` argument collects.
from(p: Parsed, i: int) -> str[] => p.args.slice(i, p.args.length())
