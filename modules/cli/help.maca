import { Cmd, Opt } from cli/spec
import { bold, dim, grey, pad, width } from cli/style

/// The whole help page for `c`.
help(c: Cmd) -> str {
    out = bold(c.name) ++ (c.about == "" ? "" : ": " ++ c.about) ++ "\n\n"
    out = out ++ bold("Usage") ++ "\n  " ++ usage(c) ++ "\n"

    if c.args.length() > 0 {
        out = out ++ "\n" ++ bold("Arguments") ++ "\n" ++ arg_lines(c, 0, "")
    }
    out ++ "\n" ++ bold("Options") ++ "\n" ++ opt_lines(c, 0, "") ++ help_line(c)
}

/// The one line that shows how the command is invoked.
usage(c: Cmd) -> str {
    line = c.name
    if c.opts.length() > 0 {
        line = line ++ " [options]"
    }
    line ++ arg_usage(c, 0, "")
}

arg_usage(c: Cmd, i: int, acc: str) -> str {
    if i >= c.args.length() {
        acc
    } else {
        a = c.args.get(i)
        arg_usage(c, i + 1, acc ++ (a.many ? " <{a.name}>..." : " <{a.name}>"))
    }
}

column(c: Cmd) -> int {
    w = 10
    for a in c.args {
        cw = width("<{a.name}>")
        if cw > w {
            w = cw
        }
    }
    for o in c.opts {
        cw = width(left_of(o))
        if cw > w {
            w = cw
        }
    }
    w + 2
}

left_of(o: Opt) -> str =>
    o.short == "" ? "    --{o.long}" : "-{o.short}, --{o.long}"

arg_lines(c: Cmd, i: int, acc: str) -> str {
    if i >= c.args.length() {
        acc
    } else {
        a = c.args.get(i)
        arg_lines(c, i + 1, acc ++ "  " ++ pad("<{a.name}>", column(c)) ++ a.help ++ "\n")
    }
}

opt_lines(c: Cmd, i: int, acc: str) -> str {
    if i >= c.opts.length() {
        acc
    } else {
        o = c.opts.get(i)
        tail = o.takes && o.fallback != "" ? grey("  (default: {o.fallback})") : ""
        line = "  " ++ pad(left_of(o), column(c)) ++ o.help ++ tail
        opt_lines(c, i + 1, acc ++ line ++ "\n")
    }
}

help_line(c: Cmd) -> str =>
    "  " ++ pad("-h, --help", column(c)) ++ dim("show this and exit") ++ "\n"
