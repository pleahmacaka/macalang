import { bold, dim, grey, pad, pad_left, width } from cli/style

/** A table with a header row, columns as wide as their widest cell. */
table(header: str[], rows: str[][]) -> str {
    cols = header.length()
    w = widths(header, rows, cols)

    out = ""
    i = 0
    while i < cols {
        cell = bold(pad(header.get(i), w.get(i)))
        out = out ++ cell ++ (i + 1 < cols ? "  " : "")
        i = i + 1
    }
    out = out ++ "\n"

    i = 0
    while i < cols {
        out = out ++ grey("─".repeat(w.get(i))) ++ (i + 1 < cols ? "  " : "")
        i = i + 1
    }
    out = out ++ "\n"

    for row in rows {
        out = out ++ row_text(row, w, cols) ++ "\n"
    }
    out
}

/** The same table with the numeric columns right-aligned. */
table_aligned(header: str[], rows: str[][]) -> str {
    cols = header.length()
    w = widths(header, rows, cols)

    out = ""
    i = 0
    while i < cols {
        head = numeric_column(rows, i) ? pad_left(header.get(i), w.get(i))
                                      : pad(header.get(i), w.get(i))
        out = out ++ bold(head) ++ (i + 1 < cols ? "  " : "")
        i = i + 1
    }
    out = out ++ "\n"

    i = 0
    while i < cols {
        out = out ++ grey("─".repeat(w.get(i))) ++ (i + 1 < cols ? "  " : "")
        i = i + 1
    }
    out = out ++ "\n"

    for row in rows {
        j = 0
        line = ""
        while j < cols {
            cell = j < row.length() ? row.get(j) : ""
            line = line ++ (numeric_column(rows, j) ? pad_left(cell, w.get(j))
                                                    : pad(cell, w.get(j)))
            line = line ++ (j + 1 < cols ? "  " : "")
            j = j + 1
        }
        out = out ++ line ++ "\n"
    }
    out
}

widths(header: str[], rows: str[][], cols: int) -> int[] {
    w = []
    i = 0
    while i < cols {
        best = width(header.get(i))
        for row in rows {
            if i < row.length() && width(row.get(i)) > best {
                best = width(row.get(i))
            }
        }
        w = w.push(best)
        i = i + 1
    }
    w
}

row_text(row: str[], w: int[], cols: int) -> str {
    out = ""
    i = 0
    while i < cols {
        cell = i < row.length() ? row.get(i) : ""
        out = out ++ pad(cell, w.get(i)) ++ (i + 1 < cols ? "  " : "")
        i = i + 1
    }
    out
}

numeric_column(rows: str[][], i: int) -> bool =>
    filled(rows, i, 0) && all_numeric(rows, i, 0)

filled(rows: str[][], i: int, at: int) -> bool {
    if at >= rows.length() {
        false
    } else if i < rows.get(at).length() && rows.get(at).get(i) != "" {
        true
    } else {
        filled(rows, i, at + 1)
    }
}

all_numeric(rows: str[][], i: int, at: int) -> bool {
    if at >= rows.length() {
        true
    } else if i >= rows.get(at).length() || rows.get(at).get(i) == "" {
        all_numeric(rows, i, at + 1)
    } else if numeric(rows.get(at).get(i)) {
        all_numeric(rows, i, at + 1)
    } else {
        false
    }
}

numeric(s: str) -> bool {
    body = s.starts_with("-") ? s.substr(1, s.length() - 1) : s
    body != "" && digits_only(body, 0)
}

digits_only(s: str, i: int) -> bool {
    if i >= s.length() {
        true
    } else if s.at(i).is_ascii_digit() || s.at(i) == "." || s.at(i) == "," {
        digits_only(s, i + 1)
    } else {
        false
    }
}

/** A horizontal rule, optionally with a title sitting in it. */
rule(title: str) -> str {
    w = 60
    if title == "" {
        grey("─".repeat(w))
    } else {
        left = grey("── ")
        right = w - width(title) - 4
        left ++ bold(title) ++ " " ++ grey("─".repeat(right > 0 ? right : 0))
    }
}

/** A box around `body`, with `title` in its top edge. */
panel(title: str, body: str) -> str {
    lines = body.split("\n")
    inner = widest(lines, 0, width(title) + 2)

    edge = "─".repeat(inner - width(title) - 1)
    out = grey("┌─ ") ++ bold(title) ++ grey(" " ++ edge ++ "┐")
    out = out ++ "\n"
    for line in lines {
        out = out ++ grey("│ ") ++ pad(line, inner) ++ grey(" │") ++ "\n"
    }
    out ++ grey("└" ++ "─".repeat(inner + 2) ++ "┘")
}

widest(lines: str[], i: int, best: int) -> int {
    if i >= lines.length() {
        best
    } else if width(lines.get(i)) > best {
        widest(lines, i + 1, width(lines.get(i)))
    } else {
        widest(lines, i + 1, best)
    }
}

/** ` key value`: a labelled fact, with the label dimmed so the value is what
 * the eye lands on.
 */
kv(key: str, value: str) -> str => "  " ++ dim(pad(key, 14)) ++ value

/** A bulleted line. */
bullet(s: str) -> str => "  " ++ grey("•") ++ " " ++ s

/** `[####----] n%`: a progress bar of a given width. */
bar(done: int, total: int, w: int) -> str {
    share = total > 0 ? done * w / total : 0
    filled = share > w ? w : (share < 0 ? 0 : share)
    pct = total > 0 ? done * 100 / total : 0
    body = "█".repeat(filled) ++ grey("░".repeat(w - filled))
    "[" ++ body ++ "] " ++ pad_left("{pct}%", 4)
}

/** The same line, rewritten in place: carriage return, no newline. */
redraw(s: str) {
    if is_tty() {
        print("\r" ++ s)
    }
}
