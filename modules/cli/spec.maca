/** One `--name` the command accepts. */
Opt = {
    long: str,
    short: str,
    help: str,
    fallback: str,
    takes: bool,
}

/** One positional. */
Arg = {
    name: str,
    help: str,
    many: bool,
}

Cmd = {
    name: str,
    about: str,
    opts: Opt[],
    args: Arg[],
}

/** A command with a name and one line saying what it does. */
command(name: str, about: str) -> Cmd =>
    Cmd { name = name, about = about, opts = [], args = [] }

/** `--long value` / `-s value`, with `fallback` when it is not given. */
opt(c: Cmd, long: str, short: str, help: str, fallback: str) -> Cmd =>
    c with {
        opts = c.opts.push(Opt {
            long = long,
            short = short,
            help = help,
            fallback = fallback,
            takes = true,
        })
    }

/** `--long` / `-s`, present or absent. */
flag(c: Cmd, long: str, short: str, help: str) -> Cmd =>
    c with {
        opts = c.opts.push(Opt {
            long = long,
            short = short,
            help = help,
            fallback = "",
            takes = false,
        })
    }

/** One positional, in the order it is written. */
arg(c: Cmd, name: str, help: str) -> Cmd => add_arg(c, name, help, false)

/** A positional that takes the rest of the command line. */
rest(c: Cmd, name: str, help: str) -> Cmd => add_arg(c, name, help, true)

add_arg(c: Cmd, name: str, help: str, many: bool) -> Cmd =>
    c with { args = c.args.push(Arg { name = name, help = help, many = many }) }

/** The option `--<long>` names, or one with an empty `long` if there is none.
 */
find_long(c: Cmd, long: str) -> Opt {
    match_at(c.opts, 0, long, true)
}

/** The option `-<short>` names, or one with an empty `long` if there is none.
 */
find_short(c: Cmd, short: str) -> Opt {
    match_at(c.opts, 0, short, false)
}

match_at(opts: Opt[], i: int, want: str, by_long: bool) -> Opt {
    if i >= opts.length() {
        Opt { long = "", short = "", help = "", fallback = "", takes = false }
    } else if by_long && opts.get(i).long == want {
        opts.get(i)
    } else if !by_long && want != "" && opts.get(i).short == want {
        opts.get(i)
    } else {
        match_at(opts, i + 1, want, by_long)
    }
}

/** Did a lookup find anything? */
found(o: Opt) -> bool => o.long != ""

/** The long names the command accepts, for a `did you mean` on a misspelling.
 */
long_names(c: Cmd) -> str[] => names_from(c.opts, 0, [])

names_from(opts: Opt[], i: int, acc: str[]) -> str[] {
    if i >= opts.length() {
        acc
    } else {
        names_from(opts, i + 1, acc.push(opts.get(i).long))
    }
}
