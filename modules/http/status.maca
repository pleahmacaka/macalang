/// The reason phrase for a status code.
reason(code: int) -> str {
    if code == 200 {
        "OK"
    } else if code == 201 {
        "Created"
    } else if code == 204 {
        "No Content"
    } else if code == 301 {
        "Moved Permanently"
    } else if code == 302 {
        "Found"
    } else if code == 304 {
        "Not Modified"
    } else if code == 400 {
        "Bad Request"
    } else if code == 401 {
        "Unauthorized"
    } else if code == 403 {
        "Forbidden"
    } else if code == 404 {
        "Not Found"
    } else if code == 405 {
        "Method Not Allowed"
    } else if code == 409 {
        "Conflict"
    } else if code == 413 {
        "Payload Too Large"
    } else if code == 415 {
        "Unsupported Media Type"
    } else if code == 422 {
        "Unprocessable Content"
    } else if code == 429 {
        "Too Many Requests"
    } else if code == 500 {
        "Internal Server Error"
    } else if code == 501 {
        "Not Implemented"
    } else if code == 503 {
        "Service Unavailable"
    } else {
        class_reason(code)
    }
}

class_reason(code: int) -> str {
    if code < 200 {
        "Informational"
    } else if code < 300 {
        "Success"
    } else if code < 400 {
        "Redirection"
    } else if code < 500 {
        "Client Error"
    } else {
        "Server Error"
    }
}

/// Did this code succeed?
is_ok(code: int) -> bool =>
    code >= 200 && code < 300

/// The MIME type for a filename's extension, `application/octet-stream` when nothing matches.
content_type(path: str) -> str {
    ext = extension_of(path)

    if ext == "html" || ext == "htm" {
        "text/html; charset=utf-8"
    } else if ext == "css" {
        "text/css; charset=utf-8"
    } else if ext == "js" || ext == "mjs" {
        "text/javascript; charset=utf-8"
    } else if ext == "json" {
        "application/json; charset=utf-8"
    } else if ext == "svg" {
        "image/svg+xml"
    } else if ext == "png" {
        "image/png"
    } else if ext == "jpg" || ext == "jpeg" {
        "image/jpeg"
    } else if ext == "gif" {
        "image/gif"
    } else if ext == "webp" {
        "image/webp"
    } else if ext == "ico" {
        "image/x-icon"
    } else if ext == "woff2" {
        "font/woff2"
    } else if ext == "wasm" {
        "application/wasm"
    } else if ext == "txt" || ext == "md" {
        "text/plain; charset=utf-8"
    } else if ext == "xml" {
        "application/xml"
    } else if ext == "pdf" {
        "application/pdf"
    } else {
        "application/octet-stream"
    }
}

extension_of(path: str) -> str {
    segment = last_segment(path)
    at = last_dot(segment, segment.length() - 1)

    if at < 0 {
        ""
    } else {
        segment.substr(at + 1, segment.length()).lower()
    }
}

last_segment(path: str) -> str {
    at = last_slash(path, path.length() - 1)

    if at < 0 {
        path
    } else {
        path.substr(at + 1, path.length())
    }
}

last_slash(s: str, i: int) -> int {
    if i < 0 {
        -1
    } else if s.at(i) == "/" {
        i
    } else {
        last_slash(s, i - 1)
    }
}

last_dot(s: str, i: int) -> int {
    if i <= 0 {
        -1
    } else if s.at(i) == "." {
        i
    } else {
        last_dot(s, i - 1)
    }
}
