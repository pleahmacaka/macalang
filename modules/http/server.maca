import "http.h"

import { parse_request, Request } from http/request
import { Response, render, status } from http/response

http_listen(port: int) -> int
http_accept_loop(server: int, handler: (str) -> str) -> int
http_fetch(host: str, port: int, request: str) -> str

/// Serve `handler` on `port` until the process ends.
listen(port: int, handler) -> int {
    server = http_listen(port)

    if server < 0 {
        err(bind_failure(server, port))
        1
    } else {
        http_accept_loop(server, raw => render(answer(handler, raw)))
        0
    }
}

answer(handler, raw: str) -> Response {
    r = parse_request(raw)

    if r.method == "" {
        status(400)
    } else {
        handler(r)
    }
}

bind_failure(code: int, port: int) -> str {
    if code == -2 {
        "port {port} is already in use"
    } else if code == -1 {
        "could not open a socket"
    } else {
        "could not listen on port {port}"
    }
}

/// One request against a server, returning the whole reply including headers.
fetch(host: str, port: int, request: str) -> str =>
    http_fetch(host, port, request)

/// A `GET` for the common case.
get(host: str, port: int, path: str) -> str =>
    fetch(host, port,
          "GET {path} HTTP/1.1\r\nHost: {host}\r\nConnection: close\r\n\r\n")
