import { split_once, index_of_from } from std/text

/** One request, parsed. */
Request = {
    method:  str
    /** The path with the query string removed, and percent-escapes decoded. */
    path:    str
    /** Everything after `?`, undecoded. */
    query:   str
    version: str
    /** The header block, still raw. */
    headers: str
    body:    str
}

/** Parse a raw request. */
parse_request(raw: str) -> Request {
    split = split_head(raw)
    head = normalize_endings(split.get(0))
    body = split.get(1)
    line_rest = split_once(head, "\n")
    parts = line_rest.get(0).split(" ").filter(w => w != "")
    target = if parts.length() > 1 { parts.get(1) } else { "" }
    path_query = split_once(target, "?")

    Request {
        method = if parts.length() > 2 { parts.get(0).upper() } else { "" },
        path = percent_decode(path_query.get(0)),
        query = path_query.get(1),
        version = if parts.length() > 2 { parts.get(2) } else { "" },
        headers = line_rest.get(1),
        body = body
    }
}

split_head(raw: str) -> str[] {
    crlf = raw.index_of("\r\n\r\n")
    lf = raw.index_of("\n\n")

    if crlf >= 0 && (lf < 0 || crlf < lf) {
        [raw.substr(0, crlf), raw.substr(crlf + 4, raw.length())]
    } else if lf >= 0 {
        [raw.substr(0, lf), raw.substr(lf + 2, raw.length())]
    } else {
        [raw, ""]
    }
}

normalize_endings(raw: str) -> str =>
    raw.replace("\r\n", "\n")

/** A header's value, or "" when it is absent. */
header(r: Request, name: str) -> str =>
    scan_headers(r.headers.split("\n"), 0, name.lower())

scan_headers(lines: str[], i: int, want: str) -> str {
    if i >= lines.length() {
        ""
    } else if header_name(lines.get(i)) == want {
        header_value(lines.get(i))
    } else {
        scan_headers(lines, i + 1, want)
    }
}

header_name(line: str) -> str =>
    split_once(line, ":").get(0).trim().lower()

header_value(line: str) -> str =>
    split_once(line, ":").get(1).trim()

/** A query parameter's value, or "" when absent. */
query_value(r: Request, name: str) -> str =>
    scan_pairs(r.query.split("&"), 0, name)

/** The same, over a form-encoded body: `application/x-www-form-urlencoded`. */
form_value(r: Request, name: str) -> str =>
    scan_pairs(r.body.split("&"), 0, name)

scan_pairs(pairs: str[], i: int, want: str) -> str {
    if i >= pairs.length() {
        ""
    } else if split_once(pairs.get(i), "=").get(0) == want {
        percent_decode(split_once(pairs.get(i), "=").get(1).replace("+", " "))
    } else {
        scan_pairs(pairs, i + 1, want)
    }
}

/** Decode `%XX` escapes. */
percent_decode(s: str) -> str =>
    decode_from(s, 0, "")

decode_from(s: str, i: int, acc: str) -> str {
    if i >= s.length() {
        acc
    } else if s.at(i) == "%" && i + 2 < s.length() {
        code = hex_pair(s.at(i + 1), s.at(i + 2))

        if code < 0 {
            decode_from(s, i + 1, acc + s.at(i))
        } else {
            decode_from(s, i + 3, acc + chr(code))
        }
    } else {
        decode_from(s, i + 1, acc + s.at(i))
    }
}

hex_pair(hi: str, lo: str) -> int {
    h = hex_digit(hi)
    l = hex_digit(lo)

    if h < 0 || l < 0 {
        -1
    } else {
        h * 16 + l
    }
}

hex_digit(c: str) -> int {
    b = ord(c)

    if b >= Zero && b <= Nine {
        b - Zero
    } else if b >= LowerA && b <= LowerF {
        10 + b - LowerA
    } else if b >= UpperA && b <= UpperF {
        10 + b - UpperA
    } else {
        -1
    }
}

Zero = ord("0")
Nine = ord("9")
LowerA = ord("a")
LowerF = ord("f")
UpperA = ord("A")
UpperF = ord("F")
