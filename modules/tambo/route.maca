/// What a pattern bound from a path.
Bound = {
    ok: bool
    /// The bound segments, by name.
    params: Map str str
}

/// Match `path` against `pattern`.
bind_path(pattern: str, path: str) -> Bound {
    ps = pattern.split("/")
    xs = path.split("/")
    empty: Map str str = map()

    if !ends_in_wildcard(ps) {
        if ps.length() != xs.length() {
            miss()
        } else {
            bind_segments(ps, xs, 0, ps.length(), empty)
        }
    } else if xs.length() < ps.length() {
        miss()
    } else {
        upto = ps.length() - 1
        tail = xs.slice(upto, xs.length()).join("/")

        bind_segments(ps, xs, 0, upto, empty.set("*", tail))
    }
}

bind_segments(ps: str[], xs: str[], i: int, upto: int,
              acc: Map str str) -> Bound {
    if i >= upto {
        Bound { ok = true, params = acc }
    } else if is_param(ps.get(i)) && xs.get(i) == "" {
        miss()
    } else if is_param(ps.get(i)) {
        name = param_name(ps.get(i))

        bind_segments(ps, xs, i + 1, upto, acc.set(name, xs.get(i)))
    } else if ps.get(i) == xs.get(i) {
        bind_segments(ps, xs, i + 1, upto, acc)
    } else {
        miss()
    }
}

miss() -> Bound {
    empty: Map str str = map()

    Bound { ok = false, params = empty }
}

/// Is `a` a more specific pattern than `b`?
more_specific(a: str, b: str) -> bool {
    left = a.split("/")
    right = b.split("/")
    at = first_difference(left, right, 0)

    if at < 0 {
        left.length() > right.length()
    } else {
        rank(left, at) > rank(right, at)
    }
}

first_difference(a: str[], b: str[], i: int) -> int {
    if i >= a.length() || i >= b.length() {
        -1
    } else if rank(a, i) != rank(b, i) {
        i
    } else {
        first_difference(a, b, i + 1)
    }
}

rank(ps: str[], i: int) -> int {
    if is_wildcard(ps, i) {
        0
    } else if is_param(ps.get(i)) {
        1
    } else {
        2
    }
}

/// The names a pattern binds, in order, with `"*"` last when it has one.
param_names(pattern: str) -> str[] =>
    collect_names(pattern.split("/"), 0, [])

collect_names(ps: str[], i: int, acc: str[]) -> str[] {
    if i >= ps.length() {
        acc
    } else if is_param(ps.get(i)) {
        collect_names(ps, i + 1, acc.push(param_name(ps.get(i))))
    } else if is_wildcard(ps, i) {
        collect_names(ps, i + 1, acc.push("*"))
    } else {
        collect_names(ps, i + 1, acc)
    }
}

/// A path this pattern matches, with each `:name` standing in for itself.
sample_path(pattern: str) -> str =>
    sample_segments(pattern.split("/"), 0, []).join("/")

sample_segments(ps: str[], i: int, acc: str[]) -> str[] {
    if i >= ps.length() {
        acc
    } else if is_param(ps.get(i)) {
        sample_segments(ps, i + 1, acc.push(param_name(ps.get(i))))
    } else if is_wildcard(ps, i) {
        sample_segments(ps, i + 1, acc.push(""))
    } else {
        sample_segments(ps, i + 1, acc.push(ps.get(i)))
    }
}

is_wildcard(ps: str[], i: int) -> bool =>
    ps.get(i) == "*" && i == ps.length() - 1

ends_in_wildcard(ps: str[]) -> bool =>
    ps.length() > 0 && is_wildcard(ps, ps.length() - 1)

is_param(seg: str) -> bool =>
    seg.starts_with(":") && seg.length() > 1

param_name(seg: str) -> str =>
    seg.slice(1, seg.length())
