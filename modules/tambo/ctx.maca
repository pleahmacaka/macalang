import { Request, percent_decode } from http/request
import { Response } from http/response
import { pass } from tambo/reply
import { split_once } from std/text

/// One request, as a handler sees it.
Ctx = {
    method: str
    /// The path with the query removed and percent-escapes decoded.
    path: str
    /// The handler being called: a route's name, a hook's name, or the fallback's.
    name: str
    /// The name of the route that matched, "" when nothing did.
    route: str
    /// The pattern that matched, "" when nothing did.
    pattern: str
    params: Map str str
    query: Map str str
    /// Header names lower-cased, because a client picks its own capitals.
    headers: Map str str
    body: str
    /// `now_ms()` at the moment the request was taken apart.
    arrived: int
    /// What the route answered.
    reply: Response
}

/// A bound segment, or "" when the pattern bound no such name.
param(ctx: Ctx, name: str) -> str =>
    ctx.params.get(name, "")

/// A bound segment as a number, or `fallback` when it is absent.
param_int(ctx: Ctx, name: str, fallback: int) -> int {
    v = ctx.params.get(name, "")

    v == "" ? fallback : int(v)
}

/// Everything a trailing `*` bound, or "".
wildcard(ctx: Ctx) -> str =>
    ctx.params.get("*", "")

/// A query parameter, or "".
query(ctx: Ctx, name: str) -> str =>
    ctx.query.get(name, "")

/// A header, matched however the client capitalised it, or "".
header(ctx: Ctx, name: str) -> str =>
    ctx.headers.get(name.lower(), "")

/// The context for `req`, routed to `name`.
context(req: Request, name: str, route: str, pattern: str,
        params: Map str str) -> Ctx =>
    Ctx {
        method = req.method,
        path = req.path,
        name = name,
        route = route,
        pattern = pattern,
        params = params,
        query = parse_query(req.query),
        headers = parse_headers(req.headers),
        body = req.body,
        arrived = now_ms(),
        reply = pass(),
    }

/// A context with nothing in it but a method and a path.
probe(method: str, path: str) -> Ctx {
    empty: Map str str = map()

    Ctx {
        method = method.upper(),
        path = path,
        name = "",
        route = "",
        pattern = "",
        params = empty,
        query = empty,
        headers = empty,
        body = "",
        arrived = 0,
        reply = pass(),
    }
}

/// `a=1&b=two` as a map, with `%XX` decoded and `+` read as a space.
parse_query(q: str) -> Map str str {
    empty: Map str str = map()

    if q == "" {
        empty
    } else {
        add_pairs(q.split("&"), 0, empty)
    }
}

add_pairs(ps: str[], i: int, acc: Map str str) -> Map str str {
    if i >= ps.length() {
        acc
    } else {
        cut = split_once(ps.get(i), "=")
        key = decode_form(cut.get(0))

        if key == "" {
            add_pairs(ps, i + 1, acc)
        } else {
            add_pairs(ps, i + 1, acc.set(key, decode_form(cut.get(1))))
        }
    }
}

decode_form(s: str) -> str =>
    percent_decode(s.replace("+", " "))

/// A raw header block as a map, names lower-cased and values trimmed.
parse_headers(block: str) -> Map str str {
    empty: Map str str = map()

    add_headers(block.replace("\r\n", "\n").split("\n"), 0, empty)
}

add_headers(ls: str[], i: int, acc: Map str str) -> Map str str {
    if i >= ls.length() {
        acc
    } else if !ls.get(i).contains(":") {
        add_headers(ls, i + 1, acc)
    } else {
        cut = split_once(ls.get(i), ":")
        name = cut.get(0).trim().lower()

        if name == "" {
            add_headers(ls, i + 1, acc)
        } else {
            add_headers(ls, i + 1, acc.set(name, cut.get(1).trim()))
        }
    }
}
