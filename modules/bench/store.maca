import { Result } from bench/time

/** Bumped when the stored shape changes. */
Version = 1

/** A run as a JSON document: a version, and the results in the order given. */
to_json(rs: Result[]) -> str =>
    "\{\"version\":{Version},\"results\":["
        ++ encoded(rs, 0, []).join(",") ++ "]\}"

encoded(rs: Result[], i: int, acc: str[]) -> str[] {
    if i >= rs.length() {
        acc
    } else {
        encoded(rs, i + 1, acc.push(one_json(rs[i])))
    }
}

one_json(r: Result) -> str =>
    "\{\"name\":" ++ encode_str(r.name) ++ ",\"size\":{r.size}"
        ++ ",\"iters\":{r.iters},\"samples\":[" ++ int_csv(r.samples, 0, [])
        ++ "],\"checksum\":{r.checksum}\}"

int_csv(xs: int[], i: int, acc: str[]) -> str {
    if i >= xs.length() {
        acc.join(",")
    } else {
        int_csv(xs, i + 1, acc.push(str(xs[i])))
    }
}

/** A JSON string literal. */
encode_str(s: str) -> str =>
    "\"" ++ s.replace("\\", "\\\\")
             .replace("\"", "\\\"")
             .replace("\n", "\\n")
             .replace("\r", "\\r")
             .replace("\t", "\\t") ++ "\""

/** The results in a document written by `to_json`. */
from_json(src: str) -> Result[] {
    if field_int(src, "version", 0) != Version {
        []
    } else {
        decoded(elements(field(src, "results")), 0, [])
    }
}

decoded(raw: str[], i: int, acc: Result[]) -> Result[] {
    if i >= raw.length() {
        acc
    } else {
        decoded(raw, i + 1, acc.push(one_result(raw[i])))
    }
}

one_result(src: str) -> Result =>
    Result {
        name = field_str(src, "name"),
        size = field_int(src, "size", 0),
        iters = field_int(src, "iters", 0),
        samples = int_list(elements(field(src, "samples")), 0, []),
        checksum = field_int(src, "checksum", 0),
    }

int_list(raw: str[], i: int, acc: int[]) -> int[] {
    if i >= raw.length() {
        acc
    } else {
        int_list(raw, i + 1, acc.push(int(raw[i])))
    }
}

/** The raw text of `key`'s value in a JSON object, or "" when it is absent. */
field(src: str, key: str) -> str {
    marker = "\"" ++ key ++ "\":"
    at = src.index_of(marker)

    if at < 0 {
        ""
    } else {
        value_from(src, at + marker.length())
    }
}

/** `field`, with the quotes taken off and the escapes undone: what a string
 * value actually says.
 */
field_str(src: str, key: str) -> str =>
    bare(field(src, key))

/** `field`, read as an integer, with `fallback` when the key is absent. */
field_int(src: str, key: str, fallback: int) -> int {
    raw = field(src, key)

    if raw == "" {
        fallback
    } else {
        int(raw)
    }
}

value_from(src: str, at: int) -> str {
    rest = src.slice(at, src.length()).trim()

    if rest.starts_with("[") || rest.starts_with("\{") {
        rest.slice(0, bracket_end(rest, 0, 0))
    } else if rest.starts_with("\"") {
        rest.slice(0, quoted_end(rest, 1))
    } else {
        rest.slice(0, scalar_end(rest, 0))
    }
}

bracket_end(s: str, i: int, depth: int) -> int {
    if i >= s.length() {
        i
    } else if s.at(i) == "\"" {
        bracket_end(s, quoted_end(s, i + 1), depth)
    } else if s.at(i) == "[" || s.at(i) == "\{" {
        bracket_end(s, i + 1, depth + 1)
    } else if s.at(i) != "]" && s.at(i) != "\}" {
        bracket_end(s, i + 1, depth)
    } else if depth <= 1 {
        i + 1
    } else {
        bracket_end(s, i + 1, depth - 1)
    }
}

quoted_end(s: str, i: int) -> int {
    if i >= s.length() {
        i
    } else if s.at(i) == "\\" {
        quoted_end(s, i + 2)
    } else if s.at(i) == "\"" {
        i + 1
    } else {
        quoted_end(s, i + 1)
    }
}

scalar_end(s: str, i: int) -> int {
    if i >= s.length() {
        i
    } else if s.at(i) == "," || s.at(i) == "]" || s.at(i) == "\}" {
        i
    } else {
        scalar_end(s, i + 1)
    }
}

/** The elements of a JSON array, each as raw text, strings unquoted. */
elements(src: str) -> str[] {
    body = src.trim()

    if !body.starts_with("[") {
        []
    } else {
        split_at_depth(body.slice(1, body.length() - 1), 0, 0, "", [])
    }
}

split_at_depth(s: str, i: int, depth: int, cur: str, acc: str[]) -> str[] {
    if i >= s.length() {
        cur.trim() == "" ? acc : acc.push(bare(cur))
    } else if s.at(i) == "\"" {
        stop = quoted_end(s, i + 1)
        split_at_depth(s, stop, depth, cur ++ s.slice(i, stop), acc)
    } else if s.at(i) == "," && depth == 0 {
        split_at_depth(s, i + 1, depth, "", acc.push(bare(cur)))
    } else {
        split_at_depth(s, i + 1, depth + step(s.at(i)), cur ++ s.at(i), acc)
    }
}

step(c: str) -> int {
    if c == "[" || c == "\{" {
        1
    } else if c == "]" || c == "\}" {
        -1
    } else {
        0
    }
}

bare(s: str) -> str {
    t = s.trim()

    if t.length() >= 2 && t.starts_with("\"") && t.ends_with("\"") {
        decode_str(t.slice(1, t.length() - 1))
    } else {
        t
    }
}

/** Undo `encode_str`. */
decode_str(s: str) -> str =>
    unescaped(s, 0, "")

unescaped(s: str, i: int, acc: str) -> str {
    if i >= s.length() {
        acc
    } else if s.at(i) != "\\" || i + 1 >= s.length() {
        unescaped(s, i + 1, acc ++ s.at(i))
    } else {
        unescaped(s, i + 2, acc ++ unescape_one(s.at(i + 1)))
    }
}

unescape_one(c: str) -> str {
    if c == "n" {
        "\n"
    } else if c == "r" {
        "\r"
    } else if c == "t" {
        "\t"
    } else if c == "\"" || c == "\\" {
        c
    } else {
        "\\" ++ c
    }
}

/** Write a run to `path`. */
save(path: str, rs: Result[]) -> bool =>
    write_file(path, to_json(rs) ++ "\n")

/** Read a run from `path`, or an empty list when there is nothing there. */
load(path: str) -> Result[] {
    if !file_exists(path) {
        []
    } else {
        from_json(read_file(path))
    }
}

/** The index of the result named `name`, or -1. */
find(rs: Result[], name: str) -> int =>
    scan_for(rs, name, 0)

scan_for(rs: Result[], name: str, i: int) -> int {
    if i >= rs.length() {
        -1
    } else if rs[i].name == name {
        i
    } else {
        scan_for(rs, name, i + 1)
    }
}
