import { min_of, median, mean, spread, relative_spread } from bench/stat

/// How hard to measure.
Options = {
    samples: int,
    min_ms: int,
    warmups: int,
    max_iters: int,
}

/// Five samples of at least 50 ms each, after one discarded warm-up.
defaults() -> Options =>
    Options { samples = 5, min_ms = 50, warmups = 1, max_iters = 100000000 }

/// Shorter and noisier: for a demo, a smoke test, or a first look at a candidate you are still writing.
quick() -> Options =>
    Options { samples = 3, min_ms = 15, warmups = 1, max_iters = 100000000 }

/// Longer and steadier: eleven samples of 200 ms, three warm-ups.
careful() -> Options =>
    Options { samples = 11, min_ms = 200, warmups = 3, max_iters = 100000000 }

/// What one candidate measured.
Result = {
    name: str,
    size: int,
    iters: int,
    samples: int[],
    checksum: int,
}

Tick = { ms: int, checksum: int }

/// Time `candidate` at workload `size` and keep the samples.
measure(name: str, size: int, candidate, opts: Options) -> Result {
    iters = calibrate(candidate, size, opts)
    warm(candidate, size, iters, opts.warmups)
    collect(name, size, candidate, iters, opts.samples)
}

/// `measure` with `defaults()`.
time_it(name: str, size: int, candidate) -> Result =>
    measure(name, size, candidate, defaults())

spin(candidate, size: int, iters: int) -> int {
    acc = 0
    i = 0
    while i < iters {
        acc = acc + candidate(size)
        i = i + 1
    }
    acc
}

tick(candidate, size: int, iters: int) -> Tick {
    started = now_ms()
    got = spin(candidate, size, iters)
    Tick { ms = now_ms() - started, checksum = got }
}

calibrate(candidate, size: int, opts: Options) -> int {
    iters = 1
    while true {
        got = tick(candidate, size, iters)
        if got.ms >= opts.min_ms || iters >= opts.max_iters {
            break
        }
        iters = grown(iters, got.ms, opts.min_ms, opts.max_iters)
    }
    iters
}

grown(iters: int, ms: int, want: int, cap: int) -> int {
    guess = if ms <= 0 {
        iters * 8
    } else {
        iters * (want / ms + 2)
    }
    stepped = guess > iters ? guess : iters + 1

    stepped > cap ? cap : stepped
}

warm(candidate, size: int, iters: int, rounds: int) -> int {
    acc = 0
    i = 0
    while i < rounds {
        acc = acc + tick(candidate, size, iters).checksum
        i = i + 1
    }
    acc
}

collect(name: str, size: int, candidate, iters: int, rounds: int) -> Result {
    taken: int[] = []
    i = 0
    while i < rounds {
        taken = taken.push(tick(candidate, size, iters).ms)
        i = i + 1
    }

    Result { name = name, size = size, iters = iters, samples = taken,
             checksum = candidate(size) }
}

/// Milliseconds spent inside the candidate across every kept sample.
total_ms(r: Result) -> int {
    if r.samples.length() == 0 {
        0
    } else {
        r.samples.sum()
    }
}

/// Candidate calls across every kept sample.
total_ops(r: Result) -> int =>
    r.iters * r.samples.length()

/// Nanoseconds per candidate call.
ns_per_op(r: Result) -> float {
    ops = total_ops(r)

    if ops <= 0 {
        0.0
    } else {
        float(total_ms(r)) * 1000000.0 / float(ops)
    }
}

/// Candidate calls per second.
ops_per_sec(r: Result) -> float {
    ms = total_ms(r)

    if ms <= 0 {
        0.0
    } else {
        float(total_ops(r)) * 1000.0 / float(ms)
    }
}

/// Nanoseconds per unit of workload: `ns_per_op` divided by `size`.
ns_per_item(r: Result) -> float {
    if r.size <= 0 {
        0.0
    } else {
        ns_per_op(r) / float(r.size)
    }
}

/// The fastest sample, in milliseconds.
fastest_ms(r: Result) -> int => min_of(r.samples)

/// The middle sample, in milliseconds.
median_ms(r: Result) -> float => median(r.samples)

/// The mean sample, in milliseconds.
mean_ms(r: Result) -> float => mean(r.samples)

/// How far the samples scatter, in milliseconds.
spread_ms(r: Result) -> float => spread(r.samples)

/// Did the clock resolve this at all?
resolved(r: Result) -> bool =>
    total_ms(r) > 0

/// Are these samples steady enough to compare against another run?
steady(r: Result) -> bool =>
    resolved(r) && relative_spread(r.samples) < 0.1
