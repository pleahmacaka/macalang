/** The smallest sample. */
min_of(xs: int[]) -> int {
    if xs.length() == 0 {
        0
    } else {
        xs.min()
    }
}

/** The largest sample, 0 for an empty list. */
max_of(xs: int[]) -> int {
    if xs.length() == 0 {
        0
    } else {
        xs.max()
    }
}

/** The middle sample, averaging the two middles when there is an even number of
 * them.
 */
median(xs: int[]) -> float {
    n = xs.length()

    if n == 0 {
        0.0
    } else if n % 2 == 1 {
        float(xs.sort().get(n / 2))
    } else {
        sorted = xs.sort()
        float(sorted.get(n / 2 - 1) + sorted.get(n / 2)) / 2.0
    }
}

/** The arithmetic mean. */
mean(xs: int[]) -> float {
    if xs.length() == 0 {
        0.0
    } else {
        float(xs.sum()) / float(xs.length())
    }
}

/** Population standard deviation, in the same unit as the samples. */
spread(xs: int[]) -> float {
    n = xs.length()

    if n == 0 {
        0.0
    } else {
        root(squared_error(xs, mean(xs), 0, 0.0) / float(n))
    }
}

root(v: float) -> float {
    if v <= 0.0 {
        0.0
    } else {
        descend(v, v > 1.0 ? v : 1.0)
    }
}

descend(v: float, guess: float) -> float {
    at = guess
    step = 0

    while step < 4000 {
        closer = (at + v / at) / 2.0
        if closer >= at {
            break
        }
        at = closer
        step = step + 1
    }
    at
}

squared_error(xs: int[], centre: float, i: int, acc: float) -> float {
    if i >= xs.length() {
        acc
    } else {
        off = float(xs.get(i)) - centre
        squared_error(xs, centre, i + 1, acc + off * off)
    }
}

/** The spread as a fraction of the mean. */
relative_spread(xs: int[]) -> float {
    centre = mean(xs)

    if centre <= 0.0 {
        0.0
    } else {
        spread(xs) / centre
    }
}

/** The sample at `frac` of the way through the sorted list: `percentile(xs,
 * 0.95)` is the slow tail.
 */
percentile(xs: int[], frac: float) -> int {
    n = xs.length()

    if n == 0 {
        0
    } else {
        at = int(frac * float(n - 1) + 0.5)
        xs.sort().get(clamp(at, 0, n - 1))
    }
}

clamp(v: int, low: int, high: int) -> int {
    if v < low {
        low
    } else if v > high {
        high
    } else {
        v
    }
}
