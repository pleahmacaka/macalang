import { ascending, sentence } from bench/cases/data

/// A point, for the record cases.
Pt = { x: int, y: int }

/// Integer add, multiply, divide and remainder, `n` times.
int_arith(n: int) -> int {
    acc = 0
    i = 1
    while i <= n {
        acc = acc + i * 3 + i % 7 - i / 2
        i = i + 1
    }
    acc
}

/// Float conversion, division and addition, `n` times, reported as thousandths so the checksum is an integer without being 0.
float_arith(n: int) -> int {
    acc = 0.0
    i = 1
    while i <= n {
        acc = acc + 1.0 / float(i)
        i = i + 1
    }
    int(acc * 1000.0)
}

/// Append a two-byte literal `n` times; returns the length built.
str_concat(n: int) -> int {
    out = ""
    i = 0
    while i < n {
        out = out ++ "ab"
        i = i + 1
    }
    out.length()
}

/// The same, through string interpolation: a number formatted and spliced in `n` times.
str_interp(n: int) -> int {
    out = ""
    i = 0
    while i < n {
        out = out ++ "{i}|"
        i = i + 1
    }
    out.length()
}

/// Walk `n` bytes classifying each one; returns letters and digits packed into one number.
str_scan(n: int) -> int {
    text = sentence(n)
    letters = 0
    digits = 0
    i = 0
    while i < text.length() {
        c = text.at(i)
        if c.is_alpha() {
            letters = letters + 1
        } else if c.is_ascii_digit() {
            digits = digits + 1
        }
        i = i + 1
    }
    letters * 1000 + digits
}

/// Grow a list one element at a time; returns the sum of what went in.
list_push(n: int) -> int {
    xs: int[] = []
    i = 0
    while i < n {
        xs = xs.push(i)
        i = i + 1
    }
    xs.sum()
}

/// Read `n` elements by subscript.
list_index(n: int) -> int {
    xs = ascending(n)
    acc = 0
    i = 0
    while i < n {
        acc = acc + xs[i]
        i = i + 1
    }
    acc
}

/// Read the same `n` elements with `for … in`.
list_iterate(n: int) -> int {
    acc = 0
    for x in ascending(n) {
        acc = acc + x
    }
    acc
}

/// Insert `n` string keys into a map; returns how many landed.
map_set(n: int) -> int {
    m: Map str int = map()
    i = 0
    while i < n {
        m = m.set("k{i}", i)
        i = i + 1
    }
    m.length()
}

/// Insert `n` keys and then read every one back; returns the sum of the values that came out.
map_get(n: int) -> int {
    m: Map str int = map()
    i = 0
    while i < n {
        m = m.set("k{i}", i)
        i = i + 1
    }

    acc = 0
    j = 0
    while j < n {
        acc = acc + m.get("k{j}", -1)
        j = j + 1
    }
    acc
}

/// Construct `n` records, reading both fields of each.
record_build(n: int) -> int {
    acc = 0
    i = 0
    while i < n {
        p = Pt { x = i, y = i * 2 }
        acc = acc + p.x + p.y
        i = i + 1
    }
    acc
}

/// Read both fields of one record `n` times, construction held out, so the gap against `record_build` is what building one costs.
record_field(n: int) -> int {
    p = Pt { x = 3, y = 4 }
    acc = 0
    i = 0
    while i < n {
        acc = acc + p.x + p.y
        i = i + 1
    }
    acc
}
