import bench/cases/prim
import bench/cases/algo
import bench/cases/inter
import bench/cases/adv

/** The primitives: what everything else is built out of. */
prim_names() -> str[] =>
    ["int arithmetic", "float arithmetic", "string concat",
     "string interpolate", "string scan", "list push", "list index",
     "list iterate", "map set", "map get", "record build", "record field"]

/** The algorithms you write in the first week. */
algo_names() -> str[] =>
    ["linear search", "binary search", "bubble sort", "insertion sort",
     "selection sort", "reverse", "sum/min/max", "fib recursive",
     "fib iterative", "factorial", "gcd", "prime count"]

/** The ones with a data structure in them. */
inter_names() -> str[] =>
    ["merge sort", "quick sort", "heap sort", "heap ops", "sieve",
     "matrix multiply", "substring search", "run-length", "base convert",
     "balanced brackets", "ring queue", "bst"]

/** The ones with a real idea in them. */
adv_names() -> str[] =>
    ["kmp search", "edit distance", "lcs", "knapsack", "n-queens",
     "union-find", "dijkstra", "topological sort", "lru cache",
     "json tokenize"]

/** Every case, in the order the groups are meant to be read. */
case_names() -> str[] =>
    prim_names() + algo_names() + inter_names() + adv_names()

/** Which group `name` belongs to, or "" for a name that is not a case. */
group_of(name: str) -> str {
    if prim_names().contains(name) {
        "primitives"
    } else if algo_names().contains(name) {
        "elementary"
    } else if inter_names().contains(name) {
        "intermediate"
    } else if adv_names().contains(name) {
        "advanced"
    } else {
        ""
    }
}

/** The names in one group, in order. */
names_in(group: str) -> str[] {
    if group == "primitives" {
        prim_names()
    } else if group == "elementary" {
        algo_names()
    } else if group == "intermediate" {
        inter_names()
    } else if group == "advanced" {
        adv_names()
    } else {
        []
    }
}

/** The four groups, in reading order. */
groups() -> str[] =>
    ["primitives", "elementary", "intermediate", "advanced"]

table_cases() -> str[] =>
    ["edit distance", "lcs"]

byte_cases() -> str[] =>
    ["run-length", "base convert", "json tokenize"]

quadratic_cases() -> str[] =>
    ["list push", "bubble sort", "insertion sort", "selection sort"]

steep_cases() -> str[] =>
    ["knapsack", "dijkstra", "topological sort"]

cheap_cases() -> str[] =>
    ["record build", "record field", "list index", "list iterate", "reverse",
     "sum/min/max", "balanced brackets", "ring queue", "string scan",
     "factorial", "gcd"]

/** The workload size a case runs at when nobody says otherwise. */
default_size(name: str) -> int {
    if name == "fib recursive" {
        22
    } else if name == "fib iterative" {
        90
    } else if name == "n-queens" {
        7
    } else if name == "matrix multiply" {
        32
    } else if name == "heap ops" {
        150
    } else if table_cases().contains(name) {
        60
    } else if steep_cases().contains(name) {
        200
    } else if byte_cases().contains(name) {
        200
    } else if quadratic_cases().contains(name) {
        400
    } else if cheap_cases().contains(name) {
        2000
    } else {
        1000
    }
}

/** What the size means for this case, for a report that has to say so. */
size_unit(name: str) -> str {
    if name == "fib recursive" || name == "fib iterative" {
        "index"
    } else if name == "n-queens" || name == "matrix multiply" {
        "side"
    } else if group_of(name) == "" {
        ""
    } else {
        "elements"
    }
}

/** Run the case called `name` at workload size `n`, and return its checksum. */
run_case(name: str, n: int) -> int {
    if prim_names().contains(name) {
        run_prim(name, n)
    } else if algo_names().contains(name) {
        run_algo(name, n)
    } else if inter_names().contains(name) {
        run_inter(name, n)
    } else if adv_names().contains(name) {
        run_adv(name, n)
    } else {
        0
    }
}

run_prim(name: str, n: int) -> int {
    if name == "int arithmetic" {
        int_arith(n)
    } else if name == "float arithmetic" {
        float_arith(n)
    } else if name == "string concat" {
        str_concat(n)
    } else if name == "string interpolate" {
        str_interp(n)
    } else if name == "string scan" {
        str_scan(n)
    } else if name == "list push" {
        list_push(n)
    } else if name == "list index" {
        list_index(n)
    } else if name == "list iterate" {
        list_iterate(n)
    } else if name == "map set" {
        map_set(n)
    } else if name == "map get" {
        map_get(n)
    } else if name == "record build" {
        record_build(n)
    } else {
        record_field(n)
    }
}

run_algo(name: str, n: int) -> int {
    if name == "linear search" {
        linear_search_case(n)
    } else if name == "binary search" {
        binary_search_case(n)
    } else if name == "bubble sort" {
        bubble_sort_case(n)
    } else if name == "insertion sort" {
        insertion_sort_case(n)
    } else if name == "selection sort" {
        selection_sort_case(n)
    } else if name == "reverse" {
        reversed_case(n)
    } else if name == "sum/min/max" {
        sum_min_max_case(n)
    } else if name == "fib recursive" {
        fib_recursive_case(n)
    } else if name == "fib iterative" {
        fib_iterative_case(n)
    } else if name == "factorial" {
        factorial_case(n)
    } else if name == "gcd" {
        gcd_case(n)
    } else {
        prime_count_case(n)
    }
}

run_inter(name: str, n: int) -> int {
    if name == "merge sort" {
        merge_sort_case(n)
    } else if name == "quick sort" {
        quick_sort_case(n)
    } else if name == "heap sort" {
        heap_sort_case(n)
    } else if name == "heap ops" {
        heap_ops_case(n)
    } else if name == "sieve" {
        sieve_case(n)
    } else if name == "matrix multiply" {
        matrix_multiply_case(n)
    } else if name == "substring search" {
        find_substring_case(n)
    } else if name == "run-length" {
        run_length_case(n)
    } else if name == "base convert" {
        base_convert_case(n)
    } else if name == "balanced brackets" {
        balanced_case(n)
    } else if name == "ring queue" {
        queue_case(n)
    } else {
        bst_case(n)
    }
}

run_adv(name: str, n: int) -> int {
    if name == "kmp search" {
        kmp_search_case(n)
    } else if name == "edit distance" {
        edit_distance_case(n)
    } else if name == "lcs" {
        lcs_case(n)
    } else if name == "knapsack" {
        knapsack_case(n)
    } else if name == "n-queens" {
        n_queens_case(n)
    } else if name == "union-find" {
        union_find_case(n)
    } else if name == "dijkstra" {
        dijkstra_case(n)
    } else if name == "topological sort" {
        topo_sort_case(n)
    } else if name == "lru cache" {
        lru_case(n)
    } else {
        json_tokenize_case(n)
    }
}
