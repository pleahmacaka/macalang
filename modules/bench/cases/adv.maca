import { ascending, zeros, repeated } from bench/cases/data
import { sentence, checksum } from bench/cases/data

/** The distance a Dijkstra run reports for a node it could not reach. */
Unreachable = 1000000000

/** For each prefix of `needle`, the length of its longest proper prefix that is
 * also a suffix.
 */
kmp_table(needle: str) -> int[] {
    table = zeros(needle.length())
    len = 0
    i = 1

    while i < needle.length() {
        if needle.at(i) == needle.at(len) {
            len = len + 1
            table[i] = len
            i = i + 1
        } else if len > 0 {
            len = table[len - 1]
        } else {
            table[i] = 0
            i = i + 1
        }
    }
    table
}

/** The index of `needle` in `hay`, or -1, in `n + m` steps. */
kmp_search(hay: str, needle: str) -> int {
    if needle.length() == 0 {
        0
    } else {
        table = kmp_table(needle)
        found = -1
        matched = 0
        i = 0

        while i < hay.length() {
            if hay.at(i) == needle.at(matched) {
                matched = matched + 1
                i = i + 1
                if matched == needle.length() {
                    found = i - matched
                    i = hay.length()
                }
            } else if matched > 0 {
                matched = table[matched - 1]
            } else {
                i = i + 1
            }
        }
        found
    }
}

/** The same near-miss search as `find_substring_case`, so the two numbers are
 * directly comparable and the comparison is the point.
 */
kmp_search_case(n: int) -> int =>
    kmp_search(sentence(n), "the quick brown cat")

/** The fewest single-character insertions, deletions and substitutions that
 * turn `a` into `b`.
 */
edit_distance(a: str, b: str) -> int {
    previous = ascending(b.length() + 1)
    current = zeros(b.length() + 1)
    i = 1

    while i <= a.length() {
        current[0] = i
        j = 1
        while j <= b.length() {
            cost = a.at(i - 1) == b.at(j - 1) ? 0 : 1
            current[j] = least_of(current[j - 1] + 1, previous[j] + 1,
                                  previous[j - 1] + cost)
            j = j + 1
        }
        previous = current.slice(0, current.length())
        i = i + 1
    }
    previous[b.length()]
}

least_of(a: int, b: int, c: int) -> int {
    if a <= b && a <= c {
        a
    } else if b <= c {
        b
    } else {
        c
    }
}

edit_distance_case(n: int) -> int =>
    edit_distance(sentence(n), sentence(n).upper())

/** The length of the longest sequence of characters appearing, in order but not
 * necessarily together, in both `a` and `b`.
 */
lcs_length(a: str, b: str) -> int {
    previous = zeros(b.length() + 1)
    current = zeros(b.length() + 1)
    i = 1

    while i <= a.length() {
        current[0] = 0
        j = 1
        while j <= b.length() {
            if a.at(i - 1) == b.at(j - 1) {
                current[j] = previous[j - 1] + 1
            } else {
                current[j] = max(previous[j], current[j - 1])
            }
            j = j + 1
        }
        previous = current.slice(0, current.length())
        i = i + 1
    }
    previous[b.length()]
}

lcs_case(n: int) -> int =>
    lcs_length(sentence(n), sentence(n).replace("o", "0"))

/** The best total value that fits in `capacity`, taking each item once or not
 * at all.
 */
knapsack(weights: int[], values: int[], capacity: int) -> int {
    best = zeros(capacity + 1)
    item = 0

    while item < weights.length() {
        w = weights[item]
        c = capacity
        while c >= w {
            best[c] = max(best[c], best[c - w] + values[item])
            c = c - 1
        }
        item = item + 1
    }
    best[capacity]
}

/** `n` items in a knapsack of `2n`, so the table is `n × 2n` and the size
 * parameter moves the work quadratically.
 */
knapsack_case(n: int) -> int {
    weights = zeros(n)
    values = zeros(n)
    i = 0
    while i < n {
        weights[i] = i % 7 + 1
        values[i] = (i * 13) % 29 + 1
        i = i + 1
    }
    knapsack(weights, values, 2 * n)
}

/** How many ways `n` queens fit on an `n × n` board with none attacking
 * another.
 */
n_queens(n: int) -> int {
    if n <= 0 {
        0
    } else {
        columns = repeated(n, 0)
        down = repeated(2 * n, 0)
        up = repeated(2 * n, 0)
        place_queen(n, 0, columns, down, up)
    }
}

place_queen(n: int, row: int, columns: int[], down: int[], up: int[]) -> int {
    if row == n {
        1
    } else {
        found = 0
        col = 0
        while col < n {
            if columns[col] == 0 && down[row - col + n] == 0
                    && up[row + col] == 0 {
                columns[col] = 1
                down[row - col + n] = 1
                up[row + col] = 1
                found = found + place_queen(n, row + 1, columns, down, up)
                columns[col] = 0
                down[row - col + n] = 0
                up[row + col] = 0
            }
            col = col + 1
        }
        found
    }
}

/** `n` is the board side. */
n_queens_case(n: int) -> int =>
    n_queens(n)

/** Disjoint sets over `0 … n-1`. */
Uf = {
    parent: int[],
    size: int[],
}

uf_of(n: int) -> Uf =>
    Uf { parent = ascending(n), size = repeated(n, 1) }

/** The representative of `x`'s set, flattening the path on the way. */
uf_root(uf: Uf, x: int) -> int {
    at = x
    while uf.parent[at] != at {
        uf.parent[at] = uf.parent[uf.parent[at]]
        at = uf.parent[at]
    }
    at
}

/** Merge the sets holding `a` and `b`. */
uf_union(uf: Uf, a: int, b: int) -> bool {
    ra = uf_root(uf, a)
    rb = uf_root(uf, b)

    if ra == rb {
        false
    } else {
        big = uf.size[ra] >= uf.size[rb] ? ra : rb
        small = big == ra ? rb : ra
        uf.parent[small] = big
        uf.size[big] = uf.size[big] + uf.size[small]
        true
    }
}

/** How many separate sets are left. */
uf_groups(uf: Uf) -> int {
    found = 0
    i = 0
    while i < uf.parent.length() {
        if uf_root(uf, i) == i {
            found = found + 1
        }
        i = i + 1
    }
    found
}

/** Join `n` elements in a pattern that builds long chains before compressing
 * them, then count what is left.
 */
union_find_case(n: int) -> int {
    uf = uf_of(n)
    i = 0
    while i < n {
        uf_union(uf, i, (i * 2) % n)
        i = i + 1
    }
    uf_groups(uf)
}

/** Shortest distances from `source`, over an `n × n` weight matrix where -1
 * means no edge.
 */
dijkstra(weight: int[], n: int, source: int) -> int[] {
    if n <= 0 {
        []
    } else {
        walk_graph(weight, n, source)
    }
}

walk_graph(weight: int[], n: int, source: int) -> int[] {
    distance = repeated(n, Unreachable)
    settled = repeated(n, 0)
    distance[source] = 0
    round = 0

    while round < n {
        at = nearest(distance, settled, n)
        if at < 0 {
            round = n
        } else {
            settled[at] = 1
            relax_from(weight, distance, n, at)
            round = round + 1
        }
    }
    distance
}

nearest(distance: int[], settled: int[], n: int) -> int {
    best = -1
    i = 0
    while i < n {
        if settled[i] == 0 && distance[i] < Unreachable {
            if best < 0 || distance[i] < distance[best] {
                best = i
            }
        }
        i = i + 1
    }
    best
}

relax_from(weight: int[], distance: int[], n: int, at: int) {
    j = 0
    while j < n {
        w = weight[at * n + j]
        if w >= 0 && distance[at] + w < distance[j] {
            distance[j] = distance[at] + w
        }
        j = j + 1
    }
}

/** A ring of `n` nodes with a few chords across it, solved from node 0. */
dijkstra_case(n: int) -> int {
    weight = repeated(n * n, -1)
    i = 0
    while i < n {
        weight[i * n + (i + 1) % n] = i % 9 + 1
        weight[i * n + (i + 7) % n] = i % 5 + 3
        i = i + 1
    }
    total = 0
    for d in dijkstra(weight, n, 0) {
        total = total + d
    }
    total
}

/** An order in which `n` nodes can be visited with every edge pointing
 * forwards, or an empty list when the edges contain a cycle.
 */
topo_sort(edges: int[], n: int) -> int[] {
    incoming = repeated(n, 0)
    e = 0
    while e + 1 < edges.length() {
        incoming[edges[e + 1]] = incoming[edges[e + 1]] + 1
        e = e + 2
    }

    ready = zeros(n)
    waiting = 0
    i = 0
    while i < n {
        if incoming[i] == 0 {
            ready[waiting] = i
            waiting = waiting + 1
        }
        i = i + 1
    }

    out = zeros(n)
    written = 0
    taken = 0
    while taken < waiting {
        node = ready[taken]
        taken = taken + 1
        out[written] = node
        written = written + 1

        at = 0
        while at + 1 < edges.length() {
            if edges[at] == node {
                target = edges[at + 1]
                incoming[target] = incoming[target] - 1
                if incoming[target] == 0 {
                    ready[waiting] = target
                    waiting = waiting + 1
                }
            }
            at = at + 2
        }
    }

    written == n ? out : []
}

/** A chain, `0 → 1 → … → n-1`. */
topo_sort_case(n: int) -> int {
    edges = zeros(2 * (n - 1 > 0 ? n - 1 : 0))
    at = 0
    i = 0
    while i + 1 < n {
        edges[at] = i
        edges[at + 1] = i + 1
        at = at + 2
        i = i + 1
    }
    checksum(topo_sort(edges, n))
}

/** How many of `keys` were already cached, with room for `capacity` of them and
 * the least recently used one thrown out.
 */
lru_hits(keys: int[], capacity: int) -> int {
    if capacity <= 0 {
        0
    } else {
        recent = zeros(capacity)
        held = 0
        hits = 0

        for k in keys {
            at = position_of(recent, held, k)
            if at >= 0 {
                hits = hits + 1
                promote(recent, at)
            } else {
                if held < capacity {
                    held = held + 1
                }
                recent[held - 1] = k
                promote(recent, held - 1)
            }
        }
        hits
    }
}

position_of(recent: int[], held: int, k: int) -> int {
    found = -1
    i = 0
    while i < held {
        if recent[i] == k {
            found = i
            break
        }
        i = i + 1
    }
    found
}

promote(recent: int[], from: int) {
    held = recent[from]
    at = from
    while at > 0 {
        recent[at] = recent[at - 1]
        at = at - 1
    }
    recent[0] = held
}

/** `n` accesses in a cache of 16, keyed by the squares modulo 100. */
lru_case(n: int) -> int {
    keys = zeros(n)
    i = 0
    while i < n {
        keys[i] = (i * i) % 100
        i = i + 1
    }
    lru_hits(keys, 16)
}

/** JSON split into its tokens: punctuation one character each, strings whole
 * and still quoted, numbers and bare words as they are, whitespace dropped.
 */
json_tokens(src: str) -> str[] {
    out: str[] = []
    i = 0

    while i < src.length() {
        stop = token_end(src, i)
        if stop > i {
            out = out.push(src.slice(i, stop))
        }
        i = stop > i ? stop : i + 1
    }
    out
}

/** How many tokens `src` has, without building them. */
json_token_count(src: str) -> int {
    found = 0
    i = 0

    while i < src.length() {
        stop = token_end(src, i)
        if stop > i {
            found = found + 1
        }
        i = stop > i ? stop : i + 1
    }
    found
}

token_end(src: str, i: int) -> int {
    c = src.at(i)

    if c.is_whitespace() {
        i
    } else if is_punctuation(c) {
        i + 1
    } else if c == "\"" {
        string_end(src, i + 1)
    } else {
        word_end(src, i)
    }
}

is_punctuation(c: str) -> bool =>
    c == "\{" || c == "\}" || c == "[" || c == "]" || c == ":" || c == ","

string_end(src: str, from: int) -> int {
    i = from
    while i < src.length() {
        if src.at(i) == "\\" {
            i = i + 2
        } else if src.at(i) == "\"" {
            i = i + 1
            break
        } else {
            i = i + 1
        }
    }
    i
}

word_end(src: str, from: int) -> int {
    i = from
    while i < src.length() && !src.at(i).is_whitespace()
            && !is_punctuation(src.at(i)) && src.at(i) != "\"" {
        i = i + 1
    }
    i
}

/** A JSON array of `n` objects, for the tokenizer to chew on. */
json_sample(n: int) -> str {
    if n <= 0 {
        "[]"
    } else {
        unit = "\{\"id\":1,\"name\":\"a row\",\"ok\":true\},"
        body = unit.repeat(n)
        "[" ++ body.slice(0, body.length() - 1) ++ "]"
    }
}

/** `n` is the number of objects in the document, not its length in bytes. */
json_tokenize_case(n: int) -> int =>
    json_token_count(json_sample(n))
