import { table_aligned, rule } from cli/show
import { grey } from cli/style
import { Result, fastest_ms, median_ms, mean_ms } from bench/time
import { ns_per_op, ops_per_sec, total_ops, total_ms, resolved } from bench/time

/// The column headings, in the order `row_of` fills them.
result_columns() -> str[] =>
    ["case", "size", "iters", "min", "med", "mean", "ns/op", "ops/sec"]

/// One result as table cells.
row_of(r: Result) -> str[] =>
    [r.name, grouped(r.size), grouped(r.iters), grouped(fastest_ms(r)),
     "{median_ms(r):.1}", "{mean_ms(r):.1}", "{ns_per_op(r):.1}",
     grouped(int(ops_per_sec(r)))]

/// Every result as one aligned table.
table_of(rs: Result[]) -> str =>
    table_aligned(result_columns(), rows_of(rs, 0, []))

rows_of(rs: Result[], i: int, acc: str[][]) -> str[][] {
    if i >= rs.length() {
        acc
    } else {
        rows_of(rs, i + 1, acc.push(row_of(rs.get(i))))
    }
}

/// One result on one line, for printing as the run goes rather than waiting for the whole table.
line_of(r: Result) -> str {
    head = "{r.name:<24} {r.size:>9} {ns_per_op(r):>12.1} ns/op"

    if resolved(r) {
        head
    } else {
        head ++ "  " ++ grey("(under the clock)")
    }
}

/// A section rule with a title, for putting a group of results under a name.
heading(title: str) -> str => rule(title)

/// The one-paragraph footer a table needs to be read correctly.
footnote(rs: Result[]) -> str {
    calls = summed_ops(rs, 0, 0)
    ms = summed_ms(rs, 0, 0)
    shaky = unresolved_count(rs, 0, 0)
    body = "{counted(rs.length(), "case")}, {grouped(calls)} calls,"
        ++ " {grouped(ms)} ms measured. Times are wall-clock; ns/op is the"
        ++ " total divided by the call count."

    if shaky == 0 {
        grey(body)
    } else {
        grey(body ++ " {counted(shaky, "case")} stayed under the clock.")
    }
}

counted(n: int, thing: str) -> str {
    if n == 1 {
        "1 {thing}"
    } else {
        "{n} {thing}s"
    }
}

summed_ops(rs: Result[], i: int, acc: int) -> int {
    if i >= rs.length() {
        acc
    } else {
        summed_ops(rs, i + 1, acc + total_ops(rs.get(i)))
    }
}

summed_ms(rs: Result[], i: int, acc: int) -> int {
    if i >= rs.length() {
        acc
    } else {
        summed_ms(rs, i + 1, acc + total_ms(rs.get(i)))
    }
}

unresolved_count(rs: Result[], i: int, acc: int) -> int {
    if i >= rs.length() {
        acc
    } else if resolved(rs.get(i)) {
        unresolved_count(rs, i + 1, acc)
    } else {
        unresolved_count(rs, i + 1, acc + 1)
    }
}

/// `1234567` as `1,234,567`.
grouped(n: int) -> str {
    if n < 0 {
        "-" ++ grouped(0 - n)
    } else {
        digits = str(n)
        insert_commas(digits, 0, "")
    }
}

insert_commas(digits: str, i: int, acc: str) -> str {
    if i >= digits.length() {
        acc
    } else {
        left = digits.length() - i
        sep = i > 0 && left % 3 == 0 ? "," : ""
        insert_commas(digits, i + 1, acc ++ sep ++ digits.at(i))
    }
}
