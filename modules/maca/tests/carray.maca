import maca/lexer
import maca/parser
import maca/check
import maca/emit_c

c_for(src: str) -> str =>
    emit_module(annotated(parse_module(lex(src), 0, [])))

Rec = "R = {{ n: int }} "

Sum = "C = A | B "

Higher = "p(c: str) -> bool => true "
    ++ "run(xs: str[], f) -> bool => f(xs.get(0)) "
    ++ "use(xs: str[]) -> bool => run(xs, p)"

test_a_record_element_is_read_back_as_a_record() {
    out = c_for(Rec ++ "f(xs: R[]) -> int => xs.get(0).n")

    assert(out.index_of("(*(R*)xs.data[0]).n") >= 0,
           "the cell is a boxed R, so the field reads through the pointer")
    assert(out.index_of("((int)xs.data[0]).n") < 0,
           "and never as an int, which is not a structure or union")
}

test_a_record_element_is_boxed_into_the_cell() {
    out = c_for(Rec ++ "f() -> R[] => [R {{ n = 1 }}]")

    assert(out.index_of("maca_box(sizeof(R), (R[]){{ (R){{ .n = 1 }} }})") >= 0,
           "a record is copied to the heap and the cell holds its address")
    assert(out.index_of("(long)((R){{ .n = 1 }})") < 0,
           "a struct is not an arithmetic type, so it cannot be cast to long")
}

test_the_preamble_carries_the_box_helper() {
    assert(c_for("f() -> int => 1").index_of("maca_box(int n,") >= 0,
           "every emitted unit can box, because any list may hold a record")
}

test_a_push_boxes_the_element_it_appends() {
    out = c_for(Rec ++ "g(xs: R[]) -> R[] => xs.push(R {{ n = 2 }})")

    assert(out.index_of("maca_listv(1, maca_box(sizeof(R),") >= 0,
           "the appended cell is boxed like any other")
    assert(out.index_of("(long)(R)") < 0,
           "the old lowering cast the struct itself, and lost its parentheses")
}

test_the_element_type_comes_from_the_receiver_not_the_index() {
    out = c_for(Rec ++ "h(xs: R[]) -> R => xs.get(1)")

    assert(out.index_of("R h(MacaList xs)") >= 0,
           "a list is one C type whatever it holds")
    assert(out.index_of("(*(R*)xs.data[1])") >= 0,
           "and the element type is read off the receiver's own type")
}

test_a_sum_element_is_boxed_and_compares_as_a_value() {
    out = c_for(Sum ++ "f(xs: C[]) -> int => xs.get(0) == A ? 1 : 0")

    assert(out.index_of("(*(C*)xs.data[0]) == A") >= 0,
           "an enum cell is unboxed before the comparison")
}

test_a_float_element_is_boxed_because_a_cell_would_truncate_it() {
    out = c_for("f(xs: float[]) -> float => xs.get(0)")

    assert(out.index_of("(*(double*)xs.data[0])") >= 0,
           "a double read out of a long cell would have lost its fraction")
}

test_a_field_of_a_boxed_element_reads_through_the_box() {
    out = c_for("R = {{ ys: int[] }} f(rs: R[]) -> int => rs.get(0).ys.length()")

    assert(out.index_of("(*(R*)rs.data[0]).ys.len") >= 0,
           "the record comes out of the box, then the field out of the record")
}

test_a_string_element_is_read_back_as_a_string() {
    out = c_for("f(xs: str[]) -> int => xs.get(0).length()")

    assert(out.index_of("(const char*)xs.data[0]") >= 0,
           "a str cell is a pointer, not an int")
    assert(out.index_of("((int)xs.data[0])") < 0,
           "reading it as an int is what strlen refused")
}

test_an_int_list_is_left_exactly_as_it_was() {
    out = c_for("f(xs: int[], v: int) -> int[] => xs.push(xs.get(0) + v)")

    assert(out.index_of("((int)xs.data[0])") >= 0,
           "an int fits a cell, so it is read straight out")
    assert(out.index_of("maca_listv(1, (long)(") >= 0,
           "and written straight in, with no box in sight")
    assert(out.index_of("maca_box") == out.index_of("maca_box(int n,"),
           "the only mention of the helper is the preamble that defines it")
}

test_a_list_whose_element_is_unknown_is_still_a_list() {
    out = c_for("f() -> int {{ z = [] z.length() }}")

    assert(out.index_of("(z.len)") >= 0,
           "an empty list has no element type, but it is a list all the same")
    assert(out.index_of("strlen(z)") < 0,
           "it is certainly not a string")
}

test_a_function_is_declared_before_any_body() {
    out = c_for("f() -> int => g() g() -> int => 1")
    proto = out.index_of("int g();")
    body = out.index_of("int f() {{")

    assert(proto >= 0,
           "C wants a declaration before the call, so every function gets one")
    assert(body > proto,
           "and the prototypes land ahead of the first body, not beside it")
}

test_a_prototype_carries_the_definitions_parameter_types() {
    out = c_for("f(a: str, b: int[]) -> int => 0")

    assert(out.index_of("int f(const char* a, MacaList b);") >= 0,
           "a prototype that disagreed with the definition is a conflict")
}

test_a_record_is_defined_before_the_prototype_naming_it() {
    out = c_for("f() -> R => R {{ n = 1 }} " ++ Rec)
    made = out.index_of("}} R;")

    assert(made >= 0, "the record is still emitted")
    assert(out.index_of("R f();") > made,
           "a type written below its user is hoisted above the prototypes")
}

test_str_of_a_str_is_the_string_itself() {
    out = c_for("f(s: str) -> str => str(s)")

    assert(out.index_of("return s;") >= 0,
           "a string needs no conversion, so str(s) is s")
    assert(out.index_of("maca_int_to_str(s)") < 0,
           "handing a char pointer to an int parameter is what that did")
}

test_str_picks_its_helper_from_the_arguments_type() {
    fl = c_for("f(x: float) -> str => str(x)")
    bl = c_for("f(b: bool) -> str => str(b)")
    it = c_for("f(n: int) -> str => str(n)")

    assert(fl.index_of("maca_float_to_str(x)") >= 0,
           "a double read as an int loses everything after the point")
    assert(bl.index_of("maca_bool_to_str(b)") >= 0,
           "a bool spells itself true or false, not 1")
    assert(it.index_of("maca_int_to_str(n)") >= 0,
           "and an int keeps the helper it always had")
}

test_chars_is_a_list_of_one_character_cells() {
    out = c_for("f(s: str) -> int {{ cs = s.chars() 0 }}")

    assert(out.index_of("MacaList cs = maca_chars(s);") >= 0,
           "the scanner walks a list of cells, and each cell is a str")
    assert(out.index_of("s.chars()") < 0,
           "a method call on a char pointer is not C at all")
    assert(out.index_of("maca_chars(const char* s)") >= 0,
           "and the preamble carries the helper that builds the list")
}

test_a_character_class_reads_a_byte_from_either_receiver() {
    cell = c_for("f(c: str) -> bool => c.is_whitespace()")
    digit = c_for("f(c: str) -> bool => c.is_ascii_digit()")
    code = c_for("f(s: str) -> bool => s.at(0).is_alpha()")

    assert(cell.index_of("(isspace((unsigned char)(c)[0]) != 0)") >= 0,
           "a one-character str is classified by its first byte")
    assert(digit.index_of("(isdigit((unsigned char)(c)[0]) != 0)") >= 0,
           "the same for a digit, which is what a number literal starts on")
    assert(code.index_of("(isalpha((unsigned char)(((int)s[0]))) != 0)") >= 0,
           "and .at already produced a byte, so it is classified as it is")
    assert(cell.index_of("#include <ctype.h>") >= 0,
           "the three classes are the C library's, so the header comes too")
}

test_the_preamble_defines_every_helper_the_emitter_calls() {
    out = c_for("f() -> int => 1")

    assert(out.index_of("maca_float_to_str(double x)") >= 0, "str of a float")
    assert(out.index_of("maca_bool_to_str(int b)") >= 0, "str of a bool")
    assert(out.index_of("maca_upper(const char* s)") >= 0, "upper of a str")
    assert(out.index_of("maca_str_slice(const char* s,") >= 0, "a str slice")
    assert(out.index_of("maca_ends_with(const char* s,") >= 0, "a str suffix")
    assert(out.index_of("maca_args(int argc, char** argv)") >= 0, "argv")
}

test_a_main_that_takes_arguments_gets_a_c_shim() {
    out = c_for("main(args: str[]) -> int => args.length()")

    assert(out.index_of("int maca_main(MacaList args)") >= 0,
           "the Maca body keeps its list parameter, under another name")
    assert(out.index_of("int maca_main(MacaList args);") >= 0,
           "and the prototype is renamed with it, or the two would conflict")
    assert(out.index_of("int main(int argc, char** argv)"
                        ++ " {{ return maca_main(maca_args(argc, argv)); }}")
               >= 0,
           "while the real main builds the list out of what C hands it")
    assert(out.index_of("int main(MacaList") < 0,
           "a main whose first parameter is not an int is what C refused")
}

test_a_main_with_no_parameters_is_left_exactly_as_it_was() {
    out = c_for("main() -> int => 42")

    assert(out.index_of("int main() {{ return 42;") >= 0,
           "nothing to build means no shim, and C's own main already fits")
    assert(out.index_of("maca_main") < 0,
           "renaming it would have left the program with no entry point")
}

test_int_reads_a_string_and_leaves_a_number_alone() {
    from_str = c_for("f(t: str) -> int => int(t)")
    from_int = c_for("f(v: int) -> int => int(v)")

    assert(from_str.index_of("return atoi(t);") >= 0,
           "a string becomes a number by being read, not by being cast")
    assert(from_str.index_of("int(t)") < 0,
           "int is a C keyword, so a call spelled that way is not an expression")
    assert(from_int.index_of("return v;") >= 0,
           "an int already is one, so the conversion disappears")
    assert(from_int.index_of("atoi") < 0,
           "handing atoi an int is the pointer conversion C warns about")
}

test_read_file_hands_back_a_fresh_block_of_its_own() {
    out = c_for("f(p: str) -> int {{ src = read_file(p) src.length() }}")

    assert(out.index_of("const char* src = maca_read_file(p);") >= 0,
           "the contents are a string, so the local that holds them is one")
    assert(out.index_of("= read_file(") < 0,
           "the bare name was an undeclared call returning an implicit int")
    assert(out.index_of("char* maca_read_file(const char* path)") >= 0,
           "and the preamble defines it, allocating what it hands back")
}

test_write_file_lowers_to_the_helper_the_preamble_defines() {
    out = c_for("f(p: str, t: str) -> int => write_file(p, t)")

    assert(out.index_of("return maca_write_file(p, t);") >= 0,
           "the call reaches a function C has been shown a declaration of")
    assert(out.index_of("int maca_write_file(const char* path,") >= 0,
           "which is the preamble's, beside every other helper")
}

test_upper_copies_a_string_and_folds_a_single_byte() {
    whole = c_for("f(s: str) -> str => s.upper()")
    one = c_for("f(s: str) -> int => s.at(0).upper()")

    assert(whole.index_of("maca_upper(s)") >= 0,
           "a str is uppercased into a fresh block, never in place")
    assert(one.index_of("toupper((unsigned char)(((int)s[0])))") >= 0,
           "a byte folds with toupper, which is how a type name is spotted")
}

test_a_called_parameter_is_declared_as_a_function_pointer() {
    out = c_for(Higher)

    assert(out.index_of("int run(MacaList xs, int (*f)(const char*))") >= 0,
           "the parameter carries the type the call site proved it has")
    assert(out.index_of("int run(MacaList xs, int (*f)(const char*));") >= 0,
           "and the prototype says the same, or the two would conflict")
    assert(out.index_of("MacaList xs, int f") < 0,
           "an int is not callable, which is what C said before")
    assert(out.index_of("int p(const char* c)") >= 0,
           "the callee keeps its own signature, so the pointer is not a lie")
}

test_a_function_type_in_type_position_is_an_abstract_declarator() {
    assert_eq(type_c("(int) -> str"), "const char* (*)(int)",
              "the name's place is left empty where there is no name")
    assert_eq(type_c("() -> int"), "int (*)(void)",
              "no parameters is void, not an unspecified list")
    assert_eq(type_c("(int, str) -> bool"), "int (*)(int, const char*)",
              "every parameter is converted in turn")
    assert_eq(type_c("(int) -> str[]"), "MacaList (*)(int)",
              "a function is spotted before the list its result ends with")
}

test_a_mapped_function_is_called_on_the_element_it_declared() {
    out = c_for(Rec ++ "n(r: R) -> int => r.n"
                ++ " f(xs: R[]) -> int[] => xs.map(n)")

    assert(out.index_of("n((*(R*)_m.data[_i]))") >= 0,
           "the cell is unboxed to the record the callee takes by value")
    assert(out.index_of("xs.map(n)") < 0,
           "a MacaList has no map member, which is what C said before")
    assert(out.index_of("for (int _i = 0; _i < _m.len; _i++)") >= 0,
           "the map is a loop, so no call goes through a retyped pointer")
}

test_a_mapped_result_is_boxed_when_the_callee_returns_a_record() {
    boxed = c_for(Rec ++ "w(k: int) -> R => R {{ n = k }}"
                  ++ " f(xs: int[]) -> R[] => xs.map(w)")
    flat = c_for(Rec ++ "n(r: R) -> int => r.n"
                 ++ " f(xs: R[]) -> int[] => xs.map(n)")

    assert(boxed.index_of("maca_box(sizeof(R), (R[]){{ w(") >= 0,
           "the callee's return type is what decides the cell's shape")
    assert(flat.index_of("_r.data[_i] = (long)(n(") >= 0,
           "an int fits a cell, so it is written straight in")
}

test_a_string_element_is_found_by_content_and_not_by_address() {
    out = c_for("f(xs: str[], w: str) -> int => xs.index_of(w)")
    has = c_for("f(xs: str[], w: str) -> bool => xs.contains(w)")
    cells = c_for("f(xs: int[], v: int) -> int => xs.index_of(v)")

    assert(out.index_of("maca_list_index_of_str(xs, w)") >= 0,
           "two equal strings at different addresses are the same element")
    assert(out.index_of("maca_list_index_of(xs, (long)(w))") < 0,
           "comparing the cells compared the addresses, so every lookup missed")
    assert(has.index_of("(maca_list_index_of_str(xs, w) >= 0)") >= 0,
           "contains asks the same question, so it reads the same way")
    assert(cells.index_of("maca_list_index_of(xs, (long)(v))") >= 0,
           "an int is its own value, so the cell comparison still stands")
    assert(c_for("f() -> int => 1")
               .index_of("maca_list_index_of_str(MacaList a,") >= 0,
           "and the preamble defines it beside the helper it stands next to")
}

test_two_strings_compare_by_content_with_no_literal_in_sight() {
    out = c_for("f(a: str, b: str) -> bool => a == b")
    ne = c_for("f(a: str, b: str) -> bool => a != b")
    cells = c_for("f(a: int, b: int) -> bool => a == b")

    assert(out.index_of("(strcmp(a, b) == 0)") >= 0,
           "the type says str, so the comparison reads the bytes")
    assert(out.index_of("return (a == b);") < 0,
           "comparing two char pointers asks whether they are one block")
    assert(ne.index_of("(strcmp(a, b) != 0)") >= 0,
           "and the negation is the same call against a different answer")
    assert(cells.index_of("return (a == b);") >= 0,
           "an int compares as an int, literal or not")
}

test_the_last_str_methods_lower_to_the_c_library() {
    has = c_for("f(s: str) -> bool => s.contains(\"x\")")
    cut = c_for("f(s: str) -> str => s.slice(0, 2)")
    tail = c_for("f(s: str) -> bool => s.ends_with(\"[]\")")

    assert(has.index_of("(strstr(s, \"x\") != NULL)") >= 0,
           "contains is a substring search")
    assert(cut.index_of("maca_str_slice(s, 0, 2)") >= 0,
           "a str slice copies bytes, where a list slice copies cells")
    assert(tail.index_of("maca_ends_with(s, \"[]\")") >= 0,
           "and a list type is spotted by the suffix its name ends with")
}

test_a_constant_is_emitted_once_at_file_scope() {
    out = c_for("Seed = 1000 f() -> int => Seed")

    assert(out.index_of("static const int Seed = 1000;") >= 0,
           "a top-level binding is a definition, not a statement")
    assert(out.index_of("Seed = 1000") < out.index_of("int f("),
           "and stands before the function that reads it")
}

test_a_raise_prints_and_leaves() {
    out = c_for("f() -> int {{ fail \"gone\" }}")

    assert(out.index_of("exit(1)") >= 0, "fail does not return")
    assert(out.index_of("stderr") >= 0, "and says why on the error stream")
}
