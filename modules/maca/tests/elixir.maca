import maca/lexer
import maca/parser
import maca/check
import maca/emit_elixir
import std/proc

scratch() -> str {
    dir = env_or("TMPDIR", "/tmp") ++ "/maca-elixir"
    make_dir(dir)

    dir
}

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

gate_ex(src: str) -> str =>
    exemit_module(annotated(parse_module(lex(src), 0, [])))

refused_ex(src: str) -> str[] =>
    exemit_errors(annotated(parse_module(lex(src), 0, [])))

elixir_here() -> bool =>
    have("elixir")

test_a_unit_is_one_module_and_main_is_what_the_status_comes_from() {
    made = gate_ex("main() -> int {{ info(\"hi\") 0 }}")

    assert(made.index_of("defmodule Maca do") >= 0,
           "the BEAM has nowhere to put a function but a module")
    assert(made.index_of("IO.puts(\"hi\")") >= 0, "info writes a line")
    assert(made.index_of("System.halt(Maca.main())") >= 0,
           "and the number main answered is the exit status")
}

test_a_record_is_a_struct_and_a_nullary_variant_is_an_atom() {
    made = gate_ex("Colour = Red | Green\nPoint = {{ x: int y: int }}\n"
                       ++ "here() -> Point => Point {{ x = 1, y = 2 }}\n"
                       ++ "pick() -> Colour => Red\n")

    assert(made.index_of("defmodule Point do") >= 0,
           "a record is a struct module of its own")
    assert(made.index_of("defstruct [:x, :y]") >= 0,
           "and its fields are the atoms that name them")
    assert(made.index_of("%Point{{x: 1, y: 2}}") >= 0,
           "a literal is written the way Elixir writes one")
    assert(made.index_of(":Red") >= 0,
           "a variant that carries nothing is just an atom")
}

test_a_match_is_a_case_and_the_arms_lie_flat() {
    made = gate_ex("C = Red | Green\nn(c: C) -> int => match c {{\n"
                       ++ "    Red => 1\n    Green => 2\n}}\n")

    assert(made.index_of("case c do") >= 0, "match is case")
    assert(made.index_of(":Red -> 1") >= 0, "the first arm and its body")
    assert(made.index_of(":Green -> 2") >= 0, "and the second, not the first")
}

test_integer_division_and_text_join_are_the_calls_the_beam_has() {
    made = gate_ex("half(n: int) -> int => n / 2\n"
                       ++ "rest(n: int) -> int => n % 2\n"
                       ++ "both(a: str, b: str) -> str => a ++ b\n")

    assert(made.index_of("div(n, 2)") >= 0,
           "`/` on two integers truncates, and `div` is what does that")
    assert(made.index_of("rem(n, 2)") >= 0, "and `%` is `rem`")
    assert(made.index_of("(a <> b)") >= 0,
           "`++` joins text, which on the BEAM is `<>` and not list append")
}

test_an_interpolation_is_flattened_before_the_backend_sees_it() {
    made = gate_ex("greet(who: str) -> str => \"hi {{who}}\"\n"
                       ++ "tag() -> str => \"a#b\"\n")

    assert(made.index_of("(\"hi \" <> to_string(who))") >= 0,
           "Maca flattens its own interpolation, so the BEAM sees a join")
    assert(made.index_of("\"a\\#b\"") >= 0,
           "and a `#` that was text is escaped, or a brace after it would "
               ++ "open an interpolation Elixir invented on its own")
}

test_what_the_beam_has_no_shape_for_is_named_rather_than_emitted() {
    looped = refused_ex("count() -> int {{\n    i = 0\n"
                            ++ "    while i < 3 {{ i = i + 1 }}\n    i\n}}\n")

    assert_eq(str(looped.length()), "1", "one loop, one refusal")
    assert(looped.get(0).contains("while"),
           "the refusal names the word: {looped.get(0)}")
    assert(looped.get(0).contains("recursion"),
           "and says what to write instead: {looped.get(0)}")

    early = refused_ex("pick(n: int) -> int {{\n"
                           ++ "    if n > 0 {{ return 1 }}\n    0\n}}\n")

    assert_eq(str(early.length()), "1", "one early exit, one refusal")
    assert(early.get(0).contains("return"),
           "the refusal names it: {early.get(0)}")
}

/// The same file through two back ends has to answer the same thing, or there is no language.
test_the_capstone_answers_the_same_through_the_beam_as_it_does_natively() {
    if !elixir_here() {
        assert(true, "running what was emitted needs elixir, which this host "
                         ++ "has not got")
    } else {
        dir = scratch()
        src = "apps/examples/elixir_capstone.maca"
        native = "{dir}/capstone"
        beam = "{dir}/capstone.exs"

        assert_eq(str(exec(maca_bin(), ["build", src, "-o", native])), "0",
                  "the capstone builds natively")
        assert_eq(str(exec(maca_bin(), ["build", src, "--target", "elixir",
                                        "-o", beam])), "0",
                  "and it builds for the BEAM")

        back = cwd()
        chdir(dir)
        said_c = capture(native, [])
        code_c = exec(native, [])
        said_x = capture("elixir", [beam])
        code_x = exec("elixir", [beam])
        chdir(back)

        assert_eq(said_x, said_c,
                  "the two back ends print the same thing, or one of them "
                      ++ "is reading a different language")
        assert_eq(str(code_x), str(code_c),
                  "and leave the same exit status")
        assert_eq(str(code_c), "42", "which is the number the capstone names")
    }
}

main() -> int {
    test_a_unit_is_one_module_and_main_is_what_the_status_comes_from()
    test_a_record_is_a_struct_and_a_nullary_variant_is_an_atom()
    test_a_match_is_a_case_and_the_arms_lie_flat()
    test_integer_division_and_text_join_are_the_calls_the_beam_has()
    test_an_interpolation_is_flattened_before_the_backend_sees_it()
    test_what_the_beam_has_no_shape_for_is_named_rather_than_emitted()
    test_the_capstone_answers_the_same_through_the_beam_as_it_does_natively()
    failures()
}
