import maca/lexer
import maca/parser
import maca/ty
import maca/check

errors_of(src: str) -> str[] =>
    check_errors(parse_module(lex(src), 0, []))

count_of(src: str) -> str =>
    str(errors_of(src).length())

diags_of(src: str) -> Diagnostic[] =>
    check_diagnostics(parse_module(lex(src), 0, []))

test_a_diagnostic_carries_a_code_and_where_its_statement_starts() {
    ds = diags_of("Color = Red | Green\nshade(c: Color) -> int =>\n" +
                      "    match c {{ Red => 1 }}\n")
    assert_eq(str(ds.length()), "1", "one variant is left unhandled")
    assert_eq(ds.get(0).code, "M0002", "a match with a hole has its own code")
    assert(ds.get(0).pos > 0,
           "and it names the statement it came from: {ds.get(0).pos}")
}

test_a_config_refusal_carries_the_code_for_what_it_refused() {
    ds = diags_of("system.stateVersion = \"24.05\"\n" +
                      "netwroking.hostName = \"box\"")
    assert_eq(str(ds.length()), "1", "one namespace nobody declares")
    assert_eq(ds.get(0).code, "M0004", "an unknown option has its own code")
    assert(ds.get(0).pos > 0, "the second statement is not the first")
}

test_the_sentences_are_the_messages_the_records_carry() {
    src = "take(n: int) -> int => n use() -> int => take(\"x\")"
    assert_eq(errors_of(src).get(0), diags_of(src).get(0).message,
              "check_errors is check_diagnostics read as prose")
}

test_every_code_a_diagnostic_can_carry_explains_itself() {
    assert(diag_explain("M0001") != "", "M0001 says what it means")
    assert(diag_explain("M0006") != "", "M0006 says what it means")
    assert_eq(diag_explain("M9999"), "", "and a code nobody issues says nothing")
}

type_named_in(src: str) -> str =>
    type_of(parse_expr(lex(src), 0).node)

param_surface(src: str, at: int, of: int) -> str =>
    annotated(parse_module(lex(src), 0, [])).items.get(at).params.get(of).ty

test_type_of_names_what_was_inferred() {
    assert_eq(type_named_in("1 + 2"), "int", "int arithmetic")
    assert_eq(type_named_in("1.5 + 2.5"), "float", "float arithmetic")
    assert_eq(type_named_in("1 < 2"), "bool", "a comparison")
    assert_eq(type_named_in("\"a\" + \"b\""), "str", "a concatenation")
    assert_eq(type_named_in("1 + \"a\""), "error", "a clash")
}

test_a_call_argument_must_match_the_signature() {
    bad = errors_of("take(n: int) -> int => n use() -> int => take(\"x\")")
    assert_eq(str(bad.length()), "1", "str is not int")
    assert_eq(bad.get(0), "type mismatch: expected int, found str",
              "the parameter type is what the argument is checked against")
}

test_a_call_with_the_right_argument_is_clean() {
    assert_eq(count_of("take(n: int) -> int => n use() -> int => take(7)"),
              "0", "int against int")
}

test_a_call_must_have_the_right_number_of_arguments() {
    bad = errors_of("add(a: int, b: int) -> int => a + b use() -> int => add(1)")
    assert_eq(str(bad.length()), "1", "one argument short")
    assert_eq(bad.get(0), "`add` takes 2 argument(s), given 1",
              "the count is named")
}

test_an_unannotated_parameter_is_polymorphic_across_call_sites() {
    assert_eq(count_of("keep(x) -> int => 1" +
                       " both() -> int => keep(1) + keep(\"s\")"),
              "0", "each call instantiates its own copy of x")
}

test_an_unannotated_parameter_is_inferred_from_its_own_body() {
    bad = errors_of("keep(x) -> int => x + 1" +
                    " use() -> int => keep(\"s\")")
    assert_eq(str(bad.length()), "1", "the body forced x to a number")
}

test_inference_does_not_depend_on_declaration_order() {
    after = count_of("keep(x) -> int => x + 1" +
                     " use() -> int => keep(\"s\")")
    before = count_of("use() -> int => keep(\"s\")" +
                      " keep(x) -> int => x + 1")
    assert_eq(before, after, "a call is checked against what the body proved")
    assert_eq(before, "1", "either way, one error")
}

test_an_annotated_parameter_is_the_same_type_at_every_call_site() {
    assert_eq(count_of("keep(x: int) -> int => 1" +
                       " both() -> int => keep(1) + keep(\"s\")"),
              "1", "int is int everywhere")
}

test_a_body_must_agree_with_the_declared_return() {
    bad = errors_of("bad() -> str => 1 + 2")
    assert_eq(str(bad.length()), "1", "int is not str")
    assert_eq(bad.get(0), "type mismatch: expected str, found int",
              "the declared type comes first")
}

test_a_field_read_carries_the_declared_field_type() {
    assert_eq(count_of("Point = {{ x: int }} good(p: Point) -> int => p.x"),
              "0", "x is int")
    assert_eq(count_of("Point = {{ x: int }} bad(p: Point) -> str => p.x"),
              "1", "x is int, not str")
}

test_one_mistake_is_reported_once() {
    assert_eq(count_of("bad() -> int => 1 + \"x\""),
              "1", "the return check does not report the same clash again")
}

test_a_local_does_not_leak_into_the_next_function() {
    said = errors_of("first() -> int {{ tmp = \"s\" 1 }}" +
                     " second() -> int => tmp").join(" ")

    assert(said.contains("`tmp` is a local of another function"),
           "tmp is not second's to read: {said}")
}

test_a_name_the_arm_that_reads_it_bound_is_its_own() {
    assert_eq(count_of("first() -> int {{ v = 1 v }}" +
                       " second(xs: int[]) -> str =>" +
                       " match xs {{ [v] => \"one {{v}}\" _ => \"more\" }}"),
              "0", "`v` here is what the cell matched")
}

test_a_loop_binder_and_a_captured_local_are_not_another_function_s() {
    assert_eq(count_of("held(n: int) -> int {{ x = n x }}" +
                       " over(xs: int[]) -> int {{ total = 0" +
                       " for x in xs {{ total = total + x }}" +
                       " step = f => f + total step(1) }}"),
              "0", "a binder and a capture are both in scope where they stand")
}

test_a_local_takes_the_type_of_what_it_was_bound_to() {
    assert_eq(count_of("bad() -> int {{ tmp = \"s\" tmp }}"),
              "1", "tmp is str, and the return says int")
}

test_a_list_holds_one_type() {
    assert_eq(count_of("mix() -> int {{ xs = [1, \"a\"] 1 }}"),
              "1", "int and str cannot share a list")
    assert_eq(count_of("same() -> int {{ xs = [1, 2] 1 }}"),
              "0", "two ints can")
}

test_the_branches_of_a_ternary_are_unified() {
    assert_eq(count_of("pick(c: bool) -> int => c ? 1 : \"x\""),
              "1", "one branch is int and the other str")
}

test_the_arms_of_a_match_are_unified() {
    assert_eq(count_of("Color = Red | Green" +
                       " pick(c: Color) -> int => match c {{" +
                       " Red => 1 Green => \"x\" }}"),
              "1", "one arm is int and the other str")
}

Lit = "Box = {{ n: int }} "

test_a_record_literal_field_is_checked_against_the_declared_type() {
    assert_eq(count_of(Lit + "ok() -> Box => Box {{ n = 1 }}"),
              "0", "an int belongs in an int field")
    bad = errors_of(Lit + "no() -> Box => Box {{ n = \"s\" }}")
    assert_eq(str(bad.length()), "1", "a str does not")
    assert_eq(bad.get(0), "type mismatch: expected int, found str",
              "the field's declared type is what the value answers to")
}

test_a_record_update_field_is_checked_against_the_declared_type() {
    assert_eq(count_of(Lit + "ok(b: Box) -> Box => b with {{ n = 2 }}"),
              "0", "an int belongs in an int field")
    assert_eq(count_of(Lit + "no(b: Box) -> Box => b with {{ n = \"s\" }}"),
              "1", "a str does not, and `with` knows the record from its base")
}

Two = "Pair = {{ a: int b: int }} "

test_a_record_literal_names_every_field_the_record_declares() {
    assert_eq(count_of(Two + "ok() -> Pair => Pair {{ a = 1, b = 2 }}"),
              "0", "both fields are named")
    bad = errors_of(Two + "no() -> Pair => Pair {{ a = 1 }}")

    assert_eq(str(bad.length()), "1", "the field left out is one error")
    assert_eq(bad.get(0), "`Pair` is missing field(s): b",
              "and it is named, because the C it emits will not name it")
    assert_eq(count_of(Two + "up(p: Pair) -> Pair => p with {{ a = 9 }}"),
              "0", "`with` names the fields it changes, so it owes no others")
}

test_a_record_literal_names_no_field_the_record_does_not_declare() {
    bad = errors_of(Two + "no() -> Pair => Pair {{ a = 1, b = 2, c = 3 }}")

    assert_eq(str(bad.length()), "1", "the field that is not there is one error")
    assert_eq(bad.get(0), "`Pair` has no field `c`", "and it is named")
}

Hues = "Color = Red | Green | Blue "

test_a_match_on_a_sum_covers_every_variant_or_says_underscore() {
    bad = errors_of(Hues +
                    "a(c: Color) -> int => match c {{ Red => 1 Green => 2 }}")

    assert_eq(str(bad.length()), "1", "the variant with no arm is one error")
    assert_eq(bad.get(0), "match on `Color` is not exhaustive; missing: Blue",
              "and the message names what has no arm")
    assert_eq(count_of(Hues +
                       "b(c: Color) -> int => match c {{ Red => 1 _ => 0 }}"),
              "0", "`_` is everything else, forever")
    assert_eq(count_of(Hues +
                       "d(c: Color) -> int => match c {{ Red => 1 e => 0 }}"),
              "0", "and so is a name the sum does not declare")
    assert_eq(count_of(Hues + "e(c: Color) -> int => match c {{" +
                       " Red | Green => 1 Blue => 0 }}"),
              "0", "one arm may name two variants")
}

test_a_field_binding_is_not_an_arithmetic_operator() {
    assert_eq(count_of("Tag = {{ s: str }} ok() -> Tag => Tag {{ s = \"a\" }}"),
              "0", "`=` names a field, so a str field is not a number")
}

test_plus_joins_what_it_is_given() {
    assert_eq(count_of("j(a: str, b: str) -> str => a + b"), "0",
              "two strings join, the same as `++` joins them")
    assert_eq(count_of("j(a: int[], b: int[]) -> int[] => a + b"), "0",
              "and so do two lists")
    assert_eq(count_of("j(a: int, b: int) -> int => a + b"), "0",
              "while two numbers still add")
    assert_eq(count_of("j(a: str, b: str) -> int => a + b"), "1",
              "joining two strings does not make an int")
}

test_a_call_to_a_name_nobody_declared_is_refused() {
    bad = errors_of("use() -> int => slugify(1, 2)")
    assert_eq(str(bad.length()), "1", "nothing declares `slugify`")
    assert_eq(bad.get(0), "call to undefined function `slugify`",
              "the message names the function that is missing")
    assert_eq(count_of("slugify(a: int, b: int) -> int => a + b" +
                       " use() -> int => slugify(1, 2)"),
              "0", "and writing it is the whole fix")
}

test_the_prelude_is_not_undefined() {
    assert_eq(count_of("use() -> int {{ info(\"x\") sqrt(2.0) 0 }}"),
              "0", "a call nobody wrote here is still a call the prelude answers")
}

test_a_capitalized_pattern_that_is_no_variant_is_a_misspelling() {
    bad = errors_of("Mode = Idle | Busy" +
                    " name(m: Mode) -> int => match m {{ Busi => 1 _ => 0 }}")
    assert_eq(str(bad.length()), "1", "nothing declares `Busi`")
    assert_eq(bad.get(0), "`Busi` is capitalized, so it is a constructor," +
                              " and nothing declares one by that name:" +
                              " did you mean `Busy`?",
              "and the nearest variant is what the hint offers")
    assert_eq(count_of("Mode = Idle | Busy" +
                       " name(m: Mode) -> int => match m {{ busi => 1 }}"),
              "0", "a pattern that binds what it matched is lowercase")
}

test_exec_hands_back_an_exit_code() {
    assert_eq(count_of("run() -> int => exec(\"cc\", [])"),
              "0", "an exit code is an int")
    assert_eq(count_of("run() -> str => exec(\"cc\", [])"),
              "1", "and it is not a string")
}

test_a_clean_module_reports_nothing() {
    assert_eq(count_of("add(a: int, b: int) -> int => a + b" +
                       " use() -> int => add(1, 2)"),
              "0", "nothing to say")
}

Higher = "run(xs: str[], p) -> int => p(xs.get(0)) ? 1 : 0"

test_a_called_parameter_is_inferred_as_a_function() {
    assert_eq(count_of(Higher + " ok(c: str) -> bool => true" +
                       " use(xs: str[]) -> int => run(xs, ok)"),
              "0", "ok matches the shape p was used at")
    assert_eq(count_of(Higher + " no(c: int) -> bool => true" +
                       " use(xs: str[]) -> int => run(xs, no)"),
              "1", "an int parameter is not the str p was called with")
}

Ret = "run(xs: str[], p) -> int => p(xs.get(0))"

test_an_inferred_parameter_type_is_written_into_the_tree() {
    assert_eq(param_surface(Ret, 0, 1), "(str) -> int",
              "a back end reads the shape rather than guessing at it")
    assert_eq(param_surface(Ret, 0, 0), "str[]",
              "a declared parameter keeps the type it was written with")
}

test_a_function_type_is_spelled_with_its_parameters_and_its_result() {
    assert_eq(surface_of(t_fn([], t_int())), "() -> int",
              "no parameters is an empty list, not a missing one")
    assert_eq(surface_of(t_fn([t_int(), t_str()], t_bool())),
              "(int, str) -> bool", "the parameters are comma separated")
    assert_eq(surface_of(t_fn([t_str()], t_array(t_str()))),
              "(str) -> str[]", "the result carries its own spelling")
}

test_a_called_parameter_carries_its_result_type() {
    assert_eq(count_of("run(xs: str[], p) -> int => p(xs.get(0))" +
                       " ok(c: str) -> int => 1" +
                       " use(xs: str[]) -> int => run(xs, ok)"),
              "0", "p returns what run returns")
    assert_eq(count_of("run(xs: str[], p) -> int => p(xs.get(0))" +
                       " ok(c: str) -> str => \"a\"" +
                       " use(xs: str[]) -> int => run(xs, ok)"),
              "1", "a str result does not fit an int return")
}

test_fail_fits_whatever_return_it_stands_in_for() {
    assert_eq(count_of("f(xs: int[]) -> bool {{ fail \"unwritten\" }}"), "0",
              "a raise is not a str where a bool was declared")
    assert_eq(count_of("g() -> int[] {{ fail \"unwritten\" }}"), "0",
              "nor a str where a list was declared")
}

test_a_top_level_constant_is_a_name_the_module_knows() {
    assert_eq(count_of("Seed = 1000 f() -> int => Seed"), "0",
              "a constant is in scope for every function under it")
    assert_eq(count_of("Name = \"m\" f() -> int => Name"), "1",
              "and carries the type of the value it binds")
}

Loop = "f(n: int) -> int {{ i = 0 while i < n {{ i = i + 1 }} i }}"

test_a_while_condition_must_be_a_bool() {
    assert_eq(count_of(Loop), "0", "a comparison is a bool")
    bad = errors_of("f() -> int {{ while 5 {{ info(\"x\") }} 0 }}")
    assert_eq(str(bad.length()), "1", "5 is not a condition")
    assert_eq(bad.get(0), "type mismatch: expected bool, found int",
              "and the diagnostic says which side is wrong")
}

test_a_range_counts_between_two_ints() {
    assert_eq(count_of("f(n: int) -> int[] => 0..n"), "0", "both ends are int")
    assert_eq(count_of("f() -> int[] => 0..\"ten\""), "1",
              "a str end is refused")
    assert_eq(type_named_in("1..5"), "Array int", "a range is a list of int")
}

test_a_for_binder_takes_the_element_type() {
    assert_eq(count_of("f(xs: str[]) -> int {{ for s in xs" +
                       " {{ info(s) }} 0 }}"), "0",
              "the binder is a str, which info accepts")
    assert_eq(count_of("g(n: int) -> int => n" +
                       " f(xs: str[]) -> int {{ for s in xs" +
                       " {{ g(s) }} 0 }}"), "1",
              "and it is not an int, so a call that wants one is refused")
}

test_a_string_index_is_a_one_character_string() {
    assert_eq(count_of("f(s: str) -> str => s.at(0)"), "0",
              "at gives a str, which is what the handbook promises")
    bad = errors_of("f(s: str) -> int => s.at(0)")
    assert_eq(str(bad.length()), "1", "so it is not an int")
    assert_eq(bad.get(0), "type mismatch: expected int, found str",
              "and the mismatch names both")
    assert_eq(count_of("f(xs: int[]) -> int => xs.get(0)"), "0",
              "a list element is still the element")
}

test_a_lowercase_type_variable_fits_whatever_it_is_given() {
    assert_eq(count_of("id(x: a) -> a => x use() -> int => id(5) + id(6)"),
              "0", "a is a variable, not a nominal type named a")
    assert_eq(count_of("f(v: f32x8) -> f32x8 => v"), "0",
              "and a sized number is concrete, so it unifies with itself")
    assert_eq(count_of("f(p: Point) -> int => p"), "1",
              "a capitalised type is still nominal and still checked")
}

test_arithmetic_over_a_nominal_type_takes_its_own_result() {
    assert_eq(count_of("dot(a: f32x8, b: f32x8) -> f32x8 => a * b"), "0",
              "a vector times a vector is a vector")
    assert_eq(count_of("V = {{ x: int }} add(a: V, b: V) -> V => a" +
                       " use(p: V, q: V) -> V => p + q"), "0",
              "a record with an `add` beside it takes that result")
    assert_eq(count_of("V = {{ x: int }} mul(a: V, n: int) -> V => a" +
                       " twice(p: V) -> V => p * 2"), "0",
              "and the overload settles the result before the two sides meet")
    bad = errors_of("j(a: str, b: str) -> int => a + b")
    assert_eq(str(bad.length()), "1", "two joined strings are not an int")
    assert_eq(bad.get(0), "type mismatch: expected int, found str",
              "and the declared return is what refuses them")
}

test_a_statement_if_has_no_value_to_agree_on() {
    assert_eq(count_of("f(n: int) -> int {{ q = 0 b = true" +
                       " if n > 0 {{ b = false }} else {{ q = 1 }} q }}"),
              "0", "the branches of a statement if need not agree")
    assert_eq(count_of("f(n: int) -> int =>" +
                       " if n > 0 {{ 1 }} else {{ \"x\" }}"), "1",
              "but in value position they still must")
}

test_a_builtin_carries_the_type_its_result_has() {
    assert_eq(count_of("f(n: int) -> float => float(n) / 2.0"), "0",
              "float() is a float, so the division is one too")
    assert_eq(count_of("f(n: int) -> int => float(n)"), "1",
              "and it is not an int")
    assert_eq(count_of("f(p: str) -> bool => file_exists(p)"), "0",
              "an existence test is a bool")
    assert_eq(count_of("f() -> str[] => list_dir(\".\")"), "0",
              "and a listing is a list of str")
}

test_a_typed_binding_is_the_type_it_declares() {
    assert_eq(count_of("f() -> str {{ s: str = \"a\" s }}"), "0",
              "the annotation is what the name carries")
    assert_eq(count_of("f() -> int {{ s: str = \"a\" s }}"), "1",
              "so returning it as an int is refused")
}

test_a_typed_binding_holds_its_value_to_the_type_it_declares() {
    assert_eq(count_of("f() -> int {{ n: str = 1 0 }}"), "1",
              "a declared type the value cannot be is a clash, not a cast")
    assert_eq(param_surface("apply(f, xs: str[]) -> str {{" +
                            " got: str = f(xs) got }}", 0, 0),
              "(str[]) -> str",
              "and it flows back, so what f returns is solved by the binding")
}

test_a_method_no_receiver_answers_to_is_the_function_of_that_name() {
    assert_eq(count_of("C = {{ n: int }} wide(c: C, by: int) -> C => c\n" +
                       "f(c: C) -> C => c.wide(2)"),
              "0", "`c.wide(2)` is `wide(c, 2)`, so it is a C and not an any")
    assert_eq(count_of("C = {{ n: int }} wide(c: C, by: int) -> C => c\n" +
                       "f(c: C) -> int => c.wide(2)"),
              "1", "which means handing it back as an int is refused")
    assert_eq(count_of("C = {{ n: int }} wide(c: C, by: int) -> C => c\n" +
                       "f(c: C) -> C => c.wide(\"2\")"),
              "1", "and the argument is checked against what wide declared")
}

test_a_constant_at_file_scope_carries_the_type_of_its_value() {
    assert_eq(count_of("C = {{ n: int }} mk() -> C => C {{ n = 1 }}\n" +
                       "Spec = mk()\n" +
                       "f(c: C) -> int => c.n\n" +
                       "g() -> int => f(Spec)"),
              "0", "a constant is what its value is, which is what f asks for")
    assert_eq(count_of("C = {{ n: int }} mk() -> C => C {{ n = 1 }}\n" +
                       "Spec = mk()\n" +
                       "g() -> int => Spec"),
              "1", "so handing it back as an int is refused")
}

test_a_branch_run_for_its_effect_need_not_agree() {
    assert_eq(count_of("step(n: int) {{\n" +
                       "    p = false\n" +
                       "    at = 0\n" +
                       "    while !p {{\n" +
                       "        if at < n {{\n" +
                       "            if at > 0 {{ p = true }} else {{ at = at + 1 }}\n" +
                       "        }} else if at > n {{\n" +
                       "            p = true\n" +
                       "        }} else {{\n" +
                       "            at = 0\n" +
                       "        }}\n" +
                       "    }}\n" +
                       "}}"),
              "0", "a nested if and an else-if run for their effect answer nothing")
    assert_eq(count_of("run(tag: int, xs: int[]) -> int {{\n" +
                       "    match tag {{\n" +
                       "        1 => {{ info(\"a\") }}\n" +
                       "        _ => {{ xs[0] = 2 }}\n" +
                       "    }}\n" +
                       "    0\n" +
                       "}}"),
              "0", "and a match run for its effect answers nothing either")
    assert_eq(count_of("pick(n: int) -> int => if n > 0 {{ 1 }} else {{ \"x\" }}"),
              "1", "while an if that is read for its value still has to agree")
}

test_a_local_shadows_a_function_of_the_same_name() {
    assert_eq(count_of("body(a: int, b: int, c: int, d: int) -> int => a\n" +
                       "span(r: int, body) -> int => body(r)"),
              "0", "`body(r)` calls the parameter, not the four-argument function")
    assert_eq(count_of("body(a: int) -> int => a\n" +
                       "span(r: int, body: int) -> int => body(r)"),
              "0", "a local that cannot be called leaves the function it shadows")
}

test_input_no_production_reads_is_reported_not_swallowed() {
    bad = errors_of("f() -> int => :")
    assert_eq(str(bad.length()), "1", "an unreadable token is not nothing")
    assert_eq(bad.get(0), "no expression starts at `:`",
              "the token is named, so the message says where to look")
}

test_one_name_defined_twice_is_named_as_a_clash() {
    bad = errors_of("count(s: str) -> int => 1 count(n: int) -> int => 2")

    assert_eq(str(bad.length()), "1", "the second definition is the problem")
    assert(bad.get(0).contains("`count` is defined twice"),
           "and it says which name, because the C it emits will not")
    assert_eq(count_of("a() -> int => 1 b() -> int => 2"), "0",
              "two different names are not a clash")
}

test_a_pattern_binds_its_payload_to_the_type_the_variant_declared() {
    assert_eq(count_of("S = C(float) | R(float, float)" +
                       " area(s: S) -> float => match s {{" +
                       " C(r) => 3.14 * r * r R(w, h) => w * h }}"),
              "0", "an unbound payload settled on int and clashed with float")
    assert_eq(count_of("S = C(int) f(s: S) -> str => match s {{ C(n) => n }}"),
              "1", "and a payload the variant declared int is not a str")
}

test_element_is_the_name_the_spec_gives_rendered_text() {
    assert_eq(count_of("view() -> Element => div(\"hi\")"), "0",
              "a rendered element is a str natively, and Element names it")
    assert_eq(count_of("view() -> Element[] => [div(\"a\"), div(\"b\")]"), "0",
              "and a list of them is a list of those")
    assert_eq(count_of("view() -> Element => 1"), "1",
              "which is still not a number")
}

test_an_element_is_the_html_text_it_renders() {
    assert_eq(count_of("shell(body: str) -> str => div(class=\"wrap\", body)"),
              "0", "a tag no one declared is an element, and one reads as str")
    assert_eq(count_of("shell(body: str) -> int => div(class=\"wrap\", body)"),
              "1", "so handing it back as an int is refused")
}

test_a_declared_name_beats_the_tag_it_is_spelled_like() {
    assert_eq(count_of("code(n: int) -> int => n use() -> int => code(1)"),
              "0", "`code` is a tag, and this module declares it anyway")
}

test_a_swallowed_argument_does_not_pass_for_a_clean_module() {
    assert_eq(count_of("g(n: int) -> int => n use() -> int => g(:)"),
              "1", "silence here emitted `?` into the C and still exited zero")
}

test_a_shift_counts_bits_so_neither_side_may_be_a_float() {
    assert_eq(type_named_in("1 << 2"), "int", "a shift answers a whole number")
    assert_eq(type_named_in("1.5 << 2.5"), "int",
              "and a float pair does not make one, because a bit is not a fraction")
    assert_eq(count_of("f() -> int => 1.5 << 2.5"), "2",
              "each side that has no bits to move is reported")
    assert_eq(count_of("g(s: str) -> int => s >> 1"), "1", "text has none either")
    assert_eq(count_of("h(n: int) -> int => n << 1"), "0", "two integers are fine")
}

test_a_constant_refuses_the_second_write() {
    bad = errors_of("use() -> int {{ const n = 1 n = 2 n }}")
    assert_eq(str(bad.length()), "1", "`const` froze n")
    assert_eq(bad.get(0), "cannot reassign constant `n`; declare it mutable" +
                              " with `n = …` (no `const`)",
              "the message names the binding and the way out")
}

test_only_const_freezes_a_lowercase_binding() {
    assert_eq(count_of("use() -> int {{ n = 1 n = 2 n }}"), "0",
              "a bare lowercase name is a variable")
    assert_eq(count_of("use() -> int {{ n = 1 as const n = 2 n }}"), "1",
              "`as const` freezes the binding it trails")
    assert_eq(count_of("use() -> int {{ const n: int = 1 n = 2 n }}"), "1",
              "an annotated constant is a constant too")
}

test_a_capitalized_binding_is_a_constant_without_the_word() {
    assert_eq(count_of("use() -> int {{ N = 1 N = 2 N }}"), "1",
              "a capital says constant on its own")
}

test_a_constant_is_frozen_only_inside_the_body_that_declared_it() {
    assert_eq(count_of("one() -> int {{ const n = 1 n }}" +
                       " two() -> int {{ n = 1 n = 2 n }}"),
              "0", "the freeze does not outlive its function")
    assert_eq(count_of("use(n: int) -> int {{ n = 2 n }}"), "0",
              "and a parameter is a mutable local")
}

test_a_tag_nobody_declared_is_markup_and_not_a_missing_function() {
    assert_eq(count_of("main() -> Element => div(button(\"ok\")," +
                       " input(placeholder=\"name\"))"),
              "0", "a nested tag and an attribute are markup, not calls to write")
}

test_a_hyphenated_tag_is_a_custom_element_not_a_missing_function() {
    assert_eq(count_of("main() -> Element =>" +
                       " iconify-icon(icon=\"lucide:lock\", my-card())"),
              "0", "the platform spells a custom element with a hyphen")
}

test_a_name_the_module_declares_is_a_name_and_not_a_word_maca_lacks() {
    assert_eq(count_of("type(n: int) -> int => n + 1" +
                       " main() -> int => type(41)"),
              "0", "`type` is declared here, so it is the function it declares")
    assert_eq(count_of("f() -> int {{ return 1 }}"), "0",
              "and `return` is a word Maca has, so it is not hinted at")
}

test_two_anonymous_record_literals_meet_on_their_fields() {
    assert_eq(count_of("pick(c: bool) -> int {{ p = c ? {{ x = 1 }}" +
                       " : {{ x = 2 }} p.x }}"),
              "0", "neither literal names a record, so the field is what they share")
}

test_the_message_names_the_annotation_and_then_the_value() {
    bad = errors_of("Point = {{ x: int }} f() -> int {{ p: Point = 3 p.x }}")
    assert_eq(str(bad.length()), "1", "3 is not a Point")
    assert_eq(bad.get(0), "type mismatch: expected Point, found int",
              "the annotation is what the value answers to")
    over = errors_of("f() -> int {{ for i in \"a\"..\"b\" {{ info(\"{{i}}\") }} 0 }}")
    assert(over.length() > 0, "a range between two strings counts nothing")
    assert_eq(over.get(0), "type mismatch: expected int, found str",
              "and a range end is read against the int it has to be")
}

test_a_rest_parameter_must_be_the_last_one() {
    bad = errors_of("odd(...rest: int, tail: str) -> int => rest.length()")
    assert_eq(str(bad.length()), "1", "nothing says where the gathering stops")
    assert(bad.get(0).contains("must be last"),
           "and the message says where it belongs: {bad.get(0)}")
    assert_eq(count_of("odd(head: str, ...rest: int) -> int => rest.length()"),
              "0", "behind a fixed parameter it is where it belongs")
}

test_a_variadic_call_counts_only_the_fixed_parameters() {
    bad = errors_of("tag(label: str, ...rest: int) -> int => rest.length()" +
                    " use() -> int => tag()")
    assert_eq(str(bad.length()), "1", "the fixed parameter went unfilled")
    assert_eq(bad.get(0), "`tag` takes at least 1 argument(s), given 0",
              "the count owed is the fixed one, not every parameter")
    assert_eq(count_of("tag(label: str, ...rest: int) -> int => rest.length()" +
                       " use() -> int => tag(\"a\")"),
              "0", "the fixed one alone fills the call")
}

test_a_variadic_is_callable_and_is_not_a_value() {
    bad = errors_of("total(...rest: int) -> int => rest.length()" +
                    " apply(f, v: int) -> int => f(v)" +
                    " use() -> int => apply(total, 3)")
    assert_eq(str(bad.length()), "1", "a variadic has no arity as a value")
    assert(bad.get(0).contains("cannot be used as a function value"),
           "and the message says to call it instead: {bad.get(0)}")
    assert_eq(count_of("total(...rest: int) -> int => rest.length()" +
                       " use() -> int => total(1, 2)"),
              "0", "calling it is what it is for")
}

test_a_rest_parameter_says_what_its_list_holds() {
    assert_eq(count_of("total(...rest: int) -> int => rest.length()"), "0",
              "an annotated rest parameter is one list of that type")
    bad = errors_of("firstf(...rest) -> int => rest.length()")
    assert_eq(str(bad.length()), "1", "an unannotated one says nothing")
    assert(bad.get(0).contains("rest parameter with no type"),
           "and the message says what is missing: {bad.get(0)}")
    told = errors_of("main(...args: str) -> int => args.length()")
    assert_eq(str(told.length()), "1", "the command line is not a caller")
    assert(told.get(0).contains("`main` takes no rest parameter"),
           "and `main` is told so by name: {told.get(0)}")
}

on_target(src: str, target: str) -> str[] =>
    check_diagnostics_on(parse_module(lex(src), 0, []), target)
        .map(diag_message)

named_on(src: str, target: str) -> str =>
    on_target(src, target).join(" | ")

test_a_target_names_every_function_performing_what_it_cannot_carry() {
    src = "shout(m: str) -> int {{\n    info(m)\n    0\n}}\n"
    assert_eq(str(on_target(src, "native").length()), "0",
              "native carries io, so nothing is refused")
    said = on_target(src, "embedded")
    assert_eq(str(said.length()), "1", "embedded carries only exn")
    assert_eq(said.get(0),
              "`shout` performs io, which the `embedded` target cannot carry",
              "and the message names the function, the effect and the target")
}

test_an_effect_reaches_the_caller_that_only_calls_the_thing_performing_it() {
    src = "deep(n: int) -> int {{\n    info(\"x\")\n    n\n}}\n" +
        "middle(n: int) -> int => deep(n)\n" +
        "top(n: int) -> int => middle(n)\n" +
        "aside(n: int) -> int => n + 1\n"
    said = named_on(src, "embedded")
    assert(said.contains("`top` performs io"),
           "an effect propagates through two calls: {said}")
    assert(said.contains("`middle` performs io"), "and through one: {said}")
    assert(!said.contains("`aside`"),
           "a function calling nothing effectful stays pure: {said}")
}

test_two_functions_that_call_each_other_settle_instead_of_spinning() {
    src = "ping(n: int) -> int => n <= 0 ? 0 : pong(n - 1)\n" +
        "pong(n: int) -> int {{\n    info(\"p\")\n    ping(n - 1)\n}}\n"
    said = named_on(src, "embedded")
    assert(said.contains("`ping` performs io"),
           "the effect crosses the cycle: {said}")
    assert(said.contains("`pong` performs io"), "both ways: {said}")
}

test_each_target_carries_what_that_back_end_can_actually_do() {
    forked = "forked() -> int => os.run(\"ls\")\n"
    fetched = "fetched() -> int => net.get(\"u\")\n"
    napped = "napped() -> int {{\n    sleep_ms(1)\n    0\n}}\n"
    raised = "raised() -> int => fail \"no\"\n"

    assert_eq(str(on_target(fetched, "js").length()), "0",
              "a browser can reach the network")
    assert_eq(str(on_target(forked, "js").length()), "1",
              "and cannot fork a process")
    assert_eq(str(on_target(napped, "js").length()), "0",
              "async is what a browser is made of")
    assert_eq(str(on_target(raised, "embedded").length()), "0",
              "exn is the one effect every target carries")
    assert(named_on(forked + fetched + napped, "all")
               .contains("every program target"),
           "`all` is what the targets share, and is named as such")
}

test_a_target_nothing_builds_for_is_not_a_target() {
    assert(is_known_target("embedded"), "embedded is built")
    assert(is_known_target("all"), "`all` is what every program target shares")
    assert(is_known_target("elixir"), "the BEAM is reached by naming Elixir")
    assert(!is_known_target("beam"),
           "and by naming the language, never the machine under it")
    assert_eq(str(target_effects("nix").length()), "0",
              "a NixOS module is data, so it carries nothing")
    assert_eq(str(target_effects("native").length()), "5",
              "and native carries every effect there is")
}

test_the_target_refusal_carries_its_code_and_says_how_to_fix_it() {
    ds = check_diagnostics_on(
        parse_module(lex("shout() -> int {{\n    info(\"x\")\n    0\n}}\n"),
                     0, []), "embedded")
    assert_eq(str(ds.length()), "1", "one function, one refusal")
    assert_eq(ds.get(0).code, "M0007", "an off-target effect has its own code")
    assert(ds.get(0).note.contains("build for a target that can"),
           "and the note says what to do: {ds.get(0).note}")
    assert(diag_explain("M0007") != "", "M0007 says what it means")
}
