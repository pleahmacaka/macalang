import std/proc

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

scratch(name: str) -> str {
    dir = "{env_or("TMPDIR", "/tmp")}/maca-js-parse/{name}"

    exec("rm", ["-rf", dir])
    make_dir(dir)

    dir
}

js_apps() -> str[] =>
    ["apps/site/home.maca", "apps/desktop/app.maca",
     "apps/signal_demo/signal_demo.maca", "apps/bench_demo/bench_demo.maca",
     "apps/profile_demo/profile_demo.maca", "apps/cli_tool/cli_tool.maca",
     "apps/tambo_demo/tambo_demo.maca"]

/// Build one source to JS and hand back the directory `app.js` landed in.
emitted(src: str, name: str) -> str {
    out = scratch(name)
    said = capture_err(maca_bin(), ["build", "--target", "js", src, "-o", out])

    assert(file_exists(out ++ "/app.js"), "{src} did not build to JS: {said}")

    out
}

parses(src: str, name: str) {
    at = emitted(src, name) ++ "/app.js"

    assert_eq(str(exec("node", ["--check", at])), "0",
              "node refused the JS emitted for {src}:\n"
                  ++ capture_err("node", ["--check", at]))
}

test_every_page_this_repository_ships_is_javascript_node_accepts() {
    if !have("node") {
        return
    }

    for src in js_apps() {
        parses(src, basename(src))
    }
}

test_the_playground_parses_where_the_module_it_carries_can_be_found() {
    if !have("node") {
        return
    }

    root = scratch("play")

    make_dir(root ++ "/apps/playground")
    make_dir(root ++ "/apps/npm")
    write_file(root ++ "/apps/playground/playground.maca",
               read_file("apps/playground/playground.maca"))
    write_file(root ++ "/apps/npm/maca_wasm.wasm", "not the compiler")

    parses(root ++ "/apps/playground/playground.maca", "playground")
}

test_the_control_flow_fixture_computes_the_same_thing_natively() {
    assert_eq(str(exec(maca_bin(),
                       ["test",
                        "crates/driver/tests/programs/js_control_flow.maca"])),
              "0",
              "the file the JS backend has its own run of answers the same "
                  ++ "way when it is compiled natively")
}

Shims = """
globalThis.assert = function (c, m) {
  if (!c) throw new Error("assert failed: " + m);
};
globalThis.assert_eq = function (got, want, m) {
  if (String(got) !== String(want)) {
    throw new Error(m + " | got: " + String(got) + " | want: " + String(want));
  }
};
globalThis.failures = () => 0;
const m = require("./app.js");
const tests = Object.keys(m).filter((k) => k.startsWith("test_"));
let failed = 0;
for (const name of tests) {
  try {
    m[name]();
  } catch (e) {
    failed += 1;
    console.log("FAILED " + name + ": " + e.message);
  }
}
console.log("ran " + tests.length + " tests");
if (tests.length === 0) process.exit(2);
if (failed > 0) process.exit(1);
"""

/// Run a suite's `test_` functions on the JS target, since `assert` has no JS lowering of its own.
holds_on_the_js_target(src: str, name: str) {
    runner = emitted(src, name) ++ "/run.js"
    write_file(runner, Shims)
    said = capture("node", [runner])

    assert_eq(str(exec("node", [runner])), "0",
              "{src} did not hold on the JS target:\n{said}")
}

test_the_module_state_suite_holds_on_the_js_target() {
    if !have("node") {
        return
    }

    holds_on_the_js_target("crates/driver/tests/programs/module_state.maca",
                           "module_state")
}
