import std/proc

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

scratch(name: str) -> str {
    dir = "{env_or("TMPDIR", "/tmp")}/maca-js-parse/{name}"

    exec("rm", ["-rf", dir])
    make_dir(dir)

    dir
}

js_apps() -> str[] =>
    ["apps/site/home.maca", "apps/desktop/app.maca",
     "apps/signal_demo/signal_demo.maca", "apps/bench_demo/bench_demo.maca",
     "apps/profile_demo/profile_demo.maca", "apps/cli_tool/cli_tool.maca",
     "apps/tambo_demo/tambo_demo.maca"]

/// Build one source to JS and hand back the directory `app.js` landed in.
emitted(src: str, name: str) -> str {
    out = scratch(name)
    said = capture_err(maca_bin(), ["build", "--target", "js", src, "-o", out])

    assert(file_exists(out ++ "/app.js"), "{src} did not build to JS: {said}")

    out
}

parses(src: str, name: str) {
    at = emitted(src, name) ++ "/app.js"

    assert_eq(str(exec("node", ["--check", at])), "0",
              "node refused the JS emitted for {src}:\n"
                  ++ capture_err("node", ["--check", at]))
}

test_every_page_this_repository_ships_is_javascript_node_accepts() {
    if !have("node") {
        return
    }

    for src in js_apps() {
        parses(src, basename(src))
    }
}

test_the_playground_parses_where_the_module_it_carries_can_be_found() {
    if !have("node") {
        return
    }

    root = scratch("play")

    make_dir(root ++ "/apps/playground")
    make_dir(root ++ "/apps/npm")
    write_file(root ++ "/apps/playground/playground.maca",
               read_file("apps/playground/playground.maca"))
    write_file(root ++ "/apps/npm/maca_wasm.wasm", "not the compiler")

    parses(root ++ "/apps/playground/playground.maca", "playground")
}

test_the_control_flow_fixture_computes_the_same_thing_natively() {
    assert_eq(str(exec(maca_bin(),
                       ["test",
                        "crates/driver/tests/programs/js_control_flow.maca"])),
              "0",
              "the file the JS backend has its own run of answers the same "
                  ++ "way when it is compiled natively")
}

/// A suite on the JS target runs the way a native one does: the entry answers with its failure count.
holds_on_the_js_target(src: str, name: str) {
    at = emitted(src, name) ++ "/app.js"
    said = capture_err("node", [at])

    assert_eq(str(exec("node", [at])), "0",
              "{src} did not hold on the JS target:\n{said}")
}

test_the_typed_json_suite_holds_on_the_js_target() {
    if !have("node") {
        return
    }

    holds_on_the_js_target("crates/driver/tests/programs/json_typed.maca",
                           "json_typed")
}

test_the_module_state_suite_holds_on_the_js_target() {
    if !have("node") {
        return
    }

    holds_on_the_js_target("crates/driver/tests/programs/module_state.maca",
                           "module_state")
}

test_an_arrow_block_body_is_a_block_on_the_js_target() {
    if !have("node") {
        return
    }

    at = emitted("crates/driver/tests/programs/arrow_records.maca",
                 "arrow_records") ++ "/app.js"
    probe = "const m = require(\"{at}\");"
        ++ " if (m.several() !== 41) throw new Error(\"several: \" +"
        ++ " m.several());"
        ++ " if (m.one() !== 42) throw new Error(\"one: \" + m.one());"
        ++ " console.log(\"ok\")"

    assert_eq(capture("node", ["-e", probe]).trim(), "ok",
              "the arrow block came out as a record: "
                  ++ capture_err("node", ["-e", probe]))
}

PageWithStorage = "import web/storage\n\nnote = stored(\"page.note\", \"hello\")"
    ++ "\n\nrename(v: str) -> int {{\n    note = v\n    0\n}}\n\n"
    ++ "main() -> Element => div(span(note))\n"

/// Every `<script>` the page holds, in the order a browser would run them.
page_scripts(at: str) -> str {
    html = read_file(at)
    out = ""
    rest = html
    i = 0

    while rest.index_of("<script>") >= 0 {
        opened = rest.slice(rest.index_of("<script>") + 8, rest.length())
        shut = opened.index_of("</script>")
        out = out ++ opened.slice(0, shut) ++ "\n"
        rest = opened.slice(shut + 9, opened.length())
        i = i + 1
    }

    out
}

test_a_module_that_supplies_a_function_reaches_the_page_that_uses_it() {
    if !have("node") {
        return
    }

    dir = scratch("storage")
    src = dir ++ "/home.maca"

    write_file(src, PageWithStorage)

    said = capture_err(maca_bin(), ["build", "--target", "js", src, "-o",
                                    dir ++ "/out"])

    assert(file_exists(dir ++ "/out/index.html"),
           "the page did not build: {said}")

    write_file(dir ++ "/page.js",
        "const store = new Map([[\"page.note\", JSON.stringify(\"kept\")]]);\n"
            ++ "globalThis.localStorage = {{ getItem: k => store.has(k) ? "
            ++ "store.get(k) : null, setItem: (k, v) => store.set(k, "
            ++ "String(v)), removeItem: k => store.delete(k) }};\n"
            ++ page_scripts(dir ++ "/out/index.html")
            ++ "\nrename(\"written\");\n"
            ++ "console.log(store.get(\"page.note\"));\n")

    assert_eq(capture("node", [dir ++ "/page.js"]).trim(), "\"written\"",
              "a name the browser keeps is read back through the block the "
                  ++ "module supplies, and assigning it saves again: "
                  ++ capture_err("node", [dir ++ "/page.js"]))
}
