import std/path
import std/proc

root() -> str =>
    env_or("TMPDIR", "/tmp") + "/maca-cli-module-entry"

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() + "/" + named
}

project(tag: str) -> str {
    dir = root() + "/" + tag
    remove_dir(dir)
    make_dir(dir)
    write_file(dir + "/maca.toml", "[package]\nname = \"p\"\n")

    dir
}

put(dir: str, rel: str, body: str) -> bool {
    at = dir + "/" + rel
    make_dir(dirname(at))

    write_file(at, body)
}

said_out(dir: str, args: str[]) -> str {
    bin = maca_bin()
    back = cwd()
    chdir(dir)
    got = capture(bin, args)
    chdir(back)

    got
}

said_err(dir: str, args: str[]) -> str {
    bin = maca_bin()
    back = cwd()
    chdir(dir)
    got = capture_err(bin, args)
    chdir(back)

    got
}

exit_code(dir: str, args: str[]) -> int {
    bin = maca_bin()
    back = cwd()
    chdir(dir)
    rc = exec(bin, args)
    chdir(back)

    rc
}

test_a_package_function_runs_from_the_command_line() {
    dir = project("serve")
    put(dir, "modules/http/server.maca",
        "listen(port: int) -> str =>\n    \"listening on {{port}}\"\n")
    put(dir, "modules/http/serve.maca",
        "import {{ listen }} from http/server\n\nserve() -> int {{\n" +
            "    info(listen(8080))\n    0\n}}\n")

    for spec in ["http.serve", "http/serve"] {
        assert_eq(said_out(dir, ["-m", spec]).trim(), "listening on 8080",
                  "maca -m {spec} did not reach the function")
    }
}

test_a_bare_module_runs_its_main() {
    dir = project("bare")
    put(dir, "modules/greet.maca",
        "main() -> int {{\n    info(\"hello from the module\")\n    0\n}}\n")

    assert_eq(said_out(dir, ["-m", "greet"]).trim(), "hello from the module",
              "a module that has a main runs it")
}

test_a_module_without_a_main_runs_its_namesake() {
    dir = project("namesake")
    put(dir, "modules/greet.maca",
        "greet() -> int {{\n    info(\"named after the module\")\n    0\n}}\n")

    assert_eq(said_out(dir, ["-m", "greet"]).trim(), "named after the module",
              "the function named after the module is the entry")
}

test_the_leftover_command_line_reaches_the_function() {
    dir = project("args")
    put(dir, "modules/echo.maca",
        "say(args: str[]) -> int {{\n    joined = args.join(\" \")\n" +
            "    info(\"got {{args.length()}}: {{joined}}\")\n    0\n}}\n")

    assert_eq(said_out(dir, ["-m", "echo.say", "alpha", "beta"]).trim(),
              "got 2: alpha beta", "what is left of the line is the argument")
}

test_the_return_type_becomes_the_exit_status() {
    dir = project("status")
    put(dir, "modules/status.maca",
        "code() -> int => 3\n\nok() -> bool => false\n\n" +
            "note() -> str => \"nothing to report\"\n")

    assert_eq(str(exit_code(dir, ["-m", "status.code"])), "3",
              "an int is the code")
    assert_eq(str(exit_code(dir, ["-m", "status.ok"])), "1", "false is failure")
    assert_eq(str(exit_code(dir, ["-m", "status.note"])), "0",
              "a value the shell has no meaning for still succeeds")
}

test_the_refusals_name_what_is_missing() {
    dir = project("errors")
    put(dir, "modules/status.maca",
        "code() -> int => 0\n\nneeds(port: int) -> int => port\n")
    put(dir, "modules/quiet.maca", "helper() -> int => 0\n")

    absent = said_err(dir, ["-m", "nosuch.thing"])
    assert(absent.contains("no module `nosuch/thing`"), "names it: {absent}")
    assert(absent.contains("nosuch/thing.maca"), "and where it looked: {absent}")

    gone = said_err(dir, ["-m", "status.missing"])
    assert(gone.contains("no function `missing`"), "names the function: {gone}")

    arity = said_err(dir, ["-m", "status.needs"])
    assert(arity.contains("port: int"), "names the signature: {arity}")
    assert(arity.contains("one `str[]`"), "says what would work: {arity}")

    quiet = said_err(dir, ["-m", "quiet"])
    assert(quiet.contains("no `main`"), "says what is missing: {quiet}")
    assert(quiet.contains("maca -m quiet.something"), "suggests it: {quiet}")
}

test_the_generated_entry_leaves_nothing_behind() {
    dir = project("clean")
    put(dir, "modules/http.maca", "serve() -> int => 0\n")

    assert_eq(str(exit_code(dir, ["-m", "http.serve"])), "0", "the module runs")
    assert_eq(list_dir(dir).join(" "), ".maca maca.toml modules",
              "the run left no source and no binary in the project")
    assert_eq(str(list_dir(dir + "/.maca").length()), "0",
              "and the generated entry did not survive the run")
}
