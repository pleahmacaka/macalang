import maca/token
import maca/lexer

count_of(src: str) -> str =>
    str(lex(src).length())

text_at(src: str, i: int) -> str =>
    lex(src).get(i).text

Escaped = "\"a\\\"b\""

test_a_string_holds_an_escaped_quote_without_ending() {
    assert_eq(count_of(Escaped), "5",
              "one string token and the Eof run, not a string cut in half")
    assert_eq(text_at(Escaped, 0), "a\\\"b",
              "the escape stays in the text, so it re-emits as it was written")
}

test_a_plain_string_still_ends_at_its_quote() {
    assert_eq(count_of("\"ab\""), "5", "one string and the Eof run")
    assert_eq(text_at("\"ab\"", 0), "ab", "no escapes to keep")
}

test_a_line_comment_is_skipped() {
    assert_eq(count_of("// a note\nx"), "5",
              "the note is trivia, leaving the name and the Eof run")
    assert_eq(text_at("// a note\nx", 0), "x", "the name after the note")
}

test_a_comment_may_end_the_file() {
    assert_eq(count_of("x // trailing"), "5", "the name and the Eof run")
}

test_a_lone_slash_is_still_division() {
    assert_eq(count_of("a / b"), "7", "name, slash, name, Eof run")
    assert_eq(text_at("a / b", 1), "/", "the operator survives")
}

test_the_blurb_line_of_this_package_lexes() {
    assert_eq(count_of("// maca/ast: the compiler's own tree.\nimport maca/token"),
              "8", "the comment goes, the import statement stays")
}

errors_of(src: str) -> str[] =>
    lex_all(src).errors

test_a_clean_source_reports_nothing() {
    assert_eq(str(errors_of("f(x: int) -> int => x + 1").length()), "0",
              "nothing to say about valid source")
}

test_an_unknown_character_is_reported_not_swallowed() {
    bad = errors_of("a # b")
    assert_eq(str(bad.length()), "1", "the `#` has no token kind")
    assert_eq(bad.get(0), "unexpected character `#` at 2",
              "and the message says which character and where")
}

test_an_unterminated_string_is_reported() {
    bad = errors_of("\"abc")
    assert_eq(str(bad.length()), "1", "the quote never closes")
    assert_eq(bad.get(0), "unterminated string", "said plainly")
}

widened(s: str, n: int) -> str {
    if n <= 0 {
        s
    } else {
        widened(s ++ s, n - 1)
    }
}

test_a_source_far_larger_than_a_stack_frame_run_still_lexes() {
    assert_eq(count_of(widened(" ", 17)), "4",
              "131072 chars of trivia, and the Eof run is all that comes back")
}

test_the_tokens_still_come_back_beside_the_errors() {
    both = lex_all("a # b")
    assert_eq(str(both.tokens.length()), "7",
              "name, the unknown character, name, Eof run: recovery keeps going")
    assert_eq(str(both.errors.length()), "1", "and the problem is recorded")
}
