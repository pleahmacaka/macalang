import maca/lexer
import maca/parser
import maca/check
import maca/emit_rust

ra_rust(src: str) -> str =>
    remit_module(annotated(parse_module(lex(src), 0, [])))

RaRecord = "R = {{ n: int }} f(xs: R[]) -> int => xs.get(0).n"

RaStr = "g(xs: str[]) -> str => xs.get(0)"

RaFloat = "h(xs: float[]) -> float => xs.get(0)"

RaInt = "k(xs: int[]) -> int => xs.get(0)"

RaNode = "Node = {{ kids: Node[], n: int }}"

RaSum = "Color = Red | Green  p(cs: Color[]) -> int => 1"

RaJoin = "j(xs: str[]) -> str => xs.join(\", \")"

RaChars = "c(s: str) -> str => s.chars().join(\"\")"

RaMap = "u(s: str) -> str => s.upper()"
    ++ "  m(xs: str[]) -> str => xs.map(u).join(\", \")"

RaPred = "p(c: str) -> bool =>"
    ++ " c.is_whitespace() || c.is_ascii_digit() || c.is_alpha()"

RaFind = "q(s: str, t: str) -> bool => s.contains(t) && s.ends_with(t)"

test_a_record_element_is_the_record_and_not_an_int() {
    assert(ra_rust(RaRecord).index_of("xs: Rc<Vec<R>>") >= 0,
           "a list of records is a Vec of that record")
    assert(ra_rust(RaRecord).index_of("Vec<i64>") < 0,
           "never the i64 fallback")
}

test_a_string_element_is_a_string() {
    assert(ra_rust(RaStr).index_of("xs: Rc<Vec<String>>") >= 0,
           "str[] carries Strings")
}

test_a_float_element_is_an_f64() {
    assert(ra_rust(RaFloat).index_of("xs: Rc<Vec<f64>>") >= 0,
           "float[] carries f64")
}

test_an_int_element_is_still_an_i64() {
    assert(ra_rust(RaInt).index_of("xs: Rc<Vec<i64>>") >= 0,
           "int[] is what it always was")
}

test_a_sum_element_is_the_enum() {
    assert(ra_rust(RaSum).index_of("cs: Rc<Vec<Color>>") >= 0,
           "a list of variants is a Vec of the enum")
}

test_a_list_is_counted_rather_than_copied_when_it_is_passed() {
    assert(ra_rust(RaInt).index_of("Rc<Vec<i64>>") >= 0,
           "a parameter is owned, so a plain Vec would deep copy at every call")
    assert(ra_rust(RaInt).index_of("use std::rc::Rc;") >= 0,
           "and the count needs the import that names it")
}

test_a_nested_array_nests_the_vector() {
    assert_eq(rtype("int[][]"), "Rc<Vec<Rc<Vec<i64>>>>", "the element recurses")
    assert_eq(rtype("str[][]"), "Rc<Vec<Rc<Vec<String>>>>",
              "and it recurses again")
    assert_eq(relem("R[]"), "R", "the element of R[] is R")
    assert_eq(rtype("[]"), "Rc<Vec<i64>>", "an unsolved element stays i64")
}

test_a_record_field_of_its_own_type_keeps_that_type() {
    assert(ra_rust(RaNode).index_of("kids: Rc<Vec<Node>>") >= 0,
           "a self-referential field is a Vec of the record")
}

test_a_cell_that_is_not_copy_is_cloned() {
    assert(ra_rust(RaStr).index_of("as usize].clone()") >= 0,
           "a String cannot be moved out of a Vec index")
    assert(ra_rust(RaInt).index_of("as usize].clone()") < 0,
           "an i64 is Copy, so the cell is read in place")
}

test_a_record_is_comparable_so_a_list_can_be_searched() {
    assert(ra_rust(RaRecord).index_of("#[derive(Clone, PartialEq)]") >= 0,
           "index_of compares cells, so an element derives PartialEq")
}

test_a_join_separator_is_a_slice() {
    assert(ra_rust(RaJoin).index_of(".as_str())") >= 0,
           "a Vec<String> joins on a &str, never on a &String")
}

test_chars_is_a_vector_of_one_character_strings() {
    assert(ra_rust(RaChars).index_of("collect::<Vec<String>>()") >= 0,
           "chars() collects, so the result is indexable and joinable")
    assert(ra_rust(RaChars).index_of("s.chars()") < 0,
           "never a bare Chars iterator, which joins nothing")
}

test_map_over_a_list_goes_through_an_iterator() {
    assert(ra_rust(RaMap).index_of(".iter().cloned().map(u)") >= 0,
           "Rust has map on an iterator, not on a Vec")
    assert(ra_rust(RaMap).index_of("collect::<Vec<_>>()") >= 0,
           "and the result is collected back into a Vec")
}

test_upper_is_the_rust_spelling() {
    assert(ra_rust(RaMap).index_of(".to_uppercase()") >= 0,
           "upper() is to_uppercase()")
}

test_a_character_class_reads_the_first_character() {
    out = ra_rust(RaPred)

    assert(out.index_of("chars().next().map_or(false, |c| c.is_whitespace())")
           >= 0, "a one-character str tests its only char")
    assert(out.index_of("|c| c.is_ascii_digit()") >= 0,
           "is_ascii_digit is spelled the same on a char")
    assert(out.index_of("|c| c.is_ascii_alphabetic()") >= 0,
           "is_alpha is is_ascii_alphabetic, which Rust has")
}

test_a_search_argument_is_a_pattern() {
    assert(ra_rust(RaFind).index_of(".contains(t.clone().as_str())") >= 0,
           "contains takes a &str pattern, never a String")
    assert(ra_rust(RaFind).index_of(".ends_with(t.clone().as_str())") >= 0,
           "and so does ends_with")
}

test_a_function_parameter_is_a_rust_function_pointer() {
    assert_eq(rtype("(str) -> int"), "fn(String) -> i64",
              "one parameter and a result")
    assert_eq(rtype("(int, str) -> bool"), "fn(i64, String) -> bool",
              "two parameters keep their order")
    assert_eq(rtype("(str) -> int[]"), "fn(String) -> Rc<Vec<i64>>",
              "a list result is still a list")
}

test_a_plain_type_is_untouched_by_the_function_case() {
    assert_eq(rtype("str"), "String", "no arrow, no change")
    assert_eq(rtype("int[]"), "Rc<Vec<i64>>", "nor for a list")
}

test_a_constant_takes_a_borrowed_string_not_an_owned_one() {
    out = remit_module(annotated(parse_module(lex("Name = \"m\""), 0, [])))

    assert(out.index_of("const Name: &str = \"m\";") >= 0,
           "String is not constructible in a const, &str is")
}

test_an_element_builds_the_same_html_in_rust() {
    out = ra_rust("shell(body: str) -> str => div(class=\"wrap\", body)")

    assert(out.index_of("maca_element(\"div\".to_string()") >= 0,
           "both back ends reach the same element through the same call")
    assert(out.index_of("maca_attr(\"class\".to_string()") >= 0,
           "and write the attribute the same way")
    assert(out.index_of("fn maca_element(tag: String") >= 0,
           "the call needs the definition, which Rust has no runtime for")
}

test_an_if_with_no_else_is_a_statement_not_a_value() {
    out = ra_rust("f(n: int) -> int {{ c = 0 if n > 0 {{ c = 1 }} c }}")

    assert(out.index_of("if (n > 0i64) {{") >= 0,
           "Rust has a statement if, so no branch needs inventing")
    assert(out.index_of("?") < 0,
           "`?` is the marker for a missing else, never something to emit")
}

test_an_assertion_is_the_runtime_call_and_not_the_macro() {
    out = ra_rust("t() -> int {{ assert_eq(\"a\", \"a\", \"same\") 0 }}")

    assert(out.index_of("maca_assert_eq(") >= 0,
           "`assert_eq!` is a macro in Rust, so the call needs its own name")
    assert(out.index_of("fn maca_assert_eq(got: String") >= 0,
           "and the preamble defines what the call reaches")
}

test_a_string_search_takes_a_pattern_not_a_string() {
    out = ra_rust("f(s: str, p: str) -> bool => s.starts_with(p)")
    cut = ra_rust("f(s: str) -> str[] => s.split(\",\")")

    assert(out.index_of(".starts_with(p.clone().as_str())") >= 0,
           "a String is not a Pattern, and every search wants one")
    assert(cut.index_of("Rc::new((s.clone()).split(") >= 0,
           "a split hands back a counted list like any other")
}

test_a_map_is_an_ordered_table_so_a_run_repeats() {
    out = ra_rust("T = {{ opts: Map str int }} f(t: T) -> int => 0")

    assert(out.index_of("Rc<std::collections::BTreeMap<String, i64>>") >= 0,
           "a hash order would make two runs of the compiler disagree")
}

test_an_empty_list_leaves_its_element_type_to_be_inferred() {
    out = ra_rust("f() -> int[] => []")

    assert(out.index_of("Rc::new(vec![])") >= 0,
           "the checker leaves an empty list open, so pinning it named i64"
               ++ " where a Vec<Ty> was wanted")
}

test_a_function_with_no_declared_return_takes_the_type_of_its_tail() {
    out = ra_rust("t() {{ assert_eq(\"a\", \"a\", \"m\") }}")

    assert(out.index_of("-> bool") >= 0,
           "the tail is what the function hands back, and i64 is not it")
}

test_a_program_that_calls_nothing_foreign_emits_no_unsafe() {
    out = ra_rust("R = {{ n: int }} f(xs: R[]) -> int => xs.get(0).n"
                  ++ " g(s: str) -> str => s.upper()"
                  ++ " h(m: Map str int) -> int => m.get(\"k\")")

    assert(out.index_of("unsafe") < 0,
           "Maca has no raw pointer and no transmute, so nothing needs it")
}

test_a_foreign_call_keeps_its_unsafe_in_one_wrapper() {
    out = ra_rust("now_parts() -> int\nuse() -> int => now_parts()")

    assert(out.index_of("fn now_parts() -> i64 {{ unsafe {{"
                        ++ " now_parts_raw() }} }}") >= 0,
           "Rust cannot cross the C ABI safely, so the block is the boundary")
    assert(out.index_of("unsafe {{ now_parts_raw() }} }} }}") < 0,
           "and the call site stays outside it")
}

test_a_raise_is_a_panic() {
    out = remit_fn(parse_fn(lex("f() -> int {{ fail \"gone\" }}"), 0).snode)

    assert(out.index_of("panic!") >= 0, "a raise diverges, so it fits any type")
}
