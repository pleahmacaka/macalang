import std/proc
import std/text

scratch() -> str =>
    env_or("TMPDIR", "/tmp") ++ "/maca-cli-tooling"

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

fixture(name: str, src: str) -> str {
    dir = scratch()
    make_dir(dir)
    at = dir ++ "/" ++ name
    write_file(at, src)

    at
}

package_dir(tag: str) -> str {
    dir = scratch() ++ "/" ++ tag
    remove_dir(dir)
    make_dir(dir)

    dir
}

out_in(dir: str, args: str[]) -> str {
    bin = maca_bin()
    back = cwd()
    chdir(dir)
    got = capture(bin, args)
    chdir(back)

    got
}

err_in(dir: str, args: str[]) -> str {
    bin = maca_bin()
    back = cwd()
    chdir(dir)
    got = capture_err(bin, args)
    chdir(back)

    got
}

rc_in(dir: str, args: str[]) -> int {
    bin = maca_bin()
    back = cwd()
    chdir(dir)
    rc = exec(bin, args)
    chdir(back)

    rc
}

repeated(word: str, n: int, acc: str[]) -> str[] {
    if n <= 0 {
        acc
    } else {
        repeated(word, n - 1, acc.push(word))
    }
}

lint_says(name: str, src: str) -> str =>
    capture(maca_bin(), ["lint", fixture(name, src)])

lint_rc(name: str, src: str) -> int =>
    exec(maca_bin(), ["lint", fixture(name, src)])

test_lint_flags_a_line_past_eighty_columns() {
    src = "total = " ++ repeated("value", 20, []).join(" + ") ++ "\n"

    said = lint_says("wide.maca", src)
    assert(said.contains("80 columns"), "the rule names the width: {said}")
    assert_eq(str(lint_rc("wide.maca", src)), "1",
              "a seeded issue is a failing exit status")
}

test_lint_does_not_flag_a_long_string_literal() {
    src = "x = \"" ++ repeated("a", 200, []).join("") ++ "\"\n"

    assert_eq(str(lint_rc("literal.maca", src)), "0",
              "a long string literal is not a long line")
}

test_lint_does_not_flag_an_else_if_chain() {
    src = "pick(n: int) -> str {{\n    if n > 1 {{\n        \"many\"\n"
        ++ "    }} else if n == 1 {{\n        \"one\"\n"
        ++ "    }} else {{\n        \"none\"\n    }}\n}}\n"

    assert_eq(str(lint_rc("chain.maca", src)), "0",
              "an else-if chain is the house style, not a violation")
}

test_lint_resolves_imports_before_calling_a_name_undefined() {
    src = "import std/path\n\nmain() -> int {{\n"
        ++ "    info(join(\"a\", \"b\"))\n    0\n}}\n"

    said = lint_says("import.maca", src)
    assert(!said.contains("UndefinedName"), "join comes from std/path: {said}")
}

test_fmt_settles_on_the_second_run_and_keeps_what_it_read() {
    at = fixture("shape.maca", read_file("apps/examples/taskr.maca"))

    exec(maca_bin(), ["fmt", at])
    once = read_file(at)
    exec(maca_bin(), ["fmt", at])

    assert_eq(read_file(at), once,
              "a formatter that moves on the second run is a bug")
    assert(once.contains("\n    "), "a block body is written one indent in")
    assert(once.contains(" {{\n"), "and the brace that opens it ends a line")
    assert(once.contains("import std/json"), "an import is not a thing to drop")
    assert(once.contains("match t.status {{"), "and neither is a match")
}

fixed(name: str, src: str) -> str {
    at = fixture(name, src)
    exec(maca_bin(), ["fix", at])

    read_file(at)
}

test_fix_deletes_a_keyword_maca_has_no_word_for() {
    got = fixed("phantom.maca",
                "async fn main() -> int {{\n    let x = 1\n    x\n}}\n")

    assert_eq(got, "main() -> int {{\n    x = 1\n    x\n}}\n",
              "the phantom keyword goes and the binding stays")
}

test_fix_leaves_a_field_that_is_spelled_like_one_alone() {
    src = "Row = {{ type: str }}\n\nname(r: Row) -> str {{\n"
        ++ "    who = r.type\n    who\n}}\n"

    assert_eq(fixed("field.maca", src), src,
              "`type` after a dot is a field, not a keyword from elsewhere")
}

test_fix_reads_a_word_in_a_string_as_a_string() {
    src = "main() -> int {{\n    info(\"let it be\")\n    0\n}}\n"

    assert_eq(fixed("quoted.maca", src), src,
              "the fixer edits tokens, so a literal is never one")
}

test_fix_says_what_it_would_do_without_doing_it() {
    at = fixture("dry.maca", "main() -> int {{\n    let x = 1\n    x\n}}\n")
    said = capture(maca_bin(), ["fix", "--dry-run", at])

    assert(said.contains("would delete 1"), "it counts what it found: {said}")
    assert(read_file(at).contains("let x"), "and left the file alone")
}

test_a_script_alias_runs_the_line_that_table_gives_it() {
    dir = package_dir("script")
    write_file(dir ++ "/maca.toml", "[scripts]\ngo = \"echo maca-script-ok\"\n")

    assert_eq(out_in(dir, ["go"]).trim(), "maca-script-ok",
              "a [scripts] name is a command of its own")
}

test_a_library_with_no_bin_is_told_so_rather_than_building_the_roots() {
    dir = package_dir("library")
    write_file(dir ++ "/maca.toml", "[package]\nname = \"greet\"\n")
    write_file(dir ++ "/say.maca", "greeting(who: str) -> str => \"hi \" ++ who\n")

    said = err_in(dir, ["build"])
    assert(said.contains("greet"), "the message names the package: {said}")
    assert(said.contains("[[bin]]"), "and what it lacks: {said}")
    assert_eq(str(rc_in(dir, ["build"])), "2", "there is nothing to build")
}

two_binaries(tag: str, declared: str) -> str {
    dir = package_dir(tag)
    write_file(dir ++ "/main.maca", "main() -> int => 0\n")
    write_file(dir ++ "/other.maca", "main() -> int => 3\n")
    write_file(dir ++ "/maca.toml",
        "[package]\nname = \"hello\"\n\n" ++ declared
            ++ "[[bin]]\nname = \"hello\"\npath = \"main.maca\"\n\n"
            ++ "[[bin]]\nname = \"other\"\npath = \"other.maca\"\n")

    dir
}

test_two_binaries_need_the_one_to_build_naming() {
    dir = two_binaries("choose", "")

    said = err_in(dir, ["build"])
    assert(said.contains("hello") && said.contains("other"),
           "the message lists the names to choose from: {said}")
    assert_eq(str(rc_in(dir, ["build"])), "2", "which one was meant")
}

test_the_binary_a_package_builds_by_default_can_be_declared() {
    dir = two_binaries("default-bin", "[build]\nbin = \"other\"\n\n")

    assert_eq(str(rc_in(dir, ["build"])), "0", "a declared bin needs no flag")
    assert(file_exists(dir ++ "/other"), "the declared binary is the one built")
    assert(!file_exists(dir ++ "/main"), "and the one it did not name was not")
}

test_the_version_the_binary_reports_is_the_one_the_manifest_declares() {
    declared = between(read_file("maca.toml"), "version = \"", "\"")

    assert_eq(capture(maca_bin(), ["--version"]).trim(), "maca {declared}",
              "the binary reports the version its own manifest states")
}

test_dev_without_a_dev_file_shows_the_starter_it_wants() {
    dir = scratch() ++ "/starter"

    make_dir(dir)
    here = cwd()
    chdir(dir)
    said = capture_err(maca_bin(), ["dev"]) ++ capture(maca_bin(), ["dev"])
    code = exec(maca_bin(), ["dev"])

    chdir(here)
    assert(code != 0, "there is no dev.maca here, so it cannot succeed")
    assert(said.contains("dev.packages"),
           "the message carries a starter the reader can paste: {said}")
}

/// A root that gathers a library and an application, the way this repository does.
monorepo(tag: str) -> str {
    dir = package_dir(tag)

    make_dir(dir ++ "/modules/greet")
    make_dir(dir ++ "/apps/hello")
    write_file(dir ++ "/maca.toml",
        "[package]\nname = \"repo\"\n\n[workspace]\nmembers = [\n"
            ++ "    \"modules/greet\",\n    \"apps/hello\",\n]\n\n"
            ++ "[scripts]\ngo = \"echo workspace-script-ok\"\n")
    write_file(dir ++ "/modules/greet/maca.toml",
               "[package]\nname = \"greet\"\n")
    write_file(dir ++ "/modules/greet/say.maca",
               "greeting(who: str) -> str => \"hi \" ++ who\n")
    write_file(dir ++ "/apps/hello/maca.toml",
        "[package]\nname = \"hello\"\n\n[[bin]]\nname = \"hello\"\n"
            ++ "path = \"main.maca\"\n")
    write_file(dir ++ "/apps/hello/main.maca",
        "import greet/say\n\nmain() -> int {{\n"
            ++ "    info(greeting(\"world\"))\n    0\n}}\n")

    dir
}

test_a_package_builds_and_runs_from_its_own_directory() {
    at = monorepo("ws-run") ++ "/apps/hello"

    assert_eq(str(rc_in(at, ["build"])), "0", "a bare build inside a member")
    assert(file_exists(at ++ "/main"), "the [[bin]] it declares was built")
    assert_eq(out_in(at, ["run"]).trim(), "hi world",
              "and its imports still reach the roots above its own manifest")
}

test_a_root_key_the_member_is_silent_about_is_inherited() {
    at = monorepo("ws-script") ++ "/apps/hello"

    assert_eq(out_in(at, ["go"]).trim(), "workspace-script-ok",
              "the nearest manifest that states a key answers for it")
}

test_a_member_that_is_listed_but_absent_is_named() {
    dir = monorepo("ws-ghost")

    write_file(dir ++ "/maca.toml",
        "[package]\nname = \"repo\"\n\n[workspace]\n"
            ++ "members = [\"modules/greet\", \"apps/ghost\"]\n")
    said = err_in(dir ++ "/apps/hello", ["build"])

    assert(said.contains("apps/ghost"), "a listed member exists: {said}")
}

test_a_member_without_a_package_name_is_named() {
    dir = monorepo("ws-nameless")

    write_file(dir ++ "/apps/hello/maca.toml",
               "[[bin]]\npath = \"main.maca\"\n")
    said = err_in(dir, ["build", "apps/hello/main.maca"])

    assert(said.contains("apps/hello") && said.contains("name"),
           "the message names the manifest and the key: {said}")
}

test_a_stray_directory_does_not_become_a_package() {
    dir = monorepo("ws-stray")

    make_dir(dir ++ "/apps/notes")
    write_file(dir ++ "/apps/notes/jot.maca", "main() -> int => 0\n")

    assert_eq(str(rc_in(dir ++ "/apps/hello", ["build"])), "0",
              "a directory with no maca.toml is not a member")
}

test_a_package_the_workspace_does_not_list_is_named() {
    dir = monorepo("ws-undeclared")

    make_dir(dir ++ "/apps/scratch")
    write_file(dir ++ "/apps/scratch/maca.toml",
               "[package]\nname = \"scratch\"\n")
    said = err_in(dir ++ "/apps/hello", ["build"])

    assert(said.contains("apps/scratch"),
           "the list and the tree must agree: {said}")
}

test_a_member_may_not_declare_a_workspace_of_its_own() {
    dir = monorepo("ws-nested")

    write_file(dir ++ "/apps/hello/maca.toml",
        "[package]\nname = \"hello\"\n\n[workspace]\nmembers = []\n\n"
            ++ "[[bin]]\nname = \"hello\"\npath = \"main.maca\"\n")
    said = err_in(dir ++ "/apps/hello", ["build"])

    assert(said.contains("[workspace]"), "one workspace per tree: {said}")
}
