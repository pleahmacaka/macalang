import std/proc
import std/text

scratch() -> str =>
    env_or("TMPDIR", "/tmp") ++ "/maca-cli-tooling"

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

fixture(name: str, src: str) -> str {
    dir = scratch()
    make_dir(dir)
    at = dir ++ "/" ++ name
    write_file(at, src)

    at
}

package_dir(tag: str) -> str {
    dir = scratch() ++ "/" ++ tag
    remove_dir(dir)
    make_dir(dir)

    dir
}

out_in(dir: str, args: str[]) -> str {
    bin = maca_bin()
    back = cwd()
    chdir(dir)
    got = capture(bin, args)
    chdir(back)

    got
}

err_in(dir: str, args: str[]) -> str {
    bin = maca_bin()
    back = cwd()
    chdir(dir)
    got = capture_err(bin, args)
    chdir(back)

    got
}

rc_in(dir: str, args: str[]) -> int {
    bin = maca_bin()
    back = cwd()
    chdir(dir)
    rc = exec(bin, args)
    chdir(back)

    rc
}

repeated(word: str, n: int, acc: str[]) -> str[] {
    if n <= 0 {
        acc
    } else {
        repeated(word, n - 1, acc.push(word))
    }
}

lint_says(name: str, src: str) -> str =>
    capture(maca_bin(), ["lint", fixture(name, src)])

lint_rc(name: str, src: str) -> int =>
    exec(maca_bin(), ["lint", fixture(name, src)])

test_lint_flags_a_line_past_eighty_columns() {
    src = "total = " ++ repeated("value", 20, []).join(" + ") ++ "\n"

    said = lint_says("wide.maca", src)
    assert(said.contains("80 columns"), "the rule names the width: {said}")
    assert_eq(str(lint_rc("wide.maca", src)), "1",
              "a seeded issue is a failing exit status")
}

test_lint_does_not_flag_a_long_string_literal() {
    src = "x = \"" ++ repeated("a", 200, []).join("") ++ "\"\n"

    assert_eq(str(lint_rc("literal.maca", src)), "0",
              "a long string literal is not a long line")
}

test_lint_does_not_flag_an_else_if_chain() {
    src = "pick(n: int) -> str {{\n    if n > 1 {{\n        \"many\"\n"
        ++ "    }} else if n == 1 {{\n        \"one\"\n"
        ++ "    }} else {{\n        \"none\"\n    }}\n}}\n"

    assert_eq(str(lint_rc("chain.maca", src)), "0",
              "an else-if chain is the house style, not a violation")
}

test_lint_resolves_imports_before_calling_a_name_undefined() {
    src = "import std/path\n\nmain() -> int {{\n"
        ++ "    info(join(\"a\", \"b\"))\n    0\n}}\n"

    said = lint_says("import.maca", src)
    assert(!said.contains("UndefinedName"), "join comes from std/path: {said}")
}

test_lint_names_the_rule_and_the_line_of_everything_it_flags() {
    src = "main() -> int {{\n    if x > 0 {{ x = 2 }}\n\ty = 3\n"
        ++ "    z = 4   \n    w = "
        ++ repeated("value", 20, []).join(" + ") ++ "\n    0\n}}\n"

    said = lint_says("rules.maca", src)
    assert(said.contains("rules.maca:2: single-line `if` block"),
           "a body written on the line that opens it: {said}")
    assert(said.contains("rules.maca:3: hard tab"),
           "an indent is four spaces: {said}")
    assert(said.contains("rules.maca:4: trailing whitespace"),
           "a line does not end in a space: {said}")
    assert(said.contains("rules.maca:5: line exceeds 80 columns"),
           "and the width rule reads the fifth line: {said}")
    assert(said.contains("4 issues"),
           "four rules fired, so four is the count: {said}")
}

test_lint_calls_a_file_that_nothing_fires_on_clean() {
    src = "main() -> int {{\n    0\n}}\n"

    assert_eq(str(lint_rc("clean.maca", src)), "0",
              "a file with nothing wrong is a passing exit status")
    assert(lint_says("clean.maca", src).contains("clean"),
           "and the word the reader looks for")
}

test_the_single_line_if_rule_reads_code_and_not_prose() {
    src = "// a comment naming `if x {{ y }}` inline\n"
        ++ "pick(c: bool) -> int => c ? 1 : 2\n"
        ++ "has(s: str) -> bool => s.contains(\"if \")\n"

    assert_eq(str(lint_rc("exempt.maca", src)), "0",
              "a ternary, a comment and a string are none of them a block")
}

test_the_width_rule_measures_code_once_the_strings_are_gone() {
    wide = "main() -> int {{\n    a = 1" ++ repeated(" ", 70, []).join("")
        ++ "+ 2 + 3 + 4 + \"s\"\n    0\n}}\n"

    assert_eq(str(lint_rc("widecode.maca", wide)), "1",
              "the code alone is past eighty columns")
}

test_the_repository_passes_its_own_linter() {
    assert_eq(exec(maca_bin(), ["run", "apps/lint/lint.maca"]), 0,
              "Maca lints Maca, and this tree is what it lints")
}

test_fmt_settles_on_the_second_run_and_keeps_what_it_read() {
    at = fixture("shape.maca", read_file("apps/examples/taskr.maca"))

    exec(maca_bin(), ["fmt", at])
    once = read_file(at)
    exec(maca_bin(), ["fmt", at])

    assert_eq(read_file(at), once,
              "a formatter that moves on the second run is a bug")
    assert(once.contains("\n    "), "a block body is written one indent in")
    assert(once.contains(" {{\n"), "and the brace that opens it ends a line")
    assert(once.contains("import std/json"), "an import is not a thing to drop")
    assert(once.contains("match t.status {{"), "and neither is a match")
}

fixed(name: str, src: str) -> str {
    at = fixture(name, src)
    exec(maca_bin(), ["fix", at])

    read_file(at)
}

test_fix_deletes_a_keyword_maca_has_no_word_for() {
    got = fixed("phantom.maca",
                "async fn main() -> int {{\n    let x = 1\n    x\n}}\n")

    assert_eq(got, "main() -> int {{\n    x = 1\n    x\n}}\n",
              "the phantom keyword goes and the binding stays")
}

test_fix_leaves_a_field_that_is_spelled_like_one_alone() {
    src = "Row = {{ type: str }}\n\nname(r: Row) -> str {{\n"
        ++ "    who = r.type\n    who\n}}\n"

    assert_eq(fixed("field.maca", src), src,
              "`type` after a dot is a field, not a keyword from elsewhere")
}

test_fix_reads_a_word_in_a_string_as_a_string() {
    src = "main() -> int {{\n    info(\"let it be\")\n    0\n}}\n"

    assert_eq(fixed("quoted.maca", src), src,
              "the fixer edits tokens, so a literal is never one")
}

test_fix_says_what_it_would_do_without_doing_it() {
    at = fixture("dry.maca", "main() -> int {{\n    let x = 1\n    x\n}}\n")
    said = capture(maca_bin(), ["fix", "--dry-run", at])

    assert(said.contains("would delete 1"), "it counts what it found: {said}")
    assert(read_file(at).contains("let x"), "and left the file alone")
}

test_a_script_alias_runs_the_line_that_table_gives_it() {
    dir = package_dir("script")
    write_file(dir ++ "/maca.toml", "[scripts]\ngo = \"echo maca-script-ok\"\n")

    assert_eq(out_in(dir, ["go"]).trim(), "maca-script-ok",
              "a [scripts] name is a command of its own")
}

test_a_library_with_no_bin_is_told_so_rather_than_building_the_roots() {
    dir = package_dir("library")
    write_file(dir ++ "/maca.toml", "[package]\nname = \"greet\"\n")
    write_file(dir ++ "/say.maca", "greeting(who: str) -> str => \"hi \" ++ who\n")

    said = err_in(dir, ["build"])
    assert(said.contains("greet"), "the message names the package: {said}")
    assert(said.contains("[[bin]]"), "and what it lacks: {said}")
    assert_eq(str(rc_in(dir, ["build"])), "2", "there is nothing to build")
}

two_binaries(tag: str, declared: str) -> str {
    dir = package_dir(tag)
    write_file(dir ++ "/main.maca", "main() -> int => 0\n")
    write_file(dir ++ "/other.maca", "main() -> int => 3\n")
    write_file(dir ++ "/maca.toml",
        "[package]\nname = \"hello\"\n\n" ++ declared
            ++ "[[bin]]\nname = \"hello\"\npath = \"main.maca\"\n\n"
            ++ "[[bin]]\nname = \"other\"\npath = \"other.maca\"\n")

    dir
}

test_two_binaries_need_the_one_to_build_naming() {
    dir = two_binaries("choose", "")

    said = err_in(dir, ["build"])
    assert(said.contains("hello") && said.contains("other"),
           "the message lists the names to choose from: {said}")
    assert_eq(str(rc_in(dir, ["build"])), "2", "which one was meant")
}

test_the_binary_a_package_builds_by_default_can_be_declared() {
    dir = two_binaries("default-bin", "[build]\nbin = \"other\"\n\n")

    assert_eq(str(rc_in(dir, ["build"])), "0", "a declared bin needs no flag")
    assert(file_exists(dir ++ "/other"), "the declared binary is the one built")
    assert(!file_exists(dir ++ "/main"), "and the one it did not name was not")
}

test_the_version_the_binary_reports_is_the_one_the_manifest_declares() {
    declared = between(read_file("maca.toml"), "version = \"", "\"")

    assert_eq(capture(maca_bin(), ["--version"]).trim(), "maca {declared}",
              "the binary reports the version its own manifest states")
}

test_dev_without_a_dev_file_shows_the_starter_it_wants() {
    dir = scratch() ++ "/starter"

    make_dir(dir)
    here = cwd()
    chdir(dir)
    said = capture_err(maca_bin(), ["dev"]) ++ capture(maca_bin(), ["dev"])
    code = exec(maca_bin(), ["dev"])

    chdir(here)
    assert(code != 0, "there is no dev.maca here, so it cannot succeed")
    assert(said.contains("dev.packages"),
           "the message carries a starter the reader can paste: {said}")
}

jdk_here() -> bool =>
    have("javac") && have("java")

/// The interface a Fabric mod implements, compiled where a classpath can name it.
jvm_stub(dir: str) -> bool {
    make_dir(dir ++ "/net/fabricmc/api")
    write_file(dir ++ "/net/fabricmc/api/ModInitializer.java",
        "package net.fabricmc.api;\n"
            ++ "public interface ModInitializer {{ void onInitialize(); }}\n")

    exec("javac", [dir ++ "/net/fabricmc/api/ModInitializer.java",
                   "-d", dir]) == 0
}

/// The Fabric mod this repository ships, which is what a JVM package looks like.
mcmod_source() -> str =>
    read_file(cwd() ++ "/apps/mcmod/mod.maca")

test_the_jvm_target_compiles_the_java_it_emits() {
    if jdk_here() {
        dir = package_dir("jvm-classes")

        write_file(dir ++ "/fibj.maca",
            "fib(n: int) -> int =>\n    n < 2 ? n : fib(n - 1) + fib(n - 2)\n"
                ++ "\nmain() -> int {{\n    info(\"{{fib(20)}}\")\n    0\n}}\n")

        assert_eq(str(rc_in(dir, ["build", "--target", "jvm", "fibj.maca",
                                  "-o", "out"])), "0", "the build ran")
        assert(file_exists(dir ++ "/out/Fibj.class"),
               "javac wrote the class the JVM loads, not only the Java")
        assert(capture("java", ["-cp", dir ++ "/out", "Fibj"]).contains("6765"),
               "and the class the source stem named is the one that runs")
    }
}

/// The jars a JVM package compiles against belong to the package, not to whoever types the command.
test_a_declared_classpath_reaches_the_java_compiler() {
    if jdk_here() {
        at = monorepo("ws-classpath") ++ "/apps/hello"

        assert(jvm_stub(at ++ "/stub"), "the interface the mod implements")
        write_file(at ++ "/maca.toml",
            "[package]\nname = \"hello\"\n\n[build]\ntarget = \"jvm\"\n"
                ++ "classpath = \"stub\"\nout = \"classes\"\n\n"
                ++ "[[bin]]\nname = \"hello\"\npath = \"mod.maca\"\n")
        write_file(at ++ "/mod.maca", mcmod_source())

        assert_eq(str(rc_in(at, ["build"])), "0", "the declared build ran")
        assert(file_exists(at ++ "/classes/Mod.class"),
               "javac needs the declared jars to resolve the interface")
    }
}

test_a_classpath_flag_names_the_jars_a_manifest_did_not() {
    if jdk_here() {
        dir = package_dir("jvm-cp-flag")

        src = cwd() ++ "/apps/mcmod/mod.maca"

        assert(jvm_stub(dir ++ "/stub"), "the interface the mod implements")
        assert_eq(str(rc_in(dir, ["build", "--target", "jvm", src,
                                  "-o", "out", "--cp", "stub"])), "0",
                  "the flag carried the jars")
        write_file(dir ++ "/out/Runner.java",
            "public class Runner {{ public static void main(String[] a) {{\n"
                ++ "  net.fabricmc.api.ModInitializer m ="
                ++ " new Mod.ExampleMod();\n  m.onInitialize();\n}} }}\n")

        cp = dir ++ "/stub:" ++ dir ++ "/out"

        assert_eq(str(exec("javac", ["-cp", cp, "-d", dir ++ "/out",
                                     dir ++ "/out/Runner.java"])), "0",
                  "the emitted class is a ModInitializer to javac")
        assert(capture("java", ["-cp", cp, "Runner"])
                   .contains("Maca-authored Fabric mod"),
               "and the interface method runs the body the mod wrote")
    }
}

/// A root that gathers a library and an application, the way this repository does.
monorepo(tag: str) -> str {
    dir = package_dir(tag)

    make_dir(dir ++ "/modules/greet")
    make_dir(dir ++ "/apps/hello")
    write_file(dir ++ "/maca.toml",
        "[package]\nname = \"repo\"\nversion = \"9.9.9\"\n\n"
            ++ "[workspace]\nmembers = [\n"
            ++ "    \"modules/greet\",\n    \"apps/hello\",\n]\n\n"
            ++ "[scripts]\ngo = \"echo workspace-script-ok\"\n")
    write_file(dir ++ "/modules/greet/maca.toml",
               "[package]\nname = \"greet\"\n")
    write_file(dir ++ "/modules/greet/say.maca",
               "greeting(who: str) -> str => \"hi \" ++ who\n")
    make_dir(dir ++ "/modules/greet/tests")
    write_file(dir ++ "/modules/greet/tests/say.maca",
        "import greet/say\n\ntest_the_name_is_the_one_greeted() {{\n"
            ++ "    assert_eq(greeting(\"ana\"), \"hi ana\", \"named\")\n}}\n")
    write_file(dir ++ "/apps/hello/maca.toml",
        "[package]\nname = \"hello\"\n\n[[bin]]\nname = \"hello\"\n"
            ++ "path = \"main.maca\"\n")
    write_file(dir ++ "/apps/hello/main.maca",
        "import greet/say\n\nmain() -> int {{\n"
            ++ "    info(greeting(\"world\"))\n    0\n}}\n")

    dir
}

test_a_package_builds_and_runs_from_its_own_directory() {
    at = monorepo("ws-run") ++ "/apps/hello"

    assert_eq(str(rc_in(at, ["build"])), "0", "a bare build inside a member")
    assert(file_exists(at ++ "/main"), "the [[bin]] it declares was built")
    assert_eq(out_in(at, ["run"]).trim(), "hi world",
              "and its imports still reach the roots above its own manifest")
}

test_a_root_key_the_member_is_silent_about_is_inherited() {
    at = monorepo("ws-script") ++ "/apps/hello"

    assert_eq(out_in(at, ["go"]).trim(), "workspace-script-ok",
              "the nearest manifest that states a key answers for it")
}

test_a_root_format_key_reaches_a_member_that_states_none() {
    dir = monorepo("ws-format-inherit")

    write_file(dir ++ "/maca.toml",
        "[package]\nname = \"repo\"\n\n[workspace]\n"
            ++ "members = [\"modules/greet\", \"apps/hello\"]\n\n"
            ++ "[format]\nindent_style = \"space\"\nindent_size = 8\n")
    write_file(dir ++ "/apps/hello/wide.maca", "main() -> int {{\n  0\n}}\n")

    assert_eq(str(rc_in(dir, ["fmt", "apps/hello/wide.maca"])), "0", "fmt ran")
    assert(read_file(dir ++ "/apps/hello/wide.maca").contains("\n        0\n"),
           "the eight the root declared reached a member that states none")
}

test_a_bare_test_runs_the_packages_own_suites() {
    at = monorepo("ws-bare-test") ++ "/modules/greet"

    said = out_in(at, ["test"])
    assert(said.contains("greet 9.9.9"),
           "the heading names the package and the version it takes: {said}")
    assert(said.contains("1 of 1 suites passed"),
           "the suite under tests/ is the one that ran: {said}")
    assert_eq(str(rc_in(at, ["test"])), "0", "and it passed")
}

test_a_member_that_is_listed_but_absent_is_named() {
    dir = monorepo("ws-ghost")

    write_file(dir ++ "/maca.toml",
        "[package]\nname = \"repo\"\n\n[workspace]\n"
            ++ "members = [\"modules/greet\", \"apps/ghost\"]\n")
    said = err_in(dir ++ "/apps/hello", ["build"])

    assert(said.contains("apps/ghost"), "a listed member exists: {said}")
}

test_a_member_without_a_package_name_is_named() {
    dir = monorepo("ws-nameless")

    write_file(dir ++ "/apps/hello/maca.toml",
               "[[bin]]\npath = \"main.maca\"\n")
    said = err_in(dir, ["build", "apps/hello/main.maca"])

    assert(said.contains("apps/hello") && said.contains("name"),
           "the message names the manifest and the key: {said}")
}

test_a_stray_directory_does_not_become_a_package() {
    dir = monorepo("ws-stray")

    make_dir(dir ++ "/apps/notes")
    write_file(dir ++ "/apps/notes/jot.maca", "main() -> int => 0\n")

    assert_eq(str(rc_in(dir ++ "/apps/hello", ["build"])), "0",
              "a directory with no maca.toml is not a member")
}

test_a_package_the_workspace_does_not_list_is_named() {
    dir = monorepo("ws-undeclared")

    make_dir(dir ++ "/apps/scratch")
    write_file(dir ++ "/apps/scratch/maca.toml",
               "[package]\nname = \"scratch\"\n")
    said = err_in(dir ++ "/apps/hello", ["build"])

    assert(said.contains("apps/scratch"),
           "the list and the tree must agree: {said}")
}

test_a_member_may_not_declare_a_workspace_of_its_own() {
    dir = monorepo("ws-nested")

    write_file(dir ++ "/apps/hello/maca.toml",
        "[package]\nname = \"hello\"\n\n[workspace]\nmembers = []\n\n"
            ++ "[[bin]]\nname = \"hello\"\npath = \"main.maca\"\n")
    said = err_in(dir ++ "/apps/hello", ["build"])

    assert(said.contains("[workspace]"), "one workspace per tree: {said}")
}

declared_build(tag: str, build: str) -> str {
    dir = package_dir(tag)
    write_file(dir ++ "/main.maca", "main() -> int => 0\n")
    write_file(dir ++ "/maca.toml",
        "[package]\nname = \"hello\"\n\n[[bin]]\nname = \"hello\"\n"
            ++ "path = \"main.maca\"\n\n[build]\n" ++ build)

    dir
}

test_the_target_a_package_builds_for_can_be_declared() {
    dir = declared_build("build-target", "target = \"js\"\n")

    assert_eq(str(rc_in(dir, ["build"])), "0", "a declared target needs no flag")
    assert(read_file(dir ++ "/main-web/app.js").contains("function"),
           "what landed is the JavaScript the manifest asked for")
    assert(file_exists(dir ++ "/main-web/index.html"),
           "and the page that carries it")
}

test_a_declared_rust_target_names_its_source_for_what_it_holds() {
    dir = declared_build("build-target-rust", "target = \"rust\"\n")

    assert_eq(str(rc_in(dir, ["build"])), "0", "a declared target needs no flag")
    assert(read_file(dir ++ "/main.rs").starts_with("use std::rc::Rc;"),
           "the rust back end writes rust, under a name that says so")
}

test_where_a_build_lands_can_be_declared() {
    dir = declared_build("build-out", "out = \"app\"\n")

    assert_eq(str(rc_in(dir, ["build"])), "0", "a declared out needs no flag")
    assert(file_exists(dir ++ "/app"), "the build landed where [build] out said")
    assert(!file_exists(dir ++ "/main"), "and not under the file's own stem")
}

test_a_flag_on_the_line_beats_what_the_manifest_declared() {
    dir = declared_build("build-flag", "out = \"app\"\n")

    assert_eq(str(rc_in(dir, ["build", "-o", "other"])), "0", "the flag ran")
    assert(file_exists(dir ++ "/other"), "the flag chose where it landed")
    assert(!file_exists(dir ++ "/app"), "so the declared name was not used")
}

test_a_misspelled_build_key_is_named_rather_than_ignored() {
    dir = declared_build("build-stray", "targt = \"js\"\n")

    said = err_in(dir, ["build"])
    assert(said.contains("targt"), "the message names the key: {said}")
    assert(said.contains("target"), "and the ones it knows: {said}")
    assert_eq(str(rc_in(dir, ["build"])), "2",
              "a key that does nothing is a typo")
}

package_of_suites(tag: str, second: str) -> str {
    dir = package_dir(tag)
    make_dir(dir ++ "/tests")
    write_file(dir ++ "/maca.toml", "[package]\nname = \"suited\"\n")
    write_file(dir ++ "/tests/a.maca",
               "test_one() \{\n    assert_eq(1, 1, \"one\")\n\}\n")
    write_file(dir ++ "/tests/b.maca", second)

    dir
}

passing_suite() -> str =>
    "test_two() \{\n    assert_eq(2, 2, \"two\")\n\}\n"

failing_suite() -> str =>
    "test_two() \{\n    assert_eq(2, 3, \"two\")\n\}\n"

test_every_suite_the_package_holds_runs_when_no_file_is_named() {
    dir = package_of_suites("suites-pass", passing_suite())

    said = out_in(dir, ["test"])
    assert(said.contains("2 of 2 suites passed"), "both suites ran: {said}")
    assert_eq(str(rc_in(dir, ["test"])), "0", "and both passed")
}

test_a_failing_suite_is_counted_among_the_ones_that_ran() {
    dir = package_of_suites("suites-fail", failing_suite())

    said = out_in(dir, ["test"])
    assert(said.contains("1 of 2 suites passed"),
           "one of the two failed: {said}")
    assert_eq(str(rc_in(dir, ["test"])), "1",
              "and the count is the exit status")
}

test_a_package_with_no_test_directory_is_told_so() {
    dir = package_dir("suites-none")
    write_file(dir ++ "/maca.toml", "[package]\nname = \"bare\"\n")

    said = err_in(dir, ["test"])
    assert(said.contains("no .maca suite"), "there is nothing to run: {said}")
    assert(said.contains("[package] tests"),
           "and where to say otherwise: {said}")
}

unformatted(dir: str, name: str) -> str {
    at = dir ++ "/" ++ name
    write_file(at, "main() -> int \{\n  info(\"x\")\n  0\n\}\n")

    at
}

test_fmt_reads_the_flag_wherever_it_is_on_the_line() {
    dir = package_dir("fmt-flag")
    at = unformatted(dir, "one.maca")

    assert_eq(str(rc_in(dir, ["fmt", "--check", "one.maca"])), "1",
              "the file after the flag is the one checked")
    assert(read_file(at).contains("\n  info"), "and --check wrote nothing")
}

test_fmt_formats_every_file_it_is_given() {
    dir = package_dir("fmt-many")
    one = unformatted(dir, "one.maca")
    two = unformatted(dir, "two.maca")

    assert_eq(str(rc_in(dir, ["fmt", "one.maca", "two.maca"])), "0", "both ran")
    assert(read_file(one).contains("\n    info"), "the first was formatted")
    assert(read_file(two).contains("\n    info"), "and so was the second")
}

test_a_named_binary_is_the_one_that_gets_built() {
    dir = two_binaries("ws-bin-flag", "")

    assert_eq(str(rc_in(dir, ["build", "--bin", "other"])), "0", "--bin ran")
    assert(file_exists(dir ++ "/other"), "the named binary is the one built")
    assert(!file_exists(dir ++ "/main"), "and the other was left alone")
}

listed_members() -> str[] {
    found = []
    inside = false

    for line in lines(read_file("maca.toml")) {
        cut = line.trim()

        if cut.starts_with("members") {
            inside = true
        } else if inside && cut.starts_with("]") {
            inside = false
        } else if inside && cut.contains("\"") {
            found = found.push(between(cut, "\"", "\""))
        }
    }

    found
}

test_every_member_this_repository_lists_is_a_package() {
    members = listed_members()

    assert(members.length() >= 21,
           "only {str(members.length())} members were read out of the root "
               ++ "manifest, so the reading above went wrong")

    for m in members {
        said = read_file(m ++ "/maca.toml")

        assert(said.contains("[package]") && said.contains("name ="),
               "{m} does not say what it is")
        assert(!said.contains("version ="),
               "{m} repeats a version the workspace already states")

        for line in lines(said) {
            if line.trim().starts_with("path =") {
                assert(file_exists(m ++ "/" ++ between(line, "\"", "\"")),
                       "{m}: a [[bin]] path names no file")
            }
        }
    }
}

declared_web(tag: str, build: str) -> str {
    dir = monorepo(tag)
    write_file(dir ++ "/apps/hello/maca.toml",
        "[package]\nname = \"hello\"\n\n[build]\n" ++ build
            ++ "\n[[bin]]\nname = \"hello\"\npath = \"main.maca\"\n")

    dir
}

test_a_member_key_beats_the_root_key_it_repeats() {
    dir = monorepo("ws-format")

    write_file(dir ++ "/maca.toml",
        "[package]\nname = \"repo\"\n\n[workspace]\n"
            ++ "members = [\"modules/greet\", \"apps/hello\"]\n\n"
            ++ "[format]\nindent_style = \"space\"\nindent_size = 8\n")
    write_file(dir ++ "/apps/hello/maca.toml",
        "[package]\nname = \"hello\"\n\n[format]\nindent_size = 2\n\n"
            ++ "[[bin]]\nname = \"hello\"\npath = \"main.maca\"\n")
    write_file(dir ++ "/apps/hello/wide.maca",
               "main() -> int {{\n        0\n}}\n")

    assert_eq(str(rc_in(dir, ["fmt", "apps/hello/wide.maca"])), "0", "fmt ran")
    assert(read_file(dir ++ "/apps/hello/wide.maca").contains("\n  0\n"),
           "the member's indent_size beats the eight the root declared")
}

test_a_declared_output_directory_is_relative_to_its_own_manifest() {
    dir = declared_web("ws-out-rel", "target = \"js\"\nout = \"build\"\n")

    assert_eq(str(rc_in(dir, ["build", "apps/hello/main.maca"])), "0",
              "a build run from the root of the workspace")
    assert(file_exists(dir ++ "/apps/hello/build/index.html"),
           "the page belongs beside the manifest that named the directory")
    assert(!file_exists(dir ++ "/build"),
           "and not beside the directory the command was run in")
}

test_a_flag_beats_the_target_the_manifest_declared() {
    at = declared_web("ws-target-flag", "target = \"js\"\n") ++ "/apps/hello"

    assert_eq(str(rc_in(at, ["build", "--target", "rust"])), "0",
              "the flag on the line ran")
    assert(read_file(at ++ "/main.rs").starts_with("use std::rc::Rc;"),
           "the back end the flag named is the one that wrote the source")
    assert(!file_exists(at ++ "/main-web"),
           "and the declared one did not run at all")
}
