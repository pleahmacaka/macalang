import std/proc

Stamp = str(now_ms())

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

scratch() -> str {
    dir = env_or("TMPDIR", "/tmp") ++ "/maca-build-cache"
    make_dir(dir)

    dir
}

/// The stamp is what makes the first build of a run a real miss, whatever an earlier run left behind.
fixture(name: str, says: str) -> str {
    path = "{scratch()}/{name}"

    write_file(path, "main() -> int \{\n    info(\"{says} {Stamp}\")\n"
                         ++ "    0\n\}\n")

    path
}

built(src: str, out: str) -> int {
    at = now_ms()
    code = exec(maca_bin(), ["build", src, "-o", "{scratch()}/{out}"])

    assert_eq(code, 0, "{src} does not build")

    now_ms() - at
}

racing(src: str, prefix: str) -> str {
    line = "rm -f '{scratch()}'/race.*; for i in 1 2 3 4; do "
               ++ "{prefix}'{maca_bin()}' run '{src}' "
               ++ "> '{scratch()}'/race.$i 2>&1 & done; wait; "
               ++ "cat '{scratch()}'/race.*"

    output("sh", ["-c", line])
}

test_four_runs_of_one_program_do_not_collide() {
    src = fixture("racer.maca", "racer")
    cold = racing(src, "MACA_NO_CACHE=1 ")

    exec(maca_bin(), ["run", src])

    warm = racing(src, "")

    assert_eq(cold.split("racer ").length() - 1, 4,
              "a cold run was raced by three others: {cold}")
    assert_eq(warm.split("racer ").length() - 1, 4,
              "a warm run was raced by three others: {warm}")
    assert(!cold.contains("Text file busy")
               && !warm.contains("Text file busy"),
           "one run wrote the binary another was executing")
    assert(!cold.contains("cache copy failed"),
           "two runs wrote the cache at once: {cold}")
}

test_the_second_build_of_a_program_is_a_copy_and_not_a_compile() {
    src = fixture("cost.maca", "cost")
    cold = built(src, "cost1")
    warm = built(src, "cost2")
    off = now_ms()

    exec("env", ["MACA_NO_CACHE=1", maca_bin(), "build", src, "-o",
                 "{scratch()}/cost3"])

    assert(warm * 2 < cold,
           "a repeated build took {str(warm)}ms against {str(cold)}ms cold, "
               ++ "so nothing was cached")
    assert(now_ms() - off > warm * 2,
           "MACA_NO_CACHE=1 was answered out of the cache anyway")
}

/// A program that embeds a file is made of that file too, so the cache has to answer for it.
embedding(name: str, note: str) -> str {
    src = "{scratch()}/{name}"

    write_file(src, "note: str = data(\"{note}\")\n\nmain() -> int \{\n"
                        ++ "    info(note)\n    0\n\}\n")

    src
}

test_a_program_that_embeds_a_file_is_still_cached() {
    write_file("{scratch()}/kept_note.txt", "kept {Stamp}")

    src = embedding("keeper.maca", "kept_note.txt")
    cold = built(src, "keeper1")
    warm = built(src, "keeper2")

    assert(warm * 2 < cold,
           "a repeated build took {str(warm)}ms against {str(cold)}ms cold, "
               ++ "so embedding a file turned the cache off")
}

test_one_character_of_an_embedded_file_is_a_binary_of_its_own() {
    note = "{scratch()}/edited_note.txt"
    src = embedding("edits_a_note.maca", "edited_note.txt")
    out = "{scratch()}/edits_a_note"

    remove_file(note ++ ".local")
    remove_file("{scratch()}/edited_note.local.txt")
    write_file(note, "one {Stamp}")
    exec(maca_bin(), ["build", src, "-o", out])

    first = capture(out, []).trim()

    write_file(note, "two {Stamp}")
    exec(maca_bin(), ["build", src, "-o", out])

    assert_eq(first, "one {Stamp}", "the built program says what it embedded")
    assert_eq(capture(out, []).trim(), "two {Stamp}",
              "an edited embedded file is compiled again, not served from "
                  ++ "the cache")
}

test_a_local_companion_appearing_beside_a_file_is_a_binary_of_its_own() {
    note = "{scratch()}/shadowed_note.txt"
    private = "{scratch()}/shadowed_note.local.txt"
    src = embedding("reads_a_note.maca", "shadowed_note.txt")
    out = "{scratch()}/reads_a_note"

    remove_file(private)
    write_file(note, "committed {Stamp}")
    exec(maca_bin(), ["build", src, "-o", out])

    first = capture(out, []).trim()

    write_file(private, "private {Stamp}")
    exec(maca_bin(), ["build", src, "-o", out])

    assert_eq(first, "committed {Stamp}", "the committed file is what it read")
    assert_eq(capture(out, []).trim(), "private {Stamp}",
              "the .local companion appearing beside it is a build of its "
                  ++ "own, not a cache hit")
    remove_file(private)
}

test_one_character_of_the_source_is_a_binary_of_its_own() {
    src = fixture("edited.maca", "aa")
    out = "{scratch()}/edited"

    exec(maca_bin(), ["build", src, "-o", out])

    first = capture(out, []).trim()

    write_file(src, read_file(src).replace("aa", "ab"))
    exec(maca_bin(), ["build", src, "-o", out])

    assert_eq(first, "aa {Stamp}", "the built program says what it was given")
    assert_eq(capture(out, []).trim(), "ab {Stamp}",
              "an edited source is compiled again, not served from the cache")
}
