import std/proc

Stamp = str(now_ms())

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

scratch() -> str {
    dir = env_or("TMPDIR", "/tmp") ++ "/maca-build-cache"
    make_dir(dir)

    dir
}

/// The stamp is what makes the first build of a run a real miss, whatever an earlier run left behind.
fixture(name: str, says: str) -> str {
    path = "{scratch()}/{name}"

    write_file(path, "main() -> int \{\n    info(\"{says} {Stamp}\")\n"
                         ++ "    0\n\}\n")

    path
}

built(src: str, out: str) -> int {
    at = now_ms()
    code = exec(maca_bin(), ["build", src, "-o", "{scratch()}/{out}"])

    assert_eq(code, 0, "{src} does not build")

    now_ms() - at
}

test_the_second_build_of_a_program_is_a_copy_and_not_a_compile() {
    src = fixture("cost.maca", "cost")
    cold = built(src, "cost1")
    warm = built(src, "cost2")
    off = now_ms()

    exec("env", ["MACA_NO_CACHE=1", maca_bin(), "build", src, "-o",
                 "{scratch()}/cost3"])

    assert(warm * 2 < cold,
           "a repeated build took {str(warm)}ms against {str(cold)}ms cold, "
               ++ "so nothing was cached")
    assert(now_ms() - off > warm * 2,
           "MACA_NO_CACHE=1 was answered out of the cache anyway")
}

test_one_character_of_the_source_is_a_binary_of_its_own() {
    src = fixture("edited.maca", "aa")
    out = "{scratch()}/edited"

    exec(maca_bin(), ["build", src, "-o", out])

    first = capture(out, []).trim()

    write_file(src, read_file(src).replace("aa", "ab"))
    exec(maca_bin(), ["build", src, "-o", out])

    assert_eq(first, "aa {Stamp}", "the built program says what it was given")
    assert_eq(capture(out, []).trim(), "ab {Stamp}",
              "an edited source is compiled again, not served from the cache")
}
