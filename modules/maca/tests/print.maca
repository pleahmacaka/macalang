import maca/token
import maca/lexer
import maca/parser
import maca/print

printed(src: str) -> str =>
    print_module(parse_module(lex(src), 0, []))

round_trips(src: str) -> bool =>
    printed(printed(src)) == printed(src)

test_a_function_prints_back_as_maca() {
    assert_eq(printed("add(a: int,b: int)->int=>a+b"),
              "add(a: int, b: int) -> int =>\n    (a + b)\n",
              "the canonical form spaces the parameters and the arrow")
}

test_a_block_body_keeps_its_braces_and_one_indent() {
    assert_eq(printed("f(n: int) -> int {{ t = n * n\nt }}"),
              "f(n: int) -> int \{\n    t = (n * n)\n    t\n\}\n",
              "each statement is one line at one indent")
}

test_a_record_and_a_sum_print_on_one_line() {
    assert_eq(printed("Point = {{ x: int, y: int }}"),
              "Point = \{ x: int, y: int \}\n", "fields keep their types")
    assert_eq(printed("Color = Red | Green"), "Color = Red | Green\n",
              "and variants keep their bar")
}

test_printing_is_idempotent() {
    assert(round_trips("add(a: int, b: int) -> int => a + b"),
           "a formatter that moves on the second run is not canonical")
    assert(round_trips("Point = {{ x: int }} f(p: Point) -> int => p.x"),
           "nor is one that only settles for a function")
    assert(round_trips("f(xs: int[]) -> int {{ t = xs.get(0)\nt + 1 }}"),
           "nor one that only settles without a method call")
}

marked(src: str) -> str =>
    print_marked(parse_module(lex(src), 0, []), lex_marked(src))

test_a_comment_lands_back_above_the_item_it_was_written_above() {
    out = marked("// why\nf() -> int => 1")

    assert_eq(out, "// why\nf() -> int =>\n    1\n",
              "a formatter that drops a comment is not a formatter")
}

test_a_comment_between_two_items_stays_between_them() {
    out = marked("a() -> int => 1\n// about b\nb() -> int => 2")

    assert(out.index_of("// about b\nb()") >= 0,
           "it belongs to what follows it, not to what came before")
}

test_a_comment_after_the_last_item_is_still_written() {
    out = marked("f() -> int => 1\n// the end")

    assert(out.ends_with("// the end\n"),
           "nothing is dropped for having nothing after it")
}

test_two_items_are_separated_by_a_blank_line() {
    assert_eq(printed("a() -> int => 1 b() -> int => 2"),
              "a() -> int =>\n    1\n\nb() -> int =>\n    2\n",
              "a reader needs the gap, and the file ends with one newline")
}
