import maca/lexer
import maca/parser
import maca/check
import maca/emit_c
import maca/emit_rust

shown(src: str) -> str =>
    show(parse_expr(lex(src), 0).node)

c_of(src: str) -> str =>
    emit_fn(parse_fn(lex(src), 0).snode)

rust_of(src: str) -> str =>
    remit_fn(parse_fn(lex(src), 0).snode)

errors_in(src: str) -> str =>
    str(check_errors(parse_module(lex(src), 0, [])).length())

Picker = "pick(n: int) -> int => if n > 0 {{ 1 }} else {{ 0 }}"

test_an_if_expression_parses_with_both_branches() {
    assert_eq(shown("if a > b {{ 1 }} else {{ 2 }}"),
              "(if (a > b) then 1 else 2)",
              "condition, then-branch, else-branch")
}

test_an_else_if_chain_nests_to_the_right() {
    assert_eq(shown("if a {{ 1 }} else if b {{ 2 }} else {{ 3 }}"),
              "(if a then 1 else (if b then 2 else 3))",
              "the second if is the first one's else-branch")
}

test_an_if_is_an_expression_and_composes() {
    assert_eq(shown("1 + if a {{ 2 }} else {{ 3 }}"),
              "(1 + (if a then 2 else 3))",
              "it sits where any other operand would")
}

test_an_if_lowers_to_a_ternary_in_c() {
    assert_eq(c_of(Picker),
              "int pick(int n) {{ return ((n > 0) ? 1 : 0);  }}",
              "C has no if-expression, so it is a ternary")
}

test_an_if_lowers_to_a_native_if_in_rust() {
    assert_eq(rust_of(Picker),
              "fn pick(n: i64) -> i64 {{ (if (n > 0i64) {{ 1i64 }} else {{ 0i64 }})  }}",
              "Rust has one already")
}

test_an_if_has_the_type_of_its_branches() {
    assert_eq(errors_in(Picker), "0",
              "both branches are int, and so is the return")
    assert_eq(errors_in("pick(n: int) -> str => if n > 0 {{ 1 }} else {{ 0 }}"),
              "1", "int is not str")
}

test_the_branches_of_an_if_must_agree() {
    assert_eq(errors_in("pick(n: int) -> int => if n > 0 {{ 1 }} else {{ \"x\" }}"),
              "1", "one branch is int and the other str")
}

Bumper = "bump(p: Point) -> Point => p with {{ x = 1 }}"

test_a_record_update_parses_as_a_base_and_its_fields() {
    assert_eq(shown("p with {{ x = 1, y = 2 }}"),
              "p with {{ (x = 1), (y = 2) }}",
              "the base, then only the fields named")
}

test_a_shorthand_field_repeats_the_name_as_its_value() {
    assert_eq(shown("Point {{ x, y = 2 }}"),
              "Point {{ (x = x), (y = 2) }}",
              "`{{ x }}` is `{{ x = x }}`")
}

test_a_record_update_takes_a_shorthand_field_too() {
    assert_eq(shown("p with {{ x }}"), "p with {{ (x = x) }}",
              "the same rule inside with")
}

test_a_record_update_copies_before_it_assigns_in_c() {
    assert_eq(c_of(Bumper),
              "Point bump(Point p) {{ return ({{ __typeof__(p) _w = p;"
                  ++ " _w.x = 1; _w; }});  }}",
              "C has no update expression, so it is a statement expression")
}

test_a_record_update_copies_before_it_assigns_in_rust() {
    assert_eq(rust_of(Bumper),
              "fn bump(p: Point) -> Point {{ {{ let mut _w = p;"
                  ++ " _w.x = 1i64; _w }}  }}",
              "a block that mutates its own copy")
}

test_a_record_update_has_the_type_of_its_base() {
    assert_eq(errors_in("Point = {{ x: int }}"
                        ++ " bump(p: Point) -> Point => p with {{ x = 1 }}"),
              "0", "the update is still a Point")
    assert_eq(errors_in("Point = {{ x: int }}"
                        ++ " bump(p: Point) -> int => p with {{ x = 1 }}"),
              "1", "a Point is not an int")
}

test_a_named_call_argument_carries_the_name_it_was_given() {
    assert_eq(shown("div(class=\"wrap\", body)"), "div(class=wrap, body)",
              "the name belongs to the argument, the value is what follows")
}

test_a_hyphenated_attribute_name_is_one_name() {
    assert_eq(shown("div(aria-label=\"x\")"), "div(aria-label=x)",
              "the platform spells it with a hyphen and so does this")
}

test_a_subtraction_in_argument_position_is_still_a_subtraction() {
    assert_eq(shown("f(a - b, c)"), "f((a - b), c)",
              "a hyphen run names an attribute only when `=` closes it")
}

test_a_list_is_matched_by_its_shape() {
    assert_eq(errors_in("f(xs: int[]) -> str => match xs {{\n"
                        ++ "[] => \"none\"\n[x] => \"one\"\n"
                        ++ "[x, ..rest] => \"more\"\n}}"),
              "0", "empty, exactly one, and one with a rest behind it")
    assert(annotated_c("f(xs: int[]) -> str => match xs {{"
                       ++ " [] => \"none\" _ => \"some\" }}")
               .index_of(".len == 0") >= 0,
           "an empty list is a length nobody has to bind")
}

test_a_bracket_that_opens_a_line_is_not_an_index() {
    assert_eq(errors_in("f(xs: int[]) -> str => match xs {{"
                        ++ " [x] => \"one\"\n [x, y] => \"two\" _ => \"more\" }}"),
              "0", "the next arm's `[` was read as an index on the last body")
    assert_eq(errors_in("f(s: str) -> str =>\n    s.trim()\n        .upper()"),
              "0", "while a `.` that opens a line still continues the chain")
}

test_a_comma_pattern_matches_a_list_without_brackets() {
    assert_eq(errors_in("f(xs: str[]) -> str => match xs {{\n"
                        ++ "\"done\", id => id\n"
                        ++ "\"add\", ..rest => \"more\"\n_ => \"none\"\n}}"),
              "0", "a bare comma list is a pattern, and its head may be a literal")
    assert(annotated_c("f(xs: str[]) -> str => match xs {{"
                       ++ " \"done\", id => id\n _ => \"none\" }}")
               .index_of("\"done\") == 0") >= 0,
           "a cell the pattern spells out is compared, not bound")
}

test_a_rest_parameter_is_one_list_the_call_fills() {
    assert_eq(errors_in("total(...rest: int) -> int => 0\n"
                        ++ "f() -> int => total(1, 2, 3)"),
              "0", "a variadic takes as many arguments as the call hands it")
    assert(annotated_c("total(...rest: int) -> int => 0\n"
                       ++ "f() -> int => total(1, 2)")
               .index_of("total(maca_listv(") >= 0,
           "the loose arguments arrive as the one list the callee declared")
}

test_a_tag_a_function_also_names_is_still_a_tag() {
    assert_eq(errors_in("html(s: str) -> str => s\n"
                        ++ "f() -> str => html(\"a\", \"b\", \"c\")"),
              "0", "three arguments cannot be the one-parameter function")
    assert_eq(errors_in("html(s: str) -> str => s\n"
                        ++ "f() -> str => html(1)"),
              "1", "while one argument still has to be the type it declares")
}

test_a_function_written_inside_a_body_is_a_local() {
    assert_eq(errors_in("f(n: int) -> int {{\n"
                        ++ "twice(x: int) -> int => x + x\n"
                        ++ "twice(n)\n}}"),
              "0", "a nested declaration is not a call with a type in it")
    assert_eq(errors_in("f(n: int) -> int {{\n"
                        ++ "twice(x: int) -> int {{ x + x }}\n"
                        ++ "twice(n)\n}}"),
              "0", "and it may carry a block for a body")
}

test_a_match_arm_may_answer_with_a_block() {
    assert_eq(errors_in("C = A | B f(c: C) -> int => match c {{"
                        ++ " A => {{ n = 1 n + 1 }} B => 0 }}"),
              "0", "an arm answers the way a branch of an `if` does")
    assert(shown("match c {{ A => {{ n = 1 n }} B => 0 }}")
               .index_of("match c") >= 0,
           "and the arm after it is still read")
}

annotated_c(src: str) -> str =>
    emit_module(annotated(parse_module(lex(src), 0, [])))

annotated_rust(src: str) -> str =>
    remit_module(annotated(parse_module(lex(src), 0, [])))

test_the_checker_writes_the_type_it_inferred_into_the_tree() {
    m = annotated(parse_module(lex("n(s: str) -> int => s.length()"), 0, []))
    body = m.items.get(0).body.get(0).value
    assert_eq(body.children.get(0).ty, "str",
              "the receiver knows it is a string")
}

test_an_array_length_is_not_a_string_length_in_c() {
    assert(annotated_c("n(xs: int[]) -> int => xs.length()")
                  .index_of("(xs.len)") >= 0,
           "an array reads its own length field")
    assert(annotated_c("n(s: str) -> int => s.length()")
                  .index_of("strlen(s)") >= 0,
           "a string still goes through strlen")
}

test_a_string_index_is_one_character_and_an_array_index_an_element() {
    assert(annotated_c("n(s: str) -> str => s.get(0)")
                  .index_of("maca_str_at(s, 0)") >= 0,
           "get on a string is the one-character str at that offset")
    assert(annotated_c("n(xs: int[]) -> int => xs.get(0)")
                  .index_of("xs.data[0]") >= 0,
           "get on an array is the element")
    assert(annotated_rust("n(s: str) -> str => s.get(0)")
                  .index_of("get(_i.._i + 1)") >= 0,
           "Rust takes the one-byte slice and owns it")
    assert_eq(errors_in("n(s: str) -> int => s.at(0)"), "1",
              "a one-character str is not an int")
}

test_a_local_takes_its_c_type_from_the_lowering() {
    assert(annotated_c("n() -> float {{ t = 1.5 * 2.0 t }}")
               .index_of("double t =") >= 0,
           "float arithmetic is a double, which the shape of a `*` cannot say")
    assert(annotated_c("s() -> str => \"a\" n() -> str {{ t = s() t }}")
               .index_of("const char* t =") >= 0,
           "a call takes the type its declaration returns")
}

Keyword = "kw(w: str) -> int => match w {{ \"let\" => 1 \"if\" => 2 _ => 0 }}"

Tagged = "rank(c: Color) -> int => match c {{ Red => 1 Green => 2 }}"

test_a_string_pattern_is_compared_by_content_in_c() {
    assert(c_of(Keyword).index_of("strcmp(w, \"let\") == 0") >= 0,
           "a string pattern goes through strcmp")
    assert(c_of(Keyword).index_of("w == let") < 0,
           "never a pointer compare against an undeclared name")
}

test_a_string_pattern_matches_a_slice_in_rust() {
    assert(rust_of(Keyword).index_of("w.as_str()") >= 0,
           "a String is matched as a str slice")
    assert(rust_of(Keyword).index_of("\"let\" =>") >= 0,
           "the pattern keeps its quotes")
}

Payload = "area(s: Shape) -> int => match s {{ Circle(r) => r Rect(w, h) => w }}"

test_a_variant_pattern_is_not_touched_by_the_string_rule() {
    assert(c_of(Tagged).index_of("c == Red") >= 0,
           "a nullary sum is a C enum, so its variants compare as values")
    assert(c_of(Payload).index_of("s.tag == Circle_tag") >= 0,
           "a payload sum still dispatches on its tag")
    assert(rust_of(Tagged).index_of("Red =>") >= 0,
           "Rust matches the bare variant name")
    assert(rust_of(Tagged).index_of("as_str()") < 0,
           "a sum is not a string, so it is not sliced")
}

Cat = "join(a: int[], b: int[]) -> int[] => a ++ b"

Span = "span(cs: str[], i: int, j: int) -> str => cs.slice(i, j).join(\"\")"

Find = "at(xs: int[], v: int) -> int => xs.index_of(v)"

Grow = "add(xs: int[], v: int) -> int[] => xs.push(v)"

test_two_arrays_concatenate_as_lists_not_as_strings() {
    assert(annotated_c(Cat).index_of("maca_list_cat(a, b)") >= 0,
           "C joins the two blocks")
    assert(annotated_c(Cat).index_of("maca_cat(a, b)") < 0,
           "never through the string concat")
    assert(annotated_rust(Cat).index_of("Rc::make_mut(&mut _v).extend(") >= 0,
           "Rust extends the left vector, in place when nothing else holds it")
}

test_a_slice_and_a_join_lower_for_a_list() {
    assert(annotated_c(Span).index_of("maca_list_slice(cs, i, j)") >= 0,
           "the scanner's own span")
    assert(annotated_c(Span).index_of("maca_list_join(") >= 0,
           "and the join that turns it back into text")
}

test_index_of_picks_a_list_or_a_string() {
    assert(annotated_c(Find).index_of("maca_list_index_of(xs,") >= 0,
           "a list scans its cells")
    assert(annotated_c("at(s: str, n: str) -> int => s.index_of(n)")
               .index_of("maca_str_index_of(s, n)") >= 0,
           "a string looks for a substring")
}

test_push_appends_one_cell() {
    assert(annotated_c(Grow).index_of("maca_list_cat(xs, maca_listv(1,") >= 0,
           "one more cell on the end")
    assert(annotated_rust(Grow).index_of("Rc::make_mut(&mut _v).push(v)") >= 0,
           "Rust pushes onto the same vector when its count is one")
}

items_of(src: str) -> str =>
    str(parse_module(lex(src), 0, []).items.length())

bad_of(src: str) -> str[] =>
    parse_module(lex(src), 0, []).errors

test_a_token_that_starts_nothing_is_stepped_over() {
    assert_eq(items_of("a"), "0",
              "a bare name is no declaration, and the walk still ends")
    assert_eq(items_of("# @ ?"), "0", "nor is a row of punctuation")
}

test_what_the_walk_steps_over_is_reported() {
    bad = bad_of("a")
    assert_eq(str(bad.length()), "1", "the bare name is not silently dropped")
    assert_eq(bad.get(0), "no declaration starts at `a` (offset 0)",
              "and the message names it and where it sat")
    assert_eq(str(bad_of("f() -> int => 1").length()), "0",
              "a file the parser reads whole says nothing")
}

test_a_list_concatenation_is_a_list_and_not_a_string() {
    assert(annotated_c("g(xs: int[], v: int) -> int[] {{ t = xs ++ [v] t }}")
               .index_of("MacaList t =") >= 0,
           "the result of joining two lists is a list")
    assert(annotated_c("g(a: str, b: str) -> str {{ t = a ++ b t }}")
               .index_of("const char* t =") >= 0,
           "and joining two strings is still a string")
}

test_the_walk_still_reaches_what_follows_the_junk() {
    assert_eq(items_of("a f() -> int => 1"), "1",
              "the function after the stray name is still read")
    assert_eq(items_of("f() -> int => 1 a"), "1",
              "and a stray name after one does not lose it")
}

test_a_declaration_still_needs_its_parentheses() {
    assert_eq(items_of("f -> int => 1"), "0",
              "without `(` it is not a function declaration")
}

Guarded = "pick(n: int) -> int => if n > 0 {{ d = n * 2 d + 1 }} else {{ 0 }}"

test_a_branch_with_a_binding_is_a_block() {
    assert_eq(shown("if c {{ d = 1 d }} else {{ 2 }}"),
              "(if c then ? else 2)",
              "the branch is a block node, which the printer does not spell out")
}

test_a_block_branch_lowers_to_a_statement_expression_in_c() {
    assert(c_of(Guarded).index_of("({{ int d = (n * 2); (d + 1); }})") >= 0,
           "C declares the local inside a statement expression")
}

test_a_block_branch_lowers_to_a_block_in_rust() {
    assert(rust_of(Guarded).index_of("{{ let d = (n * 2i64); (d + 1i64) }}") >= 0,
           "Rust ends the block in its value")
}

test_a_block_branch_types_by_its_last_expression() {
    assert_eq(errors_in(Guarded), "0", "the block is an int, and so is the return")
    assert_eq(errors_in("pick(n: int) -> str => if n > 0 {{ d = n d }} else {{ 0 }}"),
              "1", "both branches are int, so only the str return disagrees")
}

test_a_block_binding_does_not_escape_its_branch() {
    assert_eq(errors_in("pick(n: int) -> int {{"
                        ++ " q = if n > 0 {{ d = n d }} else {{ 0 }} q }}"),
              "0", "d is gone by the time q is bound")
}

test_a_list_that_never_closes_stops_at_the_end_of_input() {
    assert_eq(items_of("f() -> int => g(1, 2"), "1",
              "the call runs to the end of input without leaving the token list")
    assert_eq(items_of("f() -> int => [1, 2"), "1", "so does a list literal")
    assert_eq(items_of("R = {{ a: int"), "1",
              "a record whose brace never shuts keeps the fields it found")
}

test_a_sum_that_never_closes_stops_at_the_end_of_input() {
    assert_eq(items_of("K =\n    A | B |"), "1",
              "a trailing bar leaves the variant list, it does not read past Eof")
    assert_eq(items_of("K = A(int"), "1", "nor does an unclosed payload")
}

test_a_record_field_may_be_an_array() {
    assert_eq(items_of("R = {{\n    xs: int[]\n    n: int\n}}"), "1",
              "an array field does not throw the field walk off")
    assert_eq(errors_in("R = {{ xs: int[] }} f(r: R) -> int => r.xs.length()"),
              "0", "and the field keeps its element type")
}

test_a_string_inside_an_interpolation_does_not_end_the_string() {
    assert_eq(items_of("g(a: int[], s: str) -> str => s"
                       ++ " f(a: int[]) -> str => \"x {{g(a, \" \")}} y\""),
              "2", "the quote inside the braces belongs to the interpolation")
}

test_a_call_before_a_branch_marks_a_block_not_a_record() {
    assert_eq(items_of("f(t: int) -> int {{"
                       ++ " if t == 0 {{ at = g(t)\n if at < 0 {{ 1 }} else {{ 2 }} }}"
                       ++ " else {{ 3 }} }}"),
              "1", "a `)` before an `if` is two statements, not a field")
}

Guardy = "pick(a: int) -> int => match true {{"
    ++ " _ if a > 5 => 1 _ if a > 0 => 2 _ => 0 }}"

test_a_match_arm_may_carry_a_guard() {
    assert(c_of(Guardy).index_of("(a > 5) ? 1") >= 0,
           "the guard is the arm's test in C")
    assert(c_of(Guardy).index_of("1._0") < 0,
           "a guard's two children are not payload binders")
    assert(rust_of(Guardy).index_of("_ if (a > 5i64) =>") >= 0,
           "Rust writes the guard where it belongs")
}

test_a_doubled_brace_is_one_brace_and_not_an_interpolation() {
    assert(c_of("open() -> str => \"{{{{ x }}}}\"").index_of("maca_int_to_str") < 0,
           "a literal brace is not lowered as an interpolation")
}

test_an_empty_list_is_not_a_trailing_comma_in_c() {
    assert(annotated_c("f() -> int[] => []").index_of("maca_listv(0)") >= 0,
           "no argument means no comma after the count")
    assert(annotated_c("f() -> int[] => []").index_of("maca_listv(0, )") < 0,
           "which is what C refused to parse")
}

Backslash = "\\"

OneBrace = "{{"

test_an_escaped_brace_does_not_open_an_interpolation() {
    src = "a" ++ Backslash ++ OneBrace ++ "b"
    assert(!has_interp(src.chars(), 0),
           "a backslash before a brace is a brace, not an interpolation")
    assert(has_interp(("a" ++ OneBrace ++ "b").chars(), 0),
           "a bare brace still opens one")
}

test_an_escaped_brace_loses_its_backslash_in_the_literal() {
    src = "a" ++ Backslash ++ OneBrace ++ "b"
    assert_eq(plain_braces(src.chars(), 0, ""), "a" ++ OneBrace ++ "b",
              "what the emitter writes is one brace")
}

CloseBrace = "}}"

Reopen = "f(n: int) -> str => \"a {{n}}}} b\""

test_a_doubled_brace_is_still_one_brace() {
    assert(!has_interp((OneBrace ++ OneBrace).chars(), 0),
           "the doubled form is not an interpolation either")
    assert_eq(plain_braces((OneBrace ++ OneBrace).chars(), 0, ""), OneBrace,
              "and the literal it writes is the one brace it stands for")
    assert_eq(plain_braces((CloseBrace ++ CloseBrace).chars(), 0, ""),
              CloseBrace, "the closing pair collapses the same way")
}

test_a_string_literal_compares_by_content_without_a_typed_tree() {
    assert(c_of("kw(w: str) -> int => w == \"let\" ? 1 : 0")
               .index_of("(strcmp(w, \"let\") == 0)") >= 0,
           "no inferred type on the tree leaves the literal to go by")
}

test_a_doubled_brace_after_an_interpolation_closes_it_first() {
    assert(c_of(Reopen).index_of("maca_int_to_str(n)), \"" ++ CloseBrace
                                 ++ " b\")") >= 0,
           "the brace that shuts the hole is not half of the pair after it")
}

test_a_top_level_binding_is_a_declaration() {
    m = parse_module(lex("Seed = 1000 f() -> int => Seed"), 0, [])

    assert_eq(str(m.items.length()), "2", "the constant is an item of its own")
    assert_eq(str(m.errors.length()), "0", "and not a skipped declaration")
    assert_eq(m.items.get(0).name, "Seed", "named by what it binds")
}

test_fail_carries_the_message_it_raises() {
    assert_eq(shown("fail \"gone\""), "(failgone)",
              "fail is a prefix over the value it raises")
}

Counter = "run(n: int) -> int {{ i = 0 while i < n {{ i = i + 1 }} i }}"

test_a_while_loop_is_a_statement_with_a_condition_and_a_body() {
    assert_eq(str(bad_of(Counter).length()), "0",
              "the loop is read whole, so nothing is skipped")
    assert(c_of(Counter).index_of("while ((i < n))") >= 0,
           "C has a while of its own")
    assert(rust_of(Counter).index_of("while (i < n)") >= 0, "so does Rust")
}

test_a_loop_body_reassigns_rather_than_redeclaring() {
    out = annotated_c(Counter)

    assert(out.index_of("i = (i + 1);") >= 0,
           "the second write to i is an assignment")
    assert(out.index_of("int i = (i + 1);") < 0,
           "never a fresh declaration, which would loop for ever")
}

Jumper = "run(n: int) -> int {{ i = 0 while true {{ if i > n {{ break }}"
    ++ " i = i + 1 }} i }}"

test_break_and_continue_are_the_loop_keywords_not_names() {
    assert(c_of(Jumper).index_of("break") >= 0, "break lowers to C's break")
    assert(parse_expr(lex("break"), 0).node.kind == EJump,
           "break is a jump of its own, never a name the program declared")
    assert(parse_expr(lex("continue"), 0).node.kind == EJump,
           "the same for continue")
    assert_eq(shown("break"), "break", "and it prints as what it is")
}

Walker = "total(xs: int[]) -> int {{ acc = 0 for x in xs"
    ++ " {{ acc = acc + x }} acc }}"

test_a_for_loop_binds_one_element_at_a_time() {
    assert_eq(str(bad_of(Walker).length()), "0", "the loop is read whole")
    assert(annotated_c(Walker).index_of("int x = ((int)_f.data[_fi]);") >= 0,
           "C walks the block and names each cell")
    assert(annotated_rust(Walker).index_of("for x in (xs.clone()).iter()") >= 0,
           "Rust already has the loop, and the count is what it walks")
}

test_a_range_counts_from_its_low_end_to_below_its_high_one() {
    assert(annotated_c("f(n: int) -> int[] => 0..n")
               .index_of("maca_range(0, n)") >= 0,
           "the range materialises as a list")
    assert_eq(shown("1..n + 1"), "(1 .. (n + 1))",
              "`..` binds looser than `+`, so the end is the whole sum")
}

Extern = "py_call(m: str) -> str\nmain() -> int => 0"

test_a_declaration_with_no_body_is_a_prototype() {
    assert_eq(items_of(Extern), "2",
              "the bodyless declaration and main are two items")
    assert_eq(str(bad_of(Extern).length()), "0", "and neither is skipped")
    assert(annotated_c(Extern).index_of("const char* py_call(const char* m);")
               >= 0, "C gets the prototype")
    assert(annotated_c(Extern).index_of("const char* py_call(const char* m) {{")
               < 0, "and no definition, which would be a second symbol")
}

test_a_declaration_still_needs_a_body_to_get_one() {
    assert(annotated_c("f() -> int => 1").index_of("int f() {{ return 1;") >= 0,
           "a function that has a body still gets it emitted")
}

test_a_nested_array_and_an_applied_type_are_read_whole() {
    nested = parse_module(lex("chunk(xs: int[]) -> int[][] => []"), 0, [])
    assert_eq(nested.items.get(0).ret, "int[][]",
              "the second `[]` belongs to the return type")
    assert_eq(items_of("chunk(xs: int[]) -> int[][] => []"), "1",
              "and it does not throw the walk off")
    m = parse_module(lex("q(a: Map str str, n: int) -> int => n"), 0, [])
    assert_eq(str(m.items.get(0).params.length()), "2",
              "`Map str str` is one type, not three parameters")
    assert_eq(m.items.get(0).params.get(0).ty, "Map str str",
              "and the parameter keeps the whole applied type")
}

test_a_record_field_keeps_an_applied_type_too() {
    m = parse_module(lex("R = {{\n    q: Map str str\n    n: int\n}}"), 0, [])
    assert_eq(str(m.items.get(0).params.length()), "2", "two fields")
    assert_eq(m.items.get(0).params.get(0).ty, "Map str str",
              "the field type is not truncated to its head")
}

Header = "run(n: int) -> int {{ i = 0 while i < n {{ acc = 1 i = i + 1 }} i }}"

test_a_loop_header_cannot_open_a_record_literal() {
    assert_eq(str(bad_of(Header ++ " after() -> int => 1").length()), "0",
              "the brace after the condition opens the body")
    assert_eq(items_of(Header ++ " after() -> int => 1"), "2",
              "so the declaration after the loop is still found")
}

test_a_record_literal_is_still_a_record_literal() {
    assert_eq(shown("Point {{ x = 1, y = 2 }}"),
              "Point {{ (x = 1), (y = 2) }}",
              "outside a header a brace after a name is the literal")
}

test_a_lambda_is_an_expression_with_parameters_and_a_body() {
    assert_eq(items_of("f(xs: int[]) -> int[] => xs.map(v => v * v)"), "1",
              "the arrow inside the call is a lambda, not stray arguments")
    assert_eq(str(bad_of("f(xs: int[]) -> int[] => xs.map(v => v * v)")
                      .length()), "0", "and nothing is skipped")
    assert(annotated_rust("f(xs: int[]) -> int[] => xs.map(v => v * v)")
               .index_of("|v| (v * v)") >= 0, "Rust writes its own closure")
    assert_eq(shown("(a, b) => a + b"), "?",
              "a two-parameter lambda is one node")
}

test_a_lambda_argument_is_counted_as_one_argument() {
    assert_eq(errors_in("pick(xs: int[], f) -> int => 0"
                        ++ " use(xs: int[]) -> int => pick(xs, v => v > 2)"),
              "0", "two arguments, the second a lambda")
    assert_eq(errors_in("pick(xs: int[], f) -> int => 0"
                        ++ " use(xs: int[]) -> int => pick(xs)"),
              "1", "and a missing one is still an arity error")
}

test_a_subscript_reads_and_writes_through_the_lvalue() {
    assert(annotated_c("f(xs: int[]) -> int => xs[0]")
               .index_of("((int)xs.data[0])") >= 0, "a read is the cell")
    assert(annotated_c("f(xs: int[], v: int) -> int {{ xs[0] = v xs[0] }}")
               .index_of("xs.data[0] = (long)(v);") >= 0,
           "a write assigns the cell, which a cast could not")
}

test_a_bracketless_comma_list_is_one_list_value() {
    m = parse_module(lex("Stages = \"a\", \"b\", \"c\""), 0, [])
    assert_eq(str(m.items.length()), "1", "one binding, not three")
    assert_eq(str(m.errors.length()), "0", "and no stray comma is skipped")
    assert_eq(shown("[1, 2]"), "[1, 2]", "a bracketed list is unchanged")
    assert_eq(items_of("f() -> int[] => 1, 2, 3"), "1",
              "an arrow body takes the list too")
}

test_a_comma_list_in_a_block_is_one_list_value() {
    assert(annotated_c("f() -> int[] {{ xs = 5, 3, 1 xs }}")
               .index_of("maca_listv(3,") >= 0,
           "three cells, not one with the rest dropped")
}

test_a_typed_binding_declares_its_own_type() {
    assert(annotated_c("f() -> int {{ n: int = 5 n }}")
               .index_of("int n = 5;") >= 0,
           "the annotation is the local's C type")
    assert(annotated_c("f() -> int {{ n: int = 5 n }}").index_of("int int =")
               < 0, "and the type name is never bound as the local")
    assert(c_of("f() -> str {{ t: str = g() t }}")
               .index_of("const char* t =") >= 0,
           "an annotation outranks what the shape of the value guesses")
    m = parse_module(lex("limit: int = 10 f() -> int => limit"), 0, [])
    assert_eq(str(m.items.length()), "2", "a typed constant is a declaration")
    assert_eq(str(m.errors.length()), "0", "and not a skipped one")
}

test_a_const_and_an_alias_are_read_as_the_bindings_they_are() {
    assert_eq(items_of("const limit = 10 f() -> int => limit"), "2",
              "`const` is a marker before an ordinary binding")
    assert_eq(str(bad_of("const limit = 10 f() -> int => limit").length()),
              "0", "and the marker itself is not a skipped declaration")
    assert_eq(items_of("NTASKS = 6 as const f() -> int => NTASKS"), "2",
              "`as const` is a marker after the value")
    assert_eq(str(bad_of("NTASKS = 6 as const f() -> int => NTASKS")
                      .length()), "0", "nor is that one")
    assert_eq(items_of("alias user = other f() -> int => 0"), "2",
              "an alias binds a name like any other")
    assert_eq(str(bad_of("alias user = other f() -> int => 0").length()),
              "0", "and the alias keyword is read, not stepped over")
}

test_a_bare_name_is_still_no_declaration() {
    assert_eq(items_of("q"), "0", "a name alone declares nothing")
    assert_eq(str(bad_of("q").length()), "1", "and it is reported")
    assert_eq(items_of("q: int"), "0",
              "nor does an ascription without a value")
}
