import std/proc

scratch() -> str =>
    env_or("TMPDIR", "/tmp") ++ "/maca-refusals"

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

entry_project() -> str {
    root = scratch() ++ "/entry"

    make_dir(scratch())
    make_dir(root)
    make_dir(root ++ "/modules")
    write_file(root ++ "/maca.toml", "[package]\nname = \"p\"\n")
    write_file(root ++ "/modules/status.maca",
        "code() -> int => 0\n\nneeds(port: int) -> int => port\n")
    write_file(root ++ "/modules/quiet.maca", "helper() -> int => 0\n")

    root
}

pair_project() -> str {
    root = scratch() ++ "/pair"

    make_dir(scratch())
    make_dir(root)
    write_file(root ++ "/maca.toml",
        "[package]\nname = \"pair\"\n\n[[bin]]\nname = \"a\"\npath = \"a.maca\"\n"
            ++ "\n[[bin]]\nname = \"b\"\npath = \"b.maca\"\n")
    write_file(root ++ "/a.maca", "main() -> int {{\n    info(\"A\")\n    0\n}}\n")
    write_file(root ++ "/b.maca", "main() -> int {{\n    info(\"B\")\n    0\n}}\n")

    root
}

bare_project() -> str {
    root = scratch() ++ "/bare"

    make_dir(scratch())
    make_dir(root)

    root
}

said_in(dir: str, args: str[]) -> str {
    bin = maca_bin()
    back = cwd()

    chdir(dir)
    said = capture_err(bin, args)
    chdir(back)

    said
}

code_in(dir: str, args: str[]) -> int {
    bin = maca_bin()
    back = cwd()

    chdir(dir)
    code = exec(bin, args)
    chdir(back)

    code
}

refused(path: str, want: str) -> bool {
    said = capture(maca_bin(), ["check", path])

    assert(exec(maca_bin(), ["check", path]) > 0,
        "{path} was not refused: {said}")
    assert(said.contains(want), "{path}: wanted {want}, said {said}")

    true
}

test_the_bad_corpus_is_refused_and_told_why() {
    refused("apps/examples/bad/type_mismatch.maca", "expected int, found str")
    refused("apps/examples/bad/arg_mismatch.maca", "expected int, found str")
    refused("apps/examples/bad/branch_mismatch.maca", "expected int, found str")
    refused("apps/examples/bad/range_end.maca", "expected int, found str")
    refused("apps/examples/bad/while_cond.maca", "expected bool, found int")
    refused("apps/examples/bad/arity.maca", "`greet` takes 1 argument(s), given 2")
    refused("apps/examples/bad/undefined_call.maca",
        "call to undefined function `slugify`")
    refused("apps/examples/bad/misspelt_variant.maca",
        "`Busi` is capitalized, so it is a constructor, and nothing declares"
            ++ " one by that name: did you mean `Busy`?")
    refused("apps/examples/bad/missing_asset.maca",
        "data(\"nowhere.txt\"): apps/examples/bad/nowhere.txt: no such file")
    refused("apps/examples/bad/reassign_const.maca",
        "cannot reassign constant `count`; declare it mutable with"
            ++ " `count = …` (no `const`)")
}

test_a_config_file_is_refused_for_what_a_nixos_module_cannot_do() {
    refused("apps/examples/bad/effect_in_config.maca",
        "config must be pure, and `info` performs io")
    refused("apps/examples/bad/effect_statement_in_config.maca",
        "config must be pure, and `info` performs io")
    refused("apps/examples/bad/unknown_option.maca",
        "unknown NixOS option namespace `netwrking`: did you mean"
            ++ " `networking`?")
}

test_a_dotted_binding_is_what_makes_a_file_config_mode() {
    make_dir(scratch())
    program = scratch() ++ "/effectful.maca"
    config = scratch() ++ "/pure.maca"

    write_file(program, "info(\"before main\")\n\n"
        ++ "main() -> int {{\n    info(\"hello\")\n    0\n}}\n")
    write_file(config, "networking.hostName = \"rigel\"\n"
        ++ "boot.loader.systemd_boot = true\n")

    assert_eq(str(exec(maca_bin(), ["check", program])), "0",
        "a program names no option, so no purity rule reaches it")
    assert_eq(str(exec(maca_bin(), ["check", config])), "0",
        "a config file that names known options and runs nothing is clean")
}

test_the_golden_examples_are_still_accepted() {
    for name in ["hello", "tour", "loops", "sum_record", "recursive_record",
                 "async", "taskr", "counter", "dot", "system", "operators",
                 "generic", "keywords", "indexing", "record_update", "tree",
                 "payload_sum", "range", "collections", "math"] {
        assert_eq(str(exec(maca_bin(), ["check", "apps/examples/{name}.maca"])), "0",
            "{name} is a golden example and has to check clean")
    }
}

test_every_back_end_refuses_the_same_type_error() {
    make_dir(scratch())
    src = scratch() ++ "/mismatch.maca"

    write_file(src, "add(a: int, b: int) -> int => a + b\n\n"
        ++ "main() -> int {{\n    add(\"not an int\", 2)\n}}\n")

    for target in ["c", "js", "jvm", "rust", "nix", "embedded"] {
        built = ["build", src, "-o", scratch() ++ "/out-{target}", "--target", target]

        assert(exec(maca_bin(), built) != 0,
            "{target} accepted a program the checker rejects")
        assert(capture(maca_bin(), built)
            .contains("type mismatch: expected int, found str"),
            "{target} refused it without naming the mismatch")
    }
}

test_check_answers_on_stdout_and_counts_on_the_exit_code() {
    make_dir(scratch())
    good = scratch() ++ "/good.maca"
    bad = scratch() ++ "/bad.maca"

    write_file(good, "f(n: int) -> int => n + 1\n")
    write_file(bad, "f() -> int => \"x\"\n")

    assert_eq(str(exec(maca_bin(), ["check", good])), "0",
        "nothing to say about a clean file")
    assert_eq(str(exec(maca_bin(), ["check", bad])), "1", "one mismatch is one error")
    assert(capture(maca_bin(), ["check", bad]).contains("expected int, found str"),
        "and the message names both types")
    assert_eq(capture_err(maca_bin(), ["check", bad]), "",
        "a diagnostic is what check was asked for, so it is not on stderr")
}

test_a_module_that_is_not_there_is_named_with_where_it_was_looked_for() {
    said = said_in(entry_project(), ["-m", "nosuch.thing"])

    assert(said.contains("no module `nosuch"), "names the module: {said}")
    assert(said.contains("nosuch/thing.maca"), "and where it looked: {said}")
}

test_a_function_the_module_does_not_define_is_named() {
    said = said_in(entry_project(), ["-m", "status.missing"])

    assert(said.contains("no function `missing`"), "{said}")
}

test_an_entry_point_the_command_line_cannot_fill_is_refused() {
    said = said_in(entry_project(), ["-m", "status.needs"])

    assert(said.contains("port: int"), "names the signature: {said}")
    assert(said.contains("one `str[]`"), "says what would work instead: {said}")
}

test_a_module_with_nothing_to_run_is_told_to_name_a_function() {
    said = said_in(entry_project(), ["-m", "quiet"])

    assert(said.contains("no `main`"), "{said}")
    assert(said.contains("maca -m quiet.something"), "suggests the fix: {said}")
}

test_every_module_refusal_is_a_usage_error() {
    root = entry_project()

    for spec in ["nosuch.thing", "status.missing", "status.needs", "quiet"] {
        assert_eq(str(code_in(root, ["-m", spec])), "2",
            "-m {spec} should be refused as a usage error")
    }
}

test_two_binaries_and_no_choice_is_refused_with_both_names() {
    root = pair_project()
    said = said_in(root, ["run"])

    assert_eq(str(code_in(root, ["run"])), "2",
        "two binaries and no --bin is a usage error")
    assert(said.contains("declares 2 binaries"), "says what it found: {said}")
    assert(said.contains("one of a, b"), "and names them: {said}")
}

test_no_manifest_and_no_file_is_refused_by_name() {
    root = bare_project()
    said = said_in(root, ["run"])

    assert_eq(str(code_in(root, ["run"])), "2",
        "no manifest and no file is a usage error")
    assert(said.contains("no maca.toml here"),
        "the message says what is missing: {said}")
}

test_a_record_and_a_match_are_refused_by_the_shape_they_left_out() {
    refused("apps/examples/bad/nonexhaustive.maca",
        "match on `Status` is not exhaustive; missing: Done")
    refused("apps/examples/bad/missing_field.maca",
        "`Config` is missing field(s): port, title")
    refused("apps/examples/bad/unknown_field.maca",
        "`Config` has no field `titel`")
}

test_a_rest_parameter_is_lowered_and_its_misuse_is_refused() {
    assert_eq(str(exec(maca_bin(),
        ["check", "crates/driver/tests/programs/variadic.maca"])), "0",
        "a rest parameter is a declaration the checker lowers, not one it refuses")

    refused("crates/driver/tests/programs/bad_variadic_value.maca",
        "cannot be used as a function value")
    refused("crates/driver/tests/programs/bad_variadic_arity.maca",
        "`tag` takes at least 1 argument(s), given 0")
    refused("crates/driver/tests/programs/bad_variadic_not_last.maca",
        "a rest parameter must be last")
    refused("crates/driver/tests/programs/bad_variadic_unannotated.maca",
        "rest parameter with no type")
    refused("crates/driver/tests/programs/bad_variadic_main.maca",
        "`main` takes no rest parameter")
}

test_an_effect_in_config_is_refused_by_the_effect_it_carries() {
    make_dir(scratch())
    spawned = scratch() ++ "/spawned.maca"
    awaited = scratch() ++ "/awaited.maca"

    write_file(spawned, "svc.value = spawn work(1)\n")
    write_file(awaited, "svc.value = await work(1)\n")

    refused(spawned, "config must be pure, and `spawn` performs async")
    refused(awaited, "config must be pure, and `await` performs async")

    assert(capture(maca_bin(), ["check", spawned])
        .contains("call to undefined function `work`"),
        "a callee nothing declares is still an undefined call")
    assert_eq(str(exec(maca_bin(), ["check", "apps/examples/async.maca"])), "0",
        "a program spawns and awaits, and no effect rule reaches it")
}

refused_on(path: str, target: str, want: str) -> bool {
    args = ["check", path, "--target", target]
    said = capture(maca_bin(), args)

    assert(exec(maca_bin(), args) > 0,
        "{path} was not refused for {target}: {said}")
    assert(said.contains(want), "{path}: wanted {want}, said {said}")

    true
}

test_a_program_is_refused_by_the_effect_its_target_cannot_carry() {
    bad = "apps/examples/bad/effect_off_target.maca"

    refused_on(bad, "embedded",
        "`report` performs io, which the `embedded` target cannot carry")
    refused_on(bad, "embedded",
        "`blink` performs io, which the `embedded` target cannot carry")
    assert_eq(str(exec(maca_bin(), ["check", bad])), "0",
        "native carries io, so the same program is clean where it runs")
    assert_eq(str(exec(maca_bin(),
        ["check", "apps/examples/hello.maca", "--target", "js"])), "0",
        "a browser prints, so hello builds for it")
    assert_eq(str(exec(maca_bin(), ["check", "apps/examples/hello.maca",
        "--target", "beam"])), "2",
        "there is no BEAM back end, and naming one is a usage error")
}

refused_by_every_target(name: str, src: str, said: str, why: str) {
    make_dir(scratch())
    at = scratch() ++ "/" ++ name

    write_file(at, src)

    for target in ["c", "js", "jvm", "rust"] {
        built = ["build", at, "-o", scratch() ++ "/out-{target}", "--target",
                 target]

        assert(exec(maca_bin(), built) != 0, "{target} accepted {why}")
        assert(capture(maca_bin(), built).contains(said),
               "{target} refused {why} without saying so")
    }
}

test_every_back_end_refuses_a_match_that_misses_a_variant() {
    refused_by_every_target("kinds.maca",
        "Color = Red | Green | Blue\n\nname(c: Color) -> str => match c {{\n"
            ++ "    Red => \"red\"\n    Green => \"green\"\n}}\n\n"
            ++ "main() -> int {{\n    info(name(Red))\n    0\n}}\n",
        "match on `Color` is not exhaustive; missing: Blue",
        "a match that misses a variant")
}

test_every_back_end_refuses_a_write_to_a_constant() {
    refused_by_every_target("written.maca",
        "main() -> int {{\n    const limit = 3\n    limit = 4\n    limit\n}}\n",
        "cannot reassign constant `limit`",
        "a write to a constant")
}

refused_by_ported_targets(name: str, src: str, said: str, why: str) {
    make_dir(scratch())
    at = scratch() ++ "/" ++ name

    write_file(at, src)

    for target in ["jvm", "rust"] {
        built = ["build", at, "-o", scratch() ++ "/port-{target}", "--target",
                 target]

        assert(exec(maca_bin(), built) != 0, "{target} accepted {why}")
        assert(capture(maca_bin(), built).contains(said),
               "{target} refused {why} without saying so")
    }
}

test_a_bodyless_function_reaches_no_target_without_a_c_abi() {
    refused_by_ported_targets("ffi_decl.maca",
        "measure(n: int) -> int\n\nmain() -> int => measure(1)\n",
        "is declared with no body",
        "an FFI declaration")
}

test_a_field_holding_a_function_reaches_no_target_without_a_pointer() {
    refused_by_ported_targets("held_fn.maca",
        "Box = {{\n    run: (int) -> int\n}}\n\nmain() -> int => 0\n",
        "holds a function",
        "a record field holding a function")
}
