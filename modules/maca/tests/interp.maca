import maca/lexer
import maca/parser
import maca/interp

ran(src: str) -> RunOut =>
    run_module(parse_module(lex(src), 0, []))

said(src: str) -> str =>
    ran(src).output.trim()

in_main(inner: str) -> str =>
    "main() -> int \{\n{inner}\n    0\n\}\n"

shown(expr: str) -> str =>
    said(in_main("    info(str({expr}))"))

bound(expr: str) -> str =>
    said(in_main("    n = {expr}\n    info(str(n))"))

test_a_literal_is_its_own_value() {
    assert_eq(shown("42"), "42", "an int literal")
    assert_eq(shown("1.5"), "1.5", "a float literal")
    assert_eq(shown("true"), "true", "a bool literal")
    assert_eq(shown("\"hi\""), "hi", "a string literal")
}

test_arithmetic_answers_what_the_native_backend_answers() {
    assert_eq(shown("1 + 2 * 3"), "7", "precedence is the parser's")
    assert_eq(shown("(1 + 2) * 3"), "9", "parentheses win")
    assert_eq(shown("7 / 2"), "3", "int division truncates")
    assert_eq(shown("7 % 2"), "1", "int remainder")
    assert_eq(shown("7 / 0"), "0", "division by zero answers zero")
    assert_eq(shown("1.5 + 1.5"), "3.0", "float addition")
    assert_eq(shown("1 + 1.5"), "2.5", "a mixed sum is float")
    assert_eq(shown("0 - 5"), "-5", "subtraction")
    assert_eq(shown("1 << 3"), "8", "shift left")
    assert_eq(shown("16 >> 2"), "4", "shift right")
}

test_comparison_and_logic_answer_bools() {
    assert_eq(shown("1 < 2"), "true", "less than")
    assert_eq(shown("2 <= 2"), "true", "less or equal")
    assert_eq(shown("3 > 4"), "false", "greater than")
    assert_eq(shown("1 == 1"), "true", "equality")
    assert_eq(shown("1 != 1"), "false", "inequality")
    assert_eq(shown("\"a\" < \"b\""), "true", "strings order lexically")
    assert_eq(shown("\"b\" < \"a\""), "false", "and the other way")
    assert_eq(shown("true && false"), "false", "conjunction")
    assert_eq(shown("true || false"), "true", "disjunction")
    assert_eq(shown("!true"), "false", "negation")
    assert_eq(shown("0 - 3 < 0"), "true", "unary minus")
}

test_a_ternary_and_an_if_both_answer_a_value() {
    assert_eq(shown("1 < 2 ? 10 : 20"), "10", "the ternary takes a side")
    assert_eq(shown("2 < 1 ? 10 : 20"), "20", "and the other side")
    assert_eq(said("main() -> int \{\n"
                       ++ "    b = if 1 < 2 \{ 100 \} else \{ 200 \}\n"
                       ++ "    info(str(b))\n    0\n\}\n"),
              "100", "an if answers in value position")
}

test_a_binding_is_read_back_and_written_over() {
    assert_eq(said(in_main("    x = 5\n    info(str(x))")), "5",
              "a binding is read back")
    assert_eq(said(in_main("    x = 5\n    x = x + 1\n    info(str(x))")),
              "6", "and a rebind is seen by the next read")
}

test_a_function_is_called_and_recursion_terminates() {
    assert_eq(said("double(n: int) -> int => n * 2\n"
                       ++ "main() -> int \{\n    info(str(double(21)))\n"
                       ++ "    0\n\}\n"),
              "42", "a user function is reached")
    assert_eq(said("fib(n: int) -> int =>\n"
                       ++ "    n < 2 ? n : fib(n - 1) + fib(n - 2)\n"
                       ++ "main() -> int \{\n    info(str(fib(10)))\n"
                       ++ "    0\n\}\n"),
              "55", "recursion answers 55 for fib(10)")
}

test_a_call_the_interpreter_does_not_know_is_a_fault_not_a_value() {
    out = ran(in_main("    info(str(no_such_helper(1)))"))

    assert(out.fault.contains("no_such_helper"),
           "the fault names the call: {out.fault}")
    assert_eq(out.output, "", "and nothing was printed")
}

test_a_module_with_no_main_says_so() {
    assert_eq(ran("helper() -> int => 1\n").fault,
              "no `main` function to run", "there is nothing to run")
}

test_the_exit_code_is_what_main_answered() {
    assert_eq(str(ran("main() -> int => 7\n").exit), "7", "main answered 7")
    assert_eq(str(ran(in_main("    info(\"hi\")")).exit), "0",
              "and the trailing 0 is the exit code")
}

test_a_record_is_built_read_and_replaced() {
    src = "Point = \{\n    x: int\n    y: int\n\}\n"
              ++ "main() -> int \{\n"
              ++ "    p = Point \{ x = 1, y = 2 \}\n"
              ++ "    q = p with \{ y = 9 \}\n"
              ++ "    info(\"\{p.x\} \{p.y\} \{q.x\} \{q.y\}\")\n    0\n\}\n"

    assert_eq(said(src), "1 2 1 9", "a field is read and `with` replaces one")
}

test_a_field_is_written_in_place() {
    src = "Point = \{\n    x: int\n\}\n"
              ++ "main() -> int \{\n"
              ++ "    p = Point \{ x = 1 \}\n    p.x = 8\n"
              ++ "    info(str(p.x))\n    0\n\}\n"

    assert_eq(said(src), "8", "the write is seen by the next read")
}

test_a_nullary_sum_is_matched_by_its_tag() {
    src = "Color = Red | Green | Blue\n"
              ++ "shade(c: Color) -> int =>\n    match c \{\n"
              ++ "        Red => 1\n        Green => 2\n        _ => 3\n"
              ++ "    \}\n"
              ++ "main() -> int \{\n"
              ++ "    info(\"\{shade(Red)\} \{shade(Green)\} \{shade(Blue)\}\")\n"
              ++ "    0\n\}\n"

    assert_eq(said(src), "1 2 3", "each variant takes its own arm")
}

test_a_sum_with_a_payload_binds_what_it_carries() {
    src = "Shape = Circle(int) | Square(int)\n"
              ++ "area(s: Shape) -> int \{\n    match s \{\n"
              ++ "        Circle(r) => r * r\n        Square(w) => w * w\n"
              ++ "    \}\n\}\n"
              ++ "main() -> int \{\n    info(str(area(Square(5))))\n"
              ++ "    0\n\}\n"

    assert_eq(said(src), "25", "the binder carries the payload")
}

test_a_recursive_sum_is_walked_to_the_bottom() {
    src = "Tree = Leaf(int) | Node(Tree, Tree)\n"
              ++ "total(t: Tree) -> int \{\n    match t \{\n"
              ++ "        Leaf(n) => n\n"
              ++ "        Node(l, r) => total(l) + total(r)\n    \}\n\}\n"
              ++ "main() -> int \{\n"
              ++ "    info(str(total(Node(Leaf(1), Node(Leaf(2), Leaf(3))))))\n"
              ++ "    0\n\}\n"

    assert_eq(said(src), "6", "the whole tree is summed")
}

test_a_match_arm_takes_a_guard_and_a_literal() {
    src = "size(n: int) -> str =>\n    match n \{\n"
              ++ "        0 => \"none\"\n        m if m > 10 => \"many\"\n"
              ++ "        _ => \"some\"\n    \}\n"
              ++ "main() -> int \{\n"
              ++ "    info(\"\{size(0)\} \{size(5)\} \{size(50)\}\")\n"
              ++ "    0\n\}\n"

    assert_eq(said(src), "none some many",
              "a literal arm, a guarded arm and a wildcard")
}

test_a_range_a_for_loop_and_a_while_loop_all_run() {
    assert_eq(said(in_main("    sum = 0\n    for i in 1..10 \{\n"
                               ++ "        sum = sum + i\n    \}\n"
                               ++ "    info(str(sum))")),
              "55", "a range is inclusive at both ends")
    assert_eq(said(in_main("    n = 0\n    while n < 5 \{\n"
                               ++ "        n = n + 1\n    \}\n"
                               ++ "    info(str(n))")),
              "5", "a while loop stops on its condition")
}

test_break_and_continue_steer_a_loop() {
    assert_eq(said(in_main("    sum = 0\n    for i in 1..10 \{\n"
                               ++ "        if i > 3 \{ break \}\n"
                               ++ "        sum = sum + i\n    \}\n"
                               ++ "    info(str(sum))")),
              "6", "break leaves the loop with 1 + 2 + 3")
    assert_eq(said(in_main("    sum = 0\n    for i in 1..5 \{\n"
                               ++ "        if i % 2 == 0 \{ continue \}\n"
                               ++ "        sum = sum + i\n    \}\n"
                               ++ "    info(str(sum))")),
              "9", "continue skips the even cells")
}

test_a_return_leaves_the_function_early() {
    src = "pick(n: int) -> int \{\n"
              ++ "    if n > 0 \{\n        return 1\n    \}\n    0\n\}\n"
              ++ "main() -> int \{\n"
              ++ "    info(\"\{pick(5)\} \{pick(0)\}\")\n    0\n\}\n"

    assert_eq(said(src), "1 0", "the early answer wins, the fall-through does")
}

test_interpolation_stringifies_every_shape() {
    assert_eq(said(in_main("    info(\"\{1\} \{1.5\} \{true\} \{[1, 2]\}\")")),
              "1 1.5 true [1, 2]", "each value renders the way str does")
}

test_a_list_is_indexed_and_written() {
    assert_eq(said(in_main("    xs = [10, 20, 30]\n    xs[0] = 99\n"
                               ++ "    info(\"\{xs[0]\} \{len(xs)\}\")")),
              "99 3", "the cell write is seen by the next read")
}

test_chr_and_ord_match_the_native_domain() {
    assert_eq(said(in_main("    info(\"\{ord(chr(200))\} \{ord(chr(65))\}"
                               ++ " \{len(chr(256))\} \{len(chr(0))\}"
                               ++ " \{ord(\\\"\\\")\}\")")),
              "200 65 0 0 -1", "the interpreter's domain is the native one")
}

test_the_math_prelude_answers_what_the_native_backend_answers() {
    assert_eq(said(in_main("    info(\"\{abs(0 - 7)\} \{min(4, 9)\}"
                               ++ " \{max(4, 9)\} \{gcd(54, 24)\}"
                               ++ " \{clamp(42, 0, 10)\} \{sign(0 - 2)\}\")")),
              "7 4 9 6 10 -1", "abs, min, max, gcd, clamp and sign")
}

test_every_str_method_answers_what_the_native_backend_answers() {
    assert_eq(shown("\"hello\".length()"), "5", "length")
    assert_eq(shown("\"aB\".upper()"), "AB", "upper")
    assert_eq(shown("\"aB\".lower()"), "ab", "lower")
    assert_eq(shown("\"  x  \".trim()"), "x", "trim")
    assert_eq(shown("\"hello\".contains(\"ell\")"), "true", "contains")
    assert_eq(shown("\"hello\".starts_with(\"he\")"), "true", "starts_with")
    assert_eq(shown("\"hello\".ends_with(\"lo\")"), "true", "ends_with")
    assert_eq(shown("\"aXbXc\".replace(\"X\", \"-\")"), "a-b-c", "replace")
    assert_eq(shown("\"hello\".substr(1, 3)"), "ell", "substr")
    assert_eq(shown("\"hello\".slice(1, 3)"), "el", "slice")
    assert_eq(shown("\"hello\".index_of(\"l\")"), "2", "index_of")
    assert_eq(shown("\"hello\".index_of(\"z\")"), "-1", "index_of misses")
    assert_eq(shown("\"ab\".repeat(3)"), "ababab", "repeat")
    assert_eq(shown("\"7\".pad_start(3, \"0\")"), "007", "pad_start")
    assert_eq(shown("\"7\".pad_end(3, \"0\")"), "700", "pad_end")
    assert_eq(shown("\"x\".pad_center(6, \".\")"), "..x...", "pad_center")
    assert_eq(shown("\"a,b,c\".split(\",\").length()"), "3", "split")
    assert_eq(shown("\"abc\".chars().length()"), "3", "chars")
    assert_eq(shown("\"abc\".at(1)"), "b", "at")
    assert_eq(shown("\" \".is_whitespace()"), "true", "is_whitespace")
    assert_eq(shown("\"5\".is_ascii_digit()"), "true", "is_ascii_digit")
    assert_eq(shown("\"z\".is_alpha()"), "true", "is_alpha")
}

test_every_list_cell_method_answers_what_the_native_backend_answers() {
    assert_eq(shown("[1, 2, 3].length()"), "3", "length")
    assert_eq(shown("[10, 9, 2].sort().get(0)"), "2", "sort takes the least")
    assert_eq(shown("[10, 9, 2].sort().get(2)"), "10", "and the greatest last")
    assert_eq(shown("[\"b\", \"a\", \"c\"].sort().join(\"|\")"), "a|b|c",
              "strings sort lexically")
    assert_eq(shown("[1, 2, 3].reverse().get(0)"), "3", "reverse")
    assert_eq(shown("[1, 2].push(3).get(2)"), "3", "push")
    assert_eq(shown("[1, 2].push(3).length()"), "3", "push grows by one")
    assert_eq(shown("[1, 2, 3].pop().length()"), "2", "pop")
    assert_eq(shown("[1, 2, 3, 4].slice(1, 3).get(0)"), "2", "slice")
    assert_eq(shown("[1, 2, 3, 4].slice(1, 3).length()"), "2", "slice length")
    assert_eq(shown("[1, 2].contains(2)"), "true", "contains")
    assert_eq(shown("[5, 6].index_of(6)"), "1", "index_of")
    assert_eq(shown("[5, 6].index_of(9)"), "-1", "index_of misses")
    assert_eq(shown("[1, 2, 3].sum()"), "6", "sum")
    assert_eq(shown("[3, 1, 2].min()"), "1", "min")
    assert_eq(shown("[3, 1, 2].max()"), "3", "max")
    assert_eq(shown("[7, 8].first()"), "7", "first")
    assert_eq(shown("[7, 8].last()"), "8", "last")
    assert_eq(shown("[7, 8].get(1)"), "8", "get")
    assert_eq(shown("[\"a\", \"b\"].join(\"-\")"), "a-b", "join")
    assert_eq(shown("[1, 2, 3].set(1, 9).get(1)"), "9", "set")
    assert_eq(shown("[1, 2, 3].set(7, 9).get(1)"), "2", "set past the end")
    assert_eq(shown("[1, 2].insert(0, 9).get(0)"), "9", "insert")
    assert_eq(shown("[1, 2].insert(99, 9).get(2)"), "9", "insert clamps")
    assert_eq(shown("[1, 2, 3].remove(1).get(1)"), "3", "remove")
    assert_eq(shown("[1, 2, 3].remove(9).length()"), "3", "remove past the end")
}

test_every_list_walk_method_answers_what_the_native_backend_answers() {
    assert_eq(shown("[1, 2, 3].map(v => v * 2).sum()"), "12", "map")
    assert_eq(shown("[1, 2, 3].parallel(v => v * 2).sum()"), "12", "parallel")
    assert_eq(shown("[1, 2, 3, 4].filter(v => v > 2).length()"), "2", "filter")
    assert_eq(bound("[1, 2, 3].reduce(0, (a, b) => a + b)"), "6", "reduce")
    assert_eq(bound("[1, 2, 3].fold(10, (a, b) => a + b)"), "16", "fold")
    assert_eq(shown("[4, 7, 9].index_of_by(v => v > 5)"), "1", "index_of_by")
    assert_eq(shown("[4, 7, 9].index_of_by(v => v > 90)"), "-1",
              "index_of_by misses")
    assert_eq(shown("[\"a\", \"b\"].enumerate()"
                        ++ ".map(e => \"\{e.index\}\{e.value\}\").join(\"|\")"),
              "0a|1b", "enumerate")
    assert_eq(shown("[\"bbb\", \"a\", \"cc\"].sort_by(v => v.length())"
                        ++ ".join(\"|\")"),
              "a|cc|bbb", "sort_by")
}

test_map_and_parallel_agree() {
    assert_eq(said(in_main("    a = [1, 2, 3].map(v => v + 1).sum()\n"
                               ++ "    b = [1, 2, 3].parallel(v => v + 1).sum()\n"
                               ++ "    info(\"\{a\}|\{b\}\")")),
              "9|9", "parallel maps rather than answering unit")
}

test_a_closure_sees_the_binding_beside_it() {
    assert_eq(said(in_main("    k = 10\n"
                               ++ "    xs = [1, 2, 3].map(v => v + k)\n"
                               ++ "    inc = n => n + 1\n"
                               ++ "    info(\"\{xs.get(0)\} \{inc(41)\}\")")),
              "11 42", "the lambda reads k, and a bound lambda is callable")
}

test_a_function_passed_by_name_is_applied() {
    src = "even(n: int) -> bool => n % 2 == 0\n"
              ++ "count_if(xs: int[], i: int, pred) -> int =>\n"
              ++ "    i >= xs.length() ? 0"
              ++ " : (pred(xs.get(i)) ? 1 : 0) + count_if(xs, i + 1, pred)\n"
              ++ "main() -> int \{\n    xs = [1, 2, 3, 4, 5, 6]\n"
              ++ "    info(str(count_if(xs, 0, even)))\n    0\n\}\n"

    assert_eq(said(src), "3", "three of the six are even")
}

test_a_record_that_holds_its_own_kind_is_walked() {
    src = "Tree = \{\n    label: str\n    kids: Tree[]\n\}\n"
              ++ "leaf(l: str) -> Tree => Tree \{ label = l, kids = [] \}\n"
              ++ "size(t: Tree) -> int => 1 + ks(t.kids, 0)\n"
              ++ "ks(xs: Tree[], i: int) -> int =>\n"
              ++ "    i >= xs.length() ? 0 : size(xs.get(i)) + ks(xs, i + 1)\n"
              ++ "main() -> int \{\n"
              ++ "    r = Tree \{ label = \"r\", kids = [leaf(\"a\"),"
              ++ " leaf(\"b\")] \}\n    info(str(size(r)))\n    0\n\}\n"

    assert_eq(said(src), "3", "a root and two leaves")
}

test_the_scan_primitives_match_the_native_ones() {
    src = in_main("    s = \"a1 b\"\n    cs = s.chars()\n"
                      ++ "    info(\"\{s.length()\} \{cs.length()\}"
                      ++ " \{cs.get(0)\} \{cs.get(1)\}\")\n"
                      ++ "    info(\"\{cs.get(0).is_alpha()\}"
                      ++ " \{cs.get(1).is_ascii_digit()\}"
                      ++ " \{cs.get(2).is_whitespace()\}\")\n"
                      ++ "    info(cs.slice(0, 2).join(\"\"))")

    assert_eq(said(src), "4 4 a 1\ntrue true true\na1",
              "lengths, access, char classes and slice+join")
}

test_a_runaway_loop_is_stopped_rather_than_hanging() {
    out = ran(in_main("    n = 0\n    while true \{\n"
                          ++ "        n = n + 1\n    \}"))

    assert(out.fault != "", "the guard tripped: {out.fault}")
}

test_a_call_that_never_bottoms_out_is_stopped() {
    out = ran("down(n: int) -> int => down(n + 1)\n"
                  ++ "main() -> int \{\n    info(str(down(1)))\n    0\n\}\n")

    assert_eq(out.fault, "maximum recursion depth reached",
              "the depth guard names itself")
}

test_print_writes_without_a_newline() {
    assert_eq(ran(in_main("    print(\"a\")\n    print(\"b\")")).output,
              "ab", "print does not end the line")
    assert_eq(ran(in_main("    info(\"a\")")).output, "a\n",
              "info does")
}

test_a_lambda_inside_a_call_argument_answers() {
    assert_eq(said(in_main("    info(str([1, 2].reduce(0, (a, b) => a + b)))")),
              "3", "the call is one statement and it adds the two")
}
