Bag = { items: int[] }

grow(n: int) -> int[] {
    xs: int[] = []
    for i in 1..n + 1 {
        xs = xs.push(i)
    }
    xs
}

size_of(xs: int[]) -> int => xs.length()

test_an_accumulator_does_not_rebuild_itself_every_round() {
    before = alloc_count() + reuse_count()
    big = grow(2000)
    spent = alloc_count() + reuse_count() - before

    assert_eq("{big.length()}", "2000", "every round is in it")
    assert(spent > 0, "the counter moved at all: {spent}")
    assert(spent < 40, "grew in place: {spent} allocations for 2000 elements")
}

test_a_holder_taken_after_the_list_grew_keeps_its_own_tail() {
    a = grow(3)
    b = a
    a = a.push(9)
    b = b.push(7)

    assert_eq("{a.get(3)}", "9", "the tip kept the value it appended")
    assert_eq("{b.get(3)}", "7", "and the older holder got its own room")
    assert_eq("{a.length()}", "4", "each of them is one longer")
    assert_eq("{b.length()}", "4", "than the list they shared")
}

test_the_accumulator_holds_every_value_in_order() {
    out = grow(6)

    assert_eq("{out.length()}", "6", "one per round")
    assert_eq("{out.get(0)}", "1", "the first")
    assert_eq("{out.get(5)}", "6", "and the last")
}

test_a_second_holder_reads_what_it_was_given() {
    a = [1, 2]
    b = a
    a = a.push(3)

    assert_eq("{a.length()}", "3", "the one appended to grew")
    assert_eq("{b.length()}", "2", "and the other did not")
    assert_eq("{b.get(1)}", "2", "and it still reads the value it held")
}

test_two_holders_appending_do_not_overwrite_each_other() {
    a = [1, 2]
    b = a
    a = a.push(3)
    b = b.push(9)

    assert_eq("{a.get(2)}", "3", "the first append is where it was put")
    assert_eq("{b.get(2)}", "9", "and the second went somewhere else")
}

test_appending_to_the_list_being_iterated_reads_the_original() {
    f = grow(8)
    seen = 0
    for x in f {
        f = f.push(x)
        seen = seen + x
    }

    assert_eq("{seen}", "36", "the loop saw one through eight, and no more")
    assert_eq("{f.length()}", "16", "eight appended, from the eight there were")
    assert_eq("{f.get(8)}", "1", "and they are the originals, in order")
}

test_a_record_keeps_the_list_it_was_given() {
    d = [1, 2]
    held = Bag { items = d }
    d = d.push(3)

    assert_eq("{d.length()}", "3", "the local grew")
    assert_eq("{held.items.length()}", "2", "the record did not")
}

test_a_function_sees_the_list_as_it_was_passed() {
    c = [1, 2]
    n = size_of(c)
    c = c.push(3)

    assert_eq("{n}", "2", "what the function saw")
    assert_eq("{c.length()}", "3", "and what the caller has now")
}

test_a_list_of_lists_accumulates_row_by_row() {
    rows: int[][] = []
    for i in 1..4 {
        row: int[] = []
        for j in 1..4 {
            row = row.push(i * j)
        }
        rows = rows.push(row)
    }

    assert_eq("{rows.length()}", "3", "three rows")
    assert_eq("{rows.get(2).get(2)}", "9", "and the last cell")
}
