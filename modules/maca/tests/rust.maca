import maca/lexer
import maca/parser
import maca/check
import maca/emit_rust
import std/proc

gate_rust(src: str) -> str =>
    remit_module(annotated(parse_module(lex(src), 0, [])))

gpui_rust(src: str) -> str =>
    remit_module(annotated_on(parse_module(lex(src), 0, []), "rust"))

whole_rust(src: str) -> str =>
    remit_module(annotated(monomorphic(lifted(
        annotated(parse_module(lex(src), 0, []))))))

borrows_of(src: str) -> str[] =>
    kept_borrow_notes(annotated(parse_module(lex(src), 0, [])))

impl_src(methods: str) -> str =>
    "Counter = {{ count: int }}\nCounter : Greet = {{\n" ++ methods ++ "}}\n"

test_main_exits_with_the_code_it_answered() {
    made = gate_rust("main() -> int {{ info(\"hi\") 0 }}")

    assert(made.index_of("fn __maca_main() -> i64") >= 0,
           "the author's main answers a number, so it is not Rust's main")
    assert(made.index_of("std::process::exit(__maca_main() as i32)") >= 0,
           "and the number it answered is the exit code")
    assert(made.index_of("println!") >= 0, "info writes a line")
}

test_a_signature_threads_through_a_recursive_function() {
    made = gate_rust("fib(n: int) -> int => n < 2 ? n : fib(n - 1) + fib(n - 2)")

    assert(made.index_of("fn fib(n: i64) -> i64") >= 0,
           "int is i64 in both directions")
    assert(made.index_of("if (n < 2i64)") >= 0,
           "a ternary is Rust's if, and the literal carries the parameter's type")
}

test_a_record_is_a_struct_and_a_sum_is_an_enum() {
    made = gate_rust("Color = Red | Green | Blue\nPoint = {{ x: int y: int }}")

    assert(made.index_of("enum Color {{ Red, Green, Blue }}") >= 0, "the sum")
    assert(made.index_of("struct Point {{ x: i64, y: i64 }}") >= 0, "the record")
    assert(made.index_of("#[derive(Clone, PartialEq)]") >= 0,
           "a value a match compares must be comparable, and one it reuses cloneable")
}

test_a_variant_with_a_payload_is_a_data_enum() {
    made = gate_rust("Shape = Circle(int) | Rect(int, int)\n"
                     ++ "area(s: Shape) -> int => match s {{"
                     ++ " Circle(r) => r * r Rect(w, h) => w * h }}\n"
                     ++ "main() -> int {{ area(Circle(5)) }}")

    assert(made.index_of("enum Shape {{ Circle(i64), Rect(i64, i64) }}") >= 0,
           "each variant carries the types it declared")
    assert(made.index_of("static SHAPE") < 0,
           "a type declaration is not a constant")
    assert(made.index_of("use Shape::*;") >= 0,
           "the variants are in scope, so the source spelling is the Rust spelling")
    assert(made.index_of("Circle(5i64)") >= 0, "a construction")
    assert(made.index_of("Rect(w, h) =>") >= 0, "and a pattern")
}

test_a_value_read_twice_is_cloned_rather_than_moved() {
    made = gate_rust("Grid = {{ rows: int }}\n"
                     ++ "Outcome = Rows(Grid) | Affected(int)\n"
                     ++ "rows_of(o: Outcome) -> int => match o {{"
                     ++ " Rows(g) => g.rows Affected(n) => n }}\n"
                     ++ "main() -> int {{ r = Rows(Grid {{ rows = 7 }})"
                     ++ " info(\"{{rows_of(r)}}\") rows_of(r) }}")

    assert(made.index_of("rows_of(r.clone())") >= 0,
           "the second read would be a use after move")
}

test_a_reassignment_is_not_a_new_binding() {
    made = gate_rust("sum_to(n: int) -> int {{ acc = 0 i = 1"
                     ++ " while i <= n {{ acc = acc + i i = i + 1 }} acc }}")

    assert(made.index_of("let mut acc = 0i64;") >= 0, "the first write declares")
    assert(made.index_of("acc = (acc + i);") >= 0
               && made.index_of("let mut acc = (acc + i)") < 0,
           "and every later one assigns, or the loop shadows what it is summing")
}

test_a_list_is_a_vec_and_its_length_is_a_number() {
    made = gate_rust("main() -> int {{ xs = [1, 2, 3] xs.length() }}")

    assert(made.index_of("vec![1i64, 2i64, 3i64]") >= 0, "the elements carry their type")
    assert(made.index_of(".len() as i64") >= 0,
           "a Rust length is a usize, and every Maca int is an i64")
    assert(made.index_of("xs::") < 0,
           "a receiver is a value, so its method is reached with a dot")
}

test_break_and_continue_are_lowered_rather_than_defaulted() {
    made = gate_rust("count_to(n: int) -> int {{ i = 0"
                     ++ " while true {{ i = i + 1 if i >= n {{ break }} }} i }}\n"
                     ++ "evens_below(n: int) -> int {{ total = 0"
                     ++ " for i in 1..n {{ if i % 2 == 1 {{ continue }} total = total + i }}"
                     ++ " total }}")

    assert(made.index_of("break") >= 0, "a break is a break")
    assert(made.index_of("continue") >= 0, "and a continue is a continue")
    assert(made.index_of("Default::default()") < 0,
           "a jump is not a value, and standing one in for it silently changes the answer")
}

test_a_record_update_copies_the_base_it_was_given() {
    made = gate_rust("Point = {{ x: int y: int }}\n"
                     ++ "moved(p: Point) -> int {{ q = p with {{ x = 9 }} q.x + q.y }}")

    assert(made.index_of("Default::default()") < 0,
           "the untouched fields come from the base, not from a zero value")
    assert(made.index_of("let mut _w = p.clone(); _w.x = 9i64; _w") >= 0,
           "the copy is taken first, and only the named field is written")
}

test_an_anonymous_literal_takes_the_name_of_the_record_it_fits() {
    made = gate_rust("Point = {{ x: int y: int }}\ncorner() -> Point {{ {{ x = 1, y = 2 }} }}")

    assert(made.index_of("Point {{") >= 0,
           "Rust has no anonymous struct, so the declared one is the answer")
    assert(made.index_of("MacaAnon") < 0, "and nothing is synthesised beside it")
}

test_a_closure_is_a_closure() {
    made = gate_rust("main() -> int {{ f = (n) => n + 1 0 }}")

    assert(made.index_of("|n| (n + 1i64)") >= 0,
           "one parameter, one body, no wrapper")
}

test_a_shift_lowers_to_the_rust_shift() {
    made = gate_rust("mask(n: int) -> int => 1 << n\nhalf(n: int) -> int => n >> 1")

    assert(made.index_of("<< n") >= 0, "Rust moves the bits of an i64 the same way")
    assert(made.index_of(">> 1") >= 0, "and moves them back")
}

test_a_binder_the_arm_writes_is_mutable() {
    made = gate_rust("grown(x: int) -> int {{ out = 0"
                         ++ " match x {{ v => {{ v = v + 1 out = v }} }} out }}")

    assert(made.index_of("mut v => ") >= 0,
           "Maca reassigns the binder where Rust would shadow it")
    assert(made.index_of("v = (v + 1i64)") >= 0,
           "so the arm writes the name rather than declaring it again")
}

test_a_record_of_methods_is_that_type_implemented_for_the_record() {
    made = gate_rust(impl_src("    value = (self) => self.count + 1\n"
                                  ++ "    bump = (self) =>"
                                  ++ " self.count = self.count + 100\n"))

    assert(made.index_of("impl Greet for Counter {{") >= 0,
           "the declared type is the trait, and the bound name is what it is for")
    assert(made.index_of("fn value(&mut self) -> i64 {{") >= 0,
           "the receiver is lent, and the answer is what the body came to")
    assert(made.index_of("fn bump(&mut self) {{") >= 0,
           "a method whose body only assigns answers nothing")
    assert(made.index_of("self_mc") < 0,
           "`self` is Rust's own word here, so it is not escaped away")
    assert(made.index_of("MacaAnon") < 0,
           "the record of methods is the implementation, not a value of a shape")
    assert(made.index_of("fn Counter()") < 0,
           "and it is not a constant either")
    assert(whole_rust(impl_src("    value = (self) => self.count + 1\n"))
               .index_of("impl Greet for Counter {{") >= 0,
           "and a method is not lifted out into a function of its own")
}

test_a_method_borrows_every_type_its_module_never_declared() {
    made = gate_rust(impl_src("    bump = (self, w: Window, n: int)"
                                  ++ " -> AnyElement => self.count\n"))

    assert(made.index_of("w: &mut Window") >= 0,
           "a foreign value belongs to the caller, so it is lent for the call")
    assert(made.index_of("mut n: i64") >= 0,
           "a type the language owns is passed by value")
    assert(made.index_of("-> AnyElement") >= 0,
           "and the method answers what it declared, foreign or not")
}

test_a_borrowed_value_may_be_read_and_passed_on_but_not_kept() {
    kept = borrows_of("Holder = {{ saved: Window }}\nHolder : Keep = {{\n"
                          ++ "    keep = (self, w: Window) -> int =>"
                          ++ " Holder {{ saved = w }}.saved\n}}\n")
    given = borrows_of("Holder = {{ saved: int }}\nHolder : Keep = {{\n"
                           ++ "    keep = (self, w: Window) -> int =>"
                           ++ " peek(w)\n}}\n")
    back = borrows_of("Holder = {{ saved: int }}\nHolder : Keep = {{\n"
                          ++ "    keep = (self, w: Window) -> Window => w\n}}\n")

    assert_eq(str(kept.length()), "1", "a borrow put in a record never comes back")
    assert(kept.get(0).index_of("`w` in method `keep`") >= 0,
           "and the refusal names the parameter and the method")
    assert_eq(str(given.length()), "0", "reading it and passing it on is fine")
    assert_eq(str(back.length()), "1", "answering with it is not")
}

maca_bin() -> str {
    named = env_or("MACA", "target/release/maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

scratch() -> str {
    dir = env_or("TMPDIR", "/tmp") ++ "/maca-rust-foreign"
    make_dir(dir)

    dir
}

built_rust(name: str, src: str) -> int {
    at = "{scratch()}/{name}.maca"
    write_file(at, src)

    exec(maca_bin(), ["build", "--target", "rust", at, "-o",
                      "{scratch()}/{name}"])
}

emitted_rust(name: str, src: str) -> str {
    built_rust(name, src)

    read_file("{scratch()}/{name}.rs")
}

ClosureSrc = "import \"shim.rs\" \"\"\"\nfn apply(f: impl Fn(i64) -> i64, x: i64)"
    ++ " -> i64 {{ f(x) }}\n\"\"\"\n\n"
    ++ "main() -> int {{\n    r = apply(n => n + 1, 41)\n"
    ++ "    info(\"apply = {{r}}\")\n    r\n}}\n"

TraitSrc = "import \"shim.rs\" \"\"\"\ntrait Greet {{ fn value(&mut self) -> i64; }}"
    ++ "\n\"\"\"\n\nCounter = {{ count: int }}\n"
    ++ "Counter : Greet = {{\n    value = (self) => self.count + 1\n}}\n\n"
    ++ "main() -> int {{\n    c = Counter {{ count = 41 }}\n"
    ++ "    v = c.value()\n    info(\"value = {{v}}\")\n    v\n}}\n"

rustc_here() -> bool =>
    exec("sh", ["-c", "command -v rustc >/dev/null 2>&1"]) == 0

CoreSrc = "Color = Red | Green | Blue\n"
    ++ "Point = {{ x: int y: int }}\n"
    ++ "Grid = {{ rows: int }}\n"
    ++ "Outcome = Rows(Grid) | Affected(int)\n"
    ++ "fib(n: int) -> int => n < 2 ? n : fib(n - 1) + fib(n - 2)\n"
    ++ "warmth(c: Color) -> int => match c {{"
    ++ " Red => 2 Green => 1 Blue => 0 }}\n"
    ++ "sum_to(n: int) -> int {{ acc = 0 i = 1"
    ++ " while i <= n {{ acc = acc + i i = i + 1 }} acc }}\n"
    ++ "describe(o: Outcome) -> int => match o {{"
    ++ " Rows(g) => g.rows Affected(n) => n }}\n"
    ++ "main() -> int {{\n    p = Point {{ x = 3, y = 4 }}\n"
    ++ "    r = Rows(Grid {{ rows = 7 }})\n"
    ++ "    info(\"fib={{fib(10)}} warmth={{warmth(Green)}}"
    ++ " sum={{sum_to(5)}} px={{p.x}} rows={{describe(r)}}"
    ++ " affected={{describe(Affected(42))}}\")\n    sum_to(5)\n}}\n"

ForeignSrc = "import \"std::time::Duration\"\n\n"
    ++ "main() -> int {{\n    d = Duration.from_secs(5)\n"
    ++ "    total = d.as_secs()\n"
    ++ "    info(\"duration = {{total}} secs\")\n    int(total)\n}}\n"

AsyncSrc = "work(n: int) -> int => n * 2\n\nmain() -> int {{\n"
    ++ "    a = spawn work(21)\n    b = spawn work(10)\n"
    ++ "    info(\"{{await a}} {{await b}}\")\n    0\n}}\n"

AnonSrc = "main() -> int {{\n"
    ++ "    c = {{ host = \"localhost\", port = 8080 }}\n"
    ++ "    info(\"{{c.host}}:{{c.port}}\")\n"
    ++ "    d = {{ port = 80, host = \"example.com\" }}\n"
    ++ "    info(\"{{d.host}}:{{d.port}}\")\n    0\n}}\n"

DeclaredRetSrc = "import \"shim.rs\" \"\"\"\n"
    ++ "pub struct Div {{ pub s: String }}\n"
    ++ "pub struct AnyElement {{ pub s: String }}\n"
    ++ "impl Div {{ pub fn into_any_element(self) -> AnyElement"
    ++ " {{ AnyElement {{ s: self.s }} }} }}\n"
    ++ "pub fn div() -> Div {{ Div {{ s: \"count \".to_string()"
    ++ " }} }}\n"
    ++ "pub trait Render {{ fn render(&mut self) -> AnyElement; }}\n"
    ++ "\"\"\"\n\nCounter = {{ count: int }}\n\n"
    ++ "Counter : Render = {{\n"
    ++ "    render = (self) -> AnyElement => div().into_any_element()\n}}\n\n"
    ++ "main() -> int {{\n    c = Counter {{ count = 41 }}\n"
    ++ "    info(\"{{c.render().s}}{{c.count}}\")\n    0\n}}\n"

BorrowSrc = "import \"shim.rs\" \"\"\"\n"
    ++ "pub struct Window {{ pub n: i64 }}\n"
    ++ "pub trait Bump {{ fn bump(&mut self, w: &mut Window) -> i64;"
    ++ " }}\n"
    ++ "pub fn peek(w: &mut Window) -> i64 {{ w.n }}\n\"\"\"\n\n"
    ++ "Counter = {{ count: int }}\n\nCounter : Bump = {{\n"
    ++ "    bump = (self, w: Window) -> int => peek(w) + self.count\n}}\n\n"
    ++ "main() -> int {{\n    c = Counter {{ count = 40 }}\n"
    ++ "    info(\"{{c.bump(Window {{ n = 2 }})}}\")\n    0\n}}\n"

ran_rust(name: str, src: str, said: str, code: str) -> bool {
    at = "{scratch()}/{name}"

    assert_eq(str(built_rust(name, src)), "0",
              "{name} did not build through rustc")

    got = capture(at, [])

    assert(got.contains(said), "{name} printed {got}, wanted {said}")
    assert_eq(str(exec(at, [])), code,
              "{name} left an exit code that is not what main answered")

    true
}

test_the_core_language_computes_the_same_answers_through_rustc() {
    if !rustc_here() {
        assert(true, "running what was emitted needs rustc, which this host "
                         ++ "has not got")
    } else {
        ran_rust("core_run", CoreSrc,
                 "fib=55 warmth=1 sum=15 px=3 rows=7 affected=42", "15")
    }
}

test_a_foreign_type_is_reached_by_its_own_path() {
    if !rustc_here() {
        assert(true, "running what was emitted needs rustc, which this host "
                         ++ "has not got")
    } else {
        made = emitted_rust("foreign_std", ForeignSrc)

        assert(made.index_of("Duration::from_secs(5)") >= 0,
               "an associated function is reached with `::`, and a foreign"
                   ++ " call takes the literal Rust would type for itself")
        ran_rust("foreign_std", ForeignSrc, "duration = 5 secs", "5")
    }
}

test_spawn_and_await_reach_this_target_too() {
    if !rustc_here() {
        assert(true, "running what was emitted needs rustc, which this host "
                         ++ "has not got")
    } else {
        ran_rust("async_run", AsyncSrc, "42 20", "0")
    }
}

test_a_literal_of_no_named_type_still_gets_one() {
    if !rustc_here() {
        assert(true, "running what was emitted needs rustc, which this host "
                         ++ "has not got")
    } else {
        ran_rust("anon_run", AnonSrc, "localhost:8080", "0")
        assert(capture("{scratch()}/anon_run", []).contains("example.com:80"),
               "the same shape written in another order is the same type")
    }
}

test_a_tag_a_raw_block_declares_is_that_function_and_not_an_element() {
    made = emitted_rust("declared_ret", DeclaredRetSrc)

    assert(made.index_of("maca_element(\"div\"") < 0,
           "`div` is a function the block declares, so it is not an element")
    assert(made.index_of("div().into_any_element()") >= 0,
           "and the method a trait declared answers what it said it would")

    if !rustc_here() {
        assert(true, "running what was emitted needs rustc, which this host "
                         ++ "has not got")
    } else {
        ran_rust("declared_ret", DeclaredRetSrc, "count 41", "0")
    }
}

test_a_foreign_argument_is_lent_at_the_call_site_as_well() {
    made = emitted_rust("borrowed_param", BorrowSrc)

    assert(made.index_of("bump(&mut Window") >= 0,
           "the method borrows it, so the caller has to lend it")

    if !rustc_here() {
        assert(true, "running what was emitted needs rustc, which this host "
                         ++ "has not got")
    } else {
        ran_rust("borrowed_param", BorrowSrc, "42", "0")
    }
}

test_a_crate_path_import_is_written_back_as_a_use_item() {
    made = emitted_rust("use_item",
                        "import \"std::time::Duration\"\n\n"
                            ++ "main() -> int => 0\n")

    assert(made.index_of("use std::time::Duration;") >= 0,
           "the path the program asked for is a use item, not a dropped line")
}

test_a_raw_block_is_pasted_as_the_rust_it_was_written_in() {
    made = emitted_rust("raw_block", ClosureSrc)

    assert(made.index_of("fn apply(f: impl Fn(i64) -> i64, x: i64) -> i64")
               >= 0,
           "the block reaches the unit as the source it was, braces and all")
    assert(made.index_of("apply(maca_lambda") >= 0,
           "and the call the program wrote reaches it")
}

test_a_call_into_a_raw_block_is_not_an_undefined_function() {
    if !rustc_here() {
        assert(true, "running what was emitted needs rustc, which this host "
                         ++ "has not got")
    } else {
        assert_eq(str(built_rust("closure_run", ClosureSrc)), "0",
                  "a name the block declares is declared, so the build is clean")
        assert_eq(capture("{scratch()}/closure_run", []).trim(), "apply = 42",
                  "and what it answered is what the Rust function computed")
    }
}

test_a_trait_a_raw_block_declared_is_implemented_for_a_record() {
    if !rustc_here() {
        assert(true, "running what was emitted needs rustc, which this host "
                         ++ "has not got")
    } else {
        assert_eq(str(built_rust("trait_run", TraitSrc)), "0",
                  "the trait is declared by the block, and implemented here")
        assert_eq(capture("{scratch()}/trait_run", []).trim(), "value = 42",
                  "and the method runs")
    }
}

test_what_a_function_returns_picks_between_gpui_and_text() {
    made = gpui_rust("view() -> Element =>\n    div(class=\"flex gap-2\", id=\"root\", span(\"hi\"))\n\nshell(body: str) -> str => div(class=\"wrap\", body)\n")

    assert(made.index_of("fn view() -> Div {{ div().flex().gap_2()") >= 0,
           "an Element is gpui's box, styled by the class it was written with: {made}")
    assert(made.index_of(".child(div()") >= 0,
           "and a child is a child, every tag gpui lacks being a div: {made}")
    assert(made.index_of("fn shell(body: String) -> String {{ maca_element") >= 0,
           "while a function that says it answers text still builds text, which is what the declared result is for: {made}")
}
