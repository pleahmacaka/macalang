    "static int maca_file_exists(const char* p) {{ struct stat st; return stat(p, &st) == 0; }}\nstatic int maca_is_dir(const char* p) {{ struct stat st; return stat(p, &st) == 0 && S_ISDIR(st.st_mode); }}\n" +
    "static long long maca_file_size(const char* p) {{ struct stat st; return stat(p, &st) == 0 ? (long long)st.st_size : -1; }}\nstatic long long maca_modified_ms(const char* p) {{ struct stat st; return stat(p, &st) == 0 ? (long long)(st.st_mtime * 1000) : -1; }}\n" +
    "static int maca_make_dir(const char* p) {{ char* d = maca_cat(p, \"\"); for (char* q = d + 1; *q; q++) if (*q == '/') {{ *q = 0; maca_mkdir(d); *q = '/'; }} maca_mkdir(d); return maca_is_dir(d); }}\n" +
    "static int maca_remove_file(const char* p) {{ return unlink(p) == 0; }}\nstatic int maca_remove_dir(const char* p) {{ DIR* d = opendir(p); if (!d) return 0; struct dirent* it; while ((it = readdir(d))) {{ if (strcmp(it->d_name, \".\") == 0 || strcmp(it->d_name, \"..\") == 0) continue; char* c = maca_cat(p, maca_cat(\"/\", it->d_name)); if (maca_is_dir(c)) maca_remove_dir(c); else maca_remove_file(c); }} closedir(d); return rmdir(p) == 0; }}\n" +
    "static int maca_copy_bytes(const char* src, const char* dst) {{ FILE* a = fopen(src, \"rb\"); if (!a) return 0; FILE* b = fopen(dst, \"wb\"); if (!b) {{ fclose(a); return 0; }} char buf[8192]; size_t n; while ((n = fread(buf, 1, sizeof buf, a)) > 0) fwrite(buf, 1, n, b); fclose(a); fclose(b); return 1; }}\n" +
    "static MacaList maca_list_dir(const char* p) {{ MacaList l; l.len = 0; int cap = 16; l.data = maca_cells((size_t)cap * sizeof(long long)); DIR* d = opendir(p); if (!d) return l; struct dirent* it; while ((it = readdir(d))) {{ if (strcmp(it->d_name, \".\") == 0 || strcmp(it->d_name, \"..\") == 0) continue; if (l.len == cap) {{ cap *= 2; long long* g = maca_cells((size_t)cap * sizeof(long long)); memcpy(g, l.data, (size_t)l.len * sizeof(long long)); l.data = g; }} l.data[l.len++] = (long long)maca_cat(it->d_name, \"\"); }} closedir(d); if (l.len > 1) qsort(l.data, (size_t)l.len, sizeof(long long), maca_cmp_cell_str); return l; }}\n" +
    "static char* maca_real_path(const char* p) {{ char* r = malloc(4096); if (!maca_full_path(p, r)) return maca_cat(p, \"\"); return r; }}\n" +
    "static char* maca_path_join(const char* a, const char* b) {{ if (!*a) return maca_cat(b, \"\"); if (!*b) return maca_cat(a, \"\"); return a[strlen(a) - 1] == '/' ? maca_cat(a, b) : maca_cat(a, maca_cat(\"/\", b)); }}\n" +
    "static long long maca_now_ms(void) {{ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (long long)(ts.tv_sec * 1000 + ts.tv_nsec / 1000000); }}\n" +
    "static char* maca_now_iso(void) {{ time_t t = time(NULL); struct tm g; maca_gmtime(&t, &g); char* r = malloc(32); strftime(r, 32, \"%Y-%m-%dT%H:%M:%SZ\", &g); return r; }}\n" +
    "static char* maca_format_time(long long ms, const char* fmt) {{ time_t t = (time_t)(ms / 1000); struct tm g; maca_gmtime(&t, &g); char* r = malloc(128); if (!strftime(r, 128, fmt, &g)) r[0] = 0; return r; }}\n" +
    "static void maca_sleep_ms(int ms) {{ if (ms > 0) usleep((unsigned)ms * 1000); }}\n" +
    "static char* maca_input(const char* prompt) {{ if (prompt && *prompt) {{ printf(\"%s\", prompt); fflush(stdout); }} size_t cap = 128, n = 0; char* b = malloc(cap); int c; while ((c = fgetc(stdin)) != EOF && c != '\\n') {{ if (n + 1 >= cap) {{ cap *= 2; char* g = malloc(cap); memcpy(g, b, n); b = g; }} b[n++] = (char)c; }} b[n] = 0; return b; }}\nstatic int maca_at_eof(void) {{ int c = fgetc(stdin); if (c == EOF) return 1; ungetc(c, stdin); return 0; }}\n" +
    "static char* maca_attr(const char* name, const char* value) {{ if (!name || !*name) return maca_cat(\"\", \"\"); size_t n = strlen(name), v = strlen(value); char* r = malloc(n + v * 6 + 5); char* w = r; *w++ = ' '; memcpy(w, name, n); w += n; *w++ = '='; *w++ = '\"'; for (size_t i = 0; i < v; i++) {{ char c = value[i]; if (c == '&') {{ memcpy(w, \"&amp;\", 5); w += 5; }} else if (c == '<') {{ memcpy(w, \"&lt;\", 4); w += 4; }} else if (c == '>') {{ memcpy(w, \"&gt;\", 4); w += 4; }} else if (c == '\"') {{ memcpy(w, \"&quot;\", 6); w += 6; }} else {{ *w++ = c; }} }} *w++ = '\"'; *w = 0; return r; }}\n" +
    "static char* maca_flag(const char* name, int on) {{ if (!on || !name || !*name) return maca_cat(\"\", \"\"); return maca_cat(\" \", name); }}\n" +
    "static int maca_void_tag(const char* t) {{ const char* v[] = {{\"area\", \"base\", \"br\", \"col\", \"embed\", \"hr\", \"img\", \"input\", \"link\", \"meta\", \"source\", \"track\", \"wbr\", 0}}; for (int i = 0; v[i]; i++) if (strcmp(t, v[i]) == 0) return 1; return 0; }}\n" +
    "static char* maca_element(const char* tag, const char* attrs, const char* kids) {{ size_t t = strlen(tag), a = strlen(attrs), k = strlen(kids); char* r = malloc(t * 2 + a + k + 6); char* w = r; *w++ = '<'; memcpy(w, tag, t); w += t; memcpy(w, attrs, a); w += a; *w++ = '>'; if (!maca_void_tag(tag)) {{ memcpy(w, kids, k); w += k; *w++ = '<'; *w++ = '/'; memcpy(w, tag, t); w += t; *w++ = '>'; }} *w = 0; return r; }}\n"

c_errors(code: str) -> str {
    if c_uses(code, "maca_try_push") {
        "#include <setjmp.h>\n" +
        "static jmp_buf maca_handlers[256];\nstatic int maca_handler_top = 0;\nstatic const char* maca_caught = \"\";\n" +
        "static jmp_buf* maca_try_push(void) {{ return &maca_handlers[maca_handler_top++]; }}\n" +
        "static void maca_try_pop(void) {{ if (maca_handler_top > 0) maca_handler_top--; }}\n" +
        "static char* maca_last_fail(void) {{ return maca_cat(maca_caught, \"\"); }}\n" +
        "static int maca_fail(const char* s) {{ if (maca_handler_top > 0) {{ maca_caught = s ? s : \"\"; longjmp(maca_handlers[--maca_handler_top], 1); }} fprintf(stderr, \"error: %s\\n\", s ? s : \"\"); exit(1); return 0; }}\n"
    } else {
        "static int maca_fail(const char* s) {{ fprintf(stderr, \"error: %s\\n\", s ? s : \"\"); exit(1); return 0; }}\n"
    }
}

c_uses(code: str, name: str) -> bool =>
    code.index_of(name) >= 0

/** The emitted C with its string literals dropped, so a runtime helper a
 * program only names in its own text is not read as a call to it.
 */
c_bare(code: str) -> str =>
    c_unquoted(code.split("\""), 0, true, []).join(" ")

c_unquoted(parts: str[], i: int, live: bool, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else {
        part = parts.get(i)
        next = c_escaped(part) ? live : !live

        c_unquoted(parts, i + 1, next, live ? acc.push(part) : acc)
    }
}

c_escaped(part: str) -> bool =>
    c_slashes(part, part.length() - 1, 0) % 2 == 1

c_slashes(s: str, i: int, n: int) -> int =>
    i >= 0 && s.at(i) == "\\" ? c_slashes(s, i - 1, n + 1) : n

c_net_headers() -> str =>
    "#include <pthread.h>\n#include <sys/socket.h>\n" +
    "#include <netinet/in.h>\n#include <netinet/tcp.h>\n" +
    "#include <arpa/inet.h>\n"

c_process(code: str) -> str {
    if c_uses(code, "maca_exec") || c_uses(code, "maca_capture") {
        "#ifdef _WIN32\n" + c_process_win() + "#else\n" +
            c_process_posix() + "#endif\n"
    } else {
        ""
    }
}

/** Windows has no `fork`, so a run is a spawn and a capture is a pipe the shell
 * opens.
 */
c_process_win() -> str =>
    "static char* maca_quoted(const char* s) {{ char* r = malloc(strlen(s) * 2 + 3); char* w = r; *w++ = 34; for (const char* p = s; *p; p++) {{ if (*p == 34) *w++ = 92; *w++ = *p; }} *w++ = 34; *w = 0; return r; }}\n" +
        "static int maca_exec(const char* cmd, MacaList args) {{ const char** argv = malloc((args.len + 2) * sizeof(char*)); argv[0] = cmd; for (int i = 0; i < args.len; i++) argv[i + 1] = (const char*)args.data[i]; argv[args.len + 1] = NULL; intptr_t r = _spawnvp(_P_WAIT, cmd, argv); return r < 0 ? -1 : (int)r; }}\n" +
        "static char* maca_capture_fd(const char* cmd, MacaList args, int child_fd) {{ char* line = maca_quoted(cmd); for (int i = 0; i < args.len; i++) line = maca_cat(maca_cat(line, \" \"), maca_quoted((const char*)args.data[i])); line = maca_cat(line, child_fd == 2 ? \" 2>&1 1>NUL\" : \"\"); size_t _n = strlen(line); char* _w = malloc(_n + 3); _w[0] = 34; memcpy(_w + 1, line, _n); _w[_n + 1] = 34; _w[_n + 2] = 0; line = _w; FILE* p = _popen(line, \"r\"); if (!p) return maca_cat(\"\", \"\"); char* out = malloc(1); out[0] = 0; size_t n = 0; char buf[4096]; size_t got; while ((got = fread(buf, 1, sizeof(buf), p)) > 0) {{ out = realloc(out, n + got + 1); memcpy(out + n, buf, got); n += got; out[n] = 0; }} _pclose(p); return out; }}\n" +
        "static char* maca_capture(const char* cmd, MacaList args) {{ return maca_capture_fd(cmd, args, 1); }}\n" +
        "static char* maca_capture_err(const char* cmd, MacaList args) {{ return maca_capture_fd(cmd, args, 2); }}\n"

c_process_posix() -> str =>
    "#include <sys/wait.h>\n" +
        "static int maca_exec(const char* cmd, MacaList args) {{ char** argv = malloc((args.len + 2) * sizeof(char*)); argv[0] = (char*)cmd; for (int i = 0; i < args.len; i++) argv[i + 1] = (char*)args.data[i]; argv[args.len + 1] = NULL; pid_t pid = fork(); if (pid < 0) return -1; if (pid == 0) {{ execvp(cmd, argv); _exit(127); }} int st = 0; if (waitpid(pid, &st, 0) < 0) return -1; if (WIFEXITED(st)) return WEXITSTATUS(st); if (WIFSIGNALED(st)) return 128 + WTERMSIG(st); return -1; }}\n" +
        "static char* maca_capture_fd(const char* cmd, MacaList args, int child_fd) {{ int fd[2]; if (pipe(fd) < 0) return maca_cat(\"\", \"\"); char** argv = malloc((size_t)(args.len + 2) * sizeof(char*)); argv[0] = (char*)cmd; for (int i = 0; i < args.len; i++) argv[i + 1] = (char*)args.data[i]; argv[args.len + 1] = NULL; pid_t pid = fork(); if (pid < 0) {{ close(fd[0]); close(fd[1]); return maca_cat(\"\", \"\"); }} if (pid == 0) {{ close(fd[0]); dup2(fd[1], child_fd); close(fd[1]); execvp(cmd, argv); _exit(127); }} close(fd[1]); size_t cap = 4096, n = 0; char* b = malloc(cap); ssize_t got; while ((got = read(fd[0], b + n, cap - n - 1)) > 0) {{ n += (size_t)got; if (n + 1 >= cap) {{ cap *= 2; char* g = malloc(cap); memcpy(g, b, n); b = g; }} }} close(fd[0]); int st = 0; waitpid(pid, &st, 0); b[n] = 0; return b; }}\n" +
        "static char* maca_capture(const char* cmd, MacaList args) {{ return maca_capture_fd(cmd, args, 1); }}\n" +
        "static char* maca_capture_err(const char* cmd, MacaList args) {{ return maca_capture_fd(cmd, args, 2); }}\n"

c_threads(code: str) -> str {
    if c_uses(code, "maca_spawn") || c_uses(code, "MacaFuture") {
        "#include <pthread.h>\n" +
        "typedef long long (*MacaTask)(long long);\ntypedef long long (*MacaTask2)(long long, long long);\n" +
        "typedef struct {{ pthread_t th; MacaTask fn; MacaTask2 fn2; long long a; long long b; long long out; int done; }} MacaFuture;\n" +
        "static void* maca_task_run(void* p) {{ MacaFuture* f = (MacaFuture*)p; f->out = f->fn2 ? f->fn2(f->a, f->b) : f->fn(f->a); return NULL; }}\n" +
        "static MacaFuture* maca_spawn(MacaTask fn, long long a) {{ MacaFuture* f = malloc(sizeof(MacaFuture)); f->fn = fn; f->fn2 = 0; f->a = a; f->b = 0; f->out = 0; f->done = 0; pthread_create(&f->th, NULL, maca_task_run, f); return f; }}\n" +
        "static MacaFuture* maca_spawn2(MacaTask2 fn, long long a, long long b) {{ MacaFuture* f = malloc(sizeof(MacaFuture)); f->fn = 0; f->fn2 = fn; f->a = a; f->b = b; f->out = 0; f->done = 0; pthread_create(&f->th, NULL, maca_task_run, f); return f; }}\n" +
        "static long long maca_await(MacaFuture* f) {{ if (!f) return 0; if (!f->done) {{ pthread_join(f->th, NULL); f->done = 1; }} return f->out; }}\n"
    } else {
        ""
    }
}

c_sockets(code: str) -> str {
    if c_uses(code, "http_listen") || c_uses(code, "http_fetch") {
        c_net_headers() + c_http()
    } else {
        ""
    }
}

c_http() -> str =>
    "#define MACA_HTTP_MAX (1 << 20)\n" +
    "#define MACA_HTTP_IDLE 30\n" +
    "typedef const char* (*MacaHttpFn)(const char*);\n" +
    "typedef const char* (*MacaHttpFat)(MacaList, const char*);\n" +
    "typedef struct {{ int fd; MacaFn fn; }} MacaHttpConn;\n" +
    "typedef struct {{ char* buf; size_t cap, len; }} MacaHttpBuf;\n" +
    "static int maca_http_write(int fd, const char* b, size_t n) {{ size_t off = 0; while (off < n) {{ ssize_t w = send(fd, b + off, n - off, MSG_NOSIGNAL); if (w <= 0) return -1; off += (size_t)w; }} return 0; }}\n" +
    "static long long maca_http_head_end(const char* b, size_t n) {{ for (size_t i = 0; i + 3 < n; i++) if (b[i] == '\\r' && b[i+1] == '\\n' && b[i+2] == '\\r' && b[i+3] == '\\n') return (long long)(i + 4); for (size_t i = 0; i + 1 < n; i++) if (b[i] == '\\n' && b[i+1] == '\\n') return (long long)(i + 2); return -1; }}\n" +
    "static long long maca_http_length(const char* h, size_t n) {{ for (size_t i = 0; i + 15 < n; i++) {{ if (i && h[i-1] != '\\n') continue; if (strncasecmp(h + i, \"content-length:\", 15) != 0) continue; size_t j = i + 15; while (j < n && (h[j] == ' ' || h[j] == '\\t')) j++; if (j >= n || h[j] < '0' || h[j] > '9') return -1; long long v = 0; while (j < n && h[j] >= '0' && h[j] <= '9') {{ if (v > (long long)MACA_HTTP_MAX) return -1; v = v * 10 + (h[j] - '0'); j++; }} return v; }} return 0; }}\n" +
    "static int maca_http_chunked(const char* h, size_t n) {{ for (size_t i = 0; i + 18 < n; i++) {{ if (i && h[i-1] != '\\n') continue; if (strncasecmp(h + i, \"transfer-encoding:\", 18) == 0) return 1; }} return 0; }}\n" +
    "static int maca_http_closing(const char* m) {{ for (const char* p = m; *p; p++) {{ if (p != m && p[-1] != '\\n') continue; if (p[0] == '\\r' || p[0] == '\\n') break; if (strncasecmp(p, \"connection:\", 11) != 0) continue; const char* v = p + 11; while (*v == ' ' || *v == '\\t') v++; return strncasecmp(v, \"close\", 5) == 0; }} return 0; }}\n" +
    "static void maca_http_refuse(int fd, const char* line, const char* body) {{ char out[256]; int n = snprintf(out, sizeof(out), \"HTTP/1.1 %s\\r\\nContent-Type: text/plain; charset=utf-8\\r\\nContent-Length: %d\\r\\nConnection: close\\r\\n\\r\\n%s\", line, (int)strlen(body), body); if (n > 0) maca_http_write(fd, out, (size_t)n); }}\n" +
    "static int maca_http_take(int fd, MacaHttpBuf* b, char** out) {{ for (;;) {{ long long head = maca_http_head_end(b->buf, b->len); if (head >= 0) {{ if (maca_http_chunked(b->buf, (size_t)head)) return 3; long long want = maca_http_length(b->buf, (size_t)head); if (want < 0) return 4; if (head + want > (long long)MACA_HTTP_MAX) return 2; if ((long long)b->len >= head + want) {{ size_t take = (size_t)(head + want); char* req = malloc(take + 1); if (!req) return 1; memcpy(req, b->buf, take); req[take] = 0; memmove(b->buf, b->buf + take, b->len - take); b->len -= take; *out = req; return 0; }} }} if (b->len >= MACA_HTTP_MAX) return 2; if (b->len + 1 >= b->cap) {{ size_t cap = b->cap ? b->cap * 2 : 8192; char* g = realloc(b->buf, cap); if (!g) return 1; b->buf = g; b->cap = cap; }} ssize_t r = recv(fd, b->buf + b->len, b->cap - b->len - 1, 0); if (r <= 0) return 1; b->len += (size_t)r; b->buf[b->len] = 0; }} }}\n" +
    "static void* maca_http_client(void* arg) {{ MacaHttpConn* c = (MacaHttpConn*)arg; int fd = c->fd; MacaFn fn = c->fn; free(c); struct timeval tv; tv.tv_sec = MACA_HTTP_IDLE; tv.tv_usec = 0; setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)); setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv)); MacaHttpBuf b; b.buf = NULL; b.cap = 0; b.len = 0; for (;;) {{ char* req = NULL; int st = maca_http_take(fd, &b, &req); if (st == 2) {{ maca_http_refuse(fd, \"413 Payload Too Large\", \"413 Payload Too Large\\n\"); break; }} if (st == 3) {{ maca_http_refuse(fd, \"501 Not Implemented\", \"501 Not Implemented\\n\"); break; }} if (st == 4) {{ maca_http_refuse(fd, \"400 Bad Request\", \"400 Bad Request\\n\"); break; }} if (st != 0) break; int done = maca_http_closing(req); const char* reply = fn.env.len ? ((MacaHttpFat)fn.fn)(fn.env, req) : ((MacaHttpFn)fn.fn)(req); free(req); if (!reply) break; if (maca_http_write(fd, reply, strlen(reply))) break; if (done || maca_http_closing(reply)) break; }} free(b.buf); close(fd); return NULL; }}\n" +
    "long long http_listen(long long port) {{ int srv = socket(AF_INET, SOCK_STREAM, 0); if (srv < 0) return -1; int one = 1; setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one)); struct sockaddr_in a; memset(&a, 0, sizeof(a)); a.sin_family = AF_INET; a.sin_addr.s_addr = INADDR_ANY; a.sin_port = htons((unsigned short)port); if (bind(srv, (struct sockaddr*)&a, sizeof(a)) < 0) {{ close(srv); return -2; }} if (listen(srv, 512) < 0) {{ close(srv); return -3; }} return srv; }}\n" +
    "static int maca_http_serve(int srv, MacaFn fn) {{ if (!fn.fn) return -1; for (;;) {{ int fd = accept(srv, 0, 0); if (fd < 0) continue; int one = 1; setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one)); MacaHttpConn* c = malloc(sizeof(MacaHttpConn)); if (!c) {{ close(fd); continue; }} c->fd = fd; c->fn = fn; pthread_t th; if (pthread_create(&th, 0, maca_http_client, c) != 0) {{ free(c); close(fd); continue; }} pthread_detach(th); }} return 0; }}\n" +
    "const char* http_fetch(const char* host, long long port, const char* request) {{ int fd = socket(AF_INET, SOCK_STREAM, 0); if (fd < 0) return \"\"; struct sockaddr_in a; memset(&a, 0, sizeof(a)); a.sin_family = AF_INET; a.sin_port = htons((unsigned short)port); inet_pton(AF_INET, host && *host ? host : \"127.0.0.1\", &a.sin_addr); if (connect(fd, (struct sockaddr*)&a, sizeof(a)) < 0) {{ close(fd); return \"\"; }} if (maca_http_write(fd, request, strlen(request))) {{ close(fd); return \"\"; }} shutdown(fd, SHUT_WR); size_t cap = 8192, n = 0; char* buf = malloc(cap); if (!buf) {{ close(fd); return \"\"; }} for (;;) {{ if (n + 1 >= cap) {{ cap *= 2; char* g = realloc(buf, cap); if (!g) {{ free(buf); close(fd); return \"\"; }} buf = g; }} ssize_t r = recv(fd, buf + n, cap - n - 1, 0); if (r <= 0) break; n += (size_t)r; }} buf[n] = 0; close(fd); return buf; }}\n" +
    "long long http_accept_loop(long long srv, MacaFn handler) {{ return maca_http_serve(srv, handler); }}\n"

c_mqtt(protos: str) -> str {
    if protos.index_of("mqtt_") < 0 {
        ""
    } else {
        c_net_headers() +
        "#define MACA_MQTT_MAX_SUBS 8192\n" +
        "typedef struct {{ int fd; char pat[256]; }} MacaMqttSub;\n" +
        "static MacaMqttSub maca_mqtt_subs[MACA_MQTT_MAX_SUBS];\n" +
        "static int maca_mqtt_nsubs = 0;\n" +
        "static pthread_mutex_t maca_mqtt_lock = PTHREAD_MUTEX_INITIALIZER;\n" +
        "static int maca_mqtt_write_all(int fd, const unsigned char* b, int n) {{ int off = 0; while (off < n) {{ int w = write(fd, b + off, n - off); if (w <= 0) return -1; off += w; }} return 0; }}\n" +
        "static int maca_mqtt_read_n(int fd, unsigned char* b, int n) {{ int off = 0; while (off < n) {{ int r = read(fd, b + off, n - off); if (r <= 0) return -1; off += r; }} return 0; }}\n" +
        "static int maca_mqtt_read_remlen(int fd) {{ int mult = 1, value = 0; unsigned char c; do {{ if (maca_mqtt_read_n(fd, &c, 1)) return -1; value += (c & 127) * mult; mult *= 128; }} while (c & 128); return value; }}\n" +
        "static int maca_mqtt_enc_remlen(unsigned char* b, int len) {{ int i = 0; do {{ unsigned char c = len % 128; len /= 128; if (len) c |= 128; b[i++] = c; }} while (len); return i; }}\n" +
        "static int maca_mqtt_put_str(unsigned char* b, const char* s) {{ int n = (int)strlen(s); b[0] = (n >> 8) & 0xFF; b[1] = n & 0xFF; memcpy(b + 2, s, n); return n + 2; }}\n" +
        "static int maca_mqtt_send(int fd, unsigned char type_flags, const unsigned char* body, int blen) {{ unsigned char hdr[5]; hdr[0] = type_flags; int hn = 1 + maca_mqtt_enc_remlen(hdr + 1, blen); if (maca_mqtt_write_all(fd, hdr, hn)) return -1; if (blen && maca_mqtt_write_all(fd, body, blen)) return -1; return 0; }}\n" +
        "static int maca_mqtt_match(const char* f, const char* t) {{ if (*f == '#') return 1; if (*f == 0 && *t == 0) return 1; if (*f == 0 || *t == 0) return 0; const char* fe = f; while (*fe && *fe != '/') fe++; const char* te = t; while (*te && *te != '/') te++; int fl = (int)(fe - f); int ok = (fl == 1 && f[0] == '+') || ((int)(te - t) == fl && strncmp(f, t, fl) == 0); if (!ok) return 0; return maca_mqtt_match(*fe == '/' ? fe + 1 : fe, *te == '/' ? te + 1 : te); }}\n" +
        "static void maca_mqtt_route(const char* topic, const unsigned char* payload, int plen) {{ pthread_mutex_lock(&maca_mqtt_lock); for (int i = 0; i < maca_mqtt_nsubs; i++) {{ if (maca_mqtt_match(maca_mqtt_subs[i].pat, topic)) {{ unsigned char body[1024]; int n = maca_mqtt_put_str(body, topic); if (plen > 0 && n + plen < (int)sizeof(body)) {{ memcpy(body + n, payload, plen); n += plen; }} maca_mqtt_send(maca_mqtt_subs[i].fd, 0x30, body, n); }} }} pthread_mutex_unlock(&maca_mqtt_lock); }}\n" +
        "static void* maca_mqtt_client(void* arg) {{ int fd = (int)(long long)arg; unsigned char b1; while (maca_mqtt_read_n(fd, &b1, 1) == 0) {{ int rl = maca_mqtt_read_remlen(fd); if (rl < 0 || rl > 65535) break; unsigned char* body = (unsigned char*)malloc(rl > 0 ? rl : 1); if (rl > 0 && maca_mqtt_read_n(fd, body, rl)) {{ free(body); break; }} int type = b1 >> 4; if (type == 1) {{ unsigned char ack[2] = {{ 0x00, 0x00 }}; maca_mqtt_send(fd, 0x20, ack, 2); }} else if (type == 8) {{ int p = 2; unsigned char subacks[64]; int na = 0; while (p + 2 <= rl) {{ int tl = (body[p] << 8) | body[p + 1]; p += 2; if (p + tl > rl) break; pthread_mutex_lock(&maca_mqtt_lock); if (maca_mqtt_nsubs < MACA_MQTT_MAX_SUBS && tl < 256) {{ maca_mqtt_subs[maca_mqtt_nsubs].fd = fd; memcpy(maca_mqtt_subs[maca_mqtt_nsubs].pat, body + p, tl); maca_mqtt_subs[maca_mqtt_nsubs].pat[tl] = 0; maca_mqtt_nsubs++; }} pthread_mutex_unlock(&maca_mqtt_lock); p += tl + 1; if (na < 64) subacks[na++] = 0x00; }} unsigned char sb[66]; sb[0] = body[0]; sb[1] = body[1]; memcpy(sb + 2, subacks, na); maca_mqtt_send(fd, 0x90, sb, 2 + na); }} else if (type == 3) {{ int tl = (body[0] << 8) | body[1]; char topic[256]; int cl = tl < 255 ? tl : 255; memcpy(topic, body + 2, cl); topic[cl] = 0; int po = 2 + tl; maca_mqtt_route(topic, body + po, rl - po); }} else if (type == 12) {{ maca_mqtt_send(fd, 0xD0, 0, 0); }} else if (type == 14) {{ free(body); break; }} free(body); }} pthread_mutex_lock(&maca_mqtt_lock); int j = 0; for (int i = 0; i < maca_mqtt_nsubs; i++) if (maca_mqtt_subs[i].fd != fd) maca_mqtt_subs[j++] = maca_mqtt_subs[i]; maca_mqtt_nsubs = j; pthread_mutex_unlock(&maca_mqtt_lock); close(fd); return 0; }}\n" +
        "long long mqtt_broker_run(long long port) {{ int srv = socket(AF_INET, SOCK_STREAM, 0); if (srv < 0) return -1; int one = 1; setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one)); struct sockaddr_in a; memset(&a, 0, sizeof(a)); a.sin_family = AF_INET; a.sin_addr.s_addr = INADDR_ANY; a.sin_port = htons((unsigned short)port); if (bind(srv, (struct sockaddr*)&a, sizeof(a)) < 0) return -2; if (listen(srv, 128) < 0) return -3; for (;;) {{ int c = accept(srv, 0, 0); if (c < 0) continue; pthread_t th; pthread_create(&th, 0, maca_mqtt_client, (void*)(long long)c); pthread_detach(th); }} return 0; }}\n" +
        "long long mqtt_connect(const char* host, long long port) {{ int fd = socket(AF_INET, SOCK_STREAM, 0); if (fd < 0) return -1; struct sockaddr_in a; memset(&a, 0, sizeof(a)); a.sin_family = AF_INET; a.sin_port = htons((unsigned short)port); inet_pton(AF_INET, host ? host : \"127.0.0.1\", &a.sin_addr); if (connect(fd, (struct sockaddr*)&a, sizeof(a)) < 0) {{ close(fd); return -1; }} unsigned char cx[] = {{ 0, 4, 'M', 'Q', 'T', 'T', 4, 2, 0, 60, 0, 0 }}; maca_mqtt_send(fd, 0x10, cx, sizeof(cx)); unsigned char b1; maca_mqtt_read_n(fd, &b1, 1); int rl = maca_mqtt_read_remlen(fd); unsigned char tmp[8]; if (rl > 0 && rl <= 8) maca_mqtt_read_n(fd, tmp, rl); return fd; }}\n" +
        "long long mqtt_subscribe(long long fd, const char* topic) {{ unsigned char body[512]; body[0] = 0; body[1] = 1; int n = 2 + maca_mqtt_put_str(body + 2, topic); body[n++] = 0; maca_mqtt_send((int)fd, 0x82, body, n); unsigned char b1; maca_mqtt_read_n((int)fd, &b1, 1); int rl = maca_mqtt_read_remlen((int)fd); unsigned char tmp[16]; if (rl > 0 && rl <= 16) maca_mqtt_read_n((int)fd, tmp, rl); return 0; }}\n" +
        "long long mqtt_publish(long long fd, const char* topic, const char* payload) {{ unsigned char body[2048]; int n = maca_mqtt_put_str(body, topic); int pl = (int)strlen(payload ? payload : \"\"); if (n + pl < (int)sizeof(body)) {{ memcpy(body + n, payload, pl); n += pl; }} maca_mqtt_send((int)fd, 0x30, body, n); return 0; }}\n" +
        "const char* mqtt_receive(long long fd) {{ unsigned char b1; while (maca_mqtt_read_n((int)fd, &b1, 1) == 0) {{ int rl = maca_mqtt_read_remlen((int)fd); if (rl < 0 || rl > 65535) return \"\"; unsigned char* body = (unsigned char*)malloc(rl > 0 ? rl : 1); if (rl > 0 && maca_mqtt_read_n((int)fd, body, rl)) {{ free(body); return \"\"; }} if ((b1 >> 4) == 3) {{ int tl = (body[0] << 8) | body[1]; int po = 2 + tl; int pl = rl - po; char* out = (char*)malloc(pl > 0 ? pl + 1 : 1); if (pl > 0) memcpy(out, body + po, pl); out[pl > 0 ? pl : 0] = 0; free(body); return out; }} free(body); }} return \"\"; }}\n" +
        "long long mqtt_disconnect(long long fd) {{ maca_mqtt_send((int)fd, 0xE0, 0, 0); close((int)fd); return 0; }}\n"
    }
}

c_json_runtime() -> str =>
    "static const char* mj_ws(const char* p) {{ while (*p == ' ' || *p == '\\t' || *p == '\\n' || *p == '\\r') p++; return p; }}\n" +
    "static const char* mj_str_end(const char* p) {{ p++; while (*p && *p != '\"') {{ if (*p == '\\\\' && p[1]) p++; p++; }} return *p ? p + 1 : p; }}\n" +
    "static const char* mj_end(const char* p) {{ p = mj_ws(p); if (*p == '\"') return mj_str_end(p); if (*p == '[' || *p == '{{') {{ char open = *p, close = open == '[' ? ']' : '}}'; int d = 0; while (*p) {{ if (*p == '\"') {{ p = mj_str_end(p); continue; }} if (*p == open) d++; else if (*p == close) {{ d--; if (!d) return p + 1; }} p++; }} return p; }} while (*p && *p != ',' && *p != '}}' && *p != ']') p++; return p; }}\n" +
    "static char* mj_take(const char* a, const char* b) {{ size_t n = (size_t)(b - a); char* r = malloc(n + 1); memcpy(r, a, n); r[n] = 0; return r; }}\n" +
    "static const char* maca_json_kind(const char* p) {{ p = mj_ws(p); if (*p == '\"') return \"a string\"; if (*p == '{{') return \"an object\"; if (*p == '[') return \"a list\"; if (*p == 't' || *p == 'f') return \"a boolean\"; if (*p == 'n') return \"nothing\"; return \"a number\"; }}\n" +
    "static const char* mj_field(const char* t, const char* key) {{ const char* p = mj_ws(t); if (*p != '{{') return 0; p++; for (;;) {{ p = mj_ws(p); if (*p != '\"') return 0; const char* ke = mj_str_end(p); size_t n = strlen(key); int hit = (size_t)(ke - p) == n + 2 && memcmp(p + 1, key, n) == 0; p = mj_ws(ke); if (*p != ':') return 0; p = mj_ws(p + 1); if (hit) return p; p = mj_ws(mj_end(p)); if (*p != ',') return 0; p++; }} }}\n" +
    "static char* mj_named(const char* what, const char* said) {{ return maca_cat(\"`\", maca_cat(what, maca_cat(\"`: \", said))); }}\n" +
    "static const char* maca_json_want(const char* t, const char* key, const char* kind) {{ const char* v = mj_field(t, key); if (!v) {{ maca_fail(mj_named(key, \"no such field\")); return \"null\"; }} if (strcmp(maca_json_kind(v), kind) != 0) {{ maca_fail(mj_named(key, maca_cat(\"expected \", maca_cat(kind, maca_cat(\", got \", maca_json_kind(v)))))); return \"null\"; }} return v; }}\n" +
    "static const char* maca_json_object(const char* t, const char* what) {{ const char* p = mj_ws(t); if (*p != '{{') maca_fail(mj_named(what, maca_cat(\"expected an object, got \", maca_json_kind(p)))); return p; }}\n" +
    "static long long maca_json_int(const char* v) {{ return (long long)strtod(mj_ws(v), 0); }}\nstatic double maca_json_float(const char* v) {{ return strtod(mj_ws(v), 0); }}\nstatic long long maca_json_bool(const char* v) {{ return *mj_ws(v) == 't'; }}\n" +
    "static char* maca_json_str(const char* v) {{ const char* p = mj_ws(v); if (*p != '\"') return mj_take(p, mj_end(p)); const char* e = mj_str_end(p); char* r = malloc((size_t)(e - p) + 1); char* w = r; for (const char* q = p + 1; q + 1 < e; q++) {{ if (*q != '\\\\') {{ *w++ = *q; continue; }} q++; char c = *q; *w++ = c == 'n' ? '\\n' : c == 't' ? '\\t' : c == 'r' ? '\\r' : c; }} *w = 0; return r; }}\n" +
    "static char* maca_json_quote(const char* s) {{ size_t n = strlen(s); char* r = malloc(n * 2 + 3); char* w = r; *w++ = '\"'; for (size_t i = 0; i < n; i++) {{ char c = s[i]; if (c == '\"' || c == '\\\\') {{ *w++ = '\\\\'; *w++ = c; }} else if (c == '\\n') {{ *w++ = '\\\\'; *w++ = 'n'; }} else if (c == '\\r') {{ *w++ = '\\\\'; *w++ = 'r'; }} else if (c == '\\t') {{ *w++ = '\\\\'; *w++ = 't'; }} else {{ *w++ = c; }} }} *w++ = '\"'; *w = 0; return r; }}\n" +
    "static MacaList maca_json_items(const char* v) {{ MacaList l = maca_listv(0); const char* p = mj_ws(v); if (*p != '[') return l; p = mj_ws(p + 1); while (*p && *p != ']') {{ const char* e = mj_end(p); l = maca_list_pushed(l, (long long)mj_take(p, e)); p = mj_ws(e); if (*p == ',') p = mj_ws(p + 1); }} return l; }}\n"

/** The JSON text for a value of this type, as one C expression. */
c_json_text(ty: str, code: str, d: int) -> str {
    el = c_elem_of(ty)

    if ty == "int" {
        "maca_int_to_str({code})"
    } else if ty == "float" {
        "maca_float_to_str({code})"
    } else if ty == "bool" {
        "maca_bool_to_str({code})"
    } else if ty == "str" {
        "maca_json_quote({code})"
    } else if el != "" {
        c_json_arr(el, code, d)
    } else {
        "maca_json_of_{c_id(ty)}({code})"
    }
}

c_json_arr(el: str, code: str, d: int) -> str {
    xs = "_ja{str(d)}"
    ix = "_jb{str(d)}"
    acc = "_jc{str(d)}"

    "({{ MacaList {xs} = {code}; char* {acc} = maca_cat(\"[\", \"\");" +
        " for (int {ix} = 0; {ix} < {xs}.len; {ix}++) {{" +
        " if ({ix}) {acc} = maca_cat({acc}, \",\");" +
        " {acc} = maca_cat({acc}," +
        " {c_json_text(el, c_cell_at(xs, el, ix), d + 1)}); }}" +
        " maca_cat({acc}, \"]\"); }})"
}

/** The value of this type read out of the JSON text `code`, as one C
 * expression.
 */
c_json_read(ty: str, code: str, field: str, d: int) -> str {
    el = c_elem_of(ty)

    if ty == "int" {
        "maca_json_int({code})"
    } else if ty == "float" {
        "maca_json_float({code})"
    } else if ty == "bool" {
        "maca_json_bool({code})"
    } else if ty == "str" {
        "maca_json_str({code})"
    } else if el != "" {
        c_json_rows(el, code, field, d)
    } else {
        "maca_json_to_{c_id(ty)}({code}, \"{field}\")"
    }
}

c_json_rows(el: str, code: str, field: str, d: int) -> str {
    raw = "_jr{str(d)}"
    out = "_jo{str(d)}"
    ix = "_jk{str(d)}"
    one = c_json_read(el, "((const char*){raw}.data[{ix}])", field, d + 1)

    "({{ MacaList {raw} = maca_json_items({code});" +
        " MacaList {out} = maca_listv(0);" +
        " for (int {ix} = 0; {ix} < {raw}.len; {ix}++)" +
        " {out} = maca_list_pushed({out}, {c_cell_of(el, one)});" +
        " {out}; }})"
}

/** What JSON writes a value of this type as, named the way a diagnostic says
 * it.
 */
c_json_kind(items: Stmt[], ty: str) -> str {
    if ty == "int" || ty == "float" {
        "a number"
    } else if ty == "bool" {
        "a boolean"
    } else if ty == "str" || is_sum_name(items, ty) {
        "a string"
    } else if c_elem_of(ty) != "" {
        "a list"
    } else {
        "an object"
    }
}

is_sum_name(items: Stmt[], ty: str) -> bool {
    if items.length() == 0 {
        false
    } else {
        one = items.get(0)

        one.kind == SSum && one.name == ty
            ? true
            : is_sum_name(items.slice(1, items.length()), ty)
    }
}

c_json_of_rec(s: Stmt) -> str =>
    "static char* maca_json_of_{c_id(s.name)}({type_c(s.name)} _v) {{" +
        " char* _s = maca_cat(\"{{\", \"\");{c_json_puts(s.params, 0)}" +
        " return maca_cat(_s, \"}}\"); }}\n"

c_json_puts(fs: Expr[], i: int) -> str {
    if i >= fs.length() {
        ""
    } else {
        f = fs.get(i)
        lead = i == 0 ? "" : ","

        " _s = maca_cat(_s, \"{lead}\\\"{f.text}\\\":\");" +
            " _s = maca_cat(_s, {c_json_text(f.ty, "_v.{c_id(f.text)}", 0)});" +
            c_json_puts(fs, i + 1)
    }
}

c_json_to_rec(items: Stmt[], s: Stmt) -> str =>
    "static {type_c(s.name)} maca_json_to_{c_id(s.name)}(const char* _t," +
        " const char* _w) {{ const char* _o = maca_json_object(_t, _w);" +
        " {type_c(s.name)} _v;{c_json_gets(items, s.params, 0)}" +
        " return _v; }}\n"

c_json_gets(items: Stmt[], fs: Expr[], i: int) -> str {
    if i >= fs.length() {
        ""
    } else {
        f = fs.get(i)
        got = "maca_json_want(_o, \"{f.text}\", \"{c_json_kind(items, f.ty)}\")"

        " _v.{c_id(f.text)} = {c_json_read(f.ty, got, f.text, 0)};" +
            c_json_gets(items, fs, i + 1)
    }
}

c_json_of_sum(s: Stmt) -> str =>
    "static char* maca_json_of_{c_id(s.name)}({type_c(s.name)} _v) {{" +
        " return maca_json_quote({c_json_names(s.params, 0)}); }}\n"

c_json_names(vs: Expr[], i: int) -> str {
    if i >= vs.length() {
        "\"\""
    } else {
        "_v == {vs.get(i).text} ? \"{vs.get(i).text.lower()}\"" +
            " : {c_json_names(vs, i + 1)}"
    }
}

c_json_to_sum(s: Stmt) -> str =>
    "static {type_c(s.name)} maca_json_to_{c_id(s.name)}(const char* _t," +
        " const char* _w) {{ char* _s = maca_json_str(_t);" +
        "{c_json_picks(s.params, 0)}" +
        " maca_fail(maca_cat(\"`\", maca_cat(_w, maca_cat(\"`: \\\"\"," +
        " maca_cat(_s, \"\\\" is not one of {c_json_list(s.params, 0)}\"" +
        ")))));" +
        " return {s.params.get(0).text}; }}\n"

c_json_picks(vs: Expr[], i: int) -> str {
    if i >= vs.length() {
        ""
    } else {
        v = vs.get(i)

        " if (strcmp(_s, \"{v.text.lower()}\") == 0) return {v.text};" +
            c_json_picks(vs, i + 1)
    }
}

c_json_list(vs: Expr[], i: int) -> str {
    if i >= vs.length() {
        ""
    } else if i == vs.length() - 1 {
        vs.get(i).text.lower()
    } else {
        "{vs.get(i).text.lower()}, {c_json_list(vs, i + 1)}"
    }
}

/** Every record and sum a program's `encode` and `decode` reach, fields
 * included.
 */
json_wanted(items: Stmt[]) -> str[] =>
    json_closed(items, json_seeds(items, 0, []), items.length())

json_seeds(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else {
        s = items.get(i)
        seen = is_typed_decode(s) ? json_add(acc, base_type(s.ret)) : acc

        json_seeds(items, i + 1,
                   json_seeds(s.body, 0, json_seeds_in(s.value, seen)))
    }
}

json_seeds_in(e: Expr, acc: str[]) -> str[] {
    seen = e.kind == ECall && e.text == "encode" && e.children.length() == 1
        ? json_add(acc, base_type(e.children.get(0).ty))
        : acc

    json_seeds(e.stmts, 0, json_seed_kids(e.children, 0, seen))
}

json_seed_kids(xs: Expr[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else {
        json_seed_kids(xs, i + 1, json_seeds_in(xs.get(i), acc))
    }
}

json_closed(items: Stmt[], names: str[], fuel: int) -> str[] {
    grown = json_grow(items, names, 0, names)

    if fuel <= 0 || grown.length() == names.length() {
        names
    } else {
        json_closed(items, grown, fuel - 1)
    }
}

json_grow(items: Stmt[], names: str[], i: int, acc: str[]) -> str[] {
    if i >= names.length() {
        acc
    } else {
        json_grow(items, names, i + 1,
                  json_field_types(json_fields_of(items, names.get(i), 0),
                                   0, acc))
    }
}

json_fields_of(items: Stmt[], name: str, i: int) -> Expr[] {
    if i >= items.length() {
        []
    } else if items.get(i).kind == SRecord && items.get(i).name == name {
        items.get(i).params
    } else {
        json_fields_of(items, name, i + 1)
    }
}

json_field_types(fs: Expr[], i: int, acc: str[]) -> str[] {
    if i >= fs.length() {
        acc
    } else {
        json_field_types(fs, i + 1, json_add(acc, base_type(fs.get(i).ty)))
    }
}

json_add(acc: str[], name: str) -> str[] =>
    upper_word(name) && acc.index_of(name) < 0 ? acc.push(name) : acc

base_type(ty: str) -> str =>
    c_elem_of(ty) != "" ? base_type(c_elem_of(ty)) : ty

is_typed_decode(s: Stmt) -> bool =>
    s.kind == SBind && s.ret != "" && is_decode_call(s.value)

is_decode_call(e: Expr) -> bool =>
    e.kind == ECall && e.text == "decode" && e.children.length() == 1

c_bound(s: Stmt) -> str {
    if is_typed_decode(s) {
        c_json_read(s.ret, emit_expr(s.value.children.get(0)),
                    base_type(s.ret), 0)
    } else {
        emit_expr(s.value)
    }
}

c_json(items: Stmt[], names: str[], bare: str) -> str {
    defs = c_json_protos(items, names, 0) + c_json_bodies(items, names, 0)

    if defs == "" && !c_uses(bare, "maca_json_") {
        ""
    } else {
        c_json_runtime() + defs
    }
}

c_json_protos(items: Stmt[], names: str[], i: int) -> str {
    if i >= names.length() {
        ""
    } else {
        s = json_type_item(items, names.get(i), 0)
        here = s.name == "" ? "" :
            "static char* maca_json_of_{c_id(s.name)}({type_c(s.name)} _v);\n" +
                "static {type_c(s.name)} maca_json_to_{c_id(s.name)}(" +
                "const char* _t, const char* _w);\n"

        here + c_json_protos(items, names, i + 1)
    }
}

c_json_bodies(items: Stmt[], names: str[], i: int) -> str {
    if i >= names.length() {
        ""
    } else {
        s = json_type_item(items, names.get(i), 0)
        here = if s.name == "" {
            ""
        } else if s.kind == SRecord {
            c_json_of_rec(s) + c_json_to_rec(items, s)
        } else {
            c_json_of_sum(s) + c_json_to_sum(s)
        }

        here + c_json_bodies(items, names, i + 1)
    }
}

/** The record or nullary sum this name declares, or a nameless one when it
 * declares neither.
 */
json_type_item(items: Stmt[], name: str, i: int) -> Stmt {
    if i >= items.length() {
        s_record("", [])
    } else if json_codable(items.get(i)) && items.get(i).name == name {
        items.get(i)
    } else {
        json_type_item(items, name, i + 1)
    }
}

json_codable(s: Stmt) -> bool =>
    s.kind == SRecord || (s.kind == SSum && payload_arity(s.params, 0) == 0)

emit_module(m: Module) -> str {
    protos = emit_protos(m.items, 0)
    code = protos + emit_starts(m.items) + emit_bodies(m.items, 0)
    bare = c_bare(code)

    c_preamble() + c_styles(m, code) + c_errors(bare) +
        c_process(bare) + c_threads(bare) + c_sockets(bare) +
        emit_types(m.items, 0) +
        c_json(m.items, json_wanted(m.items), bare) +
        emit_consts(m.items, 0) + code +
        c_mqtt(c_bare(protos)) + c_ffi(protos)
}

/** The stylesheet a program asks for by calling `styles`, and only then. */
c_styles(m: Module, code: str) -> str {
    if code.index_of("MACA_STYLES") < 0 {
        ""
    } else {
        "#define MACA_STYLES \"{style_sheet(m.items)}\"\n"
    }
}

c_ffi(protos: str) -> str =>
    c_sqlite(protos) + c_python(protos)

c_sqlite(protos: str) -> str {
    if protos.index_of("sqlite_open(") < 0 {
        ""
    } else {
        "#include <sqlite3.h>\n" +
        "static long long maca_sq_handle(void* p) {{ return (long long)(intptr_t)p; }}\n" +
        "static sqlite3* maca_sq_db(long long h) {{ return (sqlite3*)(intptr_t)h; }}\n" +
        "static sqlite3_stmt* maca_sq_stmt(long long h) {{ return (sqlite3_stmt*)(intptr_t)h; }}\n" +
        "static const char* maca_sq_text(const unsigned char* t) {{ return t ? maca_cat((const char*)t, \"\") : \"\"; }}\n" +
        "long long sqlite_open(const char* path) {{ sqlite3* db = 0; if (sqlite3_open(path, &db) != SQLITE_OK) {{ if (db) sqlite3_close(db); return 0; }} return maca_sq_handle(db); }}\n" +
        "long long sqlite_close(long long db) {{ return sqlite3_close(maca_sq_db(db)); }}\n" +
        "long long sqlite_exec(long long db, const char* sql) {{ char* err = 0; int rc = sqlite3_exec(maca_sq_db(db), sql, 0, 0, &err); if (err) sqlite3_free(err); return rc; }}\n" +
        "long long sqlite_prepare(long long db, const char* sql) {{ sqlite3_stmt* st = 0; if (sqlite3_prepare_v2(maca_sq_db(db), sql, -1, &st, 0) != SQLITE_OK) return 0; return maca_sq_handle(st); }}\n" +
        "long long sqlite_step(long long st) {{ return sqlite3_step(maca_sq_stmt(st)) == SQLITE_ROW; }}\n" +
        "long long sqlite_column_count(long long st) {{ return sqlite3_column_count(maca_sq_stmt(st)); }}\n" +
        "const char* sqlite_column_name(long long st, long long col) {{ return maca_sq_text((const unsigned char*)sqlite3_column_name(maca_sq_stmt(st), (int)col)); }}\n" +
        "const char* sqlite_column_text(long long st, long long col) {{ return maca_sq_text(sqlite3_column_text(maca_sq_stmt(st), (int)col)); }}\n" +
        "long long sqlite_column_int(long long st, long long col) {{ return sqlite3_column_int64(maca_sq_stmt(st), (int)col); }}\n" +
        "double sqlite_column_float(long long st, long long col) {{ return sqlite3_column_double(maca_sq_stmt(st), (int)col); }}\n" +
        "long long sqlite_finalize(long long st) {{ return sqlite3_finalize(maca_sq_stmt(st)); }}\n"
    }
}

c_python(protos: str) -> str {
    if protos.index_of("py_call(") < 0 {
        ""
    } else {
        "#define PY_SSIZE_T_CLEAN\n#include <Python.h>\n" +
        "static const char* maca_py_str(PyObject* r) {{ if (!r) return \"<py error>\"; const char* out = \"<py error>\"; PyObject* s = PyObject_Str(r); if (s) {{ const char* c = PyUnicode_AsUTF8(s); if (c) out = maca_cat(c, \"\"); Py_DECREF(s); }} return out; }}\n" +
        "static PyObject* maca_py_find(const char* module, const char* func) {{ PyObject* m = PyImport_ImportModule(module); if (!m) return 0; PyObject* f = PyObject_GetAttrString(m, func); Py_DECREF(m); if (f && PyCallable_Check(f)) return f; Py_XDECREF(f); return 0; }}\n" +
        "const char* py_call(const char* module, const char* func) {{ Py_Initialize(); const char* out = \"<py error>\"; PyObject* f = maca_py_find(module, func); if (f) {{ PyObject* r = PyObject_CallObject(f, 0); out = maca_py_str(r); Py_XDECREF(r); Py_DECREF(f); }} Py_Finalize(); return out; }}\n" +
        "const char* py_call_s(const char* module, const char* func, const char* arg) {{ Py_Initialize(); const char* out = \"<py error>\"; PyObject* f = maca_py_find(module, func); if (f) {{ PyObject* r = PyObject_CallFunction(f, \"s\", arg ? arg : \"\"); out = maca_py_str(r); Py_XDECREF(r); Py_DECREF(f); }} Py_Finalize(); return out; }}\n" +
        "const char* py_call_i(const char* module, const char* func, long long n) {{ Py_Initialize(); const char* out = \"<py error>\"; PyObject* f = maca_py_find(module, func); if (f) {{ PyObject* r = PyObject_CallFunction(f, \"L\", (long long)n); out = maca_py_str(r); Py_XDECREF(r); Py_DECREF(f); }} Py_Finalize(); return out; }}\n"
    }
}

emit_consts(items: Stmt[], i: int) -> str {
    parts: str[] = []
    at = i

    while at < items.length() {
        if items.get(at).kind == SBind {
            parts = parts.push("{emit_const(items.get(at))}\n")
        }

        at = at + 1
    }

    parts.join("")
}

emit_const(s: Stmt) -> str {
    if c_constant(s.value) {
        "static {c_held(s)}{bind_c_decl(s)} = " +
            "{emit_expr(s.value)};"
    } else {
        "static {bind_c_decl(s)};"
    }
}

/** A Capitalized name is a constant; a lowercase one is module state a body
 * assigns to.
 */
c_held(s: Stmt) -> str {
    if c_lower_name(s.name) {
        ""
    } else {
        "const "
    }
}

c_constant(e: Expr) -> bool =>
    e.kind == EInt || e.kind == EFloat || e.kind == EStr || e.kind == EBool

emit_starts(items: Stmt[]) -> str {
    sets = emit_start_sets(items, 0)

    if sets == "" {
        ""
    } else {
        "__attribute__((constructor)) static void maca_module_init(void)" +
            " {{ {sets}}}\n"
    }
}

emit_start_sets(items: Stmt[], i: int) -> str {
    if i >= items.length() {
        ""
    } else if items.get(i).kind != SBind || c_constant(items.get(i).value) {
        emit_start_sets(items, i + 1)
    } else {
        s = items.get(i)

        "{c_id(s.name)} = {emit_expr(s.value)}; " +
            emit_start_sets(items, i + 1)
    }
}

is_type_item(s: Stmt) -> bool =>
    s.kind == SRecord || s.kind == SSum

emit_types(items: Stmt[], i: int) -> str =>
    emit_ranked(items, i, 0)

/** A field holds its record by value, so a type is emitted after every type it
 * names.
 */
emit_ranked(items: Stmt[], i: int, r: int) -> str {
    parts: str[] = []
    rank = r

    while rank <= items.length() {
        parts = parts.push(emit_rank(items, i, rank))
        rank = rank + 1
    }

    parts.join("")
}

emit_rank(items: Stmt[], i: int, r: int) -> str {
    if i >= items.length() {
        ""
    } else if is_type_item(items.get(i))
            && type_rank(items, items.get(i), items.length(), 0) == r {
        "{emit_item(items.get(i))}\n{emit_rank(items, i + 1, r)}"
    } else {
        emit_rank(items, i + 1, r)
    }
}

type_rank(items: Stmt[], s: Stmt, fuel: int, i: int) -> int {
    if fuel <= 0 || i >= s.params.length() {
        0
    } else {
        wider(node_rank(items, s.params.get(i), fuel),
              type_rank(items, s, fuel, i + 1))
    }
}

node_rank(items: Stmt[], p: Expr, fuel: int) -> int =>
    wider(named_rank(items, p.ty, fuel, 0),
          payload_rank(items, p.children, fuel, 0))

payload_rank(items: Stmt[], cs: Expr[], fuel: int, i: int) -> int {
    if i >= cs.length() {
        0
    } else {
        wider(named_rank(items, cs.get(i).ty, fuel, 0),
              payload_rank(items, cs, fuel, i + 1))
    }
}

named_rank(items: Stmt[], ty: str, fuel: int, i: int) -> int {
    if i >= items.length() {
        0
    } else if is_type_item(items.get(i)) && items.get(i).name == ty {
        1 + type_rank(items, items.get(i), fuel - 1, 0)
    } else {
        named_rank(items, ty, fuel, i + 1)
    }
}

is_declared_only(s: Stmt) -> bool =>
    s.kind == SFn && s.body.length() == 0

emit_protos(items: Stmt[], i: int) -> str {
    parts: str[] = []
    at = i

    while at < items.length() {
        if items.get(at).kind == SFn {
            parts = parts.push("{emit_proto(items.get(at))}\n")
        }

        at = at + 1
    }

    parts.join("")
}

emit_bodies(items: Stmt[], i: int) -> str {
    parts: str[] = []
    at = i

    while at < items.length() {
        held = items.get(at)

        if held.kind == SFn && !is_declared_only(held) {
            parts = parts.push("{emit_fn(held)}\n")
        }

        at = at + 1
    }

    parts.join("")
}

emit_proto(s: Stmt) -> str =>
    "{c_ret(s)} {c_name(s)}({c_sig_params(s)});"

emit_item(s: Stmt) -> str {
    if s.kind == SRecord {
        emit_struct(s)
    } else {
        emit_sum(s)
    }
}

emit_struct(s: Stmt) -> str {
    fields = s.params.map(emit_struct_field).join(" ")

    "typedef struct {{ {fields} }} {s.name};"
}

emit_struct_field(f: Expr) -> str =>
    "{c_decl(f.ty, c_id(f.text))};"

emit_sum(s: Stmt) -> str {
    if payload_arity(s.params, 0) == 0 {
        variants = s.params.map(variant_name).join(", ")
        "typedef enum {{ {variants} }} {s.name};"
    } else {
        emit_tagged_sum(s)
    }
}

variant_name(v: Expr) -> str =>
    v.text

emit_tagged_sum(s: Stmt) -> str {
    tags = s.params.map(tag_name).join(", ")
    slots = emit_slots(s, payload_arity(s.params, 0), 0)

    "typedef enum {{ {tags} }} {s.name}_tag;\n" +
        "typedef struct {{ {s.name}_tag tag; {slots}}} {s.name};\n" +
        emit_ctors(s, 0)
}

tag_name(v: Expr) -> str =>
    "{v.text}_tag"

payload_arity(vs: Expr[], i: int) -> int {
    if i >= vs.length() {
        0
    } else {
        wider(vs.get(i).children.length(), payload_arity(vs, i + 1))
    }
}

wider(a: int, b: int) -> int {
    if a > b {
        a
    } else {
        b
    }
}

emit_slots(s: Stmt, n: int, i: int) -> str {
    if i >= n {
        ""
    } else {
        "{slot_type(s, i, 0)} _{i}; {emit_slots(s, n, i + 1)}"
    }
}

/** Every variant shares one slot, so it carries a declared type only where they
 * all agree.
 */
slot_type(s: Stmt, at: int, i: int) -> str {
    if i >= s.params.length() {
        "long long"
    } else if s.params.get(i).children.length() <= at {
        slot_type(s, at, i + 1)
    } else if s.params.get(i).children.get(at).ty == s.name {
        "long long"
    } else {
        agreed(type_c(s.params.get(i).children.get(at).ty),
               slot_type(s, at, i + 1))
    }
}

agreed(a: str, b: str) -> str =>
    (b == "long long" || a == b) ? a : "long long"

emit_ctors(s: Stmt, i: int) -> str {
    if i >= s.params.length() {
        ""
    } else {
        emit_ctor(s, s.params.get(i)) + emit_ctors(s, i + 1)
    }
}

emit_ctor(s: Stmt, v: Expr) -> str {
    if v.children.length() == 0 {
        "static const {s.name} {v.text} = {{ {v.text}_tag }};\n"
    } else {
        "static inline {s.name} {v.text}({ctor_params(s, v.children, 0)}) " +
            "{{ {s.name} _v; _v.tag = {v.text}_tag; " +
            ctor_assigns(s, v.children, 0) + "return _v; }}\n"
    }
}

ctor_params(s: Stmt, ps: Expr[], i: int) -> str {
    if ps.length() == 0 {
        "void"
    } else if i >= ps.length() {
        ""
    } else if i == ps.length() - 1 {
        "{ctor_slot(s, ps, i)} _{i}"
    } else {
        "{ctor_slot(s, ps, i)} _{i}, {ctor_params(s, ps, i + 1)}"
    }
}

/** A constructor takes its own payload by value, whatever the shared slot
 * holds.
 */
ctor_slot(s: Stmt, ps: Expr[], i: int) -> str =>
    ps.get(i).ty == s.name ? s.name : slot_type(s, i, 0)

ctor_assigns(s: Stmt, ps: Expr[], i: int) -> str {
    if i >= ps.length() {
        ""
    } else if ps.get(i).ty == s.name {
        "{s.name}* _b{i} = ({s.name}*)malloc(sizeof({s.name}));" +
            " *_b{i} = _{i}; _v._{i} = (long long)_b{i};" +
            " {ctor_assigns(s, ps, i + 1)}"
    } else {
        "_v._{i} = _{i}; {ctor_assigns(s, ps, i + 1)}"
    }
}
