import maca/token
import maca/ast

quoted(s: str) -> str =>
    "\"" ++ s ++ "\""

emit_expr(e: Expr) -> str =>
    match e.kind {
        EInt     => str(e.ival)
        EFloat   => e.text
        EStr     => quoted(e.text)
        EBool    => emit_bool(e)
        EIdent   => e.text
        ECall    => emit_call(e)
        EBinary  => emit_binary(e)
        ETernary => emit_ternary(e)
        EIf      => emit_ternary(e)
        EUnary   => "({e.text}{emit_expr(e.children.get(0))})"
        ERecord  => "({e.text}){{ {emit_lit_fields(e.children, 0)} }}"
        EWith    => emit_with(e)
        EBlock   => emit_block(e)
        EField   => "{emit_expr(e.children.get(0))}.{e.text}"
        EMatch   => emit_match(e)
        EMethod  => emit_method(e)
        EList    => emit_list(e)
        _        => "0"
    }

emit_bool(e: Expr) -> str {
    if e.text == "true" {
        "1"
    } else {
        "0"
    }
}

emit_ternary(e: Expr) -> str {
    cond = emit_expr(e.children.get(0))
    then = emit_expr(e.children.get(1))
    els = emit_expr(e.children.get(2))

    "({cond} ? {then} : {els})"
}

emit_list(e: Expr) -> str {
    n = e.children.length()

    if n == 0 {
        "maca_listv(0)"
    } else {
        "maca_listv({str(n)}, {c_cells(c_elem_of(e.ty), e.children, 0)})"
    }
}

c_cells(el: str, cs: Expr[], i: int) -> str {
    if i >= cs.length() {
        ""
    } else if i == cs.length() - 1 {
        c_cell(el, cs.get(i))
    } else {
        "{c_cell(el, cs.get(i))}, {c_cells(el, cs, i + 1)}"
    }
}

c_cell(el: str, e: Expr) -> str =>
    c_cell_of(el, emit_expr(e))

c_cell_of(el: str, code: str) -> str {
    if c_boxed(el) {
        ct = type_c(el)

        "maca_box(sizeof({ct}), ({ct}[]){{ {code} }})"
    } else {
        "(long)({code})"
    }
}

c_cell_at(recv: str, el: str, ix: str) -> str {
    if c_boxed(el) {
        "(*({type_c(el)}*){recv}.data[{ix}])"
    } else if el == "str" {
        "((const char*){recv}.data[{ix}])"
    } else {
        "((int){recv}.data[{ix}])"
    }
}

c_boxed(el: str) -> bool =>
    el != "" && el != "int" && el != "bool" && el != "str"

c_elem_of(ty: str) -> str {
    if is_list_type(ty) {
        ty.slice(0, ty.length() - 2)
    } else {
        ""
    }
}

emit_method(e: Expr) -> str {
    recv = emit_expr(e.children.get(0))
    rty = e.children.get(0).ty
    on_list = is_list_type(rty)
    on_str = rty == "str"
    el = c_elem_of(rty)

    if e.text == "count" || (e.text == "length" && on_list) {
        "({recv}.len)"
    } else if e.text == "length" {
        "((int)strlen({recv}))"
    } else if e.text == "at" || (e.text == "get" && on_str) {
        "((int){recv}[{emit_expr(e.children.get(1))}])"
    } else if e.text == "get" {
        c_cell_at(recv, el, emit_expr(e.children.get(1)))
    } else if e.text == "slice" && on_list {
        "maca_list_slice({recv}, {emit_expr(e.children.get(1))},"
            ++ " {emit_expr(e.children.get(2))})"
    } else if e.text == "slice" {
        "maca_str_slice({recv}, {emit_expr(e.children.get(1))},"
            ++ " {emit_expr(e.children.get(2))})"
    } else if e.text == "ends_with" {
        "maca_ends_with({recv}, {emit_expr(e.children.get(1))})"
    } else if e.text == "index_of" && on_list {
        c_list_find(recv, el, e.children.get(1))
    } else if e.text == "index_of" {
        "maca_str_index_of({recv}, {emit_expr(e.children.get(1))})"
    } else if e.text == "join" {
        "maca_list_join({recv}, {emit_expr(e.children.get(1))})"
    } else if e.text == "push" {
        "maca_list_cat({recv}, maca_listv(1,"
            ++ " {c_cell(el, e.children.get(1))}))"
    } else if e.text == "map" {
        emit_map(e)
    } else if e.text == "chars" {
        "maca_chars({recv})"
    } else if e.text == "is_whitespace" {
        "(isspace((unsigned char){c_char(recv, on_str)}) != 0)"
    } else if e.text == "is_ascii_digit" {
        "(isdigit((unsigned char){c_char(recv, on_str)}) != 0)"
    } else if e.text == "is_alpha" {
        "(isalpha((unsigned char){c_char(recv, on_str)}) != 0)"
    } else if e.text == "upper" && on_str {
        "maca_upper({recv})"
    } else if e.text == "upper" {
        "toupper((unsigned char){c_char(recv, on_str)})"
    } else if e.text == "contains" && on_list {
        "({c_list_find(recv, el, e.children.get(1))} >= 0)"
    } else if e.text == "contains" {
        "(strstr({recv}, {emit_expr(e.children.get(1))}) != NULL)"
    } else {
        "{recv}.{e.text}({emit_args(e.children, 1)})"
    }
}

emit_map(e: Expr) -> str {
    src = emit_expr(e.children.get(0))
    cell = c_cell_at("_m", c_elem_of(e.children.get(0).ty), "_i")
    f = e.children.get(1)
    got = c_cell_of(c_map_elem(f), "{emit_expr(f)}({cell})")

    "({{ MacaList _m = {src}; MacaList _r; _r.len = _m.len;"
        ++ " _r.data = malloc((_r.len ? _r.len : 1) * sizeof(long));"
        ++ " for (int _i = 0; _i < _m.len; _i++) _r.data[_i] = {got};"
        ++ " _r; }})"
}

c_map_elem(f: Expr) -> str {
    if is_fn_type(f.ty) {
        fn_ret_of(f.ty)
    } else {
        ""
    }
}

c_list_find(recv: str, el: str, want: Expr) -> str {
    if el == "str" {
        "maca_list_index_of_str({recv}, {emit_expr(want)})"
    } else {
        "maca_list_index_of({recv}, {c_cell(el, want)})"
    }
}

c_char(recv: str, on_str: bool) -> str {
    if on_str {
        "({recv})[0]"
    } else {
        "({recv})"
    }
}

is_list_type(ty: str) -> bool =>
    ty.length() >= 2 && ty.slice(ty.length() - 2, ty.length()) == "[]"

emit_call(e: Expr) -> str {
    args = emit_args(e.children, 0)

    if e.text == "info" {
        "printf(\"%s\\n\", {args})"
    } else if e.text == "print" {
        "printf(\"%s\", {args})"
    } else if e.text == "str" {
        c_str_of(c_arg_ty(e.children), args)
    } else if e.text == "int" {
        c_int_of(c_arg_ty(e.children), args)
    } else if e.text == "read_file" {
        "maca_read_file({args})"
    } else if e.text == "write_file" {
        "maca_write_file({args})"
    } else if e.text == "exec" {
        "maca_exec({args})"
    } else {
        "{e.text}({args})"
    }
}

c_arg_ty(cs: Expr[]) -> str {
    if cs.length() == 0 {
        ""
    } else {
        cs.get(0).ty
    }
}

c_str_of(ty: str, args: str) -> str {
    if ty == "str" {
        args
    } else if ty == "float" {
        "maca_float_to_str({args})"
    } else if ty == "bool" {
        "maca_bool_to_str({args})"
    } else {
        "maca_int_to_str({args})"
    }
}

c_int_of(ty: str, args: str) -> str {
    if ty == "int" {
        args
    } else {
        "atoi({args})"
    }
}

c_is_str(e: Expr) -> bool =>
    e.kind == EStr || e.ty == "str"

emit_binary(e: Expr) -> str {
    l = e.children.get(0)
    r = e.children.get(1)
    is_cmp = e.text == "==" || e.text == "!="
    is_str_eq = is_cmp && (c_is_str(l) || c_is_str(r))

    if e.text == "++" && (is_list_type(l.ty) || is_list_type(r.ty)) {
        "maca_list_cat({emit_expr(l)}, {emit_expr(r)})"
    } else if e.text == "++" {
        "maca_cat({emit_expr(l)}, {emit_expr(r)})"
    } else if is_str_eq {
        "(strcmp({emit_expr(l)}, {emit_expr(r)}) {e.text} 0)"
    } else {
        "({emit_expr(l)} {e.text} {emit_expr(r)})"
    }
}

emit_match(e: Expr) -> str =>
    emit_arms(emit_expr(e.children.get(0)), e.children, 1)

emit_arms(scrut: str, cs: Expr[], i: int) -> str =>
    emit_arms_at(scrut, cs, i, any_bound(cs, 1))

emit_arms_at(scrut: str, cs: Expr[], i: int, tagged: bool) -> str {
    if i + 1 >= cs.length() {
        "0"
    } else if cs.get(i).text == "_" && cs.get(i).kind != EGuard {
        emit_expr(cs.get(i + 1))
    } else {
        cond = test(scrut, cs.get(i), tagged)
        body = arm_body(scrut, cs.get(i), cs.get(i + 1))
        rest = emit_arms_at(scrut, cs, i + 2, tagged)
        "({cond} ? {body} : {rest})"
    }
}

bound_pat(p: Expr) -> bool {
    if p.kind == EGuard {
        bound_pat(p.children.get(0))
    } else {
        p.children.length() > 0
    }
}

any_bound(cs: Expr[], i: int) -> bool {
    if i >= cs.length() {
        false
    } else if bound_pat(cs.get(i)) {
        true
    } else {
        any_bound(cs, i + 2)
    }
}

test(scrut: str, pat: Expr, tagged: bool) -> str {
    if pat.kind == EGuard {
        guard_test(scrut, pat, tagged)
    } else if tagged {
        "{scrut}.tag == {pat.text}_tag"
    } else if pat.kind == EStr {
        "(strcmp({scrut}, {quoted(pat.text)}) == 0)"
    } else {
        "{scrut} == {pat.text}"
    }
}

guard_test(scrut: str, pat: Expr, tagged: bool) -> str {
    when = emit_expr(pat.children.get(1))

    if pat.children.get(0).text == "_" {
        when
    } else {
        "({test(scrut, pat.children.get(0), tagged)} && {when})"
    }
}

arm_body(scrut: str, pat: Expr, body: Expr) -> str {
    if pat.kind == EGuard {
        arm_body(scrut, pat.children.get(0), body)
    } else if pat.children.length() == 0 {
        emit_expr(body)
    } else {
        "({{ {bind_slots(scrut, pat.children, 0)}{emit_expr(body)}; }})"
    }
}

bind_slots(scrut: str, bs: Expr[], i: int) -> str {
    if i >= bs.length() {
        ""
    } else {
        "long {bs.get(i).text} = {scrut}._{i}; {bind_slots(scrut, bs, i + 1)}"
    }
}

emit_block(e: Expr) -> str =>
    "({{ {block_stmts(e.stmts, 0)}{emit_expr(e.children.get(0))}; }})"

block_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        "{emit_stmt(body.get(i), false)} {block_stmts(body, i + 1)}"
    }
}

emit_with(e: Expr) -> str {
    base = emit_expr(e.children.get(0))

    "({{ __typeof__({base}) _w = {base}; {emit_updates(e.children, 1)}_w; }})"
}

emit_updates(fs: Expr[], i: int) -> str {
    if i >= fs.length() {
        ""
    } else {
        f = fs.get(i)
        set = "_w.{f.children.get(0).text} = {emit_expr(f.children.get(1))}; "

        set ++ emit_updates(fs, i + 1)
    }
}

emit_lit_fields(fs: Expr[], i: int) -> str =>
    fs.map(emit_lit_field).join(", ")

emit_lit_field(f: Expr) -> str =>
    ".{f.children.get(0).text} = {emit_expr(f.children.get(1))}"

emit_args(xs: Expr[], i: int) -> str =>
    xs.slice(i, xs.length()).map(emit_expr).join(", ")

emit_unit(e: Expr) -> str =>
    "int main(void) {{ return {emit_expr(e)}; }}"

is_fn_type(ty: str) -> bool =>
    ty.index_of(") -> ") >= 0

fn_ret_of(ty: str) -> str =>
    ty.slice(ty.index_of(") -> ") + 5, ty.length())

fn_params_of(ty: str) -> str =>
    ty.slice(1, ty.index_of(") -> "))

c_decl(ty: str, name: str) -> str {
    if !is_fn_type(ty) {
        "{type_c(ty)} {name}"
    } else {
        rt = type_c(fn_ret_of(ty))
        ps = c_fn_params(fn_params_of(ty))

        "{rt} (*{name})({ps})"
    }
}

c_fn_params(ps: str) -> str {
    at = ps.index_of(", ")

    if ps == "" {
        "void"
    } else if at < 0 {
        type_c(ps)
    } else {
        rest = c_fn_params(ps.slice(at + 2, ps.length()))

        "{type_c(ps.slice(0, at))}, {rest}"
    }
}

type_c(ty: str) -> str {
    if is_fn_type(ty) {
        c_decl(ty, "")
    } else if is_list_type(ty) {
        "MacaList"
    } else if ty == "float" {
        "double"
    } else if ty == "str" {
        "const char*"
    } else if ty == "" || ty == "int" || ty == "bool" {
        "int"
    } else {
        ty
    }
}

emit_fn(s: Stmt) -> str {
    params = c_params(s.params, 0)
    made = "{type_c(s.ret)} {c_name(s)}({params}) "
        ++ "{{ {emit_stmts(s.body, 0)} }}"

    made ++ c_main_shim(s)
}

c_shimmed(s: Stmt) -> bool =>
    s.name == "main" && s.params.length() > 0

c_name(s: Stmt) -> str {
    if c_shimmed(s) {
        "maca_main"
    } else {
        s.name
    }
}

c_main_shim(s: Stmt) -> str {
    if c_shimmed(s) {
        "\nint main(int argc, char** argv)"
            ++ " {{ return maca_main(maca_args(argc, argv)); }}"
    } else {
        ""
    }
}

c_params(ps: Expr[], i: int) -> str {
    if i >= ps.length() {
        ""
    } else if i == ps.length() - 1 {
        emit_param(ps.get(i))
    } else {
        "{emit_param(ps.get(i))}, {c_params(ps, i + 1)}"
    }
}

emit_param(p: Expr) -> str =>
    c_decl(p.ty, p.text)

emit_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        here = emit_stmt(body.get(i), i == body.length() - 1)
        "{here} {emit_stmts(body, i + 1)}"
    }
}

local_c_type(e: Expr) -> str {
    if e.ty != "" {
        type_c(e.ty)
    } else {
        guessed_c_type(e)
    }
}

guessed_c_type(e: Expr) -> str =>
    match e.kind {
        EStr    => "const char*"
        EFloat  => "double"
        ERecord => e.text
        EList   => "MacaList"
        EBinary => concat_c_type(e)
        EMethod => method_c_type(e)
        ECall   => call_c_type(e)
        _       => "int"
    }

call_c_type(e: Expr) -> str {
    if e.text == "read_file" {
        "const char*"
    } else {
        "int"
    }
}

method_c_type(e: Expr) -> str {
    if e.text == "chars" {
        "MacaList"
    } else if e.text == "upper" {
        "const char*"
    } else {
        "int"
    }
}

concat_c_type(e: Expr) -> str {
    if e.text == "++" {
        "const char*"
    } else {
        "int"
    }
}

emit_stmt(s: Stmt, is_last: bool) -> str {
    if s.kind == SBind {
        "{local_c_type(s.value)} {s.name} = {emit_expr(s.value)};"
    } else if is_last {
        "return {emit_expr(s.value)};"
    } else {
        "{emit_expr(s.value)};"
    }
}

c_preamble() -> str =>
    "#include <string.h>\n#include <stdlib.h>\n#include <stdio.h>\n#include <stdarg.h>\n#include <ctype.h>\n#include <unistd.h>\n#include <sys/wait.h>\n" ++
    "static char* maca_cat(const char* a, const char* b) {{ char* r = malloc(strlen(a) + strlen(b) + 1); strcpy(r, a); strcat(r, b); return r; }}\n" ++
    "static char* maca_int_to_str(int n) {{ char* r = malloc(16); snprintf(r, 16, \"%d\", n); return r; }}\n" ++
    "static char* maca_float_to_str(double x) {{ char* r = malloc(32); if (x == (double)(long long)x && x < 1e15 && x > -1e15) snprintf(r, 32, \"%.1f\", x); else snprintf(r, 32, \"%g\", x); return r; }}\n" ++
    "static const char* maca_bool_to_str(int b) {{ return b ? \"true\" : \"false\"; }}\n" ++
    "static char* maca_upper(const char* s) {{ size_t n = strlen(s); char* r = malloc(n + 1); for (size_t i = 0; i < n; i++) r[i] = toupper((unsigned char)s[i]); r[n] = 0; return r; }}\n" ++
    "typedef struct {{ long* data; int len; }} MacaList;\n" ++
    "static MacaList maca_listv(int n, ...) {{ MacaList l; l.data = malloc(n * sizeof(long)); l.len = n; va_list ap; va_start(ap, n); for (int i = 0; i < n; i++) l.data[i] = va_arg(ap, long); va_end(ap); return l; }}\n" ++
    "static MacaList maca_list_cat(MacaList a, MacaList b) {{ MacaList l; l.len = a.len + b.len; l.data = malloc((l.len ? l.len : 1) * sizeof(long)); memcpy(l.data, a.data, a.len * sizeof(long)); memcpy(l.data + a.len, b.data, b.len * sizeof(long)); return l; }}\n" ++
    "static MacaList maca_list_slice(MacaList a, int lo, int hi) {{ if (lo < 0) lo = 0; if (hi > a.len) hi = a.len; if (hi < lo) hi = lo; MacaList l; l.len = hi - lo; l.data = malloc((l.len ? l.len : 1) * sizeof(long)); memcpy(l.data, a.data + lo, l.len * sizeof(long)); return l; }}\n" ++
    "static int maca_list_index_of(MacaList a, long v) {{ for (int i = 0; i < a.len; i++) if (a.data[i] == v) return i; return -1; }}\n" ++
    "static int maca_list_index_of_str(MacaList a, const char* v) {{ for (int i = 0; i < a.len; i++) if (strcmp((const char*)a.data[i], v) == 0) return i; return -1; }}\n" ++
    "static int maca_str_index_of(const char* a, const char* b) {{ const char* p = strstr(a, b); return p ? (int)(p - a) : -1; }}\n" ++
    "static char* maca_str_slice(const char* s, int from, int to) {{ int n = (int)strlen(s); if (from < 0) from = 0; if (to > n) to = n; if (to < from) to = from; int m = to - from; char* r = malloc(m + 1); memcpy(r, s + from, m); r[m] = 0; return r; }}\n" ++
    "static int maca_ends_with(const char* s, const char* suf) {{ size_t n = strlen(s), m = strlen(suf); return m <= n && memcmp(s + n - m, suf, m) == 0; }}\n" ++
    "static char* maca_list_join(MacaList a, const char* sep) {{ size_t n = 1; for (int i = 0; i < a.len; i++) n += strlen((const char*)a.data[i]) + strlen(sep); char* r = malloc(n); r[0] = 0; for (int i = 0; i < a.len; i++) {{ if (i) strcat(r, sep); strcat(r, (const char*)a.data[i]); }} return r; }}\n" ++
    "static long maca_box(int n, const void* p) {{ void* r = malloc(n); memcpy(r, p, n); return (long)r; }}\n" ++
    "static MacaList maca_chars(const char* s) {{ int n = (int)strlen(s); MacaList l; l.len = n; l.data = malloc((n ? n : 1) * sizeof(long)); for (int i = 0; i < n; i++) {{ char* c = malloc(2); c[0] = s[i]; c[1] = 0; l.data[i] = (long)c; }} return l; }}\n" ++
    "static MacaList maca_args(int argc, char** argv) {{ MacaList l; l.len = argc - 1; l.data = malloc((l.len ? l.len : 1) * sizeof(long)); for (int i = 0; i < l.len; i++) l.data[i] = (long)argv[i + 1]; return l; }}\n" ++
    "static int maca_exec(const char* cmd, MacaList args) {{ char** argv = malloc((args.len + 2) * sizeof(char*)); argv[0] = (char*)cmd; for (int i = 0; i < args.len; i++) argv[i + 1] = (char*)args.data[i]; argv[args.len + 1] = NULL; pid_t pid = fork(); if (pid < 0) return -1; if (pid == 0) {{ execvp(cmd, argv); _exit(127); }} int st = 0; if (waitpid(pid, &st, 0) < 0) return -1; if (WIFEXITED(st)) return WEXITSTATUS(st); if (WIFSIGNALED(st)) return 128 + WTERMSIG(st); return -1; }}\n" ++
    "static char* maca_read_file(const char* path) {{ FILE* f = fopen(path, \"rb\"); if (!f) {{ char* e = malloc(1); e[0] = 0; return e; }} fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET); char* r = malloc(n + 1); size_t got = fread(r, 1, n, f); r[got] = 0; fclose(f); return r; }}\n" ++
    "static int maca_write_file(const char* path, const char* text) {{ FILE* f = fopen(path, \"wb\"); if (!f) return 0; fputs(text, f); fclose(f); return 1; }}\n"

emit_module(m: Module) -> str =>
    c_preamble() ++ emit_types(m.items, 0) ++ emit_protos(m.items, 0)
        ++ emit_bodies(m.items, 0)

is_type_item(s: Stmt) -> bool =>
    s.kind == SRecord || s.kind == SSum

emit_types(items: Stmt[], i: int) -> str {
    if i >= items.length() {
        ""
    } else if is_type_item(items.get(i)) {
        "{emit_item(items.get(i))}\n{emit_types(items, i + 1)}"
    } else {
        emit_types(items, i + 1)
    }
}

emit_protos(items: Stmt[], i: int) -> str {
    if i >= items.length() {
        ""
    } else if is_type_item(items.get(i)) {
        emit_protos(items, i + 1)
    } else {
        "{emit_proto(items.get(i))}\n{emit_protos(items, i + 1)}"
    }
}

emit_bodies(items: Stmt[], i: int) -> str {
    if i >= items.length() {
        ""
    } else if is_type_item(items.get(i)) {
        emit_bodies(items, i + 1)
    } else {
        "{emit_fn(items.get(i))}\n{emit_bodies(items, i + 1)}"
    }
}

emit_proto(s: Stmt) -> str =>
    "{type_c(s.ret)} {c_name(s)}({c_params(s.params, 0)});"

emit_item(s: Stmt) -> str {
    if s.kind == SRecord {
        emit_struct(s)
    } else {
        emit_sum(s)
    }
}

emit_struct(s: Stmt) -> str {
    fields = s.params.map(emit_struct_field).join(" ")

    "typedef struct {{ {fields} }} {s.name};"
}

emit_struct_field(f: Expr) -> str =>
    "{type_c(f.ty)} {f.text};"

emit_sum(s: Stmt) -> str {
    if payload_arity(s.params, 0) == 0 {
        variants = s.params.map(variant_name).join(", ")
        "typedef enum {{ {variants} }} {s.name};"
    } else {
        emit_tagged_sum(s)
    }
}

variant_name(v: Expr) -> str =>
    v.text

emit_tagged_sum(s: Stmt) -> str {
    tags = s.params.map(tag_name).join(", ")
    slots = emit_slots(payload_arity(s.params, 0), 0)

    "typedef enum {{ {tags} }} {s.name}_tag;\n"
        ++ "typedef struct {{ {s.name}_tag tag; {slots}}} {s.name};\n"
        ++ emit_ctors(s.name, s.params, 0)
}

tag_name(v: Expr) -> str =>
    "{v.text}_tag"

payload_arity(vs: Expr[], i: int) -> int {
    if i >= vs.length() {
        0
    } else {
        wider(vs.get(i).children.length(), payload_arity(vs, i + 1))
    }
}

wider(a: int, b: int) -> int {
    if a > b {
        a
    } else {
        b
    }
}

emit_slots(n: int, i: int) -> str {
    if i >= n {
        ""
    } else {
        "long _{i}; {emit_slots(n, i + 1)}"
    }
}

emit_ctors(sum: str, vs: Expr[], i: int) -> str {
    if i >= vs.length() {
        ""
    } else {
        emit_ctor(sum, vs.get(i)) ++ emit_ctors(sum, vs, i + 1)
    }
}

emit_ctor(sum: str, v: Expr) -> str =>
    "static inline {sum} {v.text}({ctor_params(v.children, 0)}) "
        ++ "{{ {sum} _v; _v.tag = {v.text}_tag; "
        ++ ctor_assigns(v.children, 0) ++ "return _v; }}\n"

ctor_params(ps: Expr[], i: int) -> str {
    if ps.length() == 0 {
        "void"
    } else if i >= ps.length() {
        ""
    } else if i == ps.length() - 1 {
        "long _{i}"
    } else {
        "long _{i}, {ctor_params(ps, i + 1)}"
    }
}

ctor_assigns(ps: Expr[], i: int) -> str {
    if i >= ps.length() {
        ""
    } else {
        "_v._{i} = _{i}; {ctor_assigns(ps, i + 1)}"
    }
}
