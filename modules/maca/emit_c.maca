import maca/token
import maca/ast

quoted(s: str) -> str =>
    "\"" ++ s ++ "\""

Reserved = " auto break case char const continue default do double else enum extern float for goto if inline int long register restrict return short signed sizeof static struct switch typedef union unsigned void volatile while bool class new delete this template typeof unix linux i386 abs bind clock close div exit free index link listen log open pow read remove stat strlen time write "

c_id(name: str) -> str {
    if Reserved.index_of(" {name} ") >= 0 {
        "{name}_mc"
    } else {
        name
    }
}

emit_expr(e: Expr) -> str =>
    match e.kind {
        EInt     => str(e.ival)
        EFloat   => e.text
        EStr     => quoted(e.text)
        EBool    => emit_bool(e)
        EIdent   => c_id(e.text)
        ECall    => emit_call(e)
        EBinary  => emit_binary(e)
        ETernary => emit_ternary(e)
        EIf      => emit_ternary(e)
        EUnary   => emit_unary(e)
        ERecord  => "({e.text}){{ {emit_lit_fields(e.children, 0)} }}"
        EWith    => emit_with(e)
        EBlock   => emit_block(e)
        EField   => "{emit_expr(e.children.get(0))}.{c_id(e.text)}"
        EMatch   => emit_match(e)
        EMethod  => emit_method(e)
        EList    => emit_list(e)
        EJump    => emit_jump(e, "")
        EWhile   => "({{ {emit_while(e)} 0; }})"
        EFor     => "({{ {emit_for(e)} 0; }})"
        _        => "0"
    }

emit_while(e: Expr) -> str =>
    "while ({emit_expr(e.children.get(0))})"
        ++ " {{ {block_stmts(e.stmts, 0)}}}"

emit_for(e: Expr) -> str {
    over = e.children.get(0)
    el = c_elem_of(over.ty)
    cell = c_cell_at("_f", el, "_fi")

    "{{ MacaList _f = {emit_expr(over)};"
        ++ " for (int _fi = 0; _fi < _f.len; _fi++) {{ {type_c(el)}"
        ++ " {c_id(e.text)}"
        ++ " = {cell}; {block_stmts(e.stmts, 0)}}} }}"
}

is_loop(e: Expr) -> bool =>
    e.kind == EWhile || e.kind == EFor

emit_loop(e: Expr) -> str {
    if e.kind == EWhile {
        emit_while(e)
    } else {
        emit_for(e)
    }
}

emit_unary(e: Expr) -> str {
    if e.text == "fail" {
        "maca_fail({emit_expr(e.children.get(0))})"
    } else if e.text == "try" {
        "({{ jmp_buf* _jb = maca_try_push(); char* _tr;"
            ++ " if (setjmp(*_jb) == 0) {{ (void)({emit_expr(e.children.get(0))});"
            ++ " maca_try_pop(); _tr = maca_cat(\"\", \"\"); }}"
            ++ " else {{ _tr = maca_last_fail(); }} _tr; }})"
    } else if e.text == "spawn" {
        emit_spawn(e.children.get(0))
    } else if e.text == "await" {
        "((int)maca_await({emit_expr(e.children.get(0))}))"
    } else {
        "({e.text}{emit_expr(e.children.get(0))})"
    }
}

emit_spawn(call: Expr) -> str {
    task = c_id(call.text)
    n = call.children.length()

    if n == 0 {
        "maca_spawn((MacaTask){task}, 0)"
    } else if n == 1 {
        "maca_spawn((MacaTask){task},"
            ++ " (long)({emit_expr(call.children.get(0))}))"
    } else {
        "maca_spawn2((MacaTask2){task},"
            ++ " (long)({emit_expr(call.children.get(0))}),"
            ++ " (long)({emit_expr(call.children.get(1))}))"
    }
}

emit_jump(e: Expr, ret: str) -> str {
    if e.text != "return" {
        e.text
    } else if e.children.length() == 0 {
        "return {c_zero(ret)}"
    } else {
        "return {emit_expr(e.children.get(0))}"
    }
}

emit_bool(e: Expr) -> str {
    if e.text == "true" {
        "1"
    } else {
        "0"
    }
}

emit_ternary(e: Expr) -> str {
    cond = emit_expr(e.children.get(0))
    then = c_arm(e.children.get(1), e.children.get(2).ty)
    els = if is_missing_else(e.children.get(2)) {
        c_zero(e.children.get(1).ty)
    } else {
        c_arm(e.children.get(2), e.children.get(1).ty)
    }

    "({cond} ? {then} : {els})"
}

/// A branch that raises answers nothing, so it takes the other branch's type.
c_arm(e: Expr, other: str) -> str {
    if is_raise(e) {
        "({emit_expr(e)}, {c_zero(other)})"
    } else {
        emit_expr(e)
    }
}

emit_list(e: Expr) -> str {
    n = e.children.length()

    if n == 0 {
        "maca_listv(0)"
    } else {
        "maca_listv({str(n)}, {c_cells(c_elem_of(e.ty), e.children, 0)})"
    }
}

c_cells(el: str, cs: Expr[], i: int) -> str {
    if i >= cs.length() {
        ""
    } else if i == cs.length() - 1 {
        c_cell(el, cs.get(i))
    } else {
        "{c_cell(el, cs.get(i))}, {c_cells(el, cs, i + 1)}"
    }
}

c_cell(el: str, e: Expr) -> str =>
    c_cell_of(el, emit_expr(e))

c_cell_of(el: str, code: str) -> str {
    if c_boxed(el) {
        ct = type_c(el)

        "maca_box(sizeof({ct}), ({ct}[]){{ {code} }})"
    } else {
        "(long)({code})"
    }
}

c_cell_at(recv: str, el: str, ix: str) -> str {
    if c_boxed(el) {
        "(*({type_c(el)}*){recv}.data[{ix}])"
    } else if el == "str" {
        "((const char*){recv}.data[{ix}])"
    } else {
        "((long){recv}.data[{ix}])"
    }
}

c_boxed(el: str) -> bool =>
    el != "" && el != "int" && el != "bool" && el != "str"

c_elem_of(ty: str) -> str {
    if is_list_type(ty) {
        ty.slice(0, ty.length() - 2)
    } else {
        ""
    }
}

map_method(name: str) -> bool =>
    name == "get" || name == "set" || name == "has" || name == "keys"
        || name == "length" || name == "count" || name == "remove"
        || name == "values" || name == "contains"

/// A map is two lists side by side, so a key is an index into both.
emit_map_method(e: Expr, recv: str) -> str {
    val = map_type_val(e.children.get(0).ty)
    key = e.children.length() > 1 ? emit_expr(e.children.get(1)) : ""

    if e.text == "keys" {
        "maca_map_keys({recv})"
    } else if e.text == "values" {
        "maca_map_vals({recv})"
    } else if e.text == "length" || e.text == "count" {
        "({recv}.keys.len)"
    } else if e.text == "has" || e.text == "contains" {
        "maca_map_has({recv}, {key})"
    } else if e.text == "set" {
        "maca_map_set({recv}, {key}, (long)({emit_expr(e.children.get(2))}))"
    } else if e.text == "remove" {
        "maca_map_remove({recv}, {key})"
    } else if e.children.length() > 2 {
        c_map_read(val, "maca_map_or({recv}, {key},"
                            ++ " (long)({emit_expr(e.children.get(2))}))")
    } else {
        c_map_read(val, "maca_map_get({recv}, {key})")
    }
}

/// Every cell is a long, so a read casts back to what the map was declared over.
c_map_read(val: str, call: str) -> str {
    if val == "int" || val == "bool" {
        "((long){call})"
    } else {
        "((const char*){call})"
    }
}

/// A user type answers to no builtin method, so `x.f(y)` on one is `f(x, y)`.
c_own_type(ty: str) -> bool =>
    ty != "" && ty != "str" && ty != "int" && ty != "bool" && ty != "float"
        && ty != "Element" && !is_list_type(ty) && !is_map_type(ty)
        && !c_sized_number(ty) && !is_vector_type(ty)

/// A width-tagged number is the number it tags, so `f32` is a float and `i32` an int.
c_sized_number(ty: str) -> bool =>
    ty.length() > 1 && ty.at(1).is_ascii_digit() && ty.index_of("x") < 0
        && (ty.at(0) == "i" || ty.at(0) == "u" || ty.at(0) == "f")

c_sized_float(ty: str) -> bool =>
    c_sized_number(ty) && ty.at(0) == "f"

/// A vector type is a width-tagged scalar carrying a lane count, `f32x8`.
is_vector_type(ty: str) -> bool =>
    c_vec_lanes(ty) > 1

c_vec_lanes(ty: str) -> int {
    at = ty.index_of("x")

    if at < 2 || !c_sized_number(ty.slice(0, at)) {
        0
    } else {
        int(ty.slice(at + 1, ty.length()))
    }
}

c_vec_scalar(ty: str) -> str =>
    type_c(ty.slice(0, ty.index_of("x")))

c_vec_splat(ty: str, arg: str) -> str {
    one = "{arg}, "
    lanes = one.repeat(c_vec_lanes(ty))

    "(({ty}){{ {lanes} }})"
}

c_vec_sum(ty: str, recv: str) -> str {
    over = "for (int _vi = 0; _vi < {c_vec_lanes(ty)}; _vi++)"

    "({{ {ty} _v = {recv}; {c_vec_scalar(ty)} _a = 0;"
        ++ " {over} _a += _v[_vi]; _a; }})"
}

emit_method(e: Expr) -> str {
    recv = emit_expr(e.children.get(0))
    rty = e.children.get(0).ty
    on_list = is_list_type(rty)
    on_str = rty == "str"
    el = c_elem_of(rty)

    if e.text == "splat" && is_vector_type(e.children.get(0).text) {
        c_vec_splat(e.children.get(0).text, emit_expr(e.children.get(1)))
    } else if e.text == "sum" && is_vector_type(rty) {
        c_vec_sum(rty, recv)
    } else if c_own_type(rty) {
        "{c_id(e.text)}({c_ufcs_args(recv, e.children)})"
    } else if is_map_type(rty) && map_method(e.text) {
        emit_map_method(e, recv)
    } else if e.text == "count" || (e.text == "length" && on_list) {
        "({recv}.len)"
    } else if e.text == "length" {
        "((int)strlen({recv}))"
    } else if e.text == "at" || (e.text == "get" && on_str) {
        c_at(recv, on_str, emit_expr(e.children.get(1)))
    } else if e.text == "get" {
        c_cell_at(recv, el, emit_expr(e.children.get(1)))
    } else if e.text == "slice" && on_list {
        "maca_list_slice({recv}, {emit_expr(e.children.get(1))},"
            ++ " {emit_expr(e.children.get(2))})"
    } else if e.text == "slice" {
        "maca_str_slice({recv}, {emit_expr(e.children.get(1))},"
            ++ " {emit_expr(e.children.get(2))})"
    } else if e.text == "ends_with" {
        "maca_ends_with({recv}, {emit_expr(e.children.get(1))})"
    } else if e.text == "index_of" && on_list {
        c_list_find(recv, el, e.children.get(1))
    } else if e.text == "index_of" {
        "maca_str_index_of({recv}, {emit_expr(e.children.get(1))})"
    } else if e.text == "join" {
        "maca_list_join({recv}, {emit_expr(e.children.get(1))})"
    } else if e.text == "push" {
        "maca_list_cat({recv}, maca_listv(1,"
            ++ " {c_cell(el, e.children.get(1))}))"
    } else if e.text == "map" || e.text == "parallel" {
        emit_map(e)
    } else if e.text == "filter" {
        emit_filter(e)
    } else if e.text == "reduce" || e.text == "fold" {
        emit_reduce(e)
    } else if e.text == "chars" {
        "maca_chars({recv})"
    } else if e.text == "is_whitespace" {
        "(isspace((unsigned char){c_char(recv, on_str)}) != 0)"
    } else if e.text == "is_ascii_digit" {
        "(isdigit((unsigned char){c_char(recv, on_str)}) != 0)"
    } else if e.text == "is_alpha" {
        "(isalpha((unsigned char){c_char(recv, on_str)}) != 0)"
    } else if e.text == "upper" && on_str {
        "maca_upper({recv})"
    } else if e.text == "upper" {
        "toupper((unsigned char){c_char(recv, on_str)})"
    } else if e.text == "contains" && on_list {
        "({c_list_find(recv, el, e.children.get(1))} >= 0)"
    } else if e.text == "contains" {
        "(strstr({recv}, {emit_expr(e.children.get(1))}) != NULL)"
    } else if on_list && c_list_method(e.text) {
        emit_list_method(e, recv, el)
    } else if c_padding(e.text) && e.children.length() == 2 {
        "maca_{e.text}({recv}, {emit_expr(e.children.get(1))}, \" \")"
    } else if c_str_method(e.text) {
        "maca_{e.text}({c_ufcs_args(recv, e.children)})"
    } else {
        "{c_id(e.text)}({c_ufcs_args(recv, e.children)})"
    }
}

c_list_method(name: str) -> bool =>
    name == "sum" || name == "min" || name == "max" || name == "first"
        || name == "last" || name == "pop" || name == "reverse"
        || name == "sort" || name == "set" || name == "insert"
        || name == "remove"

emit_list_method(e: Expr, recv: str, el: str) -> str {
    held = type_c(el)
    cell = c_cell_at("_q", el, "_qi")
    over = "for (int _qi = 0; _qi < _q.len; _qi++)"
    arg1 = emit_args(e.children, 1)

    if e.text == "sum" {
        c_over(recv, "{held} _a = 0; {over} _a += {cell}; _a;")
    } else if e.text == "min" {
        c_over(recv, c_fold_pick(held, over, el, "<"))
    } else if e.text == "max" {
        c_over(recv, c_fold_pick(held, over, el, ">"))
    } else if e.text == "first" {
        c_over(recv, "_q.len ? {c_cell_at("_q", el, "0")} : {c_zero(el)};")
    } else if e.text == "last" {
        c_over(recv, "_q.len ? {c_cell_at("_q", el, "_q.len - 1")}"
            ++ " : {c_zero(el)};")
    } else if e.text == "pop" {
        c_over(recv, "maca_list_slice(_q, 0, _q.len - 1);")
    } else if e.text == "reverse" {
        "maca_list_reverse({recv})"
    } else if e.text == "sort" {
        "maca_list_sorted({recv}, {c_cell_kind(el)})"
    } else if e.text == "remove" {
        "maca_list_remove({recv}, {arg1})"
    } else {
        "maca_list_{e.text}({recv}, {emit_expr(e.children.get(1))},"
            ++ " {c_cell(el, e.children.get(2))})"
    }
}

c_over(recv: str, body: str) -> str =>
    "({{ MacaList _q = {recv}; {body} }})"

c_fold_pick(held: str, over: str, el: str, op: str) -> str {
    cell = c_cell_at("_q", el, "_qi")

    "{held} _a = _q.len ? {c_cell_at("_q", el, "0")} : {c_zero(el)};"
        ++ " {over} if ({cell} {op} _a) _a = {cell}; _a;"
}

c_cell_kind(el: str) -> str {
    if el == "str" {
        "1"
    } else if el == "float" {
        "2"
    } else {
        "0"
    }
}

c_padding(name: str) -> bool =>
    name == "pad_start" || name == "pad_end"

c_str_method(name: str) -> bool =>
    name == "trim" || name == "lower" || name == "replace"
        || name == "repeat" || name == "substr" || name == "starts_with"
        || name == "split" || name == "pad_start" || name == "pad_end"
        || name == "pad_center" || name == "fixed"

c_ufcs_args(recv: str, cs: Expr[]) -> str {
    rest = emit_args(cs, 1)

    if rest == "" {
        recv
    } else {
        "{recv}, {rest}"
    }
}

c_apply(f: Expr, el: str, arg: str) -> str {
    if f.kind != ELambda {
        "{emit_expr(f)}({arg})"
    } else {
        "({{ {type_c(el)} {c_id(f.children.get(0).text)} = {arg};"
            ++ " {emit_expr(lambda_body(f))}; }})"
    }
}

emit_map(e: Expr) -> str {
    src = emit_expr(e.children.get(0))
    el = c_elem_of(e.children.get(0).ty)
    cell = c_cell_at("_m", el, "_i")
    f = e.children.get(1)
    got = c_cell_of(c_elem_of(e.ty), c_apply(f, el, cell))

    "({{ MacaList _m = {src}; MacaList _r; _r.len = _m.len;"
        ++ " _r.data = malloc((_r.len ? _r.len : 1) * sizeof(long));"
        ++ " for (int _i = 0; _i < _m.len; _i++) _r.data[_i] = {got};"
        ++ " _r; }})"
}

emit_filter(e: Expr) -> str {
    src = emit_expr(e.children.get(0))
    el = c_elem_of(e.children.get(0).ty)
    cell = c_cell_at("_m", el, "_i")
    kept = c_apply(e.children.get(1), el, cell)

    "({{ MacaList _m = {src}; MacaList _r; _r.len = 0;"
        ++ " _r.data = malloc((_m.len ? _m.len : 1) * sizeof(long));"
        ++ " for (int _i = 0; _i < _m.len; _i++)"
        ++ " if ({kept}) _r.data[_r.len++] = _m.data[_i]; _r; }})"
}

emit_reduce(e: Expr) -> str {
    src = emit_expr(e.children.get(0))
    el = c_elem_of(e.children.get(0).ty)
    cell = c_cell_at("_m", el, "_i")
    seed = e.children.get(1)
    held = local_c_type(seed)

    "({{ MacaList _m = {src}; {held} _acc = {emit_expr(seed)};"
        ++ " for (int _i = 0; _i < _m.len; _i++) _acc ="
        ++ " {c_apply2(e.children.get(2), held, el, cell)}; _acc; }})"
}

c_apply2(f: Expr, held: str, el: str, cur: str) -> str {
    if f.kind != ELambda {
        "{emit_expr(f)}(_acc, {cur})"
    } else {
        "({{ {held} {c_id(f.children.get(0).text)} = _acc;"
            ++ " {type_c(el)} {c_id(f.children.get(1).text)} = {cur};"
            ++ " {emit_expr(lambda_body(f))}; }})"
    }
}

c_list_find(recv: str, el: str, want: Expr) -> str {
    if el == "str" {
        "maca_list_index_of_str({recv}, {emit_expr(want)})"
    } else {
        "maca_list_index_of({recv}, {c_cell(el, want)})"
    }
}

c_at(recv: str, on_str: bool, ix: str) -> str {
    if on_str {
        "maca_str_at({recv}, {ix})"
    } else {
        "((int){recv}[{ix}])"
    }
}

c_char(recv: str, on_str: bool) -> str {
    if on_str {
        "({recv})[0]"
    } else {
        "({recv})"
    }
}

is_list_type(ty: str) -> bool =>
    ty.length() >= 2 && ty.slice(ty.length() - 2, ty.length()) == "[]"

emit_call(e: Expr) -> str {
    args = emit_args(e.children, 0)

    if e.text == "map" && e.children.length() == 0 {
        "maca_map_new()"
    } else if e.text == "info" {
        "printf(\"%s\\n\", {args})"
    } else if e.text == "print" {
        "printf(\"%s\", {args})"
    } else if e.text == "str" {
        c_str_of(c_arg_ty(e.children), args)
    } else if e.text == "int" {
        c_int_of(c_arg_ty(e.children), args)
    } else if e.text == "read_file" {
        "maca_read_file({args})"
    } else if e.text == "write_file" {
        "maca_write_file({args})"
    } else if e.text == "read_line" {
        "maca_input(\"\")"
    } else if e.text == "exec" {
        "maca_exec({args})"
    } else if e.text == "assert" {
        "maca_assert({args})"
    } else if e.text == "assert_eq" {
        c_assert_eq(e.children)
    } else if e.text == "failures" {
        "maca_failures()"
    } else {
        emit_prelude(e, args)
    }
}

emit_prelude(e: Expr, args: str) -> str {
    if e.text == "float" {
        "((double)({args}))"
    } else if c_math_call(e.text) {
        "__builtin_{e.text}((double)({args}))"
    } else if e.text == "pow" {
        "__builtin_pow({args})"
    } else if e.text == "abs" {
        "({{ __typeof__({args}) _x = {args}; _x < 0 ? -_x : _x; }})"
    } else if e.text == "sign" {
        "({{ __typeof__({args}) _x = {args}; (_x > 0) - (_x < 0); }})"
    } else if e.text == "clamp" && e.children.length() == 3 {
        c_clamp(e)
    } else if e.text == "gcd" && e.children.length() == 2 {
        c_gcd(e)
    } else if e.text == "len" {
        c_len(e.children, args)
    } else if c_picking(e.text) && e.children.length() == 2 {
        c_pick2(e)
    } else if e.text == "err" || e.text == "warn" {
        "fprintf(stderr, \"%s\\n\", {args})"
    } else if c_runtime_call(e.text) {
        "maca_{e.text}({args})"
    } else {
        "{c_id(e.text)}({args})"
    }
}

c_math_call(name: str) -> bool =>
    name == "sqrt" || name == "floor" || name == "ceil" || name == "round"
        || name == "sin" || name == "cos" || name == "tan" || name == "log"
        || name == "exp"

c_picking(name: str) -> bool =>
    name == "min" || name == "max"

c_pick2(e: Expr) -> str {
    a = emit_expr(e.children.get(0))
    b = emit_expr(e.children.get(1))
    op = if e.text == "min" { "<" } else { ">" }

    "({{ __typeof__({a}) _x = {a}, _y = {b};"
        ++ " _x {op} _y ? _x : _y; }})"
}

c_clamp(e: Expr) -> str {
    v = emit_expr(e.children.get(0))
    lo = emit_expr(e.children.get(1))
    hi = emit_expr(e.children.get(2))

    "({{ __typeof__({v}) _v = {v}, _lo = {lo}, _hi = {hi};"
        ++ " _v < _lo ? _lo : (_v > _hi ? _hi : _v); }})"
}

c_gcd(e: Expr) -> str {
    a = emit_expr(e.children.get(0))
    b = emit_expr(e.children.get(1))

    "({{ __typeof__({a}) _a = {a}, _b = {b};"
        ++ " while (_b) {{ __typeof__(_a) _t = _b; _b = _a % _b; _a = _t; }}"
        ++ " _a < 0 ? -_a : _a; }})"
}

c_len(cs: Expr[], args: str) -> str {
    if is_list_type(c_arg_ty(cs)) {
        "({args}).len"
    } else {
        "((int)strlen({args}))"
    }
}

c_runtime_call(name: str) -> bool =>
    c_char_call(name) || c_file_call(name) || c_host_call(name)

c_char_call(name: str) -> bool =>
    name == "chr" || name == "ord" || name == "now_ms"
        || name == "now_iso" || name == "format_time" || name == "sleep_ms"

c_file_call(name: str) -> bool =>
    name == "file_exists" || name == "is_dir" || name == "file_size"
        || name == "modified_ms" || name == "make_dir" || name == "list_dir"
        || name == "remove_file" || name == "remove_dir"
        || name == "copy_bytes" || name == "real_path"

c_host_call(name: str) -> bool =>
    name == "env" || name == "cwd" || name == "chdir" || name == "is_tty"
        || name == "capture" || name == "capture_err"

c_assert_eq(cs: Expr[]) -> str =>
    "maca_assert_eq({c_shown(cs, 0)}, {c_shown(cs, 1)}, {c_shown(cs, 2)})"

c_shown(cs: Expr[], i: int) -> str {
    if i >= cs.length() {
        "\"\""
    } else {
        c_str_of(cs.get(i).ty, emit_expr(cs.get(i)))
    }
}

c_arg_ty(cs: Expr[]) -> str {
    if cs.length() == 0 {
        ""
    } else {
        cs.get(0).ty
    }
}

c_str_of(ty: str, args: str) -> str {
    if ty == "str" {
        args
    } else if ty == "float" || c_sized_float(ty) {
        "maca_float_to_str({args})"
    } else if ty == "bool" {
        "maca_bool_to_str({args})"
    } else if is_list_type(ty) {
        c_list_str(c_elem_of(ty), args)
    } else {
        "maca_int_to_str({args})"
    }
}

c_list_str(el: str, code: str) -> str =>
    "({{ MacaList _t = {code}; char* _s = maca_cat(\"[\", \"\");"
        ++ " for (int _ti = 0; _ti < _t.len; _ti++) {{"
        ++ " if (_ti) _s = maca_cat(_s, \", \");"
        ++ " _s = maca_cat(_s, {c_str_of(el, c_cell_at("_t", el, "_ti"))});"
        ++ " }} _s = maca_cat(_s, \"]\"); _s; }})"

c_int_of(ty: str, args: str) -> str {
    if ty == "int" {
        args
    } else if ty == "float" || ty == "bool" {
        "((long)({args}))"
    } else {
        "atol({args})"
    }
}

/// Two `char*` compared with `<` compares addresses, so every comparison on text goes through strcmp.
c_compare(op: str) -> bool =>
    op == "==" || op == "!=" || op == "<" || op == ">"
        || op == "<=" || op == ">="

c_is_str(e: Expr) -> bool =>
    e.kind == EStr || e.ty == "str"

c_joins(op: str, l: Expr, r: Expr) -> bool =>
    op == "++" || (op == "+" && ((c_is_str(l) && c_is_str(r))
                                     || (is_list_type(l.ty)
                                             && is_list_type(r.ty))))

emit_binary(e: Expr) -> str {
    l = e.children.get(0)
    r = e.children.get(1)
    is_cmp = c_compare(e.text)
    is_str_eq = is_cmp && (c_is_str(l) || c_is_str(r))

    if e.text == "=" && l.kind == EMethod && l.text == "get" {
        c_store(l, r)
    } else if e.text == ".." {
        "maca_range({emit_expr(l)}, {emit_expr(r)})"
    } else if c_overload(e.text) != "" && c_own_type(l.ty) {
        "{c_id(c_overload(e.text))}({emit_expr(l)}, {emit_expr(r)})"
    } else if c_joins(e.text, l, r)
            && (is_list_type(l.ty) || is_list_type(r.ty)) {
        "maca_list_cat({emit_expr(l)}, {emit_expr(r)})"
    } else if c_joins(e.text, l, r) {
        "maca_cat({emit_expr(l)}, {emit_expr(r)})"
    } else if is_str_eq {
        "(strcmp({emit_expr(l)}, {emit_expr(r)}) {e.text} 0)"
    } else if e.text == "/" && c_is_str(l) {
        "maca_path_join({emit_expr(l)}, {emit_expr(r)})"
    } else {
        "({emit_expr(l)} {e.text} {emit_expr(r)})"
    }
}

/// On a user type an operator is the same-named function, so `a + b` is `add(a, b)`.
c_overload(op: str) -> str {
    if op == "+" {
        "add"
    } else if op == "-" {
        "sub"
    } else if op == "*" {
        "mul"
    } else if op == "/" {
        "div"
    } else if op == "%" {
        "rem"
    } else if op == "++" {
        "concat"
    } else {
        ""
    }
}

c_store(l: Expr, r: Expr) -> str {
    holder = l.children.get(0)
    el = c_elem_of(holder.ty)

    "{emit_expr(holder)}.data[{emit_expr(l.children.get(1))}] ="
        ++ " {c_cell(el, r)}"
}

emit_match(e: Expr) -> str =>
    emit_arms(emit_expr(e.children.get(0)), e.children, 1,
              c_elem_of(e.children.get(0).ty), e.children.get(0).ty)

/// A match run for its effect answers nothing, so its arms are statements.
emit_match_stmt(e: Expr) -> str =>
    stmt_arms(emit_expr(e.children.get(0)), e.children, 1,
              any_bound(e.children, 1), c_elem_of(e.children.get(0).ty),
              e.children.get(0).ty)

stmt_arms(scrut: str, cs: Expr[], i: int, tagged: bool, el: str,
          sum: str) -> str {
    if i + 1 >= cs.length() {
        ""
    } else if cs.get(i).text == "_" && cs.get(i).kind != EGuard {
        "{{ {emit_expr(cs.get(i + 1))}; }}"
    } else {
        head = "if ({test(scrut, cs.get(i), tagged, el)})"
            ++ " {{ {arm_body(scrut, cs.get(i), cs.get(i + 1), el, sum)}; }}"
        rest = stmt_arms(scrut, cs, i + 2, tagged, el, sum)

        rest == "" ? head : "{head} else {rest}"
    }
}

emit_arms(scrut: str, cs: Expr[], i: int, el: str, sum: str) -> str =>
    emit_arms_at(scrut, cs, i, any_bound(cs, 1), el, sum)

emit_arms_at(scrut: str, cs: Expr[], i: int, tagged: bool, el: str,
             sum: str) -> str {
    if i + 1 >= cs.length() {
        "0"
    } else if cs.get(i).text == "_" && cs.get(i).kind != EGuard {
        emit_expr(cs.get(i + 1))
    } else if i + 3 >= cs.length() && cs.get(i).kind != EGuard {
        arm_body(scrut, cs.get(i), cs.get(i + 1), el, sum)
    } else {
        cond = test(scrut, cs.get(i), tagged, el)
        body = arm_body(scrut, cs.get(i), cs.get(i + 1), el, sum)
        rest = emit_arms_at(scrut, cs, i + 2, tagged, el, sum)
        "({cond} ? {body} : {rest})"
    }
}

bound_pat(p: Expr) -> bool {
    if p.kind == EGuard {
        bound_pat(p.children.get(0))
    } else if is_alt_pat(p) || is_fields_pat(p) || is_cells_pat(p) {
        false
    } else {
        p.children.length() > 0
    }
}

any_bound(cs: Expr[], i: int) -> bool {
    if i >= cs.length() {
        false
    } else if bound_pat(cs.get(i)) {
        true
    } else {
        any_bound(cs, i + 2)
    }
}

is_alt_pat(p: Expr) -> bool =>
    p.kind == EBinary && p.text == "|"

is_cells_pat(p: Expr) -> bool =>
    p.kind == EIdent && (p.text == "[]" || p.text == "[..]")

/// `[x, ..rest]` matches from that many cells on; `[x]` matches exactly that many.
cells_test(scrut: str, p: Expr) -> str {
    n = p.children.length()
    size = if p.text == "[..]" {
        "{scrut}.len >= {str(n - 1)}"
    } else {
        "{scrut}.len == {str(n)}"
    }

    size ++ literal_cells(scrut, p, 0)
}

/// A cell the pattern spelled out is a value to compare, not a name to bind.
literal_cells(scrut: str, p: Expr, i: int) -> str {
    if i >= p.children.length() {
        ""
    } else if p.children.get(i).kind != EStr {
        literal_cells(scrut, p, i + 1)
    } else {
        " && strcmp({c_cell_at(scrut, "str", str(i))},"
            ++ " {quoted(p.children.get(i).text)}) == 0"
            ++ "{literal_cells(scrut, p, i + 1)}"
    }
}

bind_cells(scrut: str, p: Expr, el: str, i: int) -> str {
    if i >= p.children.length() {
        ""
    } else if p.children.get(i).kind == EStr {
        bind_cells(scrut, p, el, i + 1)
    } else if p.text == "[..]" && i == p.children.length() - 1 {
        "MacaList {c_id(p.children.get(i).text)} ="
            ++ " maca_list_slice({scrut}, {str(i)}, {scrut}.len);"
    } else {
        "{type_c(el)} {c_id(p.children.get(i).text)} ="
            ++ " {c_cell_at(scrut, el, str(i))};"
            ++ " {bind_cells(scrut, p, el, i + 1)}"
    }
}

test(scrut: str, pat: Expr, tagged: bool, el: str) -> str {
    if pat.kind == EGuard {
        guard_test(scrut, pat, tagged, el)
    } else if is_alt_pat(pat) {
        "({test(scrut, pat.children.get(0), tagged, el)}"
            ++ " || {test(scrut, pat.children.get(1), tagged, el)})"
    } else if is_cells_pat(pat) {
        cells_test(scrut, pat)
    } else if is_fields_pat(pat) || is_bind_pat(pat) {
        "1"
    } else if pat.kind == EStr && el != "" {
        one_cell_test(scrut, pat, el)
    } else if tagged {
        "{scrut}.tag == {pat.text}_tag"
    } else if pat.kind == EStr {
        "(strcmp({scrut}, {quoted(pat.text)}) == 0)"
    } else {
        "{scrut} == {c_id(pat.text)}"
    }
}

/// A bare literal against a list is the one-cell list pattern its comma never spelled.
one_cell_test(scrut: str, pat: Expr, el: str) -> str =>
    "{scrut}.len == 1 && strcmp({c_cell_at(scrut, el, "0")},"
        ++ " {quoted(pat.text)}) == 0"

guard_test(scrut: str, pat: Expr, tagged: bool, el: str) -> str {
    when = emit_expr(pat.children.get(1))

    if pat.children.get(0).text == "_" {
        when
    } else if is_bind_pat(pat.children.get(0)) {
        "({{ {bind_one(scrut, pat.children.get(0))}{when}; }})"
    } else {
        "({test(scrut, pat.children.get(0), tagged, el)} && {when})"
    }
}

/// `{ a, b }` names fields rather than slots, so it matches anything and binds by name.
is_fields_pat(p: Expr) -> bool =>
    p.kind == EIdent && p.text == "{{}}"

/// A bare name that resolved to nothing is a binder, not a value to compare against.
is_bind_pat(p: Expr) -> bool =>
    p.kind == EIdent && c_lower_name(p.text) && p.children.length() == 0
        && !is_cells_pat(p) && !is_fields_pat(p)

/// Maca capitalises a variant, so a lowercase name in a pattern is a binder and not a value.
c_lower_name(name: str) -> bool =>
    name.length() > 0 && name.at(0).is_alpha()
        && name.at(0).upper() != name.at(0)

bind_one(scrut: str, p: Expr) -> str =>
    "__typeof__({scrut}) {c_id(p.text)} = {scrut}; "

arm_body(scrut: str, pat: Expr, body: Expr, arm_elem: str,
         sum: str) -> str {
    if pat.kind == EGuard {
        arm_body(scrut, pat.children.get(0), body, arm_elem, sum)
    } else if is_cells_pat(pat) && pat.children.length() > 0 {
        "({{ {bind_cells(scrut, pat, arm_elem, 0)}{emit_expr(body)}; }})"
    } else if is_bind_pat(pat) {
        "({{ {bind_one(scrut, pat)}{emit_expr(body)}; }})"
    } else if pat.children.length() == 0 || is_alt_pat(pat) {
        emit_expr(body)
    } else if is_fields_pat(pat) {
        "({{ {bind_fields(scrut, pat.children, 0)}{emit_expr(body)}; }})"
    } else {
        "({{ {bind_slots(scrut, pat.children, sum, 0)}{emit_expr(body)}; }})"
    }
}

bind_fields(scrut: str, fs: Expr[], i: int) -> str {
    if i >= fs.length() {
        ""
    } else {
        "__typeof__({scrut}.{c_id(fs.get(i).text)}) {c_id(fs.get(i).text)}"
            ++ " = {scrut}.{c_id(fs.get(i).text)};"
            ++ " {bind_fields(scrut, fs, i + 1)}"
    }
}

bind_slots(scrut: str, bs: Expr[], sum: str, i: int) -> str {
    if i >= bs.length() {
        ""
    } else if bs.get(i).ty == sum && type_c(sum) == sum {
        "{sum} {c_id(bs.get(i).text)} = *({sum}*){scrut}._{i};"
            ++ " {bind_slots(scrut, bs, sum, i + 1)}"
    } else {
        "__typeof__({scrut}._{i}) {c_id(bs.get(i).text)} = {scrut}._{i};"
            ++ " {bind_slots(scrut, bs, sum, i + 1)}"
    }
}

emit_block(e: Expr) -> str =>
    "({{ {block_stmts(e.stmts, 0)}{emit_expr(e.children.get(0))}; }})"

block_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        "{emit_stmt(body.get(i), false, "")} {block_stmts(body, i + 1)}"
    }
}

emit_with(e: Expr) -> str {
    base = emit_expr(e.children.get(0))

    "({{ __typeof__({base}) _w = {base}; {emit_updates(e.children, 1)}_w; }})"
}

emit_updates(fs: Expr[], i: int) -> str {
    if i >= fs.length() {
        ""
    } else {
        f = fs.get(i)
        set = "_w.{c_id(f.children.get(0).text)} ="
            ++ " {emit_expr(f.children.get(1))}; "

        set ++ emit_updates(fs, i + 1)
    }
}

emit_lit_fields(fs: Expr[], i: int) -> str =>
    fs.map(emit_lit_field).join(", ")

emit_lit_field(f: Expr) -> str =>
    ".{c_id(f.children.get(0).text)} = {emit_expr(f.children.get(1))}"

emit_args(xs: Expr[], i: int) -> str =>
    xs.slice(i, xs.length()).map(emit_expr).join(", ")

emit_unit(e: Expr) -> str =>
    "int main(void) {{ return {emit_expr(e)}; }}"

is_fn_type(ty: str) -> bool =>
    ty.index_of(") -> ") >= 0

fn_ret_of(ty: str) -> str =>
    ty.slice(ty.index_of(") -> ") + 5, ty.length())

fn_params_of(ty: str) -> str =>
    ty.slice(1, ty.index_of(") -> "))

c_decl(ty: str, name: str) -> str {
    if !is_fn_type(ty) {
        "{type_c(ty)} {name}"
    } else {
        rt = type_c(fn_ret_of(ty))
        ps = c_fn_params(fn_params_of(ty))

        "{rt} (*{name})({ps})"
    }
}

c_fn_params(ps: str) -> str {
    at = ps.index_of(", ")

    if ps == "" {
        "void"
    } else if at < 0 {
        type_c(ps)
    } else {
        rest = c_fn_params(ps.slice(at + 2, ps.length()))

        "{type_c(ps.slice(0, at))}, {rest}"
    }
}

is_map_type(ty: str) -> bool =>
    ty.length() > 4 && ty.slice(0, 4) == "Map "

type_c(ty: str) -> str {
    if is_fn_type(ty) {
        c_decl(ty, "")
    } else if is_list_type(ty) {
        "MacaList"
    } else if is_map_type(ty) {
        "MacaMap"
    } else if ty == "float" {
        "double"
    } else if ty == "Future" {
        "MacaFuture*"
    } else if ty == "str" || ty == "Element" {
        "const char*"
    } else if c_sized_float(ty) {
        ty == "f32" ? "float" : "double"
    } else if ty == "" || ty == "int" || ty == "bool" || c_sized_number(ty) {
        "long"
    } else {
        ty
    }
}

emit_fn(s: Stmt) -> str {
    params = c_params(s.params, 0)
    made = "{c_ret(s)} {c_name(s)}({params}) "
        ++ "{{ {emit_stmts(s.body, 0, s.ret)} }}"

    made ++ c_main_shim(s)
}

c_shimmed(s: Stmt) -> bool =>
    s.name == "main" && s.params.length() > 0

c_name(s: Stmt) -> str {
    if c_shimmed(s) {
        "maca_main"
    } else {
        c_id(s.name)
    }
}

/// C fixes the return type of `main`, whatever width the language gives an int.
/// C wants `main` to answer an int, but a main that renders is a main that answers text.
c_ret(s: Stmt) -> str {
    if s.name == "main" && !c_shimmed(s) && type_c(s.ret) == "long" {
        "int"
    } else {
        type_c(s.ret)
    }
}

c_main_shim(s: Stmt) -> str {
    if c_shimmed(s) {
        "\nint main(int argc, char** argv)"
            ++ " {{ return maca_main(maca_args(argc, argv)); }}"
    } else {
        ""
    }
}

c_params(ps: Expr[], i: int) -> str {
    if i >= ps.length() {
        ""
    } else if i == ps.length() - 1 {
        emit_param(ps.get(i))
    } else {
        "{emit_param(ps.get(i))}, {c_params(ps, i + 1)}"
    }
}

emit_param(p: Expr) -> str =>
    c_decl(p.ty, c_id(p.text))

emit_stmts(body: Stmt[], i: int, ret: str) -> str {
    if i >= body.length() {
        ""
    } else {
        here = emit_stmt(body.get(i), i == body.length() - 1, ret)
        "{here} {emit_stmts(body, i + 1, ret)}"
    }
}

bind_c_decl(s: Stmt) -> str {
    held = s.ret != "" ? s.ret : s.value.ty

    if is_fn_type(held) {
        c_decl(held, c_id(s.name))
    } else {
        "{bind_c_type(s)} {c_id(s.name)}"
    }
}

bind_c_type(s: Stmt) -> str {
    if s.ret != "" {
        type_c(s.ret)
    } else {
        local_c_type(s.value)
    }
}

local_c_type(e: Expr) -> str {
    if e.ty != "" {
        type_c(e.ty)
    } else {
        guessed_c_type(e)
    }
}

guessed_c_type(e: Expr) -> str =>
    match e.kind {
        EStr    => "const char*"
        EFloat  => "double"
        ERecord => e.text
        EList   => "MacaList"
        EBinary => concat_c_type(e)
        EMethod => method_c_type(e)
        ECall   => call_c_type(e)
        _       => "long"
    }

call_c_type(e: Expr) -> str {
    if c_str_call(e.text) {
        "const char*"
    } else {
        "long"
    }
}

c_str_call(name: str) -> bool =>
    name == "read_file" || name == "capture" || name == "capture_err"
        || name == "env" || name == "cwd" || name == "real_path"
        || name == "input" || name == "chr"

method_c_type(e: Expr) -> str {
    if is_vector_type(e.children.get(0).text) {
        e.children.get(0).text
    } else if e.text == "sum" && is_vector_type(e.children.get(0).ty) {
        c_vec_scalar(e.children.get(0).ty)
    } else if c_listy_method(e.text) {
        "MacaList"
    } else if c_texty_method(e.text) {
        "const char*"
    } else {
        "long"
    }
}

c_listy_method(name: str) -> bool =>
    name == "chars" || name == "split" || name == "map" || name == "filter"
        || name == "pop" || name == "reverse" || name == "sort"
        || name == "set" || name == "insert" || name == "remove"
        || name == "parallel"

c_texty_method(name: str) -> bool =>
    name == "upper" || name == "lower" || name == "trim"
        || name == "replace" || name == "repeat" || name == "substr"
        || name == "pad_start" || name == "pad_end" || name == "fixed"
        || name == "pad_center"

concat_c_type(e: Expr) -> str {
    if e.text == ".." {
        "MacaList"
    } else if e.text == "++" {
        "const char*"
    } else {
        "long"
    }
}

emit_stmt(s: Stmt, is_last: bool, ret: str) -> str {
    if s.kind == SSet {
        "{c_id(s.name)} = {emit_expr(s.value)};"
    } else if s.kind == SBind {
        "{bind_c_decl(s)} = {emit_expr(s.value)};"
    } else if is_loop(s.value) {
        emit_loop(s.value)
    } else if s.value.kind == EIf && !is_last {
        emit_if_stmt(s.value)
    } else if s.value.kind == EMatch && !is_last {
        emit_match_stmt(s.value)
    } else if s.value.kind == EIf && is_missing_else(s.value.children.get(2)) {
        "{emit_if_stmt(s.value)} return {c_zero(ret)};"
    } else if s.value.kind == EJump {
        "{emit_jump(s.value, ret)};"
    } else if is_last && is_raise(s.value) {
        "{emit_expr(s.value)}; return {c_zero(ret)};"
    } else if is_last {
        "return {emit_expr(s.value)};"
    } else {
        "{emit_expr(s.value)};"
    }
}

emit_if_stmt(e: Expr) -> str {
    cond = emit_expr(e.children.get(0))
    then = c_branch(e.children.get(1))
    els = e.children.get(2)

    if is_missing_else(els) {
        "if ({cond}) {then}"
    } else {
        "if ({cond}) {then} else {c_branch(els)}"
    }
}

is_missing_else(e: Expr) -> bool =>
    e.kind == EIdent && e.text == "?"

c_branch(e: Expr) -> str {
    if e.kind == EIf {
        emit_if_stmt(e)
    } else if e.kind == EBlock {
        "{{ {block_stmts(e.stmts, 0)}{emit_expr(e.children.get(0))}; }}"
    } else {
        "{{ {emit_expr(e)}; }}"
    }
}

is_raise(e: Expr) -> bool =>
    e.kind == EUnary && e.text == "fail"

c_zero(ty: str) -> str {
    if is_fn_type(ty) {
        "0"
    } else if ty == "" || ty == "int" || ty == "bool" || ty == "float" {
        "0"
    } else if ty == "str" {
        "(const char*)0"
    } else {
        "({type_c(ty)}){{0}}"
    }
}

c_preamble() -> str =>
    "#include <string.h>\n#include <stdlib.h>\n#include <stdio.h>\n#include <stdarg.h>\n#include <ctype.h>\n#include <unistd.h>\n#include <sys/stat.h>\n#include <dirent.h>\n#include <time.h>\n#include <stdint.h>\n#include <strings.h>\n#include <sys/time.h>\n" ++
    "typedef float f32x4 __attribute__((vector_size(16)));\ntypedef float f32x8 __attribute__((vector_size(32)));\ntypedef double f64x2 __attribute__((vector_size(16)));\ntypedef double f64x4 __attribute__((vector_size(32)));\ntypedef int i32x4 __attribute__((vector_size(16)));\ntypedef int i32x8 __attribute__((vector_size(32)));\n" ++
    "static char* maca_cat(const char* a, const char* b) {{ char* r = malloc(strlen(a) + strlen(b) + 1); strcpy(r, a); strcat(r, b); return r; }}\n" ++
    "static char* maca_int_to_str(long n) {{ char* r = malloc(24); snprintf(r, 24, \"%ld\", n); return r; }}\n" ++
    "static char* maca_float_to_str(double x) {{ char* r = malloc(32); if (x == (double)(long long)x && x < 1e15 && x > -1e15) snprintf(r, 32, \"%.1f\", x); else snprintf(r, 32, \"%g\", x); return r; }}\n" ++
    "static char* maca_fixed(double x, int n) {{ if (n < 0) n = 0; if (n > 17) n = 17; int need = snprintf(NULL, 0, \"%.*f\", n, x); char* r = malloc((size_t)need + 1); snprintf(r, (size_t)need + 1, \"%.*f\", n, x); return r; }}\n" ++
    "static const char* maca_bool_to_str(int b) {{ return b ? \"true\" : \"false\"; }}\n" ++
    "static char* maca_upper(const char* s) {{ size_t n = strlen(s); char* r = malloc(n + 1); for (size_t i = 0; i < n; i++) r[i] = toupper((unsigned char)s[i]); r[n] = 0; return r; }}\n" ++
    "typedef struct {{ long* data; int len; }} MacaList;\n" ++
    "typedef struct {{ MacaList keys; MacaList vals; }} MacaMap;\n" ++
    "static MacaMap maca_map_new(void) {{ MacaMap m; m.keys.data = NULL; m.keys.len = 0; m.vals.data = NULL; m.vals.len = 0; return m; }}\n" ++
    "static int maca_map_at(MacaMap m, const char* k) {{ for (int i = 0; i < m.keys.len; i++) if (strcmp((const char*)m.keys.data[i], k) == 0) return i; return -1; }}\n" ++
    "static int maca_map_has(MacaMap m, const char* k) {{ return maca_map_at(m, k) >= 0; }}\n" ++
    "static MacaList maca_list_sorted(MacaList a, int kind);\nstatic MacaList maca_map_keys(MacaMap m) {{ return maca_list_sorted(m.keys, 1); }}\n" ++
    "static MacaList maca_map_vals(MacaMap m) {{ return m.vals; }}\n" ++
    "static long maca_map_or(MacaMap m, const char* k, long d) {{ int i = maca_map_at(m, k); return i < 0 ? d : m.vals.data[i]; }}\n" ++
    "static long maca_map_get(MacaMap m, const char* k) {{ return maca_map_or(m, k, 0); }}\n" ++
    "static MacaMap maca_map_remove(MacaMap m, const char* k) {{ int at = maca_map_at(m, k); if (at < 0) return m; MacaMap r; r.keys.len = m.keys.len - 1; r.vals.len = r.keys.len; r.keys.data = malloc((r.keys.len ? r.keys.len : 1) * sizeof(long)); r.vals.data = malloc((r.vals.len ? r.vals.len : 1) * sizeof(long)); int w = 0; for (int i = 0; i < m.keys.len; i++) {{ if (i == at) continue; r.keys.data[w] = m.keys.data[i]; r.vals.data[w] = m.vals.data[i]; w++; }} return r; }}\n" ++
    "static MacaMap maca_map_set(MacaMap m, const char* k, long v) {{ int i = maca_map_at(m, k); MacaMap r; if (i >= 0) {{ r = m; r.vals.data = malloc((m.vals.len ? m.vals.len : 1) * sizeof(long)); memcpy(r.vals.data, m.vals.data, m.vals.len * sizeof(long)); r.vals.data[i] = v; return r; }} r.keys.len = m.keys.len + 1; r.vals.len = m.vals.len + 1; r.keys.data = malloc(r.keys.len * sizeof(long)); r.vals.data = malloc(r.vals.len * sizeof(long)); memcpy(r.keys.data, m.keys.data, m.keys.len * sizeof(long)); memcpy(r.vals.data, m.vals.data, m.vals.len * sizeof(long)); r.keys.data[m.keys.len] = (long)k; r.vals.data[m.vals.len] = v; return r; }}\n" ++
    "static MacaList maca_listv(int n, ...) {{ MacaList l; l.data = malloc(n * sizeof(long)); l.len = n; va_list ap; va_start(ap, n); for (int i = 0; i < n; i++) l.data[i] = va_arg(ap, long); va_end(ap); return l; }}\n" ++
    "static MacaList maca_list_cat(MacaList a, MacaList b) {{ MacaList l; l.len = a.len + b.len; l.data = malloc((l.len ? l.len : 1) * sizeof(long)); memcpy(l.data, a.data, a.len * sizeof(long)); memcpy(l.data + a.len, b.data, b.len * sizeof(long)); return l; }}\n" ++
    "static MacaList maca_list_slice(MacaList a, int lo, int hi) {{ if (lo < 0) lo = 0; if (hi > a.len) hi = a.len; if (hi < lo) hi = lo; MacaList l; l.len = hi - lo; l.data = malloc((l.len ? l.len : 1) * sizeof(long)); memcpy(l.data, a.data + lo, l.len * sizeof(long)); return l; }}\n" ++
    "static int maca_list_index_of(MacaList a, long v) {{ for (int i = 0; i < a.len; i++) if (a.data[i] == v) return i; return -1; }}\n" ++
    "static int maca_list_index_of_str(MacaList a, const char* v) {{ for (int i = 0; i < a.len; i++) if (strcmp((const char*)a.data[i], v) == 0) return i; return -1; }}\n" ++
    "static int maca_str_index_of(const char* a, const char* b) {{ const char* p = strstr(a, b); return p ? (int)(p - a) : -1; }}\n" ++
    "static char* maca_str_slice(const char* s, int from, int to) {{ int n = (int)strlen(s); if (from < 0) from = 0; if (to > n) to = n; if (to < from) to = from; int m = to - from; char* r = malloc(m + 1); memcpy(r, s + from, m); r[m] = 0; return r; }}\n" ++
    "static int maca_ends_with(const char* s, const char* suf) {{ size_t n = strlen(s), m = strlen(suf); return m <= n && memcmp(s + n - m, suf, m) == 0; }}\n" ++
    "static char* maca_list_join(MacaList a, const char* sep) {{ size_t n = 1; for (int i = 0; i < a.len; i++) n += strlen((const char*)a.data[i]) + strlen(sep); char* r = malloc(n); r[0] = 0; for (int i = 0; i < a.len; i++) {{ if (i) strcat(r, sep); strcat(r, (const char*)a.data[i]); }} return r; }}\n" ++
    "static long maca_box(int n, const void* p) {{ void* r = malloc(n); memcpy(r, p, n); return (long)r; }}\n" ++
    "static MacaList maca_chars(const char* s) {{ int n = (int)strlen(s); MacaList l; l.len = n; l.data = malloc((n ? n : 1) * sizeof(long)); for (int i = 0; i < n; i++) {{ char* c = malloc(2); c[0] = s[i]; c[1] = 0; l.data[i] = (long)c; }} return l; }}\n" ++
    "static MacaList maca_args(int argc, char** argv) {{ MacaList l; l.len = argc - 1; l.data = malloc((l.len ? l.len : 1) * sizeof(long)); for (int i = 0; i < l.len; i++) l.data[i] = (long)argv[i + 1]; return l; }}\n" ++
    "static char* maca_read_file(const char* path) {{ struct stat st; if (stat(path, &st) != 0 || !S_ISREG(st.st_mode)) {{ char* e = malloc(1); e[0] = 0; return e; }} FILE* f = fopen(path, \"rb\"); if (!f) {{ char* e = malloc(1); e[0] = 0; return e; }} fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET); char* r = malloc(n + 1); size_t got = fread(r, 1, n, f); r[got] = 0; fclose(f); return r; }}\n" ++
    "static int maca_write_file(const char* path, const char* text) {{ FILE* f = fopen(path, \"wb\"); if (!f) return 0; fputs(text, f); fclose(f); return 1; }}\n" ++
    "static char* maca_str_at(const char* s, int i) {{ char* r = malloc(2); r[0] = (i >= 0 && i < (int)strlen(s)) ? s[i] : 0; r[1] = 0; return r; }}\n" ++
    "static MacaList maca_range(int lo, int hi) {{ MacaList l; l.len = hi > lo ? hi - lo : 0; l.data = malloc((l.len ? l.len : 1) * sizeof(long)); for (int i = 0; i < l.len; i++) l.data[i] = lo + i; return l; }}\n" ++
    "static MacaList maca_list_reverse(MacaList a) {{ MacaList l = maca_list_slice(a, 0, a.len); for (int i = 0; i < l.len / 2; i++) {{ long t = l.data[i]; l.data[i] = l.data[l.len - 1 - i]; l.data[l.len - 1 - i] = t; }} return l; }}\n" ++
    "static int maca_cmp_cell(const void* a, const void* b) {{ long x = *(const long*)a, y = *(const long*)b; return (x > y) - (x < y); }}\n" ++
    "static int maca_cmp_cell_str(const void* a, const void* b) {{ return strcmp((const char*)*(const long*)a, (const char*)*(const long*)b); }}\n" ++
    "static int maca_cmp_cell_float(const void* a, const void* b) {{ double x = *(double*)*(const long*)a, y = *(double*)*(const long*)b; return (x > y) - (x < y); }}\n" ++
    "static MacaList maca_list_sorted(MacaList a, int kind) {{ MacaList l = maca_list_slice(a, 0, a.len); if (l.len > 1) qsort(l.data, (size_t)l.len, sizeof(long), kind == 1 ? maca_cmp_cell_str : kind == 2 ? maca_cmp_cell_float : maca_cmp_cell); return l; }}\n" ++
    "static MacaList maca_list_set(MacaList a, int at, long v) {{ MacaList l = maca_list_slice(a, 0, a.len); if (at >= 0 && at < l.len) l.data[at] = v; return l; }}\n" ++
    "static MacaList maca_list_insert(MacaList a, int at, long v) {{ if (at < 0) at = 0; if (at > a.len) at = a.len; MacaList l; l.len = a.len + 1; l.data = malloc((size_t)l.len * sizeof(long)); memcpy(l.data, a.data, (size_t)at * sizeof(long)); l.data[at] = v; memcpy(l.data + at + 1, a.data + at, (size_t)(a.len - at) * sizeof(long)); return l; }}\n" ++
    "static MacaList maca_list_remove(MacaList a, int at) {{ if (at < 0 || at >= a.len) return maca_list_slice(a, 0, a.len); MacaList l; l.len = a.len - 1; l.data = malloc((size_t)(l.len ? l.len : 1) * sizeof(long)); memcpy(l.data, a.data, (size_t)at * sizeof(long)); memcpy(l.data + at, a.data + at + 1, (size_t)(l.len - at) * sizeof(long)); return l; }}\n" ++
    "static char* maca_trim(const char* s) {{ const char* a = s; while (*a == ' ' || *a == '\\t' || *a == '\\n' || *a == '\\r') a++; const char* b = s + strlen(s); while (b > a && (b[-1] == ' ' || b[-1] == '\\t' || b[-1] == '\\n' || b[-1] == '\\r')) b--; size_t n = (size_t)(b - a); char* r = malloc(n + 1); memcpy(r, a, n); r[n] = 0; return r; }}\n" ++
    "static char* maca_lower(const char* s) {{ size_t n = strlen(s); char* r = malloc(n + 1); for (size_t i = 0; i < n; i++) r[i] = tolower((unsigned char)s[i]); r[n] = 0; return r; }}\n" ++
    "static int maca_starts_with(const char* s, const char* p) {{ size_t n = strlen(p); return strlen(s) >= n && memcmp(s, p, n) == 0; }}\n" ++
    "static char* maca_substr(const char* s, int at, int n) {{ return maca_str_slice(s, at, at + (n < 0 ? 0 : n)); }}\n" ++
    "static char* maca_repeat(const char* s, int n) {{ if (n < 0) n = 0; size_t len = strlen(s), total = len * (size_t)n; char* r = malloc(total + 1); for (int i = 0; i < n; i++) memcpy(r + (size_t)i * len, s, len); r[total] = 0; return r; }}\n" ++
    "static char* maca_replace(const char* s, const char* from, const char* to) {{ if (!*from) return maca_cat(s, \"\"); size_t lf = strlen(from), lt = strlen(to), hits = 0; for (const char* p = strstr(s, from); p; p = strstr(p + lf, from)) hits++; char* r = malloc(strlen(s) + hits * (lt > lf ? lt - lf : 0) + 1); char* w = r; const char* p = s; for (;;) {{ const char* hit = strstr(p, from); if (!hit) {{ strcpy(w, p); break; }} memcpy(w, p, (size_t)(hit - p)); w += hit - p; memcpy(w, to, lt); w += lt; p = hit + lf; }} return r; }}\n" ++
    "static char* maca_pad(const char* s, int w, const char* p, int at_start) {{ if (!*p) p = \" \"; size_t len = strlen(s); if (w <= 0 || (size_t)w <= len) return maca_cat(s, \"\"); size_t fill = (size_t)w - len, pl = strlen(p); char* r = malloc((size_t)w + 1); char* into = at_start ? r : r + len; for (size_t i = 0; i < fill; i++) into[i] = p[i % pl]; memcpy(at_start ? r + fill : r, s, len); r[(size_t)w] = 0; return r; }}\n" ++
    "static char* maca_pad_start(const char* s, int w, const char* p) {{ return maca_pad(s, w, p, 1); }}\nstatic char* maca_pad_end(const char* s, int w, const char* p) {{ return maca_pad(s, w, p, 0); }}\nstatic char* maca_pad_center(const char* s, int w, const char* p) {{ if (!*p) p = \" \"; size_t len = strlen(s); if (w <= 0 || (size_t)w <= len) return maca_cat(s, \"\"); size_t fill = (size_t)w - len, left = fill / 2, pl = strlen(p); char* r = malloc((size_t)w + 1); for (size_t i = 0; i < left; i++) r[i] = p[i % pl]; memcpy(r + left, s, len); for (size_t i = left + len; i < (size_t)w; i++) r[i] = p[(i - left - len) % pl]; r[(size_t)w] = 0; return r; }}\n" ++
    "static MacaList maca_split(const char* s, const char* sep) {{ MacaList l; int cap = 8; l.len = 0; l.data = malloc(cap * sizeof(long)); if (!*sep) {{ l.data[l.len++] = (long)maca_cat(s, \"\"); return l; }} size_t ls = strlen(sep); const char* p = s; for (;;) {{ if (l.len == cap) {{ cap *= 2; long* d = malloc(cap * sizeof(long)); memcpy(d, l.data, (size_t)l.len * sizeof(long)); l.data = d; }} const char* hit = strstr(p, sep); if (!hit) {{ l.data[l.len++] = (long)maca_str_slice(p, 0, (int)strlen(p)); break; }} l.data[l.len++] = (long)maca_str_slice(p, 0, (int)(hit - p)); p = hit + ls; }} return l; }}\n" ++
    "static int maca_failed_count = 0;\nstatic int maca_failures(void) {{ return maca_failed_count; }}\n" ++
    "static int maca_assert(int cond, const char* msg) {{ if (cond) return 1; maca_failed_count++; fprintf(stderr, \"assertion failed: %s\\n\", msg && *msg ? msg : \"(no message)\"); return 0; }}\n" ++
    "static int maca_assert_eq(const char* got, const char* want, const char* msg) {{ if (!got) got = \"\"; if (!want) want = \"\"; if (strcmp(got, want) == 0) return 1; maca_failed_count++; fprintf(stderr, \"assertion failed: %s\\n  got:  %s\\n  want: %s\\n\", msg && *msg ? msg : \"(no message)\", got, want); return 0; }}\n" ++
    "static char* maca_chr(int b) {{ char* r = malloc(2); r[0] = (b > 0 && b < 256) ? (char)b : 0; r[1] = 0; return r; }}\nstatic int maca_ord(const char* s) {{ return (s && s[0]) ? (int)(unsigned char)s[0] : -1; }}\n" ++
    "static char* maca_env(const char* name) {{ const char* v = getenv(name); return maca_cat(v ? v : \"\", \"\"); }}\nstatic char* maca_cwd(void) {{ char* r = malloc(4096); if (!getcwd(r, 4096)) r[0] = 0; return r; }}\n" ++
    "static int maca_chdir(const char* p) {{ return chdir(p) == 0; }}\nstatic int maca_is_tty(void) {{ return isatty(1); }}\n" ++
    "static int maca_file_exists(const char* p) {{ struct stat st; return stat(p, &st) == 0; }}\nstatic int maca_is_dir(const char* p) {{ struct stat st; return stat(p, &st) == 0 && S_ISDIR(st.st_mode); }}\n" ++
    "static long maca_file_size(const char* p) {{ struct stat st; return stat(p, &st) == 0 ? (long)st.st_size : -1; }}\nstatic long maca_modified_ms(const char* p) {{ struct stat st; return stat(p, &st) == 0 ? (long)(st.st_mtime * 1000) : -1; }}\n" ++
    "static int maca_make_dir(const char* p) {{ char* d = maca_cat(p, \"\"); for (char* q = d + 1; *q; q++) if (*q == '/') {{ *q = 0; mkdir(d, 0777); *q = '/'; }} mkdir(d, 0777); return maca_is_dir(d); }}\n" ++
    "static int maca_remove_file(const char* p) {{ return unlink(p) == 0; }}\nstatic int maca_remove_dir(const char* p) {{ DIR* d = opendir(p); if (!d) return 0; struct dirent* it; while ((it = readdir(d))) {{ if (strcmp(it->d_name, \".\") == 0 || strcmp(it->d_name, \"..\") == 0) continue; char* c = maca_cat(p, maca_cat(\"/\", it->d_name)); if (maca_is_dir(c)) maca_remove_dir(c); else maca_remove_file(c); }} closedir(d); return rmdir(p) == 0; }}\n" ++
    "static int maca_copy_bytes(const char* src, const char* dst) {{ FILE* a = fopen(src, \"rb\"); if (!a) return 0; FILE* b = fopen(dst, \"wb\"); if (!b) {{ fclose(a); return 0; }} char buf[8192]; size_t n; while ((n = fread(buf, 1, sizeof buf, a)) > 0) fwrite(buf, 1, n, b); fclose(a); fclose(b); return 1; }}\n" ++
    "static MacaList maca_list_dir(const char* p) {{ MacaList l; l.len = 0; int cap = 16; l.data = malloc((size_t)cap * sizeof(long)); DIR* d = opendir(p); if (!d) return l; struct dirent* it; while ((it = readdir(d))) {{ if (strcmp(it->d_name, \".\") == 0 || strcmp(it->d_name, \"..\") == 0) continue; if (l.len == cap) {{ cap *= 2; long* g = malloc((size_t)cap * sizeof(long)); memcpy(g, l.data, (size_t)l.len * sizeof(long)); l.data = g; }} l.data[l.len++] = (long)maca_cat(it->d_name, \"\"); }} closedir(d); if (l.len > 1) qsort(l.data, (size_t)l.len, sizeof(long), maca_cmp_cell_str); return l; }}\n" ++
    "static char* maca_real_path(const char* p) {{ char* r = malloc(4096); if (!realpath(p, r)) return maca_cat(p, \"\"); return r; }}\n" ++
    "static char* maca_path_join(const char* a, const char* b) {{ if (!*a) return maca_cat(b, \"\"); if (!*b) return maca_cat(a, \"\"); return a[strlen(a) - 1] == '/' ? maca_cat(a, b) : maca_cat(a, maca_cat(\"/\", b)); }}\n" ++
    "static long maca_now_ms(void) {{ struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); return (long)(ts.tv_sec * 1000 + ts.tv_nsec / 1000000); }}\n" ++
    "static char* maca_now_iso(void) {{ time_t t = time(NULL); struct tm g; gmtime_r(&t, &g); char* r = malloc(32); strftime(r, 32, \"%Y-%m-%dT%H:%M:%SZ\", &g); return r; }}\n" ++
    "static char* maca_format_time(long ms, const char* fmt) {{ time_t t = (time_t)(ms / 1000); struct tm g; gmtime_r(&t, &g); char* r = malloc(128); if (!strftime(r, 128, fmt, &g)) r[0] = 0; return r; }}\n" ++
    "static void maca_sleep_ms(int ms) {{ if (ms > 0) usleep((unsigned)ms * 1000); }}\n" ++
    "static char* maca_input(const char* prompt) {{ if (prompt && *prompt) {{ printf(\"%s\", prompt); fflush(stdout); }} size_t cap = 128, n = 0; char* b = malloc(cap); int c; while ((c = fgetc(stdin)) != EOF && c != '\\n') {{ if (n + 1 >= cap) {{ cap *= 2; char* g = malloc(cap); memcpy(g, b, n); b = g; }} b[n++] = (char)c; }} b[n] = 0; return b; }}\n" ++
    "static char* maca_attr(const char* name, const char* value) {{ if (!name || !*name) return maca_cat(\"\", \"\"); size_t n = strlen(name), v = strlen(value); char* r = malloc(n + v * 6 + 5); char* w = r; *w++ = ' '; memcpy(w, name, n); w += n; *w++ = '='; *w++ = '\"'; for (size_t i = 0; i < v; i++) {{ char c = value[i]; if (c == '&') {{ memcpy(w, \"&amp;\", 5); w += 5; }} else if (c == '<') {{ memcpy(w, \"&lt;\", 4); w += 4; }} else if (c == '>') {{ memcpy(w, \"&gt;\", 4); w += 4; }} else if (c == '\"') {{ memcpy(w, \"&quot;\", 6); w += 6; }} else {{ *w++ = c; }} }} *w++ = '\"'; *w = 0; return r; }}\n" ++
    "static char* maca_flag(const char* name, int on) {{ if (!on || !name || !*name) return maca_cat(\"\", \"\"); return maca_cat(\" \", name); }}\n" ++
    "static int maca_void_tag(const char* t) {{ const char* v[] = {{\"area\", \"base\", \"br\", \"col\", \"embed\", \"hr\", \"img\", \"input\", \"link\", \"meta\", \"source\", \"track\", \"wbr\", 0}}; for (int i = 0; v[i]; i++) if (strcmp(t, v[i]) == 0) return 1; return 0; }}\n" ++
    "static char* maca_element(const char* tag, const char* attrs, const char* kids) {{ size_t t = strlen(tag), a = strlen(attrs), k = strlen(kids); char* r = malloc(t * 2 + a + k + 6); char* w = r; *w++ = '<'; memcpy(w, tag, t); w += t; memcpy(w, attrs, a); w += a; *w++ = '>'; if (!maca_void_tag(tag)) {{ memcpy(w, kids, k); w += k; *w++ = '<'; *w++ = '/'; memcpy(w, tag, t); w += t; *w++ = '>'; }} *w = 0; return r; }}\n"

c_errors(code: str) -> str {
    if c_uses(code, "maca_try_push") {
        "#include <setjmp.h>\n" ++
        "static jmp_buf maca_handlers[256];\nstatic int maca_handler_top = 0;\nstatic const char* maca_caught = \"\";\n" ++
        "static jmp_buf* maca_try_push(void) {{ return &maca_handlers[maca_handler_top++]; }}\n" ++
        "static void maca_try_pop(void) {{ if (maca_handler_top > 0) maca_handler_top--; }}\n" ++
        "static char* maca_last_fail(void) {{ return maca_cat(maca_caught, \"\"); }}\n" ++
        "static int maca_fail(const char* s) {{ if (maca_handler_top > 0) {{ maca_caught = s ? s : \"\"; longjmp(maca_handlers[--maca_handler_top], 1); }} fprintf(stderr, \"error: %s\\n\", s ? s : \"\"); exit(1); return 0; }}\n"
    } else {
        "static int maca_fail(const char* s) {{ fprintf(stderr, \"error: %s\\n\", s ? s : \"\"); exit(1); return 0; }}\n"
    }
}

c_uses(code: str, name: str) -> bool =>
    code.index_of(name) >= 0

/// The emitted C with its string literals dropped, so a runtime helper a program only names in its own text is not read as a call to it.
c_bare(code: str) -> str =>
    c_unquoted(code.split("\""), 0, true, []).join(" ")

c_unquoted(parts: str[], i: int, live: bool, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else {
        part = parts.get(i)
        next = c_escaped(part) ? live : !live

        c_unquoted(parts, i + 1, next, live ? acc.push(part) : acc)
    }
}

c_escaped(part: str) -> bool =>
    c_slashes(part, part.length() - 1, 0) % 2 == 1

c_slashes(s: str, i: int, n: int) -> int =>
    i >= 0 && s.at(i) == "\\" ? c_slashes(s, i - 1, n + 1) : n

c_net_headers() -> str =>
    "#include <pthread.h>\n#include <sys/socket.h>\n" ++
    "#include <netinet/in.h>\n#include <netinet/tcp.h>\n" ++
    "#include <arpa/inet.h>\n"

c_process(code: str) -> str {
    if c_uses(code, "maca_exec") || c_uses(code, "maca_capture") {
        "#include <sys/wait.h>\n" ++
        "static int maca_exec(const char* cmd, MacaList args) {{ char** argv = malloc((args.len + 2) * sizeof(char*)); argv[0] = (char*)cmd; for (int i = 0; i < args.len; i++) argv[i + 1] = (char*)args.data[i]; argv[args.len + 1] = NULL; pid_t pid = fork(); if (pid < 0) return -1; if (pid == 0) {{ execvp(cmd, argv); _exit(127); }} int st = 0; if (waitpid(pid, &st, 0) < 0) return -1; if (WIFEXITED(st)) return WEXITSTATUS(st); if (WIFSIGNALED(st)) return 128 + WTERMSIG(st); return -1; }}\n" ++
        "static char* maca_capture_fd(const char* cmd, MacaList args, int child_fd) {{ int fd[2]; if (pipe(fd) < 0) return maca_cat(\"\", \"\"); char** argv = malloc((size_t)(args.len + 2) * sizeof(char*)); argv[0] = (char*)cmd; for (int i = 0; i < args.len; i++) argv[i + 1] = (char*)args.data[i]; argv[args.len + 1] = NULL; pid_t pid = fork(); if (pid < 0) {{ close(fd[0]); close(fd[1]); return maca_cat(\"\", \"\"); }} if (pid == 0) {{ close(fd[0]); dup2(fd[1], child_fd); close(fd[1]); execvp(cmd, argv); _exit(127); }} close(fd[1]); size_t cap = 4096, n = 0; char* b = malloc(cap); ssize_t got; while ((got = read(fd[0], b + n, cap - n - 1)) > 0) {{ n += (size_t)got; if (n + 1 >= cap) {{ cap *= 2; char* g = malloc(cap); memcpy(g, b, n); b = g; }} }} close(fd[0]); int st = 0; waitpid(pid, &st, 0); b[n] = 0; return b; }}\n" ++
        "static char* maca_capture(const char* cmd, MacaList args) {{ return maca_capture_fd(cmd, args, 1); }}\n" ++
        "static char* maca_capture_err(const char* cmd, MacaList args) {{ return maca_capture_fd(cmd, args, 2); }}\n"
    } else {
        ""
    }
}

c_threads(code: str) -> str {
    if c_uses(code, "maca_spawn") || c_uses(code, "MacaFuture") {
        "#include <pthread.h>\n" ++
        "typedef long (*MacaTask)(long);\ntypedef long (*MacaTask2)(long, long);\n" ++
        "typedef struct {{ pthread_t th; MacaTask fn; MacaTask2 fn2; long a; long b; long out; int done; }} MacaFuture;\n" ++
        "static void* maca_task_run(void* p) {{ MacaFuture* f = (MacaFuture*)p; f->out = f->fn2 ? f->fn2(f->a, f->b) : f->fn(f->a); return NULL; }}\n" ++
        "static MacaFuture* maca_spawn(MacaTask fn, long a) {{ MacaFuture* f = malloc(sizeof(MacaFuture)); f->fn = fn; f->fn2 = 0; f->a = a; f->b = 0; f->out = 0; f->done = 0; pthread_create(&f->th, NULL, maca_task_run, f); return f; }}\n" ++
        "static MacaFuture* maca_spawn2(MacaTask2 fn, long a, long b) {{ MacaFuture* f = malloc(sizeof(MacaFuture)); f->fn = 0; f->fn2 = fn; f->a = a; f->b = b; f->out = 0; f->done = 0; pthread_create(&f->th, NULL, maca_task_run, f); return f; }}\n" ++
        "static long maca_await(MacaFuture* f) {{ if (!f) return 0; if (!f->done) {{ pthread_join(f->th, NULL); f->done = 1; }} return f->out; }}\n"
    } else {
        ""
    }
}

c_sockets(code: str) -> str {
    if c_uses(code, "http_listen") || c_uses(code, "http_fetch") {
        c_net_headers() ++ c_http()
    } else {
        ""
    }
}

c_http() -> str =>
    "#define MACA_HTTP_MAX (1 << 20)\n" ++
    "#define MACA_HTTP_IDLE 30\n" ++
    "typedef const char* (*MacaHttpFn)(const char*);\n" ++
    "typedef struct {{ int fd; MacaHttpFn fn; }} MacaHttpConn;\n" ++
    "typedef struct {{ char* buf; size_t cap, len; }} MacaHttpBuf;\n" ++
    "static int maca_http_write(int fd, const char* b, size_t n) {{ size_t off = 0; while (off < n) {{ ssize_t w = send(fd, b + off, n - off, MSG_NOSIGNAL); if (w <= 0) return -1; off += (size_t)w; }} return 0; }}\n" ++
    "static long maca_http_head_end(const char* b, size_t n) {{ for (size_t i = 0; i + 3 < n; i++) if (b[i] == '\\r' && b[i+1] == '\\n' && b[i+2] == '\\r' && b[i+3] == '\\n') return (long)(i + 4); for (size_t i = 0; i + 1 < n; i++) if (b[i] == '\\n' && b[i+1] == '\\n') return (long)(i + 2); return -1; }}\n" ++
    "static long maca_http_length(const char* h, size_t n) {{ for (size_t i = 0; i + 15 < n; i++) {{ if (i && h[i-1] != '\\n') continue; if (strncasecmp(h + i, \"content-length:\", 15) != 0) continue; size_t j = i + 15; while (j < n && (h[j] == ' ' || h[j] == '\\t')) j++; if (j >= n || h[j] < '0' || h[j] > '9') return -1; long v = 0; while (j < n && h[j] >= '0' && h[j] <= '9') {{ if (v > (long)MACA_HTTP_MAX) return -1; v = v * 10 + (h[j] - '0'); j++; }} return v; }} return 0; }}\n" ++
    "static int maca_http_chunked(const char* h, size_t n) {{ for (size_t i = 0; i + 18 < n; i++) {{ if (i && h[i-1] != '\\n') continue; if (strncasecmp(h + i, \"transfer-encoding:\", 18) == 0) return 1; }} return 0; }}\n" ++
    "static int maca_http_closing(const char* m) {{ for (const char* p = m; *p; p++) {{ if (p != m && p[-1] != '\\n') continue; if (p[0] == '\\r' || p[0] == '\\n') break; if (strncasecmp(p, \"connection:\", 11) != 0) continue; const char* v = p + 11; while (*v == ' ' || *v == '\\t') v++; return strncasecmp(v, \"close\", 5) == 0; }} return 0; }}\n" ++
    "static void maca_http_refuse(int fd, const char* line, const char* body) {{ char out[256]; int n = snprintf(out, sizeof(out), \"HTTP/1.1 %s\\r\\nContent-Type: text/plain; charset=utf-8\\r\\nContent-Length: %d\\r\\nConnection: close\\r\\n\\r\\n%s\", line, (int)strlen(body), body); if (n > 0) maca_http_write(fd, out, (size_t)n); }}\n" ++
    "static int maca_http_take(int fd, MacaHttpBuf* b, char** out) {{ for (;;) {{ long head = maca_http_head_end(b->buf, b->len); if (head >= 0) {{ if (maca_http_chunked(b->buf, (size_t)head)) return 3; long want = maca_http_length(b->buf, (size_t)head); if (want < 0) return 4; if (head + want > (long)MACA_HTTP_MAX) return 2; if ((long)b->len >= head + want) {{ size_t take = (size_t)(head + want); char* req = malloc(take + 1); if (!req) return 1; memcpy(req, b->buf, take); req[take] = 0; memmove(b->buf, b->buf + take, b->len - take); b->len -= take; *out = req; return 0; }} }} if (b->len >= MACA_HTTP_MAX) return 2; if (b->len + 1 >= b->cap) {{ size_t cap = b->cap ? b->cap * 2 : 8192; char* g = realloc(b->buf, cap); if (!g) return 1; b->buf = g; b->cap = cap; }} ssize_t r = recv(fd, b->buf + b->len, b->cap - b->len - 1, 0); if (r <= 0) return 1; b->len += (size_t)r; b->buf[b->len] = 0; }} }}\n" ++
    "static void* maca_http_client(void* arg) {{ MacaHttpConn* c = (MacaHttpConn*)arg; int fd = c->fd; MacaHttpFn fn = c->fn; free(c); struct timeval tv; tv.tv_sec = MACA_HTTP_IDLE; tv.tv_usec = 0; setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)); setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv)); MacaHttpBuf b; b.buf = NULL; b.cap = 0; b.len = 0; for (;;) {{ char* req = NULL; int st = maca_http_take(fd, &b, &req); if (st == 2) {{ maca_http_refuse(fd, \"413 Payload Too Large\", \"413 Payload Too Large\\n\"); break; }} if (st == 3) {{ maca_http_refuse(fd, \"501 Not Implemented\", \"501 Not Implemented\\n\"); break; }} if (st == 4) {{ maca_http_refuse(fd, \"400 Bad Request\", \"400 Bad Request\\n\"); break; }} if (st != 0) break; int done = maca_http_closing(req); const char* reply = fn(req); free(req); if (!reply) break; if (maca_http_write(fd, reply, strlen(reply))) break; if (done || maca_http_closing(reply)) break; }} free(b.buf); close(fd); return NULL; }}\n" ++
    "long http_listen(long port) {{ int srv = socket(AF_INET, SOCK_STREAM, 0); if (srv < 0) return -1; int one = 1; setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one)); struct sockaddr_in a; memset(&a, 0, sizeof(a)); a.sin_family = AF_INET; a.sin_addr.s_addr = INADDR_ANY; a.sin_port = htons((unsigned short)port); if (bind(srv, (struct sockaddr*)&a, sizeof(a)) < 0) {{ close(srv); return -2; }} if (listen(srv, 512) < 0) {{ close(srv); return -3; }} return srv; }}\n" ++
    "static int maca_http_serve(int srv, MacaHttpFn fn) {{ if (!fn) return -1; for (;;) {{ int fd = accept(srv, 0, 0); if (fd < 0) continue; int one = 1; setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one)); MacaHttpConn* c = malloc(sizeof(MacaHttpConn)); if (!c) {{ close(fd); continue; }} c->fd = fd; c->fn = fn; pthread_t th; if (pthread_create(&th, 0, maca_http_client, c) != 0) {{ free(c); close(fd); continue; }} pthread_detach(th); }} return 0; }}\n" ++
    "const char* http_fetch(const char* host, long port, const char* request) {{ int fd = socket(AF_INET, SOCK_STREAM, 0); if (fd < 0) return \"\"; struct sockaddr_in a; memset(&a, 0, sizeof(a)); a.sin_family = AF_INET; a.sin_port = htons((unsigned short)port); inet_pton(AF_INET, host && *host ? host : \"127.0.0.1\", &a.sin_addr); if (connect(fd, (struct sockaddr*)&a, sizeof(a)) < 0) {{ close(fd); return \"\"; }} if (maca_http_write(fd, request, strlen(request))) {{ close(fd); return \"\"; }} shutdown(fd, SHUT_WR); size_t cap = 8192, n = 0; char* buf = malloc(cap); if (!buf) {{ close(fd); return \"\"; }} for (;;) {{ if (n + 1 >= cap) {{ cap *= 2; char* g = realloc(buf, cap); if (!g) {{ free(buf); close(fd); return \"\"; }} buf = g; }} ssize_t r = recv(fd, buf + n, cap - n - 1, 0); if (r <= 0) break; n += (size_t)r; }} buf[n] = 0; close(fd); return buf; }}\n" ++
    "long http_accept_loop(long srv, long handler) {{ return maca_http_serve(srv, (MacaHttpFn)(intptr_t)handler); }}\n"

c_mqtt(protos: str) -> str {
    if protos.index_of("mqtt_") < 0 {
        ""
    } else {
        c_net_headers() ++
        "#define MACA_MQTT_MAX_SUBS 8192\n" ++
        "typedef struct {{ int fd; char pat[256]; }} MacaMqttSub;\n" ++
        "static MacaMqttSub maca_mqtt_subs[MACA_MQTT_MAX_SUBS];\n" ++
        "static int maca_mqtt_nsubs = 0;\n" ++
        "static pthread_mutex_t maca_mqtt_lock = PTHREAD_MUTEX_INITIALIZER;\n" ++
        "static int maca_mqtt_write_all(int fd, const unsigned char* b, int n) {{ int off = 0; while (off < n) {{ int w = write(fd, b + off, n - off); if (w <= 0) return -1; off += w; }} return 0; }}\n" ++
        "static int maca_mqtt_read_n(int fd, unsigned char* b, int n) {{ int off = 0; while (off < n) {{ int r = read(fd, b + off, n - off); if (r <= 0) return -1; off += r; }} return 0; }}\n" ++
        "static int maca_mqtt_read_remlen(int fd) {{ int mult = 1, value = 0; unsigned char c; do {{ if (maca_mqtt_read_n(fd, &c, 1)) return -1; value += (c & 127) * mult; mult *= 128; }} while (c & 128); return value; }}\n" ++
        "static int maca_mqtt_enc_remlen(unsigned char* b, int len) {{ int i = 0; do {{ unsigned char c = len % 128; len /= 128; if (len) c |= 128; b[i++] = c; }} while (len); return i; }}\n" ++
        "static int maca_mqtt_put_str(unsigned char* b, const char* s) {{ int n = (int)strlen(s); b[0] = (n >> 8) & 0xFF; b[1] = n & 0xFF; memcpy(b + 2, s, n); return n + 2; }}\n" ++
        "static int maca_mqtt_send(int fd, unsigned char type_flags, const unsigned char* body, int blen) {{ unsigned char hdr[5]; hdr[0] = type_flags; int hn = 1 + maca_mqtt_enc_remlen(hdr + 1, blen); if (maca_mqtt_write_all(fd, hdr, hn)) return -1; if (blen && maca_mqtt_write_all(fd, body, blen)) return -1; return 0; }}\n" ++
        "static int maca_mqtt_match(const char* f, const char* t) {{ if (*f == '#') return 1; if (*f == 0 && *t == 0) return 1; if (*f == 0 || *t == 0) return 0; const char* fe = f; while (*fe && *fe != '/') fe++; const char* te = t; while (*te && *te != '/') te++; int fl = (int)(fe - f); int ok = (fl == 1 && f[0] == '+') || ((int)(te - t) == fl && strncmp(f, t, fl) == 0); if (!ok) return 0; return maca_mqtt_match(*fe == '/' ? fe + 1 : fe, *te == '/' ? te + 1 : te); }}\n" ++
        "static void maca_mqtt_route(const char* topic, const unsigned char* payload, int plen) {{ pthread_mutex_lock(&maca_mqtt_lock); for (int i = 0; i < maca_mqtt_nsubs; i++) {{ if (maca_mqtt_match(maca_mqtt_subs[i].pat, topic)) {{ unsigned char body[1024]; int n = maca_mqtt_put_str(body, topic); if (plen > 0 && n + plen < (int)sizeof(body)) {{ memcpy(body + n, payload, plen); n += plen; }} maca_mqtt_send(maca_mqtt_subs[i].fd, 0x30, body, n); }} }} pthread_mutex_unlock(&maca_mqtt_lock); }}\n" ++
        "static void* maca_mqtt_client(void* arg) {{ int fd = (int)(long)arg; unsigned char b1; while (maca_mqtt_read_n(fd, &b1, 1) == 0) {{ int rl = maca_mqtt_read_remlen(fd); if (rl < 0 || rl > 65535) break; unsigned char* body = (unsigned char*)malloc(rl > 0 ? rl : 1); if (rl > 0 && maca_mqtt_read_n(fd, body, rl)) {{ free(body); break; }} int type = b1 >> 4; if (type == 1) {{ unsigned char ack[2] = {{ 0x00, 0x00 }}; maca_mqtt_send(fd, 0x20, ack, 2); }} else if (type == 8) {{ int p = 2; unsigned char subacks[64]; int na = 0; while (p + 2 <= rl) {{ int tl = (body[p] << 8) | body[p + 1]; p += 2; if (p + tl > rl) break; pthread_mutex_lock(&maca_mqtt_lock); if (maca_mqtt_nsubs < MACA_MQTT_MAX_SUBS && tl < 256) {{ maca_mqtt_subs[maca_mqtt_nsubs].fd = fd; memcpy(maca_mqtt_subs[maca_mqtt_nsubs].pat, body + p, tl); maca_mqtt_subs[maca_mqtt_nsubs].pat[tl] = 0; maca_mqtt_nsubs++; }} pthread_mutex_unlock(&maca_mqtt_lock); p += tl + 1; if (na < 64) subacks[na++] = 0x00; }} unsigned char sb[66]; sb[0] = body[0]; sb[1] = body[1]; memcpy(sb + 2, subacks, na); maca_mqtt_send(fd, 0x90, sb, 2 + na); }} else if (type == 3) {{ int tl = (body[0] << 8) | body[1]; char topic[256]; int cl = tl < 255 ? tl : 255; memcpy(topic, body + 2, cl); topic[cl] = 0; int po = 2 + tl; maca_mqtt_route(topic, body + po, rl - po); }} else if (type == 12) {{ maca_mqtt_send(fd, 0xD0, 0, 0); }} else if (type == 14) {{ free(body); break; }} free(body); }} pthread_mutex_lock(&maca_mqtt_lock); int j = 0; for (int i = 0; i < maca_mqtt_nsubs; i++) if (maca_mqtt_subs[i].fd != fd) maca_mqtt_subs[j++] = maca_mqtt_subs[i]; maca_mqtt_nsubs = j; pthread_mutex_unlock(&maca_mqtt_lock); close(fd); return 0; }}\n" ++
        "long mqtt_broker_run(long port) {{ int srv = socket(AF_INET, SOCK_STREAM, 0); if (srv < 0) return -1; int one = 1; setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one)); struct sockaddr_in a; memset(&a, 0, sizeof(a)); a.sin_family = AF_INET; a.sin_addr.s_addr = INADDR_ANY; a.sin_port = htons((unsigned short)port); if (bind(srv, (struct sockaddr*)&a, sizeof(a)) < 0) return -2; if (listen(srv, 128) < 0) return -3; for (;;) {{ int c = accept(srv, 0, 0); if (c < 0) continue; pthread_t th; pthread_create(&th, 0, maca_mqtt_client, (void*)(long)c); pthread_detach(th); }} return 0; }}\n" ++
        "long mqtt_connect(const char* host, long port) {{ int fd = socket(AF_INET, SOCK_STREAM, 0); if (fd < 0) return -1; struct sockaddr_in a; memset(&a, 0, sizeof(a)); a.sin_family = AF_INET; a.sin_port = htons((unsigned short)port); inet_pton(AF_INET, host ? host : \"127.0.0.1\", &a.sin_addr); if (connect(fd, (struct sockaddr*)&a, sizeof(a)) < 0) {{ close(fd); return -1; }} unsigned char cx[] = {{ 0, 4, 'M', 'Q', 'T', 'T', 4, 2, 0, 60, 0, 0 }}; maca_mqtt_send(fd, 0x10, cx, sizeof(cx)); unsigned char b1; maca_mqtt_read_n(fd, &b1, 1); int rl = maca_mqtt_read_remlen(fd); unsigned char tmp[8]; if (rl > 0 && rl <= 8) maca_mqtt_read_n(fd, tmp, rl); return fd; }}\n" ++
        "long mqtt_subscribe(long fd, const char* topic) {{ unsigned char body[512]; body[0] = 0; body[1] = 1; int n = 2 + maca_mqtt_put_str(body + 2, topic); body[n++] = 0; maca_mqtt_send((int)fd, 0x82, body, n); unsigned char b1; maca_mqtt_read_n((int)fd, &b1, 1); int rl = maca_mqtt_read_remlen((int)fd); unsigned char tmp[16]; if (rl > 0 && rl <= 16) maca_mqtt_read_n((int)fd, tmp, rl); return 0; }}\n" ++
        "long mqtt_publish(long fd, const char* topic, const char* payload) {{ unsigned char body[2048]; int n = maca_mqtt_put_str(body, topic); int pl = (int)strlen(payload ? payload : \"\"); if (n + pl < (int)sizeof(body)) {{ memcpy(body + n, payload, pl); n += pl; }} maca_mqtt_send((int)fd, 0x30, body, n); return 0; }}\n" ++
        "const char* mqtt_receive(long fd) {{ unsigned char b1; while (maca_mqtt_read_n((int)fd, &b1, 1) == 0) {{ int rl = maca_mqtt_read_remlen((int)fd); if (rl < 0 || rl > 65535) return \"\"; unsigned char* body = (unsigned char*)malloc(rl > 0 ? rl : 1); if (rl > 0 && maca_mqtt_read_n((int)fd, body, rl)) {{ free(body); return \"\"; }} if ((b1 >> 4) == 3) {{ int tl = (body[0] << 8) | body[1]; int po = 2 + tl; int pl = rl - po; char* out = (char*)malloc(pl > 0 ? pl + 1 : 1); if (pl > 0) memcpy(out, body + po, pl); out[pl > 0 ? pl : 0] = 0; free(body); return out; }} free(body); }} return \"\"; }}\n" ++
        "long mqtt_disconnect(long fd) {{ maca_mqtt_send((int)fd, 0xE0, 0, 0); close((int)fd); return 0; }}\n"
    }
}

emit_module(m: Module) -> str {
    protos = emit_protos(m.items, 0)
    code = protos ++ emit_starts(m.items) ++ emit_bodies(m.items, 0)
    bare = c_bare(code)

    c_preamble() ++ c_errors(bare) ++ c_process(bare) ++ c_threads(bare)
        ++ c_sockets(bare)
        ++ emit_types(m.items, 0) ++ emit_consts(m.items, 0) ++ code
        ++ c_mqtt(c_bare(protos)) ++ c_ffi(protos)
}

c_ffi(protos: str) -> str =>
    c_sqlite(protos) ++ c_python(protos)

c_sqlite(protos: str) -> str {
    if protos.index_of("sqlite_open(") < 0 {
        ""
    } else {
        "#include <sqlite3.h>\n" ++
        "static long maca_sq_handle(void* p) {{ return (long)(intptr_t)p; }}\n" ++
        "static sqlite3* maca_sq_db(long h) {{ return (sqlite3*)(intptr_t)h; }}\n" ++
        "static sqlite3_stmt* maca_sq_stmt(long h) {{ return (sqlite3_stmt*)(intptr_t)h; }}\n" ++
        "static const char* maca_sq_text(const unsigned char* t) {{ return t ? maca_cat((const char*)t, \"\") : \"\"; }}\n" ++
        "long sqlite_open(const char* path) {{ sqlite3* db = 0; if (sqlite3_open(path, &db) != SQLITE_OK) {{ if (db) sqlite3_close(db); return 0; }} return maca_sq_handle(db); }}\n" ++
        "long sqlite_close(long db) {{ return sqlite3_close(maca_sq_db(db)); }}\n" ++
        "long sqlite_exec(long db, const char* sql) {{ char* err = 0; int rc = sqlite3_exec(maca_sq_db(db), sql, 0, 0, &err); if (err) sqlite3_free(err); return rc; }}\n" ++
        "long sqlite_prepare(long db, const char* sql) {{ sqlite3_stmt* st = 0; if (sqlite3_prepare_v2(maca_sq_db(db), sql, -1, &st, 0) != SQLITE_OK) return 0; return maca_sq_handle(st); }}\n" ++
        "long sqlite_step(long st) {{ return sqlite3_step(maca_sq_stmt(st)) == SQLITE_ROW; }}\n" ++
        "long sqlite_column_count(long st) {{ return sqlite3_column_count(maca_sq_stmt(st)); }}\n" ++
        "const char* sqlite_column_name(long st, long col) {{ return maca_sq_text((const unsigned char*)sqlite3_column_name(maca_sq_stmt(st), (int)col)); }}\n" ++
        "const char* sqlite_column_text(long st, long col) {{ return maca_sq_text(sqlite3_column_text(maca_sq_stmt(st), (int)col)); }}\n" ++
        "long sqlite_column_int(long st, long col) {{ return sqlite3_column_int64(maca_sq_stmt(st), (int)col); }}\n" ++
        "double sqlite_column_float(long st, long col) {{ return sqlite3_column_double(maca_sq_stmt(st), (int)col); }}\n" ++
        "long sqlite_finalize(long st) {{ return sqlite3_finalize(maca_sq_stmt(st)); }}\n"
    }
}

c_python(protos: str) -> str {
    if protos.index_of("py_call(") < 0 {
        ""
    } else {
        "#define PY_SSIZE_T_CLEAN\n#include <Python.h>\n" ++
        "static const char* maca_py_str(PyObject* r) {{ if (!r) return \"<py error>\"; const char* out = \"<py error>\"; PyObject* s = PyObject_Str(r); if (s) {{ const char* c = PyUnicode_AsUTF8(s); if (c) out = maca_cat(c, \"\"); Py_DECREF(s); }} return out; }}\n" ++
        "static PyObject* maca_py_find(const char* module, const char* func) {{ PyObject* m = PyImport_ImportModule(module); if (!m) return 0; PyObject* f = PyObject_GetAttrString(m, func); Py_DECREF(m); if (f && PyCallable_Check(f)) return f; Py_XDECREF(f); return 0; }}\n" ++
        "const char* py_call(const char* module, const char* func) {{ Py_Initialize(); const char* out = \"<py error>\"; PyObject* f = maca_py_find(module, func); if (f) {{ PyObject* r = PyObject_CallObject(f, 0); out = maca_py_str(r); Py_XDECREF(r); Py_DECREF(f); }} Py_Finalize(); return out; }}\n" ++
        "const char* py_call_s(const char* module, const char* func, const char* arg) {{ Py_Initialize(); const char* out = \"<py error>\"; PyObject* f = maca_py_find(module, func); if (f) {{ PyObject* r = PyObject_CallFunction(f, \"s\", arg ? arg : \"\"); out = maca_py_str(r); Py_XDECREF(r); Py_DECREF(f); }} Py_Finalize(); return out; }}\n" ++
        "const char* py_call_i(const char* module, const char* func, long n) {{ Py_Initialize(); const char* out = \"<py error>\"; PyObject* f = maca_py_find(module, func); if (f) {{ PyObject* r = PyObject_CallFunction(f, \"L\", (long long)n); out = maca_py_str(r); Py_XDECREF(r); Py_DECREF(f); }} Py_Finalize(); return out; }}\n"
    }
}

emit_consts(items: Stmt[], i: int) -> str {
    if i >= items.length() {
        ""
    } else if items.get(i).kind == SBind {
        "{emit_const(items.get(i))}\n{emit_consts(items, i + 1)}"
    } else {
        emit_consts(items, i + 1)
    }
}

emit_const(s: Stmt) -> str {
    if c_constant(s.value) {
        "static {c_held(s)}{bind_c_decl(s)} = "
            ++ "{emit_expr(s.value)};"
    } else {
        "static {bind_c_decl(s)};"
    }
}

/// A Capitalized name is a constant; a lowercase one is module state a body assigns to.
c_held(s: Stmt) -> str {
    if c_lower_name(s.name) {
        ""
    } else {
        "const "
    }
}

c_constant(e: Expr) -> bool =>
    e.kind == EInt || e.kind == EFloat || e.kind == EStr || e.kind == EBool

emit_starts(items: Stmt[]) -> str {
    sets = emit_start_sets(items, 0)

    if sets == "" {
        ""
    } else {
        "__attribute__((constructor)) static void maca_module_init(void)"
            ++ " {{ {sets}}}\n"
    }
}

emit_start_sets(items: Stmt[], i: int) -> str {
    if i >= items.length() {
        ""
    } else if items.get(i).kind != SBind || c_constant(items.get(i).value) {
        emit_start_sets(items, i + 1)
    } else {
        s = items.get(i)

        "{c_id(s.name)} = {emit_expr(s.value)}; "
            ++ emit_start_sets(items, i + 1)
    }
}

is_type_item(s: Stmt) -> bool =>
    s.kind == SRecord || s.kind == SSum

emit_types(items: Stmt[], i: int) -> str =>
    emit_ranked(items, i, 0)

/// A field holds its record by value, so a type is emitted after every type it names.
emit_ranked(items: Stmt[], i: int, r: int) -> str {
    if r > items.length() {
        ""
    } else {
        emit_rank(items, i, r) ++ emit_ranked(items, i, r + 1)
    }
}

emit_rank(items: Stmt[], i: int, r: int) -> str {
    if i >= items.length() {
        ""
    } else if is_type_item(items.get(i))
            && type_rank(items, items.get(i), items.length(), 0) == r {
        "{emit_item(items.get(i))}\n{emit_rank(items, i + 1, r)}"
    } else {
        emit_rank(items, i + 1, r)
    }
}

type_rank(items: Stmt[], s: Stmt, fuel: int, i: int) -> int {
    if fuel <= 0 || i >= s.params.length() {
        0
    } else {
        wider(node_rank(items, s.params.get(i), fuel),
              type_rank(items, s, fuel, i + 1))
    }
}

node_rank(items: Stmt[], p: Expr, fuel: int) -> int =>
    wider(named_rank(items, p.ty, fuel, 0),
          payload_rank(items, p.children, fuel, 0))

payload_rank(items: Stmt[], cs: Expr[], fuel: int, i: int) -> int {
    if i >= cs.length() {
        0
    } else {
        wider(named_rank(items, cs.get(i).ty, fuel, 0),
              payload_rank(items, cs, fuel, i + 1))
    }
}

named_rank(items: Stmt[], ty: str, fuel: int, i: int) -> int {
    if i >= items.length() {
        0
    } else if is_type_item(items.get(i)) && items.get(i).name == ty {
        1 + type_rank(items, items.get(i), fuel - 1, 0)
    } else {
        named_rank(items, ty, fuel, i + 1)
    }
}

is_declared_only(s: Stmt) -> bool =>
    s.kind == SFn && s.body.length() == 0

emit_protos(items: Stmt[], i: int) -> str {
    if i >= items.length() {
        ""
    } else if items.get(i).kind != SFn {
        emit_protos(items, i + 1)
    } else {
        "{emit_proto(items.get(i))}\n{emit_protos(items, i + 1)}"
    }
}

emit_bodies(items: Stmt[], i: int) -> str {
    if i >= items.length() {
        ""
    } else if items.get(i).kind != SFn || is_declared_only(items.get(i)) {
        emit_bodies(items, i + 1)
    } else {
        "{emit_fn(items.get(i))}\n{emit_bodies(items, i + 1)}"
    }
}

emit_proto(s: Stmt) -> str =>
    "{c_ret(s)} {c_name(s)}({c_params(s.params, 0)});"

emit_item(s: Stmt) -> str {
    if s.kind == SRecord {
        emit_struct(s)
    } else {
        emit_sum(s)
    }
}

emit_struct(s: Stmt) -> str {
    fields = s.params.map(emit_struct_field).join(" ")

    "typedef struct {{ {fields} }} {s.name};"
}

emit_struct_field(f: Expr) -> str =>
    "{c_decl(f.ty, c_id(f.text))};"

emit_sum(s: Stmt) -> str {
    if payload_arity(s.params, 0) == 0 {
        variants = s.params.map(variant_name).join(", ")
        "typedef enum {{ {variants} }} {s.name};"
    } else {
        emit_tagged_sum(s)
    }
}

variant_name(v: Expr) -> str =>
    v.text

emit_tagged_sum(s: Stmt) -> str {
    tags = s.params.map(tag_name).join(", ")
    slots = emit_slots(s, payload_arity(s.params, 0), 0)

    "typedef enum {{ {tags} }} {s.name}_tag;\n"
        ++ "typedef struct {{ {s.name}_tag tag; {slots}}} {s.name};\n"
        ++ emit_ctors(s, 0)
}

tag_name(v: Expr) -> str =>
    "{v.text}_tag"

payload_arity(vs: Expr[], i: int) -> int {
    if i >= vs.length() {
        0
    } else {
        wider(vs.get(i).children.length(), payload_arity(vs, i + 1))
    }
}

wider(a: int, b: int) -> int {
    if a > b {
        a
    } else {
        b
    }
}

emit_slots(s: Stmt, n: int, i: int) -> str {
    if i >= n {
        ""
    } else {
        "{slot_type(s, i, 0)} _{i}; {emit_slots(s, n, i + 1)}"
    }
}

/// Every variant shares one slot, so it carries a declared type only where they all agree.
slot_type(s: Stmt, at: int, i: int) -> str {
    if i >= s.params.length() {
        "long"
    } else if s.params.get(i).children.length() <= at {
        slot_type(s, at, i + 1)
    } else if s.params.get(i).children.get(at).ty == s.name {
        "long"
    } else {
        agreed(type_c(s.params.get(i).children.get(at).ty),
               slot_type(s, at, i + 1))
    }
}

agreed(a: str, b: str) -> str =>
    (b == "long" || a == b) ? a : "long"

emit_ctors(s: Stmt, i: int) -> str {
    if i >= s.params.length() {
        ""
    } else {
        emit_ctor(s, s.params.get(i)) ++ emit_ctors(s, i + 1)
    }
}

emit_ctor(s: Stmt, v: Expr) -> str {
    if v.children.length() == 0 {
        "static const {s.name} {v.text} = {{ {v.text}_tag }};\n"
    } else {
        "static inline {s.name} {v.text}({ctor_params(s, v.children, 0)}) "
            ++ "{{ {s.name} _v; _v.tag = {v.text}_tag; "
            ++ ctor_assigns(s, v.children, 0) ++ "return _v; }}\n"
    }
}

ctor_params(s: Stmt, ps: Expr[], i: int) -> str {
    if ps.length() == 0 {
        "void"
    } else if i >= ps.length() {
        ""
    } else if i == ps.length() - 1 {
        "{ctor_slot(s, ps, i)} _{i}"
    } else {
        "{ctor_slot(s, ps, i)} _{i}, {ctor_params(s, ps, i + 1)}"
    }
}

/// A constructor takes its own payload by value, whatever the shared slot holds.
ctor_slot(s: Stmt, ps: Expr[], i: int) -> str =>
    ps.get(i).ty == s.name ? s.name : slot_type(s, i, 0)

ctor_assigns(s: Stmt, ps: Expr[], i: int) -> str {
    if i >= ps.length() {
        ""
    } else if ps.get(i).ty == s.name {
        "{s.name}* _b{i} = ({s.name}*)malloc(sizeof({s.name}));"
            ++ " *_b{i} = _{i}; _v._{i} = (long)_b{i};"
            ++ " {ctor_assigns(s, ps, i + 1)}"
    } else {
        "_v._{i} = _{i}; {ctor_assigns(s, ps, i + 1)}"
    }
}
