    "static MacaList maca_args(int argc, char** argv) {{ MacaList l; l.len = argc - 1; l.data = maca_cells((l.len ? l.len : 1) * sizeof(long long)); for (int i = 0; i < l.len; i++) l.data[i] = (long long)argv[i + 1]; return l; }}\n" +
