    "static int maca_cmp_cell(const void* a, const void* b) {{ long long x = *(const long long*)a, y = *(const long long*)b; return (x > y) - (x < y); }}\n" +
    "static int maca_cmp_cell_str(const void* a, const void* b) {{ return strcmp((const char*)*(const long long*)a, (const char*)*(const long long*)b); }}\n" +
    "static int maca_cmp_cell_float(const void* a, const void* b) {{ double x = *(double*)*(const long long*)a, y = *(double*)*(const long long*)b; return (x > y) - (x < y); }}\n" +
