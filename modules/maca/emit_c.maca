    "static MacaList maca_split(const char* s, const char* sep) {{ MacaList l; int cap = 8; l.len = 0; l.data = maca_cells(cap * sizeof(long long)); if (!*sep) {{ l.data[l.len++] = (long long)maca_cat(s, \"\"); return l; }} size_t ls = strlen(sep); const char* p = s; for (;;) {{ if (l.len == cap) {{ cap *= 2; long long* d = maca_cells(cap * sizeof(long long)); memcpy(d, l.data, (size_t)l.len * sizeof(long long)); l.data = d; }} const char* hit = strstr(p, sep); if (!hit) {{ l.data[l.len++] = (long long)maca_str_slice(p, 0, (int)strlen(p)); break; }} l.data[l.len++] = (long long)maca_str_slice(p, 0, (int)(hit - p)); p = hit + ls; }} return l; }}\n" +
