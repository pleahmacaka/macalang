// maca/styles: the integrated Tailwind, a stylesheet for the classes a program writes.

import maca/ast

TwFixed = "|flex=display:flex|inline-flex=display:inline-flex|grid=display:grid|block=display:block|inline=display:inline|inline-block=display:inline-block|hidden=display:none|flex-col=flex-direction:column|flex-row=flex-direction:row|flex-wrap=flex-wrap:wrap|flex-1=flex:1 1 0%|flex-auto=flex:1 1 auto|flex-none=flex:none|items-center=align-items:center|items-start=align-items:flex-start|items-end=align-items:flex-end|items-baseline=align-items:baseline|items-stretch=align-items:stretch|justify-center=justify-content:center|justify-between=justify-content:space-between|justify-start=justify-content:flex-start|justify-end=justify-content:flex-end|justify-around=justify-content:space-around|self-start=align-self:flex-start|self-end=align-self:flex-end|self-center=align-self:center|self-stretch=align-self:stretch|text-center=text-align:center|text-left=text-align:left|text-right=text-align:right|font-bold=font-weight:700|font-semibold=font-weight:600|font-medium=font-weight:500|font-normal=font-weight:400|font-sans=font-family:'Pretendard GOV Variable',sans-serif|font-mono=font-family:'JetBrainsMono Nerd Font',monospace|uppercase=text-transform:uppercase|lowercase=text-transform:lowercase|italic=font-style:italic|underline=text-decoration-line:underline|whitespace-pre=white-space:pre|whitespace-pre-wrap=white-space:pre-wrap|whitespace-nowrap=white-space:nowrap|whitespace-normal=white-space:normal|truncate=overflow:hidden;text-overflow:ellipsis;white-space:nowrap|break-words=overflow-wrap:break-word|break-all=word-break:break-all|break-keep=word-break:keep-all|overflow-auto=overflow:auto|overflow-hidden=overflow:hidden|overflow-x-auto=overflow-x:auto|overflow-y-auto=overflow-y:auto|relative=position:relative|absolute=position:absolute|fixed=position:fixed|sticky=position:sticky|static=position:static|list-none=list-style:none|list-disc=list-style:disc|list-decimal=list-style:decimal|border-collapse=border-collapse:collapse|table=display:table|table-auto=table-layout:auto|table-fixed=table-layout:fixed|text-inherit=color:inherit|border-separate=border-collapse:separate|align-top=vertical-align:top|align-middle=vertical-align:middle|align-baseline=vertical-align:baseline|font-serif=font-family:ui-serif,Georgia,serif|no-underline=text-decoration-line:none|shrink-0=flex-shrink:0|grow=flex-grow:1|content-none=content:\"\"|shadow=box-shadow:0 1px 3px rgba(0,0,0,.1)|shadow-md=box-shadow:0 4px 8px rgba(0,0,0,.12)|shadow-lg=box-shadow:0 4px 14px rgba(0,0,0,.14)|shadow-none=box-shadow:none|overscroll-contain=overscroll-behavior:contain|appearance-none=appearance:none|inset-0=top:0;right:0;bottom:0;left:0|cursor-pointer=cursor:pointer|cursor-default=cursor:default|resize-none=resize:none|outline-none=outline:none|pointer-events-none=pointer-events:none|pointer-events-auto=pointer-events:auto|select-none=user-select:none|box-border=box-sizing:border-box|box-content=box-sizing:content-box|tabular-nums=font-variant-numeric:tabular-nums|w-full=width:100%|h-full=height:100%|w-screen=width:100vw|h-screen=height:100vh|w-auto=width:auto|h-auto=height:auto|min-h-0=min-height:0|min-w-0=min-width:0|max-w-full=max-width:100%|rounded-none=border-radius:0|rounded=border-radius:0.25rem|rounded-md=border-radius:0.375rem|rounded-lg=border-radius:0.5rem|rounded-xl=border-radius:0.75rem|rounded-full=border-radius:9999px|border=border-width:1px;border-style:solid|border-0=border-width:0|border-t=border-top-width:1px;border-top-style:solid|border-b=border-bottom-width:1px;border-bottom-style:solid|border-l=border-left-width:1px;border-left-style:solid|border-r=border-right-width:1px;border-right-style:solid|border-x=border-left-width:1px;border-right-width:1px;border-left-style:solid;border-right-style:solid|border-y=border-top-width:1px;border-bottom-width:1px;border-top-style:solid;border-bottom-style:solid|"

TwColor = "|white=#ffffff|black=#000000|transparent=transparent|current=currentColor|zinc-50=#fafafa|zinc-100=#f4f4f5|zinc-200=#e4e4e7|zinc-300=#d4d4d8|zinc-400=#a1a1aa|zinc-500=#71717a|zinc-600=#52525b|zinc-700=#3f3f46|zinc-800=#27272a|zinc-850=#1f1f23|zinc-900=#18181b|zinc-950=#0d0d0f|violet-300=#c4b5fd|violet-400=#a78bfa|violet-500=#8b5cf6|violet-600=#7c3aed|cyan-400=#22d3ee|emerald-400=#34d399|emerald-500=#10b981|rose-400=#fb7185|rose-500=#f43f5e|amber-400=#fbbf24|amber-500=#f59e0b|sky-400=#38bdf8|"

TwProp = "|text=font-size|w=width|h=height|min-w=min-width|min-h=min-height|max-w=max-width|max-h=max-height|bg=background-color|border=border-color|p=padding|px=padding-inline|py=padding-block|pt=padding-top|pb=padding-bottom|pl=padding-left|pr=padding-right|m=margin|mx=margin-inline|my=margin-block|mt=margin-top|mb=margin-bottom|ml=margin-left|mr=margin-right|gap=gap|gap-x=column-gap|gap-y=row-gap|top=top|right=right|bottom=bottom|left=left|inset=inset|scroll-mt=scroll-margin-top|scroll-mb=scroll-margin-bottom|leading=line-height|font=font-family|content=content|shadow=box-shadow|grid-cols=grid-template-columns|"

TwText = "|xs=0.75rem|sm=0.875rem|base=1rem|lg=1.125rem|xl=1.25rem|2xl=1.5rem|3xl=1.875rem|"

TwLead = "|none=1|tight=1.25|snug=1.375|normal=1.5|relaxed=1.625|loose=2|"

TwTrack = "|tight=-0.025em|normal=0|wide=0.025em|wider=0.05em|widest=0.1em|"

TwWide = "|xs=20rem|sm=24rem|md=28rem|lg=32rem|xl=36rem|2xl=42rem|3xl=48rem|4xl=56rem|5xl=64rem|6xl=72rem|7xl=80rem|prose=65ch|none=none|"

TwEdge = "|border-l=left|border-r=right|border-t=top|border-b=bottom|border-x=left right|border-y=top bottom|"

TwPseudo = "|hover=:hover|focus=:focus|active=:active|first=:first-child|last=:last-child|open=[open]|before=::before|after=::after|marker=::marker|details-marker=::-webkit-details-marker|placeholder=::placeholder|"

TwMedia = "|dark=(prefers-color-scheme:dark)|sm=(min-width:40rem)|md=(min-width:48rem)|lg=(min-width:64rem)|xl=(min-width:80rem)|max-sm=(max-width:40rem)|max-md=(max-width:48rem)|max-lg=(max-width:64rem)|"

TwEscaped = "/.:[](),#%'\"!$&*+;<=>?@^`{{|}}~"

TwSide = "|pt=top|pr=right|pb=bottom|pl=left|mt=top|mr=right|mb=bottom|ml=left|"

TwReset = "*,*::before,*::after{{box-sizing:border-box}}\\nhtml,body{{margin:0}}\\n"

/** The value a `|key=value|` table holds for this key, empty when it holds
 * none.
 */
tw_look(table: str, key: str) -> str {
    at = table.index_of("|{key}=")

    if at < 0 {
        ""
    } else {
        rest = table.slice(at + key.length() + 2, table.length())

        rest.slice(0, rest.index_of("|"))
    }
}

tw_starts(c: str, p: str) -> bool =>
    c.starts_with(p)

tw_after(c: str, p: str) -> str =>
    c.slice(p.length(), c.length())

tw_decl(prop: str, v: str) -> str {
    if v == "" {
        ""
    } else {
        "{prop}:{v};"
    }
}

tw_pair_decl(a: str, b: str, v: str) -> str {
    if v == "" {
        ""
    } else {
        "{a}:{v};{b}:{v};"
    }
}

tw_digits(cs: str[], i: int, acc: int) -> int {
    if i >= cs.length() {
        acc
    } else if !cs.get(i).is_ascii_digit() {
        -1
    } else {
        tw_digits(cs, i + 1, acc * 10 + int(cs.get(i)))
    }
}

/** The number this text spells, or -1 when it spells no whole number. */
tw_int(s: str) -> int {
    if s == "" {
        -1
    } else {
        tw_digits(s.chars(), 0, 0)
    }
}

/** A signed number, normalised, or empty when the text is not one. */
tw_signed(s: str) -> str {
    if s.starts_with("-") {
        n = tw_int(s.slice(1, s.length()))

        n < 0 ? "" : "-{n}"
    } else {
        n = tw_int(s)

        n < 0 ? "" : "{n}"
    }
}

tw_pow10(k: int) -> int {
    if k <= 0 {
        1
    } else {
        10 * tw_pow10(k - 1)
    }
}

/** A decimal in thousandths, so `1.5` is 1500, or -1 when the text is not one.
 */
tw_thou(s: str) -> int {
    dot = s.index_of(".")

    if dot < 0 {
        n = tw_int(s)

        n < 0 ? -1 : n * 1000
    } else {
        tw_thou_parts(tw_int(s.slice(0, dot)), s.slice(dot + 1, s.length()))
    }
}

tw_thou_parts(whole: int, frac: str) -> int {
    f = tw_int(frac)

    if whole < 0 || f < 0 || frac.length() > 3 {
        -1
    } else {
        whole * 1000 + f * tw_pow10(3 - frac.length())
    }
}

tw_zeros(s: str) -> str {
    if s.ends_with("0") {
        tw_zeros(s.slice(0, s.length() - 1))
    } else {
        s
    }
}

tw_pad(n: int, width: int) -> str {
    if width <= 1 || n >= tw_pow10(width - 1) {
        "{n}"
    } else {
        "0" + tw_pad(n, width - 1)
    }
}

/** Thousandths written the shortest way that means the same, so 1250 is `1.25`.
 */
tw_dec(n: int) -> str {
    if n % 1000 == 0 {
        "{n / 1000}"
    } else {
        "{n / 1000}.{tw_zeros(tw_pad(n % 1000, 3))}"
    }
}

/** Tailwind's spacing scale as a length, so `4` is one rem and `px` is one
 * pixel.
 */
tw_space(v: str) -> str {
    if v == "0" {
        "0"
    } else if v == "px" {
        "1px"
    } else if v == "auto" {
        "auto"
    } else {
        n = tw_thou(v)

        n < 0 ? "" : "{tw_dec(n / 4)}rem"
    }
}

tw_ratio(v: str) -> str {
    cut = v.index_of("/")
    a = tw_int(v.slice(0, cut))
    b = tw_int(v.slice(cut + 1, v.length()))

    if a < 0 || b <= 0 {
        ""
    } else {
        t = a * 1000000 / b

        "{t / 10000}.{tw_pad(t % 10000, 4)}%"
    }
}

/** A width or height: the spacing scale, plus the named sizes and fractions. */
tw_size(v: str) -> str {
    if v == "none" || v == "auto" {
        v
    } else if v == "full" {
        "100%"
    } else if v == "screen" {
        "100vh"
    } else if v == "min" || v == "max" || v == "fit" {
        "{v}-content"
    } else if v.index_of("/") >= 0 {
        tw_ratio(v)
    } else {
        tw_space(v)
    }
}

tw_border(sides: str[], i: int, w: str) -> str {
    if i >= sides.length() {
        ""
    } else {
        s = sides.get(i)

        "border-{s}-width:{w};border-{s}-style:solid;" +
            tw_border(sides, i + 1, w)
    }
}

tw_trim_dash(s: str) -> str {
    if s.ends_with("-") {
        tw_trim_dash(s.slice(0, s.length() - 1))
    } else {
        s
    }
}

tw_last_dash(cs: str[], i: int, at: int) -> int {
    if i >= cs.length() {
        at
    } else if cs.get(i) == "-" {
        tw_last_dash(cs, i + 1, i)
    } else {
        tw_last_dash(cs, i + 1, at)
    }
}

/** A class written with its value in brackets, which any property can take. */
tw_arbitrary(c: str) -> str {
    open = c.index_of("[")

    if open < 0 || !c.ends_with("]") {
        ""
    } else {
        tw_bracket(tw_trim_dash(c.slice(0, open)),
                   c.slice(open + 1, c.length() - 1).replace("_", " "))
    }
}

tw_bracket(pre: str, raw: str) -> str {
    sides = tw_look(TwEdge, pre)
    prop = tw_look(TwProp, pre)

    if sides != "" {
        tw_border(sides.split(" "), 0, raw)
    } else if prop != "" {
        "{prop}:{raw};"
    } else {
        ""
    }
}

/** `border-t-2` and its siblings: an edge, and how many pixels wide it is. */
tw_edges(c: str) -> str {
    at = tw_last_dash(c.chars(), 0, -1)

    if at < 0 {
        ""
    } else {
        sides = tw_look(TwEdge, c.slice(0, at))
        n = tw_int(c.slice(at + 1, c.length()))

        if sides == "" || n < 0 {
            ""
        } else {
            tw_border(sides.split(" "), 0, "{n}px")
        }
    }
}

tw_offsets(c: str) -> str {
    if tw_starts(c, "top-") {
        tw_decl("top", tw_space(tw_after(c, "top-")))
    } else if tw_starts(c, "right-") {
        tw_decl("right", tw_space(tw_after(c, "right-")))
    } else if tw_starts(c, "bottom-") {
        tw_decl("bottom", tw_space(tw_after(c, "bottom-")))
    } else if tw_starts(c, "left-") {
        tw_decl("left", tw_space(tw_after(c, "left-")))
    } else {
        ""
    }
}

/** Where a cell sits in a grid, which a column count alone cannot say. */
tw_track(c: str) -> str {
    at = tw_last_dash(c.chars(), 0, -1)

    if at < 0 {
        ""
    } else {
        tw_axis(c.slice(0, at), c.slice(at + 1, c.length()))
    }
}

tw_axis(head: str, val: str) -> str {
    dash = head.index_of("-")
    axis = if head.starts_with("col") {
        "column"
    } else if head.starts_with("row") {
        "row"
    } else {
        ""
    }

    if axis == "" || dash < 0 {
        ""
    } else {
        tw_place(axis, head.slice(dash + 1, head.length()), val)
    }
}

tw_place(axis: str, part: str, val: str) -> str {
    n = tw_signed(val)
    span = tw_int(val)

    if part == "span" && val == "full" {
        "grid-{axis}:1 / -1;"
    } else if part == "span" && span >= 0 {
        "grid-{axis}:span {span} / span {span};"
    } else if part == "span" {
        ""
    } else if part == "start" && val == "auto" {
        "grid-{axis}-start:auto;"
    } else if part == "end" && val == "auto" {
        "grid-{axis}-end:auto;"
    } else if part == "start" || part == "end" {
        tw_decl("grid-{axis}-{part}", n)
    } else {
        ""
    }
}

tw_leading(v: str) -> str {
    named = tw_look(TwLead, v)

    if named != "" {
        "line-height:{named};"
    } else {
        tw_decl("line-height", tw_space(v))
    }
}

tw_widest(v: str) -> str {
    named = tw_look(TwWide, v)

    if named != "" {
        "max-width:{named};"
    } else {
        tw_decl("max-width", tw_size(v))
    }
}

tw_repeat(prop: str, v: str) -> str {
    n = tw_int(v)

    if n < 0 {
        ""
    } else {
        "grid-template-{prop}:repeat({n},minmax(0,1fr));"
    }
}

/** The body of one utility class, empty when this is no class of ours. */
tw_body(c: str) -> str {
    fixed = tw_look(TwFixed, c)

    if fixed != "" {
        "{fixed};"
    } else {
        tw_measured(c)
    }
}

tw_measured(c: str) -> str {
    arbitrary = tw_arbitrary(c)
    edges = tw_edges(c)

    if tw_starts(c, "min-h-") {
        tw_decl("min-height", tw_size(tw_after(c, "min-h-")))
    } else if tw_starts(c, "min-w-") {
        tw_decl("min-width", tw_size(tw_after(c, "min-w-")))
    } else if arbitrary != "" {
        arbitrary
    } else if tw_starts(c, "underline-offset-") {
        tw_pixels("text-underline-offset", tw_after(c, "underline-offset-"))
    } else if tw_starts(c, "leading-") {
        tw_leading(tw_after(c, "leading-"))
    } else if tw_starts(c, "decoration-") {
        tw_decl("text-decoration-color",
                tw_look(TwColor, tw_after(c, "decoration-")))
    } else if edges != "" {
        edges
    } else {
        tw_placed(c)
    }
}

tw_pixels(prop: str, v: str) -> str {
    n = tw_int(v)

    if n < 0 {
        ""
    } else {
        "{prop}:{n}px;"
    }
}

tw_placed(c: str) -> str {
    offsets = tw_offsets(c)
    track = tw_track(c)

    if tw_starts(c, "scroll-mt-") {
        tw_decl("scroll-margin-top", tw_space(tw_after(c, "scroll-mt-")))
    } else if tw_starts(c, "scroll-mb-") {
        tw_decl("scroll-margin-bottom", tw_space(tw_after(c, "scroll-mb-")))
    } else if offsets != "" {
        offsets
    } else if tw_starts(c, "max-w-") {
        tw_widest(tw_after(c, "max-w-"))
    } else if tw_starts(c, "max-h-") {
        tw_decl("max-height", tw_size(tw_after(c, "max-h-")))
    } else if tw_starts(c, "gap-x-") {
        tw_decl("column-gap", tw_space(tw_after(c, "gap-x-")))
    } else if tw_starts(c, "gap-y-") {
        tw_decl("row-gap", tw_space(tw_after(c, "gap-y-")))
    } else if tw_starts(c, "grid-cols-") {
        tw_repeat("columns", tw_after(c, "grid-cols-"))
    } else if tw_starts(c, "grid-rows-") {
        tw_repeat("rows", tw_after(c, "grid-rows-"))
    } else if track != "" {
        track
    } else {
        tw_scaled(c)
    }
}

tw_scaled(c: str) -> str {
    at = c.index_of("-")

    if at < 0 {
        ""
    } else {
        tw_scale(c.slice(0, at), c.slice(at + 1, c.length()))
    }
}

tw_scale(p: str, v: str) -> str {
    if p == "p" || p == "m" {
        tw_decl(tw_box(p), tw_space(v))
    } else if p == "px" || p == "py" || p == "mx" || p == "my" {
        tw_axes(p, tw_space(v))
    } else if tw_side_of(p) != "" {
        tw_decl("{tw_box(p.slice(0, 1))}-{tw_side_of(p)}", tw_space(v))
    } else if p == "gap" {
        tw_decl("gap", tw_space(v))
    } else {
        tw_valued(p, v)
    }
}

tw_box(p: str) -> str {
    if p == "p" {
        "padding"
    } else {
        "margin"
    }
}

tw_side_of(p: str) -> str =>
    tw_look(TwSide, p)

tw_axes(p: str, v: str) -> str {
    box = tw_box(p.slice(0, 1))

    if p.ends_with("x") {
        tw_pair_decl("{box}-left", "{box}-right", v)
    } else {
        tw_pair_decl("{box}-top", "{box}-bottom", v)
    }
}

tw_valued(p: str, v: str) -> str {
    if p == "w" {
        tw_decl("width", tw_size(v))
    } else if p == "h" {
        tw_decl("height", tw_size(v))
    } else if p == "basis" {
        tw_decl("flex-basis", tw_size(v))
    } else if p == "text" {
        tw_typed(v)
    } else if p == "leading" {
        tw_decl("line-height", tw_look(TwLead, v))
    } else if p == "tracking" {
        tw_decl("letter-spacing", tw_look(TwTrack, v))
    } else if p == "opacity" {
        tw_opacity(v)
    } else if p == "z" {
        tw_decl("z-index", tw_signed(v))
    } else if p == "bg" {
        tw_decl("background-color", tw_look(TwColor, v))
    } else if p == "border" {
        tw_decl("border-color", tw_look(TwColor, v))
    } else if p == "caret" {
        tw_decl("caret-color", tw_look(TwColor, v))
    } else if p == "rounded" && v == "sm" {
        "border-radius:0.125rem;"
    } else {
        ""
    }
}

tw_typed(v: str) -> str {
    sized = tw_look(TwText, v)

    if sized != "" {
        "font-size:{sized};"
    } else {
        tw_decl("color", tw_look(TwColor, v))
    }
}

tw_opacity(v: str) -> str {
    n = tw_int(v)

    if n < 0 {
        ""
    } else {
        "opacity:{tw_dec(n * 10)};"
    }
}

/** `dark:hover:bg-x` as its variants and, last, the utility they modify. */
tw_parts(c: str, acc: str[]) -> str[] {
    at = c.index_of(":")

    if at < 0 || c.slice(0, at).index_of("[") >= 0 {
        acc + [c]
    } else {
        tw_parts(c.slice(at + 1, c.length()), acc + [c.slice(0, at)])
    }
}

tw_variant(v: str) -> str =>
    tw_look(TwPseudo, v) + tw_look(TwMedia, v)

tw_known(parts: str[], i: int, n: int) -> bool {
    if i >= n {
        true
    } else if tw_variant(parts.get(i)) == "" {
        false
    } else {
        tw_known(parts, i + 1, n)
    }
}

tw_selector(parts: str[], i: int, n: int, acc: str) -> str {
    if i >= n {
        acc
    } else {
        tw_selector(parts, i + 1, n, acc + tw_look(TwPseudo, parts.get(i)))
    }
}

tw_queries(parts: str[], i: int, n: int, acc: str[]) -> str[] {
    if i >= n {
        acc
    } else {
        found = tw_look(TwMedia, parts.get(i))
        got = if found == "" { acc } else { acc + [found] }

        tw_queries(parts, i + 1, n, got)
    }
}

/** A class name as a CSS selector spells it, with its punctuation escaped. */
tw_escape(c: str) -> str =>
    tw_escaped(c.chars(), 0, "")

tw_escaped(cs: str[], i: int, acc: str) -> str {
    if i >= cs.length() {
        acc
    } else if TwEscaped.index_of(cs.get(i)) >= 0 {
        tw_escaped(cs, i + 1, acc + "\\" + cs.get(i))
    } else {
        tw_escaped(cs, i + 1, acc + cs.get(i))
    }
}

/** The whole rule one class stands for, empty when it stands for none. */
tw_rule(c: str) -> str {
    parts = tw_parts(c, [])
    n = parts.length() - 1
    body = tw_body(parts.get(n))

    if body == "" || !tw_known(parts, 0, n) {
        ""
    } else {
        tw_wrapped(tw_queries(parts, 0, n, []),
                   ".{tw_escape(c)}{tw_selector(parts, 0, n, "")} " +
                       "{{ {body} }}")
    }
}

tw_wrapped(media: str[], rule: str) -> str {
    if media.length() == 0 {
        rule
    } else {
        q = media.join(" and ")

        "@media{q} {{ {rule} }}"
    }
}

/** Where a class's rule belongs in the sheet, since the later of two wins. */
tw_order(c: str) -> int {
    parts = tw_parts(c, [])

    if parts.length() == 1 {
        0
    } else {
        tw_rank(parts, 0, parts.length() - 1, 1)
    }
}

tw_rank(parts: str[], i: int, n: int, r: int) -> int {
    if i >= n {
        r
    } else {
        tw_rank(parts, i + 1, n, tw_layer(parts.get(i), r))
    }
}

tw_layer(v: str, r: int) -> int {
    if v == "sm" {
        3
    } else if v == "md" {
        4
    } else if v == "lg" {
        5
    } else if v == "xl" {
        6
    } else if v == "max-lg" {
        7
    } else if v == "max-md" {
        8
    } else if v == "max-sm" {
        9
    } else if v == "dark" && r < 2 {
        2
    } else {
        r
    }
}

tw_words(s: str) -> str[] =>
    s.replace("\\n", " ").replace("\\t", " ").split(" ")

tw_in_exprs(xs: Expr[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else {
        tw_in_exprs(xs, i + 1, tw_in_expr(xs.get(i), acc))
    }
}

tw_in_expr(e: Expr, acc: str[]) -> str[] {
    got = if e.kind == EStr { acc + tw_words(e.text) } else { acc }
    from = if tw_tagged(e) { 1 } else { 0 }

    tw_in_stmts(e.stmts, 0, tw_in_exprs(e.children, from, got))
}

/** A tag or an attribute is named, not classed, however much `table` looks like
 * one.
 */
tw_tagged(e: Expr) -> bool =>
    e.kind == ECall
        && (e.text == "maca_element" || e.text == "maca_attr"
                || e.text == "maca_flag")

tw_in_stmts(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else {
        tw_in_stmts(items, i + 1, tw_in_stmt(items.get(i), acc))
    }
}

tw_in_stmt(s: Stmt, acc: str[]) -> str[] =>
    tw_in_stmts(s.body, 0,
                tw_in_expr(s.value, tw_in_exprs(s.params, 0, acc)))

tw_unique(cs: str[], i: int, acc: str[]) -> str[] {
    if i >= cs.length() {
        acc
    } else if i > 0 && cs.get(i) == cs.get(i - 1) {
        tw_unique(cs, i + 1, acc)
    } else {
        tw_unique(cs, i + 1, acc + [cs.get(i)])
    }
}

/** A rule sits inside a C string, where a backslash has to be written twice. */
tw_quoted(s: str) -> str =>
    s.replace("\\", "\\\\")

tw_sheet(cs: str[], rank: int, acc: str) -> str {
    if rank > 9 {
        acc
    } else {
        tw_sheet(cs, rank + 1, acc + tw_rules(cs, 0, rank, ""))
    }
}

tw_rules(cs: str[], i: int, rank: int, acc: str) -> str {
    if i >= cs.length() {
        acc
    } else {
        c = cs.get(i)
        r = if tw_order(c) == rank { tw_rule(c) } else { "" }
        line = if r == "" { "" } else { tw_quoted(r) + "\\n" }

        tw_rules(cs, i + 1, rank, acc + line)
    }
}

/** The stylesheet a program's own class names ask for, as a C string spells it.
 */
style_sheet(items: Stmt[]) -> str =>
    TwReset +
        tw_sheet(tw_unique(tw_in_stmts(items, 0, []).sort(), 0, []), 0, "")
