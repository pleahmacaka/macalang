import maca/token
import maca/ast
import maca/ty

Env = {
    names:  str[]
    types:  Ty[]
    fns:    str[]
    sigs:   Ty[]
    fields: str[]
    ftypes: Ty[]
    ctors:  str[]
    owners: str[]
    slots:  str[]
    varargs: str[]
    errors: str[]
    infer:  Infer
}

empty_env() -> Env =>
    Env { names = [], types = [], fns = [], sigs = [],
          fields = [], ftypes = [], ctors = [], owners = [], slots = [],
          varargs = [], errors = [], infer = new_infer() }

Typed = {
    env: Env
    ty:  Ty
}

typed(env: Env, ty: Ty) -> Typed =>
    Typed { env, ty }

Signature = {
    env: Env
    tys: Ty[]
}

bind(env: Env, name: str, ty: Ty) -> Env =>
    env with { names = env.names ++ [name], types = env.types ++ [ty] }

complain(env: Env, why: str) -> Env =>
    env with { errors = env.errors ++ [why] }

note(env: Env, why: str) -> Env {
    if why == "" {
        env
    } else {
        complain(env, why)
    }
}

with_infer(env: Env, inf: Infer) -> Env =>
    env with { infer = inf }

joined(env: Env, want: Ty, got: Ty) -> Env {
    step = unify(env.infer, want, got)

    note(with_infer(env, step.infer), step.error)
}

is_array_name(name: str) -> bool =>
    name.length() > 2 && name.slice(name.length() - 2, name.length()) == "[]"

ty_named(name: str) -> Ty {
    if name == "" {
        t_any()
    } else if is_array_name(name) {
        t_array(ty_named(name.slice(0, name.length() - 2)))
    } else if name == "int" {
        t_int()
    } else if name == "float" {
        t_float()
    } else if name == "str" || name == "Element" {
        t_str()
    } else if name == "bool" {
        t_bool()
    } else if name == "bytes" {
        t_bytes()
    } else if is_type_var(name) {
        t_any()
    } else {
        t_con(name, [])
    }
}

is_type_var(name: str) -> bool {
    if name == "unit" || name.index_of("__") >= 0 {
        false
    } else if !starts_lower(name) {
        false
    } else {
        !sized_number(name)
    }
}

starts_lower(name: str) -> bool =>
    name.length() > 0 && name.at(0).is_alpha()
        && name.at(0).upper() != name.at(0)

sized_number(name: str) -> bool =>
    name.length() > 1 && name.at(1).is_ascii_digit()
        && (name.at(0) == "i" || name.at(0) == "u" || name.at(0) == "f")

declared_type(env: Env, decl: str) -> Typed {
    if decl != "" {
        typed(env, ty_named(decl))
    } else {
        made = fresh(env.infer)

        typed(with_infer(env, made.infer), made.ty)
    }
}

param_types(env: Env, ps: Expr[], i: int, acc: Ty[]) -> Signature {
    if i >= ps.length() {
        Signature { env, tys = acc }
    } else {
        got = declared_type(env, ps.get(i).ty)

        param_types(got.env, ps, i + 1, acc ++ [got.ty])
    }
}

env_of_module(m: Module) -> Env =>
    collect_items(empty_env(), m.items, 0)

collect_items(env: Env, items: Stmt[], i: int) -> Env {
    if i >= items.length() {
        env
    } else {
        collect_items(collect_item(env, items.get(i)), items, i + 1)
    }
}

collect_item(env: Env, s: Stmt) -> Env {
    if s.kind == SFn {
        add_fn(env, s)
    } else if s.kind == SRecord {
        add_fields(env, s.name, s.params, 0)
    } else if s.kind == SSum {
        add_ctors(env, s.name, s.params, 0)
    } else if s.kind == SBind {
        add_const(env, s)
    } else {
        env
    }
}

add_const(env: Env, s: Stmt) -> Env {
    got = type_in(env, s.value)
    held = if s.ret != "" { ty_named(s.ret) } else { got.ty }

    got.env with { names = got.env.names ++ [s.name],
                   types = got.env.types ++ [held] }
}

add_fn(env: Env, s: Stmt) -> Env {
    made = param_types(env, s.params, 0, [])

    made.env with { fns = made.env.fns ++ [s.name],
                    sigs = made.env.sigs ++ [t_fn(made.tys, ty_named(s.ret))],
                    varargs = made.env.varargs ++ rest_taker(s) }
}

rest_taker(s: Stmt) -> str[] {
    n = s.params.length()

    if n > 0 && s.params.get(n - 1).ival == 1 {
        [s.name]
    } else {
        []
    }
}

add_fields(env: Env, rec: str, fs: Expr[], i: int) -> Env {
    if i >= fs.length() {
        env
    } else {
        held = env with { fields = env.fields ++ [rec ++ "." ++ fs.get(i).text],
                          ftypes = env.ftypes ++ [ty_named(fs.get(i).ty)] }

        add_fields(held, rec, fs, i + 1)
    }
}

add_ctors(env: Env, sum: str, vs: Expr[], i: int) -> Env {
    if i >= vs.length() {
        env
    } else {
        held = env with { ctors = env.ctors ++ [vs.get(i).text],
                          owners = env.owners ++ [sum],
                          slots = env.slots ++ [slot_types(vs.get(i))] }

        add_ctors(held, sum, vs, i + 1)
    }
}

type_in(env: Env, e: Expr) -> Typed =>
    match e.kind {
        EInt     => typed(env, t_int())
        EFloat   => typed(env, t_float())
        EStr     => typed(env, t_str())
        EBool    => typed(env, t_bool())
        EIdent   => ident_type(env, e)
        ECall    => call_type(env, e)
        EBinary  => binop_type(env, e)
        ETernary => ternary_type(env, e)
        EIf      => ternary_type(env, e)
        EUnary   => unary_type(env, e)
        ERecord  => typed(check_fields(env, e.text, e.children, 0),
                          t_con(e.text, []))
        EWith    => with_type(env, e)
        EField   => field_type(env, e)
        EMethod  => method_type(env, e)
        EBlock   => block_type(env, e)
        EBad     => typed(complain(env, "no expression starts at "
                                        ++ "`{e.text}`"), t_error())
        EAttr    => type_in(env, e.children.get(0))
        EGuard   => typed(walk_args(env, e.children, 0), t_bool())
        EMatch   => match_type(env, e)
        EList    => list_type(env, e)
        EWhile   => while_type(env, e)
        EFor     => for_type(env, e)
        ELambda  => lambda_type(env, e)
        _        => typed(env, t_any())
    }

lambda_type(env: Env, e: Expr) -> Typed {
    ps = lambda_params(e)
    made = param_types(env, ps, 0, [])
    inner = bind_params(made.env, ps, made.tys, 0)
    body = type_in(inner, lambda_body(e))

    typed(body.env with { names = env.names, types = env.types },
          t_fn(made.tys, body.ty))
}

while_type(env: Env, e: Expr) -> Typed {
    cond = type_in(env, e.children.get(0))
    ready = joined(cond.env, t_bool(), cond.ty)
    inner = check_stmts(ready, e.stmts, 0)

    typed(inner with { names = env.names, types = env.types }, t_unit())
}

for_type(env: Env, e: Expr) -> Typed {
    over = type_in(env, e.children.get(0))
    el = element_of(resolve(over.env.infer, over.ty))
    inner = check_stmts(bind(over.env, e.text, el), e.stmts, 0)

    typed(inner with { names = env.names, types = env.types }, t_unit())
}

check_stmts(env: Env, stmts: Stmt[], i: int) -> Env {
    if i >= stmts.length() {
        env
    } else {
        st = stmts.get(i)
        got = stmt_type(env, st, false)

        check_stmts(extend(got.env, st, got.ty), stmts, i + 1)
    }
}

range_type(env: Env, a: Ty, b: Ty) -> Typed {
    lo = joined(env, t_int(), a)

    typed(joined(lo, t_int(), b), t_array(t_int()))
}

unary_type(env: Env, e: Expr) -> Typed {
    inner = type_in(env, e.children.get(0))

    if e.text == "fail" {
        typed(inner.env, t_any())
    } else if e.text == "try" {
        typed(inner.env, t_str())
    } else {
        inner
    }
}

ident_type(env: Env, e: Expr) -> Typed {
    at = env.names.index_of(e.text)
    variant = env.ctors.index_of(e.text)
    declared = env.fns.index_of(e.text)

    if at >= 0 {
        typed(env, env.types.get(at))
    } else if variant >= 0 {
        typed(env, t_con(env.owners.get(variant), []))
    } else if declared >= 0 {
        fn_value(env, env.sigs.get(declared))
    } else {
        typed(env, t_any())
    }
}

fn_value(env: Env, sig: Ty) -> Typed {
    used = instantiate(env.infer, generalize(env.infer, sig))

    typed(with_infer(env, used.infer), used.ty)
}

call_type(env: Env, e: Expr) -> Typed {
    declared = env.fns.index_of(e.text)
    variant = env.ctors.index_of(e.text)
    local = env.names.index_of(e.text)

    if declared >= 0 {
        call_declared(env, e, env.sigs.get(declared))
    } else if variant >= 0 {
        typed(walk_args(env, e.children, 0), t_con(env.owners.get(variant), []))
    } else if local >= 0 {
        call_local(env, e, env.types.get(local))
    } else {
        typed(walk_args(env, e.children, 0), builtin_type(e.text))
    }
}

call_local(env: Env, e: Expr, held: Ty) -> Typed {
    made = arg_types(env, e.children, 0, [])
    res = fresh(made.env.infer)
    ready = with_infer(made.env, res.infer)

    typed(joined(ready, held, t_fn(made.tys, res.ty)), res.ty)
}

arg_types(env: Env, args: Expr[], i: int, acc: Ty[]) -> Signature {
    if i >= args.length() {
        Signature { env, tys = acc }
    } else {
        got = type_in(env, args.get(i))

        arg_types(got.env, args, i + 1, acc ++ [got.ty])
    }
}

call_declared(env: Env, e: Expr, sig: Ty) -> Typed {
    used = instantiate(env.infer, generalize(env.infer, sig))
    ready = with_infer(env, used.infer)
    params = fn_params(used.ty)

    if takes_rest(ready, e, params.length()) {
        typed(unify_args(ready, e.children.slice(0, params.length() - 1),
                         params, 0), fn_ret(used.ty))
    } else if params.length() != e.children.length() {
        typed(wrong_arity(ready, e, params.length()), fn_ret(used.ty))
    } else {
        typed(unify_args(ready, e.children, params, 0), fn_ret(used.ty))
    }
}

takes_rest(env: Env, e: Expr, wanted: int) -> bool =>
    env.varargs.index_of(e.text) >= 0 && e.children.length() >= wanted - 1

wrong_arity(env: Env, e: Expr, wanted: int) -> Env =>
    complain(env, "`{e.text}` takes {wanted} argument(s), given {e.children.length()}")

unify_args(env: Env, args: Expr[], params: Ty[], i: int) -> Env {
    if i >= args.length() {
        env
    } else {
        got = type_in(env, args.get(i))

        unify_args(joined(got.env, params.get(i), got.ty), args, params, i + 1)
    }
}

walk_args(env: Env, args: Expr[], i: int) -> Env {
    if i >= args.length() {
        env
    } else {
        walk_args(type_in(env, args.get(i)).env, args, i + 1)
    }
}

builtin_type(name: str) -> Ty {
    if is_str_builtin(name) {
        t_str()
    } else if is_float_builtin(name) {
        t_float()
    } else if is_int_builtin(name) {
        t_int()
    } else if is_bool_builtin(name) {
        t_bool()
    } else if name == "list_dir" {
        t_array(t_str())
    } else if is_io_builtin(name) {
        t_unit()
    } else if is_element_tag(name) {
        t_str()
    } else {
        t_any()
    }
}

ElementTags = " html head title meta link style script body div span p pre code a button input textarea select option label form header footer main section article nav aside ul ol li table thead tbody tr td th h1 h2 h3 h4 h5 h6 img svg canvas small strong em b i hr br blockquote figure figcaption details summary dialog progress meter video audio "

is_element_tag(name: str) -> bool =>
    ElementTags.index_of(" {name} ") >= 0

is_prelude_call(name: str) -> bool =>
    is_str_builtin(name) || is_float_builtin(name) || is_int_builtin(name)
        || is_bool_builtin(name) || is_io_builtin(name)

is_str_builtin(name: str) -> bool =>
    name == "str" || name == "chr" || name == "read_line" || name == "capture"
        || name == "read_file" || name == "env" || name == "cwd"
        || name == "real_path" || name == "maca_attr" || name == "maca_flag"
        || name == "maca_element"

is_float_builtin(name: str) -> bool =>
    name == "float" || name == "sqrt" || name == "floor" || name == "ceil"
        || name == "round" || name == "pow" || name == "sin" || name == "cos"
        || name == "tan" || name == "log" || name == "exp"

is_int_builtin(name: str) -> bool =>
    name == "int" || name == "exec" || name == "len" || name == "ord"
        || name == "sign" || name == "gcd" || name == "now_ms"
        || name == "file_size" || name == "modified_ms"

is_bool_builtin(name: str) -> bool =>
    name == "assert" || name == "assert_eq"
        || name == "write_file" || name == "file_exists" || name == "make_dir"
        || name == "is_dir" || name == "remove_file" || name == "remove_dir"
        || name == "copy_bytes" || name == "chdir" || name == "is_tty"

is_io_builtin(name: str) -> bool =>
    name == "info" || name == "print" || name == "err" || name == "warn"
        || name == "debug" || name == "notice" || name == "crit"
        || name == "alert" || name == "emerg" || name == "panic"
        || name == "sleep_ms"

is_compare(op: str) -> bool =>
    op == "==" || op == "!=" || op == "<" || op == ">"
        || op == "<=" || op == ">="

is_logic(op: str) -> bool =>
    op == "&&" || op == "||"

binop_type(env: Env, e: Expr) -> Typed {
    if e.text == "=" {
        type_in(env, e.children.get(1))
    } else {
        operator_type(env, e)
    }
}

operator_type(env: Env, e: Expr) -> Typed {
    lhs = type_in(env, e.children.get(0))
    rhs = type_in(lhs.env, e.children.get(1))

    if e.text == "++" || joins(rhs.env, e.text, lhs.ty, rhs.ty) {
        typed(rhs.env, concat_type(rhs.env, lhs.ty, rhs.ty))
    } else if e.text == ".." {
        range_type(rhs.env, lhs.ty, rhs.ty)
    } else if is_compare(e.text) {
        typed(joined(rhs.env, lhs.ty, rhs.ty), t_bool())
    } else if is_logic(e.text) {
        typed(rhs.env, t_bool())
    } else {
        arith_type(rhs.env, e.text, lhs.ty, rhs.ty)
    }
}

is_list(t: Ty) -> bool =>
    t.kind == KCon && t.name == "Array"

joins(env: Env, op: str, a: Ty, b: Ty) -> bool {
    left = resolve(env.infer, a)
    right = resolve(env.infer, b)

    op == "+" && ((left.kind == KStr && right.kind == KStr)
                      || (is_list(left) && is_list(right)))
}

concat_type(env: Env, a: Ty, b: Ty) -> Ty {
    left = resolve(env.infer, a)
    right = resolve(env.infer, b)

    if is_list(left) {
        left
    } else if is_list(right) {
        right
    } else {
        t_str()
    }
}

numeric(t: Ty) -> bool =>
    t.kind == KInt || t.kind == KFloat || t.kind == KVar || absorbing(t)

overload_name(op: str) -> str {
    if op == "+" {
        "add"
    } else if op == "-" {
        "sub"
    } else if op == "*" {
        "mul"
    } else if op == "/" {
        "div"
    } else {
        ""
    }
}

declares_field(env: Env, owner: str, i: int) -> bool {
    if i >= env.fields.length() {
        false
    } else if env.fields.get(i).index_of(owner ++ ".") == 0 {
        true
    } else {
        declares_field(env, owner, i + 1)
    }
}

is_nominal(env: Env, t: Ty) -> bool =>
    t.kind == KCon && t.name != "Array"
        && (env.owners.index_of(t.name) >= 0 || declares_field(env, t.name, 0))

overload_at(env: Env, op: str, left: Ty) -> int {
    if overload_name(op) == "" || !is_nominal(env, left) {
        0 - 1
    } else {
        env.fns.index_of(overload_name(op))
    }
}

arith_type(env: Env, op: str, a: Ty, b: Ty) -> Typed {
    at = overload_at(env, op, resolve(env.infer, a))

    if at >= 0 {
        typed(env, fn_ret(env.sigs.get(at)))
    } else {
        numeric_type(env, a, b)
    }
}

numeric_type(env: Env, a: Ty, b: Ty) -> Typed {
    step = unify(env.infer, a, b)
    ready = with_infer(env, step.infer)
    left = resolve(step.infer, a)
    right = resolve(step.infer, b)

    if step.error != "" {
        typed(complain(ready, step.error), t_error())
    } else if left.kind == KFloat || right.kind == KFloat {
        typed(ready, t_float())
    } else if numeric(left) {
        typed(ready, t_int())
    } else if left.kind == KCon {
        typed(ready, left)
    } else {
        typed(complain(ready, "{show_ty(left)} is not a number"), t_error())
    }
}

ternary_type(env: Env, e: Expr) -> Typed {
    cond = type_in(env, e.children.get(0))
    then = type_in(cond.env, e.children.get(1))
    other = type_in(then.env, e.children.get(2))

    typed(joined(other.env, then.ty, other.ty), then.ty)
}

block_type(env: Env, e: Expr) -> Typed {
    inner = check_body(env, e.stmts, 0, t_any())
    last = type_in(inner.env, e.children.get(0))

    typed(last.env with { names = env.names, types = env.types }, last.ty)
}

method_type(env: Env, e: Expr) -> Typed {
    recv = type_in(env, e.children.get(0))
    walked = walk_args(recv.env, e.children, 1)

    if e.text == "map" && e.children.length() == 2 {
        mapped_type(recv.env, resolve(recv.env.infer, recv.ty),
                    e.children.get(1))
    } else if e.text == "filter" && e.children.length() == 2 {
        sifted_type(recv.env, resolve(recv.env.infer, recv.ty),
                    e.children.get(1))
    } else {
        typed(walked, method_result(e.text, resolve(walked.infer, recv.ty)))
    }
}

mapped_type(env: Env, recv: Ty, f: Expr) -> Typed {
    got = type_in(env, f)
    res = fresh(got.env.infer)
    ready = joined(with_infer(got.env, res.infer), got.ty,
                   t_fn([element_of(recv)], res.ty))

    typed(ready, t_array(resolve(ready.infer, res.ty)))
}

sifted_type(env: Env, recv: Ty, f: Expr) -> Typed {
    got = type_in(env, f)
    ready = joined(got.env, got.ty, t_fn([element_of(recv)], t_bool()))

    typed(ready, recv)
}

method_result(name: str, recv: Ty) -> Ty {
    if name == "length" || name == "count" || name == "index_of" {
        t_int()
    } else if name == "at" {
        element_of(recv)
    } else if name == "join" {
        t_str()
    } else if name == "chars" {
        t_array(t_str())
    } else if name == "slice" || name == "push" {
        recv
    } else if name == "get" {
        element_of(recv)
    } else if is_reshaping_method(name) {
        recv
    } else if is_picking_method(name) {
        element_of(recv)
    } else if is_text_method(name) {
        t_str()
    } else if name == "split" {
        t_array(t_str())
    } else if is_asking_method(name) {
        t_bool()
    } else {
        t_any()
    }
}

is_reshaping_method(name: str) -> bool =>
    name == "pop" || name == "reverse" || name == "sort" || name == "set"
        || name == "insert" || name == "remove"

is_picking_method(name: str) -> bool =>
    name == "sum" || name == "min" || name == "max" || name == "first"
        || name == "last"

is_text_method(name: str) -> bool =>
    name == "trim" || name == "lower" || name == "upper"
        || name == "replace" || name == "repeat" || name == "substr"
        || name == "pad_start" || name == "pad_end"

is_asking_method(name: str) -> bool =>
    name == "starts_with" || name == "ends_with" || name == "contains"
        || name == "is_whitespace" || name == "is_ascii_digit"
        || name == "is_alpha"

element_of(t: Ty) -> Ty {
    if t.kind == KStr {
        t_str()
    } else if t.kind == KCon && t.name == "Array" && t.args.length() == 1 {
        t.args.get(0)
    } else {
        t_any()
    }
}

with_type(env: Env, e: Expr) -> Typed {
    base = type_in(env, e.children.get(0))
    owner = resolve(base.env.infer, base.ty)

    typed(check_fields(base.env, owner.name, e.children, 1), base.ty)
}

check_fields(env: Env, rec: str, fs: Expr[], i: int) -> Env {
    if i >= fs.length() {
        env
    } else {
        check_fields(field_set(env, rec, fs.get(i)), rec, fs, i + 1)
    }
}

field_set(env: Env, rec: str, f: Expr) -> Env {
    at = env.fields.index_of(rec ++ "." ++ f.children.get(0).text)
    got = type_in(env, f)

    if at < 0 {
        got.env
    } else {
        joined(got.env, env.ftypes.get(at), got.ty)
    }
}

field_type(env: Env, e: Expr) -> Typed {
    base = type_in(env, e.children.get(0))
    owner = resolve(base.env.infer, base.ty)
    at = env.fields.index_of(owner.name ++ "." ++ e.text)

    if at < 0 {
        typed(base.env, t_any())
    } else {
        typed(base.env, env.ftypes.get(at))
    }
}

/// The payload types a variant carries, joined, so one list can hold them beside the name.
slot_types(v: Expr) -> str =>
    v.children.map(binder_type).join(",")

binder_type(b: Expr) -> str =>
    b.ty

match_type(env: Env, e: Expr) -> Typed {
    if e.children.length() < 3 {
        typed(walk_args(env, e.children, 0), t_any())
    } else {
        seen = type_in(env, e.children.get(0))
        first = type_in(bound_arm(seen.env, e.children.get(1)),
                        e.children.get(2))

        typed(unify_arms(first.env, e.children, first.ty, 3), first.ty)
    }
}

unify_arms(env: Env, cs: Expr[], want: Ty, i: int) -> Env {
    if i + 1 >= cs.length() {
        env
    } else {
        got = type_in(bound_arm(env, cs.get(i)), cs.get(i + 1))

        unify_arms(joined(got.env, want, got.ty), cs, want, i + 2)
    }
}

/// `C(r)` binds `r` to what the variant declared it carries, so the arm reads it as that.
bound_arm(env: Env, pat: Expr) -> Env {
    if pat.kind == EGuard {
        bound_arm(env, pat.children.get(0))
    } else if pat.children.length() == 0 {
        env
    } else {
        at = env.ctors.index_of(pat.text)

        if at < 0 {
            env
        } else {
            bind_slots_of(env, pat.children, env.slots.get(at).split(","), 0)
        }
    }
}

bind_slots_of(env: Env, bs: Expr[], tys: str[], i: int) -> Env {
    if i >= bs.length() || i >= tys.length() {
        env
    } else {
        bind_slots_of(bind(env, bs.get(i).text, ty_named(tys.get(i))),
                      bs, tys, i + 1)
    }
}

list_type(env: Env, e: Expr) -> Typed {
    if e.children.length() == 0 {
        typed(env, t_array(t_any()))
    } else {
        first = type_in(env, e.children.get(0))

        typed(unify_from(first.env, e.children, first.ty, 1, 1),
              t_array(first.ty))
    }
}

unify_from(env: Env, cs: Expr[], want: Ty, i: int, step: int) -> Env {
    if i >= cs.length() {
        env
    } else {
        got = type_in(env, cs.get(i))

        unify_from(joined(got.env, want, got.ty), cs, want, i + step, step)
    }
}

check_fn_in(env: Env, s: Stmt) -> Env {
    inner = bind_params(env, s.params, signature_params(env, s.name), 0)
    body = check_body(inner, s.body, 0, t_any())
    checked = return_check(body.env, s.ret, body.ty)

    checked with { names = env.names, types = env.types }
}

signature_params(env: Env, name: str) -> Ty[] {
    at = env.fns.index_of(name)

    if at < 0 {
        []
    } else {
        fn_params(env.sigs.get(at))
    }
}

bind_params(env: Env, ps: Expr[], tys: Ty[], i: int) -> Env {
    if i >= ps.length() {
        env
    } else if i < tys.length() {
        bind_params(bind(env, ps.get(i).text, tys.get(i)), ps, tys, i + 1)
    } else {
        got = declared_type(env, ps.get(i).ty)

        bind_params(bind(got.env, ps.get(i).text, got.ty), ps, tys, i + 1)
    }
}

check_body(env: Env, stmts: Stmt[], i: int, last: Ty) -> Typed {
    if i >= stmts.length() {
        typed(env, last)
    } else {
        st = stmts.get(i)
        got = stmt_type(env, st, i == stmts.length() - 1)

        check_body(extend(got.env, st, got.ty), stmts, i + 1, got.ty)
    }
}

stmt_type(env: Env, s: Stmt, is_last: bool) -> Typed {
    if is_last || s.kind != SExpr || s.value.kind != EIf {
        type_in(env, s.value)
    } else {
        typed(walk_args(env, s.value.children, 0), t_unit())
    }
}

extend(env: Env, s: Stmt, ty: Ty) -> Env {
    if s.kind != SBind {
        env
    } else if s.ret != "" {
        bind(env, s.name, ty_named(s.ret))
    } else {
        bind(env, s.name, ty)
    }
}

return_check(env: Env, declared: str, actual: Ty) -> Env {
    if declared == "" {
        env
    } else {
        joined(env, ty_named(declared), actual)
    }
}

checked_module(m: Module) -> Env {
    start = env_of_module(m)
    inferred = check_items(start, m.items, 0)

    check_items(with_infer(start, inferred.infer), m.items, 0)
}

check_module(m: Module) -> int =>
    checked_module(m).errors.length()

check_items(env: Env, items: Stmt[], i: int) -> Env {
    if i >= items.length() {
        env
    } else {
        check_items(check_item(env, items.get(i)), items, i + 1)
    }
}

check_item(env: Env, s: Stmt) -> Env {
    if s.kind == SFn {
        check_fn_in(env, s)
    } else {
        env
    }
}

check_errors(m: Module) -> str[] =>
    checked_module(m).errors ++ clashing_names(m.items, 0, [], [])

/// Imports flatten into one module, so two packages defining one name is a clash, not a shadow.
clashing_names(items: Stmt[], i: int, seen: str[], acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind != SFn {
        clashing_names(items, i + 1, seen, acc)
    } else if seen.index_of(items.get(i).name) >= 0 {
        clashing_names(items, i + 1, seen,
                       acc ++ [clash_of(items.get(i).name)])
    } else {
        clashing_names(items, i + 1, seen ++ [items.get(i).name], acc)
    }
}

clash_of(name: str) -> str =>
    "`{name}` is defined twice; imports share one namespace, so two"
        ++ " packages cannot both name a function this"

surface_of(t: Ty) -> str =>
    match t.kind {
        KInt   => "int"
        KFloat => "float"
        KStr   => "str"
        KBool  => "bool"
        KBytes => "bytes"
        KCon   => con_surface(t)
        KFn    => fn_surface(t)
        KOpt   => surface_of(t.args.get(0))
        _      => ""
    }

con_surface(t: Ty) -> str {
    if t.name == "Array" && t.args.length() == 1 {
        surface_of(t.args.get(0)) ++ "[]"
    } else {
        t.name
    }
}

fn_surface(t: Ty) -> str =>
    "({surface_joined(fn_params(t), 0)}) -> {surface_of(fn_ret(t))}"

surface_joined(ts: Ty[], i: int) -> str {
    if i >= ts.length() {
        ""
    } else if i == ts.length() - 1 {
        surface_of(ts.get(i))
    } else {
        surface_of(ts.get(i)) ++ ", " ++ surface_joined(ts, i + 1)
    }
}

annotated(m: Module) -> Module =>
    Module { items = annotate_items(checked_module(m), m.items, 0, []),
             errors = m.errors }

annotate_items(env: Env, items: Stmt[], i: int, acc: Stmt[]) -> Stmt[] {
    if i >= items.length() {
        acc
    } else {
        annotate_items(env, items, i + 1,
                       acc ++ [annotate_item(env, items.get(i))])
    }
}

annotate_item(env: Env, s: Stmt) -> Stmt {
    if s.kind != SFn {
        s
    } else {
        tys = signature_params(env, s.name)
        inner = bind_params(env, s.params, tys, 0)

        s with { ret = erased_ret(s.ret),
                 params = annotate_params(env.infer, s.params, tys, 0),
                 body = annotate_body(inner, s.body, 0, []) }
    }
}

erased_ret(ret: str) -> str {
    if ty_named(ret).kind == KAny {
        ""
    } else {
        ret
    }
}

annotate_params(inf: Infer, ps: Expr[], tys: Ty[], i: int) -> Expr[] {
    if i >= ps.length() {
        []
    } else {
        [annotate_param(inf, ps.get(i), tys, i)]
            ++ annotate_params(inf, ps, tys, i + 1)
    }
}

annotate_param(inf: Infer, p: Expr, tys: Ty[], i: int) -> Expr {
    if i >= tys.length() {
        p
    } else {
        p with { ty = surface_of(grounded(inf, tys.get(i))) }
    }
}

grounded(inf: Infer, t: Ty) -> Ty {
    seen = resolve(inf, t)

    seen with { args = grounded_all(inf, seen.args, 0) }
}

grounded_all(inf: Infer, ts: Ty[], i: int) -> Ty[] {
    if i >= ts.length() {
        []
    } else {
        [grounded(inf, ts.get(i))] ++ grounded_all(inf, ts, i + 1)
    }
}

annotate_body(env: Env, stmts: Stmt[], i: int, acc: Stmt[]) -> Stmt[] {
    if i >= stmts.length() {
        acc
    } else {
        st = reassigned(env, stmts.get(i))
        got = type_in(env, st.value)
        marked = st with { value = annotate_expr(env, st.value) }

        annotate_body(extend(got.env, st, got.ty), stmts, i + 1,
                      acc ++ [marked])
    }
}

reassigned(env: Env, s: Stmt) -> Stmt {
    if s.kind == SBind && env.names.index_of(s.name) >= 0 {
        s with { kind = SSet }
    } else {
        s
    }
}

annotate_expr(env: Env, e: Expr) -> Expr {
    if is_element_call(env, e) {
        annotate_expr(env, lowered_element(env, e))
    } else if is_rest_call(env, e) {
        annotated_node(env, gathered_rest(env, e))
    } else {
        annotated_node(env, e)
    }
}

is_rest_call(env: Env, e: Expr) -> bool =>
    e.kind == ECall && env.varargs.index_of(e.text) >= 0

/// Every argument past the fixed ones becomes the one list the callee declared.
gathered_rest(env: Env, e: Expr) -> Expr {
    at = fixed_arity(env, e.text)

    e with { children = e.children.slice(0, at)
                        ++ [e_list(e.children.slice(at, e.children.length()))] }
}

fixed_arity(env: Env, name: str) -> int =>
    fn_params(env.sigs.get(env.fns.index_of(name))).length() - 1

annotated_node(env: Env, e: Expr) -> Expr {
    inner = check_body(env, e.stmts, 0, t_any())

    e with { ty = surface_of(type_in(env, e).ty),
             stmts = annotate_body(looped(env, e), e.stmts, 0, []),
             children = annotate_children(inner.env, e.children, 0, []) }
}

is_element_call(env: Env, e: Expr) -> bool =>
    e.kind == ECall && is_element_tag(e.text) && !is_prelude_call(e.text)
        && env.fns.index_of(e.text) < 0 && env.ctors.index_of(e.text) < 0
        && env.names.index_of(e.text) < 0

lowered_element(env: Env, e: Expr) -> Expr =>
    e_call("maca_element",
           [e_str(e.text), element_attrs(env, e.children, 0, e_str("")),
            element_kids(env, e.children, 0, e_str(""))])

element_attrs(env: Env, cs: Expr[], i: int, acc: Expr) -> Expr {
    if i >= cs.length() {
        acc
    } else if cs.get(i).kind != EAttr {
        element_attrs(env, cs, i + 1, acc)
    } else {
        element_attrs(env, cs, i + 1,
                      e_binary("++", acc, one_attribute(env, cs.get(i))))
    }
}

one_attribute(env: Env, a: Expr) -> Expr {
    value = a.children.get(0)

    if resolve(env.infer, type_in(env, value).ty).kind == KBool {
        e_call("maca_flag", [e_str(a.text), value])
    } else {
        e_call("maca_attr", [e_str(a.text), as_html_text(env, value)])
    }
}

element_kids(env: Env, cs: Expr[], i: int, acc: Expr) -> Expr {
    if i >= cs.length() {
        acc
    } else if cs.get(i).kind == EAttr {
        element_kids(env, cs, i + 1, acc)
    } else {
        element_kids(env, cs, i + 1,
                     e_binary("++", acc, as_html_text(env, cs.get(i))))
    }
}

as_html_text(env: Env, v: Expr) -> Expr {
    t = resolve(env.infer, type_in(env, v).ty)

    if t.kind == KStr {
        v
    } else if is_str_list(env.infer, t) {
        e_method(v, "join", [e_str("")])
    } else {
        e_call("str", [v])
    }
}

is_str_list(inf: Infer, t: Ty) -> bool =>
    t.kind == KCon && t.name == "Array" && t.args.length() == 1
        && resolve(inf, t.args.get(0)).kind == KStr

looped(env: Env, e: Expr) -> Env {
    if e.kind != EFor || e.children.length() == 0 {
        env
    } else {
        over = type_in(env, e.children.get(0))

        bind(over.env, e.text, element_of(resolve(over.env.infer, over.ty)))
    }
}

annotate_children(env: Env, cs: Expr[], i: int, acc: Expr[]) -> Expr[] {
    if i >= cs.length() {
        acc
    } else {
        annotate_children(env, cs, i + 1,
                          acc ++ [annotate_expr(env, cs.get(i))])
    }
}

type_of(e: Expr) -> str =>
    show_ty(type_in(empty_env(), e).ty)

count_errors(e: Expr) -> int =>
    type_in(empty_env(), e).env.errors.length()
