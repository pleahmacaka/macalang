import maca/token
import maca/ast
import maca/ty
import maca/lexer

/// One defect: the code that names it forever, what is wrong here, and where.
Diagnostic = {
    code:    str
    message: str
    note:    str
    pos:     int
}

Env = {
    names:  str[]
    types:  Ty[]
    fns:    str[]
    sigs:   Ty[]
    fields: str[]
    ftypes: Ty[]
    ctors:  str[]
    owners: str[]
    slots:  str[]
    varargs: str[]
    frozen: str[]
    errors: Diagnostic[]
    infer:  Infer
    holes:  int[]
    fills:  Ty[]
    here:   int
}

empty_env() -> Env =>
    Env { names = [], types = [], fns = [], sigs = [],
          fields = [], ftypes = [], ctors = [], owners = [], slots = [],
          varargs = [], frozen = [], infer = new_infer(), errors = [],
          holes = [], fills = [], here = 0 }

/// What a code means in general, apart from the occurrence that raised it.
diag_explain(code: str) -> str =>
    match code {
        "M0001" => "a value is used where a different type is required"
        "M0002" => "a `match` leaves a variant unhandled"
        "M0003" => "config mode has no effects, and this call performs one"
        "M0004" => "the option this sets does not exist"
        "M0005" => "a constant is assigned after it is bound"
        "M0006" => "this name is not defined anywhere in scope"
        "M0007" => "the target being built for cannot carry this effect"
        "M0008" => "a file the program embeds is not beside it"
        _       => ""
    }

diag_message(d: Diagnostic) -> str =>
    d.message

/// A defect a whole statement is answerable for, placed where that statement starts.
diag_at(s: Stmt, code: str, why: str) -> Diagnostic =>
    Diagnostic { code, message = why, note = "", pos = s.pos }

Typed = {
    env: Env
    ty:  Ty
}

typed(env: Env, ty: Ty) -> Typed =>
    Typed { env, ty }

Signature = {
    env: Env
    tys: Ty[]
}

bind(env: Env, name: str, ty: Ty) -> Env =>
    env with { names = env.names ++ [name], types = env.types ++ [ty] }

complain(env: Env, why: str) -> Env =>
    complain_as(env, "M0001", why)

/// A defect the checker can name exactly carries its own code, so a tool branches on it.
complain_as(env: Env, code: str, why: str) -> Env {
    said = Diagnostic { code, message = why, note = "", pos = env.here }

    env with { errors = env.errors ++ [said] }
}

note(env: Env, why: str) -> Env {
    if why == "" {
        env
    } else {
        complain(env, why)
    }
}

with_infer(env: Env, inf: Infer) -> Env =>
    env with { infer = inf }

joined(env: Env, want: Ty, got: Ty) -> Env {
    step = unify(env.infer, want, got)

    note(with_infer(env, step.infer), step.error)
}

is_array_name(name: str) -> bool =>
    name.length() > 2 && name.slice(name.length() - 2, name.length()) == "[]"

ty_named(name: str) -> Ty {
    if name == "" {
        t_any()
    } else if name.index_of(") -> ") >= 0 {
        ty_fn_named(name)
    } else if is_array_name(name) {
        t_array(ty_named(name.slice(0, name.length() - 2)))
    } else if name == "int" {
        t_int()
    } else if name == "float" {
        t_float()
    } else if name == "str" || name == "Element" {
        t_str()
    } else if name == "bool" {
        t_bool()
    } else if name == "bytes" {
        t_bytes()
    } else if is_type_var(name) {
        t_any()
    } else {
        t_con(name, [])
    }
}

/// A parameter declared `(int, str) -> bool` holds a function, so it unifies with one.
ty_fn_named(name: str) -> Ty {
    cut = name.index_of(") -> ")

    t_fn(fn_arg_tys(name.slice(1, cut), []),
         ty_named(name.slice(cut + 5, name.length())))
}

fn_arg_tys(list: str, acc: Ty[]) -> Ty[] {
    cut = list.index_of(", ")

    if list == "" {
        acc
    } else if cut < 0 {
        acc ++ [ty_named(list)]
    } else {
        fn_arg_tys(list.slice(cut + 2, list.length()),
                   acc ++ [ty_named(list.slice(0, cut))])
    }
}

is_type_var(name: str) -> bool {
    if name == "unit" || name.index_of("__") >= 0 {
        false
    } else if !starts_lower(name) {
        false
    } else {
        !sized_number(name)
    }
}

starts_lower(name: str) -> bool =>
    name.length() > 0 && name.at(0).is_alpha()
        && name.at(0).upper() != name.at(0)

sized_number(name: str) -> bool =>
    name.length() > 1 && name.at(1).is_ascii_digit()
        && (name.at(0) == "i" || name.at(0) == "u" || name.at(0) == "f")

declared_type(env: Env, decl: str) -> Typed {
    if decl != "" {
        typed(env, ty_named(decl))
    } else {
        made = fresh(env.infer)

        typed(with_infer(env, made.infer), made.ty)
    }
}

param_types(env: Env, ps: Expr[], i: int, acc: Ty[]) -> Signature {
    if i >= ps.length() {
        Signature { env, tys = acc }
    } else {
        got = declared_type(env, ps.get(i).ty)

        param_types(got.env, ps, i + 1, acc ++ [got.ty])
    }
}

env_of_module(m: Module) -> Env =>
    collect_items(empty_env(), m.items, 0)

collect_items(env: Env, items: Stmt[], i: int) -> Env {
    if i >= items.length() {
        env
    } else {
        collect_items(collect_item(env, items.get(i)), items, i + 1)
    }
}

collect_item(env: Env, s: Stmt) -> Env {
    if s.kind == SFn {
        add_fn(env, s)
    } else if s.kind == SRecord {
        add_fields(env, s.name, s.params, 0)
    } else if s.kind == SSum {
        add_ctors(env, s.name, s.params, 0)
    } else if s.kind == SBind {
        add_const(env, s)
    } else {
        env
    }
}

add_const(env: Env, s: Stmt) -> Env {
    got = type_in(env, s.value)
    held = if s.ret != "" { ty_named(s.ret) } else { got.ty }

    got.env with { names = got.env.names ++ [s.name],
                   types = got.env.types ++ [held] }
}

add_fn(env: Env, s: Stmt) -> Env {
    made = param_types(env, s.params, 0, [])
    back = declared_type(made.env, s.ret)

    back.env with { fns = back.env.fns ++ [s.name],
                    sigs = back.env.sigs ++ [t_fn(made.tys, back.ty)],
                    varargs = back.env.varargs ++ rest_taker(s) }
}

rest_before_the_end(ps: Expr[], i: int) -> bool {
    if i >= ps.length() - 1 {
        false
    } else if ps.get(i).ival == 1 {
        true
    } else {
        rest_before_the_end(ps, i + 1)
    }
}

rest_taker(s: Stmt) -> str[] {
    n = s.params.length()

    if n > 0 && s.params.get(n - 1).ival == 1 {
        [s.name]
    } else {
        []
    }
}

add_fields(env: Env, rec: str, fs: Expr[], i: int) -> Env {
    if i >= fs.length() {
        env
    } else {
        held = env with { fields = env.fields ++ [rec ++ "." ++ fs.get(i).text],
                          ftypes = env.ftypes ++ [ty_named(fs.get(i).ty)] }

        add_fields(held, rec, fs, i + 1)
    }
}

add_ctors(env: Env, sum: str, vs: Expr[], i: int) -> Env {
    if i >= vs.length() {
        env
    } else {
        held = env with { ctors = env.ctors ++ [vs.get(i).text],
                          owners = env.owners ++ [sum],
                          slots = env.slots ++ [slot_types(vs.get(i))] }

        add_ctors(held, sum, vs, i + 1)
    }
}

type_in(env: Env, e: Expr) -> Typed =>
    match e.kind {
        EInt     => typed(env, t_int())
        EFloat   => typed(env, t_float())
        EStr     => typed(env, t_str())
        EBool    => typed(env, t_bool())
        EIdent   => ident_type(env, e)
        ECall    => call_type(env, e)
        EBinary  => binop_type(env, e)
        ETernary => ternary_type(env, e)
        EIf      => ternary_type(env, e)
        EUnary   => unary_type(env, e)
        ERecord  => typed(check_literal(check_fields(env, e.text,
                                                     e.children, 0),
                                        e.text, e.children),
                          t_con(e.text, []))
        EWith    => with_type(env, e)
        EField   => field_type(env, e)
        EMethod  => method_type(env, e)
        EBlock   => block_type(env, e)
        EBad     => typed(complain(env, "no expression starts at "
                                        ++ "`{e.text}`"), t_error())
        EAttr    => type_in(env, e.children.get(0))
        EGuard   => typed(walk_args(env, e.children, 0), t_bool())
        EMatch   => match_type(env, e)
        EList    => list_type(env, e)
        EWhile   => while_type(env, e)
        EFor     => for_type(env, e)
        ELambda  => lambda_type(env, e)
        _        => typed(env, t_any())
    }

lambda_type(env: Env, e: Expr) -> Typed {
    ps = lambda_params(e)
    made = param_types(env, ps, 0, [])
    inner = bind_params(made.env, ps, made.tys, 0)
    body = type_in(inner, lambda_body(e))

    typed(body.env with { names = env.names, types = env.types },
          t_fn(made.tys, body.ty))
}

while_type(env: Env, e: Expr) -> Typed {
    cond = type_in(env, e.children.get(0))
    ready = joined(cond.env, t_bool(), cond.ty)
    inner = check_stmts(ready, e.stmts, 0)

    typed(inner with { names = env.names, types = env.types }, t_unit())
}

for_type(env: Env, e: Expr) -> Typed {
    over = type_in(env, e.children.get(0))
    el = element_of(resolve(over.env.infer, over.ty))
    inner = check_stmts(bind(over.env, e.text, el), e.stmts, 0)

    typed(inner with { names = env.names, types = env.types }, t_unit())
}

check_stmts(env: Env, stmts: Stmt[], i: int) -> Env {
    if i >= stmts.length() {
        env
    } else {
        st = stmts.get(i)
        got = stmt_type(env, st, false)

        check_stmts(extend(got.env, st, got.ty), stmts, i + 1)
    }
}

range_type(env: Env, a: Ty, b: Ty) -> Typed {
    lo = joined(env, t_int(), a)

    typed(joined(lo, t_int(), b), t_array(t_int()))
}

/// A shift moves bits, so both sides count them and neither may be a float.
shift_type(env: Env, a: Ty, b: Ty) -> Typed {
    value = joined(env, t_int(), a)

    typed(joined(value, t_int(), b), t_int())
}

unary_type(env: Env, e: Expr) -> Typed {
    inner = type_in(env, e.children.get(0))

    if e.text == "fail" {
        typed(inner.env, t_any())
    } else if e.text == "try" {
        typed(inner.env, t_str())
    } else if e.text == "spawn" {
        typed(inner.env, t_con("Future", []))
    } else if e.text == "await" {
        typed(inner.env, t_int())
    } else {
        inner
    }
}

ident_type(env: Env, e: Expr) -> Typed {
    at = env.names.index_of(e.text)
    variant = env.ctors.index_of(e.text)
    declared = env.fns.index_of(e.text)

    if at >= 0 {
        typed(env, env.types.get(at))
    } else if variant >= 0 {
        typed(env, t_con(env.owners.get(variant), []))
    } else if declared >= 0 && env.varargs.index_of(e.text) >= 0 {
        typed(complain(env, "`{e.text}` is variadic, so it cannot be used as a"
                            ++ " function value; call it, or declare it"
                            ++ " `{e.text}(xs: T[])` and pass a list"),
              t_error())
    } else if declared >= 0 {
        typed(env, env.sigs.get(declared))
    } else {
        typed(env, t_any())
    }
}

call_type(env: Env, e: Expr) -> Typed {
    declared = env.fns.index_of(e.text)
    variant = env.ctors.index_of(e.text)
    local = env.names.index_of(e.text)

    if e.text == "maca_cap" && e.children.length() == 2 {
        typed(env, ty_named(e.children.get(0).text))
    } else if e.text == "maca_closure" && e.children.length() > 0 {
        typed(walk_args(env, e.children, 0), closure_sig(env, e))
    } else if declared >= 0 && tag_wins(env, e, declared) {
        typed(walk_args(env, e.children, 0), builtin_type(e.text))
    } else if local >= 0 && callable(env, env.types.get(local)) {
        call_local(env, e, env.types.get(local))
    } else if declared >= 0 {
        call_declared(env, e, env.sigs.get(declared))
    } else if variant >= 0 {
        typed(walk_args(env, e.children, 0), t_con(env.owners.get(variant), []))
    } else if local >= 0 {
        call_local(env, e, env.types.get(local))
    } else {
        typed(unknown_call(walk_args(env, e.children, 0), e.text),
              builtin_type(e.text))
    }
}

/// A closure is worth exactly what the function it was lifted out of is worth.
closure_sig(env: Env, e: Expr) -> Ty {
    at = env.fns.index_of(e.children.get(0).text)

    at < 0 ? t_any() : env.sigs.get(at)
}

/// A lowercase call name that resolves to nothing is a function nobody wrote, not a foreign one.
unknown_call(env: Env, name: str) -> Env {
    if !starts_lower(name) || is_prelude_call(name) || is_element_tag(name) {
        env
    } else if is_host_builtin(name) {
        env
    } else {
        complain_as(env, "M0006", "call to undefined function `{name}`")
    }
}

is_host_builtin(name: str) -> bool =>
    name == "abs" || name == "min" || name == "max" || name == "clamp"
        || name == "input" || name == "read_stdin" || name == "at_eof"
        || name == "failures" || name == "alloc_count" || name == "reuse_count"
        || name == "map" || name == "data" || name == "stored"
        || name == "styles" || name == "list_dir"
        || is_register_builtin(name)

is_register_builtin(name: str) -> bool =>
    name == "mmio_write" || name == "mmio_read" || name == "set_bits"
        || name == "clear_bits" || name == "toggle_bits" || name == "bit"
        || name == "shl" || name == "shr" || name == "bit_or"
        || name == "bit_and" || name == "delay" || name == "nop"
        || name == "forever"

callable(env: Env, held: Ty) -> bool =>
    resolve(env.infer, held).kind == KFn
        || resolve(env.infer, held).kind == KVar

call_local(env: Env, e: Expr, held: Ty) -> Typed {
    made = arg_types(env, e.children, 0, [])
    res = fresh(made.env.infer)
    ready = with_infer(made.env, res.infer)

    typed(joined(ready, held, t_fn(made.tys, res.ty)), res.ty)
}

arg_types(env: Env, args: Expr[], i: int, acc: Ty[]) -> Signature {
    if i >= args.length() {
        Signature { env, tys = acc }
    } else {
        got = type_in(env, args.get(i))

        arg_types(got.env, args, i + 1, acc ++ [got.ty])
    }
}

call_declared(env: Env, e: Expr, sig: Ty) -> Typed {
    used = instantiate(env.infer, generalize(env.infer, sig))
    ready = with_infer(env, used.infer)
    params = fn_params(used.ty)

    if takes_rest(ready, e, params.length()) {
        typed(noted_shapes(unify_args(ready,
                                      e.children.slice(0,
                                                       params.length() - 1),
                                      params, 0),
                           sig.args, used.ty.args, 0),
              fn_ret(used.ty))
    } else if params.length() != e.children.length() {
        typed(wrong_arity(ready, e, params.length()), fn_ret(used.ty))
    } else {
        typed(noted_shapes(unify_args(ready, e.children, params, 0),
                           sig.args, used.ty.args, 0),
              fn_ret(used.ty))
    }
}

/// A call solves its own copy of a signature, so the shape it settled on is kept aside.
noted_shapes(env: Env, want: Ty[], got: Ty[], i: int) -> Env {
    if i >= want.length() || i >= got.length() {
        env
    } else {
        noted_shapes(noted_shape(env, want.get(i), got.get(i)), want, got,
                     i + 1)
    }
}

noted_shape(env: Env, want: Ty, got: Ty) -> Env {
    hole = resolve(env.infer, want)
    seen = grounded(env.infer, got)

    if hole.kind != KVar || seen.kind == KVar
            || env.holes.index_of(hole.slot) >= 0 {
        env
    } else {
        env with { holes = env.holes ++ [hole.slot],
                   fills = env.fills ++ [seen] }
    }
}

/// What a slot ended up being: what unification proved, or else what a call site used.
solved_ty(env: Env, t: Ty) -> Ty {
    seen = resolve(env.infer, t)
    at = seen.kind == KVar ? env.holes.index_of(seen.slot) : 0 - 1

    if at >= 0 {
        env.fills.get(at)
    } else {
        seen with { args = solved_all(env, seen.args, 0) }
    }
}

solved_all(env: Env, ts: Ty[], i: int) -> Ty[] {
    if i >= ts.length() {
        []
    } else {
        [solved_ty(env, ts.get(i))] ++ solved_all(env, ts, i + 1)
    }
}

takes_rest(env: Env, e: Expr, wanted: int) -> bool =>
    env.varargs.index_of(e.text) >= 0 && e.children.length() >= wanted - 1

wrong_arity(env: Env, e: Expr, wanted: int) -> Env {
    if env.varargs.index_of(e.text) >= 0 {
        complain(env, "`{e.text}` takes at least {wanted - 1} argument(s), "
                      ++ "given {e.children.length()}")
    } else {
        complain(env, "`{e.text}` takes {wanted} argument(s), given {e.children.length()}")
    }
}

unify_args(env: Env, args: Expr[], params: Ty[], i: int) -> Env {
    if i >= args.length() {
        env
    } else {
        got = type_in(env, args.get(i))

        unify_args(joined(got.env, params.get(i), got.ty), args, params, i + 1)
    }
}

walk_args(env: Env, args: Expr[], i: int) -> Env {
    if i >= args.length() {
        env
    } else {
        walk_args(type_in(env, args.get(i)).env, args, i + 1)
    }
}

builtin_type(name: str) -> Ty {
    if is_str_builtin(name) {
        t_str()
    } else if is_float_builtin(name) {
        t_float()
    } else if is_int_builtin(name) {
        t_int()
    } else if is_bool_builtin(name) {
        t_bool()
    } else if name == "list_dir" {
        t_array(t_str())
    } else if is_io_builtin(name) {
        t_unit()
    } else if is_element_tag(name) {
        t_str()
    } else {
        t_any()
    }
}

ElementTags = " html head title meta link style script body div span p pre code a button input textarea select option label form header footer main section article nav aside ul ol li table thead tbody tr td th h1 h2 h3 h4 h5 h6 img svg canvas small strong em b i hr br blockquote figure figcaption details summary dialog progress meter video audio "

/// `element` names its tag with its first argument; every other tag is its own name.
is_element_tag(name: str) -> bool =>
    name == "element" || ElementTags.index_of(" {name} ") >= 0

is_prelude_call(name: str) -> bool =>
    is_str_builtin(name) || is_float_builtin(name) || is_int_builtin(name)
        || is_bool_builtin(name) || is_io_builtin(name)

is_str_builtin(name: str) -> bool =>
    name == "str" || name == "chr" || name == "read_line" || name == "capture"
        || name == "capture_err" || name == "styles"
        || name == "read_file" || name == "env" || name == "cwd"
        || name == "real_path" || name == "now_iso" || name == "format_time"
        || name == "maca_attr" || name == "maca_flag"
        || name == "maca_element"

is_float_builtin(name: str) -> bool =>
    name == "float" || name == "sqrt" || name == "floor" || name == "ceil"
        || name == "round" || name == "pow" || name == "sin" || name == "cos"
        || name == "tan" || name == "log" || name == "exp"

is_int_builtin(name: str) -> bool =>
    name == "int" || name == "exec" || name == "len" || name == "ord"
        || name == "sign" || name == "gcd" || name == "now_ms"
        || name == "file_size" || name == "modified_ms"

is_bool_builtin(name: str) -> bool =>
    name == "assert" || name == "assert_eq"
        || name == "write_file" || name == "file_exists" || name == "make_dir"
        || name == "is_dir" || name == "remove_file" || name == "remove_dir"
        || name == "copy_bytes" || name == "chdir" || name == "is_tty"

is_io_builtin(name: str) -> bool =>
    name == "info" || name == "print" || name == "err" || name == "warn"
        || name == "debug" || name == "notice" || name == "crit"
        || name == "alert" || name == "emerg" || name == "panic"
        || name == "sleep_ms"

is_compare(op: str) -> bool =>
    op == "==" || op == "!=" || op == "<" || op == ">"
        || op == "<=" || op == ">="

is_logic(op: str) -> bool =>
    op == "&&" || op == "||"

is_shift(op: str) -> bool =>
    op == "<<" || op == ">>"

binop_type(env: Env, e: Expr) -> Typed {
    if e.text == "=" {
        type_in(env, e.children.get(1))
    } else {
        operator_type(env, e)
    }
}

operator_type(env: Env, e: Expr) -> Typed {
    lhs = type_in(env, e.children.get(0))
    rhs = type_in(lhs.env, e.children.get(1))

    if e.text == "++" || joins(rhs.env, e.text, lhs.ty, rhs.ty) {
        typed(rhs.env, concat_type(rhs.env, lhs.ty, rhs.ty))
    } else if e.text == ".." {
        range_type(rhs.env, lhs.ty, rhs.ty)
    } else if is_shift(e.text) {
        shift_type(rhs.env, lhs.ty, rhs.ty)
    } else if is_compare(e.text) {
        typed(joined(rhs.env, lhs.ty, rhs.ty), t_bool())
    } else if is_logic(e.text) {
        typed(rhs.env, t_bool())
    } else {
        arith_type(rhs.env, e.text, lhs.ty, rhs.ty)
    }
}

is_list(t: Ty) -> bool =>
    t.kind == KCon && t.name == "Array"

joins(env: Env, op: str, a: Ty, b: Ty) -> bool {
    left = resolve(env.infer, a)
    right = resolve(env.infer, b)

    op == "+" && ((left.kind == KStr && right.kind == KStr)
                      || (is_list(left) && is_list(right)))
}

concat_type(env: Env, a: Ty, b: Ty) -> Ty {
    left = resolve(env.infer, a)
    right = resolve(env.infer, b)

    if is_list(left) {
        left
    } else if is_list(right) {
        right
    } else {
        t_str()
    }
}

numeric(t: Ty) -> bool =>
    t.kind == KInt || t.kind == KFloat || t.kind == KVar || absorbing(t)

overload_name(op: str) -> str {
    if op == "+" {
        "add"
    } else if op == "-" {
        "sub"
    } else if op == "*" {
        "mul"
    } else if op == "/" {
        "div"
    } else {
        ""
    }
}

declares_field(env: Env, owner: str, i: int) -> bool {
    if i >= env.fields.length() {
        false
    } else if env.fields.get(i).index_of(owner ++ ".") == 0 {
        true
    } else {
        declares_field(env, owner, i + 1)
    }
}

is_nominal(env: Env, t: Ty) -> bool =>
    t.kind == KCon && t.name != "Array"
        && (env.owners.index_of(t.name) >= 0 || declares_field(env, t.name, 0))

overload_at(env: Env, op: str, left: Ty) -> int {
    if overload_name(op) == "" || !is_nominal(env, left) {
        0 - 1
    } else {
        env.fns.index_of(overload_name(op))
    }
}

arith_type(env: Env, op: str, a: Ty, b: Ty) -> Typed {
    at = overload_at(env, op, resolve(env.infer, a))

    if at >= 0 {
        typed(env, fn_ret(env.sigs.get(at)))
    } else if op == "/" && resolve(env.infer, a).kind == KStr {
        typed(env, t_str())
    } else {
        numeric_type(env, a, b)
    }
}

numeric_type(env: Env, a: Ty, b: Ty) -> Typed {
    step = unify(env.infer, a, b)
    ready = with_infer(env, step.infer)
    left = resolve(step.infer, a)
    right = resolve(step.infer, b)

    if step.error != "" {
        typed(complain(ready, step.error), t_error())
    } else if left.kind == KFloat || right.kind == KFloat {
        typed(ready, t_float())
    } else if numeric(left) {
        typed(ready, t_int())
    } else if left.kind == KCon {
        typed(ready, left)
    } else {
        typed(complain(ready, "{show_ty(left)} is not a number"), t_error())
    }
}

ternary_type(env: Env, e: Expr) -> Typed {
    cond = type_in(env, e.children.get(0))
    then = type_in(cond.env, e.children.get(1))
    other = type_in(then.env, e.children.get(2))

    typed(joined(other.env, then.ty, other.ty), then.ty)
}

block_type(env: Env, e: Expr) -> Typed {
    inner = check_body(env, e.stmts, 0, t_any())
    last = type_in(inner.env, e.children.get(0))

    typed(last.env with { names = env.names, types = env.types }, last.ty)
}

method_type(env: Env, e: Expr) -> Typed {
    recv = type_in(env, e.children.get(0))

    if (e.text == "map" || e.text == "parallel") && e.children.length() == 2 {
        mapped_type(recv.env, resolve(recv.env.infer, recv.ty),
                    e.children.get(1))
    } else if e.text == "filter" && e.children.length() == 2 {
        sifted_type(recv.env, resolve(recv.env.infer, recv.ty),
                    e.children.get(1))
    } else if field_fn_ty(env, resolve(recv.env.infer, recv.ty),
                          e.text).kind == KFn {
        typed(walk_args(recv.env, e.children, 1),
              fn_ret(field_fn_ty(env, resolve(recv.env.infer, recv.ty),
                                 e.text)))
    } else if is_ufcs_call(env, e, resolve(recv.env.infer, recv.ty)) {
        call_type(env, e_call(e.text, e.children))
    } else {
        walked = walk_args(recv.env, e.children, 1)

        typed(walked, method_result(e.text, resolve(walked.infer, recv.ty)))
    }
}

/// The type of a record's field, when the receiver is a record that names one.
field_fn_ty(env: Env, recv: Ty, name: str) -> Ty {
    at = env.fields.index_of(recv.name ++ "." ++ name)

    if recv.kind != KCon || at < 0 {
        t_any()
    } else {
        env.ftypes.get(at)
    }
}

/// `x.f(y)` is `f(x, y)` when no method answers to the name and the module declares one.
is_ufcs_call(env: Env, e: Expr, recv: Ty) -> bool =>
    env.fns.index_of(e.text) >= 0
        && (method_result(e.text, recv).kind == KAny || own_method(recv))

/// A named type of the module's own answers to its functions, not to list methods.
own_method(t: Ty) -> bool =>
    t.kind == KRec || (t.kind == KCon && t.name != "Array" && !is_map_ty(t))

mapped_type(env: Env, recv: Ty, f: Expr) -> Typed {
    got = type_in(env, f)
    res = fresh(got.env.infer)
    ready = joined(with_infer(got.env, res.infer), got.ty,
                   t_fn([element_of(recv)], res.ty))

    typed(ready, t_array(resolve(ready.infer, res.ty)))
}

sifted_type(env: Env, recv: Ty, f: Expr) -> Typed {
    got = type_in(env, f)
    ready = joined(got.env, got.ty, t_fn([element_of(recv)], t_bool()))

    typed(ready, recv)
}

method_result(name: str, recv: Ty) -> Ty {
    if is_map_ty(recv) {
        map_method_result(name, recv)
    } else if name == "length" || name == "count" || name == "index_of" {
        t_int()
    } else if name == "at" {
        element_of(recv)
    } else if name == "join" {
        t_str()
    } else if name == "chars" {
        t_array(t_str())
    } else if name == "slice" || name == "push" {
        recv
    } else if name == "get" {
        element_of(recv)
    } else if is_reshaping_method(name) {
        recv
    } else if is_picking_method(name) {
        element_of(recv)
    } else if is_text_method(name) {
        t_str()
    } else if name == "split" {
        t_array(t_str())
    } else if is_asking_method(name) {
        t_bool()
    } else {
        t_any()
    }
}

is_map_ty(t: Ty) -> bool =>
    t.kind == KCon && map_type_val(t.name) != ""

/// A map answers with the types it was declared over, not with its own.
map_method_result(name: str, recv: Ty) -> Ty {
    if name == "get" {
        ty_named(map_type_val(recv.name))
    } else if name == "keys" {
        t_array(ty_named(map_type_key(recv.name)))
    } else if name == "values" {
        t_array(ty_named(map_type_val(recv.name)))
    } else if name == "has" || name == "contains" {
        t_bool()
    } else if name == "length" || name == "count" {
        t_int()
    } else {
        recv
    }
}

is_reshaping_method(name: str) -> bool =>
    name == "pop" || name == "reverse" || name == "sort" || name == "set"
        || name == "insert" || name == "remove"

is_picking_method(name: str) -> bool =>
    name == "sum" || name == "min" || name == "max" || name == "first"
        || name == "last"

is_text_method(name: str) -> bool =>
    name == "trim" || name == "lower" || name == "upper"
        || name == "replace" || name == "repeat" || name == "substr"
        || name == "pad_start" || name == "pad_end" || name == "fixed"
        || name == "pad_center"

is_asking_method(name: str) -> bool =>
    name == "starts_with" || name == "ends_with" || name == "contains"
        || name == "is_whitespace" || name == "is_ascii_digit"
        || name == "is_alpha"

element_of(t: Ty) -> Ty {
    if t.kind == KStr {
        t_str()
    } else if t.kind == KCon && t.name == "Array" && t.args.length() == 1 {
        t.args.get(0)
    } else {
        t_any()
    }
}

with_type(env: Env, e: Expr) -> Typed {
    base = type_in(env, e.children.get(0))
    owner = resolve(base.env.infer, base.ty)

    typed(check_fields(base.env, owner.name, e.children, 1), base.ty)
}

check_fields(env: Env, rec: str, fs: Expr[], i: int) -> Env {
    if i >= fs.length() {
        env
    } else {
        check_fields(field_set(env, rec, fs.get(i)), rec, fs, i + 1)
    }
}

field_set(env: Env, rec: str, f: Expr) -> Env {
    at = env.fields.index_of(rec ++ "." ++ f.children.get(0).text)
    got = type_in(env, f)

    if at < 0 {
        got.env
    } else {
        joined(got.env, env.ftypes.get(at), got.ty)
    }
}

/// A record literal names every field the record declares, and no field it does not.
check_literal(env: Env, rec: str, fs: Expr[]) -> Env {
    if !declares_field(env, rec, 0) {
        env
    } else {
        unknown_fields(missing_fields(env, rec, fs), rec, fs, 0)
    }
}

missing_fields(env: Env, rec: str, fs: Expr[]) -> Env {
    absent = absent_fields(env, rec, fs, 0, [])
    named = absent.sort().join(", ")

    if absent.length() == 0 {
        env
    } else {
        complain(env, "`{rec}` is missing field(s): {named}")
    }
}

absent_fields(env: Env, rec: str, fs: Expr[], i: int, acc: str[]) -> str[] {
    if i >= env.fields.length() {
        acc
    } else if env.fields.get(i).index_of(rec ++ ".") != 0
            || names_field(fs, field_tail(env.fields.get(i), rec), 0) {
        absent_fields(env, rec, fs, i + 1, acc)
    } else {
        absent_fields(env, rec, fs, i + 1,
                      acc ++ [field_tail(env.fields.get(i), rec)])
    }
}

field_tail(key: str, rec: str) -> str =>
    key.slice(rec.length() + 1, key.length())

names_field(fs: Expr[], name: str, i: int) -> bool {
    if i >= fs.length() {
        false
    } else {
        lit_field_name(fs.get(i)) == name || names_field(fs, name, i + 1)
    }
}

lit_field_name(f: Expr) -> str =>
    f.children.get(0).text

unknown_fields(env: Env, rec: str, fs: Expr[], i: int) -> Env {
    if i >= fs.length() {
        env
    } else if env.fields.index_of(rec ++ "." ++ lit_field_name(fs.get(i))) >= 0 {
        unknown_fields(env, rec, fs, i + 1)
    } else {
        told = lit_field_name(fs.get(i))

        unknown_fields(complain(env, "`{rec}` has no field `{told}`"),
                       rec, fs, i + 1)
    }
}

field_type(env: Env, e: Expr) -> Typed {
    base = type_in(env, e.children.get(0))
    owner = resolve(base.env.infer, base.ty)
    at = env.fields.index_of(owner.name ++ "." ++ e.text)

    if at < 0 {
        typed(base.env, t_any())
    } else {
        typed(base.env, env.ftypes.get(at))
    }
}

/// The payload types a variant carries, joined, so one list can hold them beside the name.
slot_types(v: Expr) -> str =>
    v.children.map(binder_type).join(",")

binder_type(b: Expr) -> str =>
    b.ty

match_type(env: Env, e: Expr) -> Typed {
    if e.children.length() < 3 {
        typed(walk_args(env, e.children, 0), t_any())
    } else {
        seen = type_in(env, e.children.get(0))
        first = type_in(bound_arm(seen.env, e.children.get(1)),
                        e.children.get(2))
        whole = unify_arms(first.env, e.children, first.ty, 3)

        typed(check_arms(whole, e, resolve(whole.infer, seen.ty)), first.ty)
    }
}

/// A match on a sum names every variant of it, unless an arm catches everything.
check_arms(env: Env, e: Expr, scrut: Ty) -> Env {
    if scrut.kind != KCon || env.owners.index_of(scrut.name) < 0
            || catches_all(env, e, 1) {
        env
    } else {
        left = uncovered(env, e, scrut.name, 0, [])
        named = left.join(", ")

        if left.length() == 0 {
            env
        } else {
            complain_as(env, "M0002",
                "match on `{scrut.name}` is not exhaustive; missing: {named}")
        }
    }
}

catches_all(env: Env, e: Expr, i: int) -> bool {
    if i + 1 >= e.children.length() {
        false
    } else {
        wide_arm(env, e.children.get(i)) || catches_all(env, e, i + 2)
    }
}

/// `_` catches everything, and so does a name the sum does not declare.
wide_arm(env: Env, p: Expr) -> bool {
    if p.kind == EGuard {
        false
    } else if p.kind == EBinary && p.text == "|" {
        wide_arm(env, p.children.get(0)) || wide_arm(env, p.children.get(1))
    } else if p.kind != EIdent || p.children.length() > 0 {
        false
    } else {
        p.text == "_" || (starts_lower(p.text) && env.ctors.index_of(p.text) < 0)
    }
}

uncovered(env: Env, e: Expr, sum: str, i: int, acc: str[]) -> str[] {
    if i >= env.ctors.length() {
        acc
    } else if env.owners.get(i) != sum || arm_names(e, env.ctors.get(i), 1) {
        uncovered(env, e, sum, i + 1, acc)
    } else {
        uncovered(env, e, sum, i + 1, acc ++ [env.ctors.get(i)])
    }
}

arm_names(e: Expr, ctor: str, i: int) -> bool {
    if i + 1 >= e.children.length() {
        false
    } else {
        pat_names(e.children.get(i), ctor) || arm_names(e, ctor, i + 2)
    }
}

pat_names(p: Expr, ctor: str) -> bool {
    if p.kind == EGuard {
        false
    } else if p.kind == EBinary && p.text == "|" {
        pat_names(p.children.get(0), ctor) || pat_names(p.children.get(1), ctor)
    } else {
        p.kind == EIdent && p.text == ctor
    }
}

unify_arms(env: Env, cs: Expr[], want: Ty, i: int) -> Env {
    if i + 1 >= cs.length() {
        env
    } else {
        got = type_in(bound_arm(env, cs.get(i)), cs.get(i + 1))

        unify_arms(joined(got.env, want, got.ty), cs, want, i + 2)
    }
}

/// `C(r)` binds `r` to what the variant declared it carries, so the arm reads it as that.
bound_arm(env: Env, pat: Expr) -> Env {
    if pat.kind == EGuard {
        bound_arm(env, pat.children.get(0))
    } else if pat.kind == EBinary && pat.text == "|" {
        bound_arm(bound_arm(env, pat.children.get(0)), pat.children.get(1))
    } else if pat.children.length() == 0 {
        named_pattern(env, pat)
    } else {
        at = env.ctors.index_of(pat.text)

        if at < 0 {
            env
        } else {
            bind_slots_of(env, pat.children, env.slots.get(at).split(","), 0)
        }
    }
}

/// A capitalised pattern names a constructor, so one nothing declares is a misspelling and never a binder.
named_pattern(env: Env, pat: Expr) -> Env {
    if pat.kind != EIdent || !starts_upper(pat.text) {
        env
    } else if env.ctors.index_of(pat.text) >= 0 {
        env
    } else {
        complain_as(env, "M0006",
                    "`{pat.text}` is capitalized, so it is a constructor,"
                        ++ " and nothing declares one by that name:"
                        ++ " {ctor_hint(env, pat.text)}")
    }
}

starts_upper(name: str) -> bool =>
    name.length() > 0 && name.at(0).is_alpha() && !starts_lower(name)

ctor_hint(env: Env, name: str) -> str {
    near = nearest_ctor(name, env.ctors, 0, "", hint_span(name))

    near == ""
        ? "a pattern that binds what it matched is lowercase"
        : "did you mean `{near}`?"
}

hint_span(name: str) -> int {
    if name.length() <= 3 {
        2
    } else if name.length() <= 7 {
        3
    } else {
        4
    }
}

nearest_ctor(want: str, names: str[], i: int, found: str, best: int) -> str {
    if i >= names.length() {
        found
    } else {
        apart = edits_apart(want, names.get(i), best)

        apart < best
            ? nearest_ctor(want, names, i + 1, names.get(i), apart)
            : nearest_ctor(want, names, i + 1, found, best)
    }
}

/// Levenshtein distance, stopped at `cap`, because a hint only needs the near ones.
edits_apart(a: str, b: str, cap: int) -> int {
    if a.length() > b.length() + cap || b.length() > a.length() + cap {
        cap
    } else {
        edit_rows(a, b, edit_row(b.length() + 1, 0, []), 0)
    }
}

edit_rows(a: str, b: str, prev: int[], i: int) -> int {
    if i >= a.length() {
        prev.get(b.length())
    } else {
        edit_rows(a, b, edit_cells(a, b, prev, [i + 1], i, 0), i + 1)
    }
}

edit_cells(a: str, b: str, prev: int[], cur: int[], i: int, j: int) -> int[] {
    if j >= b.length() {
        cur
    } else {
        cost = a.at(i) == b.at(j) ? 0 : 1
        best = least_of(prev.get(j) + cost, prev.get(j + 1) + 1,
                        cur.get(j) + 1)

        edit_cells(a, b, prev, cur ++ [best], i, j + 1)
    }
}

edit_row(n: int, at: int, acc: int[]) -> int[] =>
    at >= n ? acc : edit_row(n, at + 1, acc ++ [at])

least_of(a: int, b: int, c: int) -> int {
    m = a < b ? a : b

    m < c ? m : c
}

/// A comma pattern matches a list by position, so a named cell holds an element.
bound_cells(env: Env, pat: Expr, el: Ty) -> Env {
    if pat.kind == EGuard {
        bound_cells(env, pat.children.get(0), el)
    } else if pat.kind == EIdent && (pat.text == "[]" || pat.text == "[..]") {
        bind_cell_names(env, pat, el, 0)
    } else {
        env
    }
}

bind_cell_names(env: Env, pat: Expr, el: Ty, i: int) -> Env {
    if i >= pat.children.length() {
        env
    } else if pat.children.get(i).kind != EIdent {
        bind_cell_names(env, pat, el, i + 1)
    } else if pat.text == "[..]" && i == pat.children.length() - 1 {
        bind(env, pat.children.get(i).text, t_array(el))
    } else {
        bind_cell_names(bind(env, pat.children.get(i).text, el),
                        pat, el, i + 1)
    }
}

bind_slots_of(env: Env, bs: Expr[], tys: str[], i: int) -> Env {
    if i >= bs.length() || i >= tys.length() {
        env
    } else {
        bind_slots_of(bind(env, bs.get(i).text, ty_named(tys.get(i))),
                      bs, tys, i + 1)
    }
}

list_type(env: Env, e: Expr) -> Typed {
    if e.children.length() == 0 {
        typed(env, t_array(t_any()))
    } else {
        first = type_in(env, e.children.get(0))

        typed(unify_from(first.env, e.children, first.ty, 1, 1),
              t_array(first.ty))
    }
}

unify_from(env: Env, cs: Expr[], want: Ty, i: int, step: int) -> Env {
    if i >= cs.length() {
        env
    } else {
        got = type_in(env, cs.get(i))

        unify_from(joined(got.env, want, got.ty), cs, want, i + step, step)
    }
}

check_fn_in(env: Env, s: Stmt) -> Env {
    inner = bind_params(env, s.params, signature_params(env, s.name), 0)
    body = check_body(inner, s.body, 0, t_any())
    told = s.ret == "" && s.body.length() > 0
        ? joined(body.env, signature_ret(env, s.name), body.ty)
        : body.env
    checked = return_check(told, s.ret, body.ty)

    checked with { names = env.names, types = env.types,
                   frozen = env.frozen }
}

signature_ret(env: Env, name: str) -> Ty {
    at = env.fns.index_of(name)

    if at < 0 {
        t_any()
    } else {
        fn_ret(env.sigs.get(at))
    }
}

signature_params(env: Env, name: str) -> Ty[] {
    at = env.fns.index_of(name)

    if at < 0 {
        []
    } else {
        fn_params(env.sigs.get(at))
    }
}

bind_params(env: Env, ps: Expr[], tys: Ty[], i: int) -> Env {
    if i >= ps.length() {
        env
    } else if i < tys.length() {
        bind_params(bind(env, ps.get(i).text, tys.get(i)), ps, tys, i + 1)
    } else {
        got = declared_type(env, ps.get(i).ty)

        bind_params(bind(got.env, ps.get(i).text, got.ty), ps, tys, i + 1)
    }
}

check_body(env: Env, stmts: Stmt[], i: int, last: Ty) -> Typed {
    if i >= stmts.length() {
        typed(env, last)
    } else {
        st = stmts.get(i)
        got = stmt_type(env, st, i == stmts.length() - 1)

        check_body(extend(got.env, st, got.ty), stmts, i + 1, got.ty)
    }
}

stmt_type(env: Env, s: Stmt, is_last: bool) -> Typed {
    if is_last || s.kind != SExpr || !branches_for_effect(s.value) {
        type_in(env, s.value)
    } else {
        typed(effect_walk(env, s.value), t_unit())
    }
}

branches_for_effect(e: Expr) -> bool =>
    e.kind == EIf || e.kind == EMatch

/// A branch run for its effect answers nothing, so its branches need not agree.
effect_walk(env: Env, e: Expr) -> Env {
    if e.kind == EIf {
        cond = type_in(env, e.children.get(0))

        effect_walk(effect_walk(cond.env, e.children.get(1)),
                    e.children.get(2))
    } else if e.kind == EMatch && e.children.length() >= 3 {
        seen = type_in(env, e.children.get(0))

        effect_arms(seen.env, e.children, 1)
    } else if e.kind == EBlock {
        inner = check_body(env, e.stmts, 0, t_any())
        after = effect_walk(inner.env, e.children.get(0))

        after with { names = env.names, types = env.types }
    } else {
        type_in(env, e).env
    }
}

effect_arms(env: Env, cs: Expr[], i: int) -> Env {
    if i + 1 >= cs.length() {
        env
    } else {
        effect_arms(effect_walk(bound_arm(env, cs.get(i)), cs.get(i + 1)),
                    cs, i + 2)
    }
}

extend(env: Env, s: Stmt, ty: Ty) -> Env {
    if s.kind != SBind {
        env
    } else if env.frozen.index_of(s.name) >= 0 {
        complain_as(env, "M0005", "cannot reassign constant `{s.name}`;"
                                      ++ " declare it mutable with"
                                      ++ " `{s.name} = …` (no `const`)")
    } else if s.ret != "" {
        sealed(bind(joined(env, ty_named(s.ret), ty), s.name,
                    ty_named(s.ret)), s)
    } else {
        sealed(bind(env, s.name, ty), s)
    }
}

/// A binding written `const`, `as const`, or with a capital is one nothing writes twice.
sealed(env: Env, s: Stmt) -> Env {
    if s.frozen || starts_upper(s.name) {
        env with { frozen = env.frozen ++ [s.name] }
    } else {
        env
    }
}

return_check(env: Env, declared: str, actual: Ty) -> Env {
    if declared == "" {
        env
    } else {
        joined(env, ty_named(declared), actual)
    }
}

checked_module(m: Module) -> Env {
    start = env_of_module(m)
    inferred = check_items(start, m.items, 0)

    check_items(with_infer(start, inferred.infer), m.items, 0)
}

check_module(m: Module) -> int =>
    checked_module(m).errors.length()

check_items(env: Env, items: Stmt[], i: int) -> Env {
    if i >= items.length() {
        env
    } else {
        check_items(check_item(env, items.get(i)), items, i + 1)
    }
}

check_item(env: Env, s: Stmt) -> Env {
    if s.kind == SFn {
        check_fn_in(env with { here = s.pos }, s)
    } else {
        env
    }
}

/// Every defect found, each carrying its code and where the statement it came from starts.
check_diagnostics(m: Module) -> Diagnostic[] =>
    checked_module(m).errors ++ clashing_names(m.items, 0, [], [])
        ++ variadic_errors(m.items, 0, [])
        ++ config_errors(m.items)

check_errors(m: Module) -> str[] =>
    check_diagnostics(m).map(diag_message)

NixosRoots = " networking system services users user environment programs"
    ++ " fonts boot hardware security nix nixpkgs virtualisation systemd"
    ++ " i18n time sound xdg home imports console powerManagement"
    ++ " documentation location "

/// A dotted path left of `=` is how config mode writes an option, and a program has no such statement.
config_errors(items: Stmt[]) -> Diagnostic[] =>
    writes_an_option(items, 0) ? config_refusals(items, 0, []) : []

writes_an_option(items: Stmt[], i: int) -> bool {
    if i >= items.length() {
        false
    } else if items.get(i).kind == SBind
                  && items.get(i).name.index_of(".") > 0 {
        true
    } else {
        writes_an_option(items, i + 1)
    }
}

config_refusals(items: Stmt[], i: int, acc: Diagnostic[]) -> Diagnostic[] {
    if i >= items.length() {
        acc
    } else {
        config_refusals(items, i + 1, acc ++ config_refusal(items.get(i)))
    }
}

config_refusal(s: Stmt) -> Diagnostic[] {
    if s.kind == SFn {
        s.body.length() == 0 && is_io_builtin(s.name)
            ? [diag_at(s, "M0003", impure_config(s.name))]
            : []
    } else if s.kind != SBind {
        []
    } else {
        impure_value(s) ++ misspelt_option(s)
    }
}

impure_value(s: Stmt) -> Diagnostic[] {
    called = effectful_call(s.value)

    called == "" ? [] : [diag_at(s, "M0003", impure_config(called))]
}

impure_config(name: str) -> str =>
    "config must be pure, and `{name}` performs {effect_of(name)}: a NixOS"
        ++ " module is data, so there is no moment at which it could run"

/// An effect is named by the word that carries it, because config mode forces the empty effect row.
effect_of(name: str) -> str =>
    is_async_effect(name) ? "async" : "io"

is_async_effect(word: str) -> bool =>
    word == "spawn" || word == "await"

effectful_call(e: Expr) -> str {
    if e.kind == EUnary && is_async_effect(e.text) {
        e.text
    } else if (e.kind == ECall || e.kind == EMethod) && is_io_builtin(e.text) {
        e.text
    } else {
        effectful_in(e.children, 0)
    }
}

effectful_in(xs: Expr[], i: int) -> str {
    if i >= xs.length() {
        ""
    } else {
        found = effectful_call(xs.get(i))

        found == "" ? effectful_in(xs, i + 1) : found
    }
}

/// A namespace no module declares is refused only when it is a misspelling of one, because NixOS options are an open set.
misspelt_option(s: Stmt) -> Diagnostic[] {
    root = option_root(s.name)
    near = root == "" || known_root(root)
        ? ""
        : nearest_ctor(root, nixos_roots(), 0, "", hint_span(root))
    why = "unknown NixOS option namespace `{root}`: did you mean `{near}`?"

    near == "" ? [] : [diag_at(s, "M0004", why)]
}

option_root(name: str) -> str {
    cut = name.index_of(".")

    cut < 0 ? "" : name.slice(0, cut)
}

known_root(root: str) -> bool =>
    NixosRoots.index_of(" {root} ") >= 0

nixos_roots() -> str[] =>
    NixosRoots.trim().split(" ")

/// Imports flatten into one module, so two packages defining one name is a clash, not a shadow.
clashing_names(items: Stmt[], i: int, seen: str[],
               acc: Diagnostic[]) -> Diagnostic[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind != SFn {
        clashing_names(items, i + 1, seen, acc)
    } else if seen.index_of(items.get(i).name) >= 0 {
        clashing_names(items, i + 1, seen, acc ++ [clash_of(items.get(i))])
    } else {
        clashing_names(items, i + 1, seen ++ [items.get(i).name], acc)
    }
}

clash_of(s: Stmt) -> Diagnostic {
    why = "`{s.name}` is defined twice; imports share one namespace, so two"
        ++ " packages cannot both name a function this"

    diag_at(s, "M0001", why)
}

surface_of(t: Ty) -> str =>
    match t.kind {
        KInt   => "int"
        KFloat => "float"
        KStr   => "str"
        KBool  => "bool"
        KBytes => "bytes"
        KCon   => con_surface(t)
        KFn    => fn_surface(t)
        KOpt   => surface_of(t.args.get(0))
        _      => ""
    }

con_surface(t: Ty) -> str {
    if t.name == "Array" && t.args.length() == 1 {
        surface_of(t.args.get(0)) ++ "[]"
    } else {
        t.name
    }
}

fn_surface(t: Ty) -> str =>
    "({surface_joined(fn_params(t), 0)}) -> {surface_of(fn_ret(t))}"

surface_joined(ts: Ty[], i: int) -> str {
    if i >= ts.length() {
        ""
    } else if i == ts.length() - 1 {
        surface_of(ts.get(i))
    } else {
        surface_of(ts.get(i)) ++ ", " ++ surface_joined(ts, i + 1)
    }
}

annotated(m: Module) -> Module =>
    Module { items = annotate_items(checked_module(m), m.items, 0, []),
             errors = m.errors }

annotate_items(env: Env, items: Stmt[], i: int, acc: Stmt[]) -> Stmt[] {
    if i >= items.length() {
        acc
    } else {
        annotate_items(env, items, i + 1,
                       acc ++ [annotate_item(env, items.get(i))])
    }
}

annotate_item(env: Env, s: Stmt) -> Stmt {
    if s.kind == SBind {
        s with { value = annotate_expr(env, s.value) }
    } else if s.kind != SFn {
        s
    } else {
        tys = signature_params(env, s.name)
        inner = bind_params(env, s.params, tys, 0)

        keep = s.body.length() > 0

        s with { ret = erased_ret(item_ret(env, s), keep),
                 params = annotate_params(env, s.params, tys, 0, keep),
                 body = annotate_body(inner, s.body, 0, []) }
    }
}

item_ret(env: Env, s: Stmt) -> str {
    if s.ret != "" || s.body.length() == 0 {
        s.ret
    } else {
        surface_of(solved_ty(env, signature_ret(env, s.name)))
    }
}

erased_ret(ret: str, keep: bool) -> str {
    if keep && has_type_var(ret) {
        ret
    } else if ty_named(ret).kind == KAny {
        ""
    } else {
        ret
    }
}

annotate_params(env: Env, ps: Expr[], tys: Ty[], i: int,
                keep: bool) -> Expr[] {
    if i >= ps.length() {
        []
    } else {
        [annotate_param(env, ps.get(i), tys, i, keep)]
            ++ annotate_params(env, ps, tys, i + 1, keep)
    }
}

annotate_param(env: Env, p: Expr, tys: Ty[], i: int, keep: bool) -> Expr {
    if i >= tys.length() || (keep && has_type_var(p.ty)) {
        p
    } else if !keep {
        p with { ty = surface_of(grounded(env.infer, tys.get(i))) }
    } else {
        p with { ty = surface_of(solved_ty(env, tys.get(i))) }
    }
}

grounded(inf: Infer, t: Ty) -> Ty {
    seen = resolve(inf, t)

    seen with { args = grounded_all(inf, seen.args, 0) }
}

grounded_all(inf: Infer, ts: Ty[], i: int) -> Ty[] {
    if i >= ts.length() {
        []
    } else {
        [grounded(inf, ts.get(i))] ++ grounded_all(inf, ts, i + 1)
    }
}

annotate_body(env: Env, stmts: Stmt[], i: int, acc: Stmt[]) -> Stmt[] {
    if i >= stmts.length() {
        acc
    } else {
        st = reassigned(env, stmts.get(i))
        got = type_in(env, st.value)
        marked = st with { value = annotate_expr(env, st.value) }

        annotate_body(extend(got.env, st, got.ty), stmts, i + 1,
                      acc ++ [marked])
    }
}

reassigned(env: Env, s: Stmt) -> Stmt {
    if s.kind == SBind && env.names.index_of(s.name) >= 0 {
        s with { kind = SSet }
    } else {
        s
    }
}

annotate_expr(env: Env, e: Expr) -> Expr {
    if is_element_call(env, e) {
        annotate_expr(env, lowered_element(env, e))
    } else if is_rest_call(env, e) {
        annotated_node(env, gathered_rest(env, e))
    } else if is_field_call(env, e) {
        annotated_node(env, e with { ival = 1 })
    } else if e.kind == ECall && holds_fn(env, e.text) {
        annotated_node(env, e with { ival = 2 })
    } else if e.kind == EIdent && holds_fn(env, e.text) {
        annotated_node(env, e with { ival = 3 })
    } else if e.kind == EIdent && env.names.index_of(e.text) >= 0 {
        annotated_node(env, e with { ival = 4 })
    } else {
        annotated_node(env, e)
    }
}

/// A local holding a function is already a closure, where a top-level name is only a name.
holds_fn(env: Env, name: str) -> bool {
    at = env.names.index_of(name)

    if at < 0 {
        false
    } else {
        resolve(env.infer, env.types.get(at)).kind == KFn
    }
}

/// A name the checker resolved to a binding is what a lambda has to carry with it.
is_bound_name(e: Expr) -> bool =>
    e.kind == EIdent && (e.ival == 3 || e.ival == 4)

/// A record field holding a function is called through the field, not by name.
is_field_call(env: Env, e: Expr) -> bool =>
    e.kind == EMethod
        && field_fn_ty(env,
                       resolve(env.infer,
                               type_in(env, e.children.get(0)).ty),
                       e.text).kind == KFn

is_rest_call(env: Env, e: Expr) -> bool =>
    e.kind == ECall && env.varargs.index_of(e.text) >= 0

/// Every argument past the fixed ones becomes the one list the callee declared.
gathered_rest(env: Env, e: Expr) -> Expr {
    at = fixed_arity(env, e.text)

    e with { children = e.children.slice(0, at)
                        ++ [e_list(e.children.slice(at, e.children.length()))] }
}

fixed_arity(env: Env, name: str) -> int =>
    fn_params(env.sigs.get(env.fns.index_of(name))).length() - 1

annotated_node(env: Env, e: Expr) -> Expr {
    inner = check_body(env, e.stmts, 0, t_any())
    seen = type_in(env, e)

    e with { ty = surface_of(solved_ty(seen.env, seen.ty)),
             stmts = annotate_body(looped(env, e), e.stmts, 0, []),
             children = annotate_children(inner.env, e, 0, []) }
}

is_element_call(env: Env, e: Expr) -> bool =>
    e.kind == ECall && is_element_tag(e.text) && !is_prelude_call(e.text)
        && env.ctors.index_of(e.text) < 0 && env.names.index_of(e.text) < 0
        && (env.fns.index_of(e.text) < 0
            || tag_wins(env, e, env.fns.index_of(e.text)))

/// A tag some function also names stays the tag when the call cannot be that function.
tag_wins(env: Env, e: Expr, declared: int) -> bool =>
    is_element_tag(e.text) && !is_prelude_call(e.text)
        && env.names.index_of(e.text) < 0
        && env.varargs.index_of(e.text) < 0
        && fn_params(env.sigs.get(declared)).length() != e.children.length()

lowered_element(env: Env, e: Expr) -> Expr {
    named = e.text == "element" && e.children.length() > 0
    from = named ? 1 : 0
    tag = named ? e.children.get(0) : e_str(e.text)

    e_call("maca_element",
           [tag, element_attrs(env, e.children, from, e_str("")),
            element_kids(env, e.children, from, e_str(""))])
}

element_attrs(env: Env, cs: Expr[], i: int, acc: Expr) -> Expr {
    if i >= cs.length() {
        acc
    } else if cs.get(i).kind != EAttr {
        element_attrs(env, cs, i + 1, acc)
    } else {
        element_attrs(env, cs, i + 1,
                      e_binary("++", acc, one_attribute(env, cs.get(i))))
    }
}

one_attribute(env: Env, a: Expr) -> Expr {
    value = a.children.get(0)

    if resolve(env.infer, type_in(env, value).ty).kind == KBool {
        e_call("maca_flag", [e_str(a.text), value])
    } else {
        e_call("maca_attr", [e_str(a.text), as_html_text(env, value)])
    }
}

element_kids(env: Env, cs: Expr[], i: int, acc: Expr) -> Expr {
    if i >= cs.length() {
        acc
    } else if cs.get(i).kind == EAttr {
        element_kids(env, cs, i + 1, acc)
    } else {
        element_kids(env, cs, i + 1,
                     e_binary("++", acc, as_html_text(env, cs.get(i))))
    }
}

as_html_text(env: Env, v: Expr) -> Expr {
    t = resolve(env.infer, type_in(env, v).ty)

    if t.kind == KStr {
        v
    } else if is_str_list(env.infer, t) {
        e_method(v, "join", [e_str("")])
    } else {
        e_call("str", [v])
    }
}

is_str_list(inf: Infer, t: Ty) -> bool =>
    t.kind == KCon && t.name == "Array" && t.args.length() == 1
        && resolve(inf, t.args.get(0)).kind == KStr

looped(env: Env, e: Expr) -> Env {
    if e.kind != EFor || e.children.length() == 0 {
        env
    } else {
        over = type_in(env, e.children.get(0))

        bind(over.env, e.text, element_of(resolve(over.env.infer, over.ty)))
    }
}

annotate_children(env: Env, e: Expr, i: int, acc: Expr[]) -> Expr[] {
    if i >= e.children.length() {
        acc
    } else {
        annotate_children(env, e, i + 1,
                          acc ++ [annotate_expr(child_scope(env, e, i),
                                                e.children.get(i))])
    }
}

/// An arm and a lambda name their own bindings, and only that child reads them.
child_scope(env: Env, e: Expr, i: int) -> Env {
    if e.kind == EMatch && i >= 2 && i % 2 == 0 {
        arm_scope(env, e.children.get(0), e.children.get(i - 1))
    } else if e.kind == EMatch && i >= 1 {
        arm_scope(env, e.children.get(0), e.children.get(i))
    } else if e.kind == EMethod && i > 0 && e.children.get(i).kind == ELambda {
        lambda_scope(env, e, i)
    } else {
        env
    }
}

arm_scope(env: Env, scrut: Expr, pat: Expr) -> Env {
    seen = type_in(env, scrut)

    bound_cells(bound_whole(bound_arm(seen.env, pat), pat, seen.ty), pat,
                element_of(resolve(seen.env.infer, seen.ty)))
}

/// A lowercase pattern names the whole value, so writing it is a reassignment and never a second binding.
bound_whole(env: Env, pat: Expr, t: Ty) -> Env {
    if pat.kind == EGuard {
        bound_whole(env, pat.children.get(0), t)
    } else if pat.kind != EIdent || pat.children.length() > 0 {
        env
    } else if starts_upper(pat.text) || !whole_binder(pat.text) {
        env
    } else {
        bind(env, pat.text, t)
    }
}

whole_binder(name: str) -> bool =>
    name != "_" && name != "[]" && name != "[..]" && name != "{{}}"
        && name != "true" && name != "false"

lambda_scope(env: Env, e: Expr, i: int) -> Env {
    ps = lambda_params(e.children.get(i))
    recv = type_in(env, e.children.get(0))
    el = element_of(resolve(recv.env.infer, recv.ty))

    if i == 2 && ps.length() == 2 {
        bind(bind(env, ps.get(0).text, type_in(env, e.children.get(1)).ty),
             ps.get(1).text, el)
    } else {
        bind_each(env, ps, el, 0)
    }
}

bind_each(env: Env, ps: Expr[], t: Ty, i: int) -> Env {
    if i >= ps.length() {
        env
    } else {
        bind_each(bind(env, ps.get(i).text, t), ps, t, i + 1)
    }
}

type_of(e: Expr) -> str =>
    show_ty(type_in(empty_env(), e).ty)

count_errors(e: Expr) -> int =>
    type_in(empty_env(), e).env.errors.length()

Lift = {
    items: Stmt[]
    n:     int
}

Lifted = {
    node: Expr
    at:   Lift
}

LiftedAll = {
    nodes: Expr[]
    at:    Lift
}

LiftedBody = {
    stmts: Stmt[]
    at:    Lift
}

/// A lambda used as a value becomes a function of its own, which every back end already passes by name.
lifted(m: Module) -> Module {
    named = named_anons(m)
    got = lift_items(named.items, 0, Lift { items = [], n = 0 })

    Module { items = got.items, errors = m.errors }
}

top_names(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind == SFn || items.get(i).kind == SBind {
        top_names(items, i + 1, acc ++ [items.get(i).name])
    } else {
        top_names(items, i + 1, acc)
    }
}

Assets = {
    base:  str
    names: str[]
    texts: str[]
}

/// `data("f")` is the file's own text, spliced in while the program is built.
desugared(m: Module, src: str) -> Module {
    at = Assets { base = embed_dir(src),
                  names = text_const_names(m.items, 0, []),
                  texts = text_const_texts(m.items, 0, []) }

    if top_names(m.items, 0, []).index_of("data") >= 0 {
        Module { items = m.items, errors = [] }
    } else {
        Module { items = embed_items(m.items, at, 0, []),
                 errors = embed_faults(m.items, at, 0, []) }
    }
}

embed_dir(path: str) -> str =>
    path.slice(0, embed_sep(path.chars(), path.length() - 1))

embed_sep(cs: str[], i: int) -> int {
    if i < 0 {
        0
    } else if cs.get(i) == "/" || cs.get(i) == "\\" {
        i + 1
    } else {
        embed_sep(cs, i - 1)
    }
}

is_text_const(s: Stmt) -> bool =>
    s.kind == SBind && s.value.kind == EStr

text_const_names(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if is_text_const(items.get(i)) {
        text_const_names(items, i + 1, acc ++ [items.get(i).name])
    } else {
        text_const_names(items, i + 1, acc)
    }
}

text_const_texts(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if is_text_const(items.get(i)) {
        text_const_texts(items, i + 1, acc ++ [items.get(i).value.text])
    } else {
        text_const_texts(items, i + 1, acc)
    }
}

is_data_call(e: Expr) -> bool =>
    e.kind == ECall && e.text == "data"

/// The path an argument names, written out or bound to a constant beside it.
asset_spec(e: Expr, at: Assets) -> str {
    if e.kind == EStr {
        e.text
    } else if e.kind == EIdent && at.names.index_of(e.text) >= 0 {
        at.texts.get(at.names.index_of(e.text))
    } else {
        ""
    }
}

/// The file `data("x")` reads: the `.local` copy when the tree holds one.
data_file(base: str, spec: str) -> str {
    local = base ++ local_spec(spec)

    file_exists(local) ? local : base ++ spec
}

/// `config/links.json` is shadowed by `config/links.local.json` beside it.
local_spec(spec: str) -> str {
    cut = embed_sep(spec.chars(), spec.length() - 1)
    tail = spec.slice(cut, spec.length())
    dot = last_dot(tail.chars(), tail.length() - 1)

    if dot > 0 {
        spec.slice(0, cut + dot) ++ ".local"
            ++ tail.slice(dot, tail.length())
    } else {
        spec ++ ".local"
    }
}

last_dot(cs: str[], i: int) -> int {
    if i < 0 {
        -1
    } else if cs.get(i) == "." {
        i
    } else {
        last_dot(cs, i - 1)
    }
}

asset_file(e: Expr, at: Assets) -> str =>
    data_file(at.base, asset_spec(e.children.get(0), at))

asset_ok(e: Expr, at: Assets) -> bool =>
    e.children.length() == 1 && asset_spec(e.children.get(0), at) != ""
        && file_exists(asset_file(e, at))

/// The file's text as a literal a back end can print, its own escapes kept.
asset_text(e: Expr, at: Assets) -> str =>
    one_line_text(read_file(asset_file(e, at)))
        .chars().map(embed_char).join("")

one_line_text(text: str) -> str =>
    text.replace("\r\n", "\n").replace("\r", "\n")

/// A brace is its own character here, and the rest is the lexer's escape.
embed_char(c: str) -> str =>
    c == "\{" || c == "\}" ? c : raw_char(c)

embed_items(items: Stmt[], at: Assets, i: int, acc: Stmt[]) -> Stmt[] {
    if i >= items.length() {
        acc
    } else {
        embed_items(items, at, i + 1,
                    acc ++ [embed_stmt(items.get(i), at)])
    }
}

embed_stmt(s: Stmt, at: Assets) -> Stmt =>
    s with { value = embed_bound(s.value, s.ret, at),
             body = embed_items(s.body, at, 0, []) }

/// A `str` binding is the text itself, and any other type what `decode` reads.
embed_bound(e: Expr, want: str, at: Assets) -> Expr {
    if is_data_call(e) && asset_ok(e, at) && want == "str" {
        e_str(asset_text(e, at))
    } else {
        embed_expr(e, at)
    }
}

embed_expr(e: Expr, at: Assets) -> Expr {
    if is_data_call(e) && asset_ok(e, at) {
        e_call("decode", [e_str(asset_text(e, at))])
    } else {
        e with { children = embed_kids(e.children, at, 0, []),
                 stmts = embed_items(e.stmts, at, 0, []) }
    }
}

embed_kids(xs: Expr[], at: Assets, i: int, acc: Expr[]) -> Expr[] {
    if i >= xs.length() {
        acc
    } else {
        embed_kids(xs, at, i + 1, acc ++ [embed_expr(xs.get(i), at)])
    }
}

embed_faults(items: Stmt[], at: Assets, i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else {
        embed_faults(items, at, i + 1,
                     acc ++ expr_faults(items.get(i).value, at)
                         ++ embed_faults(items.get(i).body, at, 0, []))
    }
}

expr_faults(e: Expr, at: Assets) -> str[] {
    if is_data_call(e) {
        data_faults(e, at)
    } else {
        kid_faults(e.children, at, 0, [])
            ++ embed_faults(e.stmts, at, 0, [])
    }
}

kid_faults(xs: Expr[], at: Assets, i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else {
        kid_faults(xs, at, i + 1, acc ++ expr_faults(xs.get(i), at))
    }
}

data_faults(e: Expr, at: Assets) -> str[] {
    if e.children.length() != 1 {
        ["data(...) takes one path, as in `data(\"config/links.json\")`"]
    } else if asset_spec(e.children.get(0), at) == "" {
        ["data(...): the path is read while building, so write it out"
             ++ " or bind it to a constant"]
    } else if !file_exists(asset_file(e, at)) {
        ["data(\"" ++ asset_spec(e.children.get(0), at) ++ "\"): "
             ++ asset_file(e, at) ++ ": no such file"]
    } else {
        []
    }
}

lift_items(items: Stmt[], i: int, at: Lift) -> Lift {
    if i >= items.length() {
        at
    } else {
        one = lift_stmt(items.get(i), at)

        lift_items(items, i + 1,
                   one.at with { items = one.at.items ++ one.stmts })
    }
}

lift_stmt(s: Stmt, at: Lift) -> LiftedBody {
    if s.kind == SFn {
        body = lift_body(s.body, 0, [], at)

        LiftedBody { stmts = [s with { body = body.stmts }], at = body.at }
    } else if s.kind == SRecord || s.kind == SSum {
        LiftedBody { stmts = [s], at }
    } else {
        got = lift_expr(s.value, at)

        LiftedBody { stmts = [s with { value = got.node }], at = got.at }
    }
}

lift_body(stmts: Stmt[], i: int, acc: Stmt[], at: Lift) -> LiftedBody {
    if i >= stmts.length() {
        LiftedBody { stmts = acc, at }
    } else {
        one = lift_stmt(stmts.get(i), at)

        lift_body(stmts, i + 1, acc ++ one.stmts, one.at)
    }
}

lift_expr(e: Expr, at: Lift) -> Lifted {
    if e.kind == ELambda && captures_of(e).length() == 0 {
        lift_one(e, at)
    } else if e.kind == ELambda {
        lift_closure(e, at)
    } else {
        kids = lift_all(e.children, 0, [], at, e)
        body = lift_body(e.stmts, 0, [], kids.at)

        Lifted { node = e with { children = kids.nodes, stmts = body.stmts },
                 at = body.at }
    }
}

lift_all(cs: Expr[], i: int, acc: Expr[], at: Lift, owner: Expr) -> LiftedAll {
    if i >= cs.length() {
        LiftedAll { nodes = acc, at }
    } else if held_inline(owner, cs.get(i)) {
        lift_all(cs, i + 1, acc ++ [cs.get(i)], at, owner)
    } else {
        one = lift_expr(cs.get(i), at)

        lift_all(cs, i + 1, acc ++ [one.node], one.at, owner)
    }
}

/// `map` and its neighbours read the lambda's own body, and an attribute holds a handler, not a name.
held_inline(owner: Expr, kid: Expr) -> bool =>
    kid.kind == ELambda
        && (owner.kind == EAttr || is_attribute_call(owner)
            || (owner.kind == EMethod && inlines_lambda(owner.text)))

is_attribute_call(owner: Expr) -> bool =>
    owner.kind == ECall
        && (owner.text == "str" || owner.text == "maca_attr"
            || owner.text == "maca_flag")

inlines_lambda(name: str) -> bool =>
    name == "map" || name == "filter" || name == "reduce" || name == "fold"
        || name == "parallel"

/// The lifted function answers what the lambda's body answers, which a typed target must be told.
lift_one(e: Expr, at: Lift) -> Lifted {
    name = "maca_lambda_{str(at.n)}"
    made = s_fn(name, lambda_body(e).ty, lambda_params(e),
                [s_expr(lambda_body(e))])
    inner = lift_stmt(made, at with { n = at.n + 1 })

    Lifted { node = e_ident(name),
             at = inner.at with { items = inner.at.items ++ inner.stmts } }
}

/// A lambda that reads a name from around it becomes a function plus the values it read.
lift_closure(e: Expr, at: Lift) -> Lifted {
    name = "maca_closure_{str(at.n)}"
    caps = captures_of(e)
    made = s_fn(name, lambda_body(e).ty, lambda_params(e),
                cap_binds(caps, 0) ++ [s_expr(lambda_body(e))])
    inner = lift_stmt(made, at with { n = at.n + 1 })

    Lifted { node = e_call("maca_closure", [e_ident(name)] ++ caps),
             at = inner.at with { items = inner.at.items ++ inner.stmts } }
}

cap_binds(caps: Expr[], i: int) -> Stmt[] {
    if i >= caps.length() {
        []
    } else {
        one = s_bind_typed(caps.get(i).text, caps.get(i).ty,
                           e_call("maca_cap",
                                  [e_str(caps.get(i).ty), e_int(i)]))

        [one] ++ cap_binds(caps, i + 1)
    }
}

/// Every name the body reads from around it, once each, carrying the type it was given.
captures_of(e: Expr) -> Expr[] =>
    free_idents(lambda_body(e), lambda_names(lambda_params(e), 0, []), [])

lambda_names(ps: Expr[], i: int, acc: str[]) -> str[] {
    if i >= ps.length() {
        acc
    } else {
        lambda_names(ps, i + 1, acc ++ [ps.get(i).text])
    }
}

free_idents(e: Expr, bound: str[], acc: Expr[]) -> Expr[] {
    if e.kind == EIdent {
        free_added(e, bound, acc)
    } else if e.kind == ELambda {
        free_idents(lambda_body(e),
                    bound ++ lambda_names(lambda_params(e), 0, []), acc)
    } else if e.kind == EBlock {
        free_idents(e.children.get(0), bound ++ stmt_names(e.stmts, 0, []),
                    free_stmts(e.stmts, 0, bound, acc))
    } else {
        free_stmts(e.stmts, 0, free_bound(e, bound),
                   free_kids(e.children, 0, bound, acc))
    }
}

stmt_names(ss: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= ss.length() {
        acc
    } else {
        stmt_names(ss, i + 1, acc ++ [ss.get(i).name])
    }
}

free_bound(e: Expr, bound: str[]) -> str[] =>
    e.kind == EFor ? bound ++ [e.text] : bound

free_added(e: Expr, bound: str[], acc: Expr[]) -> Expr[] {
    if !is_bound_name(e) || bound.index_of(e.text) >= 0 {
        acc
    } else if free_names(acc, 0, []).index_of(e.text) >= 0 {
        acc
    } else {
        acc ++ [e]
    }
}

free_names(acc: Expr[], i: int, out: str[]) -> str[] {
    if i >= acc.length() {
        out
    } else {
        free_names(acc, i + 1, out ++ [acc.get(i).text])
    }
}

free_kids(cs: Expr[], i: int, bound: str[], acc: Expr[]) -> Expr[] {
    if i >= cs.length() {
        acc
    } else {
        free_kids(cs, i + 1, bound, free_idents(cs.get(i), bound, acc))
    }
}

free_stmts(ss: Stmt[], i: int, bound: str[], acc: Expr[]) -> Expr[] {
    if i >= ss.length() {
        acc
    } else {
        free_stmts(ss, i + 1, bound ++ [ss.get(i).name],
                   free_idents(ss.get(i).value, bound, acc))
    }
}

/// A record literal with no name gets a struct of its own shape to be.
named_anons(m: Module) -> Module {
    fixed = anon_stmts(m.items, 0)

    Module { items = fixed ++ anon_decls(anon_in_stmts(fixed, 0), 0, []),
             errors = m.errors }
}

anon_stmts(ss: Stmt[], i: int) -> Stmt[] {
    if i >= ss.length() {
        []
    } else {
        [anon_stmt(ss.get(i))] ++ anon_stmts(ss, i + 1)
    }
}

anon_stmt(s: Stmt) -> Stmt =>
    s with { value = anon_expr(s.value), body = anon_stmts(s.body, 0) }

anon_expr(e: Expr) -> Expr =>
    e with { text = anon_text(e), stmts = anon_stmts(e.stmts, 0),
             children = anon_kids(e.children, 0) }

anon_kids(cs: Expr[], i: int) -> Expr[] {
    if i >= cs.length() {
        []
    } else {
        [anon_expr(cs.get(i))] ++ anon_kids(cs, i + 1)
    }
}

/// Two literals of one shape share a name, so the field list is sorted first.
anon_text(e: Expr) -> str {
    if e.kind != ERecord || e.text != "" || e.children.length() == 0 {
        e.text
    } else if !anon_named_fields(e.children, 0) {
        e.text
    } else {
        "MacaAnon_" ++ anon_tags(e.children, 0, []).sort().join("_")
    }
}

anon_named_fields(fs: Expr[], i: int) -> bool {
    if i >= fs.length() {
        true
    } else if !anon_field_named(fs.get(i)) {
        false
    } else {
        anon_named_fields(fs, i + 1)
    }
}

anon_field_named(f: Expr) -> bool {
    if f.kind != EBinary || f.text != "=" || f.children.length() < 2 {
        false
    } else {
        anon_word(f.children.get(0).text)
    }
}

anon_word(name: str) -> bool =>
    name != "" && (name.at(0).is_alpha() || name.at(0) == "_")

anon_tags(fs: Expr[], i: int, acc: str[]) -> str[] {
    if i >= fs.length() {
        acc
    } else {
        anon_tags(fs, i + 1, acc ++ [anon_tag(fs.get(i))])
    }
}

anon_tag(f: Expr) -> str =>
    "{f.children.get(0).text}_{type_tag(f.children.get(1).ty)}"

is_anon_lit(e: Expr) -> bool =>
    e.kind == ERecord && e.text.index_of("MacaAnon_") == 0

anon_in_stmts(ss: Stmt[], i: int) -> Expr[] {
    if i >= ss.length() {
        []
    } else {
        anon_in_stmt(ss.get(i)) ++ anon_in_stmts(ss, i + 1)
    }
}

anon_in_stmt(s: Stmt) -> Expr[] =>
    anon_in_expr(s.value) ++ anon_in_stmts(s.body, 0)

anon_in_expr(e: Expr) -> Expr[] {
    under = anon_in_kids(e.children, 0) ++ anon_in_stmts(e.stmts, 0)

    is_anon_lit(e) ? [e] ++ under : under
}

anon_in_kids(cs: Expr[], i: int) -> Expr[] {
    if i >= cs.length() {
        []
    } else {
        anon_in_expr(cs.get(i)) ++ anon_in_kids(cs, i + 1)
    }
}

anon_decls(es: Expr[], i: int, seen: str[]) -> Stmt[] {
    if i >= es.length() {
        []
    } else if seen.index_of(es.get(i).text) >= 0 {
        anon_decls(es, i + 1, seen)
    } else {
        [s_record(es.get(i).text, anon_fields(es.get(i).children, 0))]
            ++ anon_decls(es, i + 1, seen ++ [es.get(i).text])
    }
}

anon_fields(fs: Expr[], i: int) -> Expr[] {
    if i >= fs.length() {
        []
    } else {
        [e_param(fs.get(i).children.get(0).text,
                 fs.get(i).children.get(1).ty)]
            ++ anon_fields(fs, i + 1)
    }
}

Want = {
    name: str
    tys:  str[]
}

Poly = {
    gens:  Stmt[]
    wants: Want[]
    done:  str[]
}

PolyNode = {
    node: Expr
    at:   Poly
}

PolyAll = {
    nodes: Expr[]
    at:    Poly
}

PolyBody = {
    stmts: Stmt[]
    at:    Poly
}

/// A function declared over a type variable is compiled once per concrete argument tuple, so no back end meets one.
monomorphic(m: Module) -> Module {
    gens = generic_items(m.items, 0, [])

    if gens.length() == 0 {
        m
    } else {
        first = mono_items(m.items, 0, [],
                           Poly { gens, wants = [], done = [] })
        grown = expanded(checked_module(m), first.at, 0, [])

        Module { items = first.stmts ++ grown.stmts, errors = m.errors }
    }
}

generic_items(items: Stmt[], i: int, acc: Stmt[]) -> Stmt[] {
    if i >= items.length() {
        acc
    } else if is_generic_fn(items.get(i)) {
        generic_items(items, i + 1, acc ++ [items.get(i)])
    } else {
        generic_items(items, i + 1, acc)
    }
}

/// A declaration without a body is what a foreign block or a back end writes, so it keeps its type variable.
is_generic_fn(s: Stmt) -> bool =>
    s.kind == SFn && s.body.length() > 0
        && (has_type_var(s.ret) || any_type_var(s.params, 0))

any_type_var(ps: Expr[], i: int) -> bool {
    if i >= ps.length() {
        false
    } else if has_type_var(ps.get(i).ty) {
        true
    } else {
        any_type_var(ps, i + 1)
    }
}

/// A name the type table answers nothing for is the one thing left that it can be.
has_type_var(name: str) -> bool {
    cut = name.index_of(") -> ")

    if is_array_name(name) {
        has_type_var(name.slice(0, name.length() - 2))
    } else if cut >= 0 {
        var_in_each(name.slice(1, cut))
            || has_type_var(name.slice(cut + 5, name.length()))
    } else if map_type_val(name) != "" {
        has_type_var(map_type_key(name)) || has_type_var(map_type_val(name))
    } else {
        name != "" && ty_named(name).kind == KAny
    }
}

var_in_each(list: str) -> bool {
    cut = list.index_of(", ")

    if list == "" {
        false
    } else if cut < 0 {
        has_type_var(list)
    } else {
        has_type_var(list.slice(0, cut))
            || var_in_each(list.slice(cut + 2, list.length()))
    }
}

mono_items(items: Stmt[], i: int, acc: Stmt[], at: Poly) -> PolyBody {
    if i >= items.length() {
        PolyBody { stmts = acc, at }
    } else if is_generic_fn(items.get(i)) {
        mono_items(items, i + 1, acc, at)
    } else {
        one = mono_stmt(items.get(i), at)

        mono_items(items, i + 1, acc ++ one.stmts, one.at)
    }
}

mono_stmt(s: Stmt, at: Poly) -> PolyBody {
    if s.kind == SRecord || s.kind == SSum {
        PolyBody { stmts = [s], at }
    } else if s.kind == SFn {
        body = mono_body(s.body, 0, [], at)

        PolyBody { stmts = [s with { body = body.stmts }], at = body.at }
    } else {
        got = mono_expr(s.value, at)

        PolyBody { stmts = [s with { value = got.node }], at = got.at }
    }
}

mono_body(stmts: Stmt[], i: int, acc: Stmt[], at: Poly) -> PolyBody {
    if i >= stmts.length() {
        PolyBody { stmts = acc, at }
    } else {
        one = mono_stmt(stmts.get(i), at)

        mono_body(stmts, i + 1, acc ++ one.stmts, one.at)
    }
}

mono_expr(e: Expr, at: Poly) -> PolyNode {
    kids = mono_all(e.children, 0, [], at)
    body = mono_body(e.stmts, 0, [], kids.at)
    node = e with { children = kids.nodes, stmts = body.stmts }

    if e.kind != ECall {
        PolyNode { node, at = body.at }
    } else {
        mono_named(node, body.at)
    }
}

mono_all(cs: Expr[], i: int, acc: Expr[], at: Poly) -> PolyAll {
    if i >= cs.length() {
        PolyAll { nodes = acc, at }
    } else {
        one = mono_expr(cs.get(i), at)

        mono_all(cs, i + 1, acc ++ [one.node], one.at)
    }
}

mono_named(e: Expr, at: Poly) -> PolyNode {
    found = generic_at(at.gens, e.text, 0)

    if found >= at.gens.length() {
        PolyNode { node = e, at }
    } else {
        mono_call(e, at.gens.get(found), at)
    }
}

/// The rewritten call carries its specialisation's return type, so a call around it reads a concrete argument.
mono_call(e: Expr, g: Stmt, at: Poly) -> PolyNode {
    want = Want { name = e.text, tys = arg_type_names(e.children, 0, []) }

    PolyNode { node = e with { text = mangled(want),
                               ty = specialised_ty(g, want.tys, g.ret) },
               at = at with { wants = at.wants ++ [want] } }
}

generic_at(gens: Stmt[], name: str, i: int) -> int {
    if i >= gens.length() || gens.get(i).name == name {
        i
    } else {
        generic_at(gens, name, i + 1)
    }
}

arg_type_names(cs: Expr[], i: int, acc: str[]) -> str[] {
    if i >= cs.length() {
        acc
    } else {
        arg_type_names(cs, i + 1, acc ++ [cs.get(i).ty])
    }
}

mangled(w: Want) -> str {
    tags = w.tys.map(type_tag).join("_")

    "{w.name}__{tags}"
}

/// A mangled name has to be a C identifier, so a bracket, a space and an arrow each become a word.
type_tag(ty: str) -> str {
    if ty == "" {
        "any"
    } else if ty.length() >= 2
            && ty.slice(ty.length() - 2, ty.length()) == "[]" {
        "arr" ++ type_tag(ty.slice(0, ty.length() - 2))
    } else if map_type_val(ty) != "" {
        type_tag(map_type_val(ty)) ++ "map"
    } else if ty.index_of(") -> ") >= 0 {
        "fn" ++ type_tag(ty.slice(ty.index_of(") -> ") + 5, ty.length()))
    } else if ty == "float" {
        "f64"
    } else {
        ty
    }
}

expanded(env: Env, at: Poly, i: int, acc: Stmt[]) -> PolyBody {
    if i >= at.wants.length() {
        PolyBody { stmts = acc, at }
    } else {
        w = at.wants.get(i)
        name = mangled(w)

        if at.done.index_of(name) >= 0 {
            expanded(env, at, i + 1, acc)
        } else {
            g = at.gens.get(generic_at(at.gens, w.name, 0))
            one = mono_stmt(annotate_item(env, specialised(g, w, name)),
                            at with { done = at.done ++ [name] })

            expanded(env, one.at, i + 1, acc ++ one.stmts)
        }
    }
}

specialised(g: Stmt, w: Want, name: str) -> Stmt =>
    g with { name,
             ret = specialised_ty(g, w.tys, g.ret),
             params = specialised_params(g, g.params, w.tys, 0),
             body = ground_body(g, w.tys, g.body, 0) }

ground_body(g: Stmt, tys: str[], ss: Stmt[], i: int) -> Stmt[] {
    if i >= ss.length() {
        []
    } else {
        [ground_stmt(g, tys, ss.get(i))] ++ ground_body(g, tys, ss, i + 1)
    }
}

ground_stmt(g: Stmt, tys: str[], s: Stmt) -> Stmt =>
    s with { ret = specialised_ty(g, tys, s.ret),
             value = ground_expr(g, tys, s.value),
             body = ground_body(g, tys, s.body, 0) }

ground_expr(g: Stmt, tys: str[], e: Expr) -> Expr =>
    e with { stmts = ground_body(g, tys, e.stmts, 0),
             children = ground_kids(g, tys, e.children, 0) }

ground_kids(g: Stmt, tys: str[], cs: Expr[], i: int) -> Expr[] {
    if i >= cs.length() {
        []
    } else {
        [ground_expr(g, tys, cs.get(i))] ++ ground_kids(g, tys, cs, i + 1)
    }
}

specialised_params(g: Stmt, ps: Expr[], tys: str[], i: int) -> Expr[] {
    if i >= ps.length() {
        []
    } else {
        [specialised_param(g, ps.get(i), tys, i)]
            ++ specialised_params(g, ps, tys, i + 1)
    }
}

/// An argument whose own type is still unknown leaves the declaration to say what it is.
specialised_param(g: Stmt, p: Expr, tys: str[], i: int) -> Expr {
    if i >= tys.length() {
        p
    } else if tys.get(i) == "" {
        p with { ty = specialised_ty(g, tys, p.ty) }
    } else {
        p with { ty = tys.get(i) }
    }
}

specialised_ty(g: Stmt, tys: str[], ty: str) -> str {
    if is_array_name(ty) {
        specialised_ty(g, tys, ty.slice(0, ty.length() - 2)) ++ "[]"
    } else if map_type_val(ty) != "" {
        "Map {specialised_ty(g, tys, map_type_key(ty))}"
            ++ " {specialised_ty(g, tys, map_type_val(ty))}"
    } else if ty.index_of(") -> ") >= 0 {
        specialised_fn(g, tys, ty)
    } else if !has_type_var(ty) {
        ty
    } else {
        var_type(g.params, tys, 0, ty)
    }
}

specialised_fn(g: Stmt, tys: str[], ty: str) -> str {
    cut = ty.index_of(") -> ")

    "({specialised_each(g, tys, ty.slice(1, cut))}) -> "
        ++ specialised_ty(g, tys, ty.slice(cut + 5, ty.length()))
}

specialised_each(g: Stmt, tys: str[], list: str) -> str {
    cut = list.index_of(", ")

    if list == "" {
        ""
    } else if cut < 0 {
        specialised_ty(g, tys, list)
    } else {
        "{specialised_ty(g, tys, list.slice(0, cut))}, "
            ++ specialised_each(g, tys, list.slice(cut + 2, list.length()))
    }
}

var_type(ps: Expr[], tys: str[], i: int, v: str) -> str {
    if i >= ps.length() || i >= tys.length() {
        ""
    } else {
        here = matched_var(ps.get(i).ty, tys.get(i), v)

        if here != "" {
            here
        } else {
            var_type(ps, tys, i + 1, v)
        }
    }
}

matched_var(declared: str, concrete: str, v: str) -> str {
    if declared == v {
        concrete
    } else if is_array_name(declared) && is_array_name(concrete) {
        matched_var(declared.slice(0, declared.length() - 2),
                    concrete.slice(0, concrete.length() - 2), v)
    } else {
        ""
    }
}

/// A rest parameter says what its list holds, and `main` is filled from the command line rather than by a caller.
variadic_errors(items: Stmt[], i: int, acc: Diagnostic[]) -> Diagnostic[] {
    if i >= items.length() {
        acc
    } else {
        variadic_errors(items, i + 1, acc ++ rest_misuse(items.get(i)))
    }
}

rest_misuse(s: Stmt) -> Diagnostic[] {
    why = rest_misuse_why(s)

    why == "" ? [] : [diag_at(s, "M0001", why)]
}

rest_misuse_why(s: Stmt) -> str {
    if s.kind != SFn {
        ""
    } else if rest_before_the_end(s.params, 0) {
        "type mismatch: `{s.name}`: a rest parameter must be last, so"
            ++ " nothing says where the arguments it gathers stop"
    } else if rest_taker(s).length() == 0 {
        ""
    } else if s.name == "main" {
        "type mismatch: `main` takes no rest parameter, because the"
            ++ " command line fills one `str[]`"
    } else if s.params.get(s.params.length() - 1).ty == "[]" {
        "type mismatch: `{s.name}` has a rest parameter with no type, so"
            ++ " nothing says what the list it gathers holds"
    } else {
        ""
    }
}

AllEffects = " io net os async exn "

/// Every effect a program can perform, in the order a diagnostic names them.
effect_list() -> str[] =>
    eff_words(AllEffects)

eff_none() -> str =>
    " "

eff_words(set: str) -> str[] =>
    set.trim() == "" ? [] : set.trim().split(" ")

eff_has(set: str, name: str) -> bool =>
    set.index_of(" {name} ") >= 0

eff_add(set: str, name: str) -> str =>
    eff_has(set, name) ? set : set ++ "{name} "

eff_union(a: str, b: str) -> str =>
    eff_merge(a, eff_words(b), 0)

eff_merge(a: str, xs: str[], i: int) -> str =>
    i >= xs.length() ? a : eff_merge(eff_add(a, xs.get(i)), xs, i + 1)

KnownTargets = " native c js jvm rust tauri embedded nix all "

/// A target nothing builds for cannot say what it carries, so naming one is a usage error.
is_known_target(name: str) -> bool =>
    KnownTargets.index_of(" {name} ") >= 0

/// What a back end can carry, as the effects a program compiled for it may perform.
target_effects(target: str) -> str[] {
    if target == "js" {
        ["io", "net", "async", "exn"]
    } else if target == "embedded" || target == "all" {
        ["exn"]
    } else if target == "nix" {
        eff_words("")
    } else {
        effect_list()
    }
}

eff_outside(set: str, allowed: str[]) -> str[] =>
    eff_refused(effect_list(), set, allowed, 0, [])

eff_refused(all: str[], set: str, allowed: str[], i: int,
            acc: str[]) -> str[] {
    if i >= all.length() {
        acc
    } else if eff_has(set, all.get(i)) && allowed.index_of(all.get(i)) < 0 {
        eff_refused(all, set, allowed, i + 1, acc.push(all.get(i)))
    } else {
        eff_refused(all, set, allowed, i + 1, acc)
    }
}

/// A prelude call is where an effect enters a program, since nothing else performs one.
eff_of_call(name: str) -> str {
    if name == "sleep_ms" {
        " async "
    } else if is_io_builtin(name) || name == "input" {
        " io "
    } else {
        eff_none()
    }
}

eff_of_word(word: str) -> str {
    if is_async_effect(word) {
        " async "
    } else if word == "try" || word == "fail" {
        " exn "
    } else {
        eff_none()
    }
}

eff_of_method(e: Expr) -> str {
    named = e.children.length() > 0 && e.children.get(0).kind == EIdent
    host = named ? e.children.get(0).text : ""

    if host == "net" || host == "http" || host == "socket" {
        " net "
    } else if host == "os" || host == "process" {
        " os "
    } else if is_io_method(e.text) {
        " io "
    } else {
        eff_none()
    }
}

is_io_method(name: str) -> bool =>
    name == "read" || name == "write" || name == "exists"
        || name == "remove" || name == "append" || name == "create"

node_effects(e: Expr, names: str[], sets: str[]) -> str {
    at = e.kind == ECall ? names.index_of(e.text) : -1

    if at >= 0 {
        sets.get(at)
    } else if e.kind == ECall {
        eff_of_call(e.text)
    } else if e.kind == EUnary {
        eff_of_word(e.text)
    } else if e.kind == EMethod {
        eff_of_method(e)
    } else {
        eff_none()
    }
}

expr_effects(e: Expr, names: str[], sets: str[]) -> str =>
    body_effects(e.stmts, names, sets, 0,
                 kids_effects(e.children, names, sets, 0,
                              node_effects(e, names, sets)))

kids_effects(xs: Expr[], names: str[], sets: str[], i: int,
             acc: str) -> str =>
    i >= xs.length()
        ? acc
        : kids_effects(xs, names, sets, i + 1,
                       eff_union(acc, expr_effects(xs.get(i), names, sets)))

body_effects(body: Stmt[], names: str[], sets: str[], i: int,
             acc: str) -> str =>
    i >= body.length()
        ? acc
        : body_effects(body, names, sets, i + 1,
                       eff_union(acc, expr_effects(body.get(i).value, names,
                                                   sets)))

effect_fn_names(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind == SFn {
        effect_fn_names(items, i + 1, acc.push(items.get(i).name))
    } else {
        effect_fn_names(items, i + 1, acc)
    }
}

blank_effects(n: int, i: int, acc: str[]) -> str[] =>
    i >= n ? acc : blank_effects(n, i + 1, acc.push(eff_none()))

/// A function performs what it calls, so the answer is the fixed point of one pass repeated.
settled_effects(items: Stmt[]) -> str[] {
    names = effect_fn_names(items, 0, [])

    settle_effects(items, names, blank_effects(names.length(), 0, []),
                   names.length() + 1)
}

settle_effects(items: Stmt[], names: str[], sets: str[],
               fuel: int) -> str[] {
    next = effect_pass(items, names, sets, 0, [])

    if fuel <= 0 || same_effects(sets, next, 0) {
        next
    } else {
        settle_effects(items, names, next, fuel - 1)
    }
}

same_effects(a: str[], b: str[], i: int) -> bool {
    if i >= a.length() || i >= b.length() {
        a.length() == b.length()
    } else if a.get(i) != b.get(i) {
        false
    } else {
        same_effects(a, b, i + 1)
    }
}

effect_pass(items: Stmt[], names: str[], sets: str[], i: int,
            acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind != SFn {
        effect_pass(items, names, sets, i + 1, acc)
    } else {
        effect_pass(items, names, sets, i + 1,
                    acc.push(body_effects(items.get(i).body, names, sets, 0,
                                          eff_none())))
    }
}

/// Every function whose effects the target being built for cannot carry.
target_errors(m: Module, target: str) -> Diagnostic[] {
    allowed = target_effects(target)

    if allowed.length() >= effect_list().length() {
        []
    } else {
        effect_refusals(m.items, settled_effects(m.items), allowed, target,
                        0, 0, [])
    }
}

effect_refusals(items: Stmt[], sets: str[], allowed: str[], target: str,
                i: int, k: int, acc: Diagnostic[]) -> Diagnostic[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind != SFn {
        effect_refusals(items, sets, allowed, target, i + 1, k, acc)
    } else {
        said = effect_refusal(items.get(i), sets.get(k), allowed, target)

        effect_refusals(items, sets, allowed, target, i + 1, k + 1,
                        acc ++ said)
    }
}

effect_refusal(s: Stmt, set: str, allowed: str[],
               target: str) -> Diagnostic[] {
    over = eff_outside(set, allowed)

    over.length() == 0 ? [] : [effect_diag(s, over.join(", "), target)]
}

effect_diag(s: Stmt, what: str, target: str) -> Diagnostic {
    said = diag_at(s, "M0007", "`{s.name}` performs {what}, which"
                                   ++ " {target_phrase(target)} cannot carry")

    said with { note = "build for a target that can, or keep {what} out of"
                           ++ " the code this target compiles" }
}

target_phrase(target: str) -> str =>
    target == "all" ? "every program target" : "the `{target}` target"

/// Every defect, and then whether the target being built for can carry what the program does.
check_diagnostics_on(m: Module, target: str) -> Diagnostic[] =>
    check_diagnostics(m) ++ target_errors(m, target)

check_errors_on(m: Module, target: str) -> str[] =>
    check_diagnostics_on(m, target).map(diag_message)
