import maca/token

is_space(c: str) -> bool => c.is_whitespace()
is_digit(c: str) -> bool => c.is_ascii_digit()
is_alpha(c: str) -> bool => c.is_alpha() || c == "_"
is_alnum(c: str) -> bool => is_alpha(c) || is_digit(c)

run_end(cs: str[], i: int, pred) -> int {
    if i < cs.length() && pred(cs.get(i)) {
        run_end(cs, i + 1, pred)
    } else {
        i
    }
}

span(cs: str[], i: int, j: int) -> str =>
    cs.slice(i, j).join("")

Lexed = {
    tokens: Token[]
    marks: Token[]
    errors: str[]
    pos: int
    broke: bool
    depth: int
}

lexed(tokens: Token[], errors: str[]) -> Lexed =>
    Lexed { tokens, marks = [], errors, pos = 0, broke = false, depth = 0 }

group_step(k: Kind) -> int {
    if k == LParen || k == LBracket {
        1
    } else if k == RParen || k == RBracket {
        -1
    } else {
        0
    }
}

/** A token that opens a line is marked, so a postfix `[` or `.` cannot reach
 * back across it.
 */
keep(acc: Lexed, t: Token) -> Lexed {
    moved = acc.depth + group_step(t.kind)

    acc with { tokens = acc.tokens.push(t with { fresh = acc.broke
                                                     && acc.depth == 0 }),
               depth = moved < 0 ? 0 : moved,
               broke = false }
}

mark(acc: Lexed, t: Token) -> Lexed =>
    acc with { marks = acc.marks.push(t) }

crossed(acc: Lexed, c: str) -> Lexed =>
    acc with { broke = acc.broke || c == "\n" }

moved(acc: Lexed, i: int) -> Lexed =>
    acc with { pos = i }

note_error(acc: Lexed, msg: str) -> Lexed =>
    acc with { errors = acc.errors + [msg] }

lex(src: str) -> Token[] =>
    lex_all(src).tokens

/** The comments, in source order, which a formatter needs and a parser must not
 * see.
 */
lex_marked(src: str) -> Token[] =>
    lex_all(src).marks

lex_all(src: str) -> Lexed {
    cs = src.chars()
    scanned = scan(cs, lexed([], []), cs.length())

    end_run(scanned, cs.length(), 0)
}

scan(cs: str[], out: Lexed, hi: int) -> Lexed {
    if out.pos >= hi {
        out
    } else if hi - out.pos == 1 {
        step(cs, out)
    } else {
        halves(cs, out, hi, out.pos + (hi - out.pos) / 2)
    }
}

halves(cs: str[], out: Lexed, hi: int, mid: int) -> Lexed {
    left = scan(cs, emptied(out), mid)
    right = scan(cs, emptied(left), hi)

    merged_runs(out, left, right)
}

emptied(acc: Lexed) -> Lexed =>
    Lexed { tokens = [], marks = [], errors = [], pos = acc.pos,
            broke = acc.broke, depth = acc.depth }

merged_runs(out: Lexed, left: Lexed, right: Lexed) -> Lexed =>
    Lexed { tokens = out.tokens + left.tokens + right.tokens,
            marks = out.marks + left.marks + right.marks,
            errors = out.errors + left.errors + right.errors,
            pos = right.pos, broke = right.broke, depth = right.depth }

end_run(out: Lexed, i: int, n: int) -> Lexed {
    if n >= 4 {
        out
    } else {
        end_run(keep(out, mk_token(Eof, "", i)), i, n + 1)
    }
}

step(cs: str[], out: Lexed) -> Lexed {
    i = out.pos
    c = cs.get(i)
    match true {
        _ if is_space(c)   => moved(crossed(out, c), i + 1)
        _ if blocks(cs, i)   => lex_block(cs, i, out)
        _ if comments(cs, i) => lex_comment(cs, i, out)
        _ if triple(cs, i) => lex_raw(cs, i, out)
        _ if c == "\""     => lex_string(cs, i, out)
        _ if is_digit(c)   => lex_number(cs, i, out)
        _ if is_alpha(c)   => lex_word(cs, i, out)
        _                  => lex_punct(cs, i, out, c)
    }
}

lex_comment(cs: str[], i: int, out: Lexed) -> Lexed {
    j = line_end(cs, i)

    moved(mark(out, mk_token(Comment, span(cs, i, j), i)), j)
}

comments(cs: str[], i: int) -> bool =>
    cs.get(i) == "/" && i + 1 < cs.length() && cs.get(i + 1) == "/"

blocks(cs: str[], i: int) -> bool =>
    cs.get(i) == "/" && i + 1 < cs.length() && cs.get(i + 1) == "*"

lex_block(cs: str[], i: int, out: Lexed) -> Lexed {
    j = shut_block(cs, i)

    moved(mark(out, mk_token(Comment, span(cs, i, j), i)), j)
}

/** A block ends at its first closing mark, and one nobody closed runs to the
 * end of the file rather than eating the parser.
 */
shut_block(cs: str[], i: int) -> int {
    j = i + 2

    while j + 1 < cs.length() {
        if cs.get(j) == "*" && cs.get(j + 1) == "/" {
            return j + 2
        }

        j = j + 1
    }

    cs.length()
}

line_end(cs: str[], i: int) -> int {
    j = i
    while j < cs.length() && cs.get(j) != "\n" {
        j = j + 1
    }
    j
}

triple(cs: str[], i: int) -> bool =>
    cs.get(i) == "\"" && at_or_blank(cs, i + 1) == "\""
        && at_or_blank(cs, i + 2) == "\""

raw_end(cs: str[], i: int) -> int {
    j = i
    while j + 2 < cs.length() {
        if triple(cs, j) {
            return j
        }
        j = j + 1
    }
    cs.length()
}

lex_raw(cs: str[], i: int, out: Lexed) -> Lexed {
    j = raw_end(cs, i + 3)
    text = escape_raw(span(cs, i + 3, j).chars(), 0, "")
    held = keep(unterminated(out, cs, j), mk_token(TStr, text, i))

    moved(held, j + 3)
}

escape_raw(cs: str[], i: int, acc: str) -> str {
    parts = "".chars()
    j = i
    while j < cs.length() {
        parts = parts.push(raw_char(cs.get(j)))
        j = j + 1
    }
    acc + parts.join("")
}

raw_char(c: str) -> str {
    if c == "\\" {
        "\\\\"
    } else if c == "\"" {
        "\\\""
    } else if c == "\n" {
        "\\n"
    } else if c == "\r" {
        "\\r"
    } else if c == "\t" {
        "\\t"
    } else if c == "{{" {
        "{{{{"
    } else if c == "}}" {
        "}}}}"
    } else {
        c
    }
}

lex_string(cs: str[], i: int, out: Lexed) -> Lexed {
    j = string_end(cs, i + 1)

    if j < 0 {
        return escaped_in_interp(cs, i, out)
    }

    text = folded(cs, i + 1, j)
    held = keep(unclosed(out, cs, i + 1, j), mk_token(TStr, text, i))

    moved(held, j + 1)
}

/** A newline inside a plain string continues it: the break and the
 * indentation after it fold to one space, so a long class list wraps without
 * a `+`.
 */
folded(cs: str[], a: int, b: int) -> str {
    out = "".chars()
    stop = b < cs.length() ? b : cs.length()
    i = a

    while i < stop {
        c = cs.get(i)

        if c == "\\" && i + 1 < stop {
            out = out.push(c)
            out = out.push(cs.get(i + 1))
            i = i + 2
        } else if c == "\n" || c == "\r" {
            out = out.push(" ")
            i = past_break(cs, i, stop)
        } else {
            out = out.push(c)
            i = i + 1
        }
    }

    out.join("")
}

past_break(cs: str[], i: int, b: int) -> int {
    j = cs.get(i) == "\r" && i + 1 < b && cs.get(i + 1) == "\n" ? i + 2
                                                                 : i + 1

    while j < b && (cs.get(j) == " " || cs.get(j) == "\t") {
        j = j + 1
    }

    j
}

/** Inside `{…}` the text is code, so a backslash there is not an escape and
 * would reach the back end as one.
 */
escaped_in_interp(cs: str[], i: int, out: Lexed) -> Lexed {
    shut = plain_end(cs, i + 1)
    held = note_error(out, "a `\\` inside an interpolation is not an escape:" +
                           " a string written inside `{{…}}` is quoted" +
                           " plainly, as in `xs.join(\", \")`")

    moved(keep(held, mk_token(TStr, span(cs, i + 1, shut), i)), shut + 1)
}

/** Where the string would end if nothing in it were special, which is how the
 * lexer gets past a bad one.
 */
plain_end(cs: str[], i: int) -> int {
    j = i

    while j < cs.length() {
        if cs.get(j) == "\\" {
            j = j + 2
        } else if cs.get(j) == "\"" {
            return j
        } else {
            j = j + 1
        }
    }

    j
}

unclosed(out: Lexed, cs: str[], from: int, j: int) -> Lexed {
    if j < cs.length() {
        out
    } else if opens_interp(cs, from, j) {
        note_error(out, "unterminated interpolation: a literal `{{` in a" +
                        " string is written `{{{{`")
    } else {
        note_error(out, "unterminated string")
    }
}

opens_interp(cs: str[], from: int, j: int) -> bool {
    k = from
    while k < j {
        if cs.get(k) == "\\" {
            k = k + 2
        } else if doubled(cs, k, "{{") {
            k = k + 2
        } else if cs.get(k) == "{{" {
            return true
        } else {
            k = k + 1
        }
    }
    false
}

string_end(cs: str[], i: int) -> int {
    j = i
    while j < cs.length() {
        if cs.get(j) == "\\" {
            j = j + 2
        } else if doubled(cs, j, "{{") || doubled(cs, j, "}}") {
            j = j + 2
        } else if cs.get(j) == "{{" {
            j = interp_end(cs, j + 1, 1)

            if j < 0 {
                return 0 - 1
            }
        } else if cs.get(j) == "\"" {
            return j
        } else {
            j = j + 1
        }
    }
    j
}

doubled(cs: str[], i: int, c: str) -> bool =>
    cs.get(i) == c && i + 1 < cs.length() && cs.get(i + 1) == c

interp_end(cs: str[], i: int, depth: int) -> int {
    j = i
    d = depth
    while j < cs.length() {
        c = cs.get(j)
        if c == "\\" {
            return 0 - 1
        } else if c == "\"" {
            j = quoted_end(cs, j + 1) + 1
        } else if c == "{{" {
            j = j + 1
            d = d + 1
        } else if c == "}}" && d == 1 {
            return j + 1
        } else if c == "}}" {
            j = j + 1
            d = d - 1
        } else {
            j = j + 1
        }
    }
    j
}

quoted_end(cs: str[], i: int) -> int {
    j = i
    while j < cs.length() {
        if cs.get(j) == "\\" {
            j = j + 2
        } else if cs.get(j) == "\"" {
            return j
        } else {
            j = j + 1
        }
    }
    j
}

lex_word(cs: str[], i: int, out: Lexed) -> Lexed {
    j = word_end(cs, run_end(cs, i, is_alnum))
    text = span(cs, i, j)

    moved(keep(out, mk_token(keyword_kind(text), text, i)), j)
}

/** An attached `-` is part of the name, and a spaced one subtracts. */
word_end(cs: str[], j: int) -> int {
    if j + 1 < cs.length() && cs.get(j) == "-" && is_alpha(cs.get(j + 1)) {
        word_end(cs, run_end(cs, j + 1, is_alnum))
    } else {
        j
    }
}

lex_number(cs: str[], i: int, out: Lexed) -> Lexed {
    j = run_end(cs, i, is_digit)
    has_fraction = j + 1 < cs.length() && cs.get(j) == "."
        && is_digit(cs.get(j + 1))

    if based(cs, i) {
        lex_based(cs, i, out)
    } else if has_fraction {
        lex_float(cs, i, j, out)
    } else {
        moved(keep(out, mk_token(TInt, span(cs, i, j), i)), j)
    }
}

/** `0x…` and `0b…`, which a register address and a bit mask are written as.
 */
based(cs: str[], i: int) -> bool {
    if cs.get(i) != "0" || i + 2 >= cs.length() {
        false
    } else {
        marker = cs.get(i + 1)

        (marker == "x" || marker == "b") && is_base_digit(cs.get(i + 2))
    }
}

is_base_digit(c: str) -> bool {
    v = ord(c)

    is_digit(c) || (v >= 97 && v <= 102) || (v >= 65 && v <= 70)
}

lex_based(cs: str[], i: int, out: Lexed) -> Lexed {
    j = run_end(cs, i + 2, is_base_digit)
    n = from_base(cs, i + 2, j, cs.get(i + 1) == "x" ? 16 : 2, 0)

    moved(keep(out, mk_token(TInt, str(n), i)), j)
}

from_base(cs: str[], i: int, j: int, base: int, acc: int) -> int {
    if i >= j {
        acc
    } else {
        from_base(cs, i + 1, j, base, acc * base + digit_value(cs.get(i)))
    }
}

digit_value(c: str) -> int {
    v = ord(c)

    if is_digit(c) {
        int(c)
    } else if v >= 97 {
        v - 97 + 10
    } else {
        v - 65 + 10
    }
}

lex_float(cs: str[], i: int, dot: int, out: Lexed) -> Lexed {
    k = run_end(cs, dot + 1, is_digit)

    moved(keep(out, mk_token(TFloat, span(cs, i, k), i)), k)
}

at_or_blank(cs: str[], i: int) -> str {
    if i < cs.length() {
        cs.get(i)
    } else {
        ""
    }
}

lex_punct(cs: str[], i: int, out: Lexed, c: str) -> Lexed {
    two = c + at_or_blank(cs, i + 1)
    three = two + at_or_blank(cs, i + 2)

    if three == "..." {
        moved(keep(out, mk_token(Ellipsis, three, i)), i + 3)
    } else if is_two_char(two) {
        moved(keep(out, mk_token(two_char_kind(two), two, i)), i + 2)
    } else {
        moved(keep(unknown(out, c, i), mk_token(one_char_kind(cs, i, c), c, i)),
              i + 1)
    }
}

/** A `?` written tight against the value before it propagates; a spaced one
 * opens a ternary.
 */
one_char_kind(cs: str[], i: int, c: str) -> Kind {
    if c == "?" && i > 0 && !is_space(cs.get(i - 1)) {
        QuestionPost
    } else {
        punct_kind(c)
    }
}

is_two_char(s: str) -> bool =>
    s == "->" || s == "=>" || s == "==" || s == "!=" ||
    s == "<=" || s == ">=" || s == "++" || s == "&&" || s == "||" ||
    s == "<<" || s == ">>" || s == ".." || s == "|>"

two_char_kind(s: str) -> Kind =>
    match s {
        ".." => DotDot
        "->" => Arrow
        "=>" => FatArrow
        "==" => EqEq
        "!=" => NotEq
        "<=" => Le
        ">=" => Ge
        "<<" => Shl
        ">>" => Shr
        "++" => PlusPlus
        "&&" => AmpAmp
        "||" => PipePipe
        "|>" => PipeGt
        _    => TIdent
    }

punct_kind(c: str) -> Kind =>
    match c {
        "(" => LParen
        ")" => RParen
        "[" => LBracket
        "]" => RBracket
        "{{" => LBrace
        "}}" => RBrace
        "," => Comma
        ":" => Colon
        "." => Dot
        "=" => Eq
        "+" => Plus
        "-" => Minus
        "*" => Star
        "/" => Slash
        "%" => Percent
        "|" => Bar
        "?" => Question
        "!" => Bang
        "<" => Lt
        ">" => Gt
        _   => TIdent
    }

unterminated(out: Lexed, cs: str[], j: int) -> Lexed {
    if j >= cs.length() {
        note_error(out, "unterminated string")
    } else {
        out
    }
}

unknown(out: Lexed, c: str, i: int) -> Lexed {
    if punct_kind(c) == TIdent {
        note_error(out, "unexpected character `{c}` at {i}")
    } else {
        out
    }
}
