// maca/ast: the compiler's own tree, and the printer a diagnostic quotes it with.

import maca/token

ExprKind =
    EInt | EFloat | EStr | EBool | EIdent
    | ECall | EField | EBinary | EUnary | ETernary | EIf
    | EList | ERecord | EWith | ELambda | EBlock | EMatch | EMethod
    | EGuard | EWhile | EFor | EJump | EAttr | EBad

Expr = {
    kind:     ExprKind
    text:     str
    ival:     int
    ty:       str
    children: Expr[]
    stmts:    Stmt[]
}

StmtKind = SExpr | SBind | SSet | SFn | SRecord | SSum

Stmt = {
    kind:   StmtKind
    name:   str
    value:  Expr
    ret:    str
    pos:    int
    params: Expr[]
    body:   Stmt[]
    frozen: bool
}

Module = {
    items:  Stmt[]
    errors: str[]
}

e_int(n: int) -> Expr =>
    Expr { kind = EInt, text = "", ival = n, ty = "", children = [],
           stmts = [] }

e_ident(name: str) -> Expr =>
    Expr { kind = EIdent, text = name, ival = 0, ty = "", children = [],
           stmts = [] }

e_bad(text: str) -> Expr =>
    Expr { kind = EBad, text, ival = 0, ty = "", children = [], stmts = [] }

e_param(name: str, ty: str) -> Expr =>
    Expr { kind = EIdent, text = name, ival = 0, ty, children = [], stmts = [] }

e_typed(name: str, ty: str) -> Expr =>
    Expr { kind = EIdent, text = name, ival = 0, ty, children = [], stmts = [] }

with_child(e: Expr, c: Expr) -> Expr =>
    Expr { kind = e.kind, text = e.text, ival = e.ival, ty = e.ty,
           children = e.children ++ [c], stmts = e.stmts }

e_str(s: str) -> Expr =>
    Expr { kind = EStr, text = s, ival = 0, ty = "", children = [], stmts = [] }

e_bool(text: str) -> Expr =>
    Expr { kind = EBool, text, ival = 0, ty = "", children = [], stmts = [] }

e_float(text: str) -> Expr =>
    Expr { kind = EFloat, text, ival = 0, ty = "", children = [], stmts = [] }

e_call(callee: str, args: Expr[]) -> Expr =>
    Expr { kind = ECall, text = callee, ival = 0, ty = "", children = args,
           stmts = [] }

e_binary(op: str, lhs: Expr, rhs: Expr) -> Expr =>
    Expr { kind = EBinary, text = op, ival = 0, ty = "",
           children = [lhs, rhs], stmts = [] }

e_ternary(cond: Expr, then: Expr, els: Expr) -> Expr =>
    Expr { kind = ETernary, text = "", ival = 0, ty = "",
           children = [cond, then, els], stmts = [] }

e_if(cond: Expr, then: Expr, els: Expr) -> Expr =>
    Expr { kind = EIf, text = "", ival = 0, ty = "",
           children = [cond, then, els], stmts = [] }

e_unary(op: str, operand: Expr) -> Expr =>
    Expr { kind = EUnary, text = op, ival = 0, ty = "",
           children = [operand], stmts = [] }

e_record(tyname: str, fields: Expr[]) -> Expr =>
    Expr { kind = ERecord, text = tyname, ival = 0, ty = "",
           children = fields, stmts = [] }

e_with(base: Expr, fields: Expr[]) -> Expr =>
    Expr { kind = EWith, text = "", ival = 0, ty = "",
           children = [base] ++ fields, stmts = [] }

e_field(base: Expr, name: str) -> Expr =>
    Expr { kind = EField, text = name, ival = 0, ty = "",
           children = [base], stmts = [] }

e_match(children: Expr[]) -> Expr =>
    Expr { kind = EMatch, text = "", ival = 0, ty = "",
           children = children, stmts = [] }

e_method(recv: Expr, name: str, args: Expr[]) -> Expr =>
    Expr { kind = EMethod, text = name, ival = 0, ty = "",
           children = [recv] ++ args, stmts = [] }

e_attr(name: str, value: Expr) -> Expr =>
    Expr { kind = EAttr, text = name, ival = 0, ty = "", children = [value],
           stmts = [] }

e_list(elems: Expr[]) -> Expr =>
    Expr { kind = EList, text = "", ival = 0, ty = "", children = elems,
           stmts = [] }

s_expr(value: Expr) -> Stmt =>
    Stmt { kind = SExpr, name = "", value, ret = "", pos = 0,
           params = [], body = [], frozen = false }

/// A `=>` body is one expression, so a `return` in it stands where no statement does.
s_arrow(value: Expr) -> Stmt =>
    Stmt { kind = SExpr, name = "", value, ret = "", pos = 0,
           params = [], body = [], frozen = true }

s_bind(name: str, value: Expr) -> Stmt =>
    Stmt { kind = SBind, name, value, ret = "", pos = 0, params = [],
           body = [], frozen = false }

s_bind_typed(name: str, ty: str, value: Expr) -> Stmt =>
    Stmt { kind = SBind, name, value, ret = ty, pos = 0, params = [],
           body = [], frozen = false }

s_fn(name: str, ret: str, params: Expr[], body: Stmt[]) -> Stmt =>
    Stmt { kind = SFn, name, value = e_ident(name), ret, pos = 0, params,
           body, frozen = false }

s_record(name: str, fields: Expr[]) -> Stmt =>
    Stmt { kind = SRecord, name, value = e_ident(name), ret = "", pos = 0,
           params = fields, body = [], frozen = false }

/// A record of lambdas bound under a declared type name implements that type for the record it names.
is_impl_block(s: Stmt) -> bool =>
    s.kind == SBind && upper_word(s.ret) && s.value.kind == ERecord
        && s.value.children.length() > 0
        && all_lambda_fields(s.value.children, 0)

/// A capitalized type this module never declared belongs to whatever the program links against.
foreign_type(ty: str, own: str[]) -> bool =>
    ty.index_of("[]") < 0 && upper_word(ty) && own.index_of(head_type(ty)) < 0
        && upper_word(head_type(ty))

head_type(ty: str) -> str {
    cut = ty.index_of(" ")

    cut < 0 ? ty : ty.slice(0, cut)
}

/// Every type this module declares itself; anything else capitalized is foreign to it.
declared_types(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind == SRecord || items.get(i).kind == SSum {
        declared_types(items, i + 1, acc ++ [items.get(i).name])
    } else {
        declared_types(items, i + 1, acc)
    }
}

upper_word(w: str) -> bool =>
    w.length() > 0 && w.at(0).is_alpha() && w.at(0).upper() == w.at(0)

all_lambda_fields(fs: Expr[], i: int) -> bool {
    if i >= fs.length() {
        true
    } else if fs.get(i).children.length() < 2
            || fs.get(i).children.get(1).kind != ELambda {
        false
    } else {
        all_lambda_fields(fs, i + 1)
    }
}

s_sum(name: str, variants: Expr[]) -> Stmt =>
    Stmt { kind = SSum, name, value = e_ident(name), ret = "", pos = 0,
           params = variants, body = [], frozen = false }

show(e: Expr) -> str =>
    match e.kind {
        EInt    => str(e.ival)
        EFloat  => e.text
        EStr    => e.text
        EBool   => e.text
        EIdent  => e.text
        ECall   => "{e.text}({show_args(e.children, 0)})"
        EBinary => "({show(e.children.get(0))} {e.text} {show(e.children.get(1))})"
        ETernary => "({show(e.children.get(0))} ? {show(e.children.get(1))} : {show(e.children.get(2))})"
        EIf     => "(if {show(e.children.get(0))} then {show(e.children.get(1))} else {show(e.children.get(2))})"
        EUnary  => "({e.text}{show(e.children.get(0))})"
        ERecord => "{e.text} {{ {show_args(e.children, 0)} }}"
        EWith   => "{show(e.children.get(0))} with {{ {show_args(e.children, 1)} }}"
        EField  => "{show(e.children.get(0))}.{e.text}"
        EMatch  => "match {show(e.children.get(0))} {{ ... }}"
        EMethod => "{show(e.children.get(0))}.{e.text}({show_args(e.children, 1)})"
        EList   => "[{show_args(e.children, 0)}]"
        EAttr   => "{e.text}={show(e.children.get(0))}"
        EJump   => e.text
        EWhile  => "while {show(e.children.get(0))} {{ ... }}"
        EFor    => "for {e.text} in {show(e.children.get(0))} {{ ... }}"
        _       => "?"
    }

show_args(xs: Expr[], i: int) -> str =>
    xs.slice(i, xs.length()).map(show).join(", ")

e_guard(pat: Expr, when: Expr) -> Expr =>
    Expr { kind = EGuard, text = pat.text, ival = 0, ty = "",
           children = [pat, when], stmts = [] }

e_while(cond: Expr, body: Stmt[]) -> Expr =>
    Expr { kind = EWhile, text = "", ival = 0, ty = "",
           children = [cond], stmts = body }

e_lambda(params: Expr[], body: Expr) -> Expr =>
    Expr { kind = ELambda, text = "", ival = 0, ty = "",
           children = params ++ [body], stmts = [] }

lambda_body(e: Expr) -> Expr =>
    e.children.get(e.children.length() - 1)

lambda_params(e: Expr) -> Expr[] =>
    e.children.slice(0, e.children.length() - 1)

e_for(binder: str, over: Expr, body: Stmt[]) -> Expr =>
    Expr { kind = EFor, text = binder, ival = 0, ty = "",
           children = [over], stmts = body }

e_jump(word: str) -> Expr =>
    Expr { kind = EJump, text = word, ival = 0, ty = "", children = [],
           stmts = [] }

e_leave(value: Expr[]) -> Expr =>
    Expr { kind = EJump, text = "return", ival = 0, ty = "",
           children = value, stmts = [] }

e_block(stmts: Stmt[], last: Expr) -> Expr =>
    Expr { kind = EBlock, text = "", ival = 0, ty = "",
           children = [last], stmts }

at_pos(s: Stmt, p: int) -> Stmt =>
    s with { pos = p }

/// An entry type is written `Entry element`, which is what `enumerate` answers with.
is_entry_type(ty: str) -> bool =>
    ty.length() > 6 && ty.slice(0, 6) == "Entry "

entry_value_type(ty: str) -> str =>
    is_entry_type(ty) ? ty.slice(6, ty.length()) : ""

/// A map type is written `Map key value`, so its key is the word after the head.
map_type_key(ty: str) -> str {
    rest = map_type_rest(ty)
    cut = rest.index_of(" ")

    if cut < 0 {
        ""
    } else {
        rest.slice(0, cut)
    }
}

/// The type a lookup in this map answers with, empty when the type is not a map.
map_type_val(ty: str) -> str {
    rest = map_type_rest(ty)
    cut = rest.index_of(" ")

    if cut < 0 {
        ""
    } else {
        rest.slice(cut + 1, rest.length())
    }
}

map_type_rest(ty: str) -> str {
    if ty.length() > 4 && ty.slice(0, 4) == "Map " {
        ty.slice(4, ty.length())
    } else {
        ""
    }
}

ElementTags = " html head title meta link style script body div span p pre code a button input textarea select option label form header footer main section article nav aside ul ol li table thead tbody tr td th h1 h2 h3 h4 h5 h6 img svg canvas small strong em b i hr br blockquote figure figcaption details summary dialog progress meter video audio "

/// `element` names its tag with its first argument; every other tag is its own name.
is_element_tag(name: str) -> bool =>
    name == "element" || ElementTags.index_of(" {name} ") >= 0
        || (tag_lower(name) && name.index_of("-") > 0)

tag_lower(w: str) -> bool =>
    w != "" && ord(w.at(0)) >= ord("a") && ord(w.at(0)) <= ord("z")
