Kind =
    TInt | TFloat | TIdent | TStr | TPath
    | KwLet | KwIf | KwElse | KwFor | KwIn | KwMatch
    | KwWhile | KwBreak | KwContinue | KwReturn
    | KwImport | KwWith | KwFail | KwTry | KwAlias
    | KwTrue | KwFalse
    | LParen | RParen | LBracket | RBracket | LBrace | RBrace
    | Comma | Colon | Dot | DotDot | Ellipsis | Arrow | FatArrow
    | Eq | EqEq | NotEq | Lt | Gt | Le | Ge | AmpAmp | PipePipe
    | Plus | Minus | Star | Slash | Percent | PlusPlus | Bar
    | Question | QuestionPost | Bang
    | Comment | Newline | Eof

Token = {
    kind: Kind
    text: str
    pos:  int
}

keyword_kind(w: str) -> Kind =>
    match w {
        "let"    => KwLet
        "if"     => KwIf
        "else"   => KwElse
        "for"    => KwFor
        "in"     => KwIn
        "while"  => KwWhile
        "break"  => KwBreak
        "continue" => KwContinue
        "return" => KwReturn
        "match"  => KwMatch
        "import" => KwImport
        "with"   => KwWith
        "fail"   => KwFail
        "try"    => KwTry
        "alias"  => KwAlias
        "true"   => KwTrue
        "false"  => KwFalse
        _        => TIdent
    }

mk_token(kind: Kind, text: str, pos: int) -> Token =>
    Token { kind, text, pos }
