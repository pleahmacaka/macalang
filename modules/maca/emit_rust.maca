import maca/token
import maca/ast

rust_int(n: int) -> str =>
    "{str(n)}i64"

rust_str(s: str) -> str =>
    "\"" ++ s ++ "\".to_string()"

RustReserved = " as async await become box break const continue crate do dyn else enum extern false final fn for if impl in let loop macro match mod move mut override priv pub ref return self Self static struct super trait true try type typeof union unsafe unsized use virtual where while yield "

rid(name: str) -> str {
    if RustReserved.index_of(" {name} ") >= 0 {
        "{name}_mc"
    } else {
        name
    }
}

rcopy(ty: str) -> bool =>
    ty == "" || ty == "int" || ty == "float" || ty == "bool" || r_is_fn(ty)

rowned(ty: str) -> str {
    if rcopy(ty) {
        ""
    } else {
        ".clone()"
    }
}

remit_expr(e: Expr) -> str =>
    match e.kind {
        EInt     => rust_int(e.ival)
        EFloat   => "{e.text}_f64"
        EStr     => rust_str(e.text)
        EBool    => e.text
        EIdent   => "{rid(e.text)}{rowned(e.ty)}"
        ECall    => remit_call(e)
        EBinary  => remit_binary(e)
        ETernary => remit_ternary(e)
        EIf      => remit_ternary(e)
        EUnary   => remit_unary(e)
        ERecord  => "{e.text} {{ {remit_lit_fields(e.children)} }}"
        EWith    => remit_with(e)
        EBlock   => remit_block(e)
        EField   => "{rfield(e)}"
        EMatch   => remit_match(e)
        EMethod  => remit_method(e)
        EList    => "Rc::new(vec![{remit_args(e.children, 0)}])"
        EJump    => rjump(e)
        EWhile   => remit_while(e)
        EFor     => remit_for(e)
        ELambda  => remit_lambda(e)
        _        => "0i64"
    }

rfield(e: Expr) -> str =>
    "{rplace(e.children.get(0))}.{rid(e.text)}{rowned(e.ty)}"

rplace(e: Expr) -> str {
    if e.kind == EIdent {
        rid(e.text)
    } else if e.kind == EField {
        "{rplace(e.children.get(0))}.{rid(e.text)}"
    } else {
        remit_expr(e)
    }
}

rjump(e: Expr) -> str {
    if e.children.length() == 0 {
        e.text
    } else {
        "{e.text} {remit_expr(e.children.get(0))}"
    }
}

remit_lambda(e: Expr) -> str =>
    "|{lambda_params(e).map(binder_name).join(", ")}|"
        ++ " {remit_expr(lambda_body(e))}"

remit_while(e: Expr) -> str =>
    "while {remit_expr(e.children.get(0))}"
        ++ " {{ {rblock_stmts(e.stmts, 0)}}}"

remit_for(e: Expr) -> str =>
    "for {rid(e.text)} in ({remit_expr(e.children.get(0))}).iter().cloned()"
        ++ " {{ {rblock_stmts(e.stmts, 0)}}}"

remit_unary(e: Expr) -> str {
    if e.text == "fail" {
        "panic!(\"{{}}\", {remit_expr(e.children.get(0))})"
    } else {
        "({e.text}{remit_expr(e.children.get(0))})"
    }
}

remit_ternary(e: Expr) -> str {
    if rmissing_else(e.children.get(2)) {
        rif_stmt(e)
    } else {
        cond = remit_expr(e.children.get(0))
        then = remit_expr(e.children.get(1))
        els = remit_expr(e.children.get(2))

        "(if {cond} {{ {then} }} else {{ {els} }})"
    }
}

rmissing_else(e: Expr) -> bool =>
    e.kind == EIdent && e.text == "?"

rif_stmt(e: Expr) -> str {
    cond = remit_expr(e.children.get(0))
    then = rbranch(e.children.get(1))
    els = e.children.get(2)

    if rmissing_else(els) {
        "if {cond} {then}"
    } else {
        "if {cond} {then} else {rbranch(els)}"
    }
}

rbranch(e: Expr) -> str {
    if e.kind == EIf {
        rif_stmt(e)
    } else if e.kind == EBlock {
        "{{ {rblock_stmts(e.stmts, 0)}{remit_expr(e.children.get(0))}; }}"
    } else {
        "{{ {remit_expr(e)}; }}"
    }
}

remit_match(e: Expr) -> str =>
    "match {remit_match_on(e)} {{ {remit_arms(e.children, 1)} }}"

remit_match_on(e: Expr) -> str {
    scrut = remit_expr(e.children.get(0))

    if has_str_arm(e.children, 1) {
        "{scrut}.as_str()"
    } else {
        scrut
    }
}

has_str_arm(cs: Expr[], i: int) -> bool {
    if i + 1 >= cs.length() {
        false
    } else if cs.get(i).kind == EStr {
        true
    } else {
        has_str_arm(cs, i + 2)
    }
}


rchar_pred(name: str) -> str {
    if name == "is_whitespace" {
        "is_whitespace"
    } else if name == "is_ascii_digit" {
        "is_ascii_digit"
    } else if name == "is_alpha" {
        "is_ascii_alphabetic"
    } else {
        ""
    }
}

rstr_helper(name: str) -> bool =>
    name == "upper" || name == "lower" || name == "trim"
        || name == "contains" || name == "ends_with" || name == "starts_with"
        || name == "replace" || name == "split" || name == "repeat"
        || name == "substr" || name == "pad_start" || name == "pad_end"
        || rchar_pred(name) != ""

remit_str_method(e: Expr, recv: str) -> str {
    pred = rchar_pred(e.text)

    if pred != "" {
        "({recv}).chars().next().map_or(false, |c| c.{pred}())"
    } else if e.text == "upper" {
        "({recv}).to_uppercase()"
    } else if e.text == "lower" {
        "({recv}).to_lowercase()"
    } else if e.text == "trim" {
        "({recv}).trim().to_string()"
    } else if e.text == "repeat" {
        "({recv}).repeat(({rarg(e, 1)}) as usize)"
    } else if e.text == "substr" {
        "maca_substr({recv}, {rarg(e, 1)}, {rarg(e, 2)})"
    } else if e.text == "pad_start" || e.text == "pad_end" {
        "maca_{e.text}({recv}, {rarg(e, 1)})"
    } else if e.text == "replace" {
        "({recv}).replace({rarg(e, 1)}.as_str(), {rarg(e, 2)}.as_str())"
    } else if e.text == "split" {
        "Rc::new(({recv}).split({rarg(e, 1)}.as_str())"
            ++ ".map(|p| p.to_string()).collect::<Vec<String>>())"
    } else {
        "({recv}).{e.text}({rarg(e, 1)}.as_str())"
    }
}

rlist_method(name: str) -> bool =>
    name == "sum" || name == "min" || name == "max" || name == "first"
        || name == "last" || name == "pop" || name == "reverse"
        || name == "sort" || name == "set" || name == "insert"
        || name == "remove" || name == "filter" || name == "reduce"

rlist_method_of(e: Expr, recv: str) -> str {
    el = relem(e.children.get(0).ty)

    if e.text == "sum" {
        "({recv}).iter().cloned().sum::<{rtype(el)}>()"
    } else if e.text == "min" || e.text == "max" {
        "({recv}).iter().cloned().{e.text}().unwrap_or_default()"
    } else if e.text == "first" {
        "({recv}).first().cloned().unwrap_or_default()"
    } else if e.text == "last" {
        "({recv}).last().cloned().unwrap_or_default()"
    } else if e.text == "pop" {
        "Rc::new(({recv})[..({recv}).len().saturating_sub(1)].to_vec())"
    } else if e.text == "reverse" {
        "{{ let mut _v = {recv}; Rc::make_mut(&mut _v).reverse(); _v }}"
    } else if e.text == "sort" {
        "{{ let mut _v = {recv};"
            ++ " Rc::make_mut(&mut _v).sort_by(|a, b| a.partial_cmp(b)"
            ++ ".unwrap_or(std::cmp::Ordering::Equal)); _v }}"
    } else if e.text == "remove" {
        "{{ let mut _v = {recv}; let _i = ({rarg(e, 1)}) as usize;"
            ++ " if _i < _v.len() {{ Rc::make_mut(&mut _v).remove(_i); }} _v }}"
    } else if e.text == "insert" {
        "{{ let mut _v = {recv};"
            ++ " let _i = (({rarg(e, 1)}) as usize).min(_v.len());"
            ++ " Rc::make_mut(&mut _v).insert(_i, {rarg(e, 2)}); _v }}"
    } else if e.text == "set" {
        "{{ let mut _v = {recv}; let _i = ({rarg(e, 1)}) as usize;"
            ++ " if _i < _v.len() {{ Rc::make_mut(&mut _v)[_i] = {rarg(e, 2)}; }}"
            ++ " _v }}"
    } else if e.text == "filter" {
        "Rc::new(({recv}).iter().cloned().filter(|_x|"
            ++ " ({rarg(e, 1)})(_x.clone())).collect::<Vec<_>>())"
    } else {
        "({recv}).iter().cloned().fold({rarg(e, 2)}, {rarg(e, 1)})"
    }
}

rarg(e: Expr, i: int) -> str {
    if i >= e.children.length() {
        "Default::default()"
    } else {
        remit_expr(e.children.get(i))
    }
}

rstr_index(e: Expr) -> bool =>
    (e.text == "at" || e.text == "get") && e.children.get(0).ty == "str"

remit_method(e: Expr) -> str {
    recv = remit_expr(e.children.get(0))

    if rstr_helper(e.text) {
        remit_str_method(e, recv)
    } else if e.text == "chars" {
        "Rc::new(({recv}).chars().map(|c| c.to_string())"
            ++ ".collect::<Vec<String>>())"
    } else if e.text == "map" {
        "Rc::new(({recv}).iter().cloned()"
            ++ ".map({remit_expr(e.children.get(1))})"
            ++ ".collect::<Vec<_>>())"
    } else if e.text == "length" || e.text == "count" {
        "(({recv}).len() as i64)"
    } else if rstr_index(e) {
        idx = remit_expr(e.children.get(1))
        "{{ let _i = ({idx}) as usize;"
            ++ " ({recv}).get(_i.._i + 1).unwrap_or(\"\").to_string() }}"
    } else if e.text == "at" {
        idx = remit_expr(e.children.get(1))
        "(({recv}).as_bytes()[({idx}) as usize] as i64)"
    } else if e.text == "get" {
        cell = "{recv}[({remit_expr(e.children.get(1))}) as usize]"
        cell ++ rclone(e.children.get(0).ty)
    } else if e.text == "slice" && rlist(e.children.get(0).ty) {
        lo = remit_expr(e.children.get(1))
        hi = remit_expr(e.children.get(2))
        "Rc::new({recv}[({lo}) as usize..({hi}) as usize].to_vec())"
    } else if e.text == "slice" {
        lo = remit_expr(e.children.get(1))
        hi = remit_expr(e.children.get(2))
        "({recv}).get(({lo}) as usize..({hi}) as usize)"
            ++ ".unwrap_or(\"\").to_string()"
    } else if e.text == "index_of" && e.children.get(0).ty == "str" {
        "({recv}).find({remit_expr(e.children.get(1))}.as_str())"
            ++ ".map(|i| i as i64).unwrap_or(-1)"
    } else if e.text == "index_of" {
        "({recv}).iter().position(|v| *v == {remit_expr(e.children.get(1))})"
            ++ ".map(|i| i as i64).unwrap_or(-1)"
    } else if e.text == "join" {
        "({recv}).join({remit_expr(e.children.get(1))}.as_str())"
    } else if rlist(e.children.get(0).ty) && rlist_method(e.text) {
        rlist_method_of(e, recv)
    } else if e.text == "push" {
        "{{ let mut _v = {recv};"
            ++ " Rc::make_mut(&mut _v).push({remit_expr(e.children.get(1))});"
            ++ " _v }}"
    } else {
        "{recv}.{e.text}({remit_args(e.children, 1)})"
    }
}

remit_call(e: Expr) -> str {
    args = remit_args(e.children, 0)

    if e.text == "info" {
        "println!(\"{{}}\", {rstr_of(rarg_ty(e.children), args)})"
    } else if e.text == "print" {
        "print!(\"{{}}\", {rstr_of(rarg_ty(e.children), args)})"
    } else if e.text == "str" {
        rstr_of(rarg_ty(e.children), args)
    } else if e.text == "int" {
        rint_of(rarg_ty(e.children), args)
    } else if e.text == "float" {
        "(({args}) as f64)"
    } else if e.text == "len" {
        rlen_of(rarg_ty(e.children), args)
    } else if e.text == "err" || e.text == "warn" {
        "eprintln!(\"{{}}\", {rstr_of(rarg_ty(e.children), args)})"
    } else if e.text == "assert_eq" {
        "maca_assert_eq({rshown(e.children, 0)}, {rshown(e.children, 1)},"
            ++ " {rshown(e.children, 2)})"
    } else if e.text == "abs" || e.text == "signum" {
        "({args}).abs()"
    } else if e.text == "sign" {
        "({args}).signum()"
    } else if e.text == "pow" {
        "({rarg(e, 0)} as f64).powf({rarg(e, 1)} as f64)"
    } else if e.text == "log" {
        "(({args}) as f64).ln()"
    } else if rmath_call(e.text) {
        "(({args}) as f64).{e.text}()"
    } else if rpicking(e.text) && e.children.length() == 2 {
        rpick2(e)
    } else if rruntime_call(e.text) {
        "maca_{e.text}({args})"
    } else {
        "{rid(e.text)}({args})"
    }
}

rlen_of(ty: str, args: str) -> str =>
    "(({args}).len() as i64)"

rstr_of(ty: str, args: str) -> str {
    if rlist(ty) {
        "format!(\"[{{}}]\", ({args}).iter()"
            ++ ".map(|_c| format!(\"{{}}\", _c))"
            ++ ".collect::<Vec<String>>().join(\", \"))"
    } else {
        "format!(\"{{}}\", {args})"
    }
}

rmath_call(name: str) -> bool =>
    name == "sqrt" || name == "floor" || name == "ceil" || name == "round"
        || name == "sin" || name == "cos" || name == "tan" || name == "exp"

rpicking(name: str) -> bool =>
    name == "min" || name == "max"

rpick2(e: Expr) -> str {
    a = remit_expr(e.children.get(0))
    b = remit_expr(e.children.get(1))

    "({a}).{e.text}({b})"
}

rshown(cs: Expr[], i: int) -> str {
    if i >= cs.length() {
        "String::new()"
    } else {
        "format!(\"{{}}\", {remit_expr(cs.get(i))})"
    }
}

rruntime_call(name: str) -> bool =>
    name == "read_file" || name == "write_file" || name == "exec"
        || name == "assert" || name == "failures" || name == "sleep_ms"
        || name == "make_dir" || name == "remove_dir" || name == "remove_file"
        || name == "file_exists" || name == "is_dir" || name == "env"
        || name == "cwd" || name == "panic" || name == "is_tty"
        || name == "now_ms" || name == "list_dir" || name == "file_size"
        || name == "chr" || name == "ord" || name == "input"

rarg_ty(cs: Expr[]) -> str {
    if cs.length() == 0 {
        ""
    } else {
        cs.get(0).ty
    }
}

rint_of(ty: str, args: str) -> str {
    if ty == "int" {
        args
    } else if ty == "float" || ty == "bool" {
        "(({args}) as i64)"
    } else {
        "({args}).trim().parse::<i64>().unwrap_or(0)"
    }
}

remit_binary(e: Expr) -> str {
    l = remit_expr(e.children.get(0))
    r = remit_expr(e.children.get(1))

    on_list = rlist(e.children.get(0).ty) || rlist(e.children.get(1).ty)

    lhs = e.children.get(0)

    if e.text == "=" && lhs.kind == EMethod && lhs.text == "get" {
        rstore(lhs, r)
    } else if e.text == ".." {
        "Rc::new((({l})..({r})).collect::<Vec<i64>>())"
    } else if e.text == "++" && on_list {
        "{{ let mut _v = {l};"
            ++ " Rc::make_mut(&mut _v).extend(({r}).iter().cloned());"
            ++ " _v }}"
    } else if e.text == "++" {
        "format!(\"{{}}{{}}\", {l}, {r})"
    } else {
        "({l} {e.text} {r})"
    }
}

rstore(l: Expr, value: str) -> str {
    holder = rplace(l.children.get(0))
    ix = remit_expr(l.children.get(1))

    "Rc::make_mut(&mut {holder})[({ix}) as usize] = {value}"
}

rlist(ty: str) -> bool =>
    ty.length() > 2 && ty.slice(ty.length() - 2, ty.length()) == "[]"

remit_arms(cs: Expr[], i: int) -> str {
    if i + 1 >= cs.length() {
        ""
    } else {
        arm = "{remit_pat(cs.get(i))} => {remit_expr(cs.get(i + 1))}, "
        arm ++ remit_arms(cs, i + 2)
    }
}

remit_pat(p: Expr) -> str {
    if p.kind == EGuard {
        "{remit_pat(p.children.get(0))} if {remit_expr(p.children.get(1))}"
    } else if p.kind == EStr {
        "\"{p.text}\""
    } else if p.children.length() == 0 {
        p.text
    } else {
        "{p.text}({p.children.map(binder_name).join(", ")})"
    }
}

binder_name(b: Expr) -> str =>
    rid(b.text)

remit_block(e: Expr) -> str =>
    "{{ {rblock_stmts(e.stmts, 0)}{remit_expr(e.children.get(0))} }}"

rblock_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        here = remit_stmt(body.get(i), false, rmut(body, i + 1, body.get(i)))

        "{here} {rblock_stmts(body, i + 1)}"
    }
}

rmut(body: Stmt[], i: int, s: Stmt) -> bool {
    if s.kind != SBind {
        false
    } else {
        rassigned_in(body, i, s.name)
    }
}

rassigned_in(body: Stmt[], i: int, name: str) -> bool {
    if i >= body.length() {
        false
    } else if body.get(i).kind == SSet && body.get(i).name == name {
        true
    } else if rassigned_deep(body.get(i).value, name) {
        true
    } else {
        rassigned_in(body, i + 1, name)
    }
}

rassigned_deep(e: Expr, name: str) -> bool =>
    rstored_into(e, name) || rassigned_in(e.stmts, 0, name)
        || rassigned_any(e.children, 0, name)

rstored_into(e: Expr, name: str) -> bool {
    if e.kind != EBinary || e.text != "=" {
        false
    } else {
        lhs = e.children.get(0)

        lhs.kind == EMethod && lhs.text == "get"
            && lhs.children.get(0).kind == EIdent
            && lhs.children.get(0).text == name
    }
}

rassigned_any(cs: Expr[], i: int, name: str) -> bool {
    if i >= cs.length() {
        false
    } else if rassigned_deep(cs.get(i), name) {
        true
    } else {
        rassigned_any(cs, i + 1, name)
    }
}

remit_with(e: Expr) -> str =>
    "{{ let mut _w = {remit_expr(e.children.get(0))};"
        ++ " {remit_updates(e.children, 1)}_w }}"

remit_updates(fs: Expr[], i: int) -> str {
    if i >= fs.length() {
        ""
    } else {
        f = fs.get(i)
        set = "_w.{rid(f.children.get(0).text)} = {remit_expr(f.children.get(1))}; "

        set ++ remit_updates(fs, i + 1)
    }
}

remit_lit_fields(fs: Expr[]) -> str =>
    fs.map(remit_lit_field).join(", ")

remit_lit_field(f: Expr) -> str =>
    "{rid(f.children.get(0).text)}: {remit_expr(f.children.get(1))}"

remit_args(xs: Expr[], i: int) -> str =>
    xs.slice(i, xs.length()).map(remit_expr).join(", ")

relem(ty: str) -> str =>
    ty.ends_with("[]") ? ty.slice(0, ty.length() - 2) : ty

rclone(ty: str) -> str {
    el = rtype(relem(ty))

    if el == "i64" || el == "f64" || el == "bool" {
        ""
    } else {
        ".clone()"
    }
}

rmap_key(ty: str) -> str {
    rest = rmap_rest(ty)
    cut = rest.index_of(" ")

    if cut < 0 {
        ""
    } else {
        rest.slice(0, cut)
    }
}

rmap_val(ty: str) -> str {
    rest = rmap_rest(ty)
    cut = rest.index_of(" ")

    if cut < 0 {
        ""
    } else {
        rest.slice(cut + 1, rest.length())
    }
}

rmap_rest(ty: str) -> str {
    if ty.length() > 4 && ty.slice(0, 4) == "Map " {
        ty.slice(4, ty.length())
    } else {
        ""
    }
}

r_is_fn(ty: str) -> bool =>
    ty.index_of(") -> ") >= 0

r_fn_ret(ty: str) -> str =>
    ty.slice(ty.index_of(") -> ") + 5, ty.length())

r_fn_params(ty: str) -> str =>
    ty.slice(1, ty.index_of(") -> "))

r_param_types(list: str, at: int, acc: str) -> str {
    cut = list.index_of(", ")

    if list == "" {
        acc
    } else if cut < 0 {
        acc ++ rtype(list)
    } else {
        head = rtype(list.slice(0, cut))
        rest = list.slice(cut + 2, list.length())

        r_param_types(rest, at + 1, acc ++ head ++ ", ")
    }
}

rtype(ty: str) -> str {
    if r_is_fn(ty) {
        "fn({r_param_types(r_fn_params(ty), 0, "")}) -> {rtype(r_fn_ret(ty))}"
    } else if ty.ends_with("[]") {
        "Rc<Vec<{rtype(relem(ty))}>>"
    } else if rmap_key(ty) != "" {
        "Rc<std::collections::BTreeMap<{rtype(rmap_key(ty))},"
            ++ " {rtype(rmap_val(ty))}>>"
    } else if ty == "float" {
        "f64"
    } else if ty == "str" {
        "String"
    } else if ty == "bool" {
        "bool"
    } else if ty == "" || ty == "int" {
        "i64"
    } else {
        ty
    }
}

remit_fn(s: Stmt) -> str {
    body = remit_stmts(s.body, 0)

    if s.body.length() == 0 {
        params = s.params.map(remit_param).join(", ")
        "extern \"C\" {{ fn {rid(s.name)}({params}) -> {rtype(s.ret)}; }}"
    } else if s.name == "main" {
        params = s.params.map(remit_param).join(", ")
        "fn __maca_main({params}) -> i64 {{ {body} }}\n"
            ++ "fn main() {{ std::process::exit(__maca_main("
            ++ "{rust_argv(s.params)}) as i32); }}"
    } else {
        params = s.params.map(remit_param).join(", ")
        "fn {rid(s.name)}({params}) -> {rret(s)} {{ {body} }}"
    }
}

rret(s: Stmt) -> str {
    if s.ret != "" {
        rtype(s.ret)
    } else {
        rtype(rtail_ty(s.body))
    }
}

rtail_ty(body: Stmt[]) -> str {
    if body.length() == 0 {
        ""
    } else if body.get(body.length() - 1).kind != SExpr {
        ""
    } else {
        body.get(body.length() - 1).value.ty
    }
}

rust_argv(params: Expr[]) -> str {
    if params.length() == 0 {
        ""
    } else {
        "Rc::new(std::env::args().skip(1).collect())"
    }
}

remit_param(p: Expr) -> str =>
    "{rid(p.text)}: {rtype(p.ty)}"

remit_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        last = i == body.length() - 1
        here = remit_stmt(body.get(i), last, rmut(body, i + 1, body.get(i)))
        "{here} {remit_stmts(body, i + 1)}"
    }
}

remit_stmt(s: Stmt, is_last: bool, movable: bool) -> str {
    if s.kind == SSet {
        "{rid(s.name)} = {remit_expr(s.value)};"
    } else if s.value.kind == EIf && rmissing_else(s.value.children.get(2)) {
        rif_stmt(s.value)
    } else if s.kind == SBind && s.ret != "" {
        "let {rmut_word(movable)}{rid(s.name)}: {rtype(s.ret)}"
            ++ " = {remit_expr(s.value)};"
    } else if s.kind == SBind {
        "let {rmut_word(movable)}{rid(s.name)} = {remit_expr(s.value)};"
    } else if is_last {
        remit_expr(s.value)
    } else {
        "{remit_expr(s.value)};"
    }
}

rmut_word(movable: bool) -> str {
    if movable {
        "mut "
    } else {
        ""
    }
}

remit_module(m: Module) -> str =>
    rust_preamble() ++ m.items.map(remit_item).join("\n")

rust_preamble() -> str =>
    "use std::rc::Rc;\n" ++
    "#[allow(dead_code)]\nfn maca_attr(name: String, value: String) -> String {{ if name.is_empty() {{ return String::new(); }} let q = value.replace('&', \"&amp;\").replace('<', \"&lt;\").replace('>', \"&gt;\").replace('\"', \"&quot;\"); format!(\" {{}}={{}}{{}}{{}}\", name, '\"', q, '\"') }}\n" ++
    "#[allow(dead_code)]\nfn maca_flag(name: String, on: bool) -> String {{ if on && !name.is_empty() {{ format!(\" {{}}\", name) }} else {{ String::new() }} }}\n" ++
    "#[allow(dead_code)]\nfn maca_element(tag: String, attrs: String, kids: String) -> String {{ if [\"area\", \"base\", \"br\", \"col\", \"embed\", \"hr\", \"img\", \"input\", \"link\", \"meta\", \"source\", \"track\", \"wbr\"].contains(&tag.as_str()) {{ format!(\"<{{}}{{}}>\", tag, attrs) }} else {{ format!(\"<{{}}{{}}>{{}}</{{}}>\", tag, attrs, kids, tag) }} }}\n" ++
    "#[allow(dead_code)]\nfn maca_read_file(path: String) -> String {{ std::fs::read_to_string(path).unwrap_or_default() }}\n" ++
    "#[allow(dead_code)]\nfn maca_write_file(path: String, text: String) -> bool {{ std::fs::write(path, text).is_ok() }}\n" ++
    "#[allow(dead_code)]\nfn maca_exec(cmd: String, args: Rc<Vec<String>>) -> i64 {{ match std::process::Command::new(cmd).args(args.iter()).status() {{ Ok(s) => s.code().unwrap_or(-1) as i64, Err(_) => -1 }} }}\n" ++
    "use std::cell::Cell;\nthread_local!(static MACA_FAILED: Cell<i64> = Cell::new(0));\n" ++
    "#[allow(dead_code)]\nfn maca_failures() -> i64 {{ MACA_FAILED.with(|c| c.get()) }}\n" ++
    "#[allow(dead_code)]\nfn maca_assert(cond: bool, msg: String) -> bool {{ if cond {{ return true; }} MACA_FAILED.with(|c| c.set(c.get() + 1)); eprintln!(\"assertion failed: {{}}\", if msg.is_empty() {{ \"(no message)\".to_string() }} else {{ msg }}); false }}\n" ++
    "#[allow(dead_code)]\nfn maca_assert_eq(got: String, want: String, msg: String) -> bool {{ if got == want {{ return true; }} MACA_FAILED.with(|c| c.set(c.get() + 1)); eprintln!(\"assertion failed: {{}}\\n  got:  {{}}\\n  want: {{}}\", if msg.is_empty() {{ \"(no message)\".to_string() }} else {{ msg }}, got, want); false }}\n" ++
    "#[allow(dead_code)]\nfn maca_panic(msg: String) {{ eprintln!(\"{{}}\", msg); std::process::exit(1); }}\n" ++
    "#[allow(dead_code)]\nfn maca_sleep_ms(ms: i64) {{ if ms > 0 {{ std::thread::sleep(std::time::Duration::from_millis(ms as u64)); }} }}\n" ++
    "#[allow(dead_code)]\nfn maca_make_dir(p: String) -> bool {{ std::fs::create_dir_all(p).is_ok() }}\n" ++
    "#[allow(dead_code)]\nfn maca_remove_dir(p: String) -> bool {{ std::fs::remove_dir(p).is_ok() }}\n" ++
    "#[allow(dead_code)]\nfn maca_remove_file(p: String) -> bool {{ std::fs::remove_file(p).is_ok() }}\n" ++
    "#[allow(dead_code)]\nfn maca_file_exists(p: String) -> bool {{ std::path::Path::new(&p).exists() }}\n" ++
    "#[allow(dead_code)]\nfn maca_is_dir(p: String) -> bool {{ std::path::Path::new(&p).is_dir() }}\n" ++
    "#[allow(dead_code)]\nfn maca_env(name: String) -> String {{ std::env::var(name).unwrap_or_default() }}\n" ++
    "#[allow(dead_code)]\nfn maca_cwd() -> String {{ std::env::current_dir().map(|p| p.display().to_string()).unwrap_or_default() }}\n" ++
    "#[allow(dead_code)]\nfn maca_substr(s: String, at: i64, n: i64) -> String {{ let a = (at.max(0) as usize).min(s.len()); let b = (a + n.max(0) as usize).min(s.len()); s.get(a..b).unwrap_or(\"\").to_string() }}\n" ++
    "#[allow(dead_code)]\nfn maca_pad_start(s: String, w: i64) -> String {{ let w = w.max(0) as usize; if s.len() >= w {{ s }} else {{ format!(\"{{}}{{}}\", \" \".repeat(w - s.len()), s) }} }}\n" ++
    "#[allow(dead_code)]\nfn maca_pad_end(s: String, w: i64) -> String {{ let w = w.max(0) as usize; if s.len() >= w {{ s }} else {{ format!(\"{{}}{{}}\", s, \" \".repeat(w - s.len())) }} }}\n" ++
    "#[allow(dead_code)]\nfn maca_is_tty() -> bool {{ false }}\n" ++
    "#[allow(dead_code)]\nfn maca_now_ms() -> i64 {{ std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis() as i64).unwrap_or(0) }}\n" ++
    "#[allow(dead_code)]\nfn maca_file_size(p: String) -> i64 {{ std::fs::metadata(p).map(|m| m.len() as i64).unwrap_or(-1) }}\n" ++
    "#[allow(dead_code)]\nfn maca_chr(b: i64) -> String {{ char::from_u32(b as u32).map(|c| c.to_string()).unwrap_or_default() }}\n" ++
    "#[allow(dead_code)]\nfn maca_ord(s: String) -> i64 {{ s.bytes().next().map(|b| b as i64).unwrap_or(-1) }}\n" ++
    "#[allow(dead_code)]\nfn maca_input(prompt: String) -> String {{ use std::io::Write; if !prompt.is_empty() {{ print!(\"{{}}\", prompt); let _ = std::io::stdout().flush(); }} let mut s = String::new(); let _ = std::io::stdin().read_line(&mut s); s.trim_end_matches('\\n').to_string() }}\n" ++
    "#[allow(dead_code)]\nfn maca_list_dir(p: String) -> Rc<Vec<String>> {{ let mut v: Vec<String> = std::fs::read_dir(p).map(|d| d.filter_map(|e| e.ok()).map(|e| e.file_name().to_string_lossy().to_string()).collect()).unwrap_or_default(); v.sort(); Rc::new(v) }}\n"

remit_item(s: Stmt) -> str {
    if s.kind == SRecord {
        remit_struct(s)
    } else if s.kind == SSum {
        remit_sum(s)
    } else if s.kind == SBind {
        remit_const(s)
    } else {
        remit_fn(s)
    }
}

remit_const(s: Stmt) -> str =>
    "const {rid(s.name)}: {rconst_type(s.value)} = {rconst_value(s.value)};"

rconst_type(e: Expr) -> str =>
    match e.kind {
        EStr   => "&str"
        EFloat => "f64"
        EBool  => "bool"
        _      => "i64"
    }

rconst_value(e: Expr) -> str =>
    e.kind == EStr ? "\"{e.text}\"" : remit_expr(e)

remit_struct(s: Stmt) -> str {
    fields = s.params.map(remit_struct_field).join(", ")

    "#[derive(Clone, PartialEq)]\nstruct {s.name} {{ {fields} }}"
}

remit_struct_field(f: Expr) -> str =>
    "{rid(f.text)}: {rtype(f.ty)}"

remit_sum(s: Stmt) -> str {
    variants = s.params.map(remit_variant).join(", ")

    "#[derive(Clone, PartialEq)]\nenum {s.name} {{ {variants} }}\n"
        ++ "use {s.name}::*;"
}

remit_variant(v: Expr) -> str {
    if v.children.length() == 0 {
        v.text
    } else {
        "{v.text}({v.children.map(payload_type).join(", ")})"
    }
}

payload_type(p: Expr) -> str =>
    rtype(p.ty)
