import maca/token
import maca/ast

rust_int(n: int) -> str =>
    "{str(n)}i64"

rust_str(s: str) -> str =>
    "\"" ++ s ++ "\".to_string()"

RustReserved = " as async await become box break const continue crate do dyn else enum extern false final fn for if impl in let loop macro match mod move mut override priv pub ref return self Self static struct super trait true try type typeof union unsafe unsized use virtual where while yield "

rid(name: str) -> str {
    if RustReserved.index_of(" {name} ") >= 0 {
        "{name}_mc"
    } else {
        name
    }
}

rcopy(ty: str) -> bool =>
    ty == "" || ty == "int" || ty == "float" || ty == "bool" || r_is_fn(ty)

rowned(ty: str) -> str {
    if rcopy(ty) {
        ""
    } else {
        ".clone()"
    }
}

remit_expr(e: Expr) -> str =>
    match e.kind {
        EInt     => rust_int(e.ival)
        EFloat   => "{e.text}_f64"
        EStr     => rust_str(e.text)
        EBool    => e.text
        EIdent   => "{rid(e.text)}{rowned(e.ty)}"
        ECall    => remit_call(e)
        EBinary  => remit_binary(e)
        ETernary => remit_ternary(e)
        EIf      => remit_ternary(e)
        EUnary   => remit_unary(e)
        ERecord  => "{e.text} {{ {remit_lit_fields(e.children)} }}"
        EWith    => remit_with(e)
        EBlock   => remit_block(e)
        EField   => "{rfield(e)}"
        EMatch   => remit_match(e)
        EMethod  => remit_method(e)
        EList    => "Rc::new(vec![{remit_args(e.children, 0)}])"
        EJump    => rjump(e)
        EWhile   => remit_while(e)
        EFor     => remit_for(e)
        ELambda  => remit_lambda(e)
        _        => "0i64"
    }

rfield(e: Expr) -> str =>
    "{rplace(e.children.get(0))}.{rid(e.text)}{rowned(e.ty)}"

rplace(e: Expr) -> str {
    if e.kind == EIdent {
        rid(e.text)
    } else if e.kind == EField {
        "{rplace(e.children.get(0))}.{rid(e.text)}"
    } else {
        remit_expr(e)
    }
}

rjump(e: Expr) -> str {
    if e.children.length() == 0 {
        e.text
    } else {
        "{e.text} {remit_expr(e.children.get(0))}"
    }
}

remit_lambda(e: Expr) -> str =>
    "|{lambda_params(e).map(binder_name).join(", ")}|"
        ++ " {remit_expr(lambda_body(e))}"

remit_while(e: Expr) -> str =>
    "while {remit_expr(e.children.get(0))}"
        ++ " {{ {rblock_stmts(e.stmts, 0)}}}"

remit_for(e: Expr) -> str =>
    "for {rid(e.text)} in ({remit_expr(e.children.get(0))}).iter().cloned()"
        ++ " {{ {rblock_stmts(e.stmts, 0)}}}"

remit_unary(e: Expr) -> str {
    if e.text == "fail" {
        "panic!(\"{{}}\", {remit_expr(e.children.get(0))})"
    } else {
        "({e.text}{remit_expr(e.children.get(0))})"
    }
}

remit_ternary(e: Expr) -> str {
    cond = remit_expr(e.children.get(0))
    then = remit_expr(e.children.get(1))
    els = remit_expr(e.children.get(2))

    "(if {cond} {{ {then} }} else {{ {els} }})"
}

remit_match(e: Expr) -> str =>
    "match {remit_match_on(e)} {{ {remit_arms(e.children, 1)} }}"

remit_match_on(e: Expr) -> str {
    scrut = remit_expr(e.children.get(0))

    if has_str_arm(e.children, 1) {
        "{scrut}.as_str()"
    } else {
        scrut
    }
}

has_str_arm(cs: Expr[], i: int) -> bool {
    if i + 1 >= cs.length() {
        false
    } else if cs.get(i).kind == EStr {
        true
    } else {
        has_str_arm(cs, i + 2)
    }
}


rchar_pred(name: str) -> str {
    if name == "is_whitespace" {
        "is_whitespace"
    } else if name == "is_ascii_digit" {
        "is_ascii_digit"
    } else if name == "is_alpha" {
        "is_ascii_alphabetic"
    } else {
        ""
    }
}

rstr_helper(name: str) -> bool =>
    name == "upper" || name == "contains" || name == "ends_with" ||
    rchar_pred(name) != ""

remit_str_method(e: Expr, recv: str) -> str {
    pred = rchar_pred(e.text)

    if pred != "" {
        "({recv}).chars().next().map_or(false, |c| c.{pred}())"
    } else if e.text == "upper" {
        "({recv}).to_uppercase()"
    } else {
        "({recv}).{e.text}({remit_expr(e.children.get(1))}.as_str())"
    }
}

rstr_index(e: Expr) -> bool =>
    (e.text == "at" || e.text == "get") && e.children.get(0).ty == "str"

remit_method(e: Expr) -> str {
    recv = remit_expr(e.children.get(0))

    if rstr_helper(e.text) {
        remit_str_method(e, recv)
    } else if e.text == "chars" {
        "Rc::new(({recv}).chars().map(|c| c.to_string())"
            ++ ".collect::<Vec<String>>())"
    } else if e.text == "map" {
        "Rc::new(({recv}).iter().cloned()"
            ++ ".map({remit_expr(e.children.get(1))})"
            ++ ".collect::<Vec<_>>())"
    } else if e.text == "length" || e.text == "count" {
        "(({recv}).len() as i64)"
    } else if rstr_index(e) {
        idx = remit_expr(e.children.get(1))
        "{{ let _i = ({idx}) as usize;"
            ++ " ({recv}).get(_i.._i + 1).unwrap_or(\"\").to_string() }}"
    } else if e.text == "at" {
        idx = remit_expr(e.children.get(1))
        "(({recv}).as_bytes()[({idx}) as usize] as i64)"
    } else if e.text == "get" {
        cell = "{recv}[({remit_expr(e.children.get(1))}) as usize]"
        cell ++ rclone(e.children.get(0).ty)
    } else if e.text == "slice" && rlist(e.children.get(0).ty) {
        lo = remit_expr(e.children.get(1))
        hi = remit_expr(e.children.get(2))
        "Rc::new({recv}[({lo}) as usize..({hi}) as usize].to_vec())"
    } else if e.text == "slice" {
        lo = remit_expr(e.children.get(1))
        hi = remit_expr(e.children.get(2))
        "({recv}).get(({lo}) as usize..({hi}) as usize)"
            ++ ".unwrap_or(\"\").to_string()"
    } else if e.text == "index_of" && e.children.get(0).ty == "str" {
        "({recv}).find({remit_expr(e.children.get(1))}.as_str())"
            ++ ".map(|i| i as i64).unwrap_or(-1)"
    } else if e.text == "index_of" {
        "({recv}).iter().position(|v| *v == {remit_expr(e.children.get(1))})"
            ++ ".map(|i| i as i64).unwrap_or(-1)"
    } else if e.text == "join" {
        "({recv}).join({remit_expr(e.children.get(1))}.as_str())"
    } else if e.text == "push" {
        "{{ let mut _v = {recv};"
            ++ " Rc::make_mut(&mut _v).push({remit_expr(e.children.get(1))});"
            ++ " _v }}"
    } else {
        "{recv}.{e.text}({remit_args(e.children, 1)})"
    }
}

remit_call(e: Expr) -> str {
    args = remit_args(e.children, 0)

    if e.text == "info" {
        "println!(\"{{}}\", {args})"
    } else if e.text == "print" {
        "print!(\"{{}}\", {args})"
    } else if e.text == "str" {
        "format!(\"{{}}\", {args})"
    } else if e.text == "int" {
        rint_of(rarg_ty(e.children), args)
    } else if rruntime_call(e.text) {
        "maca_{e.text}({args})"
    } else {
        "{rid(e.text)}({args})"
    }
}

rruntime_call(name: str) -> bool =>
    name == "read_file" || name == "write_file" || name == "exec"

rarg_ty(cs: Expr[]) -> str {
    if cs.length() == 0 {
        ""
    } else {
        cs.get(0).ty
    }
}

rint_of(ty: str, args: str) -> str {
    if ty == "int" {
        args
    } else if ty == "float" || ty == "bool" {
        "(({args}) as i64)"
    } else {
        "({args}).trim().parse::<i64>().unwrap_or(0)"
    }
}

remit_binary(e: Expr) -> str {
    l = remit_expr(e.children.get(0))
    r = remit_expr(e.children.get(1))

    on_list = rlist(e.children.get(0).ty) || rlist(e.children.get(1).ty)

    lhs = e.children.get(0)

    if e.text == "=" && lhs.kind == EMethod && lhs.text == "get" {
        rstore(lhs, r)
    } else if e.text == ".." {
        "Rc::new((({l})..({r})).collect::<Vec<i64>>())"
    } else if e.text == "++" && on_list {
        "{{ let mut _v = {l};"
            ++ " Rc::make_mut(&mut _v).extend(({r}).iter().cloned());"
            ++ " _v }}"
    } else if e.text == "++" {
        "format!(\"{{}}{{}}\", {l}, {r})"
    } else {
        "({l} {e.text} {r})"
    }
}

rstore(l: Expr, value: str) -> str {
    holder = rplace(l.children.get(0))
    ix = remit_expr(l.children.get(1))

    "Rc::make_mut(&mut {holder})[({ix}) as usize] = {value}"
}

rlist(ty: str) -> bool =>
    ty.length() > 2 && ty.slice(ty.length() - 2, ty.length()) == "[]"

remit_arms(cs: Expr[], i: int) -> str {
    if i + 1 >= cs.length() {
        ""
    } else {
        arm = "{remit_pat(cs.get(i))} => {remit_expr(cs.get(i + 1))}, "
        arm ++ remit_arms(cs, i + 2)
    }
}

remit_pat(p: Expr) -> str {
    if p.kind == EGuard {
        "{remit_pat(p.children.get(0))} if {remit_expr(p.children.get(1))}"
    } else if p.kind == EStr {
        "\"{p.text}\""
    } else if p.children.length() == 0 {
        p.text
    } else {
        "{p.text}({p.children.map(binder_name).join(", ")})"
    }
}

binder_name(b: Expr) -> str =>
    rid(b.text)

remit_block(e: Expr) -> str =>
    "{{ {rblock_stmts(e.stmts, 0)}{remit_expr(e.children.get(0))} }}"

rblock_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        here = remit_stmt(body.get(i), false, rmut(body, i + 1, body.get(i)))

        "{here} {rblock_stmts(body, i + 1)}"
    }
}

rmut(body: Stmt[], i: int, s: Stmt) -> bool {
    if s.kind != SBind {
        false
    } else {
        rassigned_in(body, i, s.name)
    }
}

rassigned_in(body: Stmt[], i: int, name: str) -> bool {
    if i >= body.length() {
        false
    } else if body.get(i).kind == SSet && body.get(i).name == name {
        true
    } else if rassigned_deep(body.get(i).value, name) {
        true
    } else {
        rassigned_in(body, i + 1, name)
    }
}

rassigned_deep(e: Expr, name: str) -> bool =>
    rassigned_in(e.stmts, 0, name) || rassigned_any(e.children, 0, name)

rassigned_any(cs: Expr[], i: int, name: str) -> bool {
    if i >= cs.length() {
        false
    } else if rassigned_deep(cs.get(i), name) {
        true
    } else {
        rassigned_any(cs, i + 1, name)
    }
}

remit_with(e: Expr) -> str =>
    "{{ let mut _w = {remit_expr(e.children.get(0))};"
        ++ " {remit_updates(e.children, 1)}_w }}"

remit_updates(fs: Expr[], i: int) -> str {
    if i >= fs.length() {
        ""
    } else {
        f = fs.get(i)
        set = "_w.{rid(f.children.get(0).text)} = {remit_expr(f.children.get(1))}; "

        set ++ remit_updates(fs, i + 1)
    }
}

remit_lit_fields(fs: Expr[]) -> str =>
    fs.map(remit_lit_field).join(", ")

remit_lit_field(f: Expr) -> str =>
    "{rid(f.children.get(0).text)}: {remit_expr(f.children.get(1))}"

remit_args(xs: Expr[], i: int) -> str =>
    xs.slice(i, xs.length()).map(remit_expr).join(", ")

relem(ty: str) -> str =>
    ty.ends_with("[]") ? ty.slice(0, ty.length() - 2) : ty

rclone(ty: str) -> str {
    el = rtype(relem(ty))

    if el == "i64" || el == "f64" || el == "bool" {
        ""
    } else {
        ".clone()"
    }
}

r_is_fn(ty: str) -> bool =>
    ty.index_of(") -> ") >= 0

r_fn_ret(ty: str) -> str =>
    ty.slice(ty.index_of(") -> ") + 5, ty.length())

r_fn_params(ty: str) -> str =>
    ty.slice(1, ty.index_of(") -> "))

r_param_types(list: str, at: int, acc: str) -> str {
    cut = list.index_of(", ")

    if list == "" {
        acc
    } else if cut < 0 {
        acc ++ rtype(list)
    } else {
        head = rtype(list.slice(0, cut))
        rest = list.slice(cut + 2, list.length())

        r_param_types(rest, at + 1, acc ++ head ++ ", ")
    }
}

rtype(ty: str) -> str {
    if r_is_fn(ty) {
        "fn({r_param_types(r_fn_params(ty), 0, "")}) -> {rtype(r_fn_ret(ty))}"
    } else if ty.ends_with("[]") {
        "Rc<Vec<{rtype(relem(ty))}>>"
    } else if ty == "float" {
        "f64"
    } else if ty == "str" {
        "String"
    } else if ty == "bool" {
        "bool"
    } else if ty == "" || ty == "int" {
        "i64"
    } else {
        ty
    }
}

remit_fn(s: Stmt) -> str {
    body = remit_stmts(s.body, 0)

    if s.body.length() == 0 {
        params = s.params.map(remit_param).join(", ")
        "extern \"C\" {{ fn {rid(s.name)}({params}) -> {rtype(s.ret)}; }}"
    } else if s.name == "main" {
        params = s.params.map(remit_param).join(", ")
        "fn __maca_main({params}) -> i64 {{ {body} }}\n"
            ++ "fn main() {{ std::process::exit(__maca_main("
            ++ "{rust_argv(s.params)}) as i32); }}"
    } else {
        params = s.params.map(remit_param).join(", ")
        "fn {rid(s.name)}({params}) -> {rtype(s.ret)} {{ {body} }}"
    }
}

rust_argv(params: Expr[]) -> str {
    if params.length() == 0 {
        ""
    } else {
        "Rc::new(std::env::args().skip(1).collect())"
    }
}

remit_param(p: Expr) -> str =>
    "{rid(p.text)}: {rtype(p.ty)}"

remit_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        last = i == body.length() - 1
        here = remit_stmt(body.get(i), last, rmut(body, i + 1, body.get(i)))
        "{here} {remit_stmts(body, i + 1)}"
    }
}

remit_stmt(s: Stmt, is_last: bool, movable: bool) -> str {
    if s.kind == SSet {
        "{rid(s.name)} = {remit_expr(s.value)};"
    } else if s.kind == SBind && s.ret != "" {
        "let {rmut_word(movable)}{rid(s.name)}: {rtype(s.ret)}"
            ++ " = {remit_expr(s.value)};"
    } else if s.kind == SBind {
        "let {rmut_word(movable)}{rid(s.name)} = {remit_expr(s.value)};"
    } else if is_last {
        remit_expr(s.value)
    } else {
        "{remit_expr(s.value)};"
    }
}

rmut_word(movable: bool) -> str {
    if movable {
        "mut "
    } else {
        ""
    }
}

remit_module(m: Module) -> str =>
    rust_preamble() ++ m.items.map(remit_item).join("\n")

rust_preamble() -> str =>
    "use std::rc::Rc;\n" ++
    "#[allow(dead_code)]\nfn maca_attr(name: String, value: String) -> String {{ if name.is_empty() {{ return String::new(); }} let q = value.replace('&', \"&amp;\").replace('<', \"&lt;\").replace('>', \"&gt;\").replace('\"', \"&quot;\"); format!(\" {{}}={{}}{{}}{{}}\", name, '\"', q, '\"') }}\n" ++
    "#[allow(dead_code)]\nfn maca_flag(name: String, on: bool) -> String {{ if on && !name.is_empty() {{ format!(\" {{}}\", name) }} else {{ String::new() }} }}\n" ++
    "#[allow(dead_code)]\nfn maca_element(tag: String, attrs: String, kids: String) -> String {{ if [\"area\", \"base\", \"br\", \"col\", \"embed\", \"hr\", \"img\", \"input\", \"link\", \"meta\", \"source\", \"track\", \"wbr\"].contains(&tag.as_str()) {{ format!(\"<{{}}{{}}>\", tag, attrs) }} else {{ format!(\"<{{}}{{}}>{{}}</{{}}>\", tag, attrs, kids, tag) }} }}\n" ++
    "#[allow(dead_code)]\nfn maca_read_file(path: String) -> String {{ std::fs::read_to_string(path).unwrap_or_default() }}\n" ++
    "#[allow(dead_code)]\nfn maca_write_file(path: String, text: String) -> bool {{ std::fs::write(path, text).is_ok() }}\n" ++
    "#[allow(dead_code)]\nfn maca_exec(cmd: String, args: Rc<Vec<String>>) -> i64 {{ match std::process::Command::new(cmd).args(args.iter()).status() {{ Ok(s) => s.code().unwrap_or(-1) as i64, Err(_) => -1 }} }}\n"

remit_item(s: Stmt) -> str {
    if s.kind == SRecord {
        remit_struct(s)
    } else if s.kind == SSum {
        remit_sum(s)
    } else if s.kind == SBind {
        remit_const(s)
    } else {
        remit_fn(s)
    }
}

remit_const(s: Stmt) -> str =>
    "const {rid(s.name)}: {rconst_type(s.value)} = {rconst_value(s.value)};"

rconst_type(e: Expr) -> str =>
    match e.kind {
        EStr   => "&str"
        EFloat => "f64"
        EBool  => "bool"
        _      => "i64"
    }

rconst_value(e: Expr) -> str =>
    e.kind == EStr ? "\"{e.text}\"" : remit_expr(e)

remit_struct(s: Stmt) -> str {
    fields = s.params.map(remit_struct_field).join(", ")

    "#[derive(Clone, PartialEq)]\nstruct {s.name} {{ {fields} }}"
}

remit_struct_field(f: Expr) -> str =>
    "{rid(f.text)}: {rtype(f.ty)}"

remit_sum(s: Stmt) -> str {
    variants = s.params.map(remit_variant).join(", ")

    "#[derive(Clone, PartialEq)]\nenum {s.name} {{ {variants} }}\n"
        ++ "use {s.name}::*;"
}

remit_variant(v: Expr) -> str {
    if v.children.length() == 0 {
        v.text
    } else {
        "{v.text}({v.children.map(payload_type).join(", ")})"
    }
}

payload_type(p: Expr) -> str =>
    rtype(p.ty)
