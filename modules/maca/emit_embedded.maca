import maca/ast

EmbedPreamble = "/* generated by maca --target embedded: freestanding, no libc */\n#include <stdint.h>\n\nstatic inline void maca_delay(uint32_t n) {{ while (n) {{ __asm__ volatile(\"nop\"); n--; }} }}\n"

EmbedStartup = "\n/* ---- Cortex-M startup ---- */\nextern uint32_t _sdata, _edata, _sidata, _sbss, _ebss, _estack;\nvoid main(void);\n\nvoid Reset_Handler(void) {{\n    uint32_t *src = &_sidata, *dst = &_sdata;\n    while (dst < &_edata) *dst++ = *src++;\n    for (dst = &_sbss; dst < &_ebss;) *dst++ = 0;\n    main();\n    for (;;) {{ __asm__ volatile(\"wfi\"); }}\n}}\n\n__attribute__((section(\".isr_vector\"), used))\nvoid (* const g_vectors[])(void) = {{\n    (void (*)(void)) &_estack,\n    Reset_Handler,\n}};\n"

Mcu = {
    name:    str
    triple:  str
    cpu:     str
    flash:   str
    flash_k: int
    ram:     str
    ram_k:   int
}

/** A core `--mcu` names, or one with no name when nothing answers to it. */
emb_mcu(name: str) -> Mcu {
    if name == "cortex-m0" || name == "cortex-m0plus" {
        Mcu { name = "cortex-m0", triple = "thumbv6m-none-eabi",
              cpu = "cortex-m0", flash = "0x08000000", flash_k = 64,
              ram = "0x20000000", ram_k = 8 }
    } else if name == "cortex-m3" {
        Mcu { name = "cortex-m3", triple = "thumbv7m-none-eabi",
              cpu = "cortex-m3", flash = "0x08000000", flash_k = 256,
              ram = "0x20000000", ram_k = 64 }
    } else if name == "cortex-m4" || name == "" || name == "default" {
        Mcu { name = "cortex-m4", triple = "thumbv7em-none-eabi",
              cpu = "cortex-m4", flash = "0x08000000", flash_k = 512,
              ram = "0x20000000", ram_k = 128 }
    } else if name == "riscv32" {
        Mcu { name = "riscv32", triple = "riscv32-none-elf",
              cpu = "generic-rv32", flash = "0x20000000", flash_k = 512,
              ram = "0x80000000", ram_k = 128 }
    } else {
        Mcu { name = "", triple = "", cpu = "", flash = "", flash_k = 0,
              ram = "", ram_k = 0 }
    }
}

/** The memory map the image is placed by: the vector table at the flash origin,
 * `.data` and `.bss` in RAM.
 */
emb_linker_script(m: Mcu) -> str =>
    "ENTRY(Reset_Handler)\nMEMORY {{\n" ++
        "  FLASH (rx) : ORIGIN = {m.flash}, LENGTH = {str(m.flash_k)}K\n" ++
        "  RAM  (rwx) : ORIGIN = {m.ram}, LENGTH = {str(m.ram_k)}K\n}}\n" ++
        "_estack = ORIGIN(RAM) + LENGTH(RAM);\nSECTIONS {{\n" ++
        "  .isr_vector : {{ KEEP(*(.isr_vector)) }} > FLASH\n" ++
        "  .text : {{ *(.text*) *(.rodata*) }} > FLASH\n" ++
        "  _sidata = LOADADDR(.data);\n" ++
        "  .data : {{ _sdata = .; *(.data*) . = ALIGN(4); _edata = .; }}" ++
        " > RAM AT> FLASH\n" ++
        "  .bss  : {{ _sbss = .; *(.bss* COMMON) . = ALIGN(4); _ebss = .; }}" ++
        " > RAM\n}}\n"

/** The whole firmware translation unit: intrinsics, the constants, the code,
 * the startup.
 */
eemit_module(m: Module) -> str =>
    EmbedPreamble ++ "\n" ++ emb_consts(m.items, 0, "")
        ++ emb_fns(m.items, 0, "") ++ EmbedStartup

/** Every construct this target cannot honour, named the way the author wrote
 * it.
 */
eemit_errors(m: Module) -> str[] =>
    emb_item_errors(m.items, 0, [])

emb_consts(items: Stmt[], i: int, acc: str) -> str {
    if i >= items.length() {
        acc == "" ? "" : acc ++ "\n"
    } else if items.get(i).kind != SBind {
        emb_consts(items, i + 1, acc)
    } else {
        emb_consts(items, i + 1, acc ++ emb_const(items.get(i)))
    }
}

/** A register address is a word, and a word the program never writes is a
 * constant.
 */
emb_const(s: Stmt) -> str =>
    "static const uint32_t {s.name} = {emb_expr(s.value)};\n"

emb_fns(items: Stmt[], i: int, acc: str) -> str {
    if i >= items.length() {
        acc
    } else if items.get(i).kind != SFn {
        emb_fns(items, i + 1, acc)
    } else {
        emb_fns(items, i + 1, acc ++ emb_fn(items.get(i)) ++ "\n")
    }
}

emb_fn(s: Stmt) -> str {
    ret = s.ret == "" ? "void" : "uint32_t"

    "{ret} {s.name}({emb_params(s.params, 0, "")}) {{\n"
        ++ emb_block(s.body, s.ret != "", 1) ++ "}}\n"
}

emb_params(ps: Expr[], i: int, acc: str) -> str {
    if i >= ps.length() {
        acc == "" ? "void" : acc
    } else if acc == "" {
        emb_params(ps, i + 1, "uint32_t {ps.get(i).text}")
    } else {
        emb_params(ps, i + 1, acc ++ ", uint32_t {ps.get(i).text}")
    }
}

emb_block(body: Stmt[], wants_value: bool, ind: int) -> str =>
    emb_stmts(body, 0, wants_value, ind, "")

emb_stmts(body: Stmt[], i: int, wants_value: bool, ind: int,
          acc: str) -> str {
    if i >= body.length() {
        acc
    } else {
        emb_stmts(body, i + 1, wants_value, ind,
                  acc ++ emb_stmt(body.get(i), i + 1 == body.length(),
                                  wants_value, ind))
    }
}

emb_stmt(s: Stmt, last: bool, wants_value: bool, ind: int) -> str {
    pad = emb_pad(ind, "")

    if s.kind == SBind {
        "{pad}uint32_t {s.name} = {emb_expr(s.value)};\n"
    } else if s.kind == SSet {
        "{pad}{s.name} = {emb_expr(s.value)};\n"
    } else if s.value.kind == EFor {
        emb_for(s.value, ind)
    } else if s.value.kind == EWhile {
        emb_while(s.value, ind)
    } else if s.value.kind == EJump {
        emb_jump(s.value, pad)
    } else if s.value.kind == EIf {
        emb_if(s.value, ind)
    } else if last && wants_value {
        "{pad}return {emb_expr(s.value)};\n"
    } else if emb_pure(s.value) {
        ""
    } else {
        "{pad}{emb_expr(s.value)};\n"
    }
}

emb_while(e: Expr, ind: int) -> str {
    pad = emb_pad(ind, "")

    "{pad}while ({emb_expr(e.children.get(0))}) {{\n"
        ++ emb_block(e.stmts, false, ind + 1) ++ "{pad}}}\n"
}

/** `for x in forever()` is the loop a microcontroller spends its life in. */
emb_for(e: Expr, ind: int) -> str {
    pad = emb_pad(ind, "")
    over = e.children.get(0)

    if over.kind == ECall && over.text == "forever" {
        "{pad}while (1) {{\n" ++ emb_block(e.stmts, false, ind + 1)
            ++ "{pad}}}\n"
    } else {
        "{pad}for (uint32_t {e.text} = 0; {e.text} < ({emb_expr(over)});"
            ++ " {e.text}++) {{\n" ++ emb_block(e.stmts, false, ind + 1)
            ++ "{pad}}}\n"
    }
}

emb_if(e: Expr, ind: int) -> str {
    pad = emb_pad(ind, "")
    head = "{pad}if ({emb_expr(e.children.get(0))}) {{\n"
        ++ emb_branch(e.children.get(1), ind + 1) ++ "{pad}}}"
    els = e.children.get(2)

    if emb_no_else(els) {
        head ++ "\n"
    } else {
        head ++ " else {{\n" ++ emb_branch(els, ind + 1) ++ "{pad}}}\n"
    }
}

emb_no_else(e: Expr) -> bool =>
    e.kind == EIdent && e.text == "?"

emb_branch(e: Expr, ind: int) -> str {
    if e.kind == EBlock {
        emb_block(e.stmts ++ [s_expr(e.children.get(0))], false, ind)
    } else {
        emb_block([s_expr(e)], false, ind)
    }
}

emb_jump(e: Expr, pad: str) -> str {
    if e.text != "return" {
        "{pad}{e.text};\n"
    } else if e.children.length() == 0 {
        "{pad}return;\n"
    } else {
        "{pad}return {emb_expr(e.children.get(0))};\n"
    }
}

emb_pad(n: int, acc: str) -> str {
    if n <= 0 {
        acc
    } else {
        emb_pad(n - 1, acc ++ "    ")
    }
}

/** A statement that only names a value does nothing, so it is not written down.
 */
emb_pure(e: Expr) -> bool =>
    e.kind == EInt || e.kind == EBool || e.kind == EIdent

emb_expr(e: Expr) -> str =>
    match e.kind {
        EInt     => emb_int(e.ival)
        EBool    => emb_bool(e)
        EIdent   => e.text
        EUnary   => emb_unary(e)
        EBinary  => emb_binary(e)
        ETernary => emb_ternary(e)
        ECall    => emb_call(e)
        EField   => "{emb_expr(e.children.get(0))}.{e.text}"
        _        => "0u"
    }

emb_int(n: int) -> str {
    if n >= 0 {
        "{str(n)}u"
    } else {
        str(n)
    }
}

emb_bool(e: Expr) -> str {
    if e.text == "true" {
        "1u"
    } else {
        "0u"
    }
}

emb_ternary(e: Expr) -> str =>
    "({emb_expr(e.children.get(0))} ? {emb_expr(e.children.get(1))}"
        ++ " : {emb_expr(e.children.get(2))})"

emb_unary(e: Expr) -> str {
    if emb_prefix(e.text) {
        "{e.text}({emb_expr(e.children.get(0))})"
    } else {
        "0u"
    }
}

emb_binary(e: Expr) -> str {
    l = emb_expr(e.children.get(0))
    r = emb_expr(e.children.get(1))

    if e.text == "=" {
        "({l} = {r})"
    } else if emb_infix(e.text) {
        "({l} {e.text} {r})"
    } else {
        "0u"
    }
}

emb_prefix(op: str) -> bool =>
    op == "-" || op == "!"

emb_infix(op: str) -> bool =>
    op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
        || op == "==" || op == "!=" || op == "<" || op == ">"
        || op == "<=" || op == ">=" || op == "&&" || op == "||"
        || op == "<<" || op == ">>"

/** The register intrinsics, which are what this target has instead of a
 * library.
 */
emb_call(e: Expr) -> str {
    a = emb_arg(e, 0)
    b = emb_arg(e, 1)

    if e.text == "mmio_write" {
        "({emb_reg(a)} = (uint32_t)({b}))"
    } else if e.text == "mmio_read" {
        emb_reg(a)
    } else if e.text == "set_bits" {
        "({emb_reg(a)} |= (uint32_t)({b}))"
    } else if e.text == "clear_bits" {
        "({emb_reg(a)} &= ~(uint32_t)({b}))"
    } else if e.text == "toggle_bits" {
        "({emb_reg(a)} ^= (uint32_t)({b}))"
    } else if e.text == "bit" {
        "(1u << ({a}))"
    } else if e.text == "shl" {
        "(({a}) << ({b}))"
    } else if e.text == "shr" {
        "(({a}) >> ({b}))"
    } else if e.text == "bit_or" {
        "(({a}) | ({b}))"
    } else if e.text == "bit_and" {
        "(({a}) & ({b}))"
    } else if e.text == "delay" {
        "maca_delay({a})"
    } else if e.text == "nop" {
        "__asm__ volatile(\"nop\")"
    } else {
        "{e.text}({emb_args(e.children, 0, "")})"
    }
}

emb_reg(addr: str) -> str =>
    "(*(volatile uint32_t *)(uintptr_t)({addr}))"

emb_arg(e: Expr, i: int) -> str {
    if i >= e.children.length() {
        "0u"
    } else {
        emb_expr(e.children.get(i))
    }
}

emb_args(xs: Expr[], i: int, acc: str) -> str {
    if i >= xs.length() {
        acc
    } else if i == 0 {
        emb_args(xs, i + 1, emb_expr(xs.get(i)))
    } else {
        emb_args(xs, i + 1, acc ++ ", " ++ emb_expr(xs.get(i)))
    }
}

emb_item_errors(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else {
        emb_item_errors(items, i + 1, emb_item_error(items.get(i), acc))
    }
}

emb_item_error(s: Stmt, acc: str[]) -> str[] {
    if s.kind == SSum {
        acc ++ [emb_sum_refusal(s.name)]
    } else if s.kind == SRecord {
        acc ++ [emb_record_refusal(s.name)]
    } else if s.kind == SFn {
        emb_stmt_errors(s.body, 0, acc)
    } else if s.kind == SBind {
        emb_value_errors(s.value, acc)
    } else {
        acc
    }
}

emb_sum_refusal(name: str) -> str =>
    "`{name}` is a sum type; the embedded target has no tagged values;"
        ++ " use integer constants"

emb_record_refusal(name: str) -> str =>
    "`{name}` is a record type; the embedded target has no structs;"
        ++ " use separate values"

emb_stmt_errors(body: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= body.length() {
        acc
    } else {
        emb_stmt_errors(body, i + 1, emb_one_errors(body.get(i), acc))
    }
}

emb_one_errors(s: Stmt, acc: str[]) -> str[] {
    if s.kind == SBind || s.kind == SSet {
        emb_value_errors(s.value, acc)
    } else if s.value.kind == EWhile || s.value.kind == EFor {
        emb_stmt_errors(s.value.stmts, 0,
                        emb_value_errors(s.value.children.get(0), acc))
    } else if s.value.kind == EIf {
        emb_if_errors(s.value, acc)
    } else if s.value.kind == EJump {
        emb_jump_errors(s.value, acc)
    } else {
        emb_value_errors(s.value, acc)
    }
}

emb_if_errors(e: Expr, acc: str[]) -> str[] =>
    emb_branch_errors(e.children.get(2),
                      emb_branch_errors(e.children.get(1),
                                        emb_value_errors(e.children.get(0),
                                                         acc)))

emb_branch_errors(e: Expr, acc: str[]) -> str[] {
    if emb_no_else(e) {
        acc
    } else if e.kind == EBlock {
        emb_one_errors(s_expr(e.children.get(0)),
                       emb_stmt_errors(e.stmts, 0, acc))
    } else {
        emb_one_errors(s_expr(e), acc)
    }
}

emb_jump_errors(e: Expr, acc: str[]) -> str[] {
    if e.children.length() == 0 {
        acc
    } else {
        emb_value_errors(e.children.get(0), acc)
    }
}

emb_value_errors(e: Expr, acc: str[]) -> str[] {
    refused = emb_refusal(e)

    if refused != "" {
        acc ++ [refused]
    } else {
        emb_child_errors(e.children, 0, acc)
    }
}

emb_child_errors(xs: Expr[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else {
        emb_child_errors(xs, i + 1, emb_value_errors(xs.get(i), acc))
    }
}

emb_refusal(e: Expr) -> str {
    named = emb_named(e)

    if e.kind == EBinary && e.text == "++" {
        "`++` needs an allocator; the embedded target is freestanding,"
            ++ " with no heap"
    } else if named == "" {
        ""
    } else {
        "{named} is not lowered on the embedded target"
    }
}

/** Name a construct the way the author wrote it, for a refusal message. */
emb_named(e: Expr) -> str {
    if emb_lowered(e) {
        ""
    } else if e.kind == EMatch {
        "`match`"
    } else if e.kind == EFloat {
        "a float literal (the target is integer-only)"
    } else if e.kind == EStr {
        "a string (the target has no allocator)"
    } else if e.kind == EList {
        "a list (the target has no allocator)"
    } else if e.kind == ERecord {
        "a record or sum value"
    } else if e.kind == EWith {
        "a record update"
    } else if e.kind == ELambda {
        "a closure"
    } else if e.kind == EIf {
        "`if` in value position"
    } else if e.kind == EBlock {
        "a block in value position"
    } else if e.kind == EJump {
        "`{e.text}` in value position"
    } else if e.kind == EMethod {
        "a method call (the target has no runtime)"
    } else if e.kind == EWhile || e.kind == EFor {
        "a loop in value position"
    } else if e.kind == EUnary {
        emb_effect_named(e.text)
    } else if e.kind == EBinary {
        "`{e.text}`"
    } else {
        "this construct"
    }
}

emb_effect_named(op: str) -> str {
    if op == "spawn" || op == "await" {
        "`await`/`spawn` (there is no scheduler)"
    } else {
        "the error operators (`?`, `fail`)"
    }
}

emb_lowered(e: Expr) -> bool {
    if e.kind == EInt || e.kind == EBool || e.kind == EIdent
            || e.kind == ECall || e.kind == EField || e.kind == ETernary {
        true
    } else if e.kind == EUnary {
        emb_prefix(e.text)
    } else if e.kind == EBinary {
        e.text == "=" || emb_infix(e.text)
    } else {
        false
    }
}
