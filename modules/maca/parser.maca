import maca/token
import maca/ast
import maca/lexer

PExpr = {
    node: Expr
    next: int
}

mk_pexpr(node: Expr, next: int) -> PExpr =>
    PExpr { node, next }

PStmt = {
    snode: Stmt
    snext: int
}

mk_pstmt(snode: Stmt, snext: int) -> PStmt =>
    PStmt { snode, snext }

PParams = {
    params: Expr[]
    pnext: int
}

mk_pparams(params: Expr[], pnext: int) -> PParams =>
    PParams { params, pnext }

PBlock = {
    bstmts: Stmt[]
    bnext: int
}

mk_pblock(bstmts: Stmt[], bnext: int) -> PBlock =>
    PBlock { bstmts, bnext }

PArgs = {
    aitems: Expr[]
    anext: int
}

mk_pargs(aitems: Expr[], anext: int) -> PArgs =>
    PArgs { aitems, anext }

parse_fn(ts: Token[], i: int) -> PStmt {
    name = ts.get(i).text
    pp = parse_params(ts, i + 2, [])
    afterp = pp.pnext + 1
    body_at = after_return_type(ts, afterp)

    if ts.get(body_at).kind == LBrace {
        mk_block_fn(ts, name, return_type(ts, afterp), pp.params, body_at)
    } else {
        mk_arrow_fn(ts, name, return_type(ts, afterp), pp.params, body_at)
    }
}

return_type(ts: Token[], at: int) -> str {
    if ts.get(at).kind != Arrow {
        ""
    } else if ts.get(at + 2).kind == LBracket {
        ts.get(at + 1).text ++ "[]"
    } else {
        ts.get(at + 1).text
    }
}

after_return_type(ts: Token[], at: int) -> int {
    if ts.get(at).kind != Arrow {
        at
    } else if ts.get(at + 2).kind == LBracket {
        at + 4
    } else {
        at + 2
    }
}

mk_arrow_fn(ts: Token[], name: str, ret: str, params: Expr[],
            at: int) -> PStmt {
    be = parse_expr(ts, at + 1)
    mk_pstmt(s_fn(name, ret, params, [s_expr(be.node)]), be.next)
}

mk_block_fn(ts: Token[], name: str, ret: str, params: Expr[],
            at: int) -> PStmt {
    pb = parse_block(ts, at + 1, [])
    mk_pstmt(s_fn(name, ret, params, pb.bstmts), pb.bnext)
}

parse_block(ts: Token[], i: int, acc: Stmt[]) -> PBlock {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        mk_pblock(acc, i + 1)
    } else if ts.get(i).kind == TIdent && ts.get(i + 1).kind == Eq {
        parse_bind_stmt(ts, i, acc)
    } else {
        parse_expr_stmt(ts, i, acc)
    }
}

parse_bind_stmt(ts: Token[], i: int, acc: Stmt[]) -> PBlock {
    name = ts.get(i).text
    v = parse_expr(ts, i + 2)
    parse_block(ts, v.next, acc ++ [s_bind(name, v.node)])
}

parse_expr_stmt(ts: Token[], i: int, acc: Stmt[]) -> PBlock {
    e = parse_expr(ts, i)
    parse_block(ts, e.next, acc ++ [s_expr(e.node)])
}

parse_module(ts: Token[], i: int, acc: Stmt[]) -> Module =>
    parse_items(ts, i, acc, [])

parse_items(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    if ts.get(i).kind == Eof {
        Module { items = acc, errors = bad }
    } else if ts.get(i).kind == KwImport {
        parse_items(ts, import_end(ts, i + 1), acc, bad)
    } else if is_record_decl(ts, i) {
        parse_record_decl(ts, i, acc, bad)
    } else if is_sum_decl(ts, i) {
        parse_sum_decl(ts, i, acc, bad)
    } else if starts_fn(ts, i) {
        parse_fn_item(ts, i, acc, bad)
    } else {
        parse_items(ts, i + 1, acc, bad ++ [skipped(ts, i)])
    }
}

skipped(ts: Token[], i: int) -> str =>
    "no declaration starts at `{ts.get(i).text}` (offset {ts.get(i).pos})"

starts_fn(ts: Token[], i: int) -> bool =>
    ts.get(i).kind == TIdent && ts.get(i + 1).kind == LParen

binds_a_name(ts: Token[], i: int) -> bool =>
    ts.get(i).kind == TIdent && ts.get(i + 1).kind == Eq

is_record_decl(ts: Token[], i: int) -> bool =>
    binds_a_name(ts, i) && ts.get(i + 2).kind == LBrace

is_sum_decl(ts: Token[], i: int) -> bool {
    if !binds_a_name(ts, i) || ts.get(i + 2).kind != TIdent {
        false
    } else if !is_upper(ts.get(i + 2).text) {
        false
    } else {
        ts.get(i + 3).kind == Bar || ts.get(i + 3).kind == LParen
    }
}

is_upper(w: str) -> bool =>
    w.length() > 0 && w.at(0).is_alpha() && w.at(0).upper() == w.at(0)

import_end(ts: Token[], i: int) -> int {
    if ts.get(i + 1).kind == Slash {
        import_end(ts, i + 2)
    } else {
        i + 1
    }
}

parse_sum_decl(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    name = ts.get(i).text
    sv = parse_variants(ts, i + 2, [])
    parse_items(ts, sv.pnext, acc ++ [s_sum(name, sv.params)], bad)
}

parse_variants(ts: Token[], i: int, acc: Expr[]) -> PParams {
    if ts.get(i).kind != TIdent {
        mk_pparams(acc, i)
    } else {
        one_variant(ts, i, acc)
    }
}

one_variant(ts: Token[], i: int, acc: Expr[]) -> PParams {
    v = parse_variant(ts, i)
    seen = acc ++ [v.node]

    if ts.get(v.next).kind == Bar {
        parse_variants(ts, v.next + 1, seen)
    } else {
        mk_pparams(seen, v.next)
    }
}

parse_variant(ts: Token[], i: int) -> PExpr {
    named = e_ident(ts.get(i).text)

    if ts.get(i + 1).kind == LParen {
        parse_payload(ts, i + 2, named)
    } else {
        mk_pexpr(named, i + 1)
    }
}

parse_payload(ts: Token[], i: int, v: Expr) -> PExpr {
    if ts.get(i).kind == Eof || ts.get(i).kind == RParen {
        mk_pexpr(v, i + 1)
    } else if ts.get(i).kind == Comma {
        parse_payload(ts, i + 1, v)
    } else {
        ty = e_typed(ts.get(i).text, ts.get(i).text)
        parse_payload(ts, i + 1, with_child(v, ty))
    }
}

parse_fn_item(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    ps = parse_fn(ts, i)
    parse_items(ts, ps.snext, acc ++ [ps.snode], bad)
}

parse_record_decl(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    name = ts.get(i).text
    rf = parse_fields(ts, i + 3, [])
    parse_items(ts, rf.pnext + 1, acc ++ [s_record(name, rf.params)], bad)
}

parse_fields(ts: Token[], i: int, acc: Expr[]) -> PParams {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        mk_pparams(acc, i)
    } else {
        parse_one_field(ts, i, acc)
    }
}

parse_one_field(ts: Token[], i: int, acc: Expr[]) -> PParams {
    fname = ts.get(i).text
    listed = is_listed(ts, i + 2)
    ftype = if listed { ts.get(i + 2).text ++ "[]" } else { ts.get(i + 2).text }
    after = if listed { i + 5 } else { i + 3 }
    seen = acc ++ [e_param(fname, ftype)]

    parse_fields(ts, skip_comma(ts, after), seen)
}

is_listed(ts: Token[], at: int) -> bool =>
    ts.get(at + 1).kind == LBracket && ts.get(at + 2).kind == RBracket

skip_comma(ts: Token[], i: int) -> int {
    if ts.get(i).kind == Comma {
        i + 1
    } else {
        i
    }
}

parse_params(ts: Token[], i: int, acc: Expr[]) -> PParams {
    if ts.get(i).kind == Eof || ts.get(i).kind == RParen {
        mk_pparams(acc, i)
    } else {
        parse_one_param(ts, i, acc)
    }
}

parse_one_param(ts: Token[], i: int, acc: Expr[]) -> PParams {
    seen = acc ++ [e_param(ts.get(i).text, param_type(ts, i))]

    parse_params(ts, skip_comma(ts, after_param_type(ts, i)), seen)
}

param_type(ts: Token[], i: int) -> str {
    if ts.get(i + 1).kind != Colon {
        ""
    } else if ts.get(i + 3).kind == LBracket {
        ts.get(i + 2).text ++ "[]"
    } else {
        ts.get(i + 2).text
    }
}

after_param_type(ts: Token[], i: int) -> int {
    if ts.get(i + 1).kind != Colon {
        i + 1
    } else if ts.get(i + 3).kind == LBracket {
        i + 5
    } else {
        i + 3
    }
}

prec_of(k: Kind) -> int {
    is_cmp = k == EqEq || k == NotEq || k == Lt || k == Gt || k == Le || k == Ge

    if k == Star || k == Slash || k == Percent {
        5
    } else if k == Plus || k == Minus || k == PlusPlus {
        4
    } else if is_cmp {
        3
    } else if k == AmpAmp {
        2
    } else if k == PipePipe {
        1
    } else {
        0
    }
}

parse_expr(ts: Token[], i: int) -> PExpr {
    lhs = parse_bin(ts, parse_primary(ts, i), 1)

    if ts.get(lhs.next).kind == Question {
        parse_ternary(ts, lhs)
    } else {
        lhs
    }
}

parse_ternary(ts: Token[], cond: PExpr) -> PExpr {
    then = parse_expr(ts, cond.next + 1)
    els = parse_expr(ts, then.next + 1)
    mk_pexpr(e_ternary(cond.node, then.node, els.node), els.next)
}

parse_bin(ts: Token[], lhs: PExpr, min_prec: int) -> PExpr {
    p = prec_of(ts.get(lhs.next).kind)

    if p < min_prec {
        lhs
    } else {
        climb(ts, lhs, p, min_prec)
    }
}

climb(ts: Token[], lhs: PExpr, p: int, min_prec: int) -> PExpr {
    op = ts.get(lhs.next).text
    rhs = parse_bin(ts, parse_primary(ts, lhs.next + 1), p + 1)
    node = e_binary(op, lhs.node, rhs.node)

    parse_bin(ts, mk_pexpr(node, rhs.next), min_prec)
}

parse_primary(ts: Token[], i: int) -> PExpr =>
    parse_postfix(ts, parse_atom(ts, i))

parse_postfix(ts: Token[], e: PExpr) -> PExpr {
    if ts.get(e.next).kind == Dot {
        parse_dot(ts, e)
    } else if ts.get(e.next).kind == KwWith {
        parse_with(ts, e)
    } else {
        e
    }
}

parse_with(ts: Token[], base: PExpr) -> PExpr {
    rf = parse_lit_fields(ts, base.next + 2, [])

    parse_postfix(ts, mk_pexpr(e_with(base.node, rf.aitems), rf.anext))
}

parse_dot(ts: Token[], e: PExpr) -> PExpr {
    name = ts.get(e.next + 1).text
    after = e.next + 2

    if ts.get(after).kind == LParen {
        parse_method(ts, e.node, name, after)
    } else {
        parse_postfix(ts, mk_pexpr(e_field(e.node, name), after))
    }
}

parse_method(ts: Token[], recv: Expr, name: str, lparen: int) -> PExpr {
    a = parse_args(ts, lparen + 1, [])
    parse_postfix(ts, mk_pexpr(e_method(recv, name, a.aitems), a.anext))
}

str_node(raw: str) -> Expr {
    if raw.contains("\{") {
        interp_node(raw)
    } else {
        e_str(raw)
    }
}

interp_node(raw: str) -> Expr =>
    join_parts(split_interp(raw.chars(), 0, false, "", []), 0, e_str(""))

split_interp(cs: str[], i: int, inside: bool, cur: str,
             acc: str[]) -> str[] {
    if i >= cs.length() {
        acc ++ [cur]
    } else {
        interp_step(cs, i, inside, cur, acc)
    }
}

interp_step(cs: str[], i: int, inside: bool, cur: str, acc: str[]) -> str[] {
    c = cs.get(i)
    opens = c == "\{" && !inside
    closes = c == "\}" && inside

    if opens || closes {
        split_interp(cs, i + 1, !inside, "", acc ++ [cur])
    } else {
        split_interp(cs, i + 1, inside, cur ++ c, acc)
    }
}

join_parts(parts: str[], i: int, acc: Expr) -> Expr {
    if i >= parts.length() {
        acc
    } else {
        join_parts(parts, i + 1, add_part(acc, parts.get(i), i))
    }
}

add_part(acc: Expr, piece: str, i: int) -> Expr {
    if i == 0 {
        e_str(piece)
    } else if i % 2 == 1 {
        e_binary("++", acc, e_call("str", [parse_fragment(piece)]))
    } else if piece == "" {
        acc
    } else {
        e_binary("++", acc, e_str(piece))
    }
}

parse_fragment(src: str) -> Expr =>
    parse_expr(lex(src), 0).node

parse_atom(ts: Token[], i: int) -> PExpr {
    t = ts.get(i)
    match t.kind {
        Minus    => parse_neg(ts, i)
        Bang     => parse_not(ts, i)
        TInt     => mk_pexpr(e_int(int(t.text)), i + 1)
        TFloat   => mk_pexpr(e_float(t.text), i + 1)
        TStr     => mk_pexpr(str_node(t.text), i + 1)
        KwTrue   => mk_pexpr(e_bool("true"), i + 1)
        KwFalse  => mk_pexpr(e_bool("false"), i + 1)
        KwMatch  => parse_match(ts, i)
        KwIf     => parse_if(ts, i)
        LBracket => parse_list(ts, i)
        TIdent   => parse_call_or_ident(ts, i)
        LParen   => parse_paren(ts, i)
        _        => mk_pexpr(e_ident("?"), i + 1)
    }
}

parse_list(ts: Token[], i: int) -> PExpr {
    el = parse_list_elems(ts, i + 1, [])
    mk_pexpr(e_list(el.aitems), el.anext)
}

parse_list_elems(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBracket {
        mk_pargs(acc, i + 1)
    } else {
        parse_one_elem(ts, i, acc)
    }
}

parse_one_elem(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    e = parse_expr(ts, i)

    parse_list_elems(ts, skip_comma(ts, e.next), acc ++ [e.node])
}

parse_if(ts: Token[], i: int) -> PExpr {
    cond = parse_expr(ts, i + 1)
    then = parse_branch(ts, cond.next)
    els = parse_else(ts, then.next)

    mk_pexpr(e_if(cond.node, then.node, els.node), els.next)
}

parse_branch(ts: Token[], brace: int) -> PExpr {
    pb = parse_block(ts, brace + 1, [])

    mk_pexpr(branch_value(pb.bstmts), pb.bnext)
}

branch_value(ss: Stmt[]) -> Expr {
    last = ss.get(ss.length() - 1)

    if ss.length() == 1 && last.kind == SExpr {
        last.value
    } else {
        e_block(ss.slice(0, ss.length() - 1), last.value)
    }
}

parse_else(ts: Token[], i: int) -> PExpr {
    if ts.get(i).kind != KwElse {
        mk_pexpr(e_ident("?"), i)
    } else if ts.get(i + 1).kind == KwIf {
        parse_if(ts, i + 1)
    } else {
        parse_branch(ts, i + 1)
    }
}

parse_match(ts: Token[], i: int) -> PExpr {
    scrut = parse_expr(ts, i + 1)
    arms = parse_arms(ts, scrut.next + 1, [scrut.node])
    mk_pexpr(e_match(arms.aitems), arms.anext)
}

parse_arms(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        mk_pargs(acc, i + 1)
    } else {
        parse_one_arm(ts, i, acc)
    }
}

parse_one_arm(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    p = parse_pattern(ts, i)
    body = parse_expr(ts, p.next + 1)

    parse_arms(ts, body.next, acc ++ [p.node, body.node])
}

parse_pattern(ts: Token[], i: int) -> PExpr {
    named = if ts.get(i).kind == TStr {
        str_node(ts.get(i).text)
    } else {
        e_ident(ts.get(i).text)
    }

    if ts.get(i + 1).kind == LParen {
        parse_binders(ts, i + 2, named)
    } else {
        mk_pexpr(named, i + 1)
    }
}

parse_binders(ts: Token[], i: int, p: Expr) -> PExpr {
    if ts.get(i).kind == Eof || ts.get(i).kind == RParen {
        mk_pexpr(p, i + 1)
    } else if ts.get(i).kind == Comma {
        parse_binders(ts, i + 1, p)
    } else {
        parse_binders(ts, i + 1, with_child(p, e_ident(ts.get(i).text)))
    }
}

parse_neg(ts: Token[], i: int) -> PExpr {
    operand = parse_primary(ts, i + 1)
    mk_pexpr(e_unary("-", operand.node), operand.next)
}

parse_not(ts: Token[], i: int) -> PExpr {
    operand = parse_primary(ts, i + 1)
    mk_pexpr(e_unary("!", operand.node), operand.next)
}

parse_paren(ts: Token[], i: int) -> PExpr {
    inner = parse_expr(ts, i + 1)
    mk_pexpr(inner.node, inner.next + 1)
}

parse_call_or_ident(ts: Token[], i: int) -> PExpr {
    name = ts.get(i).text

    if ts.get(i + 1).kind == LParen {
        parse_call(ts, i, name)
    } else if opens_record_lit(ts, i) {
        parse_record_lit(ts, i, name)
    } else {
        mk_pexpr(e_ident(name), i + 1)
    }
}

opens_record_lit(ts: Token[], i: int) -> bool {
    opens = ts.get(i + 1).kind == LBrace
    named = ts.get(i + 2).kind == TIdent
    after = ts.get(i + 3).kind

    opens && named && (after == Eq || after == Comma)
        && !block_shaped(ts, i + 2, 0)
}

ends_value(k: Kind) -> bool =>
    k == TIdent || k == TInt || k == TFloat || k == TStr
        || k == RParen || k == RBracket || k == KwTrue || k == KwFalse

starts_value(k: Kind) -> bool =>
    k == TIdent || k == TInt || k == TFloat || k == TStr
        || k == KwIf || k == KwMatch || k == KwTrue || k == KwFalse
        || k == Bang

block_shaped(ts: Token[], i: int, depth: int) -> bool {
    kind = ts.get(i).kind

    if kind == Eof {
        false
    } else if kind == RBrace && depth == 0 {
        false
    } else if kind == LBrace || kind == LParen || kind == LBracket {
        block_shaped(ts, i + 1, depth + 1)
    } else {
        block_after(ts, i, closes(kind, depth))
    }
}

closes(kind: Kind, depth: int) -> int {
    if kind == RBrace || kind == RParen || kind == RBracket {
        depth - 1
    } else {
        depth
    }
}

block_after(ts: Token[], i: int, depth: int) -> bool {
    if depth == 0 && ends_value(ts.get(i).kind)
            && starts_value(ts.get(i + 1).kind) {
        true
    } else {
        block_shaped(ts, i + 1, depth)
    }
}

parse_record_lit(ts: Token[], i: int, name: str) -> PExpr {
    rf = parse_lit_fields(ts, i + 2, [])
    mk_pexpr(e_record(name, rf.aitems), rf.anext)
}

parse_lit_fields(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        mk_pargs(acc, i + 1)
    } else {
        parse_one_lit_field(ts, i, acc)
    }
}

parse_one_lit_field(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    fname = ts.get(i).text

    if ts.get(i + 1).kind != Eq {
        parse_lit_fields(ts, skip_comma(ts, i + 1),
                         acc ++ [e_binary("=", e_ident(fname), e_ident(fname))])
    } else {
        v = parse_expr(ts, i + 2)

        parse_lit_fields(ts, skip_comma(ts, v.next),
                         acc ++ [e_binary("=", e_ident(fname), v.node)])
    }
}

parse_call(ts: Token[], i: int, name: str) -> PExpr {
    a = parse_args(ts, i + 2, [])
    mk_pexpr(e_call(name, a.aitems), a.anext)
}

parse_args(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    if ts.get(i).kind == Eof || ts.get(i).kind == RParen {
        mk_pargs(acc, i + 1)
    } else {
        parse_one_arg(ts, i, acc)
    }
}

parse_one_arg(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    a = parse_expr(ts, i)

    parse_args(ts, skip_comma(ts, a.next), acc ++ [a.node])
}
