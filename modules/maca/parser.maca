import maca/token
import maca/ast
import maca/lexer

PExpr = {
    node: Expr
    next: int
}

mk_pexpr(node: Expr, next: int) -> PExpr =>
    PExpr { node, next }

PStmt = {
    snode: Stmt
    snext: int
}

mk_pstmt(snode: Stmt, snext: int) -> PStmt =>
    PStmt { snode, snext }

PParams = {
    params: Expr[]
    pnext: int
}

mk_pparams(params: Expr[], pnext: int) -> PParams =>
    PParams { params, pnext }

PBlock = {
    bstmts: Stmt[]
    bnext: int
}

mk_pblock(bstmts: Stmt[], bnext: int) -> PBlock =>
    PBlock { bstmts, bnext }

PArgs = {
    aitems: Expr[]
    anext: int
}

mk_pargs(aitems: Expr[], anext: int) -> PArgs =>
    PArgs { aitems, anext }

parse_fn(ts: Token[], i: int) -> PStmt {
    name = ts.get(i).text
    pp = parse_params(ts, i + 2, [])
    afterp = pp.pnext + 1
    body_at = after_return_type(ts, afterp)

    if ts.get(body_at).kind == LBrace {
        mk_block_fn(ts, name, return_type(ts, afterp), pp.params, body_at)
    } else if ts.get(body_at).kind == FatArrow {
        mk_arrow_fn(ts, name, return_type(ts, afterp), pp.params, body_at)
    } else {
        mk_pstmt(s_fn(name, return_type(ts, afterp), pp.params, []), body_at)
    }
}

PType = {
    tname: str
    tnext: int
}

mk_ptype(tname: str, tnext: int) -> PType =>
    PType { tname, tnext }

scan_type(ts: Token[], i: int) -> PType =>
    type_post(ts, type_apply(ts, i + 1, ts.get(i).text))

type_apply(ts: Token[], i: int, head: str) -> PType {
    if is_upper(head) && type_arg_at(ts, i) {
        type_apply(ts, i + 1, head ++ " " ++ ts.get(i).text)
    } else {
        mk_ptype(head, i)
    }
}

type_arg_at(ts: Token[], i: int) -> bool {
    w = ts.get(i).text
    shaped = is_prim_name(w) || is_upper(w) || is_tyvar_name(w)

    ts.get(i).kind == TIdent && ts.get(i + 1).kind != Colon && shaped
}

is_prim_name(w: str) -> bool =>
    w == "int" || w == "float" || w == "str" || w == "bool" || w == "bytes"

is_tyvar_name(w: str) -> bool =>
    w.length() == 1 && !is_upper(w)

type_post(ts: Token[], t: PType) -> PType {
    listed = ts.get(t.tnext).kind == LBracket
        && ts.get(t.tnext + 1).kind == RBracket
    dotted = ts.get(t.tnext).kind == Dot && ts.get(t.tnext + 1).kind == TIdent

    if listed {
        type_post(ts, mk_ptype(t.tname ++ "[]", t.tnext + 2))
    } else if dotted {
        type_post(ts, mk_ptype("{t.tname}.{ts.get(t.tnext + 1).text}",
                               t.tnext + 2))
    } else {
        t
    }
}

return_type(ts: Token[], at: int) -> str {
    if ts.get(at).kind != Arrow {
        ""
    } else {
        scan_type(ts, at + 1).tname
    }
}

after_return_type(ts: Token[], at: int) -> int {
    if ts.get(at).kind != Arrow {
        at
    } else {
        scan_type(ts, at + 1).tnext
    }
}

mk_arrow_fn(ts: Token[], name: str, ret: str, params: Expr[],
            at: int) -> PStmt {
    be = parse_list_expr(ts, at + 1)
    mk_pstmt(s_fn(name, ret, params, [s_expr(be.node)]), be.next)
}

parse_list_expr(ts: Token[], i: int) -> PExpr {
    e = parse_expr(ts, i)

    if ts.get(e.next).kind != Comma {
        e
    } else {
        more_elems(ts, e.next + 1, [e.node])
    }
}

more_elems(ts: Token[], i: int, acc: Expr[]) -> PExpr {
    e = parse_expr(ts, i)
    seen = acc ++ [e.node]

    if ts.get(e.next).kind == Comma {
        more_elems(ts, e.next + 1, seen)
    } else {
        mk_pexpr(e_list(seen), e.next)
    }
}

mk_block_fn(ts: Token[], name: str, ret: str, params: Expr[],
            at: int) -> PStmt {
    pb = parse_block(ts, at + 1, [])
    mk_pstmt(s_fn(name, ret, params, pb.bstmts), pb.bnext)
}

parse_block(ts: Token[], i: int, acc: Stmt[]) -> PBlock {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        mk_pblock(acc, i + 1)
    } else if starts_local_fn(ts, i) {
        parse_local_fn(ts, i, acc)
    } else if binds_a_name(ts, i) {
        parse_bind_stmt(ts, i, acc)
    } else {
        parse_expr_stmt(ts, i, acc)
    }
}

starts_local_fn(ts: Token[], i: int) -> bool {
    if !starts_fn(ts, i) {
        false
    } else {
        at = after_return_type(ts, parse_params(ts, i + 2, []).pnext + 1)

        ts.get(at).kind == FatArrow || ts.get(at).kind == LBrace
    }
}

/// A function written inside a body is the name of a lambda, because C has no nested function.
parse_local_fn(ts: Token[], i: int, acc: Stmt[]) -> PBlock {
    made = parse_fn(ts, i)
    held = made.snode

    parse_block(ts, made.snext,
                acc ++ [s_bind(held.name,
                               e_lambda(held.params, body_expr(held.body)))])
}

/// A block answers with its last expression, or with the name its last statement set.
body_expr(stmts: Stmt[]) -> Expr {
    n = stmts.length()
    last = stmts.get(n - 1)

    if n == 1 && last.kind == SExpr {
        last.value
    } else if last.kind == SExpr {
        e_block(stmts.slice(0, n - 1), last.value)
    } else {
        e_block(stmts, e_ident(last.name))
    }
}

parse_bind_stmt(ts: Token[], i: int, acc: Stmt[]) -> PBlock {
    v = parse_list_expr(ts, bind_eq_at(ts, i + 1) + 1)
    made = s_bind_typed(ts.get(i).text, bind_type(ts, i + 1), v.node)

    parse_block(ts, v.next, acc ++ [made])
}

parse_expr_stmt(ts: Token[], i: int, acc: Stmt[]) -> PBlock {
    e = parse_expr(ts, i)

    if ts.get(e.next).kind == Eq {
        parse_store_stmt(ts, e, acc)
    } else {
        parse_block(ts, e.next, acc ++ [s_expr(e.node)])
    }
}

parse_store_stmt(ts: Token[], target: PExpr, acc: Stmt[]) -> PBlock {
    v = parse_expr(ts, target.next + 1)
    set = s_expr(e_binary("=", target.node, v.node))

    parse_block(ts, v.next, acc ++ [set])
}

parse_module(ts: Token[], i: int, acc: Stmt[]) -> Module =>
    parse_items(ts, i, acc, [])

parse_items(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    if ts.get(i).kind == Eof {
        Module { items = acc, errors = bad }
    } else if ts.get(i).kind == KwImport {
        parse_items(ts, import_end(ts, i + 1), acc, bad)
    } else if ts.get(i).kind == KwAlias {
        parse_items(ts, parse_expr(ts, i + 3).next, acc, bad)
    } else if is_const_word(ts, i) {
        parse_items(ts, i + 1, acc, bad)
    } else if is_record_decl(ts, i) {
        stamped(parse_record_decl(ts, i, acc, bad), acc.length(), ts.get(i).pos)
    } else if is_sum_decl(ts, i) {
        stamped(parse_sum_decl(ts, i, acc, bad), acc.length(), ts.get(i).pos)
    } else if starts_fn(ts, i) {
        stamped(parse_fn_item(ts, i, acc, bad), acc.length(), ts.get(i).pos)
    } else if binds_a_name(ts, i) {
        stamped(parse_const_item(ts, i, acc, bad), acc.length(), ts.get(i).pos)
    } else if binds_a_path(ts, i) {
        stamped(parse_path_item(ts, i, acc, bad), acc.length(), ts.get(i).pos)
    } else {
        parse_items(ts, i + 1, acc, bad ++ [skipped(ts, i)])
    }
}

stamped(m: Module, at: int, p: int) -> Module {
    if at >= m.items.length() {
        m
    } else {
        m with { items = m.items.set(at, at_pos(m.items.get(at), p)) }
    }
}

parse_const_item(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    at = bind_eq_at(ts, i + 1)
    got = parse_list_expr(ts, at + 1)
    made = s_bind_typed(ts.get(i).text, bind_type(ts, i + 1), got.node)

    parse_items(ts, past_as_const(ts, got.next), acc ++ [made], bad)
}

/// Config mode writes a whole dotted path on the left of `=`, and it is one name.
parse_path_item(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    end = path_end(ts, i + 1)
    got = parse_list_expr(ts, bind_eq_at(ts, end) + 1)
    made = s_bind_typed(dotted_name(ts, i, end, ""), bind_type(ts, end),
                        got.node)

    parse_items(ts, got.next, acc ++ [made], bad)
}

binds_a_path(ts: Token[], i: int) -> bool {
    end = path_end(ts, i + 1)

    ts.get(i).kind == TIdent && end > i + 1
        && ts.get(bind_eq_at(ts, end)).kind == Eq
}

path_end(ts: Token[], i: int) -> int {
    if ts.get(i).kind == Dot && ts.get(i + 1).kind == TIdent {
        path_end(ts, i + 2)
    } else {
        i
    }
}

dotted_name(ts: Token[], i: int, end: int, acc: str) -> str {
    if i >= end {
        acc
    } else {
        dotted_name(ts, i + 1, end, acc ++ ts.get(i).text)
    }
}

bind_type(ts: Token[], i: int) -> str {
    if ts.get(i).kind != Colon {
        ""
    } else {
        scan_type(ts, i + 1).tname
    }
}

skipped(ts: Token[], i: int) -> str =>
    "no declaration starts at `{ts.get(i).text}` (offset {ts.get(i).pos})"

starts_fn(ts: Token[], i: int) -> bool =>
    ts.get(i).kind == TIdent && ts.get(i + 1).kind == LParen

bind_eq_at(ts: Token[], i: int) -> int {
    if ts.get(i).kind != Colon {
        i
    } else {
        bind_eq_at(ts, scan_type(ts, i + 1).tnext)
    }
}

binds_a_name(ts: Token[], i: int) -> bool =>
    ts.get(i).kind == TIdent && ts.get(bind_eq_at(ts, i + 1)).kind == Eq

is_const_word(ts: Token[], i: int) -> bool =>
    ts.get(i).kind == TIdent && ts.get(i).text == "const"
        && binds_a_name(ts, i + 1)

past_as_const(ts: Token[], i: int) -> int {
    if ts.get(i).text == "as" && ts.get(i + 1).text == "const" {
        i + 2
    } else {
        i
    }
}

is_record_decl(ts: Token[], i: int) -> bool {
    at = bind_eq_at(ts, i + 1)

    binds_a_name(ts, i) && ts.get(at + 1).kind == LBrace
        && typed_fields(ts, at + 2)
}

/// A `:` in the braces gives a field its type; an `=` gives it a value, and that is a literal.
typed_fields(ts: Token[], i: int) -> bool =>
    ts.get(i).kind == RBrace
        || (ts.get(i).kind == TIdent && ts.get(i + 1).kind == Colon)

is_sum_decl(ts: Token[], i: int) -> bool {
    at = bind_eq_at(ts, i + 1)

    if !binds_a_name(ts, i) || ts.get(at + 1).kind != TIdent {
        false
    } else if !is_upper(ts.get(at + 1).text) {
        false
    } else {
        ts.get(at + 2).kind == Bar || ts.get(at + 2).kind == LParen
    }
}

is_upper(w: str) -> bool =>
    w.length() > 0 && w.at(0).is_alpha() && w.at(0).upper() == w.at(0)

import_end(ts: Token[], i: int) -> int {
    if ts.get(i).kind == LBrace {
        import_end(ts, selection_end(ts, i + 1) + 2)
    } else if ts.get(i).kind == TStr {
        i + 1
    } else if ts.get(i + 1).kind == TStr {
        i + 2
    } else if ts.get(i + 1).kind == Slash {
        import_end(ts, i + 2)
    } else {
        i + 1
    }
}

selection_end(ts: Token[], i: int) -> int {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        i
    } else {
        selection_end(ts, i + 1)
    }
}

parse_sum_decl(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    name = ts.get(i).text
    sv = parse_variants(ts, bind_eq_at(ts, i + 1) + 1, [])
    parse_items(ts, sv.pnext, acc ++ [s_sum(name, sv.params)], bad)
}

parse_variants(ts: Token[], i: int, acc: Expr[]) -> PParams {
    if ts.get(i).kind != TIdent {
        mk_pparams(acc, i)
    } else {
        one_variant(ts, i, acc)
    }
}

one_variant(ts: Token[], i: int, acc: Expr[]) -> PParams {
    v = parse_variant(ts, i)
    seen = acc ++ [v.node]

    if ts.get(v.next).kind == Bar {
        parse_variants(ts, v.next + 1, seen)
    } else {
        mk_pparams(seen, v.next)
    }
}

parse_variant(ts: Token[], i: int) -> PExpr {
    named = e_ident(ts.get(i).text)

    if ts.get(i + 1).kind == LParen {
        parse_payload(ts, i + 2, named)
    } else {
        mk_pexpr(named, i + 1)
    }
}

parse_payload(ts: Token[], i: int, v: Expr) -> PExpr {
    if ts.get(i).kind == Eof || ts.get(i).kind == RParen {
        mk_pexpr(v, i + 1)
    } else if ts.get(i).kind == Comma {
        parse_payload(ts, i + 1, v)
    } else {
        ty = e_typed(ts.get(i).text, ts.get(i).text)
        parse_payload(ts, i + 1, with_child(v, ty))
    }
}

parse_fn_item(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    ps = parse_fn(ts, i)
    parse_items(ts, ps.snext, acc ++ [ps.snode], bad)
}

parse_record_decl(ts: Token[], i: int, acc: Stmt[], bad: str[]) -> Module {
    name = ts.get(i).text
    rf = parse_fields(ts, bind_eq_at(ts, i + 1) + 2, [])
    parse_items(ts, rf.pnext + 1, acc ++ [s_record(name, rf.params)], bad)
}

parse_fields(ts: Token[], i: int, acc: Expr[]) -> PParams {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        mk_pparams(acc, i)
    } else {
        parse_one_field(ts, i, acc)
    }
}

parse_one_field(ts: Token[], i: int, acc: Expr[]) -> PParams {
    t = scan_type(ts, i + 2)
    seen = acc ++ [e_param(ts.get(i).text, t.tname)]

    parse_fields(ts, skip_comma(ts, t.tnext), seen)
}

skip_comma(ts: Token[], i: int) -> int {
    if ts.get(i).kind == Comma {
        i + 1
    } else {
        i
    }
}

parse_params(ts: Token[], i: int, acc: Expr[]) -> PParams {
    if ts.get(i).kind == Eof || ts.get(i).kind == RParen {
        mk_pparams(acc, i)
    } else {
        parse_one_param(ts, i, acc)
    }
}

parse_one_param(ts: Token[], i: int, acc: Expr[]) -> PParams {
    if ts.get(i).kind == Ellipsis {
        parse_params(ts, skip_comma(ts, after_param_type(ts, i + 1)),
                     acc ++ [rest_param(ts, i + 1)])
    } else {
        parse_params(ts, skip_comma(ts, after_param_type(ts, i)),
                     acc ++ [e_param(ts.get(i).text, param_type(ts, i))])
    }
}

/// `...rest: int` is one parameter holding every argument left, so it is a list.
rest_param(ts: Token[], i: int) -> Expr =>
    e_param(ts.get(i).text, param_type(ts, i) ++ "[]") with { ival = 1 }

param_type(ts: Token[], i: int) -> str {
    if ts.get(i + 1).kind != Colon {
        ""
    } else {
        scan_type(ts, i + 2).tname
    }
}

after_param_type(ts: Token[], i: int) -> int {
    if ts.get(i + 1).kind != Colon {
        i + 1
    } else {
        scan_type(ts, i + 2).tnext
    }
}

prec_of(k: Kind) -> int {
    is_cmp = k == EqEq || k == NotEq || k == Lt || k == Gt || k == Le || k == Ge

    if k == Star || k == Slash || k == Percent {
        7
    } else if k == Plus || k == Minus || k == PlusPlus {
        6
    } else if k == Shl || k == Shr {
        5
    } else if k == DotDot {
        4
    } else if is_cmp {
        3
    } else if k == AmpAmp {
        2
    } else if k == PipePipe {
        1
    } else {
        0
    }
}

parse_expr(ts: Token[], i: int) -> PExpr {
    lhs = parse_bin(ts, parse_primary(ts, i), 1)

    if ts.get(lhs.next).kind == Question {
        parse_ternary(ts, lhs)
    } else {
        lhs
    }
}

parse_ternary(ts: Token[], cond: PExpr) -> PExpr {
    then = parse_expr(ts, cond.next + 1)
    els = parse_expr(ts, then.next + 1)
    mk_pexpr(e_ternary(cond.node, then.node, els.node), els.next)
}

parse_bin(ts: Token[], lhs: PExpr, min_prec: int) -> PExpr {
    p = prec_of(ts.get(lhs.next).kind)

    if p < min_prec {
        lhs
    } else {
        climb(ts, lhs, p, min_prec)
    }
}

climb(ts: Token[], lhs: PExpr, p: int, min_prec: int) -> PExpr {
    op = ts.get(lhs.next).text
    rhs = parse_bin(ts, parse_primary(ts, lhs.next + 1), p + 1)
    node = e_binary(op, lhs.node, rhs.node)

    parse_bin(ts, mk_pexpr(node, rhs.next), min_prec)
}

parse_primary(ts: Token[], i: int) -> PExpr =>
    parse_postfix(ts, parse_atom(ts, i))

parse_postfix(ts: Token[], e: PExpr) -> PExpr {
    if ts.get(e.next).kind == LBracket && ts.get(e.next).fresh {
        e
    } else if ts.get(e.next).kind == QuestionPost {
        parse_postfix(ts, mk_pexpr(e.node, e.next + 1))
    } else if ts.get(e.next).kind == Dot {
        parse_dot(ts, e)
    } else if ts.get(e.next).kind == LBracket {
        parse_index(ts, e)
    } else if ts.get(e.next).kind == KwWith {
        parse_with(ts, e)
    } else {
        e
    }
}

parse_index(ts: Token[], e: PExpr) -> PExpr {
    ix = parse_expr(ts, e.next + 1)
    got = e_method(e.node, "get", [ix.node])

    parse_postfix(ts, mk_pexpr(got, ix.next + 1))
}

parse_with(ts: Token[], base: PExpr) -> PExpr {
    rf = parse_lit_fields(ts, base.next + 2, [])

    parse_postfix(ts, mk_pexpr(e_with(base.node, rf.aitems), rf.anext))
}

parse_dot(ts: Token[], e: PExpr) -> PExpr {
    name = ts.get(e.next + 1).text
    after = e.next + 2

    if ts.get(after).kind == LParen {
        parse_method(ts, e.node, name, after)
    } else {
        parse_postfix(ts, mk_pexpr(e_field(e.node, name), after))
    }
}

parse_method(ts: Token[], recv: Expr, name: str, lparen: int) -> PExpr {
    a = parse_args(ts, lparen + 1, [])
    parse_postfix(ts, mk_pexpr(e_method(recv, name, a.aitems), a.anext))
}

str_node(raw: str) -> Expr {
    if has_interp(raw.chars(), 0) {
        interp_node(raw)
    } else {
        e_str(plain_braces(raw.chars(), 0, ""))
    }
}

has_interp(cs: str[], i: int) -> bool {
    if i >= cs.length() {
        false
    } else if cs.get(i) == "\\" {
        has_interp(cs, i + 2)
    } else if pair_at(cs, i, "\{") {
        has_interp(cs, i + 2)
    } else if cs.get(i) == "\{" {
        true
    } else {
        has_interp(cs, i + 1)
    }
}

plain_braces(cs: str[], i: int, acc: str) -> str {
    if i >= cs.length() {
        acc
    } else if escaped_brace(cs, i) {
        plain_braces(cs, i + 2, acc ++ cs.get(i + 1))
    } else if pair_at(cs, i, "\{") || pair_at(cs, i, "\}") {
        plain_braces(cs, i + 2, acc ++ cs.get(i))
    } else {
        plain_braces(cs, i + 1, acc ++ cs.get(i))
    }
}

escaped_brace(cs: str[], i: int) -> bool {
    if cs.get(i) != "\\" || i + 1 >= cs.length() {
        false
    } else {
        cs.get(i + 1) == "\{" || cs.get(i + 1) == "\}"
    }
}

interp_node(raw: str) -> Expr =>
    join_parts(split_interp(raw.chars(), 0, false, "", []), 0, e_str(""))

split_interp(cs: str[], i: int, inside: bool, cur: str,
             acc: str[]) -> str[] {
    if i >= cs.length() {
        acc ++ [cur]
    } else {
        interp_step(cs, i, inside, cur, acc)
    }
}

interp_step(cs: str[], i: int, inside: bool, cur: str, acc: str[]) -> str[] {
    c = cs.get(i)
    opens = c == "\{" && !inside
    closes = c == "\}" && inside

    if escaped_brace(cs, i) {
        split_interp(cs, i + 2, inside, cur ++ cs.get(i + 1), acc)
    } else if !inside && (pair_at(cs, i, "\{") || pair_at(cs, i, "\}")) {
        split_interp(cs, i + 2, inside, cur ++ c, acc)
    } else if opens || closes {
        split_interp(cs, i + 1, !inside, "", acc ++ [cur])
    } else {
        split_interp(cs, i + 1, inside, cur ++ c, acc)
    }
}

pair_at(cs: str[], i: int, c: str) -> bool =>
    cs.get(i) == c && i + 1 < cs.length() && cs.get(i + 1) == c

join_parts(parts: str[], i: int, acc: Expr) -> Expr {
    if i >= parts.length() {
        acc
    } else {
        join_parts(parts, i + 1, add_part(acc, parts.get(i), i))
    }
}

add_part(acc: Expr, piece: str, i: int) -> Expr {
    if i == 0 {
        e_str(piece)
    } else if i % 2 == 1 {
        e_binary("++", acc, formatted(piece))
    } else if piece == "" {
        acc
    } else {
        e_binary("++", acc, e_str(piece))
    }
}

parse_fragment(src: str) -> Expr =>
    parse_expr(lex(src), 0).node

formatted(piece: str) -> Expr {
    cs = piece.chars()
    at = spec_start(cs, cs.length() - 1)

    if at < 0 {
        e_call("str", [parse_fragment(piece)])
    } else {
        spec_applied(parse_fragment(piece.slice(0, at)),
                     piece.slice(at + 1, piece.length()))
    }
}

/// The `:` opening a trailing format spec, or -1 when the colon is a ternary's.
spec_start(cs: str[], i: int) -> int {
    if i >= 0 && is_spec_char(cs.get(i)) {
        spec_start(cs, i - 1)
    } else if i < 1 || i == cs.length() - 1 || cs.get(i) != ":" {
        -1
    } else if cs.get(i - 1) == " " || cs.get(i - 1) == "\t" {
        -1
    } else {
        i
    }
}

is_spec_char(c: str) -> bool =>
    is_align(c) || c == "." || c.is_ascii_digit()

is_align(c: str) -> bool =>
    c == "<" || c == ">" || c == "^"

spec_applied(e: Expr, spec: str) -> Expr {
    rest = is_align(spec.at(0)) ? spec.slice(1, spec.length()) : spec
    dot = rest.index_of(".")
    width = dot < 0 ? rest : rest.slice(0, dot)
    prec = dot < 0 ? "" : rest.slice(dot + 1, rest.length())
    shown = shown_part(e, prec)
    fill = rest.length() > 1 && rest.at(0) == "0" ? "0" : " "

    if width == "" {
        shown
    } else {
        e_method(shown, pad_how(spec.at(0)), [e_int(int(width)), e_str(fill)])
    }
}

shown_part(e: Expr, prec: str) -> Expr {
    if prec == "" {
        e_call("str", [e])
    } else {
        e_method(e, "fixed", [e_int(int(prec))])
    }
}

pad_how(align: str) -> str {
    if align == "<" {
        "pad_end"
    } else if align == "^" {
        "pad_center"
    } else {
        "pad_start"
    }
}

parse_atom(ts: Token[], i: int) -> PExpr {
    t = ts.get(i)
    match t.kind {
        Minus    => parse_neg(ts, i)
        Bang     => parse_not(ts, i)
        TInt     => mk_pexpr(e_int(int(t.text)), i + 1)
        TFloat   => mk_pexpr(e_float(t.text), i + 1)
        TStr     => mk_pexpr(str_node(t.text), i + 1)
        KwTrue   => mk_pexpr(e_bool("true"), i + 1)
        KwFalse  => mk_pexpr(e_bool("false"), i + 1)
        KwMatch  => parse_match(ts, i)
        KwIf     => parse_if(ts, i)
        KwWhile  => parse_while(ts, i)
        KwFor    => parse_for(ts, i)
        KwBreak  => mk_pexpr(e_jump("break"), i + 1)
        KwContinue => mk_pexpr(e_jump("continue"), i + 1)
        KwReturn => parse_return(ts, i)
        KwFail   => parse_fail(ts, i)
        KwTry    => parse_try(ts, i)
        LBracket => parse_list(ts, i)
        LBrace   => parse_anon_record(ts, i)
        TIdent   => parse_call_or_ident(ts, i)
        LParen   => parse_paren(ts, i)
        _        => mk_pexpr(e_bad(ts.get(i).text), i + 1)
    }
}

parse_return(ts: Token[], i: int) -> PExpr {
    if ts.get(i + 1).kind == RBrace || ts.get(i + 1).kind == Eof {
        mk_pexpr(e_leave([]), i + 1)
    } else {
        left = parse_expr(ts, i + 1)

        mk_pexpr(e_leave([left.node]), left.next)
    }
}

parse_try(ts: Token[], i: int) -> PExpr {
    guarded = parse_expr(ts, i + 1)

    mk_pexpr(e_unary("try", guarded.node), guarded.next)
}

parse_fail(ts: Token[], i: int) -> PExpr {
    raised = parse_expr(ts, i + 1)

    mk_pexpr(e_unary("fail", raised.node), raised.next)
}

parse_list(ts: Token[], i: int) -> PExpr {
    el = parse_list_elems(ts, i + 1, [])
    mk_pexpr(e_list(el.aitems), el.anext)
}

parse_list_elems(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBracket {
        mk_pargs(acc, i + 1)
    } else {
        parse_one_elem(ts, i, acc)
    }
}

parse_one_elem(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    e = parse_expr(ts, i)

    parse_list_elems(ts, skip_comma(ts, e.next), acc ++ [e.node])
}

header_brace(ts: Token[], i: int, depth: int) -> int {
    k = ts.get(i).kind

    if k == Eof || (k == LBrace && depth == 0) {
        i
    } else if k == LParen || k == LBracket {
        header_brace(ts, i + 1, depth + 1)
    } else if k == RParen || k == RBracket {
        header_brace(ts, i + 1, depth - 1)
    } else {
        header_brace(ts, i + 1, depth)
    }
}

end_tok() -> Token =>
    mk_token(Eof, "", 0)

cond_tokens(ts: Token[], i: int, b: int) -> Token[] =>
    ts.slice(i, b) ++ [end_tok(), end_tok(), end_tok(), end_tok()]

parse_cond(ts: Token[], i: int) -> PExpr {
    b = header_brace(ts, i, 0)

    mk_pexpr(parse_expr(cond_tokens(ts, i, b), 0).node, b)
}

parse_while(ts: Token[], i: int) -> PExpr {
    cond = parse_cond(ts, i + 1)
    pb = parse_block(ts, cond.next + 1, [])

    mk_pexpr(e_while(cond.node, pb.bstmts), pb.bnext)
}

parse_for(ts: Token[], i: int) -> PExpr {
    over = parse_cond(ts, i + 3)
    pb = parse_block(ts, over.next + 1, [])

    mk_pexpr(e_for(ts.get(i + 1).text, over.node, pb.bstmts), pb.bnext)
}

parse_if(ts: Token[], i: int) -> PExpr {
    cond = parse_cond(ts, i + 1)
    then = parse_branch(ts, cond.next)
    els = parse_else(ts, then.next)

    mk_pexpr(e_if(cond.node, then.node, els.node), els.next)
}

parse_branch(ts: Token[], brace: int) -> PExpr {
    pb = parse_block(ts, brace + 1, [])

    mk_pexpr(body_expr(pb.bstmts), pb.bnext)
}

parse_else(ts: Token[], i: int) -> PExpr {
    if ts.get(i).kind != KwElse {
        mk_pexpr(e_ident("?"), i)
    } else if ts.get(i + 1).kind == KwIf {
        parse_if(ts, i + 1)
    } else {
        parse_branch(ts, i + 1)
    }
}

parse_match(ts: Token[], i: int) -> PExpr {
    scrut = parse_expr(ts, i + 1)
    arms = parse_arms(ts, scrut.next + 1, [scrut.node])
    mk_pexpr(e_match(arms.aitems), arms.anext)
}

parse_arms(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        mk_pargs(acc, i + 1)
    } else {
        parse_one_arm(ts, i, acc)
    }
}

parse_one_arm(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    p = parse_guarded(ts, parse_alts(ts, parse_commas(ts,
                                                     parse_pattern(ts, i))))
    body = parse_arm_body(ts, p.next + 1)

    parse_arms(ts, body.next, acc ++ [p.node, body.node])
}

/// An arm may answer with a block, the same way a branch of an `if` does.
parse_arm_body(ts: Token[], i: int) -> PExpr {
    if ts.get(i).kind == LBrace {
        parse_branch(ts, i)
    } else {
        parse_expr(ts, i)
    }
}

/// `"done", id => …` matches a list by position without brackets around it.
parse_commas(ts: Token[], p: PExpr) -> PExpr {
    if ts.get(p.next).kind != Comma {
        p
    } else {
        gathered(ts, mk_pexpr(with_child(e_ident("[]"), p.node), p.next))
    }
}

gathered(ts: Token[], p: PExpr) -> PExpr {
    if ts.get(p.next).kind != Comma {
        p
    } else if ts.get(p.next + 1).kind == DotDot {
        mk_pexpr(with_child(p.node with { text = "[..]" },
                            e_ident(ts.get(p.next + 2).text)), p.next + 3)
    } else {
        next = parse_pattern(ts, p.next + 1)

        gathered(ts, mk_pexpr(with_child(p.node, next.node), next.next))
    }
}

/// `Red | Green => …` is one arm that matches either, so the alternatives hang off one node.
parse_alts(ts: Token[], p: PExpr) -> PExpr {
    if ts.get(p.next).kind != Bar {
        p
    } else {
        next = parse_pattern(ts, p.next + 1)

        parse_alts(ts, mk_pexpr(e_binary("|", p.node, next.node), next.next))
    }
}

parse_guarded(ts: Token[], p: PExpr) -> PExpr {
    if ts.get(p.next).kind != KwIf {
        p
    } else {
        when = parse_expr(ts, p.next + 1)

        mk_pexpr(e_guard(p.node, when.node), when.next)
    }
}

parse_pattern(ts: Token[], i: int) -> PExpr {
    named = if ts.get(i).kind == TStr {
        str_node(ts.get(i).text)
    } else {
        e_ident(ts.get(i).text)
    }

    if ts.get(i).kind == LBrace {
        parse_fields_pattern(ts, i + 1, e_ident("{{}}"))
    } else if ts.get(i).kind == LBracket {
        parse_cells_pattern(ts, i + 1, e_ident("[]"))
    } else if ts.get(i + 1).kind == LParen {
        parse_binders(ts, i + 2, named)
    } else {
        mk_pexpr(named, i + 1)
    }
}

/// `[]`, `[x]` and `[x, ..rest]`: the cells the arm names, and whether a rest closes them.
parse_cells_pattern(ts: Token[], i: int, p: Expr) -> PExpr {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBracket {
        mk_pexpr(p, i + 1)
    } else if ts.get(i).kind == Comma {
        parse_cells_pattern(ts, i + 1, p)
    } else if ts.get(i).kind == DotDot || ts.get(i).kind == Ellipsis {
        parse_cells_pattern(ts, i + 2,
                            with_child(p with { text = "[..]" },
                                       e_ident(ts.get(i + 1).text)))
    } else {
        parse_cells_pattern(ts, i + 1, with_child(p, e_ident(ts.get(i).text)))
    }
}

/// `{ head, tail }` names the fields it wants, and matches whatever record carries them.
parse_fields_pattern(ts: Token[], i: int, p: Expr) -> PExpr {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        mk_pexpr(p, i + 1)
    } else if ts.get(i).kind == Comma {
        parse_fields_pattern(ts, i + 1, p)
    } else {
        parse_fields_pattern(ts, i + 1, with_child(p, e_ident(ts.get(i).text)))
    }
}

parse_binders(ts: Token[], i: int, p: Expr) -> PExpr {
    if ts.get(i).kind == Eof || ts.get(i).kind == RParen {
        mk_pexpr(p, i + 1)
    } else if ts.get(i).kind == Comma {
        parse_binders(ts, i + 1, p)
    } else {
        parse_binders(ts, i + 1, with_child(p, e_ident(ts.get(i).text)))
    }
}

parse_neg(ts: Token[], i: int) -> PExpr {
    operand = parse_primary(ts, i + 1)
    mk_pexpr(e_unary("-", operand.node), operand.next)
}

parse_not(ts: Token[], i: int) -> PExpr {
    operand = parse_primary(ts, i + 1)
    mk_pexpr(e_unary("!", operand.node), operand.next)
}

parse_task(ts: Token[], i: int, word: str) -> PExpr {
    operand = parse_primary(ts, i + 1)
    mk_pexpr(e_unary(word, operand.node), operand.next)
}

paren_end(ts: Token[], i: int, depth: int) -> int {
    k = ts.get(i).kind

    if k == Eof || (k == RParen && depth == 0) {
        i
    } else if k == LParen || k == LBracket || k == LBrace {
        paren_end(ts, i + 1, depth + 1)
    } else if k == RParen || k == RBracket || k == RBrace {
        paren_end(ts, i + 1, depth - 1)
    } else {
        paren_end(ts, i + 1, depth)
    }
}

parse_paren(ts: Token[], i: int) -> PExpr {
    shut = paren_end(ts, i + 1, 0)

    if ts.get(shut + 1).kind == FatArrow {
        parse_lambda(ts, i)
    } else {
        mk_pexpr(parse_expr(ts, i + 1).node, shut + 1)
    }
}

parse_lambda(ts: Token[], i: int) -> PExpr {
    pp = parse_params(ts, i + 1, [])
    body = parse_expr(ts, pp.pnext + 2)

    mk_pexpr(e_lambda(pp.params, body.node), body.next)
}

parse_call_or_ident(ts: Token[], i: int) -> PExpr {
    name = ts.get(i).text

    if name == "spawn" || name == "await" {
        parse_task(ts, i, name)
    } else if ts.get(i + 1).kind == FatArrow {
        parse_one_lambda(ts, i, name)
    } else if ts.get(i + 1).kind == LParen {
        parse_call(ts, i, name)
    } else if opens_record_lit(ts, i) {
        parse_record_lit(ts, i, name)
    } else {
        mk_pexpr(e_ident(name), i + 1)
    }
}

parse_one_lambda(ts: Token[], i: int, name: str) -> PExpr {
    body = parse_expr(ts, i + 2)

    mk_pexpr(e_lambda([e_param(name, "")], body.node), body.next)
}

opens_record_lit(ts: Token[], i: int) -> bool {
    opens = ts.get(i + 1).kind == LBrace
    named = ts.get(i + 2).kind == TIdent
    after = ts.get(i + 3).kind

    opens && named && (after == Eq || after == Comma)
        && !block_head(ts, i)
}

block_head(ts: Token[], i: int) -> bool {
    kind = ts.get(i).kind

    if kind == KwIf || kind == KwElse || kind == KwWhile
            || kind == KwFor || kind == KwMatch {
        true
    } else if i == 0 || ts.get(i).fresh
            || kind == LBrace || kind == RBrace {
        false
    } else {
        block_head(ts, i - 1)
    }
}

parse_record_lit(ts: Token[], i: int, name: str) -> PExpr {
    rf = parse_lit_fields(ts, i + 2, [])
    mk_pexpr(e_record(name, rf.aitems), rf.anext)
}

/// A value written as bare braces names no record, which is what a config's nesting is.
parse_anon_record(ts: Token[], i: int) -> PExpr {
    rf = parse_lit_fields(ts, i + 1, [])
    mk_pexpr(e_record("", rf.aitems), rf.anext)
}

parse_lit_fields(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    if ts.get(i).kind == Eof || ts.get(i).kind == RBrace {
        mk_pargs(acc, i + 1)
    } else {
        parse_one_lit_field(ts, i, acc)
    }
}

parse_one_lit_field(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    fname = ts.get(i).text

    if ts.get(i + 1).kind != Eq {
        parse_lit_fields(ts, skip_comma(ts, i + 1),
                         acc ++ [e_binary("=", e_ident(fname), e_ident(fname))])
    } else {
        v = lit_value(ts, i + 2)

        parse_lit_fields(ts, skip_comma(ts, v.next),
                         acc ++ [e_binary("=", e_ident(fname), v.node)])
    }
}

/// `xs = a, b` in braces is one field holding a list, because a field of its own would say `=`.
lit_value(ts: Token[], i: int) -> PExpr {
    v = parse_expr(ts, i)

    if ts.get(v.next).kind != Comma || ends_lit_value(ts, v.next + 1) {
        v
    } else {
        more_lit_elems(ts, v.next + 1, [v.node])
    }
}

more_lit_elems(ts: Token[], i: int, acc: Expr[]) -> PExpr {
    e = parse_expr(ts, i)
    seen = acc ++ [e.node]

    if ts.get(e.next).kind == Comma && !ends_lit_value(ts, e.next + 1) {
        more_lit_elems(ts, e.next + 1, seen)
    } else {
        mk_pexpr(e_list(seen), e.next)
    }
}

ends_lit_value(ts: Token[], i: int) -> bool {
    k = ts.get(i).kind
    after = ts.get(i + 1).kind

    k == RBrace || k == Eof
        || (k == TIdent && (after == Eq || after == Comma || after == RBrace))
}

parse_call(ts: Token[], i: int, name: str) -> PExpr {
    a = parse_args(ts, i + 2, [])
    mk_pexpr(e_call(name, a.aitems), a.anext)
}

parse_args(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    if ts.get(i).kind == Eof || ts.get(i).kind == RParen {
        mk_pargs(acc, i + 1)
    } else {
        parse_one_arg(ts, i, acc)
    }
}

parse_one_arg(ts: Token[], i: int, acc: Expr[]) -> PArgs {
    named = attr_name_end(ts, i)

    if named > i {
        v = parse_expr(ts, named + 1)

        parse_args(ts, skip_comma(ts, v.next),
                   acc ++ [e_attr(attr_name(ts, i, named, ""), v.node)])
    } else {
        a = parse_expr(ts, i)

        parse_args(ts, skip_comma(ts, a.next), acc ++ [a.node])
    }
}

attr_name_end(ts: Token[], i: int) -> int {
    end = name_run_end(ts, i)

    if ts.get(end).kind == Eq {
        end
    } else {
        i
    }
}

name_run_end(ts: Token[], i: int) -> int {
    if ts.get(i).kind == Eof {
        i
    } else if ts.get(i + 1).kind == Minus && ts.get(i + 2).kind == TIdent {
        name_run_end(ts, i + 2)
    } else {
        i + 1
    }
}

attr_name(ts: Token[], i: int, end: int, acc: str) -> str {
    if i >= end {
        acc
    } else {
        attr_name(ts, i + 1, end, acc ++ ts.get(i).text)
    }
}
