// ai/openai/chat: chat completions, over any host that speaks OpenAI's wire format.

import chaski/ask
import std/json

/** One turn of the conversation, as the wire format names it. */
Turn = {
    role:    str
    content: str
    call_id: str
}

/** Where to ask, as whom, and with what. */
Chat = {
    key:      str
    base:     str
    model:    str
    warmth:   float
    ceiling:  int
    seconds:  int
}

/** A tool the model asked for, with the arguments it filled in, as JSON text.
 */
Call = {
    id:        str
    name:      str
    arguments: str
}

/** What came back: the text, any tools it asked for, what it cost, and why it
 * failed.
 */
Answer = {
    text:  str
    model: str
    sent:  int
    got:   int
    error: str
    calls: Call[]
}

OpenAiBase = "https://api.openai.com/v1"

/** Pointed at OpenAI itself. */
openai(key: str) -> Chat =>
    compatible(key, OpenAiBase)

/** Pointed anywhere else that answers the same wire format, OpenRouter and
 * Ollama among them.
 */
compatible(key: str, base: str) -> Chat =>
    Chat { key = key, base = base, model = "gpt-4o-mini", warmth = 0.0,
           ceiling = 0, seconds = 120 }

with_model(c: Chat, name: str) -> Chat =>
    c with { model = name }

/** How far the model may wander, where 0 is as little as it can manage. */
with_warmth(c: Chat, t: float) -> Chat =>
    c with { warmth = t }

/** The most tokens the answer may run to, where 0 leaves it to the host. */
with_ceiling(c: Chat, n: int) -> Chat =>
    c with { ceiling = n }

turn(role: str, text: str) -> Turn =>
    Turn { role = role, content = text, call_id = "" }

system_turn(text: str) -> Turn =>
    turn("system", text)

user_turn(text: str) -> Turn =>
    turn("user", text)

assistant_turn(text: str) -> Turn =>
    turn("assistant", text)

/** One completion. The key never appears in a message, only in the header that
 * carries it.
 */
complete(c: Chat, ts: Turn[]) -> Answer =>
    complete_with(c, ts, [], [])

/** The same, with whatever else the wire format wants, as pairs beside the
 * standing ones.
 */
complete_with(c: Chat, ts: Turn[], more_keys: str[],
              more_values: str[]) -> Answer {
    if c.key == "" {
        return chat_failed("no API key: the caller has to supply one")
    }

    at = with_seconds(with_bearer(client(c.base), c.key), c.seconds)
    got = ask_json(at, "/chat/completions",
                   chat_body_with(c, ts, more_keys, more_values))

    if got.error != "" {
        return chat_failed(got.error)
    }

    reply_ok(got) ? chat_read(got.body) : chat_failed(chat_refusal(got))
}

chat_failed(why: str) -> Answer =>
    Answer { text = "", model = "", sent = 0, got = 0, error = why,
             calls = [] }

/** A host that refuses says why in the body, and that sentence is worth more
 * than the number.
 */
chat_refusal(r: Reply) -> str {
    said = get(get(r.body, "error"), "message")

    said == "" ? "the host answered {str(r.status)}"
               : "the host answered {str(r.status)}: {said}"
}

chat_body(c: Chat, ts: Turn[]) -> str =>
    chat_body_with(c, ts, [], [])

/** The body is pairs handed to `object_of`, so no field is ever spelled as
 * escaped braces, and a setting left alone is a pair never pushed.
 */
chat_body_with(c: Chat, ts: Turn[], more_keys: str[],
               more_values: str[]) -> str {
    ks = ["model", "messages"]
    vs = [quote(c.model), turns_json(ts)]

    if c.warmth != 0.0 {
        ks = ks.push("temperature")
        vs = vs.push(str(c.warmth))
    }

    if c.ceiling != 0 {
        ks = ks.push("max_tokens")
        vs = vs.push(str(c.ceiling))
    }

    object_of(ks ++ more_keys, vs ++ more_values)
}

turns_json(ts: Turn[]) -> str =>
    "[" ++ ts.map(t => turn_json(t)).join(",") ++ "]"

/** A turn that answers a tool call says which one, or the model cannot pair
 * them.
 */
turn_json(t: Turn) -> str {
    ks = ["role", "content"]
    vs = [quote(t.role), quote(t.content)]

    t.call_id == ""
        ? object_of(ks, vs)
        : object_of(ks.push("tool_call_id"), vs.push(quote(t.call_id)))
}

/** The answer is the first choice's message, and the usage beside it is what it
 * cost.
 */
chat_read(body: str) -> Answer {
    picks = items(get(body, "choices"))

    if picks.length() == 0 {
        return chat_failed("the host answered with no choices")
    }

    used = get(body, "usage")
    said = get(picks.get(0), "message")

    Answer { text = get(said, "content"),
             model = get(body, "model"),
             sent = get_int(used, "prompt_tokens", 0),
             got = get_int(used, "completion_tokens", 0),
             error = "",
             calls = chat_calls(items(get(said, "tool_calls")), 0, []) }
}

/** A tool the model asked for is a name and the arguments it filled in, still
 * as JSON text.
 */
chat_calls(xs: str[], i: int, acc: Call[]) -> Call[] {
    if i >= xs.length() {
        acc
    } else {
        fn = get(xs.get(i), "function")

        chat_calls(xs, i + 1,
                   acc.push(Call { id = get(xs.get(i), "id"),
                                   name = get(fn, "name"),
                                   arguments = get(fn, "arguments") }))
    }
}

/** The models the host will answer for, by name. */
models(c: Chat) -> str[] {
    at = with_seconds(with_bearer(client(c.base), c.key), c.seconds)
    got = ask_get(at, "/models")

    reply_ok(got) ? chat_names(items(get(got.body, "data")), 0, []) : []
}

chat_names(xs: str[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else {
        chat_names(xs, i + 1, acc.push(get(xs.get(i), "id")))
    }
}
