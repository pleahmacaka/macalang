import profile/trace

/// One end of one span.
Event = {
    name: str,
    at: int,
    depth: int,
    span: int,
    enter: bool,
}

/// Every enter and leave in the trace, in the order they happened.
events(t: Trace) -> Event[] {
    walked = walk_kids(t, roots(t), 0, [])

    in_order(walked, 1) ? walked : by_time(walked, 0, [])
}

in_order(evs: Event[], i: int) -> bool {
    if i >= evs.length() {
        true
    } else if evs.get(i).at < evs.get(i - 1).at {
        false
    } else {
        in_order(evs, i + 1)
    }
}

walk_kids(t: Trace, ids: int[], i: int, acc: Event[]) -> Event[] {
    if i >= ids.length() {
        acc
    } else {
        walk_kids(t, ids, i + 1, walk_span(t, ids.get(i), acc))
    }
}

walk_span(t: Trace, i: int, acc: Event[]) -> Event[] {
    s = t.spans.get(i)
    inside = walk_kids(t, children(t, i), 0, acc.push(edge(s, i, true)))

    inside.push(edge(s, i, false))
}

edge(s: Span, i: int, enter: bool) -> Event =>
    Event {
        name = s.name,
        at = enter ? s.start : s.end,
        depth = s.depth,
        span = i,
        enter = enter,
    }

by_time(evs: Event[], i: int, acc: Event[]) -> Event[] {
    if i >= evs.length() {
        acc
    } else {
        by_time(evs, i + 1, insert_by_time(acc, evs.get(i)))
    }
}

insert_by_time(acc: Event[], e: Event) -> Event[] {
    at = first_later(acc, e.at, 0)
    head = acc.slice(0, at).push(e)

    head ++ acc.slice(at, acc.length())
}

first_later(acc: Event[], at: int, i: int) -> int {
    if i >= acc.length() {
        i
    } else if acc.get(i).at > at {
        i
    } else {
        first_later(acc, at, i + 1)
    }
}

/// How many milliseconds separate event `i` from the one before it.
gap_before(evs: Event[], i: int) -> int {
    if i <= 0 || i >= evs.length() {
        0
    } else {
        evs.get(i).at - evs.get(i - 1).at
    }
}

/// Walk `evs` in time order, calling `on_event` with the index of each.
replay(evs: Event[], pace: int, on_event) -> int {
    step(evs, pace, 0, on_event)

    evs.length()
}

step(evs: Event[], pace: int, i: int, on_event) -> int {
    if i >= evs.length() {
        i
    } else {
        wait = gap_before(evs, i) * pace / 100

        if wait > 0 {
            sleep_ms(wait)
        }
        on_event(i)
        step(evs, pace, i + 1, on_event)
    }
}

/// One event as a line: when it happened, how deep it was, and which way it went.
narrate_line(e: Event) -> str {
    arrow = e.enter ? "→" : "←"
    stamp = "{e.at:>6}ms  "

    stamp ++ "  ".repeat(e.depth) ++ arrow ++ " " ++ e.name
}

/// The whole trace as lines, one per event, in the order they happened.
narrate(t: Trace) -> str[] => narrate_all(events(t), 0, [])

narrate_all(evs: Event[], i: int, acc: str[]) -> str[] {
    if i >= evs.length() {
        acc
    } else {
        narrate_all(evs, i + 1, acc.push(narrate_line(evs.get(i))))
    }
}
