// profile/report — where the time went, per name.
//
// The flame chart shows one run laid out in time. This shows the same run
// added up: for every span name, how often it ran, how long it held, how long
// it spent in its own code, and what share of the whole that was.
//
//   info(summary_table(t))
//   info(stats_table(summary(t).slice(0, 5)))     // just the top five
//
// Self time is the column to read. A span whose entire duration is one slow
// child is not itself slow, and a table ranked by duration puts every caller
// above the thing it was waiting for — which is how a profile ends up blaming
// `main`.

import profile/trace
import { pad_to, pad_num, percent, fit } from profile/flame
import { bold, dim, grey, width } from cli/style

/// One row: a name, and everything the run has to say about it.
///
/// `total` adds up the duration of every span with this name. For a name that
/// calls itself that counts the nested time more than once, which is why it is
/// not the column the table is sorted by. `own` cannot double-count: every
/// millisecond is charged to exactly one span, the innermost one running at
/// the time.
Stat = {
    name: str,
    calls: int,
    total: int,
    own: int,
    share: float,
}

/// Every name in the trace, heaviest self time first.
///
/// Names that tie keep the order they were first recorded in, so two runs of
/// the same program produce the same table and a diff of two reports shows
/// only what actually moved.
summary(t: Trace) -> Stat[] {
    counted = tally(t, 0, [])
    shared = with_shares(counted, wall(t), 0, [])

    by_self(shared, 0, [])
}

/// The row for `name`, or a zeroed one if the trace never recorded it. Saves a
/// caller hunting through the list to assert about a single region.
stat_of(stats: Stat[], name: str) -> Stat {
    at = index_named(stats, name, 0)

    if at < 0 {
        Stat { name = name, calls = 0, total = 0, own = 0, share = 0.0 }
    } else {
        stats.get(at)
    }
}

tally(t: Trace, i: int, acc: Stat[]) -> Stat[] {
    if i >= span_count(t) {
        acc
    } else {
        tally(t, i + 1, charge(acc, t.spans.get(i), self_time(t, i)))
    }
}

charge(acc: Stat[], s: Span, own: int) -> Stat[] {
    at = index_named(acc, s.name, 0)

    if at < 0 {
        acc.push(Stat {
            name = s.name,
            calls = 1,
            total = duration(s),
            own = own,
            share = 0.0,
        })
    } else {
        bump(acc, at, duration(s), own)
    }
}

// Rebuilt around the row rather than written through with `xs[i] = …`, which
// updates every other name for the same list — including a caller's copy.
bump(acc: Stat[], at: int, ms: int, own: int) -> Stat[] {
    was = acc.get(at)
    now = was with {
        calls = was.calls + 1,
        total = was.total + ms,
        own = was.own + own,
    }

    acc.slice(0, at).push(now) ++ acc.slice(at + 1, acc.length())
}

index_named(stats: Stat[], name: str, i: int) -> int {
    if i >= stats.length() {
        -1
    } else if stats.get(i).name == name {
        i
    } else {
        index_named(stats, name, i + 1)
    }
}

with_shares(stats: Stat[], whole: int, i: int, acc: Stat[]) -> Stat[] {
    if i >= stats.length() {
        acc
    } else {
        s = stats.get(i)
        with_shares(stats, whole, i + 1,
                    acc.push(s with { share = percent(s.own, whole) }))
    }
}

// A stable insertion sort. `sort` orders ints, not records, and stability is
// what makes ties fall back to the order the names were first seen instead of
// to whatever the sort happened to do.
by_self(stats: Stat[], i: int, acc: Stat[]) -> Stat[] {
    if i >= stats.length() {
        acc
    } else {
        by_self(stats, i + 1, insert_by_self(acc, stats.get(i)))
    }
}

insert_by_self(acc: Stat[], s: Stat) -> Stat[] {
    at = rank_of(acc, s.own, 0)
    head = acc.slice(0, at).push(s)

    head ++ acc.slice(at, acc.length())
}

rank_of(acc: Stat[], own: int, i: int) -> int {
    if i >= acc.length() {
        i
    } else if acc.get(i).own < own {
        i
    } else {
        rank_of(acc, own, i + 1)
    }
}

// ---- the table ------------------------------------------------------------

/// The summary as a table: name, calls, total, self, share.
summary_table(t: Trace) -> str => stats_table(summary(t))

/// The same table over rows the caller picked — the top five, everything above
/// a threshold, one name being watched. `summary(t).slice(0, 5)` is the common
/// one, and there is no other way to say it: the name column is sized to the
/// rows given, so a short table is no wider than it needs to be.
///
/// Written here rather than with `cli/show`, which cannot be linked into the
/// same program as `std/text` — and `profile/trace` reaches `std/text` through
/// `std/json`. `profile/flame` has the note.
stats_table(stats: Stat[]) -> str {
    if stats.length() == 0 {
        dim("(nothing recorded)")
    } else {
        w = name_column(stats, 0, 4)
        rows = body(stats, w, 0, [])

        header(w) ++ rows.join("\n")
    }
}

header(w: int) -> str {
    labels = row_text("span", "calls", "total", "self", "share", w)
    under = row_text("─".repeat(w), "─────", "────────", "────────",
                     "───────", w)

    bold(labels) ++ "\n" ++ grey(under) ++ "\n"
}

body(stats: Stat[], w: int, i: int, acc: str[]) -> str[] {
    if i >= stats.length() {
        acc
    } else {
        body(stats, w, i + 1, acc.push(stat_row(stats.get(i), w)))
    }
}

stat_row(s: Stat, w: int) -> str =>
    row_text(fit(s.name, w), str(s.calls), "{s.total}ms", "{s.own}ms",
             "{s.share:.1}%", w)

// The name is the only column that grows; the four number columns are fixed,
// because a table whose columns move between runs cannot be diffed.
row_text(name: str, calls: str, total: str, own: str, share: str,
         w: int) -> str {
    left = pad_to(name, w) ++ "  " ++ pad_num(calls, 5)
    mid = "  " ++ pad_num(total, 8) ++ "  " ++ pad_num(own, 8)

    left ++ mid ++ "  " ++ pad_num(share, 7)
}

// Measured in columns, not bytes: a name in Korean is three bytes and two
// columns per character, and a table sized by `length()` leaves the number
// columns hanging a long way to the right of it.
name_column(stats: Stat[], i: int, best: int) -> int {
    if i >= stats.length() {
        best
    } else if width(stats.get(i).name) > best {
        name_column(stats, i + 1, width(stats.get(i).name))
    } else {
        name_column(stats, i + 1, best)
    }
}
