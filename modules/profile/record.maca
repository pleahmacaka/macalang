import profile/trace

/** One end of a region: the moment it opened or closed. */
Mark = {
    name: str,
    at: int,
    enter: bool,
}

/** A recording in progress. */
Rec = {
    label: str,
    marks: Mark[],
    open: int,
}

/** A fresh recorder. */
recorder(label: str) -> Rec => Rec { label = label, marks = [], open = 0 }

/** Open a region named `name`. */
start(r: Rec, name: str) -> Rec =>
    r with {
        marks = r.marks.push(Mark { name = name, at = now_ms(), enter = true }),
        open = r.open + 1,
    }

/** Close the innermost open region. */
stop(r: Rec) -> Rec =>
    r with {
        marks = r.marks.push(Mark { name = "", at = now_ms(), enter = false }),
        open = r.open > 0 ? r.open - 1 : 0,
    }

/** A region around a call (`start`, the work, `stop`) with no way to forget the
 * stop.
 */
span(r: Rec, name: str, body) -> Rec =>
    close_down_to(body(start(r, name)), r.open)

close_down_to(r: Rec, want: int) -> Rec {
    if r.open <= want {
        r
    } else {
        close_down_to(stop(r), want)
    }
}

/** An instant rather than a region: a zero-length span at the current moment.
 */
mark(r: Rec, name: str) -> Rec {
    at = now_ms()
    opened = r.marks.push(Mark { name = name, at = at, enter = true })

    r with { marks = opened.push(Mark { name = "", at = at, enter = false }) }
}

/** How many regions are open right now. */
open_count(r: Rec) -> int => r.open

/** Milliseconds since the first mark. */
elapsed(r: Rec) -> int {
    n = r.marks.length()

    n == 0 ? 0 : now_ms() - r.marks.get(0).at
}

Build = {
    spans: Span[],
    open: int[],
}

/** The trace of everything recorded so far. */
finish(r: Rec) -> Trace {
    marks = r.marks

    if marks.length() == 0 {
        trace(r.label, [])
    } else {
        base = marks.get(0).at
        built = build_spans(marks, base, 0, Build { spans = [], open = [] })
        now = now_ms() - base

        trace(r.label, extend_open(built.spans, built.open, 0, now))
    }
}

build_spans(ms: Mark[], base: int, i: int, b: Build) -> Build {
    if i >= ms.length() {
        b
    } else if ms.get(i).enter {
        build_spans(ms, base, i + 1, opened(b, ms.get(i), base))
    } else {
        build_spans(ms, base, i + 1, ended(b, ms.get(i), base))
    }
}

opened(b: Build, m: Mark, base: int) -> Build {
    n = b.open.length()
    inside = n > 0 ? b.open.get(n - 1) : -1
    fresh = Span {
        name = m.name,
        start = m.at - base,
        end = m.at - base,
        depth = n,
        parent = inside,
        closed = false,
    }

    Build {
        spans = b.spans.push(fresh),
        open = b.open.push(b.spans.length()),
    }
}

ended(b: Build, m: Mark, base: int) -> Build {
    n = b.open.length()

    if n == 0 {
        b
    } else {
        Build {
            spans = closed_at(b.spans, b.open.get(n - 1), m.at - base),
            open = b.open.slice(0, n - 1),
        }
    }
}

closed_at(xs: Span[], i: int, at: int) -> Span[] {
    xs[i] = xs.get(i) with { end = at, closed = true }
    xs
}

extend_open(xs: Span[], open: int[], i: int, now: int) -> Span[] {
    if i >= open.length() {
        xs
    } else {
        at = open.get(i)
        xs[at] = xs.get(at) with { end = now }
        extend_open(xs, open, i + 1, now)
    }
}
