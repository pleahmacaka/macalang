import profile/trace
import { paint, bold, dim, yellow, width, pad, pad_left } from cli/style
import { escape_html } from std/text

Scale = {
    base: int,
    total: int,
    cols: int,
}

scale_of(t: Trace, cols: int) -> Scale =>
    Scale { base = origin(t), total = wall(t), cols = cols }

column(sc: Scale, at: int) -> int {
    if sc.total <= 0 {
        0
    } else {
        (at - sc.base) * sc.cols / sc.total
    }
}

/// The trace as a text flame chart `cols` columns wide.
flame(t: Trace, cols: int) -> str {
    if span_count(t) == 0 {
        dim("(nothing recorded)")
    } else {
        rows = chart_rows(t, scale_of(t, cols), 0, [])

        chart_head(t) ++ "\n" ++ rows.join("\n") ++ leak_note(t)
    }
}

chart_head(t: Trace) -> str {
    seen = plural(span_count(t), "span") ++ ", " ++ plural(levels(t), "level")
    counts = ", {wall(t)}ms, " ++ seen

    bold(t.label) ++ dim(counts)
}

plural(n: int, noun: str) -> str {
    ending = n == 1 ? "" : "s"

    "{n} {noun}{ending}"
}

leak_note(t: Trace) -> str {
    open = leaked(t)

    if open.length() == 0 {
        ""
    } else {
        "\n" ++ yellow("!") ++ " never closed: " ++ open.join(", ")
    }
}

chart_rows(t: Trace, sc: Scale, d: int, acc: str[]) -> str[] {
    if d >= levels(t) {
        acc
    } else {
        row = lay_out(t, sc, level(t, d), 0, 0, "")
        chart_rows(t, sc, d + 1, acc.push(row))
    }
}

lay_out(t: Trace, sc: Scale, ids: int[], i: int, cursor: int,
        acc: str) -> str {
    if i >= ids.length() {
        acc
    } else {
        s = t.spans.get(ids.get(i))
        from = bar_start(sc, s, cursor)
        w = bar_width(sc, s, from)
        gap = " ".repeat(from - cursor)
        drawn = acc ++ gap ++ tint(ids.get(i), bar_text(s, w))

        lay_out(t, sc, ids, i + 1, from + w, drawn)
    }
}

bar_start(sc: Scale, s: Span, cursor: int) -> int {
    left = column(sc, s.start)

    left < cursor ? cursor : left
}

bar_width(sc: Scale, s: Span, from: int) -> int {
    w = column(sc, s.end) - from

    w < 1 ? 1 : w
}

bar_text(s: Span, w: int) -> str {
    if w < 3 {
        "▏".repeat(w)
    } else {
        "[" ++ inside(s.name, duration(s), w - 2) ++ "]"
    }
}

inside(name: str, ms: int, room: int) -> str {
    full = "{name} {ms}ms"

    if width(full) <= room {
        pad(full, room)
    } else if width(name) <= room {
        pad(name, room)
    } else {
        pad(fit(name, room - 1) ++ "…", room)
    }
}

/// `s` padded out to `w` columns, counting what shows rather than what is stored.
fit(s: str, n: int) -> str {
    if width(s) <= n {
        s
    } else {
        s.slice(0, widest_prefix(s, n, 0, 0))
    }
}

widest_prefix(s: str, n: int, i: int, best: int) -> int {
    if i > s.length() {
        best
    } else if !on_boundary(s, i) {
        widest_prefix(s, n, i + 1, best)
    } else if width(s.slice(0, i)) > n {
        best
    } else {
        widest_prefix(s, n, i + 1, i)
    }
}

on_boundary(s: str, i: int) -> bool {
    if i >= s.length() {
        true
    } else {
        b = ord(s.at(i))

        b < 128 || b >= 192
    }
}

tint(i: int, s: str) -> str => paint(sgr(i), s)

sgr(i: int) -> str {
    codes = ["36", "32", "33", "34", "35", "96"]

    codes.get(i % codes.length())
}

/// The same chart as a self-contained SVG `px` pixels wide.
flame_svg(t: Trace, px: int) -> str {
    inset = 8
    rows = levels(t)
    high = svg_head_h() + rows * svg_row() + inset
    sc = scale_of(t, px - inset * 2)
    body = svg_frames(t, sc, inset, 0, "")

    svg_open(px, high) ++ svg_backdrop(t, px, high, inset) ++ body ++ "</svg>\n"
}

svg_head_h() -> int => 38

svg_row() -> int => 22

svg_open(px: int, high: int) -> str {
    ns = "xmlns=\"http://www.w3.org/2000/svg\""
    box = "viewBox=\"0 0 {px} {high}\""
    face = "font-family=\"ui-monospace, monospace\" font-size=\"11\""

    "<svg {ns} width=\"{px}\" height=\"{high}\" {box} {face}>\n"
}

svg_backdrop(t: Trace, px: int, high: int, inset: int) -> str {
    back = "<rect width=\"{px}\" height=\"{high}\" fill=\"#12121a\"/>\n"
    name = escape_html(t.label)
    seen = plural(span_count(t), "span") ++ ", " ++ plural(levels(t), "level")
    counts = "{wall(t)}ms, " ++ seen
    top = "<text x=\"{inset}\" y=\"17\" fill=\"#f2f1f8\" font-weight=\"600\">"
    sub = "<text x=\"{inset}\" y=\"31\" fill=\"#8d8c9b\">"

    back ++ top ++ name ++ "</text>\n" ++ sub ++ counts ++ "</text>\n"
}

svg_frames(t: Trace, sc: Scale, inset: int, i: int, acc: str) -> str {
    if i >= span_count(t) {
        acc
    } else {
        svg_frames(t, sc, inset, i + 1, acc ++ svg_frame(t, sc, inset, i))
    }
}

svg_frame(t: Trace, sc: Scale, inset: int, i: int) -> str {
    s = t.spans.get(i)
    left = inset + column(sc, s.start)
    w = frame_width(sc, s, inset, left)
    y = svg_head_h() + s.depth * svg_row()
    tip = "<title>" ++ svg_tip(t, i) ++ "</title>"
    box = svg_rect(left, y, w, i)

    "<g>" ++ tip ++ box ++ svg_label(s, left, y, w) ++ "</g>\n"
}

frame_width(sc: Scale, s: Span, inset: int, left: int) -> int {
    w = inset + column(sc, s.end) - left

    w < 2 ? 2 : w
}

svg_rect(x: int, y: int, w: int, i: int) -> str {
    size = "x=\"{x}\" y=\"{y}\" width=\"{w}\" height=\"{svg_row() - 3}\""
    look = "rx=\"2\" fill=\"{swatch(i)}\" stroke=\"#12121a\""

    "<rect {size} {look}/>"
}

svg_label(s: Span, x: int, y: int, w: int) -> str {
    room = (w - 8) / 7

    if room < 3 {
        ""
    } else {
        text = escape_html(fit(s.name, room))
        at = "x=\"{x + 4}\" y=\"{y + svg_row() - 9}\""

        "<text {at} fill=\"#12121a\" font-weight=\"600\">" ++ text ++ "</text>"
    }
}

svg_tip(t: Trace, i: int) -> str {
    s = t.spans.get(i)
    share = percent(duration(s), wall(t))
    own = "self {self_time(t, i)}ms"

    escape_html(s.name) ++ ": {duration(s)}ms ({share:.1}%), " ++ own
}

/// `part` as a percentage of `whole`, and zero rather than a division by zero when nothing was measured.
percent(part: int, whole: int) -> float {
    if whole <= 0 {
        0.0
    } else {
        float(part) * 100.0 / float(whole)
    }
}

swatch(i: int) -> str {
    fills = ["#7fd6d0", "#8fd694", "#e3cd7a", "#9db6ea", "#cba4dd", "#8ad4e8"]

    fills.get(i % fills.length())
}
