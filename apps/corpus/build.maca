// corpus/build: TypeScript to Maca to JavaScript, graded by the package's own tests.

import std/fs
import std/text
import std/path
import std/list
import std/proc
import { Record, Failure, record_line, failure_line } from apps/corpus/record
import { permits, refusal } from apps/corpus/licence
import { bold, dim, ok, bad, grey } from cli/style

Collected = "apps/corpus/collected"
Out = "apps/corpus/corpus.jsonl"
Failures = "apps/corpus/failures.jsonl"

maca() -> str =>
    env_or("MACA", "target/release/maca")

/** The command that reads a prompt file and writes Maca to stdout.
 *
 * Deterministic rules are meant to take this over one construct at a time.
 * Until they do, the translator is a model, and it is a subprocess so that
 * swapping one for the other changes nothing else in the pipeline.
 */
translator() -> str =>
    env_or("MACA_CORPUS_MODEL", "")

/** One collected package, as `collect.maca` left it on disk. */
Package = { name: str, license: str, ts: str, test: str }

/** Every package under `Collected`, in a stable order. */
packages() -> Package[] =>
    read_all(walk_dirs(Collected).sort(), 0, [])

read_all(ds: str[], i: int, acc: Package[]) -> Package[] {
    if i >= ds.length() {
        acc
    } else {
        read_all(ds, i + 1, acc.push(read_one(ds.get(i))))
    }
}

read_one(dir: str) -> Package =>
    Package {
        name = basename(dir),
        license = read_or(join(dir, "LICENSE-ID"), ""),
        ts = read_or(join(dir, "source.ts"), ""),
        test = read_or(join(dir, "test.js"), ""),
    }

read_or(p: str, dflt: str) -> str =>
    file_exists(p) ? read_file(p) : dflt

/** Ask the translator for Maca, handing the prompt over as a file. */
translate(p: Package) -> str {
    scratch = join(env_or("TMPDIR", "/tmp"), "maca-corpus")
    make_dir(scratch)
    prompt = join(scratch, "prompt.txt")
    write_file(prompt, spec() ++ "\n\nTranslate this TypeScript to Maca. "
                       ++ "Reply with Maca source only.\n\n" ++ p.ts)

    capture(translator(), [prompt])
}

spec() -> str =>
    capture(maca(), ["spec", "--llm"])

/** Compile the Maca to JavaScript and run the package's own tests against it.
 *
 * The tests are the oracle. A translation that compiles is not a translation
 * that is right, and the only thing that knows the difference is the suite the
 * package already shipped.
 */
verify(p: Package, maca_src: str) -> Failure[] {
    scratch = join(join(env_or("TMPDIR", "/tmp"), "maca-corpus"), p.name)
    make_dir(scratch)
    src = join(scratch, "mod.maca")
    write_file(src, maca_src)

    if !try_run(maca(), ["check", src]) {
        [failed(p, "compile", capture(maca(), ["check", "--json", src]))]
    } else if !try_run(maca(), ["build", "--target", "js", src, "-o",
                                join(scratch, "out")]) {
        [failed(p, "compile", "checked, but the JS backend refused it")]
    } else {
        run_suite(p, scratch)
    }
}

run_suite(p: Package, scratch: str) -> Failure[] {
    harness = join(scratch, "test.js")
    write_file(harness, p.test)

    if !have("node") {
        [failed(p, "test", "no node on PATH, so the oracle could not be asked")]
    } else if try_run("node", [harness]) {
        []
    } else {
        [failed(p, "test", "the package's own tests rejected the translation")]
    }
}

failed(p: Package, stage: str, why: str) -> Failure =>
    Failure { pkg = p.name, license = p.license, stage = stage, why = why }

main(argv: str[]) -> int {
    if !file_exists(Collected) {
        err(bad("no {Collected}: run `maca -m corpus.collect <pkg>…` first"))
        1
    } else if translator() == "" {
        err(bad("set MACA_CORPUS_MODEL to a command taking a prompt file"))
        1
    } else {
        write_file(Out, "")
        write_file(Failures, "")
        run_all(packages(), 0, 0, 0)
    }
}

run_all(ps: Package[], i: int, kept: int, lost: int) -> int {
    if i >= ps.length() {
        info(ok("{kept} pairs") ++ dim(", {lost} failures with a reason"))
        0
    } else {
        p = ps.get(i)
        problems = attempt(p)

        if problems.length() == 0 {
            err(ok("  " ++ p.name))
            run_all(ps, i + 1, kept + 1, lost)
        } else {
            err(grey("  " ++ p.name ++ ": " ++ problems.get(0).stage))
            log_failures(problems, 0)
            run_all(ps, i + 1, kept, lost + 1)
        }
    }
}

/** One package end to end, appending its record when every stage answers. */
attempt(p: Package) -> Failure[] {
    if !permits(p.license) {
        one(failed(p, "licence", refusal(p.license)))
    } else if p.ts.trim() == "" {
        one(failed(p, "fetch", "nothing was collected for it"))
    } else {
        maca_src = translate(p)

        if maca_src.trim() == "" {
            one(failed(p, "translate", "the translator returned nothing"))
        } else {
            problems = verify(p, maca_src)

            if problems.length() == 0 {
                append_file(Out, record_line(Record {
                    pkg = p.name,
                    license = p.license,
                    ts_source = p.ts,
                    maca_source = maca_src,
                    test_result = "passed",
                }) ++ "\n")
                []
            } else {
                problems
            }
        }
    }
}

one(f: Failure) -> Failure[] => [f]

log_failures(fs: Failure[], i: int) -> bool {
    if i >= fs.length() {
        true
    } else {
        append_file(Failures, failure_line(fs.get(i)) ++ "\n")
        log_failures(fs, i + 1)
    }
}
