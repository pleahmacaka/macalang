// corpus/record: what a corpus line holds, and what a failure line holds instead.

import { quote } from std/json
import std/text

Open = "\{"
Close = "\}"

/** One accepted pair: a package's TypeScript, the Maca it became, and how its
 * own tests answered.
 */
Record = {
    pkg: str,
    license: str,
    ts_source: str,
    maca_source: str,
    test_result: str,
}

/** One rejected attempt, with the step that rejected it.
 *
 * Failures are the signal for improving the translator, so they are kept with
 * a reason rather than dropped. A pipeline that only records its successes
 * cannot tell you what to fix next.
 */
Failure = {
    pkg: str,
    license: str,
    step: str,
    why: str,
}

/** A record as one JSONL line. */
record_line(r: Record) -> str =>
    Open + field("pkg", r.pkg) + "," + field("license", r.license) + "," +
        field("ts_source", r.ts_source) + "," +
        field("maca_source", r.maca_source) + "," +
        field("test_result", r.test_result) + Close

/** A failure as one JSONL line. */
failure_line(f: Failure) -> str =>
    Open + field("pkg", f.pkg) + "," + field("license", f.license) + "," +
        field("step", f.step) + "," + field("why", f.why) + Close

field(key: str, value: str) -> str =>
    quote(key) + ":" + quote(value)

/** Every step a package can fall out at, named the same way in the log and in
 * the code.
 */
Steps = "licence", "fetch", "translate", "compile", "test"
