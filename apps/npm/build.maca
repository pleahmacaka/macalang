import std/proc
import std/path

Entry = "apps/npm/wasm.maca"
Package = "apps/npm"

main() -> int {
    dest = join(Package, "maca_wasm.wasm")

    run("maca", ["build", Entry, "--target", "wasm", "-o", dest])

    if file_size(dest) <= 0 {
        fail "no wasm at {dest}"
    }

    info("built maca_wasm.wasm ({file_size(dest)} bytes) in {Package}")
    0
}
