{
  "name": "@pleahmacaka/macalang",
  "version": "0.6.2",
  "description": "Compile and import Maca (.maca) from JavaScript: the Maca compiler front-end as WebAssembly.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": "./index.js",
    "./bun": "./bun-plugin.js"
  },
  "files": [
    "index.js",
    "bun-plugin.js",
    "maca_wasm.wasm",
    "README.md"
  ],
  "scripts": {
    "build": "cd ../.. && MACA=$PWD/bin/maca ./bin/maca run apps/npm/build.maca",
    "test": "node ./test.mjs",
    "prepublishOnly": "node ./test.mjs"
  },
  "keywords": [
    "maca",
    "macalang",
    "compiler",
    "wasm",
    "language",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pleahmacaka/macalang"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
