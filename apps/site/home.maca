    match f {
        Recursion => Feature {
            title = "재귀 위주",
            body = "트리 재귀와 중첩 재귀. 함수 호출 비용이 곧 프로그램의"
                ++ " 비용인 경우입니다."
        }
        Compute => Feature {
            title = "계산 위주",
            body = "배열을 도는 촘촘한 루프와 부동소수점. 내부 루프가 곧"
                ++ " 프로그램의 비용인 경우입니다."
        }
    }

ko_standing(s: Standing) -> str =>
    match s {
        Ahead  => "C보다 빠름"
        Level  => "C와 같은 수준"
        Behind => "C보다 느림"
        Absent => "여기서는 측정되지 않음"
    }

ko_prov(p: Provenance, rs: Result[]) -> Fact =>
    match p {
        Host => Fact { label = "측정 환경", value = bench_host() }
        Tools => Fact { label = "툴체인", value = Toolchains }
        Runs => Fact { label = "측정 횟수",
                       value = "언어당 {timed_runs(rs)}회, 샘플의 중앙값,"
                           ++ " 프로세스 시작을 포함한 실측 시간" }
        Answers => Fact { label = "검증", value = ko_answers(rs) }
        Repro => Fact { label = "재현", value = "`" ++ ReproCommand ++ "`" }
    }

ko_answers(rs: Result[]) -> str {
    if all_verified(rs) {
        "모든 언어가 같은 체크섬을 출력했습니다"
    } else {
        "체크섬이 어긋난 커널: {disagreeing(rs)}"
    }
}

fact_of(c: Copy, s: Spec) -> Fact {
    if c.lang == "ko" {
        ko_fact(s)
    } else {
        en_fact(s)
    }
}

feature_of(c: Copy, t: Topic) -> Feature {
    if c.lang == "ko" {
        ko_feature(t)
    } else {
        en_feature(t)
    }
}

caveat_of(c: Copy, v: Caveat) -> str {
    if c.lang == "ko" {
        ko_caveat(v)
    } else {
        en_caveat(v)
    }
}

family_of(c: Copy, f: Family) -> Feature {
    if c.lang == "ko" {
        ko_family(f)
    } else {
        en_family(f)
    }
}

standing_of(c: Copy, s: Standing) -> str {
    if c.lang == "ko" {
        ko_standing(s)
    } else {
        en_standing(s)
    }
}

prov_of(c: Copy, p: Provenance, rs: Result[]) -> Fact {
    if c.lang == "ko" {
        ko_prov(p, rs)
    } else {
        en_prov(p, rs)
    }
}



default_lang() -> str =>
    copies().get(0).lang




StartChapter = "01-installing"

start_href(c: Copy, up: str) -> str =>
    up ++ c.lang ++ "/" ++ StartChapter ++ ".html"











BenchData = "apps/bench/results.json"

BenchReport = "apps/bench/results.md"

ReproCommand = "maca run apps/bench/run.maca"

Toolchains = "Maca `maca build` → `cc -O2`, C `cc -O2`, Rust `rustc -O`,"
    ++ " Go `go build`, JS `node`, Python `python3`"

MacaLang = "Maca"
BaseLang = "C"

bench_runs() -> Result[] =>
    load(BenchData)

family_kernels(f: Family) -> str[] =>
    match f {
        Recursion => recursion_kernels()
        Compute   => compute_kernels()
    }

timing(rs: Result[], algo: str, lang: str) -> float {
    at = find(rs, case_name(algo, lang))

    if at < 0 {
        -1.0
    } else {
        median_ms(rs.get(at))
    }
}

ratio(rs: Result[], algo: str) -> float {
    mine = timing(rs, algo, MacaLang)
    base = timing(rs, algo, BaseLang)

    if mine < 0.0 || base <= 0.0 {
        0.0
    } else {
        mine / base
    }
}

standing(rs: Result[], algo: str) -> Standing {
    r = ratio(rs, algo)

    if r <= 0.0 {
        Absent
    } else if r < 1.0 - Tolerance {
        Ahead
    } else if r > 1.0 + Tolerance {
        Behind
    } else {
        Level
    }
}

is_behind(rs: Result[], algo: str) -> bool =>
    match standing(rs, algo) {
        Behind => true
        _      => false
    }

/** The kernels Maca is slower than C on, in the harness's order. */
losses(rs: Result[]) -> str[] =>
    kept(rs, kernels(), 0, [])

kept(rs: Result[], ks: str[], i: int, acc: str[]) -> str[] {
    if i >= ks.length() {
        acc
    } else if is_behind(rs, ks.get(i)) {
        kept(rs, ks, i + 1, acc.push(ks.get(i)))
    } else {
        kept(rs, ks, i + 1, acc)
    }
}

answer(rs: Result[], algo: str, lang: str) -> int {
    at = find(rs, case_name(algo, lang))

    if at < 0 {
        0
    } else {
        rs.get(at).checksum
    }
}

verified(rs: Result[], algo: str) -> bool {
    want = answer(rs, algo, MacaLang)

    want != 0 && agree(rs, algo, langs(), 0, want)
}

agree(rs: Result[], algo: str, ls: str[], i: int, want: int) -> bool {
    if i >= ls.length() {
        true
    } else if answer(rs, algo, ls.get(i)) == 0 {
        agree(rs, algo, ls, i + 1, want)
    } else if answer(rs, algo, ls.get(i)) != want {
        false
    } else {
        agree(rs, algo, ls, i + 1, want)
    }
}

all_verified(rs: Result[]) -> bool =>
    unverified(rs, kernels(), 0, []).length() == 0

disagreeing(rs: Result[]) -> str =>
    unverified(rs, kernels(), 0, []).join(", ")

unverified(rs: Result[], ks: str[], i: int, acc: str[]) -> str[] {
    if i >= ks.length() {
        acc
    } else if verified(rs, ks.get(i)) {
        unverified(rs, ks, i + 1, acc)
    } else {
        unverified(rs, ks, i + 1, acc.push(ks.get(i)))
    }
}

timed_runs(rs: Result[]) -> int {
    if rs.length() == 0 {
        0
    } else {
        rs.get(0).samples.length()
    }
}

bench_host() -> str {
    stated = between(read_file(BenchReport), "_Host: ", ". Times")

    if stated == "" {
        fail "{BenchReport} no longer states the host it measured on"
    }

    stated
}

family_group(c: Copy, rs: Result[], f: Family) -> str =>
    div(class="mt-10",
        h3(class="font-semibold text-[1.05rem] m-0",
           escape_html(family_of(c, f).title))
        p(class="mt-1 text-[0.9rem] text-zinc-600 dark:text-zinc-400",
          prose(family_of(c, f).body))
        div(class="mt-5 grid gap-5",
            family_kernels(f).map(k => kernel_row(c, rs, k)).join("")))

kernel_row(c: Copy, rs: Result[], algo: str) -> str {
    mine = timing(rs, algo, MacaLang)
    base = timing(rs, algo, BaseLang)
    worst = mine > base ? mine : base

    div(class="grid gap-x-6 gap-y-3 md:grid-cols-[11rem_1fr] items-start",
        div(class="min-w-0",
            div(class="font-mono text-[0.9rem] font-medium", escape_html(algo))
            div(class="font-mono text-[0.75rem] text-zinc-500"
                      ++ " dark:text-zinc-400", escape_html(params(algo)))
            div(class="mt-2", verdict_chip(c, rs, algo)))
        div(class="min-w-0 grid gap-2",
            bar_row(MacaLang, mine, worst, mine_tone(rs, algo))
            bar_row(BaseLang, base, worst, "bg-zinc-300 dark:bg-zinc-600")))
}

verdict_chip(c: Copy, rs: Result[], algo: str) -> str =>
    span(class="inline-block px-2 py-[0.1rem] text-[0.72rem]"
               ++ " font-medium " ++ chip_tone(rs, algo),
         escape_html(ratio_text(rs, algo)
                     ++ standing_of(c, standing(rs, algo))))

ratio_text(rs: Result[], algo: str) -> str {
    r = ratio(rs, algo)

    if r <= 0.0 {
        ""
    } else {
        "×{r:.1} "
    }
}

/** A loss is a hole in the ink rather than a colour, so the site reads in one
 * hue.
 */
mine_tone(rs: Result[], algo: str) -> str {
    if is_behind(rs, algo) {
        "bg-white dark:bg-black border border-black dark:border-white"
    } else {
        "bg-zinc-900 dark:bg-zinc-100"
    }
}

/** The losing verdict is the filled one, so the page states its losses louder
 * than its wins.
 */
chip_tone(rs: Result[], algo: str) -> str {
    if is_behind(rs, algo) {
        "bg-zinc-900 dark:bg-zinc-100 text-white dark:text-black"
    } else {
        "bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400"
    }
}

bar_row(who: str, ms: float, worst: float, tone: str) -> str =>
    div(class="flex items-center gap-3",
        span(class="w-[3.2rem] shrink-0 text-[0.78rem] text-zinc-500"
                   ++ " dark:text-zinc-400", escape_html(who))
        span(class="flex-1 min-w-0 h-2 bg-zinc-100"
                   ++ " dark:bg-zinc-900 overflow-hidden",
             span(class="block h-2 " ++ tone,
                  style="width:{bar_width(ms, worst)}%"))
        span(class="w-[4.6rem] shrink-0 text-right font-mono tabular-nums"
                   ++ " text-[0.78rem]", escape_html(ms_text(ms))))

bar_width(ms: float, worst: float) -> int {
    if ms <= 0.0 || worst <= 0.0 {
        0
    } else if 100.0 * ms / worst < 2.0 {
        2
    } else {
        int(100.0 * ms / worst)
    }
}

ms_text(ms: float) -> str {
    if ms < 0.0 {
        "n/a"
    } else {
        "{ms:.0} ms"
    }
}

bench_table(c: Copy, rs: Result[]) -> str =>
    div(class="mt-10",
        p(class="text-[0.85rem] text-zinc-500 dark:text-zinc-400 m-0",
          prose(c.tbl_note))
        div(class="mt-3 overflow-x-auto",
            table(class="w-full border-collapse text-[0.82rem]",
                thead(tr(head_cell(c.tbl_kernel) ++ head_cell(c.tbl_workload)
                         ++ langs().map(head_cell).join("")))
                tbody(kernels().map(k => table_row(rs, k)).join("")))))

head_cell(text: str) -> str =>
    th(class="border-b border-zinc-300 dark:border-zinc-700 px-3 py-2"
             ++ " text-left font-medium whitespace-nowrap text-zinc-500"
             ++ " dark:text-zinc-400", escape_html(text))

table_row(rs: Result[], algo: str) -> str =>
    tr(th(class=body_cell() ++ " text-left font-mono font-medium",
          scope="row", escape_html(algo))
       ++ td(class=body_cell() ++ " text-zinc-500 dark:text-zinc-400",
             escape_html(params(algo)))
       ++ langs().map(l => lang_cell(rs, algo, l)).join(""))

body_cell() -> str =>
    "border-b border-zinc-100 dark:border-zinc-900 px-3 py-2 align-top"
        ++ " whitespace-nowrap"

lang_cell(rs: Result[], algo: str, lang: str) -> str =>
    td(class=body_cell() ++ " font-mono tabular-nums " ++ cell_tone(lang),
       escape_html(cell_text(rs, algo, lang)))

cell_tone(lang: str) -> str {
    if lang == MacaLang {
        "font-medium"
    } else {
        "text-zinc-600 dark:text-zinc-400"
    }
}

cell_text(rs: Result[], algo: str, lang: str) -> str {
    ms = timing(rs, algo, lang)
    base = timing(rs, algo, BaseLang)

    if ms < 0.0 {
        "n/a"
    } else if base <= 0.0 {
        "{ms:.0}"
    } else {
        "{ms:.0} (×{ms / base:.1})"
    }
}

bench_provenance(c: Copy, rs: Result[]) -> str =>
    div(class="mt-8 pt-6 border-t border-zinc-200 dark:border-zinc-800",
        div(class="grid gap-5 sm:grid-cols-2 md:grid-cols-3",
            provenance().map(key => prov_cell(prov_of(c, key, rs)))
                        .join(""))
        div(class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[0.85rem]",
            a(class="underline text-inherit", href=bench_doc("README.md"),
              escape_html(c.bench_readme))
            a(class="underline text-inherit", href=bench_doc("results.md"),
              escape_html(c.bench_full))))

bench_doc(file: str) -> str =>
    Repo ++ "/blob/main/apps/bench/" ++ file

prov_cell(f: Fact) -> str =>
    div(class=Cell,
        div(class=Eyebrow, escape_html(f.label))
        div(class="mt-3 " ++ Muted, prose(f.value)))







/** Every page the site writes, which is also the order the directory lists
 * them.
 */
Key = Home | Language | Benchmarks | Evals | Targets | Install | Limits

keys() -> Key[] =>
    Language, Benchmarks, Evals, Targets, Limits

/** The file a key is written to, under a language directory. */
page_file(k: Key) -> str =>
    match k {
        Home       => "home"
        Language   => "language"
        Benchmarks => "benchmarks"
        Evals      => "evals"
        Targets    => "targets"
        Install    => "install"
        Limits     => "limits"
    }

/** Where a key sits in the directory, printed as a two digit ordinal. */
ordinal(k: Key) -> str =>
    match k {
        Home       => "00"
        Language   => "01"
        Benchmarks => "02"
        Evals      => "03"
        Targets    => "04"
        Install    => "09"
        Limits     => "05"
    }

title_of(c: Copy, k: Key) -> str =>
    match k {
        Home       => c.title
        Language   => c.box_title
        Benchmarks => c.bench_title
        Evals      => c.eval_title
        Targets    => c.tgt_title
        Install    => c.install
        Limits     => c.lim_title
    }

blurb_of(c: Copy, k: Key) -> str =>
    match k {
        Home       => c.sub
        Language   => c.box_sub
        Benchmarks => c.bench_sub
        Evals      => c.eval_sub
        Targets    => c.tgt_sub
        Install    => c.install_more
        Limits     => c.lim_sub
    }

/** The default language is written twice: once at the root and once under its
 * own directory.
 */
page_href(o: Copy, up: str, k: Key) -> str =>
    up ++ o.lang ++ "/" ++ page_file(k) ++ ".html"

home_href(c: Copy, up: str) -> str {
    if c.lang == default_lang() {
        return up ++ "index.html"
    }

    page_href(c, up, Home)
}

canonical(c: Copy, up: str, k: Key) -> str {
    if k == Home && c.lang == default_lang() {
        return up ++ "index.html"
    }

    page_href(c, up, k)
}

alternates(up: str, k: Key) -> str =>
    copies().map(o => link(rel="alternate", hreflang=o.lang,
                           href=canonical(o, up, k))).join("")
        ++ link(rel="alternate", hreflang="x-default",
                href=canonical(copies().get(0), up, k))

/** The whole chrome every page on this site shares. */
document(c: Copy, up: str, k: Key, ...body: str) -> str =>
    "<!doctype html>\n"
        ++ html(lang=c.lang,
            head(
                meta(charset="utf-8")
                meta(name="viewport",
                     content="width=device-width,initial-scale=1")
                meta(name="description", content=c.descr)
                meta(property="og:title", content=title_of(c, k))
                meta(property="og:description", content=c.descr)
                meta(property="og:type", content="website")
                meta(property="og:locale", content=c.locale)
                meta(name="twitter:card", content="summary")
                link(rel="canonical", href=canonical(c, up, k))
                alternates(up, k)
                title_tag(c.title)
                font_link(up)
                style(base_css() ++ code_css() ++ styles())
            )
            body_tag(page_class("font-sans"),
                skip_link(c)
                    ++ masthead(c, up)
                    ++ element("main", id="content", tabindex="-1",
                               body.join(""))
                    ++ colophon(c))) ++ "\n"

skip_link(c: Copy) -> str =>
    a(class="absolute left-[-9999px] focus:left-2 focus:top-2 focus:z-30"
            ++ " bg-white dark:bg-zinc-950 px-4 py-2 border border-zinc-300"
            ++ " dark:border-zinc-700 text-inherit",
      href="#content", escape_html(c.skip))

masthead(c: Copy, up: str) -> str =>
    header(class="border-b border-zinc-200 dark:border-zinc-800",
        div(class=Frame ++ " flex flex-wrap items-center justify-between"
                  ++ " gap-x-6 gap-y-3 py-4",
            a(class="font-bold text-[1.1rem] no-underline text-inherit"
                    ++ " tracking-tight focus:underline",
              href=home_href(c, up), "Maca")
            nav(aria-label=c.nav_label,
                class="flex flex-wrap items-center gap-x-6 gap-y-3",
                a(class=NavLink, href=up ++ c.lang ++ "/index.html",
                  escape_html(c.nav_docs))
                a(class=NavLink, href=up ++ "api/index.html",
                  escape_html(c.nav_api))
                a(class=NavLink, href=up ++ "play/index.html",
                  escape_html(c.cta_play))
                a(class=NavLink, href=Repo, "GitHub")
                lang_control(c, up, Home))))

/** The language control: one disclosure, never a row of links. */
lang_control(c: Copy, up: str, k: Key) -> str =>
    nav(aria-label=c.lang_label, class="relative shrink-0",
        details(data-site="lang",
            lang_summary(c.endonym)
            ul(class=LangMenu,
               copies().map(o => lang_option(c, up, k, o)).join(""))))

lang_option(c: Copy, up: str, k: Key, other: Copy) -> str {
    if other.lang == c.lang {
        return lang_item_current(other.endonym)
    }

    lang_item(other.endonym, page_href(other, up, k), other.lang)
}

colophon(c: Copy) -> str =>
    footer(class="border-t border-zinc-200 dark:border-zinc-800",
        div(class=Frame ++ " py-10 " ++ Muted,
            p(class="m-0", prose(c.footer))
            p(class="mt-2 m-0",
              a(class=InlineLink, href=Repo,
                "github.com/pleahmacaka/macalang"))))

/** The front page: a banner, four facts, and the eight places the site goes. */
directory_page(c: Copy, up: str, rs: Result[]) -> str =>
    document(c, up, Home,
        section(class=Frame ++ " py-14 md:py-20 grid gap-10 md:grid-cols-12"
                      ++ " md:items-center",
            div(class="md:col-span-7 min-w-0",
                h1(class="m-0 " ++ Display, escape_html(c.headline))
                p(class="mt-5 m-0 " ++ Lead, prose(c.sub))
                div(class="mt-8 flex flex-wrap gap-3",
                    a(class=Primary, href=start_href(c, up),
                      escape_html(c.cta_start))
                    a(class=Ghost, href=up ++ "play/index.html",
                      escape_html(c.cta_play))))
            div(class="md:col-span-5 min-w-0",
                code_panel(HeroSample, "maca")))
        section(class=Frame ++ " pb-14",
            div(class=lattice("grid-cols-2 md:grid-cols-4"),
                specs().map(sp => fact_cell(fact_of(c, sp))).join("")))
        section(class=Frame ++ " pb-14",
            div(class=lattice("grid-cols-1 sm:grid-cols-2 md:grid-cols-4"),
                keys().map(k => dest_cell(c, up, k, rs)).join("")
                    ++ handbook_cell(c, up) ++ reference_cell(c, up)
                    ++ play_cell(c, up)))
        install_strip(c, up))

/** One destination, which ends in a figure and the file that figure came from.
 */
dest_cell(c: Copy, up: str, k: Key, rs: Result[]) -> str {
    r = reading_of(k, rs)

    a(class=CellLink, href=page_href(c, up, k),
      div(class=Ordinal, ordinal(k))
      div(class="mt-3 " ++ CellTitle, escape_html(title_of(c, k)))
      div(class="mt-5 " ++ Figure, escape_html(r.value))
      div(class="mt-1 " ++ Unit, escape_html(r.unit)))
}

handbook_cell(c: Copy, up: str) -> str {
    r = handbook_reading()

    a(class=CellLink, href=up ++ c.lang ++ "/index.html",
      div(class=Ordinal, "06")
      div(class="mt-3 " ++ CellTitle, escape_html(c.nav_docs))
      div(class="mt-5 " ++ Figure, escape_html(r.value))
      div(class="mt-1 " ++ Unit, escape_html(r.unit)))
}

reference_cell(c: Copy, up: str) -> str {
    r = reference_reading()

    a(class=CellLink, href=up ++ "api/index.html",
      div(class=Ordinal, "07")
      div(class="mt-3 " ++ CellTitle, escape_html(c.nav_api))
      div(class="mt-5 " ++ Figure, escape_html(r.value))
      div(class="mt-1 " ++ Unit, escape_html(r.unit)))
}

play_cell(c: Copy, up: str) -> str =>
    a(class=CellLink, href=up ++ "play/index.html",
      div(class=Ordinal, "08")
      div(class="mt-3 " ++ CellTitle, escape_html(c.cta_play))
      div(class="mt-5 " ++ Figure, "0")
      div(class="mt-1 " ++ Unit, escape_html(c.play_unit)))

/** The figure a destination carries, computed from a committed file. */
reading_of(k: Key, rs: Result[]) -> Reading =>
    match k {
        Home       => release_reading()
        Language   => Reading { value = "{topics().length()}",
                                unit = "capabilities", from = SiteCopy }
        Benchmarks => Reading { value = "{ahead_count(rs)} of"
                                        ++ " {kernels().length()}",
                                unit = "kernels at or ahead of C",
                                from = BenchData }
        Evals      => eval_reading()
        Targets    => Reading { value = "{targets().length()}",
                                unit = "back ends", from = SiteCopy }
        Install    => release_reading()
        Limits     => Reading { value = "{caveats().length()}",
                                unit = "known caveats", from = SiteCopy }
    }

SiteCopy = "apps/site/home.maca"

ahead_count(rs: Result[]) -> int =>
    kernels().filter(k => !is_behind(rs, k)).length()

/** A blurb is one sentence in a cell, however many it is on its own page. */
one_line(s: str) -> str {
    cut = s.split(".")

    if cut.length() < 2 {
        return s
    }

    cut.get(0) ++ "."
}

fact_cell(f: Fact) -> str =>
    div(class=Cell,
        div(class=Eyebrow, escape_html(f.label))
        div(class="mt-3 font-medium", escape_html(f.value)))

code_panel(src: str, lang: str) -> str =>
    pre(class=CodePlate,
        code(class="font-mono language-" ++ lang, highlight(lang, src)))

/** Two lines, one per platform, the way a reader expects to find them. */
install_strip(c: Copy, up: str) -> str =>
    section(id="install", class="border-t border-zinc-200 dark:border-zinc-800",
        div(class=Frame ++ " py-10",
            div(class=lattice("grid-cols-1 md:grid-cols-2"),
                install_cell("macOS, Linux, WSL", PosixInstall)
                install_cell("Windows", WindowsInstall))))

install_cell(os: str, line: str) -> str =>
    div(class=Cell,
        div(class=Eyebrow, escape_html(os))
        div(class="mt-3 overflow-x-auto",
            code(class="font-mono text-[0.85rem] language-sh",
                 highlight("sh", line))))

SiteRoot = "https://pleahmacaka.github.io/macalang"

PosixInstall = "curl -fsSL " ++ SiteRoot ++ "/install | sh"

WindowsInstall = "powershell -c \"irm " ++ SiteRoot ++ "/install.ps1 | iex\""

/** The head of a numbered document: its ordinal, its title, and where its facts
 * come from.
 */
doc_head(c: Copy, up: str, k: Key) -> str =>
    section(class=Frame ++ " py-12 md:py-16 grid gap-8 md:grid-cols-12",
        div(class="md:col-span-8 min-w-0",
            div(class=Eyebrow, ordinal(k) ++ " / "
                               ++ escape_html(title_of(c, k)))
            h1(class="mt-4 m-0 " ++ DocTitle, escape_html(title_of(c, k)))
            p(class="mt-5 m-0 " ++ Lead, prose(blurb_of(c, k))))
        div(class="md:col-span-4 min-w-0"))

/** Every document ends by saying where it sits and what is next. */
doc_foot(c: Copy, up: str, k: Key) -> str =>
    section(class=Frame ++ " py-10 border-t border-zinc-200"
                  ++ " dark:border-zinc-800",
        a(class=NavLink, href=home_href(c, up), escape_html(c.back_home)))

section_head(title: str) -> str =>
    h2(class="mt-12 pt-6 border-t border-zinc-200 dark:border-zinc-800 m-0 "
             ++ Head2, escape_html(title))

/** 01: what the language is, at a size where the samples can be read. */
language_doc(c: Copy, up: str) -> str =>
    document(c, up, Language,
        doc_head(c, up, Language)
        section(class=Frame ++ " pb-14",
            div(class="grid gap-px bg-zinc-200 dark:bg-zinc-800 border"
                      ++ " border-zinc-200 dark:border-zinc-800 md:grid-cols-2",
                topics().map(t => feature_cell(feature_of(c, t), sample(t)))
                        .join("")))
        doc_foot(c, up, Language))

feature_cell(f: Feature, src: str) -> str =>
    article(class=Cell,
        h3(class="m-0 " ++ Head3, escape_html(f.title))
        p(class="mt-3 m-0 " ++ Body, prose(f.body))
        pre(class="mt-4 " ++ CodeLight,
            code(class="font-mono language-maca", highlight("maca", src))))

/** 02: the measured argument, with its provenance beside the title. */
bench_doc_page(c: Copy, up: str, rs: Result[]) -> str =>
    document(c, up, Benchmarks,
        doc_head(c, up, Benchmarks)
        section(class=Frame ++ " pb-10",
            div(class=lattice("grid-cols-1 sm:grid-cols-2 md:grid-cols-5"),
                provenance().map(v => prov_cell(prov_of(c, v, rs))).join("")))
        section(class=Frame ++ " pb-14",
            families().map(f => family_group(c, rs, f)).join("")
            bench_table(c, rs)
            p(class="mt-6 m-0 " ++ Muted, prose(c.bench_note)))
        doc_foot(c, up, Benchmarks))

/** 03: pass@1, and the reason the third column is not the headline. */
evals_doc(c: Copy, up: str) -> str =>
    document(c, up, Evals,
        doc_head(c, up, Evals)
        section(class=Frame ++ " pb-10",
            div(class=lattice("grid-cols-1 md:grid-cols-3"),
                scores().map(score_cell).join("")))
        section(class=Frame ++ " pb-14",
            p(class="m-0 " ++ Body, prose(c.eval_note))
            p(class="mt-4 m-0 " ++ Body, prose(c.eval_caveat)))
        doc_foot(c, up, Evals))

score_cell(s: Score) -> str =>
    div(class=Cell,
        div(class=Eyebrow, escape_html(s.condition))
        div(class="mt-3 " ++ Figure, "{s.percent}%")
        div(class="mt-1 " ++ Unit, "{s.passed} of {s.of}")
        div(class="mt-4",
            span(class="block h-2 bg-zinc-900 dark:bg-zinc-100",
                 style="width:{s.percent}%")))

/** 04: what a program may be compiled to. */
targets_doc(c: Copy, up: str) -> str =>
    document(c, up, Targets,
        doc_head(c, up, Targets)
        section(class=Frame ++ " pb-14",
            div(class=lattice("grid-cols-1 sm:grid-cols-2 md:grid-cols-4"),
                targets().map(target_cell).join("")))
        doc_foot(c, up, Targets))

target_cell(t: str) -> str =>
    div(class=Cell, div(class="font-mono text-[0.95rem]", escape_html(t)))

/** 05: the one command, and the release it fetches. */
install_doc(c: Copy, up: str) -> str =>
    document(c, up, Install,
        doc_head(c, up, Install)
        section(class=Frame ++ " pb-14",
            pre(class=CodePlate,
                code(class="font-mono language-sh",
                     highlight("sh", InstallSample)))
            p(class="mt-6 m-0 " ++ Body, prose(c.install_body)))
        doc_foot(c, up, Install))

/** 06: what this language does not do, at the same size as what it does. */
limits_doc(c: Copy, up: str) -> str =>
    document(c, up, Limits,
        doc_head(c, up, Limits)
        section(class=Frame ++ " pb-14",
            ul(class=lattice("grid-cols-1 md:grid-cols-3") ++ " list-none m-0"
                      ++ " p-0",
               caveats().map(v => li(class=Cell, prose(caveat_of(c, v))))
                        .join("")))
        doc_foot(c, up, Limits))

body_for(c: Copy, up: str, k: Key, rs: Result[]) -> str =>
    match k {
        Home       => directory_page(c, up, rs)
        Language   => language_doc(c, up)
        Benchmarks => bench_doc_page(c, up, rs)
        Evals      => evals_doc(c, up)
        Targets    => targets_doc(c, up)
        Install    => install_doc(c, up)
        Limits     => limits_doc(c, up)
    }

main(args: str[]) -> int {
    out = if args.length() > 0 { args.get(0) } else { "apps/tomo/site" }
    make_dir(out)

    rs = bench_runs()

    if rs.length() == 0 {
        fail "no benchmark results in {BenchData}: run `{ReproCommand}`"
    }

    root = write_page(join(out, "index.html"),
                      directory_page(copies().get(0), "", rs))
    written = root + write_langs(out, copies(), 0, rs)
    wanted = 1 + copies().length() * (keys().length() + 1)

    if written < wanted {
        err("site: wrote {written} of {wanted} files under {out}")
        1
    } else {
        info("site: {written} files under {out}")
        0
    }
}

write_langs(out: str, cs: Copy[], i: int, rs: Result[]) -> int {
    if i >= cs.length() {
        return 0
    }

    dir = join(out, cs.get(i).lang)
    make_dir(dir)

    home = write_page(join(dir, "home.html"),
                      directory_page(cs.get(i), "../", rs))
    n = home + write_docs(dir, cs.get(i), keys(), 0, rs)

    n + write_langs(out, cs, i + 1, rs)
}

write_docs(dir: str, c: Copy, ks: Key[], i: int, rs: Result[]) -> int {
    if i >= ks.length() {
        return 0
    }

    k = ks.get(i)
    n = write_page(join(dir, page_file(k) ++ ".html"), body_for(c, "../", k, rs))

    n + write_docs(dir, c, ks, i + 1, rs)
}

write_page(path: str, markup: str) -> int {
    write_file(path, markup)

    if file_size(path) == markup.length() {
        1
    } else {
        err("could not write {path}")
        0
    }
}

/** Backticks in copy become inline code, so one string per language stays one
 * string.
 */
prose(s: str) -> str {
    parts = s.split("`")

    if parts.length() % 2 == 0 {
        fail "unclosed backtick in copy: {s}"
    }

    spans(parts, 0, "")
}

spans(parts: str[], i: int, out: str) -> str {
    if i >= parts.length() {
        out
    } else if i % 2 == 1 {
        span = code(class=CodeSpan, escape_html(parts.get(i)))
        spans(parts, i + 1, out ++ span)
    } else {
        spans(parts, i + 1, out ++ escape_html(parts.get(i)))
    }
}
