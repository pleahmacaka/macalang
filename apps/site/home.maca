ko_fact(s: Spec) -> Fact =>
    match s {
        Types  => Fact { label = "타입", value = "정적, 추론" }
        Memory => Fact { label = "메모리", value = "컴파일 타임 참조 카운트" }
        Output => Fact { label = "결과물", value = "네이티브 바이너리" }
        Colour => Fact { label = "비동기", value = "함수 색칠 없음" }
    }

ko_feature(t: Topic) -> Feature =>
    match t {
        Config => Feature {
            title = "같은 언어가 기계를 설정합니다",
            body = "`--target nix`를 주면 같은 파일이 바이너리 대신 NixOS"
                ++ " 모듈로 컴파일됩니다. 같은 문법, 같은 검사기입니다. 그리고"
                ++ " 설정 모드에서는 I/O를 거부하므로 기계 기술서가 몰래 무언가를 할"
                ++ " 수 없습니다."
        }
        Async => Feature {
            title = "비동기에 색이 없습니다",
            body = "비동기성은 함수 타입의 성질이 아니라 추론되는 이펙트입니다."
                ++ " 어떤 함수도 자기를 부르는 모든 것에 번지는 색으로 물들지"
                ++ " 않고, 쓸 async 키워드도 없습니다."
        }
        Markup => Feature {
            title = "마크업이 문자열이 아니라 문법입니다",
            body = "태그를 함수처럼 부르면 그게 요소입니다. JS 타깃에서는"
                ++ " 반응형 DOM을, 네이티브에서는 HTML을 만들고, 실제로 쓴"
                ++ " 유틸리티만큼의 스타일시트가 생성됩니다. 이 페이지가 그"
                ++ " 기능입니다."
        }
        Values => Feature {
            title = "값은 값으로 남습니다",
            body = "수동 free 없음, 만족시켜야 할 빌림 검사기도 없음. 참조"
                ++ " 카운트는 컴파일러가 넣고, 버퍼가 죽는 지점도 컴파일러가"
                ++ " 알아냅니다. C FFI로 손을 뻗으면 그때부터는 C의 규칙입니다."
        }
    }

ko_caveat(c: Caveat) -> str =>
    match c {
        Ecosystem => "오늘 당장 큰 생태계가 필요할 때. Maca는 자기 생태계를"
            ++ " 키우는 대신 C, Python, crates.io, Maven에 닿습니다."
        Cycles => "추적 수집기가 필요할 때. 참조 카운팅은 순환을 수거하지"
            ++ " 않습니다."
        Young => "검증된 언어가 필요할 때. 이 언어는 어리고, 그렇다고 말합니다."
    }

