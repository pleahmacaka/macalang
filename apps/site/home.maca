import { join } from std/path
import { between } from std/text
import apps/site/shell
import apps/site/data
import { highlight, code_css } from apps/tomo/highlight

import { Result, median_ms } from bench/time
import { load, find } from bench/store
import { Tolerance } from bench/compare
import { kernels, langs, params, case_name } from apps/bench/run
import { recursion_kernels, compute_kernels } from apps/bench/run

InstallUrl = "https://github.com/pleahmacaka/macalang/releases/latest"
    ++ "/download/maca-install-linux-x86_64"

Topic  = Config | Async | Markup | Values
Spec   = Types | Memory | Output | Colour
Caveat = Ecosystem | Cycles | Young

Family     = Recursion | Compute
Standing   = Ahead | Level | Behind | Absent
Provenance = Host | Tools | Runs | Answers | Repro

topics() -> Topic[] => Config, Async, Markup, Values

specs() -> Spec[] => Types, Memory, Output, Colour

caveats() -> Caveat[] => Ecosystem, Cycles, Young

families() -> Family[] => Recursion, Compute

provenance() -> Provenance[] => Host, Tools, Runs, Answers, Repro

targets() -> str[] =>
    ["native", "js", "jvm", "rust", "nix", "embedded", "tauri"]

Fact = {
    label: str
    value: str
}

Feature = {
    title: str
    body:  str
}

Copy = {
    lang:      str
    endonym:   str
    locale:    str
    title:     str
    descr:     str
    nav_docs:  str
    nav_api:   str
    headline:  str
    sub:       str
    cta_start: str
    cta_play:  str
    box_title: str
    box_sub:   str
    tgt_title: str
    tgt_sub:   str
    install:   str
    install_more: str
    bench_title:  str
    bench_sub:    str
    bench_note:   str
    bench_readme: str
    bench_full:   str
    tbl_kernel:   str
    tbl_workload: str
    tbl_note:     str
    lim_title: str
    lim_sub:   str
    eval_title: str
    eval_sub:   str
    eval_note:  str
    eval_caveat: str
    docs_sub:   str
    api_sub:    str
    install_body: str
    prov_label: str
    back_home:  str
    play_unit:  str
    footer:    str
    skip:      str
    nav_label: str
    lang_label: str
}

copies() -> Copy[] => english(), korean()

sample(t: Topic) -> str =>
    match t {
        Config => ConfigSample
        Async  => AsyncSample
        Markup => MarkupSample
        Values => ValueSample
    }

HeroSample = """Shape = Circle(float) | Rect(float, float)

area(s: Shape) -> float =>
    match s {
        Circle(r)  => 3.14159 * r * r
        Rect(w, h) => w * h
    }

main() -> int {
    plan = [Circle(1.0), Rect(3.0, 4.0)]
    info("{plan.map(area).sum():.2} m2")
    0
}"""

ConfigSample = """networking.hostName = "rigel"
system.packages     = git, curl, htop

services.openssh = {
    passwordAuthentication = false
}"""

AsyncSample = """fetch_both(a: str, b: str) -> int {
    x = spawn get(a)
    y = spawn get(b)
    await x + await y
}"""

MarkupSample = """card(name: str) -> str =>
    article(class="rounded-lg p-4",
        h2(class="font-bold", name)
        p("Server or browser, one line.")
    )"""

ValueSample = """shift(p: Point, dx: int) -> Point =>
    p with { x = p.x + dx }"""

InstallSample = """curl -fsSL """ ++ InstallUrl ++ """ | bash
maca init hello && cd hello
maca run main.maca"""

english() -> Copy =>
    Copy {
        lang = "en",
        endonym = "English",
        locale = "en_US",
        title = "Maca: one typed language for programs and infrastructure",
        descr = "A statically typed, compiled language with no garbage"
            ++ " collector. The same source builds a native binary, a browser"
            ++ " UI, or the NixOS module for the machine it runs on.",
        nav_docs = "Handbook",
        nav_api = "API",
        headline = "One language for machines",
        sub = "Typed, compiled, no garbage collector. The language that writes"
            ++ " your service also describes the machine it runs on.",
        cta_start = "Get started",
        cta_play = "Playground",
        box_title = "The language",
        box_sub = "The decisions that put a language in a box, stated plainly.",
        tgt_title = "Targets",
        tgt_sub = "Native is the default. The rest are a flag.",
        install = "Install",
        install_more = "Full install instructions",
        bench_title = "Benchmarks",
        bench_sub = "Every kernel below is one algorithm written out in each"
            ++ " language, on one machine, with every column verified to have"
            ++ " computed the same answer. The bars are Maca against C, because"
            ++ " Maca compiles through C and C is therefore the ceiling. Lower"
            ++ " is better, and not every row reaches it.",
        bench_note = "Where it is behind: `sieve` is the real gap, and it is"
            ++ " not a code-generation deficit. Maca's only array type is a"
            ++ " 64-bit `int[]`, so a sieve to 10⁷ touches about 80 MB where"
            ++ " C's `char` array touches 10 MB; it is bound by memory"
            ++ " bandwidth, and a compact byte array would close it. `matmul`"
            ++ " trails by a margin a single timed run cannot separate from"
            ++ " noise. Everything else lands on C, because it is C, at"
            ++ " `-O2`.",
        bench_readme = "How the benchmark works",
        bench_full = "Every number, as tables",
        tbl_kernel = "kernel",
        tbl_workload = "workload",
        tbl_note = "Median time in milliseconds, lower is better, and in"
            ++ " brackets the multiple of C's time.",
        lim_title = "Limits",
        lim_sub = "What this language does not do.",
        eval_title = "Evaluations",
        eval_sub = "pass@1 over a mechanically ported HumanEval set, by what"
            ++ " the model was told.",
        eval_note = "Model: `claude-haiku-4-5`. Task: 25 HumanEval problems"
            ++ " ported to Maca. Graded by compiling the answer and running the"
            ++ " problem's own tests; pass@1 is one attempt per problem.",
        eval_caveat = "25 problems is a small set: one solved problem moves"
            ++ " the figure four points, so treat a single run as a sample.",
        docs_sub = "The handbook, from installing to the back ends.",
        api_sub = "Every documented item in the standard library.",
        install_body = "The line above fetches the build for your machine."
            ++ " Then `maca init` writes a project that already builds.",
        prov_label = "Source",
        back_home = "Back to the directory",
        footer = "Apache-2.0.",
        play_unit = "install required",
        skip = "Skip to content",
        nav_label = "Site",
        lang_label = "Language"
    }

en_fact(s: Spec) -> Fact =>
    match s {
        Types  => Fact { label = "Types", value = "Static, inferred" }
        Memory => Fact { label = "Memory",
                         value = "Refcounted at compile time" }
        Output => Fact { label = "Output", value = "A native binary" }
        Colour => Fact { label = "Async", value = "No function colour" }
    }

en_feature(t: Topic) -> Feature =>
    match t {
        Config => Feature {
            title = "The same language configures the machine",
            body = "Pass `--target nix` and the same file compiles to a NixOS"
                ++ " module instead of a binary. Same syntax, same checker,"
                ++ " and the checker refuses I/O in config mode, so a machine"
                ++ " description cannot quietly do something."
        }
        Async => Feature {
            title = "Async has no colour",
            body = "Async-ness is an inferred effect, not a property of a"
                ++ " function's type. No function is dyed a colour that spreads"
                ++ " to everything calling it, and there is no async keyword to"
                ++ " write."
        }
        Markup => Feature {
            title = "Markup is syntax, not a string",
            body = "A tag called as a function is an element. On the JS target"
                ++ " it builds a reactive DOM; on native it renders to HTML,"
                ++ " with a stylesheet generated for exactly the utilities you"
                ++ " used. This page is that feature."
        }
        Values => Feature {
            title = "Values stay values",
            body = "No manual free and no borrow checker to satisfy: the"
                ++ " compiler inserts the reference counts and works out where"
                ++ " a buffer dies. Reach through the C FFI and you are back to"
                ++ " C's rules, as you would expect."
        }
    }

en_caveat(c: Caveat) -> str =>
    match c {
        Ecosystem => "You want a large ecosystem today. Maca reaches C,"
            ++ " Python, crates.io and Maven rather than having grown its own."
        Cycles => "You want a tracing collector. Reference counting does not"
            ++ " collect a cycle."
        Young => "You want a proven language. This one is young, and says so."
    }

en_family(f: Family) -> Feature =>
    match f {
        Recursion => Feature {
            title = "Recursion-bound",
            body = "Tree and nested recursion, where the cost of a function"
                ++ " call is the cost of the program."
        }
        Compute => Feature {
            title = "Compute-bound",
            body = "Tight loops over arrays and floating point, where the"
                ++ " inner loop is the cost of the program."
        }
    }

en_standing(s: Standing) -> str =>
    match s {
        Ahead  => "faster than C"
        Level  => "level with C"
        Behind => "slower than C"
        Absent => "not measured here"
    }

en_prov(p: Provenance, rs: Result[]) -> Fact =>
    match p {
        Host => Fact { label = "Measured on", value = bench_host() }
        Tools => Fact { label = "Toolchains", value = Toolchains }
        Runs => Fact { label = "Timed runs",
                       value = "{timed_runs(rs)} per language, median of the"
                           ++ " samples, wall clock with process start in it" }
        Answers => Fact { label = "Verified", value = en_answers(rs) }
        Repro => Fact { label = "Reproduce",
                        value = "`" ++ ReproCommand ++ "`" }
    }

en_answers(rs: Result[]) -> str {
    if all_verified(rs) {
        "every language printed the same checksum"
    } else {
        "checksums disagree on {disagreeing(rs)}"
    }
}

