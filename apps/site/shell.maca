import { escape_html } from std/text

/// The project's source, named once.
Repo = "https://github.com/pleahmacaka/macalang"

/// Told to the browser rather than to any element.
base_css() -> str =>
    """html{color-scheme:light dark}
"""

/// `<title>`, escaped.
title_tag(text: str) -> str =>
    title(escape_html(text))

body_tag(classes: str, inner: str) -> str =>
    body(class=classes, inner)

/// The two families the site uses, which `font-sans` and `font-mono` name and which nothing else supplies.
font_link(up: str) -> str =>
    link(rel="stylesheet", href=up ++ "fonts/fonts.css")

/// The body's typography and colours, over a chosen font stack.
page_class(font: str) -> str =>
    font ++ " text-base leading-relaxed break-keep bg-white dark:bg-zinc-950"
        ++ " text-zinc-900 dark:text-zinc-100"

/// An inline `<code>` span in running prose.
CodeSpan = "font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 rounded px-1"
    ++ " py-[0.05rem]"
