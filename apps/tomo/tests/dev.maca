import { Dev, Parts, parts_of, page_key, region_key, chapter_page,
         published } from apps/tomo/tomo
import { Store, store, set, clear_changed } from signal/store
import { patch, patch_json, apply_patch } from signal/dom
import { dev_head } from http/dev

Chs = ["01-alpha", "02-beta"]

Title = "Handbook"

Langs = "en,ko"

developing() -> Dev => Dev { on = true, extra = dev_head() }

titles_for(first: str) -> str[] => [first, "Beta"]

built_in(lang: str, d: Dev, md: str, first: str) -> str =>
    chapter_page(d, Title, Langs, lang, Chs, titles_for(first), 0,
                 parts_of(Chs, titles_for(first), 0, md))

built(d: Dev, md: str, first: str) -> str => built_in("en", d, md, first)

rebuilt_in(lang: str, s: Store, md: str, first: str) -> Store {
    key = page_key(lang, Chs.get(0))
    p = parts_of(Chs, titles_for(first), 0, md)

    s.set(region_key("article", key), p.article)
        .set(region_key("toc", key), p.toc)
        .set(region_key("nav", key), p.nav)
}

rebuilt(s: Store, md: str, first: str) -> Store =>
    rebuilt_in("en", s, md, first)

test_a_prose_edit_patches_to_the_same_page_as_a_rebuild() {
    v1 = "# Alpha\n\nfirst\n"
    v2 = "# Alpha\n\nfirst\n\nsecond\n"
    s = rebuilt(store(), v1, "Alpha").clear_changed()
    s = rebuilt(s, v2, "Alpha")
    ops = patch(s)

    assert_eq(str(ops.length()), "1", "only the prose moved")
    assert_eq(apply_patch(built(developing(), v1, "Alpha"), ops),
              built(developing(), v2, "Alpha"),
              "the patched page is the rebuilt page")
}

test_a_heading_edit_patches_the_two_navigation_regions_as_well() {
    v1 = "# Alpha\n\nprose\n"
    v2 = "# Omega\n\nprose\n"
    s = rebuilt(store(), v1, "Alpha").clear_changed()
    s = rebuilt(s, v2, "Omega")
    ops = patch(s)

    assert_eq(str(ops.length()), "3", "prose, heading list and chapter list")
    assert_eq(apply_patch(built(developing(), v1, "Alpha"), ops),
              built(developing(), v2, "Omega"),
              "and all three landed where the rebuild put them")
}

test_a_new_heading_reaches_the_heading_list() {
    v1 = "# Alpha\n\nprose\n"
    v2 = "# Alpha\n\nprose\n\n## Later\n\nmore\n"
    s = rebuilt(store(), v1, "Alpha").clear_changed()
    s = rebuilt(s, v2, "Alpha")
    ops = patch(s)

    assert_eq(str(ops.length()), "2", "the prose and the heading list")
    assert_eq(apply_patch(built(developing(), v1, "Alpha"), ops),
              built(developing(), v2, "Alpha"), "both patched to the rebuild")
    assert(patch_json(s).contains("#later"), "with an anchor for the new one")
}

test_removing_a_heading_patches_to_the_same_page_as_a_rebuild() {
    v1 = "# Alpha\n\nprose\n\n## Later\n\nmore\n"
    v2 = "# Alpha\n\nprose\n"
    s = rebuilt(store(), v1, "Alpha").clear_changed()
    s = rebuilt(s, v2, "Alpha")
    ops = patch(s)

    assert_eq(str(ops.length()), "2", "the prose and the heading list")
    assert_eq(apply_patch(built(developing(), v1, "Alpha"), ops),
              built(developing(), v2, "Alpha"), "shrunk to what was rebuilt")
    assert(!patch_json(s).contains("#later"), "and the anchor is gone")
}

test_a_chapter_emptied_of_prose_patches_to_the_rebuild() {
    v1 = "# Alpha\n\nprose\n"
    v2 = "# Alpha\n"
    s = rebuilt(store(), v1, "Alpha").clear_changed()
    s = rebuilt(s, v2, "Alpha")

    assert_eq(apply_patch(built(developing(), v1, "Alpha"), patch(s)),
              built(developing(), v2, "Alpha"), "emptied to the rebuild")
}

test_two_saves_in_a_row_land_on_the_third_rebuild() {
    v1 = "# Alpha\n\none\n"
    v2 = "# Alpha\n\ntwo\n\n## Mid\n\nx\n"
    v3 = "# Omega\n\nthree\n"
    s = rebuilt(store(), v1, "Alpha").clear_changed()
    s = rebuilt(s, v2, "Alpha")
    once = apply_patch(built(developing(), v1, "Alpha"), patch(s))
    s = rebuilt(s.clear_changed(), v3, "Omega")

    assert_eq(once, built(developing(), v2, "Alpha"), "the first save landed")
    assert_eq(apply_patch(once, patch(s)), built(developing(), v3, "Omega"),
              "and the second landed on top of it")
}

test_a_save_that_changed_nothing_produces_no_ops() {
    md = "# Alpha\n\nprose\n"
    s = rebuilt(store(), md, "Alpha").clear_changed()
    s = rebuilt(s, md, "Alpha")

    assert_eq(str(patch(s).length()), "0", "nothing changed, nothing sent")
    assert_eq(apply_patch(built(developing(), md, "Alpha"), patch(s)),
              built(developing(), md, "Alpha"), "and the page is untouched")
}

test_a_save_in_one_language_leaves_the_other_languages_page_alone() {
    v1 = "# 알파\n\n하나\n"
    v2 = "# 알파\n\n둘\n"
    s = rebuilt_in("ko", store(), v1, "알파").clear_changed()
    s = rebuilt_in("ko", s, v2, "알파")
    ops = patch(s)

    assert_eq(apply_patch(built_in("ko", developing(), v1, "알파"), ops),
              built_in("ko", developing(), v2, "알파"),
              "the Korean page patched to the Korean rebuild")
    assert_eq(apply_patch(built_in("en", developing(), v1, "알파"), ops),
              built_in("en", developing(), v1, "알파"),
              "and the English page, which no op names, was not touched")
}

test_a_save_cannot_reset_the_search_box_or_shut_the_sidebar() {
    v1 = "# Alpha\n\nprose\n"
    v2 = "# Omega\n\nprose\n"
    s = rebuilt(store(), v1, "Alpha").clear_changed()
    s = rebuilt(s, v2, "Omega")
    ops = patch_json(s)
    page = built(developing(), v1, "Alpha")

    assert(page.contains("id=\"q\""), "the page has a search box")
    assert(!ops.contains("id=\\\"q\\\""), "and no op replaces it")
    assert(page.contains("data-tomo=\"nav\""), "and a disclosure")
    assert(!ops.contains("data-tomo=\\\"nav\\\""),
           "whose open state is the reader's, not the builder's")
}

test_the_published_page_carries_none_of_the_dev_machinery() {
    md = "# Alpha\n\nprose\n"
    out = built(published(), md, "Alpha")

    assert(!out.contains("data-signal"), "no region markers")
    assert(!out.contains("macaDevPath"), "no poller")
    assert(!out.contains("macaSignal"), "and no patcher")
}

test_dev_mode_adds_only_markers_and_a_script() {
    md = "# Alpha\n\nprose\n"
    stripped = built(developing(), md, "Alpha")
        .replace(dev_head(), "")
        .replace(mark("article"), "")
        .replace(mark("toc"), "")
        .replace(mark("nav"), "")

    assert_eq(stripped, built(published(), md, "Alpha"),
              "the published page, plus markers and one script")
}

mark(part: str) -> str =>
    " data-signal=\"" ++ region_key(part, page_key("en", Chs.get(0)))
        ++ "\" data-signal-as=\"html\""
