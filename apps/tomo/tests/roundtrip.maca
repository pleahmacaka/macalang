import { highlight } from apps/tomo/highlight
import { find } from std/fs

text_of(html: str) -> str {
    parts = html.split("<")
    out = parts.get(0)
    i = 1
    while i < parts.length() {
        p = parts.get(i)
        at = p.index_of(">")
        out = out ++ (at < 0 ? p : p.substr(at + 1, p.length() - at - 1))
        i = i + 1
    }
    unescape(out)
}

unescape(s: str) -> str =>
    s.replace("&quot;", "\"")
        .replace("&gt;", ">")
        .replace("&lt;", "<")
        .replace("&amp;", "&")

first_diff(a: str, b: str) -> int {
    n = a.length() < b.length() ? a.length() : b.length()
    i = 0
    while i < n {
        if a.substr(i, 1) != b.substr(i, 1) {
            break
        }
        i = i + 1
    }
    i
}

corpus() -> str[] {
    from_root = find("apps", ".maca")
    from_root.length() > 0 ? from_root : find(".", ".maca")
}

test_highlighting_maca_preserves_every_character() {
    files = corpus()
    assert(files.length() > 5, "the corpus is missing: {files.length()} files")

    i = 0
    while i < files.length() {
        path = files.get(i)
        src = read_file(path)
        back = text_of(highlight("maca", src))
        at = first_diff(back, src)
        assert_eq(back.substr(at, 60), src.substr(at, 60),
                  "{path} differs at byte {at}")
        assert_eq(back.length(), src.length(), "{path} changed length")
        i = i + 1
    }
}
