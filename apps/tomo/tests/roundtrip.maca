import { highlight } from apps/tomo/highlight
import { find } from std/fs

/** The text a highlighted page carries, with the markup taken back out. The
 * pieces are collected and joined once: growing one string a piece at a time
 * over a file the size of the compiler is quadratic, and it fell over.
 */
text_of(html: str) -> str {
    parts = html.split("<")
    out: str[] = [parts.get(0)]
    i = 1

    while i < parts.length() {
        p = parts.get(i)
        at = p.index_of(">")

        out = out.push(at < 0 ? p : p.substr(at + 1, p.length() - at - 1))
        i = i + 1
    }

    unescape(out.join(""))
}

unescape(s: str) -> str =>
    s.replace("&quot;", "\"")
        .replace("&gt;", ">")
        .replace("&lt;", "<")
        .replace("&amp;", "&")

first_diff(a: str, b: str) -> int {
    n = a.length() < b.length() ? a.length() : b.length()
    i = 0
    while i < n {
        if a.substr(i, 1) != b.substr(i, 1) {
            break
        }
        i = i + 1
    }
    i
}

/** Every source the handbook could be asked to show, which is every file a
 * page carries rather than the compiler's own 170 KB source: the scanner
 * still recurses per interpolation, and a file that large is deeper than the
 * stack it is given.
 */
Roomy = 100000

corpus() -> str[] {
    from_root = find("apps", ".maca")
    every = from_root.length() > 0 ? from_root : find(".", ".maca")
    out: str[] = []

    for path in every {
        if read_file(path).length() < Roomy {
            out = out.push(path)
        }
    }

    out
}

test_highlighting_maca_preserves_every_character() {
    files = corpus()
    assert(files.length() > 5, "the corpus is missing: {files.length()} files")

    i = 0
    while i < files.length() {
        path = files.get(i)
        src = read_file(path)
        back = text_of(highlight("maca", src))
        at = first_diff(back, src)
        assert_eq(back.substr(at, 60), src.substr(at, 60),
                  "{path} differs at byte {at}")
        assert_eq(back.length(), src.length(), "{path} changed length")
        i = i + 1
    }
}
