import { conf_value } from apps/tomo/conf
import { highlight, code_css } from apps/tomo/highlight
import { escape_html, index_of_from, lines } from std/text
import { read_lines } from std/fs
import { object_of, quote } from std/json

slug(text: str) -> str =>
    slug_chars(text.lower().chars(), 0, "")

slug_chars(cs: str[], i: int, acc: str) -> str {
    if i >= cs.length() {
        acc
    } else {
        slug_chars(cs, i + 1, acc ++ slug_char(cs.get(i)))
    }
}

slug_char(c: str) -> str {
    if c == " " || c == "\t" || c == "_" {
        "-"
    } else if is_drop(c) {
        ""
    } else {
        c
    }
}

is_drop(c: str) -> bool =>
    ".,?!:;`\"'()[]\{\}/\\*&<>=+|#@$%^~".contains(c)

md_class(kind: str) -> str {
    if kind == "h1" {
        "font-sans text-[2rem] leading-tight mt-2 mb-3 font-bold"
    } else if kind == "h2" {
        "font-sans text-[1.4rem] leading-tight mt-9 mb-3 font-bold"
    } else if kind == "h3" {
        "font-sans text-[1.15rem] leading-tight mt-8 mb-3 font-bold"
    } else if kind == "p" {
        "my-4"
    } else if kind == "pre" {
        "bg-zinc-100 dark:bg-zinc-800 p-4 rounded-md overflow-x-auto my-4"
    } else if kind == "quote" {
        "border-l-2 border-zinc-300 dark:border-zinc-600 pl-4 my-4"
            ++ " text-zinc-600 dark:text-zinc-400"
    } else if kind == "table" {
        "block overflow-x-auto border-collapse w-full my-5 text-[0.94rem]"
    } else if kind == "th" {
        cell_class() ++ " font-sans text-[0.88rem]"
            ++ " bg-zinc-100 dark:bg-zinc-800"
    } else if kind == "td" {
        cell_class()
    } else if kind == "list" {
        "my-4 pl-6"
    } else {
        "my-1"
    }
}

cell_class() -> str =>
    "border border-zinc-200 dark:border-zinc-700 px-3 py-2 text-left align-top"

heading(level: str, text: str) -> str =>
    element("h" ++ level,
            id=slug(text),
            class=md_class("h" ++ level),
            inline(escape_html(text))) ++ "\n"

inline(s: str) -> str =>
    link(bold(code_spans(s)))

link(s: str) -> str {
    open = s.index_of("[")

    if open < 0 {
        s
    } else {
        link_at(s, open)
    }
}

link_at(s: str, open: int) -> str {
    close = index_of_from(s, "](", open)
    urlend = if close < 0 { -1 } else { index_of_from(s, ")", close + 2) }
    next = index_of_from(s, "[", open + 1)
    malformed = urlend < 0 || (next >= 0 && next < close)

    if malformed {
        s.substr(0, open + 1)
            ++ link(s.substr(open + 1, s.length() - open - 1))
    } else {
        s.substr(0, open)
            ++ a(class="text-inherit underline underline-offset-2"
                       ++ " decoration-zinc-400",
                 href=href(s.substr(close + 2, urlend - close - 2)),
                 s.substr(open + 1, close - open - 1))
            ++ link(s.substr(urlend + 1, s.length() - urlend - 1))
    }
}

href(url: str) -> str {
    if url.ends_with(".md") && !url.contains("://") {
        url.substr(0, url.length() - 3) ++ ".html"
    } else {
        url
    }
}

code_spans(s: str) -> str {
    open = s.index_of("`")
    close = if open < 0 { -1 } else { index_of_from(s, "`", open + 1) }

    if close < 0 {
        s
    } else {
        s.substr(0, open)
            ++ code(class="bg-zinc-100 dark:bg-zinc-800 px-1 rounded-sm"
                          ++ " font-mono text-[0.88em]",
                    s.substr(open + 1, close - open - 1))
            ++ code_spans(s.substr(close + 1, s.length() - close - 1))
    }
}

bold(s: str) -> str {
    open = s.index_of("**")
    close = if open < 0 { -1 } else { index_of_from(s, "**", open + 2) }

    if close < 0 {
        s
    } else {
        s.substr(0, open)
            ++ strong(s.substr(open + 2, close - open - 2))
            ++ bold(s.substr(close + 2, s.length() - close - 2))
    }
}

render(md: str) -> str =>
    render_lines(lines(md), 0, "")

render_lines(lines: str[], i: int, acc: str) -> str {
    if i >= lines.length() {
        acc
    } else {
        render_line(lines, i, acc)
    }
}

render_line(lines: str[], i: int, acc: str) -> str {
    line = lines.get(i)

    if line.starts_with("```") {
        render_fence(lines, i, acc, line)
    } else {
        render_block(lines, i, acc, line)
    }
}

render_fence(lines: str[], i: int, acc: str, fence: str) -> str {
    stop = fence_end(lines, i + 1)
    lang = fence.substr(3, fence.length() - 3).trim()
    html = pre(class=md_class("pre"),
               code(class=pre_code_class() ++ lang_class(lang),
                    highlight(lang, fence_body(lines, i + 1, stop))))
    render_lines(lines, stop + 1, acc ++ html ++ "\n")
}

fence_end(lines: str[], i: int) -> int {
    if i >= lines.length() || lines.get(i).starts_with("```") {
        i
    } else {
        fence_end(lines, i + 1)
    }
}

fence_body(lines: str[], at: int, stop: int) -> str {
    if at >= stop {
        ""
    } else {
        lines.get(at) ++ "\n" ++ fence_body(lines, at + 1, stop)
    }
}

lang_class(lang: str) -> str {
    if lang.length() == 0 {
        ""
    } else {
        " language-" ++ slug(lang)
    }
}

render_block(lines: str[], i: int, acc: str, line: str) -> str {
    if head_level(line) > 0 {
        render_lines(lines, i + 1, acc ++ head_html(line))
    } else if is_table(line) {
        render_table(lines, i, acc)
    } else if is_item(line) {
        render_list(lines, i, acc)
    } else if line.starts_with("> ") {
        render_quote(lines, i, acc)
    } else if line.trim() == "" {
        render_lines(lines, i + 1, acc)
    } else {
        render_para(lines, i, acc)
    }
}

head_level(line: str) -> int {
    if line.starts_with("### ") {
        3
    } else if line.starts_with("## ") {
        2
    } else if line.starts_with("# ") {
        1
    } else {
        0
    }
}

head_html(line: str) -> str {
    n = head_level(line)
    heading(str(n), line.substr(n + 1, line.length() - n - 1))
}

is_bullet(line: str) -> bool =>
    line.starts_with("- ") || line.starts_with("  - ")

is_numbered(line: str) -> bool {
    t = line.trim()
    d = digits_at(t.chars(), 0)
    d > 0 && t.substr(d, 2) == ". "
}

digits_at(cs: str[], i: int) -> int {
    if i >= cs.length() || !cs.get(i).is_ascii_digit() {
        i
    } else {
        digits_at(cs, i + 1)
    }
}

is_item(line: str) -> bool =>
    is_bullet(line) || is_numbered(line)

render_list(lines: str[], i: int, acc: str) -> str {
    stop = list_end(lines, i)
    tag = if is_numbered(lines.get(i)) { "ol" } else { "ul" }
    html = element(tag, class=md_class("list"),
                   "\n" ++ list_items(lines, i, stop)) ++ "\n"
    render_lines(lines, stop, acc ++ html)
}

list_end(lines: str[], i: int) -> int {
    if i >= lines.length() || !is_item(lines.get(i)) {
        i
    } else {
        list_end(lines, i + 1)
    }
}

list_items(lines: str[], at: int, stop: int) -> str {
    if at >= stop {
        ""
    } else {
        one_item(lines.get(at)) ++ list_items(lines, at + 1, stop)
    }
}

one_item(line: str) -> str {
    nested = line.starts_with("  - ")
    text = inline(escape_html(item_text(line, nested)))

    if nested {
        ul(li(text)) ++ "\n"
    } else {
        li(class=md_class("li"), text) ++ "\n"
    }
}

item_text(line: str, nested: bool) -> str {
    t = line.trim()

    if nested {
        line.substr(4, line.length() - 4)
    } else if is_numbered(line) {
        t.substr(digits_at(t.chars(), 0) + 2, t.length())
    } else {
        t.substr(2, t.length() - 2)
    }
}

is_table(line: str) -> bool =>
    line.trim().starts_with("|")

is_rule_row(line: str) -> bool {
    body = line.trim().replace("|", "").replace("-", "").replace(":", "").trim()

    line.trim().starts_with("|") && line.contains("-") && body == ""
}

render_table(lines: str[], i: int, acc: str) -> str {
    stop = table_end(lines, i)
    head = thead("\n" ++ row(lines.get(i), "th")) ++ "\n"
    ruled = i + 1 < stop && is_rule_row(lines.get(i + 1))
    body_at = if ruled { i + 2 } else { i + 1 }
    body = tbody("\n" ++ rows(lines, body_at, stop)) ++ "\n"
    html = table(class=md_class("table"), "\n" ++ head ++ body) ++ "\n"
    render_lines(lines, stop, acc ++ html)
}

table_end(lines: str[], i: int) -> int {
    if i >= lines.length() || !is_table(lines.get(i)) {
        i
    } else {
        table_end(lines, i + 1)
    }
}

rows(lines: str[], at: int, stop: int) -> str {
    if at >= stop {
        ""
    } else {
        row(lines.get(at), "td") ++ rows(lines, at + 1, stop)
    }
}

row(line: str, tag: str) -> str =>
    tr(cells(split_cells(line.trim()), 1, tag)) ++ "\n"

split_cells(s: str) -> str[] =>
    cell_walk(s.chars(), 0, "", [])

cell_walk(cs: str[], i: int, cur: str, acc: str[]) -> str[] {
    if i >= cs.length() {
        acc ++ [cur]
    } else if is_escaped_pipe(cs, i) {
        cell_walk(cs, i + 2, cur ++ "|", acc)
    } else if cs.get(i) == "|" {
        cell_walk(cs, i + 1, "", acc ++ [cur])
    } else {
        cell_walk(cs, i + 1, cur ++ cs.get(i), acc)
    }
}

is_escaped_pipe(cs: str[], i: int) -> bool =>
    cs.get(i) == "\\" && i + 1 < cs.length() && cs.get(i + 1) == "|"

cells(parts: str[], i: int, tag: str) -> str {
    if i >= parts.length() - 1 {
        ""
    } else {
        cell = element(tag, class=md_class(tag),
                       inline(escape_html(parts.get(i).trim())))
        cell ++ cells(parts, i + 1, tag)
    }
}

render_quote(lines: str[], i: int, acc: str) -> str {
    stop = quote_end(lines, i)
    text = join_quote(lines, i, stop)
    quoted = blockquote(class=md_class("quote"), inline(escape_html(text)))
    render_lines(lines, stop, acc ++ quoted ++ "\n")
}

quote_end(lines: str[], i: int) -> int {
    if i >= lines.length() || !lines.get(i).starts_with("> ") {
        i
    } else {
        quote_end(lines, i + 1)
    }
}

join_quote(lines: str[], at: int, stop: int) -> str {
    if at >= stop {
        ""
    } else {
        text = strip_quote_marker(lines.get(at))
        if at == stop - 1 {
            text
        } else {
            text ++ " " ++ join_quote(lines, at + 1, stop)
        }
    }
}

strip_quote_marker(line: str) -> str =>
    line.substr(2, line.length() - 2).trim()

render_para(lines: str[], i: int, acc: str) -> str {
    stop = para_end(lines, i)
    text = join_range(lines, i, stop)
    render_lines(lines, stop,
                 acc ++ p(class=md_class("p"), inline(escape_html(text))) ++ "\n")
}

para_end(lines: str[], i: int) -> int {
    if i >= lines.length() || is_break(lines.get(i)) {
        i
    } else {
        para_end(lines, i + 1)
    }
}

is_break(line: str) -> bool =>
    line.trim() == "" || line.starts_with("#") || is_item(line) ||
        line.starts_with("> ") || line.starts_with("```") || is_table(line)

join_range(lines: str[], at: int, stop: int) -> str {
    if at >= stop {
        ""
    } else if at == stop - 1 {
        lines.get(at).trim()
    } else {
        lines.get(at).trim() ++ " " ++ join_range(lines, at + 1, stop)
    }
}

toc(md: str) -> str => toc_region(published(), "", toc_list(md))

toc_list(md: str) -> str =>
    "\n" ++ ul(class="list-none m-0 p-0",
               "\n" ++ toc_lines(lines(md), 0)) ++ "\n"

toc_class() -> str =>
    "border-t border-zinc-200 dark:border-zinc-700 mt-3 pt-2"

toc_lines(lines: str[], i: int) -> str {
    if i >= lines.length() {
        ""
    } else {
        toc_line(lines.get(i)) ++ toc_lines(lines, i + 1)
    }
}

toc_line(line: str) -> str {
    n = head_level(line)

    if n == 0 {
        ""
    } else {
        toc_entry(line.substr(n + 1, line.length() - n - 1))
    }
}

toc_entry(text: str) -> str =>
    li(class="my-0",
       a(class=link_class(false) ++ " pl-4 text-[0.82rem]",
         href="#" ++ slug(text), escape_html(text))) ++ "\n"

/// What dev mode adds to a page.
Dev = {
    /// Do the three regions carry `data-signal` markers for the patcher?
    on: bool,
    /// Extra `<head>` markup: the patcher, and the poll loop that feeds it.
    extra: str,
}

/// Dev mode off, which is how the book is published.
published() -> Dev => Dev { on = false, extra = "" }

/// The parts of a chapter page that its Markdown decides.
Parts = {
    /// The rendered prose, as the `<article>`'s children.
    article: str,
    /// The page's heading list, as the table-of-contents `<nav>`'s children.
    toc: str,
    /// The book's chapter list with this page marked, as the sidebar `<ol>`'s children.
    nav: str,
}

/// The three parts, rendered.
parts_of(chs: str[], titles: str[], ci: int, md: str) -> Parts =>
    Parts {
        article = "\n" ++ render(md),
        toc = toc_list(md),
        nav = side_items(chs, titles, chs.get(ci), 0),
    }

/// Which page a region belongs to: `"en/05-strings"`.
page_key(lang: str, ch: str) -> str => lang ++ "/" ++ ch

/// One region's store key: `"article:en/05-strings"`.
region_key(part: str, key: str) -> str => part ++ ":" ++ key

article_region(d: Dev, key: str, inner: str) -> str {
    if d.on {
        article(data-signal=region_key("article", key),
                data-signal-as="html", inner)
    } else {
        article(inner)
    }
}

toc_region(d: Dev, key: str, inner: str) -> str {
    if d.on {
        nav(data-tomo="toc", class=toc_class(),
            data-signal=region_key("toc", key), data-signal-as="html",
            inner) ++ "\n"
    } else {
        nav(data-tomo="toc", class=toc_class(), inner) ++ "\n"
    }
}

nav_region(d: Dev, key: str, inner: str) -> str {
    if d.on {
        ol(class=side_list_class(), data-signal=region_key("nav", key),
           data-signal-as="html", inner)
    } else {
        ol(class=side_list_class(), inner)
    }
}

side_list_class() -> str => "list-none mt-2 p-0"

base_css() -> str =>
    """html{color-scheme:light dark}
"""

font_link(up: str) -> str =>
    element("link", rel="stylesheet", href=up ++ "fonts/pretendard.css")
        ++ "\n"

stylesheet() -> str =>
    style(base_css() ++ code_css() ++ styles()) ++ "\n"

chapter_nav(chs: str[], idx: int) -> str {
    p = prev_page(chs, idx)
    n = next_page(chs, idx)
    nav(aria-label="Chapter", class=chapter_nav_class(),
        page_link(chs, p, "← previous", false)
        page_link(chs, n, "next →", true)
    ) ++ "\n"
}

page_link(chs: str[], at: int, label: str, right: bool) -> str {
    if at < 0 {
        span("")
    } else {
        a(class=chapter_link_class(right), href=chs.get(at) ++ ".html", label)
    }
}

chapter_nav_class() -> str =>
    "grid grid-cols-2 gap-4 mt-12 pt-6 border-t border-zinc-200"
        ++ " dark:border-zinc-800 text-[0.9rem]"

chapter_link_class(right: bool) -> str =>
    "no-underline text-zinc-600 dark:text-zinc-400 hover:text-black"
        ++ " dark:hover:text-white" ++ chapter_link_side(right)

chapter_link_side(right: bool) -> str {
    if right {
        " text-right"
    } else {
        ""
    }
}

link_class(current: bool) -> str =>
    "block px-2 py-1 rounded no-underline" ++ link_state_class(current)

link_state_class(current: bool) -> str {
    if current {
        " bg-zinc-100 dark:bg-zinc-800 text-black dark:text-white"
            ++ " font-semibold"
    } else {
        " text-zinc-500 hover:bg-zinc-100 dark:hover:bg-zinc-800"
            ++ " hover:text-black dark:hover:text-white"
    }
}

sec_class() -> str =>
    "mt-4 mb-1 px-2 text-[0.78rem] uppercase tracking-wide font-semibold"
        ++ " first:mt-1"

book_class() -> str =>
    "mt-8 mb-1 px-2 pb-1 text-[0.95rem] font-bold text-black dark:text-white"
        ++ " border-b border-zinc-200 dark:border-zinc-700 first:mt-1"

lang_summary_class() -> str =>
    "cursor-pointer px-2 py-1 border border-zinc-200 dark:border-zinc-700"
        ++ " rounded text-zinc-500 whitespace-nowrap list-none"
        ++ " details-marker:hidden"

lang_menu_class() -> str =>
    "absolute right-0 z-10 mt-1 p-1 list-none bg-white dark:bg-zinc-900"
        ++ " border border-zinc-200 dark:border-zinc-700 rounded-md shadow-lg"

wrap_class() -> str =>
    "grid grid-cols-[16rem_minmax(0,44rem)] gap-12 justify-center"
        ++ " p-8 pb-20 max-md:block max-md:max-w-[44rem] max-md:mx-auto"
        ++ " max-md:p-5"

solo_class() -> str =>
    "block max-w-[44rem] mx-auto p-8 pb-20"

side_class() -> str =>
    "font-sans text-[0.85rem] sticky top-8 self-start max-h-screen"
        ++ " overflow-y-auto overscroll-contain max-md:static max-md:max-h-none"
        ++ " max-md:mb-6 max-md:border-b max-md:border-zinc-200"

sh_class() -> str =>
    "flex items-baseline justify-between gap-3 pb-2 border-b"
        ++ " border-zinc-200 dark:border-zinc-700 sticky top-0 bg-white"
        ++ " dark:bg-zinc-900 z-10"

is_section(entry: str) -> bool =>
    entry.starts_with("#")

is_book(entry: str) -> bool =>
    entry.starts_with("##")

marker_len(entry: str) -> int {
    if is_book(entry) {
        2
    } else {
        1
    }
}

section_title(entry: str, langs: str, lang: str) -> str {
    n = marker_len(entry)
    parts = entry.substr(n, entry.length() - n).split("|").map(v => v.trim())
    at = index_in(langs.split(","), lang, 0)

    if at >= 0 && at < parts.length() {
        parts.get(at)
    } else {
        parts.get(0)
    }
}

volume_titles(chs: str[], titles: str[], i: int, cur: str) -> str[] {
    if i >= chs.length() {
        []
    } else {
        here = if is_book(chs.get(i)) { titles.get(i) } else { cur }
        [here] ++ volume_titles(chs, titles, i + 1, here)
    }
}

index_in(xs: str[], want: str, i: int) -> int {
    if i >= xs.length() {
        -1
    } else if xs.get(i) == want {
        i
    } else {
        index_in(xs, want, i + 1)
    }
}

prev_page(chs: str[], i: int) -> int {
    if i <= 0 {
        -1
    } else if is_section(chs.get(i - 1)) {
        prev_page(chs, i - 1)
    } else {
        i - 1
    }
}

next_page(chs: str[], i: int) -> int {
    if i + 1 >= chs.length() {
        -1
    } else if is_section(chs.get(i + 1)) {
        next_page(chs, i + 1)
    } else {
        i + 1
    }
}

sidebar(d: Dev, key: str, title: str, langs: str, cur_lang: str, chs: str[],
        titles: str[], cur: str, nav_html: str, toc_html: str) -> str =>
    div(data-tomo="side", class=side_class(),
        div(data-tomo="head", class=sh_class(),
            a(class="font-semibold text-[0.95rem] no-underline text-inherit",
              href="index.html", escape_html(title))
            nav(data-tomo="i18n", class="relative shrink-0 text-[0.8rem]",
                lang_links(langs.split(","), 0, cur_lang, "../", cur)))
        details(data-tomo="nav", open=true,
                summary(class="hidden max-md:block cursor-pointer py-2"
                              ++ " list-none details-marker:hidden"
                              ++ " text-zinc-500",
                        "☰ " ++ nav_label(cur_lang))
                search_box()
                nav_region(d, key, nav_html)
                toc_html)
        collapse_script()) ++ "\n"

nav_label(lang: str) -> str {
    if lang == "ko" {
        "목차"
    } else if lang == "ja" {
        "目次"
    } else {
        "Contents"
    }
}

collapse_script() -> str =>
    script("""
(function(){
  var d=document.querySelector('details[data-tomo="nav"]');
  if(d&&window.matchMedia("(max-width:48rem)").matches)
    d.removeAttribute("open");
})();
""") ++ "\n"

side_items(chs: str[], titles: str[], cur: str, i: int) -> str {
    if i >= chs.length() {
        ""
    } else {
        side_item(chs.get(i), titles.get(i), cur)
            ++ side_items(chs, titles, cur, i + 1)
    }
}

side_item(entry: str, title: str, cur: str) -> str {
    if is_book(entry) {
        li(data-tomo="book", class=book_class(), escape_html(title))
    } else if is_section(entry) {
        li(data-tomo="section", class=sec_class(), escape_html(title))
    } else {
        here = entry == cur
        mark = if here { "current" } else { "chapter" }
        li(class="my-0",
           a(data-tomo=mark, class=link_class(here),
             href=entry ++ ".html", escape_html(title)))
    }
}

search_box() -> str =>
    input(id="q", type="search", placeholder="search", autocomplete="off",
          class="w-full my-2 px-2 py-1 border border-zinc-200"
                ++ " dark:border-zinc-700 rounded bg-white dark:bg-zinc-900"
                ++ " text-[0.85rem]")
    ++ ul(id="hits", class="list-none m-0 p-0")
    ++ script(src="search-index.js")
    ++ script(hit_styles())
    ++ script(search_js())

hit_styles() -> str =>
    "window.TOMO_CLS=\{hit:\"" ++ hit_class() ++ "\",sec:\""
        ++ hit_sec_class() ++ "\",none:\"" ++ hit_none_class() ++ "\"\};"

hit_class() -> str =>
    "block py-1 no-underline text-inherit text-[0.82rem]"

hit_sec_class() -> str =>
    "text-zinc-500 text-[0.75rem]"

hit_none_class() -> str =>
    "text-zinc-500 text-[0.8rem] py-1 block"

search_js() -> str =>
    """(function(){
  var q=document.getElementById("q"),hits=document.getElementById("hits");
  if(!q) return;
  var C=window.TOMO_CLS||{hit:"",sec:"",none:""};
  function esc(s){return s.replace(/[&<>"]/g,function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c];});}
  q.addEventListener("input",function(){
    var t=q.value.trim().toLowerCase();
    hits.innerHTML="";
    if(t.length<2) return;
    var idx=window.TOMO_INDEX||[],out=[],i;
    for(i=0;i<idx.length&&out.length<12;i++){
      var e=idx[i];
      if(e.s.toLowerCase().indexOf(t)>=0||e.x.indexOf(t)>=0) out.push(e);
    }
    if(!out.length){
      hits.innerHTML='<li><span class="'+C.none+'">no matches</span></li>';
      return;
    }
    hits.innerHTML=out.map(function(e){
      return '<li><a class="'+C.hit+'" href="'+esc(e.u)+'">'+esc(e.s)+
             '<br><span class="'+C.sec+'">'+esc(e.c)+'</span></a></li>';
    }).join("");
  });
})();
"""

page(title: str, cur: str, langs: str, side: str, body: str) -> str =>
    shell(title, cur, langs, side, body, "../", "")

shell(title: str, cur: str, langs: str, side: str, body: str, up: str,
      extra: str) -> str =>
    "<!doctype html>\n"
        ++ html(lang=cur,
            head(
                meta(charset="utf-8")
                meta(name="viewport",
                     content="width=device-width,initial-scale=1")
                title_tag(title)
                font_link(up)
                stylesheet()
                extra
            )
            body_tag(class=body_class(),
                div(class=column_class(side),
                    side ++ main_landmark(body)
                )
            )
        ) ++ "\n"

column_class(side: str) -> str {
    if side.length() == 0 {
        solo_class()
    } else {
        wrap_class()
    }
}

title_tag(text: str) -> str =>
    title(escape_html(text))

body_tag(class: str, inner: str) -> str =>
    body(class=class, inner)

body_class() -> str =>
    "font-serif text-base leading-relaxed break-keep bg-white dark:bg-zinc-900"
        ++ " text-zinc-900 dark:text-zinc-100"

pre_code_class() -> str =>
    "bg-transparent p-0 text-[0.88em]"

main_landmark(inner: str) -> str =>
    element("main", inner)

lang_links(codes: str[], i: int, cur: str, up: str, page: str) -> str {
    if codes.length() < 2 {
        ""
    } else {
        details(data-tomo="lang",
                summary(class=lang_summary_class(), lang_name(cur) ++ " ▾")
                ul(class=lang_menu_class(),
                   lang_options(codes, 0, cur, up, page)))
    }
}

lang_options(codes: str[], i: int, cur: str, up: str, page: str) -> str {
    if i >= codes.length() {
        ""
    } else {
        code = codes.get(i)
        option = li(class="my-0",
                    a(class=link_class(code == cur),
                      href=up ++ code ++ "/" ++ target_page(page),
                      lang=code,
                      lang_name(code)))
        option ++ lang_options(codes, i + 1, cur, up, page)
    }
}

target_page(page: str) -> str {
    if page.length() == 0 {
        "index.html"
    } else {
        page ++ ".html"
    }
}

build_book(root: str, out: str) -> int {
    toml = read_file(root ++ "/book.toml")
    title = conf_value(toml, "title")
    langs = conf_value(toml, "languages").replace(" ", "")
    chs = conf_value(toml, "chapters").split(",").map(v => v.trim())
    n = build_langs(root, out, title, langs, langs.split(","), 0, chs, 0)
    n + write_root(root, out, site_name(toml, title), langs)
}

site_name(toml: str, title: str) -> str {
    name = conf_value(toml, "site")

    if name == "" {
        title
    } else {
        name
    }
}

write_root(root: str, out: str, title: str, langs: str) -> int {
    make_dir(out)
    codes = langs.split(",")
    default = codes.get(0)

    write_file(out ++ "/index.html",
               landing(root, title, langs, default, default, ""))

    1 + write_landings(root, out, title, langs, codes, 0)
}

write_landings(root: str, out: str, title: str, langs: str, codes: str[],
               i: int) -> int {
    if i >= codes.length() {
        0
    } else {
        lang = codes.get(i)
        dir = out ++ "/" ++ lang
        make_dir(dir)
        write_file(dir ++ "/home.html",
                   landing(root, title, langs, lang, codes.get(0), "../"))
        1 + write_landings(root, out, title, langs, codes, i + 1)
    }
}

landing(root: str, title: str, langs: str, lang: str, fallback: str,
        up: str) -> str {
    src = chapter_source(root, lang, fallback, "home")
    body = landing_head(title, langs, lang, up)
           ++ "\n" ++ article(landing_body(src, title, langs, lang, up))
           ++ "\n"

    shell(title, lang, langs, "", body, up, "")
}

landing_head(title: str, langs: str, lang: str, up: str) -> str =>
    header(class=hero_class(),
           span(class="font-semibold text-[1.05rem]", escape_html(title))
           nav(data-tomo="i18n", class="relative shrink-0 text-[0.8rem]",
               lang_links(langs.split(","), 0, lang, up, "home")))

landing_body(src: str, title: str, langs: str, lang: str, up: str) -> str {
    if !file_exists(src) {
        picker(title, langs, up)
    } else {
        ls = read_lines(src)
        cut = first_section(ls, 0)

        render(ls.slice(0, cut).join("\n"))
            ++ calls_to_action(langs, lang, up)
            ++ render(ls.slice(cut, ls.length()).join("\n"))
    }
}

first_section(lines: str[], i: int) -> int {
    if i >= lines.length() {
        lines.length()
    } else if lines.get(i).starts_with("## ") {
        i
    } else {
        first_section(lines, i + 1)
    }
}

picker(title: str, langs: str, up: str) -> str =>
    h1(class=md_class("h1"), escape_html(title))
        ++ nav(ul(class="list-none p-0",
                  "\n" ++ root_links(langs.split(","), 0, up))) ++ "\n"

root_links(codes: str[], i: int, up: str) -> str {
    if i >= codes.length() {
        ""
    } else {
        code = codes.get(i)
        entry = li(class="my-1",
                   a(href=up ++ code ++ "/index.html", lang=code,
                     lang_name(code)))
        entry ++ root_links(codes, i + 1, up)
    }
}

calls_to_action(langs: str, lang: str, up: str) -> str =>
    nav(class="flex flex-wrap gap-3 my-8",
        a(class=cta_class(true), href=up ++ lang ++ "/index.html",
          cta_label(lang, "handbook"))
        a(class=cta_class(false), href=up ++ "play/index.html",
          cta_label(lang, "playground"))
        a(class=cta_class(false), href=Repo, cta_label(lang, "source"))) ++ "\n"

Repo = "https://github.com/pleahmacaka/macalang"

cta_class(primary: bool) -> str {
    base = "inline-block px-4 py-2 rounded-md no-underline font-sans"
        ++ " text-[0.9rem]"

    if primary {
        base ++ " bg-zinc-900 dark:bg-zinc-100 text-white dark:text-black"
    } else {
        base ++ " border border-zinc-300 dark:border-zinc-600 text-inherit"
    }
}

cta_label(lang: str, which: str) -> str {
    if lang != "ko" {
        english_cta(which)
    } else if which == "handbook" {
        "핸드북 읽기"
    } else if which == "playground" {
        "플레이그라운드"
    } else {
        "GitHub 소스"
    }
}

english_cta(which: str) -> str {
    if which == "handbook" {
        "Read the handbook"
    } else if which == "playground" {
        "Playground"
    } else {
        "Source on GitHub"
    }
}

hero_class() -> str =>
    "flex items-baseline justify-between gap-3 pb-3 mb-6 border-b"
        ++ " border-zinc-200 dark:border-zinc-700"

lang_name(code: str) -> str {
    if code == "en" {
        "English"
    } else if code == "ko" {
        "한국어"
    } else if code == "ja" {
        "日本語"
    } else if code == "es" {
        "Español"
    } else {
        code
    }
}

build_langs(root: str, out: str, title: str, langs: str, codes: str[],
            li: int, chs: str[], acc: int) -> int {
    if li >= codes.length() {
        acc
    } else {
        written = build_lang(root, out, title, langs, codes.get(li),
                             codes.get(0), chs)
        build_langs(root, out, title, langs, codes, li + 1, chs, acc + written)
    }
}

build_lang(root: str, out: str, title: str, langs: str, lang: str,
           fallback: str, chs: str[]) -> int {
    titles = chapter_titles(root, langs, lang, fallback, chs, 0)
    vols = volume_titles(chs, titles, 0, "")
    n = build_chapters(root, out, title, langs, lang, fallback, chs, titles,
                       0, 0)
    write_search_index(root, out, lang, fallback, chs, titles, vols)
    n + write_index(root, out, title, langs, lang, chs, titles)
}

chapter_titles(root: str, langs: str, lang: str, fallback: str, chs: str[],
               i: int) -> str[] {
    if i >= chs.length() {
        []
    } else {
        here = entry_title(root, langs, lang, fallback, chs.get(i))
        [here] ++ chapter_titles(root, langs, lang, fallback, chs, i + 1)
    }
}

entry_title(root: str, langs: str, lang: str, fallback: str, e: str) -> str {
    if is_section(e) {
        section_title(e, langs, lang)
    } else {
        chapter_title(root, lang, fallback, e)
    }
}

write_index(root: str, out: str, title: str, langs: str, lang: str,
            chs: str[], titles: str[]) -> int {
    dir = out ++ "/" ++ lang
    make_dir(dir)
    body = h1(class=md_class("h1"), escape_html(title))
           ++ nav(ol(class="list-none p-0",
                     "\n" ++ index_items(chs, titles, 0))) ++ "\n"
    side = sidebar(published(), "", title, langs, lang, chs, titles, "",
                   side_items(chs, titles, "", 0), "")
    write_file(dir ++ "/index.html", page(title, lang, langs, side, body))
    1
}

index_items(chs: str[], titles: str[], i: int) -> str {
    if i >= chs.length() {
        ""
    } else {
        index_item(chs.get(i), titles.get(i))
            ++ index_items(chs, titles, i + 1)
    }
}

index_item(entry: str, title: str) -> str {
    if is_book(entry) {
        li(data-tomo="book", class=book_class(), escape_html(title))
    } else if is_section(entry) {
        li(data-tomo="section", class=sec_class(), escape_html(title))
    } else {
        li(class="my-0",
           a(class=link_class(false), href=entry ++ ".html", escape_html(title)))
    }
}

write_search_index(root: str, out: str, lang: str, fallback: str, chs: str[],
                   titles: str[], vols: str[]) -> int {
    dir = out ++ "/" ++ lang
    make_dir(dir)
    body = index_chapters(root, lang, fallback, chs, titles, vols, 0)
    write_file(dir ++ "/search-index.js",
               "window.TOMO_INDEX=[" ++ body ++ "];\n")
    0
}

index_chapters(root: str, lang: str, fallback: str, chs: str[], titles: str[],
               vols: str[], i: int) -> str {
    if i >= chs.length() {
        ""
    } else {
        index_chapter(root, lang, fallback, chs.get(i), titles.get(i),
                      vols.get(i))
            ++ index_chapters(root, lang, fallback, chs, titles, vols, i + 1)
    }
}

index_chapter(root: str, lang: str, fallback: str, ch: str, ctitle: str,
              vol: str) -> str {
    src = chapter_source(root, lang, fallback, ch)

    if !file_exists(src) {
        ""
    } else {
        sections(read_lines(src), 0, ch ++ ".html",
                 caption(vol, ctitle), "", "", "")
    }
}

caption(vol: str, ctitle: str) -> str {
    if vol == "" {
        ctitle
    } else {
        vol ++ " / " ++ ctitle
    }
}

chapter_source(root: str, lang: str, fallback: str, ch: str) -> str {
    if is_section(ch) {
        ""
    } else {
        own = root ++ "/book/" ++ lang ++ "/" ++ ch ++ ".md"
        if file_exists(own) {
            own
        } else {
            root ++ "/book/" ++ fallback ++ "/" ++ ch ++ ".md"
        }
    }
}

sections(lines: str[], i: int, url: str, ctitle: str, head: str, buf: str,
         acc: str) -> str {
    if i >= lines.length() {
        acc ++ entry(url, ctitle, head, buf)
    } else if head_text(lines.get(i)).length() > 0 {
        sections(lines, i + 1, url, ctitle, head_text(lines.get(i)), "",
                 acc ++ entry(url, ctitle, head, buf))
    } else {
        sections(lines, i + 1, url, ctitle, head,
                 buf ++ " " ++ lines.get(i), acc)
    }
}

head_text(line: str) -> str {
    n = head_level(line)

    if n == 0 {
        ""
    } else {
        line.substr(n + 1, line.length() - n - 1)
    }
}

entry(url: str, ctitle: str, head: str, buf: str) -> str {
    if head.length() == 0 {
        ""
    } else {
        object_of(["u", "c", "s", "x"],
                  [quote(url ++ "#" ++ slug(head)), quote(ctitle),
                   quote(head), quote(buf.lower())]) ++ ","
    }
}

chapter_title(root: str, lang: str, fallback: str, ch: str) -> str {
    src = chapter_source(root, lang, fallback, ch)

    if !file_exists(src) {
        ch
    } else {
        first_heading(read_lines(src), 0, ch)
    }
}

first_heading(lines: str[], i: int, fallback: str) -> str {
    if i >= lines.length() {
        fallback
    } else if lines.get(i).starts_with("# ") {
        lines.get(i).substr(2, lines.get(i).length() - 2)
    } else {
        first_heading(lines, i + 1, fallback)
    }
}

build_chapters(root: str, out: str, title: str, langs: str, lang: str,
               fallback: str, chs: str[], titles: str[], ci: int,
               acc: int) -> int {
    if ci >= chs.length() {
        acc
    } else {
        written = build_chapter(root, out, title, langs, lang, fallback, chs,
                                titles, ci)
        build_chapters(root, out, title, langs, lang, fallback, chs, titles,
                       ci + 1, acc + written)
    }
}

build_chapter(root: str, out: str, title: str, langs: str, lang: str,
              fallback: str, chs: str[], titles: str[], ci: int) -> int {
    src = chapter_source(root, lang, fallback, chs.get(ci))

    if !file_exists(src) {
        0
    } else {
        write_chapter(published(), out, title, langs, lang, chs, titles, ci,
                      parts_of(chs, titles, ci, read_file(src)))
    }
}

/// One chapter's page, written where the book wants it.
write_chapter(d: Dev, out: str, title: str, langs: str, lang: str, chs: str[],
              titles: str[], ci: int, p: Parts) -> int {
    dir = out ++ "/" ++ lang
    make_dir(dir)
    write_file(dir ++ "/" ++ chs.get(ci) ++ ".html",
               chapter_page(d, title, langs, lang, chs, titles, ci, p))
    1
}

/// One chapter's page, as markup.
chapter_page(d: Dev, title: str, langs: str, lang: str, chs: str[],
             titles: str[], ci: int, p: Parts) -> str {
    key = page_key(lang, chs.get(ci))
    body = article_region(d, key, p.article) ++ "\n" ++ chapter_nav(chs, ci)
    side = sidebar(d, key, title, langs, lang, chs, titles, chs.get(ci), p.nav,
                   toc_region(d, key, p.toc))

    shell(title, lang, langs, side, body, "../", d.extra)
}

main() -> int {
    sample = "# Title\n\nA **bold** word and `code`, see [docs](guide.md).\n\n"
        ++ "An `int[]` is a list, and [two](a.md) [links](b.md) both work.\n\n"
        ++ "## Is it fast?\n\n- one\n  - nested\n- two\n\n1. first\n2. second\n\n"
        ++ "| target | flag |\n|--------|------|\n| native | `--target c` |\n\n"
        ++ "> a quoted aside that\n> wraps across two source lines\n\n"
        ++ "```maca\ngreet(n: int) -> str => \"hi \{n\}\"\n```\n"
        ++ "```\nx = 1\n```\n"
    html = render(sample)
    info("=== rendered ===")
    info(html)
    info("=== toc ===")
    info(toc(sample))
    info("=== page ===")
    demo = sidebar(published(), "", "Maca Handbook", "en,ko", "en", ["a", "b"],
                   ["One", "Two"], "a",
                   side_items(["a", "b"], ["One", "Two"], "a", 0), toc(sample))
    info(page("Maca Handbook", "en", "en,ko", demo, article("hi")))

    info("=== build ===")
    pages = build_book("apps/tomo", "apps/tomo/site")
    info("built {pages} pages")
    0
}
