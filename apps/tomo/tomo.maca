// tomo — the macalang handbook builder, written in Maca.
//
// Markdown -> HTML, i18n-first (the mdBook analogue for the Maca ecosystem;
// "tomo" is Spanish for a book's volume, in the Andean spirit of `maca`). The
// core is a pure `render : str -> str` markdown renderer; the CLI driver
// (file I/O over a `book.toml` + per-language chapter trees) wraps it, and the
// i18n layer renders each language's chapters into a page carrying a language
// switcher. This file is the renderer + a self-check `main`.

import std/str

// Escape the HTML metacharacters (`&` first, so it doesn't double-escape).
esc(s: str) -> str =>
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

// A URL anchor slug for a heading: lowercased, spaces to hyphens. (A light
// version — dropping punctuation grows here.)
slug(text: str) -> str =>
    text.lower().replace(" ", "-")

// `<hN id="slug">text</hN>` — the `id` lets the table of contents link to it.
heading(level: str, text: str) -> str =>
    "<h" ++ level ++ " id=\"" ++ slug(text) ++ "\">" ++ inline(esc(text)) ++ "</h" ++ level ++ ">\n"

// Replace only the *first* occurrence of `from` with `to` (`std/str`'s
// `replace` swaps every occurrence, so alternating open/close tags need this).
first_repl(s: str, pat: str, rep: str) -> str {
    idx = s.index_of(pat)
    idx < 0
        ? s
        : s.substr(0, idx) ++ rep ++ s.substr(idx + pat.length(), s.length() - idx - pat.length())
}

// `index_of` from an offset — returns an absolute index, or -1.
index_from(s: str, pat: str, start: int) -> int {
    idx = s.substr(start, s.length() - start).index_of(pat)
    idx < 0 ? -1 : idx + start
}

// Inline formatting within a line: links, then **bold**, then `code`.
inline(s: str) -> str =>
    link(bold(code(s)))

// `[text](url)` -> `<a href="url">text</a>`, recursing on the remainder. A `[`
// that doesn't open a well-formed link is left as-is.
link(s: str) -> str {
    open = s.index_of("[")
    close = open < 0 ? -1 : index_from(s, "](", open)
    urlend = close < 0 ? -1 : index_from(s, ")", close + 2)
    urlend < 0
        ? s
        : s.substr(0, open)
          ++ "<a href=\"" ++ s.substr(close + 2, urlend - close - 2) ++ "\">"
          ++ s.substr(open + 1, close - open - 1) ++ "</a>"
          ++ link(s.substr(urlend + 1, s.length() - urlend - 1))
}

// `` `x` `` -> `<code>x</code>` — the first two backticks become the open/close
// tags; further pairs are handled by recursing.
code(s: str) -> str =>
    s.contains("`")
        ? code(first_repl(first_repl(s, "`", "<code>"), "`", "</code>"))
        : s

// `**x**` -> `<strong>x</strong>`.
bold(s: str) -> str =>
    s.contains("**")
        ? bold(first_repl(first_repl(s, "**", "<strong>"), "**", "</strong>"))
        : s

// Render a whole markdown document to HTML.
render(md: str) -> str =>
    render_lines(md.split("\n"), 0, false, "")

// Fold over the lines, threading `in_code` (inside a ``` fence) and the HTML
// accumulator `acc`.
render_lines(lines: str[], i: int, in_code: bool, acc: str) -> str =>
    i >= lines.length()
        ? (in_code ? acc ++ "</code></pre>\n" : acc)
        : render_line(lines, i, in_code, acc)

render_line(lines: str[], i: int, in_code: bool, acc: str) -> str {
    line = lines.get(i)
    line.starts_with("```")
        ? render_lines(lines, i + 1, !in_code, acc ++ (in_code ? "</code></pre>\n" : "<pre><code>"))
        : in_code
            ? render_lines(lines, i + 1, true, acc ++ esc(line) ++ "\n")
            : render_block(lines, i, acc, line)
}

// A non-code line: a heading, a list item, a blank separator, or a paragraph.
render_block(lines: str[], i: int, acc: str, line: str) -> str {
    html = line.starts_with("### ")
        ? heading("3", line.substr(4, line.length() - 4))
        : line.starts_with("## ")
            ? heading("2", line.substr(3, line.length() - 3))
            : line.starts_with("# ")
                ? heading("1", line.substr(2, line.length() - 2))
                : line.starts_with("- ")
                    ? "<li>" ++ inline(esc(line.substr(2, line.length() - 2))) ++ "</li>\n"
                    : line.trim() == ""
                        ? ""
                        : "<p>" ++ inline(esc(line)) ++ "</p>\n"
    render_lines(lines, i + 1, false, acc ++ html)
}

// ---- table of contents ----------------------------------------------------

// Build a `<nav>` list of a document's headings, each linking to its anchor.
toc(md: str) -> str =>
    "<nav class=\"toc\">\n<ul>\n" ++ toc_lines(md.split("\n"), 0) ++ "</ul>\n</nav>\n"

toc_lines(lines: str[], i: int) -> str =>
    i >= lines.length()
        ? ""
        : toc_line(lines.get(i)) ++ toc_lines(lines, i + 1)

toc_line(line: str) -> str =>
    line.starts_with("### ")
        ? toc_entry(line.substr(4, line.length() - 4))
        : line.starts_with("## ")
            ? toc_entry(line.substr(3, line.length() - 3))
            : line.starts_with("# ")
                ? toc_entry(line.substr(2, line.length() - 2))
                : ""

toc_entry(text: str) -> str =>
    "<li><a href=\"#" ++ slug(text) ++ "\">" ++ esc(text) ++ "</a></li>\n"

// ---- i18n page shell ------------------------------------------------------

// Wrap rendered chapter HTML in a minimal page with a language switcher. `langs`
// is a comma-joined list of codes (e.g. "en,ko"); `cur` is the active one.
page(title: str, cur: str, langs: str, body: str) -> str =>
    "<!doctype html>\n<html lang=\"" ++ cur ++ "\">\n<head><meta charset=\"utf-8\">\n" ++
    "<title>" ++ esc(title) ++ "</title></head>\n<body>\n" ++
    "<nav class=\"i18n\">" ++ lang_links(langs.split(","), 0, cur) ++ "</nav>\n" ++
    body ++
    "</body>\n</html>\n"

lang_links(codes: str[], i: int, cur: str) -> str =>
    i >= codes.length()
        ? ""
        : (codes.get(i) == cur
            ? "<strong>" ++ codes.get(i) ++ "</strong> "
            : "<a href=\"../" ++ codes.get(i) ++ "/\">" ++ codes.get(i) ++ "</a> ")
          ++ lang_links(codes, i + 1, cur)

// ---- self-check -----------------------------------------------------------

main() -> int {
    sample = "# Title\n\nA **bold** word and `code`, see [docs](guide.md).\n\n## Section\n\n- one\n- two\n\n```\nlet x = 1\n```\n"
    html = render(sample)
    info("=== rendered ===")
    info(html)
    info("=== toc ===")
    info(toc(sample))
    info("=== page ===")
    info(page("Maca Handbook", "en", "en,ko", "<article>hi</article>\n"))
    0
}
