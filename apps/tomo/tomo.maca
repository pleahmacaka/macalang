// tomo — the macalang handbook builder, written in Maca.
//
// Markdown -> HTML, i18n-first (the mdBook analogue for the Maca ecosystem;
// "tomo" is Spanish for a book's volume, in the Andean spirit of `maca`). The
// core is a pure `render : str -> str` markdown renderer; the CLI driver
// (file I/O over a `book.toml` + per-language chapter trees) wraps it, and the
// i18n layer renders each language's chapters into a page carrying a language
// switcher. This file is the renderer + a self-check `main`.

import std/str

// Escape the HTML metacharacters (`&` first, so it doesn't double-escape).
esc(s: str) -> str =>
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

// A URL anchor slug for a heading: lowercased, whitespace to hyphens, ASCII
// punctuation dropped. Headings like "To `fail` or not to `fail`?" have to
// produce a link that works.
//
// Everything *else* is kept, and that matters more than it looks: `chars()` is
// byte-based, so a Korean heading arrives as multi-byte sequences. Keeping only
// `is_alpha() || is_ascii_digit()` deleted every one of those bytes and turned
// "값과 타입" into an empty anchor — in the language this book exists to be
// translated into. So the rule drops a known set rather than keeping one.
slug(text: str) -> str =>
    slug_chars(text.lower().chars(), 0, "")

slug_chars(cs: str[], i: int, acc: str) -> str =>
    i >= cs.length()
        ? acc
        : slug_chars(cs, i + 1, acc ++ slug_char(cs.get(i)))

slug_char(c: str) -> str =>
    c == " " || c == "\t" || c == "_" ? "-" : (is_drop(c) ? "" : c)

// ASCII punctuation with no place in a URL fragment. Any byte outside this set
// — including every byte of a multi-byte character — is kept.
is_drop(c: str) -> bool =>
    ".,?!:;`\"'()[]\{\}/\\*&<>=+|#@$%^~".contains(c)

// ---- the look of rendered markdown ----------------------------------------
//
// Utilities cannot style a descendant, so every element the renderer emits
// carries its own classes. That is the price of having no stylesheet, and it is
// worth paying: the classes sit next to the markup that uses them, and only the
// rules actually used are generated.

md_class(kind: str) -> str =>
    kind == "h1"
        ? "font-sans text-[2rem] leading-tight mt-2 mb-3 font-bold"
        : (kind == "h2"
            ? "font-sans text-[1.4rem] leading-tight mt-9 mb-3 font-bold"
            : (kind == "h3"
                ? "font-sans text-[1.15rem] leading-tight mt-8 mb-3 font-bold"
                : md_class2(kind)))

md_class2(kind: str) -> str =>
    kind == "p"
        ? "my-4"
        : (kind == "pre"
            ? "bg-zinc-100 dark:bg-zinc-800 p-4 rounded-md overflow-x-auto"
                  ++ " my-4"
            : (kind == "quote"
                ? "border-l-2 border-zinc-300 dark:border-zinc-600 pl-4 my-4"
                      ++ " text-zinc-600 dark:text-zinc-400"
                : md_class3(kind)))

cell_class() -> str =>
    "border border-zinc-200 dark:border-zinc-700 px-3 py-2 text-left align-top"

md_class3(kind: str) -> str =>
    kind == "table"
        ? "block overflow-x-auto border-collapse w-full my-5"
              ++ " text-[0.94rem]"
        : (kind == "th"
            ? cell_class() ++ " font-sans text-[0.88rem]"
                  ++ " bg-zinc-100 dark:bg-zinc-800"
            : (kind == "td"
                ? cell_class()
                : (kind == "list" ? "my-4 pl-6" : "my-1")))

// `<hN id="slug">text</hN>` — the `id` lets the table of contents link to it.
//
// The tag is `element(…)` rather than a literal, because the depth chooses it.
heading(level: str, text: str) -> str =>
    element("h" ++ level,
            id=slug(text),
            class=md_class("h" ++ level),
            inline(esc(text))) ++ "\n"

// `index_of` from an offset — returns an absolute index, or -1.
index_from(s: str, pat: str, start: int) -> int {
    idx = s.substr(start, s.length() - start).index_of(pat)
    idx < 0 ? -1 : idx + start
}

// Inline formatting within a line: code spans, then **bold**, then links.
inline(s: str) -> str =>
    link(bold(code_spans(s)))

// `[text](url)` -> `<a href="url">text</a>`, recursing on the remainder.
link(s: str) -> str {
    open = s.index_of("[")
    open < 0 ? s : link_at(s, open)
}

// A link starting at the `[` at `open`.
//
// A `[` that doesn't open a well-formed link keeps its place and the scan
// continues *after* it. Giving up on the whole remainder — which is what
// returning `s` here used to do — silently killed every link later on the line,
// and `code_spans` runs first, so any line with an inline code span carries a
// `text-[0.88em]` class through this pass.
link_at(s: str, open: int) -> str {
    close = index_from(s, "](", open)
    urlend = close < 0 ? -1 : index_from(s, ")", close + 2)
    next = index_from(s, "[", open + 1)
    urlend < 0 || (next >= 0 && next < close)
        ? s.substr(0, open + 1)
              ++ link(s.substr(open + 1, s.length() - open - 1))
        : s.substr(0, open)
          ++ a(class="text-inherit underline underline-offset-2"
                     ++ " decoration-zinc-400",
               href=href(s.substr(close + 2, urlend - close - 2)),
               s.substr(open + 1, close - open - 1))
          ++ link(s.substr(urlend + 1, s.length() - urlend - 1))
}

// A link between chapters is written to the source file — `[next](01-x.md)` —
// because that is what works when the Markdown is read on its own, in an editor
// or on a git host. Rendered, it has to point at the page that was produced.
// Without this rewrite every cross-chapter link in the book is a 404.
href(url: str) -> str =>
    url.ends_with(".md") && !url.contains("://")
        ? url.substr(0, url.length() - 3) ++ ".html"
        : url

// `` `x` `` -> `<code>x</code>`, recursing on what follows the closing
// backtick. An unpaired backtick is left alone.
code_spans(s: str) -> str {
    open = s.index_of("`")
    close = open < 0 ? -1 : index_from(s, "`", open + 1)
    close < 0
        ? s
        : s.substr(0, open)
          ++ code(class="bg-zinc-100 dark:bg-zinc-800 px-1 rounded-sm"
                        ++ " font-mono text-[0.88em]",
                  s.substr(open + 1, close - open - 1))
          ++ code_spans(s.substr(close + 1, s.length() - close - 1))
}

// `**x**` -> `<strong>x</strong>`.
bold(s: str) -> str {
    open = s.index_of("**")
    close = open < 0 ? -1 : index_from(s, "**", open + 2)
    close < 0
        ? s
        : s.substr(0, open)
          ++ strong(s.substr(open + 2, close - open - 2))
          ++ bold(s.substr(close + 2, s.length() - close - 2))
}

// Render a whole markdown document to HTML.
render(md: str) -> str =>
    render_lines(md.split("\n"), 0, "")

// Fold over the lines, threading the HTML accumulator `acc`.
render_lines(lines: str[], i: int, acc: str) -> str =>
    i >= lines.length() ? acc : render_line(lines, i, acc)

render_line(lines: str[], i: int, acc: str) -> str {
    line = lines.get(i)
    line.starts_with("```")
        ? render_fence(lines, i, acc, line)
        : render_block(lines, i, acc, line)
}

// A fenced block, gathered whole and emitted as one element.
//
// Streaming it — open tag, then a line at a time, then a close tag — is why
// this used to thread an `in_code` flag through every step of the fold, and it
// meant the `<pre>` could only ever be written as raw text. Collecting the run
// first costs one more pass and lets the markup be markup.
//
// ```` ```maca ```` carries its language through to a `language-maca` class,
// the convention every highlighter reads. An unlabelled fence is fine too.
render_fence(lines: str[], i: int, acc: str, fence: str) -> str {
    stop = fence_end(lines, i + 1)
    lang = fence.substr(3, fence.length() - 3).trim()
    html = pre(class=md_class("pre"),
               code(class=pre_code_class() ++ lang_class(lang),
                    fence_body(lines, i + 1, stop)))
    render_lines(lines, stop + 1, acc ++ html ++ "\n")
}

// The closing fence, or the end of the document if it is missing.
fence_end(lines: str[], i: int) -> int =>
    i >= lines.length() || lines.get(i).starts_with("```")
        ? i
        : fence_end(lines, i + 1)

fence_body(lines: str[], at: int, stop: int) -> str =>
    at >= stop
        ? ""
        : esc(lines.get(at)) ++ "\n" ++ fence_body(lines, at + 1, stop)

lang_class(lang: str) -> str =>
    lang.length() == 0 ? "" : " language-" ++ slug(lang)

// A non-code line: a heading, a table, a list, a quote, a blank separator, or
// a paragraph. Headings are one line each; the rest absorb the run of lines
// that belongs to them, so Markdown that wraps mid-sentence (and mid-`**bold**`)
// renders as one block rather than several broken ones.
render_block(lines: str[], i: int, acc: str, line: str) -> str =>
    head_level(line) > 0
        ? render_lines(lines, i + 1, acc ++ head_html(line))
        : is_table(line)
            ? render_table(lines, i, acc)
            : is_item(line)
                ? render_list(lines, i, acc)
                : line.starts_with("> ")
                    ? render_quote(lines, i, acc)
                    : line.trim() == ""
                        ? render_lines(lines, i + 1, acc)
                        : render_para(lines, i, acc)

// `#`, `##`, `###` → 1, 2, 3; 0 when the line is not a heading.
head_level(line: str) -> int =>
    line.starts_with("### ")
        ? 3
        : (line.starts_with("## ") ? 2 : (line.starts_with("# ") ? 1 : 0))

head_html(line: str) -> str {
    n = head_level(line)
    heading(str(n), line.substr(n + 1, line.length() - n - 1))
}

// ---- lists ----------------------------------------------------------------

is_bullet(line: str) -> bool =>
    line.starts_with("- ") || line.starts_with("  - ")

// `1. `, `2. `, … — a digit run then `. `.
is_numbered(line: str) -> bool {
    t = line.trim()
    d = digits_at(t.chars(), 0)
    d > 0 && t.substr(d, 2) == ". "
}

digits_at(cs: str[], i: int) -> int =>
    i >= cs.length() || !cs.get(i).is_ascii_digit() ? i : digits_at(cs, i + 1)

is_item(line: str) -> bool =>
    is_bullet(line) || is_numbered(line)

// A whole list: consecutive item lines, wrapped in one `<ul>`/`<ol>`. Emitting
// bare `<li>`s (as this did before) is invalid HTML — browsers cope, but the
// list gets no indent and no marker styling.
render_list(lines: str[], i: int, acc: str) -> str {
    stop = list_end(lines, i)
    // ordered or not decides the tag, so the tag is an expression
    tag = is_numbered(lines.get(i)) ? "ol" : "ul"
    html = element(tag, class=md_class("list"),
                   "\n" ++ list_items(lines, i, stop)) ++ "\n"
    render_lines(lines, stop, acc ++ html)
}

list_end(lines: str[], i: int) -> int =>
    i >= lines.length() || !is_item(lines.get(i)) ? i : list_end(lines, i + 1)

// Two leading spaces mark a nested item, which gets its own `<ul>` so it
// indents under its parent.
list_items(lines: str[], at: int, stop: int) -> str =>
    at >= stop
        ? ""
        : one_item(lines.get(at)) ++ list_items(lines, at + 1, stop)

one_item(line: str) -> str {
    nested = line.starts_with("  - ")
    text = item_text(line, nested)
    nested
        ? ul(li(inline(esc(text)))) ++ "\n"
        : li(class=md_class("li"), inline(esc(text))) ++ "\n"
}

// Drop the marker: `- `, `  - `, or `12. `.
item_text(line: str, nested: bool) -> str {
    t = line.trim()
    nested
        ? line.substr(4, line.length() - 4)
        : (is_numbered(line)
            ? t.substr(digits_at(t.chars(), 0) + 2, t.length())
            : t.substr(2, t.length() - 2))
}

// ---- tables ---------------------------------------------------------------

// A table row: `| a | b |`. The appendices are mostly tables, so this is not
// optional decoration.
is_table(line: str) -> bool =>
    line.trim().starts_with("|")

// The `|---|:--:|` alignment row, which carries no content.
is_rule_row(line: str) -> bool {
    body = line.trim().replace("|", "").replace("-", "").replace(":", "").trim()
    line.trim().starts_with("|") && line.contains("-") && body == ""
}

render_table(lines: str[], i: int, acc: str) -> str {
    stop = table_end(lines, i)
    head = thead("\n" ++ row(lines.get(i), "th")) ++ "\n"
    // skip the header row and, if present, the alignment rule under it
    body_at = i + 1 < stop && is_rule_row(lines.get(i + 1)) ? i + 2 : i + 1
    body = tbody("\n" ++ rows(lines, body_at, stop)) ++ "\n"
    html = table(class=md_class("table"), "\n" ++ head ++ body) ++ "\n"
    render_lines(lines, stop, acc ++ html)
}

table_end(lines: str[], i: int) -> int =>
    i >= lines.length() || !is_table(lines.get(i)) ? i : table_end(lines, i + 1)

rows(lines: str[], at: int, stop: int) -> str =>
    at >= stop ? "" : row(lines.get(at), "td") ++ rows(lines, at + 1, stop)

// One row. The leading and trailing `|` produce empty edge cells, which are
// dropped by `cells` rather than by trimming the line, so an intentionally
// empty cell in the middle survives.
row(line: str, tag: str) -> str =>
    tr(cells(split_cells(line.trim()), 1, tag)) ++ "\n"

// Split a row on `|`, honouring `\|` as a literal pipe — the operator appendix
// has a row *about* `||`, which a naive split turns into three broken cells.
split_cells(s: str) -> str[] =>
    cell_walk(s.chars(), 0, "", [])

cell_walk(cs: str[], i: int, cur: str, acc: str[]) -> str[] =>
    i >= cs.length()
        ? acc ++ [cur]
        : (is_escaped_pipe(cs, i)
            ? cell_walk(cs, i + 2, cur ++ "|", acc)
            : (cs.get(i) == "|"
                ? cell_walk(cs, i + 1, "", acc ++ [cur])
                : cell_walk(cs, i + 1, cur ++ cs.get(i), acc)))

is_escaped_pipe(cs: str[], i: int) -> bool =>
    cs.get(i) == "\\" && i + 1 < cs.length() && cs.get(i + 1) == "|"

// `tag` is `th` in the header row and `td` below it — the same reason `element`
// exists: which tag a cell gets is decided by the data, not by the source.
cells(parts: str[], i: int, tag: str) -> str =>
    i >= parts.length() - 1
        ? ""
        : element(tag, class=md_class(tag),
                  inline(esc(parts.get(i).trim())))
              ++ cells(parts, i + 1, tag)

// Gather the run of `> ` lines starting at `i` into one blockquote (a quote
// wraps across lines the same way a paragraph does).
render_quote(lines: str[], i: int, acc: str) -> str {
    stop = quote_end(lines, i)
    text = join_quote(lines, i, stop)
    render_lines(lines, stop,
                 acc ++ blockquote(class=md_class("quote"), inline(esc(text)))
                     ++ "\n")
}

quote_end(lines: str[], i: int) -> int =>
    i >= lines.length() || !lines.get(i).starts_with("> ")
        ? i
        : quote_end(lines, i + 1)

// Join `lines[at..stop)`, stripping each line's `> ` marker.
join_quote(lines: str[], at: int, stop: int) -> str =>
    at >= stop
        ? ""
        : at == stop - 1
            ? lines.get(at).substr(2, lines.get(at).length() - 2).trim()
            : lines.get(at).substr(2, lines.get(at).length() - 2).trim()
                  ++ " " ++ join_quote(lines, at + 1, stop)

// Gather the run of plain lines starting at `i` into a single paragraph.
render_para(lines: str[], i: int, acc: str) -> str {
    stop = para_end(lines, i)
    text = join_range(lines, i, stop)
    render_lines(lines, stop,
                 acc ++ p(class=md_class("p"), inline(esc(text))) ++ "\n")
}

// The index just past the paragraph starting at `i` — a blank line, a heading,
// a list item, or a code fence ends it.
para_end(lines: str[], i: int) -> int =>
    i >= lines.length() || is_break(lines.get(i))
        ? i
        : para_end(lines, i + 1)

is_break(line: str) -> bool =>
    line.trim() == "" || line.starts_with("#") || is_item(line) ||
        line.starts_with("> ") || line.starts_with("```") || is_table(line)

// Join `lines[from..to)` with single spaces (Markdown's soft-wrap semantics).
join_range(lines: str[], at: int, stop: int) -> str =>
    at >= stop
        ? ""
        : at == stop - 1
            ? lines.get(at).trim()
            : lines.get(at).trim() ++ " " ++ join_range(lines, at + 1, stop)

// ---- table of contents ----------------------------------------------------

// Build a `<nav>` list of a document's headings, each linking to its anchor.
toc(md: str) -> str =>
    nav(data-tomo="toc",
        class="border-t border-zinc-200 dark:border-zinc-700 mt-3 pt-2",
        "\n" ++ ul(class="list-none m-0 p-0",
                   "\n" ++ toc_lines(md.split("\n"), 0)) ++ "\n") ++ "\n"

toc_lines(lines: str[], i: int) -> str =>
    i >= lines.length()
        ? ""
        : toc_line(lines.get(i)) ++ toc_lines(lines, i + 1)

toc_line(line: str) -> str =>
    line.starts_with("### ")
        ? toc_entry(line.substr(4, line.length() - 4))
        : line.starts_with("## ")
            ? toc_entry(line.substr(3, line.length() - 3))
            : line.starts_with("# ")
                ? toc_entry(line.substr(2, line.length() - 2))
                : ""

toc_entry(text: str) -> str =>
    li(class="my-0",
       a(class=link_class(false) ++ " pl-4 text-[0.82rem]",
         href="#" ++ slug(text), esc(text))) ++ "\n"

// ---- i18n page shell ------------------------------------------------------

// A self-contained stylesheet — no external fetch, so a built book works from
// the filesystem.
//
// Almost all of it is `styles()`, generated by the compiler from the utility
// classes this program actually writes. What is left is the one rule that is
// about the *document* rather than any element: telling the browser the page
// has both a light and a dark palette, so form controls and scrollbars follow.
// (A raw triple-quoted string — CSS is full of `{`/`}`, which would otherwise
// read as string interpolation.)
base_css() -> str =>
    """html{color-scheme:light dark}
"""

// Named for what it produces rather than the tag, because `style` *is* the tag
// and a definition of that name would shadow it.
stylesheet() -> str =>
    style(base_css() ++ styles()) ++ "\n"

// Previous/next links between chapters, so a reader can move through the book.
chapter_nav(chs: str[], idx: int) -> str {
    p = prev_page(chs, idx)
    n = next_page(chs, idx)
    nav(class="chapters",
        p >= 0 ? a(href=chs.get(p) ++ ".html", "← previous") : span("")
        n >= 0 ? a(href=chs.get(n) ++ ".html", "next →") : span("")
    ) ++ "\n"
}

// ---- layout classes -------------------------------------------------------
//
// Named once here rather than repeated at each call site, because they are the
// page's structure and it should be possible to see all of it together.

// A sidebar entry, and the same shape marked as the page you are on.
link_class(current: bool) -> str =>
    "block px-2 py-1 rounded no-underline"
        ++ (current
                ? " bg-zinc-100 dark:bg-zinc-800 text-black dark:text-white"
                    ++ " font-semibold"
                : " text-zinc-500 hover:bg-zinc-100 dark:hover:bg-zinc-800"
                    ++ " hover:text-black dark:hover:text-white")

sec_class() -> str =>
    "mt-4 mb-1 px-2 text-[0.78rem] uppercase tracking-wide font-semibold"
        ++ " first:mt-1"

lang_summary_class() -> str =>
    "cursor-pointer px-2 py-1 border border-zinc-200 dark:border-zinc-700"
        ++ " rounded text-zinc-500 whitespace-nowrap list-none"
        ++ " details-marker:hidden"

lang_menu_class() -> str =>
    "absolute right-0 z-10 mt-1 p-1 list-none bg-white dark:bg-zinc-900"
        ++ " border border-zinc-200 dark:border-zinc-700 rounded-md shadow-lg"

wrap_class() -> str =>
    "grid grid-cols-[16rem_minmax(0,44rem)] gap-12 justify-center"
        ++ " p-8 pb-20 max-md:block max-md:max-w-[44rem] max-md:mx-auto"
        ++ " max-md:p-5"

solo_class() -> str =>
    "block max-w-[44rem] mx-auto p-8 pb-20"

side_class() -> str =>
    "font-sans text-[0.85rem] sticky top-8 self-start max-h-screen"
        ++ " overflow-y-auto overscroll-contain max-md:static max-md:max-h-none"
        ++ " max-md:mb-6 max-md:border-b max-md:border-zinc-200"

sh_class() -> str =>
    "flex items-baseline justify-between gap-3 pb-2 border-b"
        ++ " border-zinc-200 dark:border-zinc-700 sticky top-0 bg-white"
        ++ " dark:bg-zinc-900 z-10"

// ---- sections -------------------------------------------------------------
//
// A `chapters` entry beginning with `#` is a section heading rather than a
// page: it groups the chapters that follow it. The label carries one title per
// language, `|`-separated in the same order as `languages`:
//
//     "# Getting Started|시작하기",
//
// A language with no title of its own falls back to the first, the same way a
// missing chapter falls back to the default language. Sections are labels, not
// content, so they live in the config and leave the chapter directory to hold
// only things a reader can open.

is_section(entry: str) -> bool =>
    entry.starts_with("#")

section_title(entry: str, langs: str, lang: str) -> str {
    parts = entry.substr(1, entry.length() - 1).split("|").map(v => v.trim())
    at = index_in(langs.split(","), lang, 0)
    at >= 0 && at < parts.length() ? parts.get(at) : parts.get(0)
}

index_in(xs: str[], want: str, i: int) -> int =>
    i >= xs.length() ? -1 : (xs.get(i) == want ? i : index_in(xs, want, i + 1))

// The nearest real page before/after `i`, skipping section headings. Without
// this, previous/next would walk into a heading that has no page.
prev_page(chs: str[], i: int) -> int =>
    i <= 0
        ? -1
        : (is_section(chs.get(i - 1)) ? prev_page(chs, i - 1) : i - 1)

next_page(chs: str[], i: int) -> int =>
    i + 1 >= chs.length()
        ? -1
        : (is_section(chs.get(i + 1)) ? next_page(chs, i + 1) : i + 1)

// ---- sidebar and search ---------------------------------------------------

// Everything a reader navigates with, in one left column: the book title, the
// language switcher, search, the chapter list with the current one marked, and
// the current page's own headings. Nothing above the text — a reader scrolling
// a chapter should never lose their place in the book.
//
// The bulk of it is a `<details>` so a phone gets a line instead of three
// screens of links before the prose starts. It ships open, and a line of script
// closes it on a narrow viewport; without script it stays open and usable.
sidebar(title: str, langs: str, cur_lang: str, chs: str[], titles: str[],
        cur: str, toc_html: str) -> str =>
    div(data-tomo="side", class=side_class(),
        div(data-tomo="head", class=sh_class(),
            a(class="font-semibold text-[0.95rem] no-underline text-inherit",
              href="index.html", esc(title))
            nav(data-tomo="i18n", class="relative shrink-0 text-[0.8rem]",
                lang_links(langs.split(","), 0, cur_lang, "../", cur)))
        details(data-tomo="nav", open=true,
                summary(class="hidden max-md:block cursor-pointer py-2"
                              ++ " list-none details-marker:hidden"
                              ++ " text-zinc-500",
                        "☰ " ++ nav_label(cur_lang))
                search_box()
                ol(class="list-none mt-2 p-0", side_items(chs, titles, cur, 0))
                toc_html)
        collapse_script()) ++ "\n"

// The disclosure label, in the reader's language.
nav_label(lang: str) -> str =>
    lang == "ko" ? "목차" : (lang == "ja" ? "目次" : "Contents")

// Collapse the navigation on a narrow viewport. Progressive: the markup ships
// expanded, so a browser with no script still shows the whole thing.
collapse_script() -> str =>
    script("""
(function(){
  var d=document.querySelector('details[data-tomo="nav"]');
  if(d&&window.matchMedia("(max-width:48rem)").matches)
    d.removeAttribute("open");
})();
""") ++ "\n"

side_items(chs: str[], titles: str[], cur: str, i: int) -> str =>
    i >= chs.length()
        ? ""
        : (is_section(chs.get(i))
            ? li(data-tomo="section", class=sec_class(), esc(titles.get(i)))
            : li(class="my-0",
                 a(data-tomo=chs.get(i) == cur ? "current" : "chapter",
                   class=link_class(chs.get(i) == cur),
                   href=chs.get(i) ++ ".html",
                   esc(titles.get(i)))))
          ++ side_items(chs, titles, cur, i + 1)

// The search UI plus the code that drives it. The index is a plain `<script>`
// (not `fetch`) so a built book still searches when opened straight off disk
// as `file://…` — mdBook's search needs a server; this one doesn't.
//
// The markup is markup; only the behaviour is a raw block. That is not tidiness
// — the compiler collects `class=` strings to decide which utility rules to
// generate, and it cannot read inside a raw string. While this whole function
// was one raw block, every class in it named a rule that was never emitted, and
// the search field had no styling at all.
search_box() -> str =>
    input(id="q", type="search", placeholder="search", autocomplete="off",
          class="w-full my-2 px-2 py-1 border border-zinc-200"
                ++ " dark:border-zinc-700 rounded bg-white dark:bg-zinc-900"
                ++ " text-[0.85rem]")
    ++ ul(id="hits", class="list-none m-0 p-0")
    ++ script(src="search-index.js")
    ++ script(hit_styles())
    ++ script(search_js())

// The classes the result list uses, handed to the script as data.
//
// Results are built by JavaScript, so their classes never appear in a `class=`
// attribute for the compiler to find. Naming them here — in ordinary Maca
// strings — is what gets their rules into the stylesheet.
// (`\{` and `\}` — a bare brace would open a string interpolation.)
hit_styles() -> str =>
    "window.TOMO_CLS=\{hit:\"" ++ hit_class() ++ "\",sec:\""
        ++ hit_sec_class() ++ "\",none:\"" ++ hit_none_class() ++ "\"\};"

hit_class() -> str =>
    "block py-1 no-underline text-inherit text-[0.82rem]"

hit_sec_class() -> str =>
    "text-zinc-500 text-[0.75rem]"

hit_none_class() -> str =>
    "text-zinc-500 text-[0.8rem] py-1 block"

search_js() -> str =>
    """(function(){
  var q=document.getElementById("q"),hits=document.getElementById("hits");
  if(!q) return;
  var C=window.TOMO_CLS||{hit:"",sec:"",none:""};
  function esc(s){return s.replace(/[&<>"]/g,function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c];});}
  q.addEventListener("input",function(){
    var t=q.value.trim().toLowerCase();
    hits.innerHTML="";
    if(t.length<2) return;
    var idx=window.TOMO_INDEX||[],out=[],i;
    for(i=0;i<idx.length&&out.length<12;i++){
      var e=idx[i];
      if(e.s.toLowerCase().indexOf(t)>=0||e.x.indexOf(t)>=0) out.push(e);
    }
    if(!out.length){
      hits.innerHTML='<li><span class="'+C.none+'">no matches</span></li>';
      return;
    }
    hits.innerHTML=out.map(function(e){
      return '<li><a class="'+C.hit+'" href="'+esc(e.u)+'">'+esc(e.s)+
             '<br><span class="'+C.sec+'">'+esc(e.c)+'</span></a></li>';
    }).join("");
  });
})();
"""

// Wrap rendered chapter HTML in a page with the stylesheet, a language
// switcher and the sidebar. `langs` is a comma-joined list of codes
// (e.g. "en,ko"); `cur` is the active one.
page(title: str, cur: str, langs: str, side: str, body: str) -> str =>
    shell(title, cur, langs, side, body, "../")

// `up` is the path back to the languages' shared parent: "../" from inside a
// language directory, "" from the root page, which sits above them. Getting it
// wrong sends the switcher out of the site entirely.
shell(title: str, cur: str, langs: str, side: str, body: str,
      up: str) -> str =>
    "<!doctype html>\n"
        ++ html(lang=cur,
            head(
                meta(charset="utf-8")
                meta(name="viewport",
                     content="width=device-width,initial-scale=1")
                title_tag(esc(title))
                stylesheet()
            )
            body_tag(class=body_class(),
                div(class=side.length() == 0 ? solo_class() : wrap_class(),
                    side ++ main_landmark(body)
                )
            )
        ) ++ "\n"

// `title` and `body` are taken by parameters all over this file, and `main` is
// the entry point, so the three tags that collide get a suffixed wrapper. The
// backend resolves a user definition ahead of a tag, which is what makes these
// necessary — and what stops every `label(...)` in every program from silently
// becoming markup.
title_tag(text: str) -> str =>
    title(text)

body_tag(class: str, inner: str) -> str =>
    body(class=class, inner)

// The page's own typography and colours, on the element that owns them.
body_class() -> str =>
    "font-serif text-base leading-relaxed bg-white dark:bg-zinc-900"
        ++ " text-zinc-900 dark:text-zinc-100"

// `<code>` inside a `<pre>` must not repeat the block's background or padding.
pre_code_class() -> str =>
    "bg-transparent p-0 text-[0.88em]"

// `<main>` is the one tag no program can write as a call, because every program
// defines `main` and a user definition wins. `element` takes its tag as a
// value, so it reaches the tag the call syntax cannot.
main_landmark(inner: str) -> str =>
    element("main", inner)

// The language picker: a disclosure, not a `<select>`.
//
// A `<select>` cannot navigate without script, and this is the one control a
// reader who landed on the wrong language most needs to work. A `<details>`
// holding real links needs no script at all, keeps every language a crawlable
// `<a href>`, and still behaves like a dropdown.
//
// `page` is the chapter to land on — the one being read, not the book's index.
// Switching language should keep your place; sending a reader on chapter 8 back
// to the table of contents makes them find it again. The fallback guarantees
// that page exists in every language even when it isn't translated yet.
lang_links(codes: str[], i: int, cur: str, up: str, page: str) -> str =>
    codes.length() < 2
        ? ""
        : details(data-tomo="lang",
                  summary(class=lang_summary_class(), lang_name(cur) ++ " ▾")
                  ul(class=lang_menu_class(),
                     lang_options(codes, 0, cur, up, page)))

lang_options(codes: str[], i: int, cur: str, up: str, page: str) -> str =>
    i >= codes.length()
        ? ""
        : li(class="my-0",
             a(class=link_class(codes.get(i) == cur),
               href=up ++ codes.get(i) ++ "/" ++ target_page(page),
               lang=codes.get(i),
               lang_name(codes.get(i))))
          ++ lang_options(codes, i + 1, cur, up, page)

// Always a file, never a bare directory: a `…/ko/` URL only resolves to
// `index.html` when a web server does it. Opened off disk — which this book
// supports — the browser shows a directory listing instead.
target_page(page: str) -> str =>
    page.length() == 0 ? "index.html" : page ++ ".html"

// ---- the book builder -----------------------------------------------------

// The value of a `key = value` entry, unquoted. An array value may span lines
// (`chapters = [\n  "a",\n  "b",\n]`), so once a `[` opens, lines are gathered
// until the closing `]`. Returns "" when `key` is absent.
conf_value(toml: str, key: str) -> str =>
    conf_scan(toml.split("\n"), 0, key)

conf_scan(lines: str[], i: int, key: str) -> str =>
    i >= lines.length()
        ? ""
        : lines.get(i).trim().starts_with(key ++ " =")
            ? unquote(conf_gather(lines, i, rest_of(lines.get(i))))
            : conf_scan(lines, i + 1, key)

// The text after `=` on a `key = value` line.
rest_of(line: str) -> str =>
    line.substr(line.index_of("=") + 1, line.length()).trim()

// If the value opened a `[` that this line doesn't close, keep appending
// following lines until the `]` arrives.
conf_gather(lines: str[], i: int, acc: str) -> str =>
    !acc.starts_with("[") || acc.contains("]") || i + 1 >= lines.length()
        ? acc
        : conf_gather(lines, i + 1, acc ++ lines.get(i + 1).trim())

// Drop the `[` `]` wrapper, quotes, and a trailing comma so both
// `title = "X"` and a multi-line `["a", "b",]` yield usable text.
unquote(v: str) -> str {
    bare = v.replace("[", "").replace("]", "").replace("\"", "").trim()
    bare.ends_with(",") ? bare.substr(0, bare.length() - 1) : bare
}

// Build the whole book: for each language, render every chapter to
// `<out>/<lang>/<chapter>.html`. A chapter missing in a non-default language
// falls back to the default language's file, so a partial translation still
// produces a complete book. Returns the number of pages written.
build_book(root: str, out: str) -> int {
    toml = read_file(root ++ "/book.toml")
    title = conf_value(toml, "title")
    langs = conf_value(toml, "languages").replace(" ", "")
    // not `.replace(" ", "")` — a section label is prose and keeps its spaces
    chs = conf_value(toml, "chapters").split(",").map(v => v.trim())
    n = build_langs(root, out, title, langs, langs.split(","), 0, chs, 0)
    n + write_root(out, title, langs, conf_value(toml, "playground"))
}

// ---- the root entry point -------------------------------------------------

// One page above the languages, so `/` is a real destination rather than a
// directory listing. A multi-language book cannot pick a default for the reader
// — a Korean speaker landing on English is the same failure as the reverse — so
// this asks instead of redirecting.
//
// `play` is an optional `playground = "…"` in book.toml: a sibling link carried
// through when the book is published beside something else.
write_root(out: str, title: str, langs: str, play: str) -> int {
    make_dir(out)
    body = h1(class=md_class("h1"), esc(title)) ++ "\n"
           ++ nav(class="toc",
                  "\n" ++ ul(class="list-none p-0",
                             "\n" ++ root_links(langs.split(","), 0)
                                  ++ play_link(play)) ++ "\n") ++ "\n"
    write_file(out ++ "/index.html",
               shell(title, langs.split(",").get(0), langs, "", body, ""))
    1
}

// The optional sibling link, absent when `book.toml` names no playground.
play_link(play: str) -> str =>
    play.length() == 0
        ? ""
        : li(class="my-1", a(href=play, "Playground")) ++ "\n"

root_links(codes: str[], i: int) -> str =>
    i >= codes.length()
        ? ""
        : li(class="my-1",
             a(href=codes.get(i) ++ "/index.html", lang=codes.get(i),
               lang_name(codes.get(i))))
          ++ root_links(codes, i + 1)

// A language's own name for itself — a reader looking for their language should
// see it written the way they write it, not as an ISO code.
lang_name(code: str) -> str =>
    code == "en"
        ? "English"
        : (code == "ko"
            ? "한국어"
            : (code == "ja" ? "日本語" : (code == "es" ? "Español" : code)))

// Outer loop: one language at a time.
build_langs(root: str, out: str, title: str, langs: str, codes: str[],
            li: int, chs: str[], acc: int) -> int =>
    li >= codes.length()
        ? acc
        : build_langs(root, out, title, langs, codes, li + 1, chs,
                      acc + build_lang(root, out, title, langs,
                                       codes.get(li), codes.get(0), chs))

// One language: its chapter titles (resolved once, since the sidebar on every
// page needs all of them), then its chapters, search index and index page.
build_lang(root: str, out: str, title: str, langs: str, lang: str,
           fallback: str, chs: str[]) -> int {
    titles = chapter_titles(root, langs, lang, fallback, chs, 0)
    n = build_chapters(root, out, title, langs, lang, fallback, chs, titles,
                       0, 0)
    write_search_index(root, out, lang, fallback, chs, titles)
    n + write_index(root, out, title, langs, lang, chs, titles)
}

// Every entry's display title, in book order — a chapter's from its own
// `# heading`, a section's from its `|`-separated label.
chapter_titles(root: str, langs: str, lang: str, fallback: str, chs: str[],
               i: int) -> str[] =>
    i >= chs.length()
        ? []
        : [entry_title(root, langs, lang, fallback, chs.get(i))]
              ++ chapter_titles(root, langs, lang, fallback, chs, i + 1)

entry_title(root: str, langs: str, lang: str, fallback: str, e: str) -> str =>
    is_section(e)
        ? section_title(e, langs, lang)
        : chapter_title(root, lang, fallback, e)

// The book's entry point: a table of contents linking every chapter, titled by
// each chapter's own `# heading` (taken from the translation in use, so an
// index in Korean lists Korean titles and falls back with the chapter).
write_index(root: str, out: str, title: str, langs: str, lang: str,
            chs: str[], titles: str[]) -> int {
    dir = out ++ "/" ++ lang
    make_dir(dir)
    body = h1(class=md_class("h1"), esc(title))
           ++ nav(ol(class="list-none p-0",
                     "\n" ++ index_items(chs, titles, 0))) ++ "\n"
    side = sidebar(title, langs, lang, chs, titles, "", "")
    write_file(dir ++ "/index.html", page(title, lang, langs, side, body))
    1
}

index_items(chs: str[], titles: str[], i: int) -> str =>
    i >= chs.length()
        ? ""
        : (is_section(chs.get(i))
            ? li(data-tomo="section", class=sec_class(), esc(titles.get(i)))
            : li(class="my-0",
                 a(class=link_class(false), href=chs.get(i) ++ ".html",
                   esc(titles.get(i)))))
          ++ index_items(chs, titles, i + 1)

// ---- search index ---------------------------------------------------------

// One entry per heading, holding that section's text lowercased. Emitted as a
// `<script>` that assigns `window.TOMO_INDEX`, not as JSON the page fetches,
// so search still works when the book is opened straight off disk.
write_search_index(root: str, out: str, lang: str, fallback: str, chs: str[],
                   titles: str[]) -> int {
    dir = out ++ "/" ++ lang
    make_dir(dir)
    body = index_chapters(root, lang, fallback, chs, titles, 0)
    write_file(dir ++ "/search-index.js",
               "window.TOMO_INDEX=[" ++ body ++ "];\n")
    0
}

index_chapters(root: str, lang: str, fallback: str, chs: str[], titles: str[],
               i: int) -> str =>
    i >= chs.length()
        ? ""
        : index_chapter(root, lang, fallback, chs.get(i), titles.get(i))
              ++ index_chapters(root, lang, fallback, chs, titles, i + 1)

index_chapter(root: str, lang: str, fallback: str, ch: str,
              ctitle: str) -> str {
    own = is_section(ch)
        ? ""
        : root ++ "/book/" ++ lang ++ "/" ++ ch ++ ".md"
    src = file_exists(own)
        ? own
        : (is_section(ch)
            ? ""
            : root ++ "/book/" ++ fallback ++ "/" ++ ch ++ ".md")
    file_exists(src)
        ? sections(read_file(src).split("\n"), 0, ch ++ ".html", ctitle,
                   "", "", "")
        : ""
}

// Walk the lines, flushing an entry whenever a new heading starts.
sections(lines: str[], i: int, url: str, ctitle: str, head: str, buf: str,
         acc: str) -> str =>
    i >= lines.length()
        ? acc ++ entry(url, ctitle, head, buf)
        : (head_text(lines.get(i)).length() > 0
            ? sections(lines, i + 1, url, ctitle, head_text(lines.get(i)), "",
                       acc ++ entry(url, ctitle, head, buf))
            : sections(lines, i + 1, url, ctitle, head,
                       buf ++ " " ++ lines.get(i), acc))

head_text(line: str) -> str =>
    line.starts_with("### ")
        ? line.substr(4, line.length() - 4)
        : (line.starts_with("## ")
            ? line.substr(3, line.length() - 3)
            : (line.starts_with("# ")
                ? line.substr(2, line.length() - 2)
                : ""))

// Text before the first heading belongs to no section, so it is dropped.
entry(url: str, ctitle: str, head: str, buf: str) -> str =>
    head.length() == 0
        ? ""
        : "\{\"u\":" ++ jstr(url ++ "#" ++ slug(head)) ++ ",\"c\":"
              ++ jstr(ctitle) ++ ",\"s\":" ++ jstr(head) ++ ",\"x\":"
              ++ jstr(buf.lower()) ++ "\},"

// A JSON string literal. Backslash first, so it doesn't escape its own escapes.
jstr(s: str) -> str =>
    "\"" ++ s.replace("\\", "\\\\").replace("\"", "\\\"") ++ "\""

// A chapter's display title: its first `# ` heading, else the file stem.
chapter_title(root: str, lang: str, fallback: str, ch: str) -> str {
    own = root ++ "/book/" ++ lang ++ "/" ++ ch ++ ".md"
    src = file_exists(own) ? own : root ++ "/book/" ++ fallback ++ "/" ++ ch ++ ".md"
    file_exists(src) ? first_heading(read_file(src).split("\n"), 0, ch) : ch
}

first_heading(lines: str[], i: int, fallback: str) -> str =>
    i >= lines.length()
        ? fallback
        : lines.get(i).starts_with("# ")
            ? lines.get(i).substr(2, lines.get(i).length() - 2)
            : first_heading(lines, i + 1, fallback)

// Inner loop: one chapter at a time, for a single language.
build_chapters(root: str, out: str, title: str, langs: str, lang: str,
               fallback: str, chs: str[], titles: str[], ci: int,
               acc: int) -> int =>
    ci >= chs.length()
        ? acc
        : build_chapters(root, out, title, langs, lang, fallback, chs, titles,
                         ci + 1,
                         acc + build_chapter(root, out, title, langs, lang,
                                             fallback, chs, titles, ci))

// Render one chapter. Falls back to the default language when the translation
// is missing; writes nothing (and counts nothing) if neither exists.
build_chapter(root: str, out: str, title: str, langs: str, lang: str,
              fallback: str, chs: str[], titles: str[], ci: int) -> int {
    ch = chs.get(ci)
    own = is_section(ch)
        ? ""
        : root ++ "/book/" ++ lang ++ "/" ++ ch ++ ".md"
    src = file_exists(own)
        ? own
        : (is_section(ch)
            ? ""
            : root ++ "/book/" ++ fallback ++ "/" ++ ch ++ ".md")
    file_exists(src)
        ? write_chapter(out, title, langs, lang, chs, titles, ci,
                        read_file(src))
        : 0
}

write_chapter(out: str, title: str, langs: str, lang: str, chs: str[],
              titles: str[], ci: int, md: str) -> int {
    dir = out ++ "/" ++ lang
    make_dir(dir)
    body = article("\n" ++ render(md)) ++ "\n" ++ chapter_nav(chs, ci)
    side = sidebar(title, langs, lang, chs, titles, chs.get(ci), toc(md))
    write_file(dir ++ "/" ++ chs.get(ci) ++ ".html",
               page(title, lang, langs, side, body))
    1
}

// ---- self-check -----------------------------------------------------------

main() -> int {
    sample = "# Title\n\nA **bold** word and `code`, see [docs](guide.md).\n\n"
        ++ "An `int[]` is a list, and [two](a.md) [links](b.md) both work.\n\n"
        ++ "## Is it fast?\n\n- one\n  - nested\n- two\n\n1. first\n2. second\n\n"
        ++ "| target | flag |\n|--------|------|\n| native | `--target c` |\n\n"
        ++ "> a quoted aside that\n> wraps across two source lines\n\n"
        ++ "```maca\nx = 1\n```\n"
    html = render(sample)
    info("=== rendered ===")
    info(html)
    info("=== toc ===")
    info(toc(sample))
    info("=== page ===")
    demo = sidebar("Maca Handbook", "en,ko", "en", ["a", "b"], ["One", "Two"],
                   "a", toc(sample))
    info(page("Maca Handbook", "en", "en,ko", demo, article("hi")))

    // Build the real book from this repository into `site/`.
    info("=== build ===")
    pages = build_book("apps/tomo", "apps/tomo/site")
    info("built {pages} pages")
    0
}
