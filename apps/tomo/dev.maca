import { Dev, Parts, parts_of, page_key, region_key, chapter_page,
         write_chapter, chapter_source, chapter_titles, volume_titles,
         side_items, write_search_index, write_index,
         write_root } from apps/tomo/tomo
import { conf_value } from apps/tomo/conf
import { Store, store, set, get, changed, touched,
         clear_changed } from signal/store
import { patch, patch_json } from signal/dom
import { Feed, feed, publish, generation, is_poll, answer,
         dev_head } from http/dev
import { listen } from http/server
import { Request } from http/request
import { Response } from http/response
import { serve_file } from http/serve

/** Everything about the book that one round needs and no round changes. */
Book = {
    root:  str,
    out:   str,
    title: str,
    site:  str,
    langs: str,
    chs:   str[],
}

Budget = 25000

Interval = 300

main(args: str[]) -> int => serve(args)

/** Serve the book and keep an open page in step with `book/`. */
serve(args: str[]) -> int {
    port = args.length() > 0 ? int(args.get(0)) : 8000
    work = args.length() > 1 ? args.get(1) : ".maca/dev/tomo"
    root = args.length() > 2 ? args.get(2) : "apps/tomo"

    if !is_dir(root + "/book") {
        err("no book at {root}/book: run this from the repository root")
        1
    } else {
        out = site_dir(work)
        make_dir(out)
        info("tomo dev on http://localhost:{port}/ (work in {work})")
        spawn host(port, work)
        watch(book_at(root, out), feed(hmr_dir(work)))
    }
}

book_at(root: str, out: str) -> Book {
    toml = read_file(root + "/book.toml")
    title = conf_value(toml, "title")

    Book {
        root = root,
        out = out,
        title = title,
        site = conf_value(toml, "site") == ""
            ? title
            : conf_value(toml, "site"),
        langs = conf_value(toml, "languages").replace(" ", ""),
        chs = conf_value(toml, "chapters").split(",").map(v => v.trim()),
    }
}

host(port: int, work: str) -> int {
    f = feed(hmr_dir(work))
    listen(port, req => reply(f, site_dir(work), req))
}

/** The two directories a dev session owns. */
site_dir(work: str) -> str => work + "/site"

hmr_dir(work: str) -> str => work + "/hmr"

reply(f: Feed, out: str, req: Request) -> Response {
    if is_poll(req) {
        answer(f, req, Budget)
    } else {
        serve_file(out, req)
    }
}

watch(b: Book, f: Feed) -> int {
    srcs = store()
    regions = store()
    gen = generation(f)
    primed = false

    while true {
        srcs = read_sources(b, srcs)

        if changed(srcs).length() > 0 {
            regions = rebuild(b, regions, srcs)

            if primed {
                gen = gen + 1

                if publish(f, gen, patch_json(regions)) {
                    info(regions_patched(patch(regions).length()) +
                         " (generation {gen})")
                } else {
                    err("could not publish generation {gen} into {f.dir}:" +
                        " an open page will reload on the next save")
                }
            } else {
                info("built {b.chs.length()} entries per language")
            }

            primed = true
            srcs = clear_changed(srcs)
            regions = clear_changed(regions)
        }

        sleep_ms(Interval)
    }

    0
}

regions_patched(n: int) -> str =>
    n == 1 ? "1 region patched" : "{n} regions patched"

read_sources(b: Book, srcs: Store) -> Store =>
    read_langs(b, srcs.set("src:book.toml",
                           read_file(b.root + "/book.toml")),
               b.langs.split(","), 0)

read_langs(b: Book, srcs: Store, codes: str[], li: int) -> Store {
    if li >= codes.length() {
        srcs
    } else {
        one = read_chapters(b, srcs, codes.get(0), codes.get(li), 0)
        read_langs(b, one, codes, li + 1)
    }
}

read_chapters(b: Book, srcs: Store, fallback: str, lang: str,
              ci: int) -> Store {
    if ci >= b.chs.length() {
        read_one(b, srcs, fallback, lang, "home")
    } else {
        one = read_one(b, srcs, fallback, lang, b.chs.get(ci))
        read_chapters(b, one, fallback, lang, ci + 1)
    }
}

read_one(b: Book, srcs: Store, fallback: str, lang: str, ch: str) -> Store {
    src = chapter_source(b.root, lang, fallback, ch)

    if src == "" || !file_exists(src) {
        srcs
    } else {
        srcs.set("src:" + page_key(lang, ch), read_file(src))
    }
}

rebuild(b: Book, regions: Store, srcs: Store) -> Store {
    codes = b.langs.split(",")
    out = rebuild_langs(b, regions, srcs, codes, 0)
    write_root(b.root, b.out, b.site, b.langs)
    out
}

rebuild_langs(b: Book, regions: Store, srcs: Store, codes: str[],
              li: int) -> Store {
    if li >= codes.length() {
        regions
    } else {
        one = rebuild_lang(b, regions, srcs, codes.get(li), codes.get(0))
        rebuild_langs(b, one, srcs, codes, li + 1)
    }
}

rebuild_lang(b: Book, regions: Store, srcs: Store, lang: str,
             fallback: str) -> Store {
    titles = chapter_titles(b.root, b.langs, lang, fallback, b.chs, 0)
    fresh = render_pages(b, regions, srcs, lang, fallback, titles, 0)

    write_pages(b, fresh, lang, fallback, titles, 0)
    write_search_index(b.root, b.out, lang, fallback, b.chs, titles,
                       volume_titles(b.chs, titles, 0, ""))
    write_index(b.root, b.out, b.title, b.langs, lang, b.chs, titles)
    fresh
}

render_pages(b: Book, regions: Store, srcs: Store, lang: str, fallback: str,
             titles: str[], ci: int) -> Store {
    if ci >= b.chs.length() {
        regions
    } else {
        one = render_page(b, regions, srcs, lang, fallback, titles, ci)
        render_pages(b, one, srcs, lang, fallback, titles, ci + 1)
    }
}

render_page(b: Book, regions: Store, srcs: Store, lang: str, fallback: str,
            titles: str[], ci: int) -> Store {
    ch = b.chs.get(ci)
    key = page_key(lang, ch)
    src = chapter_source(b.root, lang, fallback, ch)

    if src == "" || !file_exists(src) {
        regions
    } else {
        navs = regions.set(region_key("nav", key),
                           side_items(b.chs, titles, ch, 0))

        if !touched(srcs, "src:" + key) && !touched(srcs, "src:book.toml") {
            navs
        } else {
            p = parts_of(b.chs, titles, ci, read_file(src))
            navs.set(region_key("article", key), p.article)
                .set(region_key("toc", key), p.toc)
        }
    }
}

write_pages(b: Book, regions: Store, lang: str, fallback: str, titles: str[],
            ci: int) -> int {
    if ci >= b.chs.length() {
        0
    } else {
        write_one(b, regions, lang, fallback, titles, ci) +
            write_pages(b, regions, lang, fallback, titles, ci + 1)
    }
}

write_one(b: Book, regions: Store, lang: str, fallback: str, titles: str[],
          ci: int) -> int {
    ch = b.chs.get(ci)
    src = chapter_source(b.root, lang, fallback, ch)

    if src == "" || !file_exists(src) {
        0
    } else {
        write_chapter(developing(), b.out, b.title, b.langs, lang, b.chs,
                      titles, ci, parts_from(regions, lang, ch))
    }
}

/** Dev mode on: regions marked, and the patcher plus its poll loop in the head.
 */
developing() -> Dev => Dev { on = true, extra = dev_head() }

/** One page's `Parts`, read back out of the store the last render left them in.
 */
parts_from(regions: Store, lang: str, ch: str) -> Parts {
    key = page_key(lang, ch)

    Parts {
        article = regions.get(region_key("article", key)),
        toc = regions.get(region_key("toc", key)),
        nav = regions.get(region_key("nav", key)),
    }
}
