import std/fs
import std/path
import std/text
import apps/site/shell
import { highlight, code_css } from apps/tomo/highlight
import std/list
import { command, arg, rest } from cli/spec
import { parse, value, from } from cli/parse
import { help } from cli/help
import { bold, dim, ok, bad } from cli/style

Item = {
    kind: str
    name: str
    sig:  str
    line: int
    doc:  str[]
}

Module = {
    path:  str
    name:  str
    blurb: str[]
    items: Item[]
}

read_module(p: str) -> Module {
    if !file_exists(p) {
        fail "no such module: {p}"
    }

    lines = read_lines(p)
    items = scan(lines, 0, [], [])

    if items.length() == 0 {
        fail "{p} documents nothing. Is every item missing its `///` block?"
    }

    require_distinct_items(p, items, 0)

    Module {
        path = p,
        name = stem(p),
        blurb = module_blurb(lines, 0, []),
        items = items
    }
}

require_distinct_items(p: str, items: Item[], i: int) -> bool {
    if i >= items.length() {
        true
    } else if item_taken(items, 0, i) {
        fail "{p} documents {items.get(i).name} twice"
    } else {
        require_distinct_items(p, items, i + 1)
    }
}

item_taken(items: Item[], i: int, before: int) -> bool {
    if i >= before {
        false
    } else if items.get(i).name == items.get(before).name {
        true
    } else {
        item_taken(items, i + 1, before)
    }
}

module_blurb(lines: str[], i: int, acc: str[]) -> str[] {
    if i >= lines.length() || !is_plain_comment(lines.get(i)) {
        acc
    } else {
        module_blurb(lines, i + 1, acc ++ [comment_body(lines.get(i))])
    }
}

is_doc(line: str) -> bool =>
    line.starts_with("///") && !line.starts_with("////")

is_plain_comment(line: str) -> bool =>
    line.starts_with("//") && !is_doc(line)

comment_body(line: str) -> str {
    body = drop_slashes(line, 0)

    if body.starts_with(" ") {
        body.slice(1, body.length())
    } else {
        body
    }
}

drop_slashes(line: str, i: int) -> str {
    if i < line.length() && line.at(i) == "/" {
        drop_slashes(line, i + 1)
    } else {
        line.slice(i, line.length())
    }
}

scan(lines: str[], i: int, doc: str[], acc: Item[]) -> Item[] {
    if i >= lines.length() {
        warn_orphan(doc, i)
        acc
    } else if is_doc(lines.get(i)) {
        scan(lines, i + 1, doc ++ [comment_body(lines.get(i))], acc)
    } else if doc.length() == 0 {
        scan(lines, i + 1, [], acc)
    } else if !is_decl(lines.get(i)) {
        warn_orphan(doc, i)
        scan(lines, i + 1, [], acc)
    } else {
        scan(lines, i + 1, [], acc ++ [declared(lines, i, doc)])
    }
}

warn_orphan(doc: str[], at: int) -> bool {
    if doc.length() == 0 {
        true
    } else {
        warn("line {at + 1}: doc comment attached to nothing: {doc.get(0)}")
        false
    }
}

is_decl(line: str) -> bool =>
    is_fn(line) || is_binding(line)

declared(lines: str[], i: int, doc: str[]) -> Item {
    line = lines.get(i)
    at = i + 1

    if is_fn(line) {
        Item { kind = "fn", name = before(line, "("),
               sig = signature(lines, i), line = at, doc = doc }
    } else if rhs(line).starts_with("\{") {
        Item { kind = "record", name = before(line, " ="),
               sig = record_sig(lines, i), line = at, doc = doc }
    } else if is_union(rhs(line)) {
        Item { kind = "sum", name = before(line, " ="), sig = line.trim(),
               line = at, doc = doc }
    } else {
        Item { kind = "const", name = before(line, " ="),
               sig = line.trim(), line = at, doc = doc }
    }
}

is_union(r: str) -> bool {
    parts = split_top(r, 0, 0, false, "", [])

    parts.length() > 1 && all_variants(parts, 0)
}

split_top(r: str, i: int, depth: int, in_str: bool, cur: str,
          acc: str[]) -> str[] {
    if i >= r.length() {
        acc.push(cur)
    } else {
        c = r.at(i)

        if c == "\"" {
            split_top(r, i + 1, depth, !in_str, cur ++ c, acc)
        } else if in_str {
            split_top(r, i + 1, depth, in_str, cur ++ c, acc)
        } else if c == "(" {
            split_top(r, i + 1, depth + 1, in_str, cur ++ c, acc)
        } else if c == ")" {
            split_top(r, i + 1, depth - 1, in_str, cur ++ c, acc)
        } else if c == "|" && depth == 0 {
            split_top(r, i + 1, depth, in_str, "", acc.push(cur))
        } else {
            split_top(r, i + 1, depth, in_str, cur ++ c, acc)
        }
    }
}

all_variants(parts: str[], i: int) -> bool {
    if i >= parts.length() {
        true
    } else if is_variant_name(parts.get(i).trim()) {
        all_variants(parts, i + 1)
    } else {
        false
    }
}

is_variant_name(p: str) -> bool {
    head = p.contains("(") ? before(p, "(") : p

    head.length() > 0 && !is_lower(head.at(0)) && is_ident(head.trim())
}

is_fn(line: str) -> bool {
    if line.starts_with(" ") || !line.contains("(") {
        false
    } else {
        head = before(line, "(")
        head.length() > 0 && is_lower(head.at(0)) && is_ident(head)
    }
}

is_binding(line: str) -> bool {
    if line.starts_with(" ") || !line.contains(" = ") {
        false
    } else {
        head = before(line, " =")
        head.length() > 0 && !is_lower(head.at(0)) && is_ident(head)
    }
}

is_lower(c: str) -> bool =>
    c.is_alpha() && c.lower() == c

is_ident(s: str) -> bool =>
    all_chars_ident(s.chars(), 0)

all_chars_ident(cs: str[], i: int) -> bool {
    if i >= cs.length() {
        true
    } else if cs.get(i).is_alpha() || cs.get(i).is_ascii_digit() {
        all_chars_ident(cs, i + 1)
    } else if cs.get(i) == "_" {
        all_chars_ident(cs, i + 1)
    } else {
        false
    }
}

before(s: str, sep: str) -> str {
    at = s.index_of(sep)

    if at < 0 {
        s.trim()
    } else {
        s.slice(0, at).trim()
    }
}

rhs(line: str) -> str {
    at = line.index_of(" = ")

    if at < 0 {
        ""
    } else {
        line.slice(at + 3, line.length())
    }
}

signature(lines: str[], i: int) -> str =>
    cut_body(whole_head(lines, i, ""))

whole_head(lines: str[], i: int, acc: str) -> str {
    if i >= lines.length() {
        acc
    } else {
        so_far = appended(acc, lines.get(i))

        if paren_depth(so_far.chars(), 0, 0) > 0 {
            whole_head(lines, i + 1, so_far)
        } else {
            so_far
        }
    }
}

appended(acc: str, line: str) -> str {
    if acc == "" {
        line.trim()
    } else {
        acc ++ " " ++ line.trim()
    }
}

paren_depth(cs: str[], i: int, n: int) -> int {
    if i >= cs.length() {
        n
    } else if cs.get(i) == "(" {
        paren_depth(cs, i + 1, n + 1)
    } else if cs.get(i) == ")" {
        paren_depth(cs, i + 1, n - 1)
    } else {
        paren_depth(cs, i + 1, n)
    }
}

cut_body(head: str) -> str {
    cut = first_of(head.index_of("=>"), head.index_of("\{"))

    if cut < 0 {
        head
    } else {
        head.slice(0, cut).trim()
    }
}

first_of(a: int, b: int) -> int {
    if a < 0 {
        b
    } else if b < 0 {
        a
    } else if a < b {
        a
    } else {
        b
    }
}

record_sig(lines: str[], i: int) -> str {
    if lines.get(i).trim().ends_with("\}") {
        lines.get(i).trim()
    } else {
        gather(lines, i, i + 1)
    }
}

gather(lines: str[], from: int, i: int) -> str {
    if i >= lines.length() || lines.get(i).trim() == "\}" {
        lines.slice(from, i + 1).join("\n")
    } else {
        gather(lines, from, i + 1)
    }
}

prose(ls: str[]) -> str =>
    blocks(ls, 0, [], "")

blocks(ls: str[], i: int, cur: str[], out: str) -> str {
    if i >= ls.length() {
        out ++ block(cur)
    } else if is_fence(ls.get(i)) {
        stop = fence_end(ls, i + 1)
        fenced = code_block(fence_tag(ls.get(i)),
                            ls.slice(i + 1, stop).join("\n"))
        blocks(ls, stop + 1, [], out ++ block(cur) ++ fenced)
    } else if ls.get(i).trim() == "" {
        blocks(ls, i + 1, [], out ++ block(cur))
    } else {
        blocks(ls, i + 1, cur ++ [ls.get(i)], out)
    }
}

block(ls: str[]) -> str {
    if ls.length() == 0 {
        ""
    } else if ls.get(0).starts_with(" ") {
        code_block("maca", dedent(ls.join("\n")))
    } else {
        p(class=ProseClass, inline(ls.join(" ")))
    }
}

code_block(lang: str, src: str) -> str =>
    pre(class=PreClass, code(class=Mono, highlight(lang, src)))

is_fence(line: str) -> bool =>
    line.trim().starts_with("```")

fence_end(ls: str[], i: int) -> int {
    if i >= ls.length() || is_fence(ls.get(i)) {
        i
    } else {
        fence_end(ls, i + 1)
    }
}

fence_tag(line: str) -> str {
    t = line.trim()
    tag = t.slice(3, t.length()).trim()

    if tag == "" {
        "maca"
    } else {
        tag
    }
}

inline(s: str) -> str =>
    spans(paired(s.split("`"), "`"), 0, "")

spans(parts: str[], i: int, out: str) -> str {
    if i >= parts.length() {
        out
    } else if i % 2 == 1 {
        span = code(class=CodeSpan, escape_html(parts.get(i)))
        spans(parts, i + 1, out ++ span)
    } else {
        starred = paired(parts.get(i).split("*"), "*")
        spans(parts, i + 1, out ++ emphasis(starred, 0, ""))
    }
}

emphasis(parts: str[], i: int, out: str) -> str {
    if i >= parts.length() {
        out
    } else if i % 2 == 0 {
        emphasis(parts, i + 1, out ++ escape_html(parts.get(i)))
    } else if is_emphasis(parts.get(i)) {
        emphasis(parts, i + 1, out ++ em(escape_html(parts.get(i))))
    } else {
        emphasis(parts, i + 1, out ++ "*" ++ escape_html(parts.get(i)) ++ "*")
    }
}

is_emphasis(body: str) -> bool =>
    body != "" && !body.starts_with(" ") && !body.ends_with(" ")

paired(parts: str[], sep: str) -> str[] {
    if parts.length() % 2 == 1 {
        parts
    } else {
        n = parts.length()
        str_take(parts, n - 2)
            .push(parts.get(n - 2) ++ sep ++ parts.get(n - 1))
    }
}

Wrap = "max-w-[78rem] mx-auto px-6"

Shell = "grid grid-cols-[16rem_minmax(0,52rem)] gap-10 justify-center px-6"
    ++ " py-10 max-md:block max-md:max-w-[52rem] max-md:mx-auto max-md:px-5"

PreClass = "mt-3 bg-zinc-50 dark:bg-zinc-900 border"
    ++ " border-zinc-200 dark:border-zinc-800 p-4 overflow-x-auto"
    ++ " text-[0.85rem] m-0"

SigClass = "mt-3 bg-zinc-50 dark:bg-zinc-900 border"
    ++ " border-zinc-200 dark:border-zinc-800 px-4 py-3 overflow-x-auto"
    ++ " text-[0.9rem] m-0"

ProseClass = "mt-3 text-[0.95rem] leading-relaxed text-zinc-600"
    ++ " dark:text-zinc-400 m-0"

Measure = "max-w-[42rem]"

Stack = "grid grid-cols-1"

page(title: str, side: str, body: str) -> str =>
    "<!doctype html>\n"
        ++ html(lang="en",
            head(
                meta(charset="utf-8")
                meta(name="viewport",
                     content="width=device-width,initial-scale=1")
                title_tag(title)
                font_link("../")
                style(base_css() ++ code_css() ++ doc_css() ++ styles())
            )
            body_tag(page_class("font-sans"),
                top_bar(title)
                    ++ div(class=Shell, side ++ element("main", body))
                    ++ hover_card()
                    ++ nav_script()))
        ++ "\n"

top_bar(title: str) -> str =>
    header(class="sticky top-0 z-40 bg-white dark:bg-zinc-950 border-b"
                 ++ " border-zinc-200 dark:border-zinc-800",
        div(class=Wrap ++ " flex flex-wrap items-center justify-between"
                  ++ " gap-x-4 gap-y-2 py-3",
            nav(aria-label="Reference",
                class="flex items-center gap-2 text-[0.9rem]",
                a(class="font-bold no-underline text-inherit focus:underline",
                  href="../index.html", "Maca")
                span(class="text-zinc-300 dark:text-zinc-700", "/")
                a(class="no-underline text-zinc-600 dark:text-zinc-400"
                        ++ " hover:text-black dark:hover:text-white"
                        ++ " focus:underline",
                  href="index.html", "API reference"))
            span(class="text-[0.85rem] text-zinc-500"
                       ++ " dark:text-zinc-400",
                 escape_html(title))))

hover_card() -> str =>
    div(id="macadoc-card", hidden=true,
        class="absolute z-50 max-w-[26rem] pointer-events-none"
              ++ " border border-zinc-200 dark:border-zinc-700"
              ++ " bg-white dark:bg-zinc-900 p-3",
        pre(class="m-0 overflow-x-auto text-[0.8rem]",
            code(class=Mono, ""))
        p(class="mt-2 mb-0 text-[0.8rem] text-zinc-600 dark:text-zinc-400",
          ""))

index_page(ms: Module[]) -> str =>
    page("API reference", sidebar(ms, ""),
         section(class="py-2",
             p(class="text-[0.75rem] uppercase tracking-widest text-zinc-500"
                     ++ " dark:text-zinc-400 m-0",
               "Reference")
             h1(class="mt-1 font-bold text-[2.1rem] tracking-tight m-0",
                "API reference")
             p(class=ProseClass ++ " " ++ Measure,
               "Every module of the standard library, generated from the"
                   ++ " source by " ++ code(class=CodeSpan,
                                            "apps/macadoc/macadoc.maca") ++ ". Press "
                   ++ element("kbd", class=KbdClass, "/") ++ " to search.")
             div(class=Stack ++ " mt-8 gap-4", module_cards(ms, 0))))

Mono = "font-mono text-[0.9em]"

KbdClass = "text-[0.7rem] px-1 py-[0.05rem] border"
    ++ " border-zinc-300 dark:border-zinc-700 text-zinc-500"
    ++ " dark:text-zinc-400"

module_cards(ms: Module[], i: int) -> str {
    if i >= ms.length() {
        ""
    } else {
        module_card(ms.get(i)) ++ module_cards(ms, i + 1)
    }
}

module_card(m: Module) -> str =>
    a(class="block no-underline text-inherit border"
            ++ " border-zinc-200 dark:border-zinc-800 p-5 hover:bg-zinc-50"
            ++ " dark:hover:bg-zinc-900 hover:border-zinc-300"
            ++ " dark:hover:border-zinc-700",
      href=m.name ++ ".html",
      div(class="flex items-baseline justify-between gap-4",
          span(class="font-mono font-semibold", escape_html(m.path))
          span(class="text-[0.8rem] text-zinc-500 dark:text-zinc-400",
               counted(m.items.length())))
      p(class=ProseClass, inline(first_sentence(m.blurb))))

counted(n: int) -> str {
    if n == 1 {
        "1 item"
    } else {
        "{n} items"
    }
}

first_sentence(ls: str[]) -> str {
    blank = str_find_index(ls, l => l.trim() == "")
    end = if blank < 0 { ls.length() } else { blank }
    para = str_take(ls, end).join(" ")
    at = para.index_of(". ")

    if at < 0 {
        para
    } else {
        para.slice(0, at + 1)
    }
}

module_page(ms: Module[], m: Module) -> str =>
    page(m.path, sidebar(ms, m.name),
         section(class="py-2",
             p(class="text-[0.75rem] uppercase tracking-widest text-zinc-500"
                     ++ " dark:text-zinc-400 m-0",
               "Module")
             div(class="mt-1 flex flex-wrap items-baseline justify-between"
                       ++ " gap-3",
                 h1(class="font-mono font-bold text-[1.7rem] tracking-tight"
                          ++ " m-0",
                    escape_html(m.path))
                 span(class="flex items-center gap-3",
                      span(class="text-[0.8rem] text-zinc-500"
                                 ++ " dark:text-zinc-400",
                           counted(m.items.length()))
                      source_link(m.path, 0, "source")))
             div(class=Measure, prose(m.blurb))
             div(class=Stack ++ " mt-10 gap-6", entries(ms, m, m.items, 0))))

entries(ms: Module[], m: Module, items: Item[], i: int) -> str {
    if i >= items.length() {
        ""
    } else {
        entry(ms, m, items.get(i)) ++ entries(ms, m, items, i + 1)
    }
}

entry(ms: Module[], m: Module, it: Item) -> str =>
    article(id=it.name, class=ItemClass,
        div(class="flex flex-wrap items-center justify-between gap-x-3"
                  ++ " gap-y-2",
            div(class="flex items-center gap-3",
                h2(class="font-mono font-semibold text-[1.05rem] m-0",
                   a(class="no-underline text-inherit hover:underline",
                     href="#" ++ it.name, escape_html(it.name)))
                span(data-kind=it.kind, class=badge_class(it.kind),
                     kind_word(it.kind)))
            div(class="flex items-center gap-3",
                anchor_link(it.name)
                source_link(m.path, it.line, "source")))
        signature_block(ms, m, it)
        div(class=Measure, prose(it.doc)))

ItemClass = "scroll-mt-20 border border-zinc-200"
    ++ " dark:border-zinc-800 p-5 max-sm:p-4"

anchor_link(name: str) -> str =>
    a(class="no-underline text-[0.8rem] text-zinc-400"
            ++ " dark:text-zinc-600 hover:text-black"
            ++ " dark:hover:text-white focus:underline",
      href="#" ++ name, title="Link to " ++ name, "#")

signature_block(ms: Module[], m: Module, it: Item) -> str =>
    pre(class=SigClass, data-sig=flat(it.sig),
        code(class=Mono,
             cross_linked(highlight("maca", it.sig), ms, m.name, it.name)))

TySpan = "<span class=\"tok-ty\">"

cross_linked(html: str, ms: Module[], here: str, own: str) -> str {
    parts = html.split(TySpan)

    linked_spans(parts, 1, ms, here, own, parts.get(0))
}

linked_spans(parts: str[], i: int, ms: Module[], here: str, own: str,
             out: str) -> str {
    if i >= parts.length() {
        out
    } else {
        linked_spans(parts, i + 1, ms, here, own,
                     out ++ TySpan ++ linked_span(parts.get(i), ms, here, own))
    }
}

linked_span(part: str, ms: Module[], here: str, own: str) -> str {
    at = part.index_of("</span>")
    name = part.slice(0, at)
    where = declaring_module(ms, here, name)

    if name == own || where == "" {
        part
    } else {
        a(class="no-underline text-inherit underline-offset-2"
                ++ " hover:underline focus:underline",
          href=item_href(where, name, where == here),
          data-mod=where, data-item=name, name)
            ++ part.slice(at, part.length())
    }
}

declaring_module(ms: Module[], here: str, name: str) -> str {
    if declares_in(ms, 0, here, name) {
        here
    } else {
        first_declaring(ms, 0, name)
    }
}

declares_in(ms: Module[], i: int, here: str, name: str) -> bool {
    if i >= ms.length() {
        false
    } else if ms.get(i).name == here {
        declares_type(ms.get(i).items, 0, name)
    } else {
        declares_in(ms, i + 1, here, name)
    }
}

first_declaring(ms: Module[], i: int, name: str) -> str {
    if i >= ms.length() {
        ""
    } else if declares_type(ms.get(i).items, 0, name) {
        ms.get(i).name
    } else {
        first_declaring(ms, i + 1, name)
    }
}

declares_type(items: Item[], i: int, name: str) -> bool {
    if i >= items.length() {
        false
    } else if items.get(i).name != name {
        declares_type(items, i + 1, name)
    } else {
        items.get(i).kind == "record" || items.get(i).kind == "sum"
    }
}

flat(s: str) -> str =>
    squeezed(s.replace("\n", " ").chars(), 0, "").trim()

squeezed(cs: str[], i: int, out: str) -> str {
    if i >= cs.length() {
        out
    } else if cs.get(i) == " " && out.ends_with(" ") {
        squeezed(cs, i + 1, out)
    } else {
        squeezed(cs, i + 1, out ++ cs.get(i))
    }
}

kind_word(kind: str) -> str {
    if kind == "fn" {
        "function"
    } else if kind == "record" {
        "record"
    } else if kind == "sum" {
        "sum type"
    } else {
        "constant"
    }
}

badge_class(kind: str) -> str =>
    "px-2 py-[0.1rem] text-[0.7rem] uppercase tracking-wide"
        ++ " border font-semibold kind-" ++ kind

doc_css() -> str =>
    """.kind-fn { color: #6d28d9; border-color: #ddd6fe }
.kind-record { color: #0e7490; border-color: #a5f3fc }
.kind-sum { color: #b45309; border-color: #fde68a }
.kind-const { color: #047857; border-color: #a7f3d0 }
a[aria-current="true"] { background-color: #f4f4f5; color: #18181b }
@media (prefers-color-scheme: dark) {
.kind-fn { color: #c4b5fd; border-color: #5b21b6 }
.kind-record { color: #67e8f9; border-color: #155e75 }
.kind-sum { color: #fcd34d; border-color: #92400e }
.kind-const { color: #6ee7b7; border-color: #065f46 }
a[aria-current="true"] { background-color: #27272a; color: #fafafa }
}
"""

source_link(path: str, line: int, label: str) -> str =>
    a(class="no-underline text-zinc-500 dark:text-zinc-400 text-[0.75rem]"
            ++ " hover:underline",
      href=source_url(path, line), label)

source_url(path: str, line: int) -> str {
    if line <= 0 {
        Repo ++ "/blob/main/" ++ path
    } else {
        Repo ++ "/blob/main/" ++ path ++ "#L{line}"
    }
}

SideClass = "text-[0.85rem] sticky top-[4.5rem] self-start"
    ++ " max-h-[calc(100vh_-_6rem)]"
    ++ " overflow-y-auto overscroll-contain max-md:static max-md:max-h-none"
    ++ " max-md:mb-6 max-md:border-b max-md:border-zinc-200"
    ++ " max-md:dark:border-zinc-800"

sidebar(ms: Module[], cur: str) -> str =>
    div(class=SideClass,
        details(data-doc="nav", open=true,
            summary(class="hidden max-md:block cursor-pointer py-2 list-none"
                          ++ " details-marker:hidden text-zinc-500",
                    "☰ Modules")
            search_box()
            div(class="mt-2", module_trees(ms, 0, cur))))

search_box() -> str =>
    div(class="relative my-2",
        input(id="macadoc-search", type="search",
              placeholder="Search names and types",
              aria-label="Search names and types", autocomplete="off",
              class="w-full px-2 py-1 pr-7 border border-zinc-200"
                    ++ " dark:border-zinc-700 bg-white"
                    ++ " dark:bg-zinc-900 text-[0.85rem]")
        span(class="absolute right-2 top-[0.35rem] pointer-events-none",
             element("kbd", class=KbdClass, "/")))
        ++ p(id="macadoc-empty", hidden=true,
             class="text-zinc-500 text-[0.8rem] my-1", "No matches.")

module_trees(ms: Module[], i: int, cur: str) -> str {
    if i >= ms.length() {
        ""
    } else {
        module_tree(ms.get(i), cur) ++ module_trees(ms, i + 1, cur)
    }
}

module_tree(m: Module, cur: str) -> str {
    here = m.name == cur

    details(data-mod=m.name, open=here,
        summary(class="cursor-pointer py-1 font-mono font-semibold"
                      ++ " text-[0.82rem] " ++ summary_class(here),
                escape_html(m.name))
        div(class="pb-2", kind_groups(m, here, 0)))
}

summary_class(here: bool) -> str {
    if here {
        "text-zinc-500 dark:text-zinc-500"
    } else {
        "hover:text-black dark:hover:text-white"
    }
}

Kinds = "fn record sum const"

kind_label(kind: str) -> str {
    if kind == "fn" {
        "Functions"
    } else if kind == "record" {
        "Records"
    } else if kind == "sum" {
        "Sum types"
    } else {
        "Constants"
    }
}

kind_groups(m: Module, here: bool, i: int) -> str {
    kinds = Kinds.split(" ")

    if i >= kinds.length() {
        ""
    } else {
        kind_group(m, here, kinds.get(i)) ++ kind_groups(m, here, i + 1)
    }
}

kind_group(m: Module, here: bool, kind: str) -> str {
    got = of_kind(m.items, 0, kind, [])

    if got.length() == 0 {
        ""
    } else {
        div(data-group=kind,
            p(class="mt-3 mb-1 px-1 text-[0.7rem] uppercase tracking-wide"
                    ++ " text-zinc-500 dark:text-zinc-400",
              kind_label(kind))
            ul(class="list-none m-0 p-0", side_rows(m, got, here, 0)))
    }
}

of_kind(items: Item[], i: int, kind: str, acc: Item[]) -> Item[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind == kind {
        of_kind(items, i + 1, kind, acc ++ [items.get(i)])
    } else {
        of_kind(items, i + 1, kind, acc)
    }
}

side_rows(m: Module, items: Item[], here: bool, i: int) -> str {
    if i >= items.length() {
        ""
    } else {
        side_row(m, items.get(i), here)
            ++ side_rows(m, items, here, i + 1)
    }
}

side_row(m: Module, it: Item, here: bool) -> str =>
    li(data-item=it.name, data-sig=flat(it.sig),
       data-brief=plain(first_sentence(it.doc)), class="m-0",
       a(class="block px-2 py-[0.15rem] no-underline font-mono"
               ++ " text-[0.8rem] text-zinc-600 dark:text-zinc-400"
               ++ " hover:bg-zinc-100 dark:hover:bg-zinc-800"
               ++ " hover:text-black dark:hover:text-white",
         href=item_href(m.name, it.name, here),
         data-mod=m.name, data-item=it.name, escape_html(it.name)))

plain(s: str) -> str =>
    flat(s).replace("`", "").replace("*", "")

item_href(module: str, name: str, here: bool) -> str {
    if here {
        "#" ++ name
    } else {
        module ++ ".html#" ++ name
    }
}

nav_script() -> str =>
    script("""
(function(){
  var nav=document.querySelector('details[data-doc="nav"]');
  if(nav&&window.matchMedia("(max-width:48rem)").matches)
    nav.removeAttribute("open");
  var q=document.getElementById("macadoc-search");
  var empty=document.getElementById("macadoc-empty");
  var mods=document.querySelectorAll('details[data-mod]');
  var was=[],i;
  for(i=0;i<mods.length;i++) was.push(mods[i].hasAttribute("open"));
  if(q) q.addEventListener("input",function(){
    var t=q.value.trim().toLowerCase(),shown=0,j;
    for(i=0;i<mods.length;i++){
      var m=mods[i],hits=0;
      var all=t===""||m.dataset.mod.toLowerCase().indexOf(t)>=0;
      var rows=m.querySelectorAll('li[data-item]');
      for(j=0;j<rows.length;j++){
        var hit=all||rows[j].dataset.sig.toLowerCase().indexOf(t)>=0;
        rows[j].hidden=!hit;
        if(hit) hits++;
      }
      var groups=m.querySelectorAll('div[data-group]');
      for(j=0;j<groups.length;j++)
        groups[j].hidden=!groups[j].querySelector('li[data-item]:not([hidden])');
      m.hidden=hits===0;
      m.open=t===""?was[i]:true;
      shown+=hits;
    }
    if(empty) empty.hidden=shown>0;
  });

  var card=document.getElementById("macadoc-card");
  var sig=card?card.querySelector("code"):null;
  var brief=card?card.querySelector("p"):null;
  function hide(){ if(card) card.hidden=true; }
  function rowFor(a){
    var m=a.getAttribute("data-mod"),n=a.getAttribute("data-item");
    if(!m||!n) return null;
    return document.querySelector(
      'details[data-mod="'+m+'"] li[data-item="'+n+'"]');
  }
  function show(a){
    var li=rowFor(a);
    if(!li||!card){ hide(); return; }
    sig.textContent=li.getAttribute("data-sig")||"";
    brief.textContent=li.getAttribute("data-brief")||"";
    card.hidden=false;
    var r=a.getBoundingClientRect();
    card.style.top=(r.bottom+window.pageYOffset+8)+"px";
    var room=window.pageXOffset+document.documentElement.clientWidth
      -card.offsetWidth-12;
    card.style.left=Math.max(window.pageXOffset+8,
      Math.min(r.left+window.pageXOffset,room))+"px";
  }
  function linkAt(e){
    return e.target&&e.target.closest?e.target.closest("a[data-item]"):null;
  }
  document.addEventListener("mouseover",function(e){
    var a=linkAt(e);
    if(a) show(a); else hide();
  });
  document.addEventListener("focusin",function(e){
    var a=linkAt(e);
    if(a) show(a); else hide();
  });

  var arts=document.querySelectorAll("article[id]");
  var own=document.querySelectorAll('li[data-item] a[href^="#"]');
  function spy(){
    var at="",k;
    for(k=0;k<arts.length;k++)
      if(arts[k].getBoundingClientRect().top<140) at=arts[k].id;
    for(k=0;k<own.length;k++){
      if(own[k].getAttribute("href")==="#"+at)
        own[k].setAttribute("aria-current","true");
      else own[k].removeAttribute("aria-current");
    }
  }
  window.addEventListener("scroll",function(){ hide(); spy(); },
    {passive:true});
  spy();

  document.addEventListener("keydown",function(e){
    var tag=e.target?e.target.tagName:"";
    if(e.key==="/"&&q&&tag!=="INPUT"&&tag!=="TEXTAREA"){
      e.preventDefault();
      if(nav) nav.open=true;
      q.focus();
      q.select();
    }else if(e.key==="Escape"){
      hide();
      if(q&&document.activeElement===q){
        q.value="";
        q.dispatchEvent(new Event("input"));
        q.blur();
      }
    }
  });
})();
""")

Spec = command("macadoc", "an API reference, rendered from Maca source")
    .arg("out", "the directory to write the reference into")
    .rest("module", "the .maca files to document")

main(argv: str[]) -> int {
    got = parse(Spec, argv)

    if got.wants_help {
        info(help(Spec))
        0
    } else if got.error != "" {
        err(bad(got.error))
        1
    } else if from(got, 1).length() == 0 {
        err(bad("macadoc: no modules given, so there is nothing to document"))
        1
    } else {
        generate(value(got, "out", ""), from(got, 1))
    }
}

generate(out: str, sources: str[]) -> int {
    modules = read_all(sources, 0, [])
    require_distinct_names(modules, 0)

    remove_dir(out)
    make_dir(out)

    write_file(join(out, "index.html"), index_page(modules))
    written = write_modules(out, modules, 0)

    info(ok("{written} modules, {total_items(modules, 0)} items → "
            ++ dim(out)))
    0
}

require_distinct_names(ms: Module[], i: int) -> bool {
    if i >= ms.length() {
        true
    } else if name_taken(ms, 0, i) {
        fail "two modules named {ms.get(i).name}: {ms.get(i).path}"
    } else {
        require_distinct_names(ms, i + 1)
    }
}

name_taken(ms: Module[], i: int, before: int) -> bool {
    if i >= before {
        false
    } else if ms.get(i).name == ms.get(before).name {
        true
    } else {
        name_taken(ms, i + 1, before)
    }
}

read_all(sources: str[], i: int, acc: Module[]) -> Module[] {
    if i >= sources.length() {
        acc
    } else {
        read_all(sources, i + 1, acc ++ [read_module(sources.get(i))])
    }
}

write_modules(out: str, ms: Module[], i: int) -> int {
    if i >= ms.length() {
        0
    } else {
        write_file(join(out, ms.get(i).name ++ ".html"),
                   module_page(ms, ms.get(i)))
        1 + write_modules(out, ms, i + 1)
    }
}

total_items(ms: Module[], i: int) -> int {
    if i >= ms.length() {
        0
    } else {
        ms.get(i).items.length() + total_items(ms, i + 1)
    }
}
