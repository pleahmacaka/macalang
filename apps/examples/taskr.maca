import std/json
import std/path
import std/proc

Status = Todo | Doing | Done

Task = {
    id:     int
    title:  str
    status: Status
}

store_path() -> str =>
    join(env_or("XDG_DATA_HOME", "."), "taskr.json")

load() -> Task[] {
    path = store_path()

    if !file_exists(path) {
        []
    } else {
        items(read_file(path)).map(task_of)
    }
}

task_of(src: str) -> Task =>
    Task {
        id = get_int(src, "id", 0),
        title = get(src, "title"),
        status = status_of(get(src, "status"))
    }

save(tasks: Task[]) -> bool =>
    write_file(store_path(), "[" + tasks.map(json_of).join(",") + "]")

json_of(t: Task) -> str =>
    object_of(["id", "title", "status"],
              [str(t.id), quote(t.title), quote(name_of(t.status))])

name_of(s: Status) -> str =>
    match s {
        Todo  => "todo"
        Doing => "doing"
        Done  => "done"
    }

status_of(name: str) -> Status {
    if name == "doing" {
        Doing
    } else if name == "done" {
        Done
    } else {
        Todo
    }
}

add(tasks: Task[], title: str) -> Task[] =>
    tasks.push(Task { id = next_id(tasks), title = title, status = Todo })

next_id(tasks: Task[]) -> int =>
    tasks.map(id_of).max() + 1

id_of(t: Task) -> int =>
    t.id

finish(tasks: Task[], id: int) -> Task[] =>
    tasks.map(t => t.id == id ? t with { status = Done } : t)

render(t: Task) -> str {
    box = match t.status {
        Todo  => "[ ]"
        Doing => "[~]"
        Done  => "[x]"
    }

    "{box} #{t.id}  {t.title}"
}

main(args: str[]) -> int {
    tasks = load()

    match args {
        "add", ..rest => {
            title = rest.join(" ")
            save(add(tasks, title))
            info("added: {title}")
        }
        "done", id => {
            save(finish(tasks, int(id)))
            info("done: #{id}")
        }
        "list" => info(tasks.map(render).join("\n"))
        _ => info("usage: taskr [add <title> | done <id> | list]")
    }
    0
}
