import "gpui::div"
import "gpui::Render"
import "gpui::IntoElement"
import "gpui::AnyElement"
import "gpui::Context"
import "gpui::Window"

Counter = {
    count: int
}

Counter : Render = {
    render = (self, window: Window, cx: Context Counter) -> AnyElement =>
        div()
            .flex()
            .gap_2()
            .child("Count: {self.count}")
            .child(
                div()
                    .id("inc")
                    .child("increment")
                    .on_click(ev => self.count = self.count + 1)
            )
            .into_any_element()
}

main() -> int {
    c = Counter { count = 41 }
    info("counter starts at {c.count}")
    0
}
