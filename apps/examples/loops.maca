sum_to(n: int) -> int {
    acc = 0
    i = 1
    while i <= n {
        acc = acc + i
        i = i + 1
    }
    acc
}

count_small(n: int) -> int {
    steps = 0
    i = n
    while i > 0 {
        i = i - 1
        if i > 100 {
            continue
        }
        steps = steps + 1
    }
    steps
}

main() -> int {
    info("{sum_to(10)}")
    info("{count_small(5)}")
    0
}
