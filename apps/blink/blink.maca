gpiod_moder : int = 0x40020C00
gpiod_odr   : int = 0x40020C14
rcc_ahb1enr : int = 0x40023830

setup() {
    set_bits(rcc_ahb1enr, bit(3))
    mmio_write(gpiod_moder, shl(1, 24))
}

blink() {
    for _ in forever() {
        set_bits(gpiod_odr, bit(12))
        delay(800000)
        clear_bits(gpiod_odr, bit(12))
        delay(800000)
    }
}

main() {
    setup()
    blink()
}
