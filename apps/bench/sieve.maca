count_primes(n: int) -> int {
    marks = 0..n + 1
    count = 0
    i = 2
    while i <= n {
        if marks[i] == i {
            count = count + 1
            j = i + i
            while j <= n {
                marks[j] = 0
                j = j + i
            }
        }
        i = i + 1
    }
    count
}

main() -> int {
    info("{count_primes(10000000)}")
    0
}
