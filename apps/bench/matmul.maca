matmul(n: int) -> int {
    a = 0..(n * n)
    b = 0..(n * n)
    c = 0..(n * n)
    for i in 0..n {
        for j in 0..n {
            a[i * n + j] = (i + j) % 100
            b[i * n + j] = (i * j) % 100
        }
    }
    for i in 0..n {
        for j in 0..n {
            s = 0
            for k in 0..n {
                s = s + a[i * n + k] * b[k * n + j]
            }
            c[i * n + j] = s
        }
    }
    sum = 0
    for i in 0..n * n {
        sum = (sum + c[i]) % 1000000007
    }
    sum
}

main() -> int {
    info("{matmul(400)}")
    0
}
