import std/proc
import { join } from std/path
import { Result, median_ms, spread_ms } from bench/time
import { save, load, find } from bench/store
import { compare, comparison_table, summary } from bench/compare
import { regressed, Tolerance } from bench/compare
import { grouped } from bench/report
import { rule } from cli/show
import { dim, ok, bad, note } from cli/style
import { command, opt } from cli/spec
import { parse, value, count } from cli/parse
import { help } from cli/help

Tmp = "/tmp/maca-bench"

Baseline = "apps/bench/results.json"
Report = "apps/bench/results.md"

RunsDefault = 5

recursion_kernels() -> str[] => ["fib", "tak", "ackermann"]
compute_kernels() -> str[] => ["sieve", "mandel", "matmul"]

kernels() -> str[] =>
    recursion_kernels() ++ compute_kernels()

expected(algo: str) -> int {
    if algo == "fib" {
        102334155
    } else if algo == "tak" {
        9
    } else if algo == "ackermann" {
        8189
    } else if algo == "sieve" {
        664579
    } else if algo == "mandel" {
        141554306
    } else {
        163198950
    }
}

params(algo: str) -> str {
    if algo == "fib" {
        "fib(40)"
    } else if algo == "tak" {
        "tak(32,16,8)"
    } else if algo == "ackermann" {
        "ack(3,10)"
    } else if algo == "sieve" {
        "primes ≤ 10⁷"
    } else if algo == "mandel" {
        "800×800, ≤1000 it"
    } else {
        "400×400 int"
    }
}

langs() -> str[] =>
    ["Maca", "C", "Rust", "Go", "JS (node)", "Python"]

case_name(algo: str, lang: str) -> str =>
    algo ++ "/" ++ lang

time_cmd(algo: str, lang: str, cmd: str, args: str[], runs: int) -> Result {
    capture(cmd, args)
    taken: int[] = []
    printed = ""

    for _ in 0..runs {
        started = now_ms()
        printed = capture(cmd, args).trim()
        taken = taken.push(now_ms() - started)
    }

    Result { name = case_name(algo, lang), size = 1, iters = 1,
             samples = taken, checksum = int(printed) }
}

Runner = {
    lang: str
    cmd: str
    args: str[]
}

runners(algo: str) -> Runner[] {
    built = [build_maca(algo), build_native("C", "cc", "-O2", algo, "_c"),
             build_native("Rust", "rustc", "-O", algo, "_rs"),
             build_go(algo)]

    built ++ [interpreted("JS (node)", "node",
                          ["--stack-size=8000", ref(algo, ".js")]),
              interpreted("Python", "python3", [ref(algo, ".py")])]
}

ref(algo: str, ext: str) -> str =>
    join("apps/bench/ref", algo ++ ext)

no_runner(lang: str) -> Runner =>
    Runner { lang = lang, cmd = "", args = [] }

build_maca(algo: str) -> Runner {
    out = join(Tmp, algo ++ "_maca")
    built = try_run("target/release/maca",
                    ["build", join("apps/bench", algo ++ ".maca"), "-o", out])

    if !built {
        fail "maca build {algo} failed"
    } else {
        Runner { lang = "Maca", cmd = out, args = [] }
    }
}

build_native(lang: str, tool: str, opt: str, algo: str, suffix: str) -> Runner {
    if !have(tool) {
        no_runner(lang)
    } else {
        out = join(Tmp, algo ++ suffix)
        ext = if tool == "cc" { ".c" } else { ".rs" }

        if !try_run(tool, [opt, ref(algo, ext), "-o", out]) {
            fail "{tool} {algo} failed"
        } else {
            Runner { lang = lang, cmd = out, args = [] }
        }
    }
}

build_go(algo: str) -> Runner {
    if !have("go") {
        no_runner("Go")
    } else {
        out = join(Tmp, algo ++ "_go")

        if !try_run("go", ["build", "-o", out, ref(algo, ".go")]) {
            fail "go build {algo} failed"
        } else {
            Runner { lang = "Go", cmd = out, args = [] }
        }
    }
}

interpreted(lang: str, tool: str, args: str[]) -> Runner {
    if !have(tool) {
        no_runner(lang)
    } else {
        Runner { lang = lang, cmd = tool, args = args }
    }
}

Spec = command("bench", "Maca against C, Rust, Go, JS and Python")
    .opt("runs", "n", "timed runs per contender, after one warm-up",
         str(RunsDefault))
    .opt("only", "k", "one kernel instead of all six", "")

main(argv: str[]) -> int {
    got = parse(Spec, argv)

    if got.wants_help {
        info(help(Spec))
        0
    } else if got.error != "" {
        err(bad(got.error))
        1
    } else {
        measure_all(chosen(value(got, "only", "")),
                    count(got, "runs", RunsDefault))
    }
}

chosen(only: str) -> str[] {
    if only == "" {
        kernels()
    } else if !kernels().contains(only) {
        fail "no kernel called {only}; try {kernels().join(", ")}"
    } else {
        [only]
    }
}

measure_all(algos: str[], runs: int) -> int {
    make_dir(Tmp)
    before = load(Baseline)
    now = run_kernels(algos, 0, runs, [])

    against(baseline_for(algos, before), now)
    record(algos, now)
    0
}

baseline_for(algos: str[], before: Result[]) -> Result[] =>
    before.filter(r => algos.contains(kernel_of(r)))

kernel_of(r: Result) -> str =>
    r.name.split("/").get(0)

run_kernels(algos: str[], i: int, runs: int, acc: Result[]) -> Result[] {
    if i >= algos.length() {
        acc
    } else {
        info(rule("{algos.get(i)}: {params(algos.get(i))}"))
        here = time_runners(runners(algos.get(i)), 0, algos.get(i), runs, [])
        run_kernels(algos, i + 1, runs, acc ++ here)
    }
}

time_runners(rs: Runner[], i: int, algo: str, runs: int,
             acc: Result[]) -> Result[] {
    if i >= rs.length() {
        acc
    } else if rs.get(i).cmd == "" {
        time_runners(rs, i + 1, algo, runs, acc)
    } else {
        r = time_cmd(algo, rs.get(i).lang, rs.get(i).cmd, rs.get(i).args, runs)
        report(algo, rs.get(i).lang, r)
        time_runners(rs, i + 1, algo, runs, acc ++ [r])
    }
}

report(algo: str, lang: str, r: Result) {
    line = "  {lang:<10}{median_ms(r):>9.0} ms  ±{spread_ms(r):<7.1}"
    mark = r.checksum == expected(algo)
        ? note("ok")
        : bad("got {grouped(r.checksum)}, want {grouped(expected(algo))}")

    info(line ++ mark)
}

against(before: Result[], now: Result[]) {
    if before.length() == 0 {
        info(note("no baseline in {Baseline}; this run becomes one"))
    } else {
        deltas = compare(before, now, Tolerance)
        info(rule("since the last run"))
        info(comparison_table(deltas))
        info(regressed(deltas) ? bad(summary(deltas)) : ok(summary(deltas)))
    }
}

record(algos: str[], now: Result[]) {
    if algos.length() < kernels().length() {
        info(note("partial run: {Baseline} and {Report} left alone"))
    } else {
        save(Baseline, now)
        write_file(Report, results_md(now))
        info(ok("wrote " ++ dim(Baseline) ++ " and " ++ dim(Report)))
    }
}

cell(rs: Result[], algo: str, lang: str, base: float) -> str {
    at = find(rs, case_name(algo, lang))

    if at < 0 {
        "n/a"
    } else if base <= 0.0 {
        "{median_ms(rs.get(at)):.0}"
    } else {
        ms = median_ms(rs.get(at))
        "{ms:.0} (×{ms / base:.1})"
    }
}

md_row(rs: Result[], algo: str) -> str {
    at = find(rs, case_name(algo, "C"))
    base = if at < 0 { 0.0 } else { median_ms(rs.get(at)) }
    cells = langs().map(l => cell(rs, algo, l, base))

    "| " ++ algo ++ " | " ++ params(algo) ++ " | " ++ cells.join(" | ") ++ " |\n"
}

md_table(rs: Result[], algos: str[], title: str, blurb: str) -> str =>
    "### " ++ title ++ "\n\n" ++ blurb ++ "\n\n"
        ++ "| kernel | params | " ++ langs().join(" | ") ++ " |\n"
        ++ "|" ++ "---|".repeat(langs().length() + 2) ++ "\n"
        ++ md_rows(rs, algos, 0)
        ++ "\n"

md_rows(rs: Result[], algos: str[], i: int) -> str {
    if i >= algos.length() {
        ""
    } else {
        md_row(rs, algos.get(i)) ++ md_rows(rs, algos, i + 1)
    }
}

results_md(rs: Result[]) -> str =>
    preamble()
        ++ md_table(rs, recursion_kernels(),
                    "Recursion-bound (call overhead)",
                    "Tree/nested recursion, dominated by function-call cost.")
        ++ md_table(rs, compute_kernels(),
                    "Compute-bound (loops, arrays, float)",
                    "Tight loops over arrays and floating point, dominated by"
                        ++ " the inner loop.")
        ++ closing()

preamble() -> str =>
    "# Benchmarks: Maca vs C / Rust / Go / JS / Python\n\n"
        ++ "Median execution time in **ms** (lower is better); `×N` is the"
        ++ " slowdown\nvs C. Maca is `maca build` (Maca → C → `cc -O2`); C is"
        ++ " `cc -O2`; Rust is\n`rustc -O`; Go is `go build`; JS is Node;"
        ++ " Python is CPython 3. Every\ncolumn computes the same verified"
        ++ " result. Reproduce with\n`maca run apps/bench/run.maca`.\n\n"

closing() -> str =>
    "On recursion and float/loop work Maca lands right on C (it *is* C, at\n"
        ++ "`-O2`). `sieve` is the widest gap: Maca's only array type is 64-bit"
        ++ " `int[]`,\nso a sieve over 10⁷ touches ~80 MB where C's `char`"
        ++ " array touches ~10 MB.\nIt's memory-bound, not a codegen deficit"
        ++ " (a compact byte array would close\nit).\n\n"
        ++ "_Host: " ++ output("uname", ["-srm"]) ++ ". Times are wall-clock"
        ++ " medians including process startup._\n"
