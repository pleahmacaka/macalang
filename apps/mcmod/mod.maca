// A Minecraft (Fabric) mod entry point, written in Maca.
//
// Build it to Java with:  maca build --target jvm mod.maca -o build
// then drop the generated ExampleMod.java into a Fabric project's
// src/main/java (or point Gradle at it). See README.md.

import java "net.fabricmc.api.ModInitializer"

// plain Maca logic, compiled to a static Java method
greeting(name: str) -> str =>
    "Hello from a Maca-authored Fabric mod, {name}!"

// a class implementing Fabric's ModInitializer; `onInitialize` runs at load
ExampleMod : ModInitializer = {
    onInitialize = () => info(greeting("world"))
}
