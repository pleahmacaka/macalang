import "../../target/wasm32-unknown-unknown/release/maca_wasm.wasm"

Sym = {
    kind:   str
    name:   str
    detail: str
    line:   int
}

Problem = {
    kind:  str
    where: str
    msg:   str
}

Outcome = {
    ran:       bool
    output:    str
    error:     str
    exited:    bool
    exit:      int
    steps:     int
    calls:     int
    depth:     int
    truncated: bool
    flame:     str
}

Shared = {
    program: str
    mode:    int
}

compile(src: str, mode: int) -> str
show(answer: str) -> bool
source() -> str
edit(text: str) -> bool
reveal(line: int) -> bool
hovered() -> str
pick(name: str) -> bool
share_link(mode: int) -> str
opened() -> Shared
micros() -> int
problems() -> Problem[]
symbols() -> Sym[]
emitted(pane: str) -> str
outcome() -> Outcome
preview(js: str, css: str) -> bool

import css """
.ol-item { display: flex; align-items: baseline; gap: .45rem;
  padding: .25rem .5rem; border-radius: .35rem; cursor: pointer;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ol-item:hover { background: #26262c; }
.ol-name { color: #e6e3f0; }
.ol-detail { color: #6b6b78; font-size: .72rem; }
.ol-kind { font-size: .58rem; text-transform: uppercase; letter-spacing: .05em;
  padding: .1rem .35rem; border-radius: .25rem; font-weight: 600; flex: none; }
.ol-fn { background: #2a2350; color: #c4b5fd; }
.ol-type { background: #3a2a12; color: #fbbf24; }
.ol-value { background: #0f2f28; color: #34d399; }
.ol-option { background: #102a3a; color: #38bdf8; }
.ol-empty { color: #5f6577; padding: .6rem; font-size: .8rem;
  font-family: 'JetBrainsMono Nerd Font', monospace; }
#preview iframe { width: 100%; height: 100%; border: 0; background: #ffffff; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: #303038; border-radius: 6px; }
::-webkit-scrollbar-thumb:hover { background: #3d3d47; }
::-webkit-scrollbar-corner, ::-webkit-scrollbar-track { background: transparent; }
"""

import js """
"use strict";
(function () {
  const EMPTY = {
    parseErrors: [], diagnostics: [], limits: {}, outputs: {},
    symbols: [], markers: [], run: null,
  };
  let ex = null;
  let last = EMPTY;
  let spent = 0;
  let ed = null;
  let mo = null;
  let pending = "";
  let previewKey = null;
  let opening = true;

  function bytesOf(b64) {
    const bin = atob(b64.trim());
    const arr = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
    return arr;
  }
  function mem() { return new Uint8Array(ex.memory.buffer); }
  function readPacked(packed) {
    const ptr = Number(packed >> 32n), len = Number(packed & 0xffffffffn);
    const out = new TextDecoder().decode(mem().slice(ptr, ptr + len));
    ex.dealloc(ptr, len);
    return out;
  }
  function into(src) {
    const b = new TextEncoder().encode(src);
    const p = ex.alloc(b.length);
    mem().set(b, p);
    return [p, b.length];
  }
  function ask(src, off) {
    if (!ex || !ex.lsp) return null;
    try {
      const boff = new TextEncoder().encode(src.slice(0, off)).length;
      const [p, n] = into(src);
      const out = readPacked(ex.lsp(p, n, boff));
      ex.dealloc(p, n);
      return JSON.parse(out);
    } catch (e) {
      return null;
    }
  }

  function b64url(text) {
    const b = new TextEncoder().encode(text);
    let bin = "";
    for (let i = 0; i < b.length; i++) bin += String.fromCharCode(b[i]);
    return btoa(bin).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  }
  function unb64url(text) {
    const bin = atob(text.replace(/-/g, "+").replace(/_/g, "/"));
    const b = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) b[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(b);
  }
  const shared = { program: "", mode: 0 };
  try {
    const parts = {};
    for (const kv of location.hash.replace(/^#/, "").split("&")) {
      const eq = kv.indexOf("=");
      if (eq > 0) parts[kv.slice(0, eq)] = kv.slice(eq + 1);
    }
    if (parts.p) {
      shared.program = unb64url(parts.p);
      shared.mode = parts.m === "1" ? 1 : 0;
    }
  } catch (e) {
    shared.program = "";
  }

  function textarea() { return document.getElementById("ed"); }
  function read() {
    if (ed) return ed.getValue();
    const ta = textarea();
    return ta ? ta.value : pending;
  }
  function caret() {
    if (ed) {
      const pos = ed.getPosition();
      return pos ? ed.getModel().getOffsetAt(pos) : 0;
    }
    const ta = textarea();
    if (!ta || document.activeElement !== ta) return -1;
    return ta.selectionStart | 0;
  }
  function paint() {
    if (!ed || !mo) return;
    const sev = {
      error: mo.MarkerSeverity.Error,
      warning: mo.MarkerSeverity.Warning,
      info: mo.MarkerSeverity.Info,
    };
    mo.editor.setModelMarkers(ed.getModel(), "maca",
      (last.markers || []).map(function (m) {
        return {
          severity: sev[m.severity] || mo.MarkerSeverity.Error,
          message: m.message,
          startLineNumber: m.line, startColumn: m.col,
          endLineNumber: m.endLine, endColumn: m.endCol,
        };
      }));
  }

  maca.provide({
    compile: function (src, mode) {
      if (!ex) return "";
      const t0 = performance.now();
      try {
        const [p, n] = into(src);
        const json = readPacked(ex.run(p, n, mode | 0));
        ex.dealloc(p, n);
        spent = Math.round((performance.now() - t0) * 1000);
        return json;
      } catch (e) {
        spent = 0;
        return JSON.stringify({ parseErrors: ["internal: " + e.message] });
      }
    },
    show: function (answer) {
      try {
        last = JSON.parse(answer);
      } catch (e) {
        last = EMPTY;
      }
      paint();
      maca.refresh();
      return true;
    },
    source: read,
    edit: function (text) {
      pending = text || "";
      if (ed) ed.setValue(pending);
      else {
        const ta = textarea();
        if (ta) ta.value = pending;
      }
      return true;
    },
    reveal: function (line) {
      if (line < 1) return false;
      if (ed) {
        ed.revealLineInCenterIfOutsideViewport(line);
        ed.setPosition({ lineNumber: line, column: 1 });
        ed.focus();
        return true;
      }
      const ta = textarea();
      if (!ta) return false;
      const ls = ta.value.split("\n");
      let off = 0;
      for (let i = 0; i < line - 1 && i < ls.length; i++) off += ls[i].length + 1;
      ta.focus();
      ta.setSelectionRange(off, off);
      return true;
    },
    hovered: function () {
      const off = caret();
      if (off < 0) return "";
      const info = ask(read(), off);
      return (info && info.hover) || "";
    },
    pick: function (name) {
      const el = document.getElementById("examples");
      if (el) el.value = name;
      return true;
    },
    share_link: function (mode) {
      const url = location.origin + location.pathname +
        "#p=" + b64url(read()) + "&m=" + (mode | 0);
      try {
        history.replaceState(null, "", url);
      } catch (e) {
        return "";
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () {}, function () {});
      }
      return url;
    },
    opened: function () { return { program: shared.program, mode: shared.mode }; },
    micros: function () { return spent; },
    problems: function () {
      const out = [];
      for (const e of last.parseErrors || []) {
        out.push({ kind: "parse", where: "", msg: e });
      }
      for (const d of last.diagnostics || []) {
        out.push({ kind: "check", where: d.kind, msg: d.msg });
      }
      const limits = last.limits || {};
      for (const target of Object.keys(limits)) {
        for (const why of limits[target]) {
          out.push({ kind: "refusal", where: target, msg: why });
        }
      }
      return out;
    },
    symbols: function () {
      return (last.symbols || []).map(function (s) {
        return {
          kind: s.kind || "value", name: s.name || "",
          detail: s.detail || "", line: s.line | 0,
        };
      });
    },
    emitted: function (pane) { return (last.outputs || {})[pane] || ""; },
    outcome: function () {
      const r = last.run;
      const p = (r && r.profile) || {};
      return {
        ran: !!r,
        output: (r && r.output) || "",
        error: (r && r.error) || "",
        exited: !!(r && r.exit !== null && r.exit !== undefined),
        exit: (r && r.exit) | 0,
        steps: p.steps | 0,
        calls: p.totalCalls | 0,
        depth: p.maxDepth | 0,
        truncated: !!p.truncated,
        flame: p.flameSvg || "",
      };
    },
    preview: function (js, css) {
      const host = document.getElementById("preview");
      if (!host) return false;
      if (!js) {
        previewKey = null;
        host.innerHTML = "";
        return false;
      }
      const key = css.length + ":" + css + js;
      if (key === previewKey) return true;
      previewKey = key;
      const frame = document.createElement("iframe");
      frame.setAttribute("sandbox", "allow-scripts");
      frame.setAttribute("title", "preview");
      frame.srcdoc = "<!doctype html><meta charset=\"utf-8\"><style>" + css +
        "</style><div id=\"app\"></div><script>" +
        js.replace(/<\/script/gi, "<\\/script") + "<\/script>";
      host.innerHTML = "";
      host.appendChild(frame);
      return true;
    },
  });

  function macaLanguage(m) {
    m.languages.register({ id: "maca" });
    m.languages.setLanguageConfiguration("maca", {
      comments: { lineComment: "//", blockComment: ["/*", "*/"] },
      brackets: [["{", "}"], ["[", "]"], ["(", ")"]],
      autoClosingPairs: [
        { open: "{", close: "}" }, { open: "[", close: "]" },
        { open: "(", close: ")" }, { open: '"', close: '"' },
      ],
    });
    m.languages.setMonarchTokensProvider("maca", {
      keywords: ["const", "as", "if", "else", "for", "in", "while", "break", "continue", "return", "match", "import", "from", "with", "fail", "try", "alias", "await", "spawn", "true", "false"],
      typeKeywords: ["int", "float", "str", "bool", "bytes"],
      tokenizer: {
        root: [
          [/\/\/\/[^\/].*$|\/\/\/$/, "comment.doc"],
          [/\/\/.*$/, "comment"],
          [/\/\*/, "comment", "@block"],
          [/"{3}/, "string", "@raw"],
          [/"/, "string", "@str"],
          [/(?:~|\.\.?\/|\/(?=[A-Za-z0-9_.~/-]))[A-Za-z0-9_.~/-]*/, "string"],
          [/\b\d[\d_]*\.\d[\d_]*\b/, "number.float"],
          [/\b0[xXbBoO][0-9a-fA-F_]+\b/, "number.hex"],
          [/\b\d[\d_]*\b/, "number"],
          [/[A-Z]\w*(?:-[A-Za-z_]\w*)*/, "type"],
          [/[a-z_]\w*(?:-[A-Za-z_]\w*)*/, { cases: { "@keywords": "keyword", "@typeKeywords": "type", "@default": "identifier" } }],
          [/[{}()\[\]]/, "@brackets"],
          [/->|=>|\.\.|[-+*/%<>=!&|?:]+/, "operator"],
          [/\./, "delimiter"],
        ],
        block: [[/[^*/]+/, "comment"], [/\*\//, "comment", "@pop"], [/[*/]/, "comment"]],
        str: [
          [/\{\{|\}\}/, "string.escape"],
          [/[^\\"{}]+/, "string"],
          [/\{/, "delimiter", "@interp"],
          [/\\./, "string.escape"],
          [/"/, "string", "@pop"],
          [/[{}]/, "string"],
        ],
        interp: [
          [/\}/, "delimiter", "@pop"],
          [/"/, "string", "@str"],
          [/\b\d[\d_]*\.\d[\d_]*\b/, "number.float"],
          [/\b0[xXbBoO][0-9a-fA-F_]+\b/, "number.hex"],
          [/\b\d[\d_]*\b/, "number"],
          [/[A-Z]\w*(?:-[A-Za-z_]\w*)*/, "type"],
          [/[a-z_]\w*(?:-[A-Za-z_]\w*)*/, { cases: { "@keywords": "keyword", "@typeKeywords": "type", "@default": "identifier" } }],
          [/->|=>|\.\.|[-+*/%<>=!&|?:]+/, "operator"],
          [/[^}]/, ""],
        ],
        raw: [[/"{3}/, "string", "@pop"], [/[^"]+/, "string"], [/"/, "string"]],
      },
    });
    m.editor.defineTheme("maca-dark", {
      base: "vs-dark", inherit: true,
      rules: [
        { token: "comment", foreground: "7d8590", fontStyle: "italic" },
        { token: "comment.doc", foreground: "8b9cb0", fontStyle: "italic" },
        { token: "keyword", foreground: "c792ea" },
        { token: "type", foreground: "ffcb6b" },
        { token: "string", foreground: "c3e88d" },
        { token: "string.escape", foreground: "89ddff" },
        { token: "number", foreground: "f78c6c" },
        { token: "operator", foreground: "89ddff" },
        { token: "delimiter", foreground: "89ddff" },
        { token: "identifier", foreground: "e6e3f0" },
      ],
      colors: {
        "editor.background": "#18181b",
        "editor.foreground": "#e6e3f0",
        "editorLineNumber.foreground": "#3f3f46",
        "editorCursor.foreground": "#a78bfa",
        "editor.selectionBackground": "#3b3564",
        "editor.lineHighlightBackground": "#1f1f23",
      },
    });
    const span = function (r) {
      return {
        startLineNumber: r.line, startColumn: r.col,
        endLineNumber: r.endLine, endColumn: r.endCol,
      };
    };
    m.languages.registerHoverProvider("maca", {
      provideHover: function (model, pos) {
        const info = ask(model.getValue(), model.getOffsetAt(pos));
        const hover = info && info.hover;
        return hover ? { contents: [{ value: "```maca\n" + hover + "\n```" }] } : null;
      },
    });
    m.languages.registerCompletionItemProvider("maca", {
      provideCompletionItems: function (model, pos) {
        const w = model.getWordUntilPosition(pos);
        const range = { startLineNumber: pos.lineNumber, endLineNumber: pos.lineNumber, startColumn: w.startColumn, endColumn: w.endColumn };
        const K = m.languages.CompletionItemKind, items = [];
        const add = (label, kind, detail) => items.push({ label, kind, insertText: label, range, detail });
        ["const", "as", "if", "else", "for", "in", "while", "break", "continue", "return", "match", "import", "with", "fail", "try", "true", "false"].forEach(k => add(k, K.Keyword));
        ["int", "float", "str", "bool", "bytes"].forEach(t => add(t, K.TypeParameter, "type"));
        ["info", "warn", "err", "print", "len", "str", "int", "float"].forEach(b => add(b, K.Function, "builtin"));
        for (const s of last.symbols || []) {
          add(s.name, s.kind === "type" ? K.Struct : s.kind === "fn" ? K.Function : K.Variable, s.detail || s.kind);
        }
        return { suggestions: items };
      },
    });
    m.languages.registerSignatureHelpProvider("maca", {
      signatureHelpTriggerCharacters: ["(", ","],
      provideSignatureHelp: function (model, pos) {
        const info = ask(model.getValue(), model.getOffsetAt(pos));
        const sig = info && info.signature;
        if (!sig) return null;
        return {
          value: {
            signatures: [{
              label: sig.label,
              parameters: (sig.params || []).map(function (p) { return { label: p }; }),
            }],
            activeSignature: 0,
            activeParameter: sig.active | 0,
          },
          dispose: function () {},
        };
      },
    });
    m.languages.registerDefinitionProvider("maca", {
      provideDefinition: function (model, pos) {
        const info = ask(model.getValue(), model.getOffsetAt(pos));
        const at = info && info.definition;
        return at ? { uri: model.uri, range: span(at) } : null;
      },
    });
    m.languages.registerDocumentHighlightProvider("maca", {
      provideDocumentHighlights: function (model, pos) {
        const info = ask(model.getValue(), model.getOffsetAt(pos));
        return ((info && info.references) || []).map(function (r) {
          return { range: span(r), kind: m.languages.DocumentHighlightKind.Text };
        });
      },
    });
  }

  function firstRender() {
    if (opening) {
      opening = false;
      start();
    } else {
      run();
    }
  }

  const CDN = "https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs";
  function mountEditor() {
    const host = document.getElementById("editor");
    if (!host) return;
    window.MonacoEnvironment = {
      getWorkerUrl: function () {
        return "data:text/javascript;charset=utf-8," + encodeURIComponent(
          "self.MonacoEnvironment={baseUrl:'" + CDN + "/'};importScripts('" + CDN + "/base/worker/workerMain.js');"
        );
      },
    };
    let fell = false;
    const fallback = function () {
      if (fell || ed) return;
      fell = true;
      plainEditor(host);
      firstRender();
    };
    const timer = setTimeout(fallback, 6000);
    const s = document.createElement("script");
    s.src = CDN + "/loader.js";
    s.onload = function () {
      require.config({ paths: { vs: CDN } });
      require(["vs/editor/editor.main"], function () {
        if (fell) return;
        clearTimeout(timer);
        mo = window.monaco;
        macaLanguage(mo);
        ed = mo.editor.create(host, {
          value: pending, language: "maca", theme: "maca-dark",
          fontFamily: "'JetBrainsMono Nerd Font', monospace",
          fontSize: 13, tabSize: 4, insertSpaces: true, minimap: { enabled: false },
          automaticLayout: true, scrollBeyondLastLine: false, smoothScrolling: true,
          padding: { top: 12, bottom: 12 }, renderLineHighlight: "line",
        });
        let t;
        ed.onDidChangeModelContent(function () {
          clearTimeout(t);
          t = setTimeout(run, 120);
        });
        ed.onDidChangeCursorPosition(function () { maca.refresh(); });
        maca.set({ editor: "monaco" });
        firstRender();
      });
    };
    s.onerror = function () { clearTimeout(timer); fallback(); };
    document.head.appendChild(s);
  }

  function plainEditor(host) {
    host.innerHTML = "";
    const ta = document.createElement("textarea");
    ta.id = "ed";
    ta.spellcheck = false;
    ta.value = pending;
    ta.setAttribute("wrap", "off");
    ta.style.cssText = "position:absolute;inset:0;width:100%;height:100%;box-sizing:border-box;" +
      "margin:0;border:0;padding:16px;resize:none;outline:none;background:#18181b;color:#e6e3f0;" +
      "font-family:'JetBrainsMono Nerd Font',monospace;font-size:13px;line-height:1.55;" +
      "white-space:pre;tab-size:4;overflow:auto;caret-color:#a78bfa";
    ta.addEventListener("input", run);
    ta.addEventListener("keyup", function () { maca.refresh(); });
    ta.addEventListener("click", function () { maca.refresh(); });
    ta.addEventListener("keydown", function (e) {
      if (e.key !== "Tab") return;
      e.preventDefault();
      const a = ta.selectionStart, b = ta.selectionEnd;
      ta.value = ta.value.slice(0, a) + "    " + ta.value.slice(b);
      ta.selectionStart = ta.selectionEnd = a + 4;
      run();
    });
    host.appendChild(ta);
    maca.set({ editor: "textarea" });
  }

  (async function boot() {
    await Promise.resolve();
    try {
      const b = bytesOf(document.getElementById("wasm-b64").textContent);
      const { instance } = await WebAssembly.instantiate(b, {});
      ex = instance.exports;
      maca.set({ ready: true, version: readPacked(ex.version()) });
    } catch (e) {
      maca.set({ trouble: "the compiler did not load: " + e.message });
    }
    mountEditor();
  })();
})();
"""

const HelloSrc = """
main() -> int {
    info("Hello from Maca")
    0
}
"""

const PageSrc = """
// A page rather than a print. A tag name called as a function is an element:
// named args are attributes, positional args are children. `value=` on a state
// name is two-way, so typing re-renders exactly the nodes that mention it.
// There is no repaint call, and there is not meant to be: assigning `who` is
// the request.
//
// The Preview tab runs this for real. The C tab is the same program rendered
// to an HTML string, which is what a site generator wants; the JS tab is what
// the Preview is running.
who = "world"

main() -> Element =>
    div(class="p-8 font-sans"
        h1(class="text-2xl font-bold text-violet-600", "Hello, {who}")
        input(class="mt-4 px-2 py-1 rounded border border-zinc-400",
              value=who)
        p(class="mt-3 text-sm text-zinc-500", "{len(who)} characters")
    )
"""

const TourSrc = """
// A tour of Maca's surface syntax in one program that type-checks clean.
// There is no `fn`, no `let` and no `type`: a bare `x = e` binds a mutable
// name, `const x = e` a constant, and the last expression is the value.

/* Block comments work too. */

Shape = Circle(float) | Rect(float, float)
Point = {
    x: int
    y: int
}

// An arrow body, and `match` over a sum with binding patterns.
area(s: Shape) -> float =>
    match s {
        Circle(r) => 3.14 * r * r
        Rect(w, h) => w * h
    }

// A block body: reassignment, `while`, `break`, and the spaced ternary.
collatz_steps(from: int) -> int {
    n = from
    steps = 0
    while n > 1 {
        n = n % 2 == 0 ? n / 2 : 3 * n + 1
        steps = steps + 1
        if steps > 1000 {
            break
        }
    }
    steps
}

// UFCS: `n.double()` is sugar for `double(n)`.
double(n: int) -> int => n * 2

main() -> int {
    xs = 1..6
    xs[0] = 10
    acc = 0
    for i in 0..len(xs) {
        acc = acc + xs[i]
    }
    info("acc {acc}, len {len(xs)}")

    p = Point { x = 1, y = 2 }
    q = p with { y = 9 }
    info("p.y {p.y}, q.y {q.y}, q.y.double() {q.y.double()}")

    info("circle {area(Circle(2.0))}, rect {area(Rect(3.0, 4.0))}")
    info("collatz(27) {collatz_steps(27)}")
    0
}
"""

const TreeSrc = """
// Recursive sum types: a self-referential payload is boxed, so a tree is an
// ordinary value and `match` on it has to be exhaustive. Drop an arm and the
// Diagnostics tab answers NonExhaustive instead of the program running.
Tree = Leaf(int) | Node(Tree, Tree)

total(t: Tree) -> int =>
    match t {
        Leaf(n) => n
        Node(l, r) => total(l) + total(r)
    }

depth(t: Tree) -> int =>
    match t {
        Leaf(n) => 1
        Node(l, r) => 1 + max(depth(l), depth(r))
    }

main() -> int {
    t = Node(Leaf(1), Node(Leaf(2), Leaf(3)))
    info("total {total(t)}, depth {depth(t)}")
    0
}
"""

const ListSrc = """
// Closures and the list methods. A lambda captures its enclosing scope, and a
// parameter that is *called* in the body is a function with no annotation
// needed: a function type is written down only in a record field.
apply_twice(n: int, f) -> int => f(f(n))

main() -> int {
    xs = 5, 3, 1, 4, 2
    step = 10

    shifted = xs.map(v => v + step)
    evens = xs.filter(v => v % 2 == 0)
    sum = xs.reduce(0, (a, v) => a + v)
    sorted = xs.sort()

    info("sorted {sorted[0]} to {xs.max()}, sum {sum}")
    info("shifted[0] {shifted[0]}, {len(evens)} even")
    info("apply_twice(20, +1) {apply_twice(20, v => v + 1)}")
    0
}
"""

const GuardSrc = """
// `return` leaves a function early, so a guard stands where it belongs rather
// than pushing the real work into an `else`. The tail is still the value, and
// both work in one function.
classify(n: int) -> str {
    if n < 0 {
        return "negative"
    }
    if n == 0 {
        return "zero"
    }
    n % 2 == 0 ? "even" : "odd"
}

// `return` is a statement, so it stands on a line of its own or as the tail of
// a branch. A ternary arm or a call argument is a TypeMismatch naming the
// function, because the value would have nowhere to go.
first_even(xs: int[]) -> int {
    for x in xs {
        if x % 2 == 0 {
            return x
        }
    }
    -1
}

main() -> int {
    info("{classify(-3)}, {classify(0)}, {classify(7)}, {classify(8)}")
    info("first even of 3 5 8 10: {first_even([3, 5, 8, 10])}")
    info("first even of 1 3 5: {first_even([1, 3, 5])}")
    0
}
"""

const AsyncSrc = """
// Colorblind async: there is no `async` keyword, and no second colour of
// function. `spawn f(x)` starts the call and answers a Future, `await` waits
// for one, and `sleep_ms` is a suspension point. Being async is an effect the
// checker infers, so `work` below is an ordinary function that happens to
// suspend, callable from anywhere.
work(n: int) -> int {
    sleep_ms(1)
    n * 2
}

main() -> int {
    a = spawn work(10)
    b = spawn work(20)
    info("{await a + await b}")
    0
}
"""

const FormatSrc = """
// An interpolation may carry a format spec: [align][0][width][.precision].
// The spec's `:` is attached and a ternary's is spaced, which is how the lexer
// tells `{q:>5}` from `{c ? a : b}`. It is sugar: the parser rewrites it to
// pad_start / pad_end / pad_center / fixed, so every back end gets it free.
row(name: str, qty: int, price: float) -> str =>
    "{name:<10}{qty:>5}{price:>10.2}"

main() -> int {
    info(row("widget", 3, 4.5))
    info(row("gasket", 128, 19.995))
    info(row("shim", 7, 0.5))
    info("pi {3.14159:.3}, zero padded {7:04}")
    0
}
"""

const ConfigSrc = """
// Config mode: the module *is* the configuration and it has to be pure, so
// there is no `main` and no `info`. `system.*` routes to NixOS, `user.*` to
// home-manager, and a block implies `enable = true`.
//
// The Nix tab is the module this compiles to. Add `info("hi")` and the
// Diagnostics tab answers EffectInConfig.
networking.hostName = "rigel"
system.stateVersion = "24.11"
system.packages = git, curl, ripgrep

services.openssh = {
    passwordAuthentication = false
}
"""

Example = {
    src:  str
    mode: int
    tab:  str
    note: str
}

example(name: str) -> Example {
    if name == "page" {
        return Example { src = PageSrc, mode = 0, tab = "Preview",
                         note = "a tag call is an element; Preview runs it" }
    }
    if name == "tour" {
        return Example { src = TourSrc, mode = 0, tab = "Console",
                         note = "most of the surface syntax in one program" }
    }
    if name == "tree" {
        return Example { src = TreeSrc, mode = 0, tab = "Console",
                         note = "recursive sums, and match that must be exhaustive" }
    }
    if name == "list" {
        return Example { src = ListSrc, mode = 0, tab = "Console",
                         note = "closures, and a function passed with no annotation" }
    }
    if name == "guard" {
        return Example { src = GuardSrc, mode = 0, tab = "Console",
                         note = "a guard that leaves the function early" }
    }
    if name == "async" {
        return Example { src = AsyncSrc, mode = 0, tab = "Console",
                         note = "spawn and await with no async keyword anywhere" }
    }
    if name == "format" {
        return Example { src = FormatSrc, mode = 0, tab = "Console",
                         note = "an interpolation carrying [align][0][width][.prec]" }
    }
    if name == "config" {
        return Example { src = ConfigSrc, mode = 1, tab = "Nix",
                         note = "the same language, compiled to a NixOS module" }
    }
    Example { src = HelloSrc, mode = 0, tab = "Console",
              note = "the smallest whole program" }
}

mode = 0
tab = "Console"
note = ""
ready = false
trouble = ""
version = ""
editor = ""

run() {
    answer = compile(source(), mode)

    if answer == "" {
        return
    }
    present(answer)
}

present(answer: str) {
    show(answer)
    syncPreview()
}

start() {
    link = opened()

    if link.program == "" {
        load("hello")
        return
    }
    edit(link.program)
    pick("")
    mode = link.mode
    tab = mode == 1 ? "Nix" : "Console"
    note = "loaded from a shared link"
    run()
}

load(name: str) {
    picked = example(name)

    edit(picked.src.trim())
    pick(name)
    mode = picked.mode
    tab = picked.tab
    note = picked.note
    run()
}

useProgram() {
    mode = 0
    tab = "Console"
    run()
}

useConfig() {
    mode = 1
    tab = "Nix"
    run()
}

share() {
    url = share_link(mode)

    note = url == "" ? "this page cannot rewrite its own address"
                     : "the whole program is in the address bar"
}

choose(which: str) {
    tab = which
    syncPreview()
}

syncPreview() {
    if tab != "Preview" || !buildsAPage() {
        preview("", "")
        return
    }
    preview(emitted("JS"), emitted("CSS"))
}

buildsAPage() -> bool {
    for s in symbols() {
        if s.name == "main" && s.detail.contains("-> Element") {
            return true
        }
    }
    false
}

brokenSource() -> bool {
    for p in problems() {
        if p.kind == "parse" {
            return true
        }
    }
    false
}

configDrops() -> str[] {
    out = []

    if mode != 1 {
        return out
    }
    for s in symbols() {
        if s.kind == "fn" {
            out = out.push(s.name)
        }
    }
    out
}

refusalText(pane: str) -> str {
    why = []

    for p in problems() {
        if p.kind == "refusal" && p.where == pane {
            why = why.push("  " ++ p.msg)
        }
    }
    if len(why) == 0 {
        return ""
    }
    "the {pane} back end will not lower this program:\n\n"
        ++ why.join("\n")
        ++ "\n\nEvery back end has this channel: it names the construct it "
        ++ "cannot carry\nrather than emitting code that would not compile."
}

problemLine(p: Problem) -> str {
    if p.kind == "parse" {
        p.msg
    } else if p.kind == "refusal" {
        "{p.where} back end: {p.msg}"
    } else {
        "{p.where}: {p.msg}"
    }
}

dropLine(name: str) -> str =>
    "config mode: `{name}` is a function, and a configuration is options "
        ++ "rather than code, so it is not in the Nix"

diagnosticsText() -> str {
    lines = []

    for p in problems() {
        lines = lines.push(problemLine(p))
    }
    for name in configDrops() {
        lines = lines.push(dropLine(name))
    }
    if len(lines) == 0 {
        return "parsed and type-checked clean"
    }
    lines.join("\n")
}

const UiNote = "`main` returns an Element, so this program builds a page instead of printing one.\n\nThe Preview tab runs it for real; JS and CSS are what it compiled to. Running it\nhere reports an unknown tag, because the interpreter has no DOM to build into."

consoleText() -> str {
    if trouble != "" {
        return "(nothing ran: {trouble})"
    }
    if !ready {
        return "(the compiler is still arriving)"
    }
    if brokenSource() {
        return "(nothing ran: fix the parse error in Diagnostics first)"
    }
    if buildsAPage() {
        return UiNote
    }
    ran = outcome()
    if !ran.ran {
        return "(config mode is pure, so there is nothing to run)"
    }
    if ran.error != "" {
        return ran.output ++ "\n! " ++ ran.error
    }
    ran.output == "" ? "(no output)" : ran.output
}

emptyNote(pane: str) -> str {
    if brokenSource() {
        "(fix the parse error first)"
    } else if mode == 1 {
        "(config mode emits Nix and nothing else)"
    } else if pane == "Nix" {
        "(Nix is what config mode emits: switch to config in the header)"
    } else {
        "(nothing here: {pane} came back empty for this program)"
    }
}

paneText(pane: str) -> str {
    if pane == "Preview" || pane == "Definitions" {
        return ""
    }
    if pane == "Diagnostics" {
        return diagnosticsText()
    }
    if pane == "Console" {
        return consoleText()
    }
    refused = refusalText(pane)
    if refused != "" {
        return refused
    }
    code = emitted(pane)
    if code == "" {
        return emptyNote(pane)
    }
    dropped = pane == "Nix" ? configDrops() : []
    if len(dropped) == 0 {
        return code
    }
    "this configuration does not carry {dropped.join(", ")}: a config module "
        ++ "is options, not code.\n\n" ++ code
}

previewNote() -> str {
    if brokenSource() {
        "the program does not parse yet"
    } else if emitted("JS") == "" {
        "config mode has no page to build"
    } else {
        "no page here: declare main() -> Element and return a tag call, such as div(class=\"p-4\", \"hello\")"
    }
}

escaped(s: str) -> str =>
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

outlineHtml() -> str {
    row(s: Sym) -> str =>
        "<div class='ol-item' onclick='reveal({s.line})'>"
            ++ "<span class='ol-kind ol-{s.kind}'>{s.kind}</span>"
            ++ "<span class='ol-name'>{escaped(s.name)}</span>"
            ++ "<span class='ol-detail'>{escaped(s.detail)}</span></div>"

    found = symbols()
    if len(found) == 0 {
        return "<div class='ol-empty'>no definitions in this program</div>"
    }
    out = ""
    for s in found {
        out = out ++ row(s)
    }
    out
}

plural(n: int) -> str =>
    n == 1 ? "" : "s"

verdict() -> str {
    n = len(problems()) + len(configDrops())

    n == 0 ? "compiled clean" : "{n} diagnostic{plural(n)}"
}

statusLine() -> str {
    if trouble != "" {
        return trouble
    }
    if !ready {
        return "loading the compiler"
    }
    verdict()
}

versionLine() -> str =>
    version == "" ? "" : "maca {version} (wasm)"

editorLine() -> str =>
    editor == "" ? "" : "{editor} editor"

runBadge() -> str {
    if buildsAPage() {
        return "builds a page"
    }
    ran = outcome()
    if !ran.ran {
        return ""
    }
    if ran.error != "" {
        return "failed"
    }
    ran.exited ? "exit {ran.exit}" : "ran"
}

timing() -> str {
    us = micros()

    if us <= 0 {
        return ""
    }
    tenths = int((us + 50) / 100)
    "{int(tenths / 10)}.{tenths % 10} ms"
}

scaled(n: int, unit: int) -> str {
    tenths = int(n * 10 / unit)

    "{int(tenths / 10)}.{tenths % 10}"
}

counted(n: int) -> str {
    if n >= 1000000000 {
        "{scaled(n, 1000000000)}B"
    } else if n >= 1000000 {
        "{scaled(n, 1000000)}M"
    } else if n >= 1000 {
        "{scaled(n, 1000)}k"
    } else {
        "{n}"
    }
}

stats() -> str {
    ran = outcome()

    if !ran.ran {
        return "run a program to profile it"
    }
    tail = ran.truncated ? ", truncated" : ""
    "{counted(ran.steps)} step{plural(ran.steps)}, "
        ++ "{counted(ran.calls)} call{plural(ran.calls)}, "
        ++ "depth {counted(ran.depth)}{tail}"
}

flameSvg() -> str =>
    outcome().flame

const Shell = "flex flex-col h-screen bg-zinc-950 text-zinc-100 font-sans"
const Bar = "flex flex-wrap items-center gap-x-3 gap-y-2 px-4 py-2 border-b border-zinc-800 bg-zinc-900"
const Brand = "font-mono text-sm font-bold text-violet-400 whitespace-nowrap"
const Kicker = "text-xs uppercase tracking-widest text-zinc-600 whitespace-nowrap max-sm:hidden"
const Segment = "flex items-center gap-1 rounded-lg border border-zinc-800 bg-zinc-950 p-1"
const ModeOn = "px-2.5 py-1 text-xs font-semibold rounded-md border-0 bg-violet-500 text-zinc-950 cursor-pointer"
const ModeOff = "px-2.5 py-1 text-xs rounded-md border-0 bg-transparent text-zinc-400 cursor-pointer hover:text-zinc-100"
const Picker = "px-2 py-1 text-xs rounded-md border border-zinc-800 bg-zinc-950 text-zinc-300 cursor-pointer"
const Ghost = "px-3 py-1 text-xs rounded-md border border-zinc-700 bg-transparent text-zinc-300 cursor-pointer hover:text-zinc-100 hover:border-zinc-500"
const Primary = "px-3 py-1 text-xs font-semibold rounded-md border-0 bg-violet-500 text-zinc-950 cursor-pointer hover:bg-violet-400"
const Split = "flex-1 min-h-0 flex flex-col md:flex-row"
const EditorSide = "flex flex-col flex-1 min-h-0 min-w-0 border-b border-zinc-800 md:border-b-0 md:border-r md:border-zinc-800"
const OutputSide = "flex flex-col flex-1 min-h-0 min-w-0 bg-zinc-950"
const PaneHead = "flex items-center gap-2 px-3 py-2 border-b border-zinc-800 bg-zinc-900"
const PaneTitle = "text-xs uppercase tracking-wider text-zinc-500 font-semibold"
const Meta = "text-xs font-mono text-zinc-500 tabular-nums whitespace-nowrap"
const Tabs = "flex items-center gap-1 px-2 py-2 border-b border-zinc-800 bg-zinc-900 overflow-x-auto"
const TabOn = "px-3 py-1.5 text-xs rounded-md border-0 bg-zinc-800 text-violet-300 font-medium cursor-pointer whitespace-nowrap"
const TabOff = "px-3 py-1.5 text-xs rounded-md border-0 bg-transparent text-zinc-500 cursor-pointer whitespace-nowrap hover:text-zinc-200"
const TextPane = "flex-1 min-h-0 m-0 overflow-auto p-4 font-mono text-sm leading-relaxed whitespace-pre-wrap break-words text-zinc-300"
const OutlinePane = "flex-1 min-h-0 overflow-auto p-2"
const PreviewPane = "flex-1 min-h-0 flex flex-col"
const PreviewFrame = "flex-1 min-h-0 overflow-hidden bg-white"
const PreviewNote = "p-4 font-mono text-sm leading-relaxed text-zinc-500"
const Profiler = "flex-none border-t border-zinc-800 p-3 bg-zinc-900"
const Foot = "flex items-center gap-3 px-4 py-2 text-xs border-t border-zinc-800 bg-zinc-900"

tabInMode(name: str) -> bool {
    if mode == 1 {
        name == "Diagnostics" || name == "Definitions" || name == "Nix"
    } else {
        name != "Nix"
    }
}

tabClass(name: str) -> str {
    if !tabInMode(name) {
        "hidden"
    } else if name == tab {
        TabOn
    } else {
        TabOff
    }
}

modeClass(want: int) -> str =>
    mode == want ? ModeOn : ModeOff

textPaneClass() -> str =>
    tab == "Preview" || tab == "Definitions" ? "hidden" : TextPane

outlinePaneClass() -> str =>
    tab == "Definitions" ? OutlinePane : "hidden"

previewPaneClass() -> str =>
    tab == "Preview" ? PreviewPane : "hidden"

previewFrameClass() -> str =>
    buildsAPage() ? PreviewFrame : "hidden"

previewNoteClass() -> str =>
    buildsAPage() ? "hidden" : PreviewNote

profilerClass() -> str =>
    flameSvg() == "" ? "hidden" : Profiler

main() -> Element =>
    div(class=Shell
        link(rel="stylesheet", href="../fonts/fonts.css")
        header(class=Bar
            span(class=Brand, "◆ maca")
            span(class=Kicker, "playground")
            div(class=Segment
                button(class=modeClass(0), onclick=useProgram, "program")
                button(class=modeClass(1), onclick=useConfig, "config")
            )
            select(id="examples", class=Picker,
                   onchange=(e => load(e.target.value))
                option(value="", "examples")
                option(value="hello", "hello")
                option(value="page", "a page")
                option(value="tour", "the syntax")
                option(value="tree", "sum types")
                option(value="list", "closures")
                option(value="guard", "early return")
                option(value="async", "async")
                option(value="format", "format specs")
                option(value="config", "config mode")
            )
            span(class="text-xs text-zinc-500 truncate max-w-sm max-sm:hidden", note)
            div(class="flex-1")
            button(class=Ghost, onclick=share, "Share")
            button(class=Primary, onclick=run, "Run")
        )
        div(class=Split
            section(class=EditorSide
                div(class=PaneHead
                    span(class=PaneTitle, "source")
                    div(class="flex-1")
                    span(class=Meta, timing())
                )
                div(id="editor",
                    class="relative flex-1 min-h-0 overflow-hidden bg-zinc-900")
            )
            section(class=OutputSide
                div(class=Tabs
                    button(class=tabClass("Diagnostics"),
                           onclick=(e => choose("Diagnostics")), "Diagnostics")
                    button(class=tabClass("Console"),
                           onclick=(e => choose("Console")), "Console")
                    button(class=tabClass("Preview"),
                           onclick=(e => choose("Preview")), "Preview")
                    button(class=tabClass("Definitions"),
                           onclick=(e => choose("Definitions")), "Definitions")
                    button(class=tabClass("C"),
                           onclick=(e => choose("C")), "C")
                    button(class=tabClass("JS"),
                           onclick=(e => choose("JS")), "JS")
                    button(class=tabClass("CSS"),
                           onclick=(e => choose("CSS")), "CSS")
                    button(class=tabClass("Nix"),
                           onclick=(e => choose("Nix")), "Nix")
                    div(class="flex-1")
                    span(class=Meta, runBadge())
                )
                pre(class=textPaneClass(), paneText(tab))
                div(class=outlinePaneClass(), html=outlineHtml())
                div(class=previewPaneClass()
                    div(id="preview", class=previewFrameClass())
                    div(class=previewNoteClass(), previewNote())
                )
                div(class=profilerClass()
                    div(class="flex items-baseline gap-2 mb-2"
                        span(class=PaneTitle, "profiler")
                        div(class="flex-1")
                        span(class=Meta, stats())
                    )
                    div(class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950",
                        html=flameSvg())
                )
            )
        )
        footer(class=Foot
            span(class="font-mono text-zinc-400 truncate", hovered())
            div(class="flex-1")
            span(class="text-zinc-500 whitespace-nowrap", statusLine())
            span(class="font-mono text-zinc-600 whitespace-nowrap", editorLine())
            span(class="font-mono text-zinc-600 whitespace-nowrap", versionLine())
        )
    )
