import wasm "../../target/wasm32-unknown-unknown/release/maca_wasm.wasm"

import css """
.ol-item { display: flex; align-items: baseline; gap: .4rem; padding: .2rem .5rem;
  border-radius: .3rem; cursor: pointer; white-space: nowrap; overflow: hidden;
  text-overflow: ellipsis; }
.ol-item:hover { background: #1c1c22; }
.ol-name { color: #e6e3f0; }
.ol-detail { color: #6b6b78; font-size: .72rem; }
.ol-kind { font-size: .58rem; text-transform: uppercase; letter-spacing: .04em;
  padding: .05rem .32rem; border-radius: .25rem; font-weight: 600; flex: none; }
.ol-fn { background: #2a2350; color: #c4b5fd; }
.ol-type { background: #3a2a12; color: #fbbf24; }
.ol-value { background: #0f2f28; color: #34d399; }
.ol-option { background: #102a3a; color: #38bdf8; }
.ol-empty { color: #5f6577; padding: .4rem .5rem; font-size: .8rem; }
"""

import js """
"use strict";
// Host shim for the Maca-authored playground (playground.maca → app.js).
//
// The Maca app owns the UI, state, and control flow; this file provides the
// browser-API glue Maca can't express itself: instantiating the WebAssembly
// compiler, reading its packed return value out of linear memory, and holding
// the last result so the app's `mc*` getters can read it. Think of it as the
// playground's runtime, the way `maca-runtime` is the native runtime.
//
// The example programs are NOT here. They are Maca constants in the Maca half
// of this file, which is where a reader looks for them and where a test can
// check that each one still compiles clean.
(function () {
  let ex = null;       // wasm exports
  let last = null;     // last compile result (parsed JSON)
  let lastMode = 0;    // the mode `last` was compiled in (0 program, 1 config)
  let lastMs = 0;      // wall-clock of the last compile+run
  let version = "";
  let statusText = "loading…";

  // ---- a shareable link, with nothing sent anywhere -------------------------
  //
  // `#p=<base64url source>&m=<mode>`. A fragment is the one part of a URL the
  // browser never puts on the wire, so the link carries the whole program to
  // whoever opens it and to nobody else. No server, no paste service, no id.
  function b64urlEncode(text) {
    const bytes = new TextEncoder().encode(text);
    let bin = "";
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  }
  function b64urlDecode(text) {
    const bin = atob(text.replace(/-/g, "+").replace(/_/g, "/"));
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }
  let urlProgram = "";
  let urlMode = 0;
  try {
    const parts = {};
    for (const kv of location.hash.replace(/^#/, "").split("&")) {
      const eq = kv.indexOf("=");
      if (eq > 0) parts[kv.slice(0, eq)] = kv.slice(eq + 1);
    }
    if (parts.p) {
      urlProgram = b64urlDecode(parts.p);
      urlMode = parts.m === "1" ? 1 : 0;
    }
  } catch (e) {
    urlProgram = "";   // a hand-edited fragment is not a reason to show nothing
  }
  window.mcUrlProgram = function () { return urlProgram; };
  window.mcUrlMode = function () { return urlMode; };
  window.mcShare = function (mode) {
    const link = location.origin + location.pathname +
      "#p=" + b64urlEncode(window.mcSource()) + "&m=" + (mode | 0);
    // Into the address bar first: that works with the clipboard blocked, and it
    // is what makes the tab itself reloadable.
    history.replaceState(null, "", link);
    statusText = "link is in the address bar";
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(link).then(function () {
        statusText = "link copied";
        if (typeof update === "function") update();
      }, function () {});
    }
  };

  // ---- the example picker ---------------------------------------------------
  // Reading a <select> and writing its selection is browser API; which examples
  // exist, and what each one says, is Maca.
  window.mcPicked = function () {
    const el = document.getElementById("examples");
    return el ? el.value : "hello";
  };
  window.mcSetPicked = function (name) {
    const el = document.getElementById("examples");
    if (el) el.value = name;
  };

  // ---- wasm bridge ---------------------------------------------------------
  function b64ToBytes(b64) {
    const bin = atob(b64.trim());
    const arr = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
    return arr;
  }
  function mem() { return new Uint8Array(ex.memory.buffer); }
  function readPacked(packed) {
    const ptr = Number(packed >> 32n), len = Number(packed & 0xffffffffn);
    const out = new TextDecoder().decode(mem().slice(ptr, ptr + len));
    ex.dealloc(ptr, len);
    return out;
  }
  function wasmRun(src, mode) {
    const bytes = new TextEncoder().encode(src);
    const p = ex.alloc(bytes.length);
    mem().set(bytes, p);
    const json = readPacked(ex.run(p, bytes.length, mode));
    ex.dealloc(p, bytes.length);
    return JSON.parse(json);
  }

  // ---- content helpers -----------------------------------------------------
  //
  // A back end's refusal belongs with the type errors: it is a compile-time no,
  // decided by name, and the reason a target's tab is empty.
  function refusals(r) {
    const out = [];
    const limits = (r && r.limits) || {};
    for (const target of Object.keys(limits)) {
      for (const why of limits[target]) out.push([target, why]);
    }
    return out;
  }
  // Definitions a configuration has no place for. Config mode's root module
  // *is* the configuration: a function is code, and the Nix back end drops it
  // without a word, so a whole program compiled as config comes back "clean"
  // with an empty module. Named here because an empty answer the page calls
  // clean is worse than an error.
  function configDrops() {
    if (lastMode !== 1) return [];
    return ((last && last.symbols) || [])
      .filter(function (s) { return s.kind === "fn"; })
      .map(function (s) { return s.name; });
  }
  function diagText(r) {
    const lines = [];
    for (const e of r.parseErrors || []) lines.push("parse: " + e);
    for (const d of r.diagnostics || []) lines.push(d.kind + ": " + d.msg);
    for (const [target, why] of refusals(r)) {
      lines.push(target + " back end: " + why);
    }
    for (const name of configDrops()) {
      lines.push("config mode: `" + name + "` is a function, and a " +
        "configuration is options rather than code, so it is not in the Nix");
    }
    if (!lines.length) return "✓ parsed and type-checked clean";
    return lines.join("\n");
  }

  // A UI program is one whose `main` is declared to return an Element. That
  // declaration is what the js back end mounts and what the C back end renders
  // to an HTML string, and it is also why the interpreter refuses to run it: a
  // tag call needs a DOM and the interpreter has none.
  function isUiProgram() {
    return ((last && last.symbols) || []).some(function (s) {
      return s.name === "main" && (s.detail || "").indexOf("-> Element") >= 0;
    });
  }
  const UI_NOTE =
    "`main` returns an Element, so this program builds a page instead of " +
    "printing one.\n\nThe Preview tab runs it for real; JS and CSS are what " +
    "it compiled to. Running it\nhere reports an unknown tag because the " +
    "interpreter has no DOM to build into.";

  // `run` is absent for exactly two reasons, and they are not the same reason:
  // config mode has nothing to run, and a program that does not parse has
  // nothing to run *yet*. Console is the opening tab, so the first thing a
  // mistyped brace used to say was that the reader had picked config mode.
  function consoleText(r) {
    if ((r.parseErrors || []).length) {
      return "(nothing ran: fix the parse error in Diagnostics first)";
    }
    if (isUiProgram()) return UI_NOTE;
    const ran = r.run;
    if (!ran) return "(config mode is pure, so there is nothing to run)";
    let body = ran.output || "";
    if (ran.error) {
      body += (body && !body.endsWith("\n") ? "\n" : "") + "⚠ " + ran.error;
    }
    return body || "(no output)";
  }

  // What a target says when it refused, rather than the code it did not write.
  function limitText(target) {
    const why = refusals(last).filter(function (r) { return r[0] === target; });
    if (!why.length) return "";
    return "the " + target + " back end will not lower this program:\n\n" +
      why.map(function (r) { return "  " + r[1]; }).join("\n") +
      "\n\nEvery back end has this channel: it names the construct it cannot " +
      "carry rather\nthan emitting code that would not compile.";
  }

  // Why a target's tab is blank, when nothing was refused either. `lastMode`
  // rather than a guess: every branch here used to end in a sentence about
  // config mode, which a program-mode reader was told for no reason.
  function emptyNote(tab) {
    if ((last.parseErrors || []).length) return "(fix the parse error first)";
    if (lastMode === 1) {
      return "(config mode emits Nix and nothing else)";
    }
    if (tab === "Nix") {
      return "(Nix is what config mode emits: switch to config in the header)";
    }
    return "(nothing here: " + tab + " came back empty for this program)";
  }

  function fmtN(n) {
    if (n >= 1e9) return (n / 1e9).toFixed(2) + "B";
    if (n >= 1e6) return (n / 1e6).toFixed(2) + "M";
    if (n >= 1e3) return (n / 1e3).toFixed(1) + "k";
    return String(n);
  }

  // ---- API consumed by the Maca app (global `mc*` functions) ---------------
  //
  // One door for "a compile result arrived": everything the panes read comes
  // from here, and `mcCompile` is this plus the wasm call. Anything that
  // compiled elsewhere (a worker, a server, a test) uses the same door.
  window.mcShow = function (result, mode) {
    lastMode = mode | 0;
    last = typeof result === "string" ? JSON.parse(result) : result;
    const n = (last.parseErrors || []).length +
      (last.diagnostics || []).length + refusals(last).length +
      configDrops().length;
    statusText = n ? (n + " diagnostic" + (n > 1 ? "s" : "")) : "compiled clean";
    if (window.mcMarkers) window.mcMarkers();
  };
  window.mcCompile = function (src, mode) {
    if (!ex) { statusText = "loading…"; return; }
    try {
      const t0 = performance.now();
      const result = wasmRun(src, mode | 0);
      lastMs = performance.now() - t0;
      window.mcShow(result, mode);
    } catch (e) {
      window.mcShow(
        { parseErrors: ["internal: " + e.message], diagnostics: [], outputs: {} },
        mode);
      statusText = "error";
    }
  };
  // The text pane's body. Preview is the one tab that is not text: it has its
  // own element, and asking for it here would answer with a note nobody sees.
  window.mcTab = function (tab) {
    if (!last || tab === "Preview") return "";
    if (tab === "Diagnostics") return diagText(last);
    if (tab === "Console") return consoleText(last);
    const refused = limitText(tab);
    if (refused) return refused;
    const code = (last.outputs || {})[tab];
    if (!code) return emptyNote(tab);
    // The switch in the header puts any program one click from config mode, so
    // say what the module left out rather than showing a short one.
    const dropped = tab === "Nix" ? configDrops() : [];
    if (dropped.length) {
      return "this configuration does not carry " + dropped.join(", ") +
        ": a config module is options, not code.\n\n" + code;
    }
    return code;
  };
  // What the run answered with, in the width of a word: the exit status is in
  // the JSON and used to be nowhere on the page.
  window.mcRunBadge = function () {
    if (!last) return "";
    if (isUiProgram()) return "builds a page";
    const ran = last.run;
    if (!ran) return "";
    if (ran.error) return "failed";
    return ran.exit === null ? "ran" : "exit " + ran.exit;
  };
  window.mcFlame = function () {
    const p = last && last.run && last.run.profile;
    return (p && p.flameSvg) || "";
  };
  window.mcStatus = function () { return statusText; };
  window.mcVersion = function () { return version ? "maca " + version + " (wasm)" : ""; };

  // ---- live preview: the emitted JS, actually running ----------------------
  //
  // Byte for byte the JS and CSS that `maca build --target js` would write,
  // running in a sandboxed iframe. Rebuilt only when the emitted code changes,
  // so editing a comment does not restart the program under the cursor.
  let previewKey = null;
  window.mcRenderPreview = function () {
    const host = document.getElementById("preview");
    if (!host) return;
    const emitted = (last && last.outputs) || {};
    const js = emitted.JS || "";
    if (!js || !isUiProgram()) {
      previewKey = null;
      host.innerHTML = '<div class="ol-empty">' + esc(previewNote()) + "</div>";
      return;
    }
    const css = emitted.CSS || "";
    // A separator no source can contain, so a change to either half is a
    // change to the key. Written as an escape rather than as the byte
    // itself: a raw block is raw, and a literal NUL in this file makes the
    // page it emits unreadable to anything that stops at one.
    const key = css + "\0" + js;
    if (key === previewKey) return;
    previewKey = key;
    const frame = document.createElement("iframe");
    frame.setAttribute("sandbox", "allow-scripts");
    frame.setAttribute("title", "preview");
    frame.style.cssText = "width:100%;height:100%;border:0;background:#ffffff";
    // A program whose own text contains `</script` would otherwise close the
    // tag early and the rest of it would render as page content.
    frame.srcdoc = '<!doctype html><meta charset="utf-8"><style>' + css +
      '</style><div id="app"></div><script>' +
      js.replace(/<\/script/gi, "<\\/script") + "<\/script>";
    host.innerHTML = "";
    host.appendChild(frame);
  };
  function previewNote() {
    if (!last) return "compiling";
    if ((last.parseErrors || []).length) return "the program does not parse yet";
    if (!(last.outputs || {}).JS) return "config mode has no page to build";
    return "no page here: declare main() -> Element and return a tag call, " +
      "such as div(class=\"p-4\", \"hello\")";
  }

  // ---- shared helpers ------------------------------------------------------
  function esc(s) {
    return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  // The active editor is Monaco when its CDN is reachable, else a plain
  // textarea (offline / strict-CSP fallback). These two accessors hide which.
  // Empty until the Maca app's `start()` puts either the shared program or the
  // opening example here, which is why the examples do not need to exist twice.
  let editor = null, monaco = null;
  let PENDING_SRC = "";
  window.mcSource = function () {
    if (editor) return editor.getValue();
    const ta = document.getElementById("ed");
    return ta ? ta.value : PENDING_SRC;
  };
  window.mcSetSource = function (text) {
    PENDING_SRC = text || "";
    if (editor) editor.setValue(PENDING_SRC);
    else { const ta = document.getElementById("ed"); if (ta) ta.value = PENDING_SRC; }
  };

  // Everything the language server has to say about one caret, in one call:
  // hover, signature help, the definition site, and every reference. The editor
  // asks all four about the same position, and a call each would re-parse the
  // file four times.
  //
  // `off` is a UTF-16 offset (Monaco's unit) and the wasm wants bytes, so the
  // prefix is re-encoded to convert. The ranges coming back are already
  // 1-based line/column with UTF-16 columns, which is what Monaco wants.
  function wasmLsp(src, off) {
    if (!ex || !ex.lsp) return null;
    try {
      const bytes = new TextEncoder().encode(src);
      const boff = new TextEncoder().encode(src.slice(0, off)).length;
      const p = ex.alloc(bytes.length); mem().set(bytes, p);
      const out = readPacked(ex.lsp(p, bytes.length, boff));
      ex.dealloc(p, bytes.length);
      return JSON.parse(out);
    } catch (e) { return null; }
  }
  function wasmHover(src, off) {
    const info = wasmLsp(src, off);
    return (info && info.hover) || "";
  }
  function monacoRange(r) {
    return {
      startLineNumber: r.line, startColumn: r.col,
      endLineNumber: r.endLine, endColumn: r.endCol,
    };
  }

  // ---- definition outline (document symbols) -------------------------------
  window.mcOutline = function () {
    const syms = (last && last.symbols) || [];
    if (!syms.length) return '<div class="ol-empty">no definitions</div>';
    let html = "";
    for (const s of syms) {
      const detail = s.detail ? '<span class="ol-detail">' + esc(s.detail) + "</span>" : "";
      html +=
        '<div class="ol-item" onclick="mcGoto(' + (s.line | 0) + ')">' +
        '<span class="ol-kind ol-' + s.kind + '">' + esc(s.kind) + "</span>" +
        '<span class="ol-name">' + esc(s.name) + "</span>" + detail + "</div>";
    }
    return html;
  };
  window.mcGoto = function (line) {
    if (line < 1) return;
    if (editor) {
      editor.revealLineInCenterIfOutsideViewport(line);
      editor.setPosition({ lineNumber: line, column: 1 });
      editor.focus();
    } else {
      const ta = document.getElementById("ed");
      if (!ta) return;
      const lines = ta.value.split("\n");
      let off = 0;
      for (let i = 0; i < line - 1 && i < lines.length; i++) off += lines[i].length + 1;
      ta.focus();
      ta.setSelectionRange(off, off);
    }
    if (typeof update === "function") update();
  };

  // ---- LSP hover (signature/type of the identifier under the caret) --------
  window.mcHover = function () {
    const src = window.mcSource();
    let off = 0;
    if (editor) {
      const pos = editor.getPosition();
      if (pos) off = editor.getModel().getOffsetAt(pos);
    } else {
      const ta = document.getElementById("ed");
      if (!ta || document.activeElement !== ta) return "";
      off = ta.selectionStart | 0;
    }
    const info = wasmHover(src, off);
    return info ? "ⓘ " + info : "";
  };

  // ---- profiler split: a prominent wall-clock, then the counters -----------
  window.mcMs = function () {
    if (!last || !last.run) return "-";
    return lastMs.toFixed(lastMs < 10 ? 2 : 1) + " ms";
  };
  window.mcStats = function () {
    const p = last && last.run && last.run.profile;
    if (!p) return "run a program to profile it";
    const t = p.truncated ? ", truncated" : "";
    return `${fmtN(p.steps)} steps, ${fmtN(p.totalCalls)} calls, depth ${fmtN(p.maxDepth)}${t}`;
  };

  // ---- diagnostics as editor markers (squiggles) --------------------------
  // the wasm returns Monaco-ready spans (precise for parse errors, best-effort
  // for semantic diagnostics), all as errors: the compiler rejects them all.
  function setMarkers() {
    if (!editor || !monaco || !last) return;
    const sev = {
      error: monaco.MarkerSeverity.Error,
      warning: monaco.MarkerSeverity.Warning,
      info: monaco.MarkerSeverity.Info,
    };
    const ms = (last.markers || []).map(function (m) {
      return {
        severity: sev[m.severity] || monaco.MarkerSeverity.Error,
        message: m.message,
        startLineNumber: m.line, startColumn: m.col,
        endLineNumber: m.endLine, endColumn: m.endCol,
      };
    });
    monaco.editor.setModelMarkers(editor.getModel(), "maca", ms);
  }
  window.mcMarkers = setMarkers;

  // ---- register the Maca language, theme, and LSP providers with Monaco ----
  function defineMacaLanguage(m) {
    m.languages.register({ id: "maca" });
    m.languages.setLanguageConfiguration("maca", {
      comments: { lineComment: "//", blockComment: ["/*", "*/"] },
      brackets: [["{", "}"], ["[", "]"], ["(", ")"]],
      autoClosingPairs: [
        { open: "{", close: "}" }, { open: "[", close: "]" },
        { open: "(", close: ")" }, { open: '"', close: '"' },
      ],
    });
    m.languages.setMonarchTokensProvider("maca", {
      keywords: ["const", "as", "if", "else", "for", "in", "while", "break", "continue", "return", "match", "import", "from", "with", "fail", "try", "alias", "await", "spawn", "true", "false"],
      typeKeywords: ["int", "float", "str", "bool", "bytes"],
      tokenizer: {
        root: [
          // `///` is a doc comment, what macadoc reads as API. Listed first
          // so the plain `//` rule doesn't claim it.
          [/\/\/\/[^\/].*$|\/\/\/$/, "comment.doc"],
          [/\/\/.*$/, "comment"],
          [/\/\*/, "comment", "@block"],
          [/"{3}/, "string", "@raw"],
          [/"/, "string", "@str"],
          // path literals (mirror the lexer): ~, ./, ../, or / + a path char.
          // A bare / needs a following path char so `a / b` stays division.
          [/(?:~|\.\.?\/|\/(?=[A-Za-z0-9_.~/-]))[A-Za-z0-9_.~/-]*/, "string"],
          [/\b\d[\d_]*\.\d[\d_]*\b/, "number.float"],
          [/\b0[xXbBoO][0-9a-fA-F_]+\b/, "number.hex"],
          [/\b\d[\d_]*\b/, "number"],
          // idents carry Nix-style internal hyphens (rust-analyzer, home-manager)
          [/[A-Z]\w*(?:-[A-Za-z_]\w*)*/, "type"],
          [/[a-z_]\w*(?:-[A-Za-z_]\w*)*/, { cases: { "@keywords": "keyword", "@typeKeywords": "type", "@default": "identifier" } }],
          [/[{}()\[\]]/, "@brackets"],
          [/->|=>|\.\.|[-+*/%<>=!&|?:]+/, "operator"],
          [/\./, "delimiter"],
        ],
        block: [[/[^*/]+/, "comment"], [/\*\//, "comment", "@pop"], [/[*/]/, "comment"]],
        str: [
          [/\{\{|\}\}/, "string.escape"],
          [/[^\\"{}]+/, "string"],
          [/\{/, "delimiter", "@interp"],
          [/\\./, "string.escape"],
          [/"/, "string", "@pop"],
          [/[{}]/, "string"],
        ],
        interp: [
          [/\}/, "delimiter", "@pop"],
          [/"/, "string", "@str"],
          [/\b\d[\d_]*\.\d[\d_]*\b/, "number.float"],
          [/\b0[xXbBoO][0-9a-fA-F_]+\b/, "number.hex"],
          [/\b\d[\d_]*\b/, "number"],
          [/[A-Z]\w*(?:-[A-Za-z_]\w*)*/, "type"],
          [/[a-z_]\w*(?:-[A-Za-z_]\w*)*/, { cases: { "@keywords": "keyword", "@typeKeywords": "type", "@default": "identifier" } }],
          [/->|=>|\.\.|[-+*/%<>=!&|?:]+/, "operator"],
          [/[^}]/, ""],
        ],
        raw: [[/"{3}/, "string", "@pop"], [/[^"]+/, "string"], [/"/, "string"]],
      },
    });
    m.editor.defineTheme("maca-dark", {
      base: "vs-dark", inherit: true,
      rules: [
        { token: "comment", foreground: "7d8590", fontStyle: "italic" },
        { token: "comment.doc", foreground: "8b9cb0", fontStyle: "italic" },
        { token: "keyword", foreground: "c792ea" },
        { token: "type", foreground: "ffcb6b" },
        { token: "string", foreground: "c3e88d" },
        { token: "string.escape", foreground: "89ddff" },
        { token: "number", foreground: "f78c6c" },
        { token: "operator", foreground: "89ddff" },
        { token: "delimiter", foreground: "89ddff" },
        { token: "identifier", foreground: "e6e3f0" },
      ],
      colors: {
        "editor.background": "#18181b",
        "editor.foreground": "#e6e3f0",
        "editorLineNumber.foreground": "#3f3f46",
        "editorCursor.foreground": "#a78bfa",
        "editor.selectionBackground": "#3b3564",
        "editor.lineHighlightBackground": "#1f1f23",
      },
    });
    m.languages.registerHoverProvider("maca", {
      provideHover: function (model, pos) {
        const info = wasmHover(model.getValue(), model.getOffsetAt(pos));
        return info ? { contents: [{ value: "```maca\n" + info + "\n```" }] } : null;
      },
    });
    m.languages.registerCompletionItemProvider("maca", {
      provideCompletionItems: function (model, pos) {
        const w = model.getWordUntilPosition(pos);
        const range = { startLineNumber: pos.lineNumber, endLineNumber: pos.lineNumber, startColumn: w.startColumn, endColumn: w.endColumn };
        const K = m.languages.CompletionItemKind, items = [];
        const add = (label, kind, detail) => items.push({ label, kind, insertText: label, range, detail });
        ["const", "as", "if", "else", "for", "in", "while", "break", "continue", "return", "match", "import", "with", "fail", "try", "true", "false"].forEach(k => add(k, K.Keyword));
        ["int", "float", "str", "bool", "bytes"].forEach(t => add(t, K.TypeParameter, "type"));
        ["info", "warn", "err", "print", "len", "str", "int", "float"].forEach(b => add(b, K.Function, "builtin"));
        for (const s of (last && last.symbols || [])) {
          add(s.name, s.kind === "type" ? K.Struct : s.kind === "fn" ? K.Function : K.Variable, s.detail || s.kind);
        }
        return { suggestions: items };
      },
    });
    // Signature help while the call is still being typed: the callee's
    // signature, with the parameter under the caret picked out. `maca-lsp`
    // counts the commas, so the answer is the same one the editor gives.
    m.languages.registerSignatureHelpProvider("maca", {
      signatureHelpTriggerCharacters: ["(", ","],
      provideSignatureHelp: function (model, pos) {
        const info = wasmLsp(model.getValue(), model.getOffsetAt(pos));
        const sig = info && info.signature;
        if (!sig) return null;
        return {
          value: {
            signatures: [{
              label: sig.label,
              parameters: (sig.params || []).map(function (p) {
                return { label: p };
              }),
            }],
            activeSignature: 0,
            activeParameter: sig.active | 0,
          },
          dispose: function () {},
        };
      },
    });
    // Ctrl-click / F12 jumps to where the name is bound.
    m.languages.registerDefinitionProvider("maca", {
      provideDefinition: function (model, pos) {
        const info = wasmLsp(model.getValue(), model.getOffsetAt(pos));
        const at = info && info.definition;
        return at ? { uri: model.uri, range: monacoRange(at) } : null;
      },
    });
    // Resting on a name marks every other mention of the *same binding*, which
    // is scope-aware rather than a text search: a parameter named `n` in one
    // function does not light up an `n` in another.
    m.languages.registerDocumentHighlightProvider("maca", {
      provideDocumentHighlights: function (model, pos) {
        const info = wasmLsp(model.getValue(), model.getOffsetAt(pos));
        return ((info && info.references) || []).map(function (r) {
          return {
            range: monacoRange(r),
            kind: m.languages.DocumentHighlightKind.Text,
          };
        });
      },
    });
  }

  // The first render is `start()`, not `run()`: only the Maca side knows which
  // program to open with, and only the bridge has read the URL fragment.
  let started = false;
  function firstRender() {
    if (!started && typeof start === "function") {
      started = true;
      start();
    } else if (typeof run === "function") {
      run();
    }
  }

  // ---- mount Monaco (from CDN); fall back to a plain textarea if it can't ---
  const MONACO_CDN = "https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs";
  function mountMonaco() {
    const host = document.getElementById("editor");
    if (!host) return;
    // cross-domain worker proxy (the worker imports the real one from the CDN)
    window.MonacoEnvironment = {
      getWorkerUrl: function () {
        return "data:text/javascript;charset=utf-8," + encodeURIComponent(
          "self.MonacoEnvironment={baseUrl:'" + MONACO_CDN + "/'};importScripts('" + MONACO_CDN + "/base/worker/workerMain.js');"
        );
      },
    };
    // if the CDN can't be reached (offline / strict CSP), fall back to a plain
    // textarea so there's always a usable editor.
    let fell = false;
    const fallback = function () {
      if (fell || editor) return;
      fell = true;
      buildFallback(host);
      firstRender();
    };
    const timer = setTimeout(fallback, 6000);
    const s = document.createElement("script");
    s.src = MONACO_CDN + "/loader.js";
    s.onload = function () {
      require.config({ paths: { vs: MONACO_CDN } });
      require(["vs/editor/editor.main"], function () {
        if (fell) return;
        clearTimeout(timer);
        monaco = window.monaco;
        defineMacaLanguage(monaco);
        editor = monaco.editor.create(host, {
          value: PENDING_SRC, language: "maca", theme: "maca-dark",
          fontFamily: "ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace",
          fontSize: 13, tabSize: 4, insertSpaces: true, minimap: { enabled: false },
          automaticLayout: true, scrollBeyondLastLine: false, smoothScrolling: true,
          padding: { top: 12, bottom: 12 }, renderLineHighlight: "line",
        });
        let t;
        editor.onDidChangeModelContent(function () {
          clearTimeout(t);
          t = setTimeout(function () { if (typeof run === "function") run(); }, 120);
        });
        editor.onDidChangeCursorPosition(function () { if (typeof update === "function") update(); });
        statusText = "ready (monaco)";
        firstRender();
      });
    };
    s.onerror = function () { clearTimeout(timer); fallback(); };
    document.head.appendChild(s);
  }

  // Plain-textarea fallback: real monospace, tab-to-indent, recompiles on input.
  function buildFallback(host) {
    host.innerHTML = "";
    const ta = document.createElement("textarea");
    ta.id = "ed"; ta.spellcheck = false; ta.value = PENDING_SRC; ta.setAttribute("wrap", "off");
    ta.style.cssText = "position:absolute;inset:0;width:100%;height:100%;box-sizing:border-box;" +
      "margin:0;border:0;padding:16px;resize:none;outline:none;background:#18181b;color:#e6e3f0;" +
      "font-family:ui-monospace,'JetBrains Mono',Menlo,monospace;font-size:13px;line-height:1.55;" +
      "white-space:pre;tab-size:4;overflow:auto;caret-color:#a78bfa";
    ta.addEventListener("input", function () { if (typeof run === "function") run(); });
    ta.addEventListener("keyup", function () { if (typeof update === "function") update(); });
    ta.addEventListener("click", function () { if (typeof update === "function") update(); });
    ta.addEventListener("keydown", function (e) {
      if (e.key === "Tab") {
        e.preventDefault();
        const a = ta.selectionStart, b = ta.selectionEnd;
        ta.value = ta.value.slice(0, a) + "    " + ta.value.slice(b);
        ta.selectionStart = ta.selectionEnd = a + 4;
        if (typeof run === "function") run();
      }
    });
    host.appendChild(ta);
    statusText = "ready (textarea)";
  }

  // ---- boot: load the wasm compiler, mount the editor, render --------------
  (async function boot() {
    try {
      const bytes = b64ToBytes(document.getElementById("wasm-b64").textContent);
      const { instance } = await WebAssembly.instantiate(bytes, {});
      ex = instance.exports;
      version = readPacked(ex.version());
      statusText = "ready";
      // by now (post-await) the Maca app has mounted, so #editor exists and
      // run()/update() are defined.
      mountMonaco();
      if (typeof update === "function") update();
    } catch (e) {
      statusText = "wasm failed: " + e.message;
      if (typeof update === "function") update();
    }
  })();
})();
"""

const HelloSrc = """
main() -> int {
    info("Hello from Maca")
    0
}
"""

const PageSrc = """
// A page rather than a print. A tag name called as a function is an element:
// named args are attributes, positional args are children. `value=` on a state
// name is
// two-way, so typing re-renders exactly the nodes that mention the state.
//
// The Preview tab runs this. The C tab refuses it, and says why: the same call
// renders to an HTML string natively, but a live binding needs a DOM.
who = "world"

main() -> Element =>
    div(class="p-8 font-sans"
        h1(class="text-2xl font-bold text-violet-600", "Hello, {who}")
        input(class="mt-4 px-2 py-1 rounded border border-zinc-400",
              value=who)
        p(class="mt-3 text-sm text-zinc-500", "{len(who)} characters")
    )
"""

const TourSrc = """
// A tour of Maca's surface syntax in one program that type-checks clean.
// There is no `fn`, no `let`, no `return` and no `type`: a bare `x = e` binds a
// mutable name, `const x = e` a constant, and the last expression is the value.

/* Block comments work too. */

Shape = Circle(float) | Rect(float, float)
Point = {
    x: int
    y: int
}

// An arrow body, and `match` over a sum with binding patterns.
area(s: Shape) -> float =>
    match s {
        Circle(r) => 3.14 * r * r
        Rect(w, h) => w * h
    }

// A block body: reassignment, `while`, `break`, and the spaced ternary.
collatz_steps(from: int) -> int {
    n = from
    steps = 0
    while n > 1 {
        n = n % 2 == 0 ? n / 2 : 3 * n + 1
        steps = steps + 1
        if steps > 1000 {
            break
        }
    }
    steps
}

// UFCS: `n.double()` is sugar for `double(n)`.
double(n: int) -> int => n * 2

main() -> int {
    xs = 1..5
    xs[0] = 10
    acc = 0
    for i in 0..len(xs) - 1 {
        acc = acc + xs[i]
    }
    info("acc {acc}, len {len(xs)}")

    p = Point { x = 1, y = 2 }
    q = p with { y = 9 }
    info("p.y {p.y}, q.y {q.y}, q.y.double() {q.y.double()}")

    info("circle {area(Circle(2.0))}, rect {area(Rect(3.0, 4.0))}")
    info("collatz(27) {collatz_steps(27)}")
    0
}
"""

const TreeSrc = """
// Recursive sum types: a self-referential payload is boxed, so a tree is an
// ordinary value and `match` on it has to be exhaustive. Drop an arm and the
// Diagnostics tab answers NonExhaustive instead of the program running.
Tree = Leaf(int) | Node(Tree, Tree)

total(t: Tree) -> int =>
    match t {
        Leaf(n) => n
        Node(l, r) => total(l) + total(r)
    }

depth(t: Tree) -> int =>
    match t {
        Leaf(n) => 1
        Node(l, r) => 1 + max(depth(l), depth(r))
    }

main() -> int {
    t = Node(Leaf(1), Node(Leaf(2), Leaf(3)))
    info("total {total(t)}, depth {depth(t)}")
    0
}
"""

const ListSrc = """
// Closures and the list methods. A lambda captures its enclosing scope, and a
// parameter that is *called* in the body is a function with no annotation
// needed: a function type is written down only in a record field.
apply_twice(n: int, f) -> int => f(f(n))

main() -> int {
    xs = 5, 3, 1, 4, 2
    step = 10

    shifted = xs.map(v => v + step)
    evens = xs.filter(v => v % 2 == 0)
    sum = xs.reduce(0, (a, v) => a + v)
    sorted = xs.sort()

    info("sorted {sorted[0]} to {xs.max()}, sum {sum}")
    info("shifted[0] {shifted[0]}, {len(evens)} even")
    info("apply_twice(20, +1) {apply_twice(20, v => v + 1)}")
    0
}
"""

const AsyncSrc = """
// Colorblind async: there is no `async` keyword, and no second colour of
// function. `spawn f(x)` starts the call and answers a Future, `await` waits
// for one, and `sleep_ms` is a suspension point. Being async is an effect the
// checker infers, so `work` below is an ordinary function that happens to
// suspend, callable from anywhere.
work(n: int) -> int {
    sleep_ms(1)
    n * 2
}

main() -> int {
    a = spawn work(10)
    b = spawn work(20)
    info("{await a + await b}")
    0
}
"""

const FormatSrc = """
// An interpolation may carry a format spec: [align][0][width][.precision].
// The spec's `:` is attached and a ternary's is spaced, which is how the lexer
// tells `{q:>5}` from `{c ? a : b}`. It is sugar: the parser rewrites it to
// pad_start / pad_end / pad_center / fixed, so every back end gets it free.
row(name: str, qty: int, price: float) -> str =>
    "{name:<10}{qty:>5}{price:>10.2}"

main() -> int {
    info(row("widget", 3, 4.5))
    info(row("gasket", 128, 19.995))
    info(row("shim", 7, 0.5))
    info("pi {3.14159:.3}, zero padded {7:04}")
    0
}
"""

const ConfigSrc = """
// Config mode: the module *is* the configuration and it has to be pure, so
// there is no `main` and no `info`. `system.*` routes to NixOS, `user.*` to
// home-manager, and a block implies `enable = true`.
//
// The Nix tab is the module this compiles to. Add `info("hi")` and the
// Diagnostics tab answers EffectInConfig.
networking.hostName = "rigel"
system.stateVersion = "24.11"
system.packages = git, curl, ripgrep

services.openssh = {
    passwordAuthentication = false
}
"""

Example = {
    src:  str
    mode: int
    tab:  str
    note: str
}

example(name: str) -> Example {
    if name == "page" {
        Example { src = PageSrc, mode = 0, tab = "Preview",
                  note = "a tag call is an element; Preview runs it" }
    } else if name == "tour" {
        Example { src = TourSrc, mode = 0, tab = "Console",
                  note = "most of the surface syntax in one program" }
    } else if name == "tree" {
        Example { src = TreeSrc, mode = 0, tab = "Console",
                  note = "recursive sums, and match that must be exhaustive" }
    } else if name == "list" {
        Example { src = ListSrc, mode = 0, tab = "Console",
                  note = "closures, and a function passed with no annotation" }
    } else if name == "async" {
        Example { src = AsyncSrc, mode = 0, tab = "Console",
                  note = "spawn and await with no async keyword anywhere" }
    } else if name == "format" {
        Example { src = FormatSrc, mode = 0, tab = "Console",
                  note = "an interpolation carrying [align][0][width][.prec]" }
    } else if name == "config" {
        Example { src = ConfigSrc, mode = 1, tab = "Nix",
                  note = "the same language, compiled to a NixOS module" }
    } else {
        Example { src = HelloSrc, mode = 0, tab = "Console",
                  note = "the smallest whole program" }
    }
}

mode = 0
tab  = "Console"
note = ""

run() {
    mcCompile(mcSource(), mode)

    if tab == "Preview" {
        mcRenderPreview()
    }

    update()
}

start() {
    shared = mcUrlProgram()

    if shared == "" {
        load("hello")
    } else {
        mcSetSource(shared)
        mcSetPicked("")
        mode = mcUrlMode()
        tab = mode == 1 ? "Nix" : "Console"
        note = "loaded from a shared link"
        run()
    }
}

load(name: str) {
    picked = example(name)
    mcSetSource(picked.src.trim())
    mcSetPicked(name)
    mode = picked.mode
    tab = picked.tab
    note = picked.note
    run()
}

pickExample() {
    load(mcPicked())
}

useProgram() {
    mode = 0
    tab  = "Console"
    run()
}

useConfig() {
    mode = 1
    tab  = "Nix"
    run()
}

share() {
    mcShare(mode)
    update()
}

showDiag()    { tab = "Diagnostics" }
showConsole() { tab = "Console" }
showC()       { tab = "C" }
showJs()      { tab = "JS" }
showCss()     { tab = "CSS" }
showNix()     { tab = "Nix" }

showPreview() {
    tab = "Preview"
    mcRenderPreview()
}

const TabOn = "px-3 py-1 text-sm rounded cursor-pointer bg-zinc-800 text-zinc-100"
const TabOff = "px-3 py-1 text-sm rounded cursor-pointer text-zinc-400"
const Secondary = "px-2 py-1 text-sm rounded border border-zinc-700 text-zinc-300 cursor-pointer"
const Picker = "px-2 py-1 text-sm rounded border border-zinc-700 bg-zinc-900 text-zinc-300 cursor-pointer"
const TextPane = "flex-1 min-h-0 overflow-auto p-4 font-mono text-sm whitespace-pre-wrap break-words text-zinc-200"
const PreviewPane = "flex-1 min-h-0 overflow-hidden bg-white"

tabClass(name: str) -> str {
    if !tabInMode(name) {
        "hidden"
    } else if name == tab {
        TabOn
    } else {
        TabOff
    }
}

tabInMode(name: str) -> bool {
    if mode == 1 {
        name == "Diagnostics" || name == "Nix"
    } else {
        name != "Nix"
    }
}

textPaneClass() -> str =>
    tab == "Preview" ? "hidden" : TextPane

previewPaneClass() -> str =>
    tab == "Preview" ? PreviewPane : "hidden"

modeClass(want: int) -> str =>
    mode == want ? TabOn : TabOff

main() -> Element =>
    div(class="flex flex-col h-screen bg-zinc-900 text-zinc-100 font-sans"
        link(rel="stylesheet", href="../fonts/pretendard.css")
        header(class="flex flex-wrap items-center gap-2 px-4 py-3 border-b border-zinc-800 bg-zinc-950"
            span(class="font-mono font-bold text-violet-400", "◆ Maca playground")
            span(class="text-xs text-zinc-500 uppercase tracking-wide", "written in Maca")
            div(class="w-4")
            button(class=modeClass(0), onclick=useProgram, "program")
            button(class=modeClass(1), onclick=useConfig, "config")
            select(id="examples", class=Picker, onchange=pickExample
                option(value="", "examples")
                option(value="hello", "hello")
                option(value="page", "a page")
                option(value="tour", "the syntax")
                option(value="tree", "sum types")
                option(value="list", "closures")
                option(value="async", "async")
                option(value="format", "format specs")
                option(value="config", "config mode")
            )
            span(class="text-xs text-zinc-500 truncate max-w-sm", note)
            div(class="flex-1")
            button(class=Secondary, onclick=share, "Share")
            button(class="px-3 py-1 text-sm font-semibold rounded bg-violet-500 text-zinc-950 cursor-pointer", onclick=run, "Run ▶")
        )
        div(class="flex-1 min-h-0 flex"
            aside(class="w-56 flex-none min-h-0 flex flex-col border-r border-zinc-800 bg-zinc-950"
                div(class="px-3 py-2 text-xs uppercase tracking-wide text-zinc-500 font-semibold border-b border-zinc-800", "Definitions")
                div(class="flex-1 min-h-0 overflow-auto p-1", html=mcOutline())
            )
            div(class="flex-1 min-w-0 grid grid-cols-2"
                div(id="editor", class="relative min-h-0 h-full overflow-hidden border-r border-zinc-800 bg-zinc-900")
                div(class="flex flex-col min-w-0 min-h-0 bg-zinc-950"
                    div(class="flex items-center gap-1 px-2 pt-2 border-b border-zinc-800 overflow-x-auto"
                        button(class=tabClass("Diagnostics"),
                               onclick=showDiag, "Diagnostics")
                        button(class=tabClass("Console"),
                               onclick=showConsole, "Console")
                        button(class=tabClass("Preview"),
                               onclick=showPreview, "Preview")
                        button(class=tabClass("C"), onclick=showC, "C")
                        button(class=tabClass("JS"), onclick=showJs, "JS")
                        button(class=tabClass("CSS"), onclick=showCss, "CSS")
                        button(class=tabClass("Nix"), onclick=showNix, "Nix")
                        div(class="flex-1")
                        span(class="pr-2 text-xs font-mono text-zinc-500 tabular-nums whitespace-nowrap", mcRunBadge())
                    )
                    pre(class=textPaneClass(), mcTab(tab))
                    div(id="preview", class=previewPaneClass())
                    div(class="flex-none border-t border-zinc-800 p-4"
                        div(class="flex items-baseline gap-2 mb-2"
                            span(class="text-xs uppercase tracking-wide text-zinc-500 font-semibold", "Profiler")
                            div(class="flex-1")
                            span(class="text-sm font-semibold tabular-nums text-violet-300", mcMs())
                            span(class="text-xs text-zinc-500 tabular-nums", mcStats())
                        )
                        div(class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950", html=mcFlame())
                    )
                )
            )
        )
        footer(class="flex items-center gap-3 px-4 py-2 text-xs border-t border-zinc-800 bg-zinc-950"
            span(class="font-mono text-zinc-400 truncate", mcHover())
            div(class="flex-1")
            span(class="text-zinc-500", mcStatus())
            span(class="font-mono text-zinc-500", mcVersion())
        )
    )
