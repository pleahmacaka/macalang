// evals/run: pass@1 over the ported HumanEval set, under three conditions.

import std/fs
import std/text
import std/path
import std/list
import std/proc
import { bold, dim, ok, bad, grey } from cli/style

Problems = "apps/evals/problems"

/// What a run is told, which is the whole point of measuring.
Condition = Bare | Spec | SpecAndCheck

/// One problem's outcome under one condition.
Outcome = { problem: str, condition: str, passed: bool, why: str }

conditions() -> Condition[] => Bare, Spec, SpecAndCheck

label(c: Condition) -> str =>
    match c {
        Bare => "no spec"
        Spec => "spec"
        SpecAndCheck => "spec + one check retry"
    }

/// The command that reads a prompt file and writes Maca to stdout.
///
/// A model is a subprocess so the harness does not care which one, and so a
/// run without one is a clear failure rather than a fabricated number.
model() -> str =>
    env_or("MACA_EVAL_MODEL", "")

/// The system prompt: what the model is told before the problem.
preamble(c: Condition) -> str =>
    match c {
        Bare => "Write Maca. Reply with source only, no fences and no prose."
        Spec => spec_text()
        SpecAndCheck => spec_text()
    }

spec_text() -> str {
    got = capture(maca(), ["spec", "--llm"])

    if got.trim() == "" {
        fail "`maca spec --llm` printed nothing: build the toolchain first"
    } else {
        got ++ "\n\nReply with Maca source only, no fences and no prose."
    }
}

maca() -> str =>
    env_or("MACA", "target/release/maca")

/// Every ported problem, in a stable order so two runs compare.
problems() -> str[] =>
    find(Problems, ".maca").sort()

/// The stub a model is asked to complete: the file with its body removed.
ask(problem: str) -> str =>
    read_file(problem)

/// Replace the stub body with what the model wrote, keeping the test.
completed(problem: str, answer: str) -> str {
    src = read_file(problem)
    at = src.index_of("test_")

    at < 0 ? answer : answer ++ "\n\n" ++ src.slice(at, src.length())
}

/// Run one problem under one condition, and say whether its tests passed.
attempt(problem: str, c: Condition) -> Outcome {
    name = basename(problem).replace(".maca", "")

    if model() == "" {
        Outcome {
            problem = name,
            condition = label(c),
            passed = false,
            why = "no MACA_EVAL_MODEL",
        }
    } else {
        first = ask_model(preamble(c), ask(problem))
        graded = grade(problem, first)

        if graded.passed || c != SpecAndCheck {
            Outcome {
                problem = name,
                condition = label(c),
                passed = graded.passed,
                why = graded.why,
            }
        } else {
            retried = ask_model(preamble(c),
                                ask(problem) ++ "\n\nThis failed:\n" ++ graded.why
                                    ++ "\nFix it and reply with the source only.")
            after = grade(problem, retried)

            Outcome {
                problem = name,
                condition = label(c),
                passed = after.passed,
                why = after.why,
            }
        }
    }
}

Graded = { passed: bool, why: str }

/// Write the answer beside the test and run it, which is the only grader that counts.
///
/// Pass and fail come from the exit status rather than from the words the
/// runner printed. Matching on prose is how this scored a passing solution
/// zero: a one-test file says "1 test passed", not "tests passed".
grade(problem: str, answer: str) -> Graded {
    scratch = join(env_or("TMPDIR", "/tmp"), "maca-evals")
    make_dir(scratch)
    file = join(scratch, basename(problem))
    write_file(file, completed(problem, answer))

    if !try_run(maca(), ["check", file]) {
        Graded {
            passed = false,
            why = capture(maca(), ["check", "--json", file]),
        }
    } else {
        Graded {
            passed = try_run(maca(), ["test", file]),
            why = capture(maca(), ["test", file]),
        }
    }
}

/// Hand the prompt to the model as a file, because a prompt is larger than an argument list should carry.
ask_model(system: str, problem: str) -> str {
    scratch = join(env_or("TMPDIR", "/tmp"), "maca-evals")
    make_dir(scratch)
    prompt = join(scratch, "prompt.txt")
    write_file(prompt, system ++ "\n\n" ++ problem)

    capture(model(), [prompt])
}

main(argv: str[]) -> int {
    if !file_exists(Problems) {
        err(bad("no {Problems}: run `maca -m evals.port <HumanEval.jsonl>` first"))
        1
    } else {
        report(measure(conditions(), 0, []))
    }
}

measure(cs: Condition[], i: int, acc: Outcome[]) -> Outcome[] {
    if i >= cs.length() {
        acc
    } else {
        info(bold(label(cs.get(i))))
        measure(cs, i + 1, acc ++ one_condition(problems(), 0, cs.get(i), []))
    }
}

one_condition(ps: str[], i: int, c: Condition, acc: Outcome[]) -> Outcome[] {
    if i >= ps.length() {
        acc
    } else {
        out = attempt(ps.get(i), c)
        err(out.passed ? ok("  " ++ out.problem) : grey("  " ++ out.problem))
        one_condition(ps, i + 1, c, acc.push(out))
    }
}

report(outs: Outcome[]) -> int {
    if outs.length() == 0 {
        err(bad("nothing measured"))
        1
    } else {
        write_file("apps/evals/BASELINE.md", baseline(outs))
        info(ok("wrote apps/evals/BASELINE.md"))
        0
    }
}

baseline(outs: Outcome[]) -> str =>
    "# Baseline\n\n"
        ++ "pass@1 over the mechanically ported HumanEval set, by what the model\n"
        ++ "was told. Regenerate with `maca -m evals` and commit the change.\n\n"
        ++ "| condition | passed | of | pass@1 |\n|---|---|---|---|\n"
        ++ rows(conditions(), 0, outs) ++ "\n"

rows(cs: Condition[], i: int, outs: Outcome[]) -> str {
    if i >= cs.length() {
        ""
    } else {
        name = label(cs.get(i))
        mine = outs.filter(o => o.condition == name)
        won = mine.filter(o => o.passed).length()
        pct = mine.length() == 0 ? 0 : won * 100 / mine.length()

        "| {name} | {won} | {mine.length()} | {pct}% |\n"
            ++ rows(cs, i + 1, outs)
    }
}
