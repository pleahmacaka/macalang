test_remove_duplicates() {
    assert_eq(remove_duplicates([]), [], "case")
    assert_eq(remove_duplicates([1, 2, 3, 4]), [1, 2, 3, 4], "case")
    assert_eq(remove_duplicates([1, 2, 3, 2, 4, 3, 5]), [1, 4, 5], "case")
