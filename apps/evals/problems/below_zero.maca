 * Write it, and leave the test below alone.
 */

below_zero(operations: int[]) -> bool {
    fail "not written yet"
}

test_below_zero() {
    assert_eq(below_zero([]), false, "case")
    assert_eq(below_zero([1, 2, -3, 1, 2, -3]), false, "case")
    assert_eq(below_zero([1, 2, -4, 5, 6]), true, "case")
    assert_eq(below_zero([1, -1, 2, -2, 5, -5, 4, -4]), false, "case")
    assert_eq(below_zero([1, -1, 2, -2, 5, -5, 4, -5]), true, "case")
    assert_eq(below_zero([1, -2, 2, -2, 5, -5, 4, -4]), true, "case")
}
