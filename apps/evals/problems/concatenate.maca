concatenate(strings: str[]) -> str {
    fail "not written yet"
}

test_concatenate() {
    assert_eq(concatenate([]), "", "case")
    assert_eq(concatenate(["x", "y", "z"]), "xyz", "case")
    assert_eq(concatenate(["x", "y", "z", "w", "k"]), "xyzwk", "case")
}
