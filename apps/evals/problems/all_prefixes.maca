/* HumanEval/14: Return list of all prefixes from shortest to longest of the input string
 * Write it, and leave the test below alone.
 */

all_prefixes(string: str) -> str[] {
    fail "not written yet"
}

test_all_prefixes() {
    assert_eq(all_prefixes(""), [], "case")
    assert_eq(
        all_prefixes("asdfgh"),
        ["a", "as", "asd", "asdf", "asdfg", "asdfgh"], "case")
    assert_eq(all_prefixes("WWW"), ["W", "WW", "WWW"], "case")
}
