/* HumanEval/5: Insert a number 'delimeter' between every two consecutive elements of input list `numbers'
 * Write it, and leave the test below alone.
 */

intersperse(numbers: int[], delimeter: int) -> int[] {
    fail "not written yet"
}

test_intersperse() {
    assert_eq(intersperse([], 7), [], "case")
    assert_eq(intersperse([5, 6, 3, 2], 8), [5, 8, 6, 8, 3, 8, 2], "case")
    assert_eq(intersperse([2, 2, 2], 2), [2, 2, 2, 2, 2], "case")
}
