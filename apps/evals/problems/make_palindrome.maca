test_make_palindrome() {
    assert_eq(make_palindrome(""), "", "case")
    assert_eq(make_palindrome("x"), "x", "case")
    assert_eq(make_palindrome("xyz"), "xyzyx", "case")
    assert_eq(make_palindrome("xyx"), "xyx", "case")
    assert_eq(make_palindrome("jerry"), "jerryrrej", "case")
}
