/* HumanEval/19: Input is a space-delimited string of numberals from 'zero' to 'nine'.
 * Write it, and leave the test below alone.
 */

sort_numbers(numbers: str) -> str {
    fail "not written yet"
}

test_sort_numbers() {
    assert_eq(sort_numbers(""), "", "case")
    assert_eq(sort_numbers("three"), "three", "case")
    assert_eq(sort_numbers("three five nine"), "three five nine", "case")
    assert_eq(
        sort_numbers("five zero four seven nine eight"),
        "zero four five seven eight nine", "case")
    assert_eq(
        sort_numbers("six five four three two one zero"),
        "zero one two three four five six", "case")
}
