test_count_distinct_characters() {
    assert_eq(count_distinct_characters(""), 0, "case")
    assert_eq(count_distinct_characters("abcde"), 5, "case")
    assert_eq(count_distinct_characters("abcde' + 'cade' + 'CADE"), 5, "case")
    assert_eq(count_distinct_characters("aaaaAAAAaaaa"), 1, "case")
    assert_eq(count_distinct_characters("Jerry jERRY JeRRRY"), 5, "case")
}
