// HumanEval/9: From a given list of integers, generate a list of rolling maximum element found until given moment
// Write it, and leave the test below alone.

rolling_max(numbers: int[]) -> int[] {
    fail "not written yet"
}

test_rolling_max() {
    assert_eq(rolling_max([]), [], "case")
    assert_eq(rolling_max([1, 2, 3, 4]), [1, 2, 3, 4], "case")
    assert_eq(rolling_max([4, 3, 2, 1]), [4, 4, 4, 4], "case")
    assert_eq(rolling_max([3, 2, 3, 100, 3]), [3, 3, 3, 100, 100], "case")
}
