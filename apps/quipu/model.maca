// The editor's own state, and every question it asks the toolchain.
//
// Nothing here draws: `ide.maca` is the gpui half and this is the half a suite
// can run. A view that cannot be tested without a window is a view nobody
// tests, so the window holds no logic at all.

import { client, with_seconds, ask_get, reply_ok } from chaski/ask
import { get } from std/json
import { Chat, compatible, with_model } from ai/openai/chat
import { generate_text_as } from ai/generate
import { Tag, tags, prose } from maca/doc
import maca/lexer
import maca/parser
import maca/ast
import std/proc
import std/text
import { walk } from std/fs

/** One open editor: the tree it was opened on, the buffer, and the panel beside
 * it.
 */
Ide = {
    root:   str,
    files:  str[],
    open:   str,
    text:   str,
    target: str,
    panel:  str,
    output: str,
    breaks: int[],
}

Panels = ["rust", "c", "js", "flame", "checks", "names", "memory", "ask", "read", "open", "keys", "about"]

maca_bin() -> str {
    named = env_or("MACA", "maca")

    named.starts_with("/") ? named : cwd() ++ "/" ++ named
}

/** Every `.maca` file under the tree, which is what the file list shows. */
sources(root: str) -> str[] {
    out: str[] = []

    for path in walk(root) {
        if path.ends_with(".maca") {
            out = out.push(path)
        }
    }

    out
}

opened(root: str) -> Ide =>
    Ide { root = root, files = sources(root), open = "", text = "",
          target = "", panel = "rust", output = "", breaks = [] }

/** Opening a file reads it and decides what building it would produce. */
opened_file(ide: Ide, path: str) -> Ide {
    body = read_file(path)

    ide with { open = path, text = body, target = target_of(body),
               output = "", breaks = [] }
}

/** What `maca build` would pick with no `--target`: a config imports nixpkgs, a
 * page answers with an Element.
 */
target_of(body: str) -> str {
    if imports_nixpkgs(body) {
        return "nix"
    }

    answers_element(body) ? "js" : "native"
}

imports_nixpkgs(body: str) -> bool {
    for line in lines(body) {
        trimmed = line.trim()

        if trimmed.starts_with("import ") && trimmed.contains("nixpkgs") {
            return true
        }
    }

    false
}

answers_element(body: str) -> bool =>
    body.contains("-> Element")

/** The panel a target opens on, so a page shows its JavaScript and a config its
 * Nix.
 */
panel_for(target: str) -> str {
    if target == "js" {
        "js"
    } else if target == "nix" {
        "nix"
    } else {
        "rust"
    }
}

/** A breakpoint is a line, and toggling one is what the gutter does. */
toggled(ide: Ide, line: int) -> Ide {
    if ide.breaks.index_of(line) >= 0 {
        ide with { breaks = without_line(ide.breaks, line, 0, []) }
    } else {
        ide with { breaks = ide.breaks ++ [line] }
    }
}

without_line(xs: int[], line: int, i: int, acc: int[]) -> int[] {
    if i >= xs.length() {
        acc
    } else if xs.get(i) == line {
        without_line(xs, line, i + 1, acc)
    } else {
        without_line(xs, line, i + 1, acc ++ [xs.get(i)])
    }
}

/** What the gutter draws beside a line: a stop, or the line's own number. */
gutter(ide: Ide, line: int) -> str =>
    ide.breaks.index_of(line) >= 0 ? "*" : str(line)

/** A run that stops where the editor was told to: the lines, in order, as the
 * runner wants them.
 */
stops(ide: Ide) -> str =>
    sorted_lines(ide.breaks).map(n => str(n)).join(",")

sorted_lines(xs: int[]) -> int[] {
    out = xs
    i = 0

    while i < out.length() {
        j = i + 1

        while j < out.length() {
            if out.get(j) < out.get(i) {
                held = out.get(i)
                out = out.set(i, out.get(j))
                out = out.set(j, held)
            }

            j = j + 1
        }

        i = i + 1
    }

    out
}

/** The panel's text, asked of the toolchain rather than guessed at. */
shown(ide: Ide) -> str {
    if ide.open == "" {
        return "open a file"
    }

    if ide.panel == "checks" {
        return checked(ide.open, ide.target)
    }

    if ide.panel == "flame" {
        return flamed(ide.open)
    }

    if ide.panel == "names" {
        return declared(ide.text)
    }

    if ide.panel == "memory" {
        return footprint(ide.open)
    }

    if ide.panel == "ask" {
        return asked(ide)
    }

    if ide.panel == "read" {
        return reading(ide.text)
    }

    if ide.panel == "open" {
        return offered(matching(picks(ide), ide.output), 0, [])
    }

    if ide.panel == "keys" {
        return listed_binds(keymap(), 0, [])
    }

    if ide.panel == "about" {
        return "{about()}\n{update_said(version_said(), latest())}"
    }

    transpiled(ide.open, ide.panel)
}

/** The file as another target reads it, which is the point of watching it
 * change.
 */
transpiled(path: str, panel: str) -> str {
    out = "{scratch()}/{stem(path)}.{panel}"

    remove_file(out)

    said = panel == "c"
        ? output("sh", ["-c", "'{maca_bin()}' '{path}' '{out}' 2>&1"])
        : output("sh", ["-c", "'{maca_bin()}' build '{path}' --target {panel}"
                                  ++ " -o '{out}' 2>&1"])
    got = read_file(out)

    got != "" ? got : said
}

/** Where the time went, under the counter that is exactly repeatable. */
flamed(path: str) -> str {
    svg = "{scratch()}/{stem(path)}.svg"

    remove_file(svg)

    said = output("sh",
                  ["-c", "'{maca_bin()}' profile '{path}' -o '{svg}' 2>&1"])

    file_exists(svg) ? "{svg}\n{flame_frames(read_file(svg))} frames" : said
}

/** A flame graph draws one rectangle a frame, so counting them says how deep
 * the run went.
 */
flame_frames(svg: str) -> int =>
    svg.split("<rect").length() - 1

checked(path: str, target: str) -> str {
    said = output("sh", ["-c", "'{maca_bin()}' check '{path}' --target {target}"
                                   ++ " 2>&1"])

    said.trim() == "" ? "no diagnostics" : said
}

scratch() -> str {
    dir = env_or("TMPDIR", "/tmp") ++ "/maca-ide"

    make_dir(dir)

    dir
}

stem(path: str) -> str {
    cut = path.split("/")
    last = cut.get(cut.length() - 1)

    last.ends_with(".maca") ? last.slice(0, last.length() - 5) : last
}

/** The gutter as text, a mark a line, which is what the view draws down the
 * left of the buffer.
 */
gutter_text(ide: Ide) -> str {
    out = ""
    lines = ide.text.split("\n").length()
    i = 1

    while i <= lines {
        out = out == "" ? gutter(ide, i) : "{out}\n{gutter(ide, i)}"
        i = i + 1
    }

    out
}

/** The panels with the one in view marked, so the tab row is a string the model
 * owns and a suite can read.
 */
tabs(ide: Ide) -> str =>
    tab_row(Panels, 0, ide.panel, "")

tab_row(ps: str[], i: int, on: str, acc: str) -> str {
    if i >= ps.length() {
        acc
    } else {
        here = ps.get(i) == on ? "[{ps.get(i)}]" : " {ps.get(i)} "

        tab_row(ps, i + 1, on, acc ++ here)
    }
}

/** Which panel a click on the tab row selects, staying put when the name is not
 * one.
 */
picked(ide: Ide, name: str) -> Ide =>
    Panels.index_of(name) < 0 ? ide : ide with { panel = name }

/** What the open file declares, read by the compiler's own parser, so the list
 * is exact rather than guessed at.
 */
declared(text: str) -> str =>
    named_items(parse_module(lex(text), 0, []).items, 0, "")

named_items(items: Stmt[], i: int, acc: str) -> str {
    if i >= items.length() {
        acc
    } else {
        here = one_declared(items.get(i))
        held = here == "" ? acc : (acc == "" ? here : "{acc}\n{here}")

        named_items(items, i + 1, held)
    }
}

one_declared(s: Stmt) -> str {
    if s.kind == SFn {
        "{s.name}/{str(s.params.length())} -> {s.ret == "" ? "?" : s.ret}"
    } else if s.kind == SRecord {
        "{s.name} {{{str(s.params.length())} fields}}"
    } else if s.kind == SSum {
        "{s.name} | {str(s.params.length())} variants"
    } else if s.kind == SBind {
        "{s.name} = ."
    } else {
        ""
    }
}

Timer = "/usr/bin/time"

/** The peak the run actually held, which no reading of the source gives. */
footprint(path: str) -> str {
    if !file_exists(Timer) {
        return "no {Timer} on this host, so nothing measured the run"
    }

    said = output("sh", ["-c", "{Timer} -f '%M KB peak, %e s'"
                                   ++ " '{maca_bin()}' run '{path}'"
                                   ++ " 2>&1 >/dev/null"])

    said.trim() == "" ? "the run said nothing" : said.trim()
}

/** The rules this repository keeps, handed to the model so it answers in this
 * language and not another.
 */
house_rules(root: str) -> str {
    said = read_file(root ++ "/AGENT.md")

    said != "" ? said : "You are helping with Maca, a typed language whose"
        ++ " syntax has no `fn`, no `let` and no `return` keyword for types."
}

/** Where the assistant asks, named by the environment so no key is ever written
 * down.
 */
assistant() -> Chat =>
    with_model(compatible(env_or("OPENROUTER_API_KEY", ""),
                          env_or("MACA_AI_BASE",
                                 "https://openrouter.ai/api/v1")),
               env_or("MACA_AI_MODEL", "google/gemma-4-31b-it:free"))

/** What the assistant says about the file in view, asked whatever the box
 * holds.
 */
asked(ide: Ide) -> str {
    if env_or("OPENROUTER_API_KEY", "") == "" {
        return "no model reached: set OPENROUTER_API_KEY"
    }

    if ide.output.trim() == "" {
        return "ask something first"
    }

    said = generate_text_as(assistant(), house_rules(ide.root),
                            asked_body(ide))

    said.error != "" ? said.error : said.text
}

asked_body(ide: Ide) -> str =>
    "{ide.output}\n\nThe file is {ide.open}:\n{ide.text}"

/** The controls the open file asked for, which is every `@param` its doc
 * comments carry.
 */
knobs(ide: Ide) -> Tag[] =>
    tags(ide.text)

/** The file as prose: what its comments say, with the code between them left
 * out.
 */
reading(text: str) -> str =>
    said_lines(prose(text).split(chr(10)), 0, [])

said_lines(ls: str[], i: int, acc: str[]) -> str {
    if i >= ls.length() {
        return acc.join(chr(10))
    }

    said = ls.get(i).trim()

    said_lines(ls, i + 1, is_said(said) ? acc.push(unmarked(said)) : acc)
}

is_said(line: str) -> bool =>
    line.starts_with("//") || line.starts_with("*")
        || line.starts_with("/**")

/** A comment reads as a sentence, so the marks that opened it go. */
unmarked(line: str) -> str {
    said = line.ends_with("*/")
        ? line.slice(0, line.length() - 2).trim()
        : line

    if said.starts_with("/**") {
        return said.slice(3, said.length()).trim()
    }

    if said.starts_with("//") {
        return said.slice(2, said.length()).trim()
    }

    said.starts_with("*") ? said.slice(1, said.length()).trim() : said
}

/** One thing the quick menu can reach: what it is called and what kind of thing
 * it is.
 */
Pick = {
    label: str
    kind:  str
}

Commands = ["open", "run", "check", "profile", "keymap", "about"]

/** Everything Ctrl+P reaches: the files, the panels, the commands. */
picks(ide: Ide) -> Pick[] =>
    named_picks(ide.files, 0, "file", [])
        ++ named_picks(Panels, 0, "panel", [])
        ++ named_picks(Commands, 0, "command", [])

named_picks(xs: str[], i: int, kind: str, acc: Pick[]) -> Pick[] {
    if i >= xs.length() {
        return acc
    }

    named_picks(xs, i + 1, kind, acc.push(Pick { label = xs.get(i),
                                                 kind = kind }))
}

/** What the box shows for a query: what starts with it first, then what merely
 * holds it.
 */
matching(ps: Pick[], query: str) -> Pick[] {
    said = query.trim().lower()

    if said == "" {
        return ps
    }

    leading(ps, 0, said, []) ++ holding(ps, 0, said, [])
}

leading(ps: Pick[], i: int, said: str, acc: Pick[]) -> Pick[] {
    if i >= ps.length() {
        return acc
    }

    hit = ps.get(i).label.lower().starts_with(said)

    leading(ps, i + 1, said, hit ? acc.push(ps.get(i)) : acc)
}

holding(ps: Pick[], i: int, said: str, acc: Pick[]) -> Pick[] {
    if i >= ps.length() {
        return acc
    }

    label = ps.get(i).label.lower()
    hit = label.contains(said) && !label.starts_with(said)

    holding(ps, i + 1, said, hit ? acc.push(ps.get(i)) : acc)
}

/** One chord and what it runs. */
Bind = {
    chord: str
    does:  str
}

/** The bindings the editor starts with, which are data it can rewrite and not a
 * table inside it.
 */
keymap() -> Bind[] => [
    Bind { chord = "ctrl-p", does = "open" },
    Bind { chord = "ctrl-r", does = "run" },
    Bind { chord = "ctrl-k", does = "keymap" },
    Bind { chord = "f5", does = "profile" },
    Bind { chord = "f9", does = "toggle-stop" }
]

/** What a chord runs, or "" when nothing is bound to it. */
bound_to(ks: Bind[], chord: str) -> str =>
    scan_binds(ks, 0, chord.trim().lower())

scan_binds(ks: Bind[], i: int, chord: str) -> str {
    if i >= ks.length() {
        return ""
    }

    ks.get(i).chord == chord ? ks.get(i).does : scan_binds(ks, i + 1, chord)
}

/** A chord already taken stays where it is, and the caller is told what holds
 * it.
 */
rebound(ks: Bind[], chord: str, does: str) -> Bind[] {
    said = chord.trim().lower()
    held = bound_to(ks, said)

    if held != "" && held != does {
        return ks
    }

    dropped(ks, 0, does, []).push(Bind { chord = said, does = does })
}

dropped(ks: Bind[], i: int, does: str, acc: Bind[]) -> Bind[] {
    if i >= ks.length() {
        return acc
    }

    dropped(ks, i + 1, does, ks.get(i).does == does ? acc : acc.push(ks.get(i)))
}

/** Why a rebinding did not take, or "" when it did. */
clash(ks: Bind[], chord: str, does: str) -> str {
    held = bound_to(ks, chord.trim().lower())

    held == "" || held == does
        ? ""
        : "{chord} already runs {held}"
}

Name = "Quipu"

/** What this is, what version, and what it was built with, asked of the
 * toolchain rather than typed twice.
 */
about() -> str =>
    "{Name}, an editor for Maca\n{version_said()}\nthe editor is Maca too:"
        ++ " apps/quipu"

version_said() -> str {
    said = output(maca_bin(), ["--version"]).trim()

    said == "" ? "no compiler on PATH" : said
}

/** The quick menu as the box draws it, one line a pick, the kind beside the
 * name.
 */
offered(ps: Pick[], i: int, acc: str[]) -> str {
    if i >= ps.length() {
        return acc.length() == 0 ? "nothing matches" : acc.join(chr(10))
    }

    offered(ps, i + 1, acc.push("{ps.get(i).kind}  {ps.get(i).label}"))
}

/** The keymap as the editor shows it, one line a binding. */
listed_binds(ks: Bind[], i: int, acc: str[]) -> str {
    if i >= ks.length() {
        return acc.join(chr(10))
    }

    listed_binds(ks, i + 1, acc.push("{ks.get(i).chord}  {ks.get(i).does}"))
}

Repo = "pleahmacaka/macalang"

/** A version, split so `0.10.0` is read as later than `0.9.0` rather than
 * earlier.
 */
parts_of(v: str) -> int[] =>
    numbered(v.trim().replace("v", "").split("."), 0, [])

numbered(xs: str[], i: int, acc: int[]) -> int[] {
    if i >= xs.length() {
        return acc
    }

    numbered(xs, i + 1, acc.push(int(digits_of(xs.get(i)))))
}

/** A part may carry a suffix, and what comes before the first non-digit is the
 * number.
 */
digits_of(s: str) -> str {
    cs = s.chars()
    out = ""
    i = 0

    while i < cs.length() && cs.get(i).is_ascii_digit() {
        out = out ++ cs.get(i)
        i = i + 1
    }

    out == "" ? "0" : out
}

/** Is `there` a later version than `here`? */
newer(here: str, there: str) -> bool =>
    ahead(parts_of(here), parts_of(there), 0)

ahead(a: int[], b: int[], i: int) -> bool {
    if i >= a.length() && i >= b.length() {
        return false
    }

    x = i < a.length() ? a.get(i) : 0
    y = i < b.length() ? b.get(i) : 0

    x != y ? y > x : ahead(a, b, i + 1)
}

/** The latest release the project published, or "" when nobody could be asked.
 */
latest() -> str {
    got = ask_get(with_seconds(client("https://api.github.com"), 10),
                  "/repos/{Repo}/releases/latest")

    reply_ok(got) ? get(got.body, "tag_name") : ""
}

/** What the editor says about updating itself, which is the truth in every
 * case.
 */
update_said(here: str, there: str) -> str {
    if there == "" {
        return "could not reach the releases, so nothing is known"
    }

    newer(here, there) ? "{there} is out, and this is {here}"
                       : "{here} is the latest"
}
