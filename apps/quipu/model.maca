/* The editor's own state, and every question it asks the toolchain.
 *
 * Nothing here draws: `ide.maca` is the gpui half and this is the half a suite
 * can run. A view that cannot be tested without a window is a view nobody
 * tests, so the window holds no logic at all.
 */

import { client, with_seconds, ask_get, reply_ok } from chaski/ask
import { get } from std/json
import { Chat, compatible, with_model } from ai/openai/chat
import { generate_text_as } from ai/generate
import { Tag, tags, prose } from maca/doc
import maca/lexer
import maca/parser
import maca/ast
import std/proc
import std/text
import { list_dir, is_dir } from std/fs
import { Lang, said, picked_lang } from i18n/say

/** One open editor: the tree it was opened on, the buffer, and the panel beside
 * it.
 */
Ide = {
    root:   str,
    files:  str[],
    open:   str,
    text:   str,
    target: str,
    panel:  str,
    output: str,
    breaks: int[],
    menu:   bool,
    seek:   str,
    pick:   int,
    line:   int,
    col:    int,
    dirty:  bool,
    marking: bool,
    mark_line: int,
    mark_col: int,
    pane:   str,
    bar:    str,
    opens:  str[],
    preview: str,
    stash_k: str[],
    stash_v: str[],
    setting: bool,
    ligs:   bool,
    thin:   bool,
    lang:   str,
    leaving: bool,
    about:  bool,
    picking: bool,
    spread: str[],
    rows:   Row[],
    term:   bool,
    cmd:    str,
    shell:  str,
    ran:    str[],
    undo_text: str[],
    undo_line: int[],
    undo_col:  int[],
    finding: bool,
    needle:  str,
    problems: str[],
    controls: Tag[],
    trusted: bool,
    kind:    str,
}

/** One line of the explorer: what it is, how deep it sits, and whether it is
 * a folder.
 */
Row = {
    path:  str
    name:  str
    depth: int
    dir:   bool
}

Panels = ["rust", "c", "js", "flame", "checks", "names", "memory", "ask", "read", "open", "keys", "about"]

/** The toolchain this editor drives: what `MACA` names, or whatever `maca`
 * the desktop's own path resolves. A relative name is left alone, because a
 * guess at the working directory is how the editor used to hang.
 */
maca_bin() -> str =>
    env_or("MACA", "maca")

/** Every `.maca` file under the tree, which is what the file list shows; a
 * directory with no manifest is not a workspace, and walking one from a Start
 * Menu launch would mean crawling a whole home directory. Build and VCS trees
 * hold no sources, and crawling `.git` once cost the window twenty seconds.
 */
sources(root: str) -> str[] {
    if !file_exists("{root}/maca.toml") {
        return []
    }

    scan(root, [])
}

scan(root: str, acc: str[]) -> str[] {
    out = acc

    for name in list_dir(root) {
        at = "{root}/{name}"

        if is_dir(at) && !skipped_dir(name) {
            out = scan(at, out)
        } else if !is_dir(at) && name.ends_with(".maca") {
            out = out.push(at)
        }
    }

    out
}

skipped_dir(name: str) -> bool =>
    name.starts_with(".") || name == "target" || name == "node_modules"
        || name == "bin" || name == "_build" || name == "deps"

/** The editor starts on nothing: no folder is opened for the reader, because
 * a window that walks whatever directory it was launched from is a window
 * that reads what nobody asked it to.
 */
fresh() -> Ide =>
    opened("")

/** A folder is opened in restricted mode: its top level is listed so it can
 * be looked at, and nothing else runs until the reader trusts it.
 */
arrived(ide: Ide, root: str) -> Ide =>
    (ide with { root = root, trusted = false, files = [], spread = [root],
                rows = listed(root, 0), open = "", text = "", pane = "",
                problems = [], opens = [], preview = "", stash_k = [],
                stash_v = [], dirty = false, line = 0, col = 0 })

/** Trusting a folder is what starts the walk, the checker and every other
 * thing that reads or runs what is in it.
 */
trusting(ide: Ide) -> Ide {
    told = ide with { trusted = true, files = sources(ide.root) }

    retreed(told)
}

/** A buffer is read until the folder it came from is trusted. */
read_only(ide: Ide) -> bool =>
    !ide.trusted

opened(root: str) -> Ide {
    bare = Ide { root = root, files = sources(root), open = "", text = "",
                 target = "", panel = "names", output = "", breaks = [],
                 menu = false, seek = "", pick = 0, line = 0, col = 0,
                 dirty = false, marking = false, mark_line = 0, mark_col = 0,
                 pane = "", bar = "", opens = [], preview = "",
                 stash_k = [], stash_v = [], setting = false, ligs = true,
                 thin = false, lang = "en", leaving = false, about = false,
                 picking = false, spread = [root], rows = [], term = false,
                 cmd = "", shell = "", ran = [], undo_text = [],
                 undo_line = [], undo_col = [], finding = false,
                 needle = "", problems = [], controls = [], trusted = false,
                 kind = "" }

    if root == "" || !is_dir(root) {
        return bare with { rows = [] }
    }

    arrived(bare, root)
}

/** No more rows than an explorer can be read at: a directory of thousands is
 * a directory nobody scrolls, and drawing it is what stops the window
 * answering.
 */
Roomy = 400

/** The explorer's lines, folders before files, and only the folders the
 * reader opened walked into.
 */
retreed(ide: Ide) -> Ide =>
    ide with { rows = spread_rows(ide, ide.root, 0) }

spread_rows(ide: Ide, dir: str, depth: int) -> Row[] {
    out: Row[] = []

    for r in listed(dir, depth) {
        if out.length() < Roomy {
            out = out.push(r)

            if r.dir && ide.spread.index_of(r.path) >= 0 {
                out = out + spread_rows(ide, r.path, depth + 1)
            }
        }
    }

    out
}

/** What one folder holds, folders first and each side by name. */
listed(dir: str, depth: int) -> Row[] {
    dirs: Row[] = []
    files: Row[] = []
    seen = 0

    for name in list_dir(dir) {
        seen = seen + 1

        if seen > Roomy {
            return by_name(dirs) + by_name(files)
        }

        at = "{dir}/{name}"

        if is_dir(at) {
            if !skipped_dir(name) {
                dirs = dirs.push(Row { path = at, name = name, depth = depth,
                                       dir = true })
            }
        } else if !name.starts_with(".") {
            files = files.push(Row { path = at, name = name, depth = depth,
                                     dir = false })
        }
    }

    by_name(dirs) + by_name(files)
}

by_name(rs: Row[]) -> Row[] {
    out: Row[] = []

    for r in rs {
        out = inserted(out, r)
    }

    out
}

inserted(sorted: Row[], r: Row) -> Row[] {
    made: Row[] = []
    placed = false

    for x in sorted {
        if !placed && r.name < x.name {
            made = made.push(r)
            placed = true
        }

        made = made.push(x)
    }

    placed ? made : made.push(r)
}

/** Clicking a folder opens or shuts it; clicking a file opens the file. */
tree_hit(ide: Ide, path: str, dir: bool) -> Ide =>
    dir ? folded(ide, path) : opened_file(ide, path)

folded(ide: Ide, path: str) -> Ide {
    shut = ide.spread.index_of(path) >= 0

    (retreed(ide with { spread = shut ? without_path(ide.spread, path)
                                      : ide.spread.push(path) }))
}

is_spread(ide: Ide, path: str) -> bool =>
    ide.spread.index_of(path) >= 0

/** The mark a row opens with, and the depth it is written at, in a face where
 * every glyph is one column wide.
 */
row_label(ide: Ide, r: Row) -> str {
    mark = r.dir ? (is_spread(ide, r.path) ? "v " : "> ") : "  "

    indent(r.depth) + mark + r.name
}

indent(depth: int) -> str =>
    depth <= 0 ? "" : "  " + indent(depth - 1)

/** Opening a file reads it and decides what building it would produce. */
opened_file(ide: Ide, path: str) -> Ide {
    kept = stashed(ide)
    body = stash_of(kept, path) != "" ? stash_of(kept, path) : read_file(path)
    tabs2 = kept.opens.index_of(path) >= 0 ? kept
                                           : kept with { preview = path }
    (tabs2 with { open = path, text = body, target = target_of(body),
                  output = "", breaks = [], line = 0, col = 0,
                  dirty = stash_of(kept, path) != "", marking = false,
                  pane = "", problems = [], controls = asked_knobs(body),
                  kind = kind_of(path) })
}

/** A buffer left unsaved is stashed by path, and switching back restores it.
 */
stashed(ide: Ide) -> Ide {
    if !ide.dirty || ide.open == "" {
        return ide
    }

    dropped = unstashed(ide, ide.open)

    (dropped with { stash_k = dropped.stash_k.push(ide.open),
                    stash_v = dropped.stash_v.push(ide.text) })
}

stash_of(ide: Ide, path: str) -> str {
    at = ide.stash_k.index_of(path)

    at < 0 ? "" : ide.stash_v.get(at)
}

unstashed(ide: Ide, path: str) -> Ide {
    ks: str[] = []
    vs: str[] = []
    i = 0

    while i < ide.stash_k.length() {
        if ide.stash_k.get(i) != path {
            ks = ks.push(ide.stash_k.get(i))
            vs = vs.push(ide.stash_v.get(i))
        }

        i = i + 1
    }

    ide with { stash_k = ks, stash_v = vs }
}

/** Editing a previewed file pins its tab, the way every editor promotes. */
promoted(ide: Ide) -> Ide {
    if ide.open != "" && ide.open == ide.preview {
        (ide with { opens = ide.opens.push(ide.open), preview = "" })
    } else {
        ide
    }
}

/** Closing a tab drops its stash and lands on whatever tab is left. */
closed_tab(ide: Ide, path: str) -> Ide {
    thinned = unstashed(ide, path) with {
        opens = without_path(ide.opens, path),
        preview = ide.preview == path ? "" : ide.preview }

    if ide.open != path {
        return thinned
    }

    rest = thinned.preview != ""
        ? thinned.opens.push(thinned.preview)
        : thinned.opens

    if rest.length() == 0 {
        return thinned with { open = "", text = "", dirty = false, pane = "" }
    }

    opened_file(thinned with { dirty = false }, rest.get(rest.length() - 1))
}

without_path(xs: str[], path: str) -> str[] {
    out: str[] = []

    for x in xs {
        if x != path {
            out = out.push(x)
        }
    }

    out
}

/** What `maca build` would pick with no `--target`: a config imports nixpkgs, a
 * page answers with an Element.
 */
target_of(body: str) -> str {
    if imports_nixpkgs(body) {
        return "nix"
    }

    answers_element(body) ? "js" : "native"
}

imports_nixpkgs(body: str) -> bool {
    for line in lines(body) {
        trimmed = line.trim()

        if trimmed.starts_with("import ") && trimmed.contains("nixpkgs") {
            return true
        }
    }

    false
}

answers_element(body: str) -> bool =>
    body.contains("-> Element")

/** The panel a target opens on, so a page shows its JavaScript and a config its
 * Nix.
 */
panel_for(target: str) -> str {
    if target == "js" {
        "js"
    } else if target == "nix" {
        "nix"
    } else {
        "rust"
    }
}

/** A breakpoint is a line, and toggling one is what the gutter does. */
toggled(ide: Ide, line: int) -> Ide {
    if ide.breaks.index_of(line) >= 0 {
        ide with { breaks = without_line(ide.breaks, line, 0, []) }
    } else {
        ide with { breaks = ide.breaks + [line] }
    }
}

without_line(xs: int[], line: int, i: int, acc: int[]) -> int[] {
    if i >= xs.length() {
        acc
    } else if xs.get(i) == line {
        without_line(xs, line, i + 1, acc)
    } else {
        without_line(xs, line, i + 1, acc + [xs.get(i)])
    }
}

/** What the gutter draws beside a line: a stop, or the line's own number. */
gutter(ide: Ide, line: int) -> str =>
    ide.breaks.index_of(line) >= 0 ? "*" : str(line)

/** A run that stops where the editor was told to: the lines, in order, as the
 * runner wants them.
 */
stops(ide: Ide) -> str =>
    sorted_lines(ide.breaks).map(n => str(n)).join(",")

sorted_lines(xs: int[]) -> int[] {
    out = xs
    i = 0

    while i < out.length() {
        j = i + 1

        while j < out.length() {
            if out.get(j) < out.get(i) {
                held = out.get(i)
                out = out.set(i, out.get(j))
                out = out.set(j, held)
            }

            j = j + 1
        }

        i = i + 1
    }

    out
}

/** The panel reads its cache; the toolchain runs when a click filled it,
 * never in a render. It shows one thing: the open file on the target its own
 * source names, with the checker's word underneath.
 */
shown(ide: Ide) -> str =>
    ide.pane

/** The panel's text, asked of the toolchain rather than guessed at. */
paneled(ide: Ide) -> str {
    if ide.open == "" {
        return t(ide, "no-file")
    }

    "{transpiled(ide.open, panel_for(ide.target))}\n\n== checks ==\n" +
        checked(ide.open, ide.target)
}

was_paneled(ide: Ide) -> str {
    if ide.open == "" {
        return "open a file"
    }

    if ide.panel == "checks" {
        return checked(ide.open, ide.target)
    }

    if ide.panel == "flame" {
        return flamed(ide.open)
    }

    if ide.panel == "names" {
        return declared(ide.text)
    }

    if ide.panel == "memory" {
        return footprint(ide.open)
    }

    if ide.panel == "ask" {
        return asked(ide)
    }

    if ide.panel == "read" {
        return reading(ide.text)
    }

    if ide.panel == "open" {
        return offered(matching(picks(ide), ide.output), 0, [])
    }

    if ide.panel == "keys" {
        return listed_binds(keymap(), 0, [])
    }

    if ide.panel == "about" {
        return "{about()}\n{update_said(version_said(), latest())}"
    }

    transpiled(ide.open, ide.panel)
}

/** The file as another target reads it, which is the point of watching it
 * change.
 */
transpiled(path: str, panel: str) -> str {
    out = "{scratch()}/{stem(path)}.{panel}"

    remove_file(out)

    said = panel == "c"
        ? ran_line("\"{maca_bin()}\" \"{path}\" \"{out}\" 2>&1")
        : ran_line("\"{maca_bin()}\" build \"{path}\" --target {panel}" +
                       " -o \"{out}\" 2>&1")
    got = read_file(out)
    rs = read_file(out + ".rs")

    got != "" ? got : (rs != "" ? rs : said)
}

/** Where the time went, under the counter that is exactly repeatable. */
flamed(path: str) -> str {
    svg = "{scratch()}/{stem(path)}.svg"

    remove_file(svg)

    said = output("sh",
                  ["-c", "'{maca_bin()}' profile '{path}' -o '{svg}' 2>&1"])

    file_exists(svg) ? "{svg}\n{flame_frames(read_file(svg))} frames" : said
}

/** A flame graph draws one rectangle a frame, so counting them says how deep
 * the run went.
 */
flame_frames(svg: str) -> int =>
    svg.split("<rect").length() - 1

checked(path: str, target: str) -> str {
    said = ran_line("\"{maca_bin()}\" check \"{path}\" --target {target}" +
                        " 2>&1")

    said.trim() == "" ? "no diagnostics" : said
}

scratch() -> str {
    dir = env_or("TMPDIR", "/tmp") + "/maca-ide"

    make_dir(dir)

    dir
}

stem(path: str) -> str {
    cut = path.split("/")
    last = cut.get(cut.length() - 1)

    last.ends_with(".maca") ? last.slice(0, last.length() - 5) : last
}

/** The gutter as text, a mark a line, which is what the view draws down the
 * left of the buffer.
 */
gutter_text(ide: Ide) -> str {
    out = ""
    lines = ide.text.split("\n").length()
    i = 1

    while i <= lines {
        out = out == "" ? gutter(ide, i) : "{out}\n{gutter(ide, i)}"
        i = i + 1
    }

    out
}

/** The panels with the one in view marked, so the tab row is a string the model
 * owns and a suite can read.
 */
tabs(ide: Ide) -> str =>
    tab_row(Panels, 0, ide.panel, "")

tab_row(ps: str[], i: int, on: str, acc: str) -> str {
    if i >= ps.length() {
        acc
    } else {
        here = ps.get(i) == on ? "[{ps.get(i)}]" : " {ps.get(i)} "

        tab_row(ps, i + 1, on, acc + here)
    }
}

/** Which panel a click on the tab row selects, staying put when the name is not
 * one.
 */
picked(ide: Ide, name: str) -> Ide {
    if Panels.index_of(name) < 0 {
        return ide
    }

    ide with { panel = name }
}

/** The panel is filled when it is asked for, never while a file is opened:
 * every line of it costs a run of the toolchain, and a render must not wait
 * on a compiler.
 */
filled(ide: Ide) -> Ide {
    if read_only(ide) {
        return ide with { pane = t(ide, "restricted") }
    }

    if ide.open == "" {
        return ide with { pane = t(ide, "no-file") }
    }

    ide with { pane = paneled(ide) }
}

/** One key, struck: Ctrl+P opens the quick menu, and while it is open the keys
 * type the query, move the pick, and choose; shut, they edit the buffer.
 */
struck(ide: Ide, key: str) -> Ide {
    if key == "escape" && ide.bar != "" {
        return ide with { bar = "" }
    }

    if key == "escape" && ide.setting {
        return ide with { setting = false }
    }

    if key == "escape" && ide.about {
        return ide with { about = false }
    }

    if key == "ctrl-`" || key == "ctrl-oem_3" {
        return ide with { term = !ide.term, bar = "" }
    }

    if ide.term {
        return typed_at_shell(ide, key)
    }

    if key == "ctrl-shift-w" {
        return closed_all(ide with { bar = "" })
    }

    if key == "ctrl-f" {
        return ide with { finding = !ide.finding, bar = "" }
    }

    if ide.finding && !ide.menu {
        return sought_at(ide, key)
    }

    if key == "ctrl-o" {
        return ide with { picking = true, bar = "" }
    }

    if key == "ctrl-p" {
        ide with { menu = !ide.menu, seek = "", pick = 0 }
    } else if !ide.menu {
        edited(ide, key)
    } else if key == "escape" {
        ide with { menu = false, bar = "" }
    } else if key == "enter" {
        chosen(ide)
    } else if key == "backspace" {
        ide with { seek = shorn(ide.seek), pick = 0 }
    } else if key == "up" {
        ide with { pick = ide.pick > 0 ? ide.pick - 1 : 0 }
    } else if key == "down" {
        ide with { pick = below(ide.pick + 1, hits(ide).length()) }
    } else if key.length() == 1 {
        ide with { seek = ide.seek + key, pick = 0 }
    } else {
        ide
    }
}

/** The files the query matches, every one of them when it is empty. */
hits(ide: Ide) -> str[] {
    out: str[] = []
    q = ide.seek.lower()

    for f in ide.files {
        if q == "" || f.lower().contains(q) {
            out = out.push(f)
        }
    }

    out
}

/** One row of the quick menu, numbered so the view can mark the pick. */
Hit = {
    at:   int
    path: str
}

sought(ide: Ide) -> Hit[] {
    out: Hit[] = []
    i = 0

    for f in hits(ide) {
        if i < 20 {
            out = out.push(Hit { at = i, path = f })
        }
        i = i + 1
    }

    out
}

/** The picked hit opens and the menu closes; a menu with nothing to pick just
 * closes.
 */
chosen(ide: Ide) -> Ide {
    all = hits(ide)
    shut = ide with { menu = false }

    at = below(ide.pick, all.length())

    all.length() == 0 ? shut : opened_file(shut, all.get(at))
}

chosen_at(ide: Ide, at: int) -> Ide =>
    chosen(ide with { pick = at })

shorn(s: str) -> str =>
    s.length() == 0 ? s : s.slice(0, s.length() - 1)

below(n: int, count: int) -> int {
    if count == 0 {
        return 0
    }

    n >= count ? count - 1 : n
}

/** What the open file declares, read by the compiler's own parser, so the list
 * is exact rather than guessed at.
 */
declared(text: str) -> str =>
    named_items(parse_module(lex(text), 0, []).items, 0, "")

named_items(items: Stmt[], i: int, acc: str) -> str {
    if i >= items.length() {
        acc
    } else {
        here = one_declared(items.get(i))
        held = here == "" ? acc : (acc == "" ? here : "{acc}\n{here}")

        named_items(items, i + 1, held)
    }
}

one_declared(s: Stmt) -> str {
    if s.kind == SFn {
        "{s.name}/{str(s.params.length())} -> {s.ret == "" ? "?" : s.ret}"
    } else if s.kind == SRecord {
        "{s.name} {{{str(s.params.length())} fields}}"
    } else if s.kind == SSum {
        "{s.name} | {str(s.params.length())} variants"
    } else if s.kind == SBind {
        "{s.name} = ."
    } else {
        ""
    }
}

Timer = "/usr/bin/time"

/** The peak the run actually held, which no reading of the source gives. */
footprint(path: str) -> str {
    if !file_exists(Timer) {
        return "no {Timer} on this host, so nothing measured the run"
    }

    said = output("sh", ["-c", "{Timer} -f '%M KB peak, %e s'" +
                                   " '{maca_bin()}' run '{path}'" +
                                   " 2>&1 >/dev/null"])

    said.trim() == "" ? "the run said nothing" : said.trim()
}

/** The rules this repository keeps, handed to the model so it answers in this
 * language and not another.
 */
house_rules(root: str) -> str {
    said = read_file(root + "/AGENT.md")

    said != "" ? said : "You are helping with Maca, a typed language whose" +
        " syntax has no `fn`, no `let` and no `return` keyword for types."
}

/** Where the assistant asks, named by the environment so no key is ever written
 * down.
 */
assistant() -> Chat =>
    with_model(compatible(env_or("OPENROUTER_API_KEY", ""),
                          env_or("MACA_AI_BASE",
                                 "https://openrouter.ai/api/v1")),
               env_or("MACA_AI_MODEL", "google/gemma-4-31b-it:free"))

/** What the assistant says about the file in view, asked whatever the box
 * holds.
 */
asked(ide: Ide) -> str {
    if env_or("OPENROUTER_API_KEY", "") == "" {
        return "no model reached: set OPENROUTER_API_KEY"
    }

    if ide.output.trim() == "" {
        return "ask something first"
    }

    said = generate_text_as(assistant(), house_rules(ide.root),
                            asked_body(ide))

    said.error != "" ? said.error : said.text
}

asked_body(ide: Ide) -> str =>
    "{ide.output}\n\nThe file is {ide.open}:\n{ide.text}"

/** The controls the open file asked for, which is every `@param` its doc
 * comments carry.
 */
/** The controls the open file asked for, read when it was opened or written
 * rather than on every frame.
 */
knobs(ide: Ide) -> Tag[] =>
    ide.controls

asked_knobs(text: str) -> Tag[] =>
    text.length() > 200000 ? [] : tags(text)

/** The file as prose: what its comments say, with the code between them left
 * out.
 */
reading(text: str) -> str =>
    said_lines(prose(text).split(chr(10)), 0, [])

said_lines(ls: str[], i: int, acc: str[]) -> str {
    if i >= ls.length() {
        return acc.join(chr(10))
    }

    said = ls.get(i).trim()

    said_lines(ls, i + 1, is_said(said) ? acc.push(unmarked(said)) : acc)
}

is_said(line: str) -> bool =>
    line.starts_with("//") || line.starts_with("*")
        || line.starts_with("/*")

/** A comment reads as a sentence, so the marks that opened it go. */
unmarked(line: str) -> str {
    said = line.ends_with("*/")
        ? line.slice(0, line.length() - 2).trim()
        : line

    if said.starts_with("/**") {
        return said.slice(3, said.length()).trim()
    }

    if said.starts_with("/*") || said.starts_with("//") {
        return said.slice(2, said.length()).trim()
    }

    said.starts_with("*") ? said.slice(1, said.length()).trim() : said
}

/** One thing the quick menu can reach: what it is called and what kind of thing
 * it is.
 */
Pick = {
    label: str
    kind:  str
}

Commands = ["open", "run", "check", "profile", "keymap", "about"]

/** Everything Ctrl+P reaches: the files, the panels, the commands. */
picks(ide: Ide) -> Pick[] =>
    named_picks(ide.files, 0, "file", []) +
        named_picks(Panels, 0, "panel", []) +
        named_picks(Commands, 0, "command", [])

named_picks(xs: str[], i: int, kind: str, acc: Pick[]) -> Pick[] {
    if i >= xs.length() {
        return acc
    }

    named_picks(xs, i + 1, kind, acc.push(Pick { label = xs.get(i),
                                                 kind = kind }))
}

/** What the box shows for a query: what starts with it first, then what merely
 * holds it.
 */
matching(ps: Pick[], query: str) -> Pick[] {
    said = query.trim().lower()

    if said == "" {
        return ps
    }

    leading(ps, 0, said, []) + holding(ps, 0, said, [])
}

leading(ps: Pick[], i: int, said: str, acc: Pick[]) -> Pick[] {
    if i >= ps.length() {
        return acc
    }

    hit = ps.get(i).label.lower().starts_with(said)

    leading(ps, i + 1, said, hit ? acc.push(ps.get(i)) : acc)
}

holding(ps: Pick[], i: int, said: str, acc: Pick[]) -> Pick[] {
    if i >= ps.length() {
        return acc
    }

    label = ps.get(i).label.lower()
    hit = label.contains(said) && !label.starts_with(said)

    holding(ps, i + 1, said, hit ? acc.push(ps.get(i)) : acc)
}

/** One chord and what it runs. */
Bind = {
    chord: str
    does:  str
}

/** The bindings the editor starts with, which are data it can rewrite and not a
 * table inside it.
 */
keymap() -> Bind[] => [
    Bind { chord = "ctrl-p", does = "open" },
    Bind { chord = "ctrl-r", does = "run" },
    Bind { chord = "ctrl-k", does = "keymap" },
    Bind { chord = "f5", does = "profile" },
    Bind { chord = "f9", does = "toggle-stop" }
]

/** What a chord runs, or "" when nothing is bound to it. */
bound_to(ks: Bind[], chord: str) -> str =>
    scan_binds(ks, 0, chord.trim().lower())

scan_binds(ks: Bind[], i: int, chord: str) -> str {
    if i >= ks.length() {
        return ""
    }

    ks.get(i).chord == chord ? ks.get(i).does : scan_binds(ks, i + 1, chord)
}

/** A chord already taken stays where it is, and the caller is told what holds
 * it.
 */
rebound(ks: Bind[], chord: str, does: str) -> Bind[] {
    said = chord.trim().lower()
    held = bound_to(ks, said)

    if held != "" && held != does {
        return ks
    }

    dropped(ks, 0, does, []).push(Bind { chord = said, does = does })
}

dropped(ks: Bind[], i: int, does: str, acc: Bind[]) -> Bind[] {
    if i >= ks.length() {
        return acc
    }

    dropped(ks, i + 1, does, ks.get(i).does == does ? acc : acc.push(ks.get(i)))
}

/** Why a rebinding did not take, or "" when it did. */
clash(ks: Bind[], chord: str, does: str) -> str {
    held = bound_to(ks, chord.trim().lower())

    held == "" || held == does
        ? ""
        : "{chord} already runs {held}"
}

Name = "Quipu"

/** What this is, what version, and what it was built with, asked of the
 * toolchain rather than typed twice.
 */
about() -> str =>
    "{Name}, an editor for Maca\n{version_said()}\nthe editor is Maca too:" +
        " apps/quipu"

version_said() -> str {
    said = output(maca_bin(), ["--version"]).trim()

    said == "" ? "no compiler on PATH" : said
}

/** The quick menu as the box draws it, one line a pick, the kind beside the
 * name.
 */
offered(ps: Pick[], i: int, acc: str[]) -> str {
    if i >= ps.length() {
        return acc.length() == 0 ? "nothing matches" : acc.join(chr(10))
    }

    offered(ps, i + 1, acc.push("{ps.get(i).kind}  {ps.get(i).label}"))
}

/** The keymap as the editor shows it, one line a binding. */
listed_binds(ks: Bind[], i: int, acc: str[]) -> str {
    if i >= ks.length() {
        return acc.join(chr(10))
    }

    listed_binds(ks, i + 1, acc.push("{ks.get(i).chord}  {ks.get(i).does}"))
}

Repo = "pleahmacaka/macalang"

/** A version, split so `0.10.0` is read as later than `0.9.0` rather than
 * earlier.
 */
parts_of(v: str) -> int[] =>
    numbered(v.trim().replace("v", "").split("."), 0, [])

numbered(xs: str[], i: int, acc: int[]) -> int[] {
    if i >= xs.length() {
        return acc
    }

    numbered(xs, i + 1, acc.push(int(digits_of(xs.get(i)))))
}

/** A part may carry a suffix, and what comes before the first non-digit is the
 * number.
 */
digits_of(s: str) -> str {
    cs = s.chars()
    out = ""
    i = 0

    while i < cs.length() && cs.get(i).is_ascii_digit() {
        out = out + cs.get(i)
        i = i + 1
    }

    out == "" ? "0" : out
}

/** Is `there` a later version than `here`? */
newer(here: str, there: str) -> bool =>
    ahead(parts_of(here), parts_of(there), 0)

ahead(a: int[], b: int[], i: int) -> bool {
    if i >= a.length() && i >= b.length() {
        return false
    }

    x = i < a.length() ? a.get(i) : 0
    y = i < b.length() ? b.get(i) : 0

    x != y ? y > x : ahead(a, b, i + 1)
}

/** The latest release the project published, or "" when nobody could be asked.
 */
latest() -> str {
    got = ask_get(with_seconds(client("https://api.github.com"), 10),
                  "/repos/{Repo}/releases/latest")

    reply_ok(got) ? get(got.body, "tag_name") : ""
}

/** What the editor says about updating itself, which is the truth in every
 * case.
 */
update_said(here: str, there: str) -> str {
    if there == "" {
        return "could not reach the releases, so nothing is known"
    }

    newer(here, there) ? "{there} is out, and this is {here}"
                       : "{here} is the latest"
}

/** One line of the open file, numbered for the gutter. */
Line = {
    n:    int
    said: str
}

/** How many lines the buffer draws at once. A window that follows the cursor
 * is what keeps a long file cheap and the cursor on screen, and gpui has no
 * scroll position to ask for.
 */
Shown = 42

/** The first line drawn, kept so the cursor sits inside the window. */
first_shown(ide: Ide) -> int =>
    window_top(rows_of(ide).length(), ide.line)

window_top(total: int, line: int) -> int {
    if total <= Shown {
        return 0
    }

    want = line - Shown / 2
    last = total - Shown

    want < 0 ? 0 : (want > last ? last : want)
}

/** The lines the buffer draws, numbered as they are in the file. Only the
 * window is built: a render that walks a whole file is a render that stops
 * answering on a large one.
 */
window_lines(ide: Ide) -> Line[] {
    rs = rows_of(ide)
    from = window_top(rs.length(), ide.line)
    out: Line[] = []
    i = from

    while i < rs.length() && i < from + Shown {
        out = out.push(Line { n = i + 1, said = rs.get(i) })
        i = i + 1
    }

    out
}

lines_of(ide: Ide) -> Line[] {
    out: Line[] = []
    i = 0

    for said in ide.text.split(chr(10)) {
        i = i + 1
        out = out.push(Line { n = i, said = said })
    }

    out
}

tail(path: str) -> str {
    cut = last_index_of(path.replace(chr(92), "/"), "/")

    cut < 0 ? path : path.slice(cut + 1, path.length())
}

/** The buffer under one key: the cursor moves, the text takes the character,
 * and Ctrl+S writes the file back.
 */
edited(ide: Ide, key: str) -> Ide {
    if ide.open == "" {
        ide
    } else if read_only(ide) {
        looked_at(ide, key)
    } else if key == "ctrl-shift-s" {
        saved_all(ide)
    } else if key == "ctrl-s" {
        saved(ide)
    } else if key == "ctrl-z" {
        undone(ide)
    } else if key.starts_with("shift-") {
        stretched(ide, key.slice(6, key.length()))
    } else if key == "ctrl-x" {
        cut_out(ide)
    } else if key == "up" {
        placed_at(let_go(ide), ide.line - 1, ide.col)
    } else if key == "down" {
        placed_at(let_go(ide), ide.line + 1, ide.col)
    } else if key == "left" {
        stepped_back(let_go(ide))
    } else if key == "right" {
        stepped_on(let_go(ide))
    } else if key == "enter" {
        split_line(cleared(promoted(ide)))
    } else if key == "backspace" {
        ide.marking ? cleared(promoted(ide)) : rubbed(promoted(ide))
    } else if key == "home" {
        let_go(ide) with { col = 0 }
    } else if key == "end" {
        let_go(ide) with { col = row_at(ide, ide.line).length() }
    } else if key == "tab" {
        put(cleared(promoted(ide)), "    ")
    } else if key.length() == 1 {
        put(cleared(promoted(ide)), key)
    } else {
        ide
    }
}

/** In restricted mode the keys still move and select, and nothing writes. */
looked_at(ide: Ide, key: str) -> Ide {
    if key == "up" {
        placed_at(let_go(ide), ide.line - 1, ide.col)
    } else if key == "down" {
        placed_at(let_go(ide), ide.line + 1, ide.col)
    } else if key == "left" {
        stepped_back(let_go(ide))
    } else if key == "right" {
        stepped_on(let_go(ide))
    } else if key.starts_with("shift-") {
        stretched(ide, key.slice(6, key.length()))
    } else if key == "home" {
        let_go(ide) with { col = 0 }
    } else if key == "end" {
        let_go(ide) with { col = row_at(ide, ide.line).length() }
    } else {
        ide
    }
}

/** A shifted arrow drops an anchor where the cursor stood and walks on; the
 * stretch between them is the selection.
 */
stretched(ide: Ide, way: str) -> Ide {
    held = ide.marking
        ? ide
        : ide with { marking = true, mark_line = ide.line, mark_col = ide.col }

    if way == "up" {
        placed_at(held, held.line - 1, held.col)
    } else if way == "down" {
        placed_at(held, held.line + 1, held.col)
    } else if way == "left" {
        stepped_back(held)
    } else if way == "right" {
        stepped_on(held)
    } else {
        held
    }
}

let_go(ide: Ide) -> Ide =>
    ide with { marking = false }

/** Editing over a selection eats the selection first. */
cleared(ide: Ide) -> Ide =>
    ide.marking ? without_selection(ide) : ide

/** The selection's corners, ordered so the first comes first in the file. */
sel_a_line(ide: Ide) -> int =>
    sel_flipped(ide) ? ide.line : ide.mark_line

sel_a_col(ide: Ide) -> int =>
    sel_flipped(ide) ? ide.col : ide.mark_col

sel_b_line(ide: Ide) -> int =>
    sel_flipped(ide) ? ide.mark_line : ide.line

sel_b_col(ide: Ide) -> int =>
    sel_flipped(ide) ? ide.mark_col : ide.col

sel_flipped(ide: Ide) -> bool =>
    ide.line < ide.mark_line ||
        (ide.line == ide.mark_line && ide.col < ide.mark_col)

/** What the selection covers, which is what Ctrl+C carries away. */
selected_text(ide: Ide) -> str {
    if !ide.marking {
        return ""
    }

    rs = rows_of(ide)
    out: str[] = []
    i = sel_a_line(ide)

    while i <= sel_b_line(ide) && i < rs.length() {
        row = rs.get(i)
        from = i == sel_a_line(ide) ? sel_a_col(ide) : 0
        upto = i == sel_b_line(ide) ? sel_b_col(ide) : row.length()

        out = out.push(row.slice(from, upto))
        i = i + 1
    }

    out.join(chr(10))
}

without_selection(ide: Ide) -> Ide {
    rs = rows_of(ide)
    head = row_at(ide, sel_a_line(ide)).slice(0, sel_a_col(ide))
    last = row_at(ide, sel_b_line(ide))
    seam = head + last.slice(sel_b_col(ide), last.length())
    out: str[] = []
    i = 0

    while i < rs.length() {
        if i < sel_a_line(ide) || i > sel_b_line(ide) {
            out = out.push(rs.get(i))
        } else if i == sel_a_line(ide) {
            out = out.push(seam)
        }

        i = i + 1
    }

    (ide with { text = out.join(chr(10)), dirty = true, marking = false,
                line = sel_a_line(ide), col = sel_a_col(ide) })
}

cut_out(ide: Ide) -> Ide =>
    ide.marking ? without_selection(ide) : ide

/** Pasting drops the clipboard at the cursor, however many lines it brought.
 */
pasted(ide: Ide, said: str) -> Ide {
    base = cleared(ide)
    bits = said.split(chr(10))

    bits.length() == 1 ? put(base, said) : pasted_lines(base, bits)
}

pasted_lines(ide: Ide, bits: str[]) -> Ide {
    row = row_at(ide, ide.line)
    head = row.slice(0, ide.col) + bits.get(0)
    tail_bit = bits.get(bits.length() - 1) +
        row.slice(ide.col, row.length())
    out: str[] = []
    i = 0

    for r in rows_of(ide) {
        if i == ide.line {
            out = out.push(head)
            j = 1

            while j < bits.length() - 1 {
                out = out.push(bits.get(j))
                j = j + 1
            }

            out = out.push(tail_bit)
        } else {
            out = out.push(r)
        }

        i = i + 1
    }

    (ide with { text = out.join(chr(10)), dirty = true,
                line = ide.line + bits.length() - 1,
                col = bits.get(bits.length() - 1).length() })
}

/** How much of one line the selection shades: none, or a column pair. */
sel_on(ide: Ide, n: int) -> bool =>
    ide.marking && n >= sel_a_line(ide) && n <= sel_b_line(ide)

sel_from(ide: Ide, n: int) -> int =>
    n == sel_a_line(ide) ? sel_a_col(ide) : 0

sel_upto(ide: Ide, n: int, row: str) -> int =>
    n == sel_b_line(ide) ? sel_b_col(ide) : row.length()

/** Every edit writes the buffer it replaced onto a stack, and Ctrl+Z puts the
 * top of that stack back where the cursor was.
 */
kept(ide: Ide) -> Ide {
    deep = ide.undo_text.length()
    from = deep >= 50 ? 1 : 0

    (ide with { undo_text = drop_front(ide.undo_text, from).push(ide.text),
                undo_line = drop_ints(ide.undo_line, from).push(ide.line),
                undo_col = drop_ints(ide.undo_col, from).push(ide.col) })
}

undone(ide: Ide) -> Ide {
    deep = ide.undo_text.length()

    if deep == 0 {
        return ide
    }

    last = deep - 1

    (ide with { text = ide.undo_text.get(last),
                line = ide.undo_line.get(last),
                col = ide.undo_col.get(last),
                dirty = true,
                marking = false,
                undo_text = drop_back(ide.undo_text),
                undo_line = drop_back_ints(ide.undo_line),
                undo_col = drop_back_ints(ide.undo_col) })
}

drop_front(xs: str[], from: int) -> str[] {
    out: str[] = []
    i = from

    while i < xs.length() {
        out = out.push(xs.get(i))
        i = i + 1
    }

    out
}

drop_ints(xs: int[], from: int) -> int[] {
    out: int[] = []
    i = from

    while i < xs.length() {
        out = out.push(xs.get(i))
        i = i + 1
    }

    out
}

drop_back(xs: str[]) -> str[] {
    out: str[] = []
    i = 0

    while i < xs.length() - 1 {
        out = out.push(xs.get(i))
        i = i + 1
    }

    out
}

drop_back_ints(xs: int[]) -> int[] {
    out: int[] = []
    i = 0

    while i < xs.length() - 1 {
        out = out.push(xs.get(i))
        i = i + 1
    }

    out
}

/** The find bar: the query is typed, Enter walks to the next line holding it,
 * and Escape puts the buffer back.
 */
sought_at(ide: Ide, key: str) -> Ide {
    if key == "escape" {
        ide with { finding = false }
    } else if key == "enter" {
        jumped(ide)
    } else if key == "backspace" {
        ide with { needle = shorn(ide.needle) }
    } else if key.length() == 1 {
        ide with { needle = ide.needle + key }
    } else {
        ide
    }
}

/** The next line at or after the cursor that holds the query, wrapping once so
 * every match is reachable.
 */
jumped(ide: Ide) -> Ide {
    if ide.needle == "" {
        return ide
    }

    at = next_hit(ide, ide.line + 1, rows_of(ide).length())

    landed = at >= 0 ? at : next_hit(ide, 0, ide.line + 1)

    landed < 0 ? ide : placed_at(ide, landed, 0)
}

next_hit(ide: Ide, from: int, upto: int) -> int {
    rs = rows_of(ide)
    i = from

    while i < upto && i < rs.length() {
        if rs.get(i).contains(ide.needle) {
            return i
        }

        i = i + 1
    }

    0 - 1
}

/** Where the query sits on a line, or -1 when the line does not hold it. */
hit_at(ide: Ide, said: str) -> int {
    if !ide.finding || ide.needle == "" {
        return 0 - 1
    }

    said.index_of(ide.needle)
}

/** How many lines hold the query, which is what the find bar counts. */
hit_count(ide: Ide) -> int {
    if ide.needle == "" {
        return 0
    }

    n = 0

    for r in rows_of(ide) {
        if r.contains(ide.needle) {
            n = n + 1
        }
    }

    n
}

/** Save every buffer that was touched, the open one and the ones waiting in
 * the stash.
 */
saved_all(ide: Ide) -> Ide {
    i = 0

    while i < ide.stash_k.length() {
        write_file(ide.stash_k.get(i), ide.stash_v.get(i))
        i = i + 1
    }

    (saved(ide) with { stash_k = [], stash_v = [] })
}

saved(ide: Ide) -> Ide {
    if read_only(ide) {
        return ide
    }

    write_file(ide.open, ide.text)

    (ide with { dirty = false, problems = complaints(ide),
                controls = asked_knobs(ide.text) })
}

/** What the checker says about the file just written, a line a complaint, so
 * a mistake is seen where it was made rather than on the next build.
 */
complaints(ide: Ide) -> str[] {
    said = checked(ide.open, ide.target)

    said.trim() == "" || said.contains("no diagnostics") ? [] : lines(said)
}

/** Every tab let go of at once, which is what a reader wants after a detour.
 */
closed_all(ide: Ide) -> Ide =>
    (ide with { opens = [], preview = "", open = "", text = "", dirty = false,
                stash_k = [], stash_v = [], pane = "", problems = [],
                line = 0, col = 0, marking = false })

rows_of(ide: Ide) -> str[] =>
    ide.text.split(chr(10))

row_at(ide: Ide, n: int) -> str {
    rs = rows_of(ide)

    n < 0 || n >= rs.length() ? "" : rs.get(n)
}

/** A click in the buffer puts the cursor on that line, at the column the
 * pointer landed on, counted in the one width every glyph of this face has.
 */
placed_click(ide: Ide, line: int, col: int) -> Ide =>
    placed_at(let_go(ide), line, col)

/** The cursor lands where it can: the line clamped to the file, the column to
 * that line.
 */
placed_at(ide: Ide, line: int, col: int) -> Ide {
    rs = rows_of(ide)
    ln = line < 0 ? 0 : (line >= rs.length() ? rs.length() - 1 : line)
    said = rs.get(ln)
    at = col < 0 ? 0 : (col > said.length() ? said.length() : col)

    ide with { line = ln, col = at }
}

stepped_back(ide: Ide) -> Ide {
    if ide.col > 0 {
        ide with { col = ide.col - 1 }
    } else if ide.line > 0 {
        placed_at(ide, ide.line - 1, row_at(ide, ide.line - 1).length())
    } else {
        ide
    }
}

stepped_on(ide: Ide) -> Ide {
    if ide.col < row_at(ide, ide.line).length() {
        ide with { col = ide.col + 1 }
    } else if ide.line < rows_of(ide).length() - 1 {
        placed_at(ide, ide.line + 1, 0)
    } else {
        ide
    }
}

put(ide: Ide, said: str) -> Ide {
    held = kept(ide)
    row = row_at(ide, ide.line)
    grown = row.slice(0, ide.col) + said + row.slice(ide.col, row.length())

    (held with { text = swapped_row(ide, grown), dirty = true,
                 col = ide.col + said.length() })
}

split_line(ide: Ide) -> Ide {
    held = kept(ide)
    row = row_at(ide, ide.line)
    cut = row.slice(0, ide.col) + chr(10) + row.slice(ide.col, row.length())

    (held with { text = swapped_row(ide, cut), dirty = true,
                 line = ide.line + 1, col = 0 })
}

/** Backspace deletes to the left, or joins this line onto the one above. */
rubbed(ide: Ide) -> Ide {
    row = row_at(ide, ide.line)
    held = kept(ide)

    if ide.col > 0 {
        cut = row.slice(0, ide.col - 1) + row.slice(ide.col, row.length())

        (held with { text = swapped_row(ide, cut), dirty = true,
                     col = ide.col - 1 })
    } else if ide.line > 0 {
        above = row_at(ide, ide.line - 1)

        (joined_up(held, above + row) with { line = ide.line - 1,
                                             col = above.length() })
    } else {
        ide
    }
}

swapped_row(ide: Ide, grown: str) -> str {
    out: str[] = []
    i = 0

    for r in rows_of(ide) {
        out = out.push(i == ide.line ? grown : r)
        i = i + 1
    }

    out.join(chr(10))
}

joined_up(ide: Ide, whole: str) -> Ide {
    out: str[] = []
    i = 0

    for r in rows_of(ide) {
        if i == ide.line - 1 {
            out = out.push(whole)
        } else if i != ide.line {
            out = out.push(r)
        }
        i = i + 1
    }

    ide with { text = out.join(chr(10)), dirty = true }
}

/** One coloured stretch of a line, as the highlighter cut it. */
Span = {
    hue:  int
    said: str
}

Keywords = ["import", "from", "if", "else", "match", "while", "for", "in",
            "return", "with", "use", "true", "false", "spawn", "await",
            "fail", "try", "break", "continue", "main", "assert",
            "assert_eq", "info"]

HueInk = 11252415
HueKey = 13138141
HueStr = 10012537
HueNum = 13736550
HueNote = 6055792
HueCall = 6402031
HueType = 15057275

/** What a file is written in, read off its name, because a `.toml` painted
 * as Maca is a file painted wrong.
 */
kind_of(path: str) -> str {
    name = tail(path).lower()

    if name.ends_with(".maca") {
        "maca"
    } else if name.ends_with(".toml") || name.ends_with(".ini")
            || name.ends_with(".cfg") {
        "toml"
    } else if name.ends_with(".json") {
        "json"
    } else if name.ends_with(".md") {
        "md"
    } else if name.ends_with(".rs") || name.ends_with(".c")
            || name.ends_with(".h") || name.ends_with(".js")
            || name.ends_with(".ts") || name.ends_with(".ex")
            || name.ends_with(".java") || name.ends_with(".py")
            || name.ends_with(".nix") {
        "code"
    } else {
        ""
    }
}

RustWords = ["fn", "let", "mut", "pub", "use", "struct", "enum", "impl",
             "match", "if", "else", "for", "while", "return", "const",
             "static", "move", "async", "await", "true", "false", "def",
             "class", "import", "from", "export", "function", "var", "int",
             "char", "void", "double", "float", "long", "unsigned", "typedef",
             "struct", "switch", "case", "break", "continue", "do", "defmodule",
             "defp", "when", "end", "in", "with", "self", "type"]

/** The line cut into coloured spans, in whatever the file is written in. A
 * kind nobody paints is left as it was typed.
 */
line_spans_in(kind: str, said: str) -> Span[] {
    if kind == "maca" || kind == "code" {
        return code_spans(kind, said)
    }

    if kind == "toml" {
        return toml_spans(said)
    }

    if kind == "json" {
        return span_scan(said.chars(), 0, "", [])
    }

    if kind == "md" {
        return md_spans(said)
    }

    [Span { hue = HueInk, said = said }]
}

/** The old scan, which is Maca's, and the same shape for the languages that
 * write comments and strings the same way.
 */
code_spans(kind: str, said: str) -> Span[] {
    trimmed = said.trim()

    if trimmed.starts_with("//") || trimmed.starts_with("*")
            || trimmed.starts_with("/*") || trimmed.starts_with("#") {
        return [Span { hue = HueNote, said = said }]
    }

    span_scan_in(kind, said.chars(), 0, "", [])
}

/** A key, its value and the section it sits under, which is all a config file
 * has.
 */
toml_spans(said: str) -> Span[] {
    trimmed = said.trim()

    if trimmed.starts_with("#") {
        return [Span { hue = HueNote, said = said }]
    }

    if trimmed.starts_with("[") {
        return [Span { hue = HueType, said = said }]
    }

    cut = said.index_of("=")

    if cut < 0 {
        return [Span { hue = HueInk, said = said }]
    }

    [Span { hue = HueCall, said = said.slice(0, cut) },
     Span { hue = HueInk, said = "=" },
     Span { hue = HueStr, said = said.slice(cut + 1, said.length()) }]
}

/** A heading, a bullet and a fence, which is what a reader looks for. */
md_spans(said: str) -> Span[] {
    trimmed = said.trim()

    if trimmed.starts_with("#") {
        return [Span { hue = HueKey, said = said }]
    }

    if trimmed.starts_with("```") {
        return [Span { hue = HueNote, said = said }]
    }

    if trimmed.starts_with("- ") || trimmed.starts_with("* ") {
        return [Span { hue = HueCall, said = said }]
    }

    [Span { hue = HueInk, said = said }]
}

line_spans(said: str) -> Span[] =>
    line_spans_in("maca", said)

span_scan_in(kind: str, cs: str[], i: int, held: str,
             acc: Span[]) -> Span[] {
    if i >= cs.length() {
        return held == "" ? acc : acc.push(Span { hue = HueInk, said = held })
    }

    c = cs.get(i)

    if c == "\"" {
        shut = string_close(cs, i + 1)
        lit = piece(cs, i, shut + 1)

        span_scan_in(kind, cs, shut + 1, "",
                     plained(acc, held).push(Span { hue = HueStr,
                                                    said = lit }))
    } else if c.is_ascii_digit() && !word_tail(cs, i) {
        stop = number_close(cs, i)

        span_scan_in(kind, cs, stop, "",
                     plained(acc, held).push(Span { hue = HueNum,
                                                    said = piece(cs, i,
                                                                 stop) }))
    } else if c.is_alpha() || c == "_" {
        stop = word_close(cs, i)
        word = piece(cs, i, stop)

        span_scan_in(kind, cs, stop, "",
                     plained(acc, held).push(Span { hue = word_hue_in(kind, cs,
                                                                      word,
                                                                      stop),
                                                    said = word }))
    } else {
        span_scan_in(kind, cs, i + 1, held + c, acc)
    }
}

word_hue_in(kind: str, cs: str[], word: str, stop: int) -> int {
    words = kind == "maca" ? Keywords : RustWords

    if words.index_of(word) >= 0 {
        HueKey
    } else if word.slice(0, 1).upper() == word.slice(0, 1) &&
            word.slice(0, 1).is_alpha() {
        HueType
    } else if stop < cs.length() && cs.get(stop) == "(" {
        HueCall
    } else {
        HueInk
    }
}

span_scan(cs: str[], i: int, held: str, acc: Span[]) -> Span[] {
    if i >= cs.length() {
        return held == "" ? acc : acc.push(Span { hue = HueInk, said = held })
    }

    c = cs.get(i)

    if c == "\"" {
        shut = string_close(cs, i + 1)
        lit = piece(cs, i, shut + 1)

        span_scan(cs, shut + 1, "",
                  plained(acc, held).push(Span { hue = HueStr, said = lit }))
    } else if c.is_ascii_digit() && !word_tail(cs, i) {
        stop = number_close(cs, i)

        span_scan(cs, stop, "",
                  plained(acc, held).push(Span { hue = HueNum,
                                                 said = piece(cs, i, stop) }))
    } else if c.is_alpha() || c == "_" {
        stop = word_close(cs, i)
        word = piece(cs, i, stop)

        span_scan(cs, stop, "",
                  plained(acc, held).push(Span { hue = word_hue(cs, word, stop),
                                                 said = word }))
    } else {
        span_scan(cs, i + 1, held + c, acc)
    }
}

word_hue(cs: str[], word: str, stop: int) -> int {
    if Keywords.index_of(word) >= 0 {
        HueKey
    } else if word.slice(0, 1).upper() == word.slice(0, 1) &&
            word.slice(0, 1).is_alpha() {
        HueType
    } else if stop < cs.length() && cs.get(stop) == "(" {
        HueCall
    } else {
        HueInk
    }
}

word_tail(cs: str[], i: int) -> bool =>
    i > 0 && (cs.get(i - 1).is_alpha() || cs.get(i - 1) == "_")

plained(acc: Span[], held: str) -> Span[] =>
    held == "" ? acc : acc.push(Span { hue = HueInk, said = held })

piece(cs: str[], a: int, b: int) -> str {
    out = "".chars()
    i = a

    while i < b && i < cs.length() {
        out = out.push(cs.get(i))
        i = i + 1
    }

    out.join("")
}

string_close(cs: str[], i: int) -> int {
    if i >= cs.length() {
        cs.length() - 1
    } else if cs.get(i) == "\"" {
        i
    } else if cs.get(i) == "\\" && i + 1 < cs.length() {
        string_close(cs, i + 2)
    } else {
        string_close(cs, i + 1)
    }
}

number_close(cs: str[], i: int) -> int {
    if i >= cs.length() || (!cs.get(i).is_ascii_digit() && cs.get(i) != ".") {
        i
    } else {
        number_close(cs, i + 1)
    }
}

word_close(cs: str[], i: int) -> int {
    if i >= cs.length() ||
            (!cs.get(i).is_alpha() && !cs.get(i).is_ascii_digit() &&
                 cs.get(i) != "_") {
        i
    } else {
        word_close(cs, i + 1)
    }
}

/** What the status bar says, which is where the file and the cursor are. */
footing(ide: Ide) -> str {
    name = ide.open == "" ? "no file" : tail(ide.open)
    mark = ide.dirty ? " (unsaved)" : ""

    "{name}{mark}   ln {str(ide.line + 1)}, col {str(ide.col + 1)}   " +
        "{str(ide.files.length())} files   {ide.target} via " +
        panel_for(ide.target)
}

/** The menu bar: one menu may hang open, and picking anything shuts it. */
bar_swung(ide: Ide, name: str) -> Ide =>
    ide with { bar = ide.bar == name ? "" : name }

menu_hit(ide: Ide, act: str) -> Ide {
    shut = ide with { bar = "" }

    if act == "save" {
        saved(shut)
    } else if act == "open" {
        shut with { menu = true, seek = "", pick = 0 }
    } else if act == "folder" {
        shut with { picking = true }
    } else if act == "shut-all" {
        closed_all(shut)
    } else if act == "trust" {
        trusting(shut)
    } else if act == "about" {
        shut with { about = true }
    } else if act == "keys" {
        shut with { setting = true }
    } else if act == "settings" {
        shut with { setting = true }
    } else if act == "quit" {
        shut with { leaving = true }
    } else if act == "all" {
        held_all(shut)
    } else {
        shut
    }
}

/** Select All: the anchor at the top, the cursor past the last character. */
held_all(ide: Ide) -> Ide {
    rs = rows_of(ide)
    last = rs.length() - 1

    (ide with { marking = true, mark_line = 0, mark_col = 0, line = last,
                col = rs.get(last).length() })
}

/** What the settings pane flips, one switch a click. */
setting_hit(ide: Ide, act: str) -> Ide {
    if act == "ligs" {
        ide with { ligs = !ide.ligs }
    } else if act == "lang" {
        ide with { lang = ide.lang == "en" ? "ko" : "en" }
    } else if act == "thin" {
        ide with { thin = !ide.thin }
    } else if act == "close" {
        ide with { setting = false }
    } else {
        ide
    }
}

/** Every word the editor shows, in the tongue the settings picked. */
Keys18 = ["file", "edit", "help", "open", "save", "all", "settings", "keys",
          "about", "explorer", "settings-title", "ligatures", "cursor",
          "close", "no-file", "files", "lang", "folder", "no-workspace",
          "empty", "restricted", "trust", "trust-ask"]

english() -> Lang =>
    Lang { tag = "en", keys = Keys18,
           words = ["File", "Edit", "Help", "Open...", "Save", "Select All",
                    "Settings", "Key Bindings", "About Quipu", "EXPLORER",
                    "SETTINGS", "Ligatures", "Cursor", "Close", "no file open",
                    "files", "Language", "Open Folder...",
                    "no folder open", "nothing here", "restricted mode",
                    "Trust this folder",
                    "Nothing is read or run until you trust it."] }

korean() -> Lang =>
    Lang { tag = "ko", keys = Keys18,
           words = ["파일", "편집", "도움말", "열기...", "저장", "모두 선택",
                    "설정", "키 바인딩", "Quipu 정보", "탐색기", "설정",
                    "합자", "커서", "닫기", "열린 파일 없음", "파일",
                    "언어", "폴더 열기...", "열린 폴더 없음",
                    "비어 있음", "제한 모드", "이 폴더 신뢰하기",
                    "신뢰하기 전에는 아무것도 읽거나 실행하지 않습니다."] }

t(ide: Ide, key: str) -> str =>
    said(picked_lang([english(), korean()], ide.lang), key)

/** The terminal strip: a line is typed, Enter runs it where the workspace
 * is, and what it said is kept above the prompt.
 */
typed_at_shell(ide: Ide, key: str) -> Ide {
    if key == "escape" {
        ide with { term = false }
    } else if key == "enter" {
        obeyed(ide)
    } else if key == "backspace" {
        ide with { cmd = shorn(ide.cmd) }
    } else if key == "up" {
        ide with { cmd = ide.ran.length() == 0
                       ? ide.cmd
                       : ide.ran.get(ide.ran.length() - 1) }
    } else if key.length() == 1 {
        ide with { cmd = ide.cmd + key }
    } else {
        ide
    }
}

obeyed(ide: Ide) -> Ide {
    if ide.cmd.trim() == "" {
        return ide
    }

    said = shell_said(ide.root, ide.cmd)

    (ide with { shell = "$ {ide.cmd}\n{said}", cmd = "",
                ran = ide.ran.push(ide.cmd) })
}

/** One command line, run by whatever shell this desktop has. */
ran_line(line: str) -> str =>
    on_windows() ? output("cmd", ["/c", whole(line)])
                 : output("sh", ["-c", line])

/** `cmd /c` drops the first and last quote of the line it is given, so a
 * line that starts at a quoted program comes apart in the middle. Another
 * pair around the whole thing is what survives that.
 */
whole(line: str) -> str =>
    line.starts_with("\"") ? "\"{line}\"" : line

shell_said(root: str, cmd: str) -> str {
    out = on_windows()
        ? output("cmd", ["/c", whole("cd /d \"{root}\" && {cmd} 2>&1")])
        : output("sh", ["-c", "cd '{root}' && {cmd} 2>&1"])

    out.trim() == "" ? "(no output)" : out
}

on_windows() -> bool =>
    env_or("OS", "") != ""

/** The face the buffer wears: whatever monospace the desktop actually has. */
face(ide: Ide) -> str =>
    ide.ligs ? "JetBrainsMono Nerd Font" : "JetBrainsMonoNL Nerd Font"

/** The chrome reads as an application, so it wears a UI face while the buffer
 * keeps the one that lines code up.
 */
ui_face() -> str =>
    "Pretendard"
