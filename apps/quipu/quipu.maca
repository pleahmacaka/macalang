/* Quipu, a Maca editor, with no Rust in it.
 *
 * A desktop program is three functions: `start` gives the first state, `view`
 * draws it, and `key` answers the keyboard. The window, its event loop, its
 * title-bar controls and the fold that turns a click into new state are the
 * compiler's, not this program's.
 */

import { Ide, fresh, struck } from apps/quipu/model
import { view } from apps/quipu/view

start() -> Ide =>
    fresh()

key(ide: Ide, chord: str) -> Ide =>
    struck(ide, chord)
