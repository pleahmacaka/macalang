/* Quipu, a Maca editor, drawn with gpui.
 *
 * The window holds no logic. Every question it asks is a function in
 * `model.maca`, which a suite runs without a window, so what is here is only
 * the tree: the file list, the buffer with its breakpoint gutter, and the panel
 * showing what the file becomes on the target the compiler would pick for it.
 */

import "boot.rs" """
#![windows_subsystem = "windows"]
use gpui::AppContext as _;

pub struct Host {
    ide: Ide,
    focus: gpui::FocusHandle,
}

thread_local! {
    static SHELL: std::cell::RefCell<Option<gpui::Entity<Host>>> =
        std::cell::RefCell::new(None);
}

pub fn maca_apply(app: &mut gpui::App, f: &dyn Fn(Ide) -> Ide) {
    let kept = SHELL.with(|s| s.borrow().clone());
    if let Some(host) = kept {
        host.update(app, |h, cx| {
            h.ide = f(h.ide.clone());
            cx.notify();
        });
    }
}

fn quipu_key(ev: &gpui::KeyDownEvent) -> String {
    let ks = &ev.keystroke;
    if ks.modifiers.control {
        return format!("ctrl-{}", ks.key);
    }
    let named = ks.key.chars().count() > 1;
    if named && ks.modifiers.shift {
        return format!("shift-{}", ks.key);
    }
    if !named {
        if let Some(ch) = &ks.key_char {
            return ch.clone();
        }
    }
    ks.key.clone()
}

impl gpui::Render for Host {
    fn render(
        &mut self,
        _win: &mut gpui::Window,
        cx: &mut gpui::Context<Host>,
    ) -> impl gpui::IntoElement {
        if !self.focus.is_focused(_win) {
            _win.focus(&self.focus);
        }
        gpui::div()
            .id("host")
            .track_focus(&self.focus)
            .on_key_down(cx.listener(|h, ev: &gpui::KeyDownEvent, _w, cx| {
                let k = quipu_key(ev);
                if k == "ctrl-c" || k == "ctrl-x" {
                    let t = selected_text(h.ide.clone());
                    if !t.is_empty() {
                        cx.write_to_clipboard(
                            gpui::ClipboardItem::new_string(t));
                    }
                    if k == "ctrl-x" {
                        h.ide = struck(h.ide.clone(), k);
                    }
                } else if k == "ctrl-v" {
                    if let Some(item) = cx.read_from_clipboard() {
                        if let Some(t) = item.text() {
                            h.ide = pasted(h.ide.clone(), t.to_string());
                        }
                    }
                } else {
                    h.ide = struck(h.ide.clone(), k);
                }
                cx.notify();
            }))
            .size_full()
            .child(view(self.ide.clone()))
    }
}

pub fn quipu_boot() -> i64 {
    gpui::Application::new().run(|cx: &mut gpui::App| {
        let bounds = gpui::Bounds::centered(
            None, gpui::size(gpui::px(1200.0), gpui::px(800.0)), cx);
        cx.open_window(
            gpui::WindowOptions {
                window_bounds: Some(gpui::WindowBounds::Windowed(bounds)),
                titlebar: Some(gpui::TitlebarOptions {
                    title: Some("Quipu".into()),
                    ..Default::default()
                }),
                ..Default::default()
            },
            |win, cx| {
                let host = cx.new(|cx| Host {
                    ide: opened(".".to_string()),
                    focus: cx.focus_handle(),
                });
                SHELL.with(|s| *s.borrow_mut() = Some(host.clone()));
                let keys = host.read(cx).focus.clone();
                win.focus(&keys);
                host
            },
        )
        .unwrap();
        cx.activate(true);
    });
    0
}
"""

import "gpui::div"
import "gpui::Div"
import "gpui::Styled"
import "gpui::ParentElement"
import "gpui::InteractiveElement"
import "gpui::StatefulInteractiveElement"

import { Ide, opened, struck, selected_text, pasted } from apps/quipu/model
import { view } from apps/quipu/view

main() -> int =>
    quipu_boot()
