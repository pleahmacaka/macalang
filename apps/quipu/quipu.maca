/* Quipu, a Maca editor, drawn with gpui.
 *
 * The window holds no logic. Every question it asks is a function in
 * `model.maca`, which a suite runs without a window, so what is here is only
 * the tree: the file list, the buffer with its breakpoint gutter, and the panel
 * showing what the file becomes on the target the compiler would pick for it.
 */

import "boot.rs" """
#![windows_subsystem = "windows"]
use gpui::AppContext as _;

pub struct Host {
    ide: Ide,
    focus: gpui::FocusHandle,
}

thread_local! {
    static SHELL: std::cell::RefCell<Option<gpui::Entity<Host>>> =
        std::cell::RefCell::new(None);
}

pub fn maca_apply(app: &mut gpui::App, f: &dyn Fn(Ide) -> Ide) {
    let kept = SHELL.with(|s| s.borrow().clone());
    if let Some(host) = kept {
        host.update(app, |h, cx| {
            h.ide = f(h.ide.clone());
            if h.ide.leaving {
                std::process::exit(0);
            }
            if h.ide.picking {
                h.ide.picking = false;
                quipu_pick_folder(cx);
            }
            cx.notify();
        });
    }
}

/** The desktop's own folder chooser, because a workspace is picked with the
 * picker every other application uses.
 */
pub fn quipu_pick_folder(cx: &mut gpui::Context<Host>) {
    let asked = cx.prompt_for_paths(gpui::PathPromptOptions {
        files: false,
        directories: true,
        multiple: false,
        prompt: None,
    });

    cx.spawn(async move |host, cx| {
        if let Ok(Ok(Some(paths))) = asked.await {
            if let Some(path) = paths.first() {
                let root = path.to_string_lossy().to_string();
                let _ = host.update(cx, |h, cx| {
                    h.ide = opened(root);
                    cx.notify();
                });
            }
        }
    })
    .detach();
}

/** A window button, done the way the platform under it wants. Windows hands
 * a caption press to the application before it would move or minimise the
 * window, and gpui stops it there, so the system command is asked for by
 * hand; every other desktop answers the window's own calls.
 */
#[cfg(target_os = "windows")]
pub fn maca_window_op(op: &str, _win: &mut gpui::Window) {
    unsafe extern "system" {
        fn GetActiveWindow() -> isize;
        fn ReleaseCapture() -> i32;
        fn IsZoomed(hwnd: isize) -> i32;
        fn SendMessageW(hwnd: isize, msg: u32, w: usize, l: isize) -> isize;
    }

    unsafe {
        let hwnd = GetActiveWindow();
        if hwnd == 0 {
            return;
        }
        match op {
            "drag" => {
                ReleaseCapture();
                SendMessageW(hwnd, 0x00A1, 2, 0);
            }
            "min" => {
                SendMessageW(hwnd, 0x0112, 0xF020, 0);
            }
            "max" => {
                let cmd = if IsZoomed(hwnd) != 0 { 0xF120 } else { 0xF030 };
                SendMessageW(hwnd, 0x0112, cmd, 0);
            }
            _ => {
                SendMessageW(hwnd, 0x0112, 0xF060, 0);
            }
        }
    }
}

#[cfg(not(target_os = "windows"))]
pub fn maca_window_op(op: &str, win: &mut gpui::Window) {
    match op {
        "min" => win.minimize_window(),
        "max" => win.zoom_window(),
        "drag" => win.start_window_move(),
        _ => {}
    }
}

fn quipu_key(ev: &gpui::KeyDownEvent) -> String {
    let ks = &ev.keystroke;
    if ks.modifiers.control {
        return format!("ctrl-{}", ks.key);
    }
    let named = ks.key.chars().count() > 1;
    if named && ks.modifiers.shift {
        return format!("shift-{}", ks.key);
    }
    if !named {
        if let Some(ch) = &ks.key_char {
            return ch.clone();
        }
    }
    ks.key.clone()
}

impl gpui::Render for Host {
    fn render(
        &mut self,
        _win: &mut gpui::Window,
        cx: &mut gpui::Context<Host>,
    ) -> impl gpui::IntoElement {
        if !self.focus.is_focused(_win) {
            _win.focus(&self.focus);
        }
        gpui::div()
            .id("host")
            .track_focus(&self.focus)
            .on_key_down(cx.listener(|h, ev: &gpui::KeyDownEvent, _w, cx| {
                let k = quipu_key(ev);
                if k == "ctrl-c" || k == "ctrl-x" {
                    let t = selected_text(h.ide.clone());
                    if !t.is_empty() {
                        cx.write_to_clipboard(
                            gpui::ClipboardItem::new_string(t));
                    }
                    if k == "ctrl-x" {
                        h.ide = struck(h.ide.clone(), k);
                    }
                } else if k == "ctrl-v" {
                    if let Some(item) = cx.read_from_clipboard() {
                        if let Some(t) = item.text() {
                            h.ide = pasted(h.ide.clone(), t.to_string());
                        }
                    }
                } else if k == "ctrl-q" {
                    std::process::exit(0);
                } else {
                    h.ide = struck(h.ide.clone(), k);
                }
                if h.ide.leaving {
                    std::process::exit(0);
                }
                cx.notify();
            }))
            .size_full()
            .child(view(self.ide.clone()))
    }
}

pub fn quipu_boot() -> i64 {
    gpui::Application::new().run(|cx: &mut gpui::App| {
        let fonts: Vec<std::borrow::Cow<'static, [u8]>> = vec![
            include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"),
                "/assets/JetBrainsMonoNerdFont-Regular.ttf"))
                .as_slice().into(),
            include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"),
                "/assets/JetBrainsMonoNerdFont-Bold.ttf"))
                .as_slice().into(),
            include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"),
                "/assets/JetBrainsMonoNLNerdFont-Regular.ttf"))
                .as_slice().into(),
            include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"),
                "/assets/Pretendard-Regular.ttf"))
                .as_slice().into(),
            include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"),
                "/assets/Pretendard-SemiBold.ttf"))
                .as_slice().into(),
        ];
        let _ = cx.text_system().add_fonts(fonts);
        let bounds = gpui::Bounds::centered(
            None, gpui::size(gpui::px(1200.0), gpui::px(800.0)), cx);
        cx.open_window(
            gpui::WindowOptions {
                window_bounds: Some(gpui::WindowBounds::Windowed(bounds)),
                titlebar: Some(gpui::TitlebarOptions {
                    title: Some("Quipu".into()),
                    appears_transparent: true,
                    ..Default::default()
                }),
                ..Default::default()
            },
            |win, cx| {
                let host = cx.new(|cx| Host {
                    ide: opened(".".to_string()),
                    focus: cx.focus_handle(),
                });
                SHELL.with(|s| *s.borrow_mut() = Some(host.clone()));
                let keys = host.read(cx).focus.clone();
                win.focus(&keys);
                host
            },
        )
        .unwrap();
        cx.activate(true);
    });
    0
}
"""

import "gpui::div"
import "gpui::Div"
import "gpui::Styled"
import "gpui::ParentElement"
import "gpui::InteractiveElement"
import "gpui::StatefulInteractiveElement"

import { Ide, opened, struck, selected_text, pasted } from apps/quipu/model
import { view } from apps/quipu/view

main() -> int =>
    quipu_boot()
