import { Ide, Panels, opened, opened_file, target_of, panel_for, toggled,
         gutter, gutter_text, stops, tabs, picked, struck, hits, sought,
         Span, line_spans, footing,
         flame_frames, declared, house_rules,
         asked, knobs, reading, Pick, picks, matching,
         Bind, keymap, bound_to, rebound, clash,
         about, newer, parts_of, update_said } from apps/quipu/model
import { bound_name, bound_call } from maca/doc
import std/proc

blank() -> Ide =>
    Ide { root = ".", files = [], open = "", text = "", target = "native",
          panel = "rust", output = "", breaks = [], menu = false, seek = "",
          pick = 0, line = 0, col = 0, dirty = false }

lined(text: str) -> Ide =>
    blank() with { text = text }

test_the_target_is_read_off_the_source_and_not_chosen() {
    assert_eq(target_of("main() -> int => 0\n"), "native",
              "a program that answers a number is a binary")
    assert_eq(target_of("view() -> Element => div()\n"), "js",
              "one that answers nodes belongs in a browser")
    assert_eq(target_of("import nixpkgs\n\nservices.sshd = true\n"), "nix",
              "and one that reaches for nixpkgs is config")
}

test_the_panel_follows_the_target_the_source_named() {
    assert_eq(panel_for("js"), "js", "a browser program is shown as js")
    assert_eq(panel_for("nix"), "nix", "a config as nix")
    assert_eq(panel_for("native"), "rust",
              "and a binary is shown as rust, which is the readable one")
}

test_a_tab_is_picked_only_when_it_names_a_panel() {
    on_c = picked(blank(), "c")

    assert_eq(on_c.panel, "c", "a name on the list selects it")
    assert_eq(picked(on_c, "nonsense").panel, "c",
              "and a name that is not stays where it was")
}

test_the_tab_row_marks_the_one_in_view() {
    row = tabs(blank())

    assert(row.contains("[rust]"), "the panel in view is bracketed: {row}")
    assert(row.contains(" c "), "and the others are not: {row}")
    assert_eq(str(Panels.length()), "12", "every panel is offered")
}

test_a_gutter_mark_toggles_and_the_stops_come_out_in_order() {
    ide = toggled(toggled(toggled(lined("a\nb\nc\nd"), 3), 1), 2)

    assert_eq(gutter(ide, 1), "*", "a marked line draws a stop")
    assert_eq(gutter(ide, 4), "4", "and an unmarked one draws its number")
    assert_eq(stops(ide), "1,2,3",
              "the runner is told the lines in order, whatever order they " +
                  "were clicked in")

    off = toggled(ide, 2)

    assert_eq(gutter(off, 2), "2", "clicking a stop again takes it away")
    assert_eq(stops(off), "1,3", "and it leaves the others alone")
}

test_the_gutter_is_as_long_as_the_buffer() {
    ide = toggled(lined("a\nb\nc"), 2)

    assert_eq(gutter_text(ide), "1\n*\n3",
              "a mark a line, in the order the lines are written")
    assert_eq(gutter_text(lined("only")), "1",
              "and one line is one mark")
}

test_a_flame_graph_is_counted_by_the_rectangles_it_draws() {
    assert_eq(str(flame_frames("<svg><rect x=1/><rect x=2/></svg>")), "2",
              "a flame graph draws one rectangle a frame")
    assert_eq(str(flame_frames("<svg></svg>")), "0",
              "and a graph with nothing in it counts none")
}

test_the_names_panel_reads_the_file_with_the_compilers_own_parser() {
    said = declared("Point = {{ x: int y: int }}\n\nHue = Red | Green\n\nSeed = 7\n\narea(p: Point) -> int => p.x * p.y\n")

    assert(said.contains("area/1 -> int"),
           "a function shows its arity and what it answers: {said}")
    assert(said.contains("Point") && said.contains("fields"),
           "a record shows how many fields it holds: {said}")
    assert(said.contains("Hue"),
           "and a sum is named too: {said}")
    assert(said.contains("Seed"),
           "as is a constant the file binds: {said}")
}

test_the_assistant_is_handed_the_rules_this_repository_keeps() {
    assert(house_rules(".").contains("Maca"),
           "the rules reach the model, read or fallen back to")
    assert(house_rules("/nowhere").contains("no `fn`"),
           "and a tree with no AGENT.md still says what the language is")
}

test_the_assistant_names_what_it_needs_rather_than_pretending() {
    if env_or("OPENROUTER_API_KEY", "") != "" {
        assert(true, "a key is set, so the offline answer is not the one to read")
    } else {
        said = asked(blank() with { output = "what is this?" })

        assert(said.contains("OPENROUTER_API_KEY"),
               "it names what is missing: {said}")
    }
}

test_a_param_in_a_doc_comment_is_a_control_the_editor_offers() {
    got = knobs(lined("/** Add two numbers.\n * @param a = slider(1..10)\n * @param b = toggle(off)\n */\nadd(a: int, b: int) -> int => a + b\n"))

    assert_eq(str(got.length()), "2",
              "two tags asked, two controls offered")
    assert_eq(bound_name(got.get(0)), "a",
              "the control is bound to the name on the left")
    assert_eq(bound_call(got.get(0)), "slider(1..10)",
              "and to the control on the right")
    assert_eq(str(knobs(lined("main() -> int => 0\n")).length()),
              "0", "a file that asks for none offers none")
}

test_reader_mode_keeps_what_was_said_and_drops_what_was_typed() {
    said = reading("/** Add two numbers, which is the whole of it.\n * @param a = slider(1..10)\n */\nadd(a: int, b: int) -> int => a + b\n\n// a plain note\nmain() -> int => 0\n")

    assert(said.contains("Add two numbers"),
           "a doc sentence is what the reader reads: {said}")
    assert(said.contains("a plain note"),
           "and so is a plain one: {said}")
    assert(!said.contains("a + b"),
           "the code between them is not: {said}")
    assert(!said.contains("@param"),
           "and neither is a tag, which is a control and not a sentence: {said}")
    assert(!said.contains("/**") && !said.contains("*/"),
           "the marks that opened and closed the comment go with it: {said}")
}

test_the_quick_menu_reaches_files_panels_and_commands() {
    got = picks(blank() with { files = ["a.maca", "b.maca"] })

    assert(got.length() > 10, "everything reachable is offered")
    assert_eq(got.get(0).kind, "file", "the files lead, because that is what is opened most")
    assert_eq(got.get(0).label, "a.maca", "and in the order the workspace holds them")
}

test_what_starts_with_the_query_comes_before_what_merely_holds_it() {
    got = matching(picks(blank() with { files = ["read.maca", "unread.maca"] }),
                   "read")

    assert_eq(got.get(0).label, "read.maca", "a leading match leads")
    assert_eq(got.get(got.length() - 1).label, "unread.maca",
              "and one that merely holds it comes after every leading match")
    assert_eq(str(matching(picks(blank()), "nothing-like-this").length()), "0",
              "a query nothing matches offers nothing")
}

test_an_empty_query_offers_everything() {
    all = picks(blank())

    assert_eq(str(matching(all, "  ").length()), str(all.length()),
              "a blank box is not a filter")
}

test_a_chord_runs_what_the_keymap_says() {
    assert_eq(bound_to(keymap(), "ctrl-p"), "open",
              "the quick menu opens on ctrl-p")
    assert_eq(bound_to(keymap(), "CTRL-P"), "open",
              "and a chord is read whatever case it was typed in")
    assert_eq(bound_to(keymap(), "ctrl-z"), "",
              "a chord nothing is bound to runs nothing")
}

test_a_chord_already_taken_is_refused_by_naming_what_holds_it() {
    said = clash(keymap(), "ctrl-p", "profile")

    assert(said.contains("open"), "the command holding it is named: {said}")
    assert_eq(bound_to(rebound(keymap(), "ctrl-p", "profile"), "ctrl-p"),
              "open", "and the binding does not move")
}

test_rebinding_a_command_moves_it_rather_than_leaving_two() {
    moved = rebound(keymap(), "ctrl-o", "open")

    assert_eq(bound_to(moved, "ctrl-o"), "open", "the new chord runs it")
    assert_eq(bound_to(moved, "ctrl-p"), "",
              "and the old one runs nothing, or a command would answer twice")
    assert_eq(clash(keymap(), "ctrl-o", "open"), "",
              "a free chord is no clash at all")
}

test_the_about_page_names_what_this_is() {
    said = about()

    assert(said.contains("Quipu"), "the editor names itself: {said}")
    assert(said.contains("Maca"), "and what it edits: {said}")
    assert(said.contains("apps/quipu"), "and that it is Maca too: {said}")
}

test_a_version_is_compared_by_its_numbers_and_not_its_letters() {
    assert(newer("0.9.0", "0.10.0"),
           "ten is later than nine, which reading them as text gets wrong")
    assert(!newer("0.10.0", "0.9.0"), "and the other way round it is not")
    assert(newer("1.0.0", "1.0.1"), "a patch counts")
    assert(!newer("1.2.3", "1.2.3"), "and the same version is not newer")
    assert(newer("v0.3.3", "v0.4.0"), "a leading `v` is not part of the number")
    assert(newer("1.0", "1.0.1"), "a version written short still compares")
}

test_the_editor_says_the_truth_about_updating_in_every_case() {
    assert(update_said("0.3.3", "0.4.0").contains("0.4.0 is out"),
           "a later release is offered")
    assert(update_said("0.4.0", "0.4.0").contains("is the latest"),
           "and nothing is offered when there is nothing")
    assert(update_said("0.4.0", "").contains("could not reach"),
           "a release nobody could ask about is said to be unknown, never " +
               "reported as up to date")
}

main() -> int {
    test_the_target_is_read_off_the_source_and_not_chosen()
    test_the_panel_follows_the_target_the_source_named()
    test_a_tab_is_picked_only_when_it_names_a_panel()
    test_the_tab_row_marks_the_one_in_view()
    test_a_gutter_mark_toggles_and_the_stops_come_out_in_order()
    test_the_gutter_is_as_long_as_the_buffer()
    test_a_flame_graph_is_counted_by_the_rectangles_it_draws()
    test_the_names_panel_reads_the_file_with_the_compilers_own_parser()
    test_the_assistant_is_handed_the_rules_this_repository_keeps()
    test_the_assistant_names_what_it_needs_rather_than_pretending()
    test_a_param_in_a_doc_comment_is_a_control_the_editor_offers()
    test_reader_mode_keeps_what_was_said_and_drops_what_was_typed()
    test_the_quick_menu_reaches_files_panels_and_commands()
    test_what_starts_with_the_query_comes_before_what_merely_holds_it()
    test_an_empty_query_offers_everything()
    test_a_chord_runs_what_the_keymap_says()
    test_a_chord_already_taken_is_refused_by_naming_what_holds_it()
    test_rebinding_a_command_moves_it_rather_than_leaving_two()
    test_the_about_page_names_what_this_is()
    test_a_version_is_compared_by_its_numbers_and_not_its_letters()
    test_the_editor_says_the_truth_about_updating_in_every_case()
    failures()
}

test_the_quick_menu_types_seeks_and_opens() {
    ide = blank() with { files = ["a/fib.maca", "b/lex.maca"] }
    m = struck(ide, "ctrl-p")

    assert(m.menu, "ctrl-p opens the menu")

    m = struck(struck(struck(m, "l"), "e"), "x")

    assert_eq(m.seek, "lex", "typing builds the query")
    assert_eq(str(hits(m).length()), "1", "and narrows the hits")

    done = struck(m, "enter")

    assert(!done.menu, "enter closes the menu")
    assert_eq(done.open, "b/lex.maca", "and opens the pick")
}

test_the_menu_leaves_on_escape_and_the_pick_stays_in_bounds() {
    ide = blank() with { files = ["x.maca", "y.maca"], menu = true }

    assert(!struck(ide, "escape").menu, "escape closes the menu")

    down = struck(struck(struck(ide, "down"), "down"), "down")

    assert_eq(str(down.pick), "1", "the pick stops at the last hit")
    assert_eq(str(struck(down, "up").pick), "0", "and walks back up")
    assert_eq(struck(struck(ide, "backspace"), "q").seek, "q",
              "backspace on nothing stays put, and typing appends")
    assert_eq(str(sought(ide).length()), "2", "the menu shows every hit")
}

test_keys_do_nothing_while_the_menu_is_shut() {
    ide = blank() with { files = ["x.maca"] }

    assert_eq(struck(ide, "a").seek, "", "typing goes nowhere")
    assert_eq(struck(ide, "enter").open, "", "and enter opens nothing")
}

scripted(text: str) -> Ide =>
    blank() with { open = "mem.maca", text = text }

test_typing_lands_at_the_cursor_and_marks_the_buffer() {
    ide = struck(struck(scripted("ab"), "right"), "x")

    assert_eq(ide.text, "axb", "the character went in at the cursor")
    assert_eq(str(ide.col), "2", "and the cursor moved past it")
    assert(ide.dirty, "an edited buffer says so")
}

test_enter_splits_and_backspace_joins_back() {
    cut = struck(struck(scripted("abcd"), "right"), "enter")

    assert_eq(cut.text, "a\nbcd", "enter cuts the line at the cursor")
    assert_eq(str(cut.line), "1", "and the cursor opens the new line")

    whole = struck(cut, "backspace")

    assert_eq(whole.text, "abcd", "backspace at column zero joins up")
    assert_eq(str(whole.col), "1", "at the seam it closed")
}

test_the_cursor_stays_inside_the_file() {
    ide = scripted("ab\ncdef")

    assert_eq(str(struck(ide, "up").line), "0", "no line above the first")
    assert_eq(str(struck(struck(ide, "down"), "down").line), "1",
              "no line below the last")

    hop = struck(struck(ide, "down"), "up")

    assert_eq(str(hop.col), "0", "the column survives the round trip")
}

test_left_and_right_walk_across_line_ends() {
    ide = struck(struck(struck(scripted("ab\ncd"), "right"),
                        "right"), "right")

    assert_eq("{str(ide.line)}:{str(ide.col)}", "1:0",
              "right at the end of a line steps onto the next")

    back = struck(ide, "left")

    assert_eq("{str(back.line)}:{str(back.col)}", "0:2",
              "and left steps back to its end")
}

test_a_line_is_cut_into_coloured_spans() {
    got = line_spans("import x = \"hi\" + 42")

    assert_eq(str(got.length() > 3 ? 1 : 0), "1", "several spans came back")
    assert_eq(got.get(0).said, "import", "the keyword is its own span")
    assert(got.get(0).hue != got.get(got.length() - 1).hue,
           "and a keyword is not the colour of a number")
}

test_a_comment_line_is_one_quiet_span() {
    got = line_spans("    // a note")

    assert_eq(str(got.length()), "1", "the whole line is one span")
}

test_saving_clears_the_mark_and_writes_the_file() {
    at = env_or("TMPDIR", "/tmp") + "/maca-ide-save.maca"
    ide = (blank() with { open = at, text = "x" })
    done = struck(struck(ide, "y"), "ctrl-s")

    assert(!done.dirty, "a saved buffer is clean")
    assert_eq(read_file(at), "yx", "and the file holds what was typed")

    remove_file(at)
}
