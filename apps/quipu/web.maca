/* The editor in a browser, drawn from the same view as the desktop one.
 *
 * A page cannot read the disk, so the state it opens with is written here
 * rather than walked for. Everything past that is `view.maca`, unchanged: the
 * components are the same components, and only the back end differs.
 */

import { Ide } from apps/quipu/model
import { view } from apps/quipu/view

Sample = "greet(who: str) -> str => \"hi {{who}}\"\n\nmain() -> int {{\n    info(greet(\"web\"))\n    0\n}}\n"

/** What the page opens with, since there is no directory to walk in a browser.
 */
shown_state() -> Ide =>
    Ide { root = "maca.dev", files = ["greet.maca"], open = "greet.maca",
          text = Sample, target = "native", panel = "names", output = "",
          breaks = [2], menu = false, seek = "", pick = 0, line = 0, col = 0,
          dirty = false, marking = false, mark_line = 0, mark_col = 0,
          pane = "", bar = "", opens = [], preview = "",
          stash_k = [], stash_v = [], setting = false, ligs = true,
          thin = false, lang = "en", leaving = false, about = false,
          picking = false, spread = [], rows = [], term = false,
          cmd = "", shell = "", ran = [], undo_text = [],
          undo_line = [], undo_col = [], finding = false, needle = "",
          problems = [], controls = [], trusted = true, kind = "maca" }

main() -> Element =>
    view(shown_state())
