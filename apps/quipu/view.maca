/* The three columns, and nothing that says which window draws them.
 *
 * `quipu.maca` is the gpui host and `web.maca` is the browser one; both import
 * this, so the editor is the same components either way.
 */

import { Ide, Line, Hit, Span, Row, window_lines, tail, panel_for, shown, face,
         knobs, opened_file, chosen_at, sought, line_spans, tree_hit,
         row_label, sel_on, sel_from, sel_upto, bar_swung, menu_hit,
         closed_tab, setting_hit, t, about, keymap, ui_face, placed_click,
         listed_binds } from apps/quipu/model
import { Tag, bound_name, bound_call } from maca/doc
import { between } from std/text

/** One Dark, near enough: paper for the buffer, a shade for the chrome, a
 * hairline between every region.
 */
Paper = 2634036

Shade = 2172203

Ink = 11252415

Dim = 6055792

Hover = 2896186

Marked = 4080721

Cursor = 5409727

Edge = 1579551

view(ide: Ide) -> Element =>
    div(class="relative flex flex-col size-full cursor-default",
        font=ui_face(), bg=Paper, fg=Ink,
        menubar(ide),
        div(class="flex flex-row grow overflow-hidden",
            tree(ide), buffer(ide), panel(ide)),
        ide.term ? terminal(ide) : gone(),
        footer(ide),
        ide.bar == "" ? gone() : hung_menu(ide))

/** The open dropdown is painted last from the root, so nothing in the tree
 * can sit on top of it.
 */
hung_menu(ide: Ide) -> Element {
    if ide.bar == "file" {
        return drop_at_12(ide)
    }

    ide.bar == "edit" ? drop_at_24(ide) : drop_at_36(ide)
}

drop_at_12(ide: Ide) -> Element =>
    div(class="absolute top-10 left-12 flex flex-col w-56 py-1
               rounded-md border-1",
        bg=Shade, edge=Edge,
        keyed_item(ide, "folder", "folder", "Ctrl+O"),
        keyed_item(ide, "open", "open", "Ctrl+P"),
        keyed_item(ide, "save", "save", "Ctrl+S"),
        menu_item(ide, "quit", "Quit          Ctrl+Q"))

drop_at_24(ide: Ide) -> Element =>
    div(class="absolute top-10 left-20 flex flex-col w-56 py-1
               rounded-md border-1",
        bg=Shade, edge=Edge,
        menu_item(ide, "all", t(ide, "all")),
        menu_item(ide, "settings", t(ide, "settings")),
        menu_item(ide, "keys", t(ide, "keys")))

drop_at_36(ide: Ide) -> Element =>
    div(class="absolute top-10 left-32 flex flex-col w-56 py-1
               rounded-md border-1",
        bg=Shade, edge=Edge,
        menu_item(ide, "about", t(ide, "about")))

/** The one bar at the top: the app's name, its menus, a stretch to drag the
 * window by, and the window's own buttons, drawn by us and answered by the
 * OS through control areas.
 */
menubar(ide: Ide) -> Element =>
    div(class="flex flex-row items-center gap-1 px-2 border-b-1",
        bg=Shade, edge=Edge,
        logo(),
        div(id="drag-left", zone="drag", winop="drag", class="w-2 h-9", ""),
        menu_head(ide, "file", t(ide, "file")),
        menu_head(ide, "edit", t(ide, "edit")),
        menu_head(ide, "help", t(ide, "help")),
        div(id="drag", zone="drag", winop="drag", class="grow h-9", ""),
        div(id="win-min", zone="min", winop="min",
            class="px-4 py-2 text-xs cursor-pointer", fg=Dim, hover_bg=Hover,
            "_"),
        div(id="win-max", zone="max", winop="max",
            class="px-4 py-2 text-xs cursor-pointer", fg=Dim, hover_bg=Hover,
            "o"),
        div(id="win-shut", zone="close", click=(i => menu_hit(i, "quit")),
            class="px-4 py-2 text-xs cursor-pointer", fg=Dim, hover_bg=Hover,
            "x"))

/** The knot: a small rounded mark, so the bar opens with a face and not a
 * word.
 */
logo() -> Element =>
    div(class="flex items-center justify-center w-5 h-5 mx-2 rounded-md",
        bg=Cursor,
        div(class="text-xs", fg=Paper, "Q"))

menu_head(ide: Ide, name: str, label: str) -> Element =>
    div(id="bar-{name}", click=(i => bar_swung(i, name)),
        class="px-3 py-1 rounded-md text-xs cursor-pointer",
        bg=(ide.bar == name ? Marked : Shade),
        fg=(ide.bar == name ? Ink : Dim), hover_bg=Hover,
        label)

gone() -> Element =>
    div(class="h-0")

menu_item(ide: Ide, act: str, label: str) -> Element =>
    div(id="item-{act}", click=(i => menu_hit(i, act)),
        class="px-3 py-1 text-xs cursor-pointer",
        bg=Shade, fg=Ink, hover_bg=Hover,
        label)

keyed_item(ide: Ide, act: str, key: str, chord: str) -> Element {
    word = t(ide, key)

    menu_item(ide, act, "{word}   {chord}")
}

tree_head(ide: Ide) -> str {
    word = t(ide, "explorer")

    "{word}   {str(ide.files.length())}"
}

tree(ide: Ide) -> Element =>
    div(id="tree",
        class="flex flex-col w-72 overflow-y-scroll border-r-1",
        bg=Shade, edge=Edge,
        div(class="px-4 py-2 text-xs", fg=Dim,
            tree_head(ide)),
        ide.rows.length() == 0 ? empty_tree(ide) : gone(),
        div(class="flex flex-col", ide.rows.map(r => tree_row(ide, r))))

/** A window opened on no workspace says so, and offers the one thing that
 * fixes it.
 */
empty_tree(ide: Ide) -> Element =>
    div(class="flex flex-col px-4 py-2 gap-2",
        div(class="text-xs", fg=Dim, t(ide, "no-workspace")),
        div(id="pick-folder", click=(i => menu_hit(i, "folder")),
            class="px-3 py-1 rounded-md text-xs cursor-pointer",
            bg=Marked, hover_bg=Hover,
            t(ide, "folder")))

tree_row(ide: Ide, r: Row) -> Element =>
    div(id=r.path, click=(i => tree_hit(i, r.path, r.dir)),
        class="px-4 py-1 text-xs cursor-pointer", font=face(ide),
        bg=(r.path == ide.open ? Marked : Shade),
        fg=(r.path == ide.open ? Ink : Dim), hover_bg=Hover,
        row_label(ide, r))

/** The buffer wears its tabs; Ctrl+P turns it into the quick menu and the
 * settings pane borrows it too.
 */
buffer(ide: Ide) -> Element {
    if ide.menu {
        return seeker(ide)
    }

    if ide.setting {
        return settings(ide)
    }

    ide.about ? about_pane(ide) : script(ide)
}

about_pane(ide: Ide) -> Element =>
    div(class="flex flex-col grow",
        div(class="px-4 py-2 border-b-1 text-xs", bg=Shade, edge=Edge,
            t(ide, "about")),
        div(class="flex flex-col px-4 py-2",
            about().split("\n").map(s => panel_line(s))),
        div(class="px-4 py-2 text-xs", fg=Dim, "Esc"))

settings(ide: Ide) -> Element =>
    div(class="flex flex-col grow",
        div(class="px-4 py-2 border-b-1 text-xs", bg=Shade, edge=Edge,
            t(ide, "settings-title")),
        setting_kv(ide, "ligs", "ligatures", ide.ligs ? "on" : "off"),
        setting_kv(ide, "thin", "cursor", ide.thin ? "bar" : "block"),
        setting_kv(ide, "lang", "lang", ide.lang),
        setting_kv(ide, "close", "close", "Esc"),
        div(class="px-4 py-2 border-t-1 text-xs", fg=Dim, edge=Edge,
            t(ide, "keys")),
        div(class="flex flex-col px-4",
            listed_binds(keymap(), 0, []).split("\n")
                .map(s => panel_line(s))))

setting_kv(ide: Ide, act: str, key: str, val: str) -> Element {
    word = t(ide, key)

    setting_row(ide, act, "{word}   {val}")
}

setting_row(ide: Ide, act: str, label: str) -> Element =>
    div(id="set-{act}", click=(i => setting_hit(i, act)),
        class="px-4 py-2 text-xs cursor-pointer", hover_bg=Hover,
        label)

script(ide: Ide) -> Element =>
    div(class="flex flex-col grow",
        tab_bar(ide),
        div(id="lines", class="flex flex-col grow py-3 overflow-y-scroll
                               cursor-text",
            font=face(ide),
            window_lines(ide).map(l => line_row(ide, l))),
        asked_controls(ide))

tab_bar(ide: Ide) -> Element =>
    div(class="flex flex-row overflow-hidden border-b-1", bg=Shade, edge=Edge,
        div(class="flex flex-row",
            ide.opens.map(t => one_tab(ide, t, false))),
        ide.preview == "" ? gone() : one_tab(ide, ide.preview, true))

/** A pinned tab sits straight, a preview leans italic, and the cross beside
 * either closes it.
 */
one_tab(ide: Ide, t: str, soft: bool) -> Element =>
    div(class="flex flex-row items-center border-r-1",
        bg=(t == ide.open ? Paper : Shade), edge=Edge,
        div(id="tab-open-{t}", click=(i => opened_file(i, t)),
            class=(soft ? "pl-4 py-2 text-xs cursor-pointer italic"
                        : "pl-4 py-2 text-xs cursor-pointer"),
            fg=(t == ide.open ? Ink : Dim),
            t == ide.open && ide.dirty ? "{tail(t)} *" : tail(t)),
        div(id="tab-shut-{t}", click=(i => closed_tab(i, t)),
            class="px-2 py-2 text-xs cursor-pointer", fg=Dim, hover_bg=Hover,
            "x"))

/** A line is a dim number and its coloured spans; the cursor line is lit, and
 * a selected line shades its stretch.
 */
line_row(ide: Ide, l: Line) -> Element =>
    div(id="line-{str(l.n)}", click=(i => placed_click(i, l.n - 1, l.said.length())),
        class="flex flex-row w-full cursor-text",
        bg=(l.n - 1 == ide.line && !sel_on(ide, l.n - 1) ? Hover : Paper),
        div(class="flex justify-end w-12 pr-4 text-xs",
            fg=(l.n - 1 == ide.line ? Ink : Dim), str(l.n)),
        picked_form(ide, l))

picked_form(ide: Ide, l: Line) -> Element {
    if sel_on(ide, l.n - 1) {
        return sel_row(ide, l)
    }

    l.n - 1 == ide.line ? cursor_row(ide, l.said) : spans_row(l.said)
}

sel_row(ide: Ide, l: Line) -> Element {
    from = sel_from(ide, l.n - 1)
    upto = sel_upto(ide, l.n - 1, l.said)

    div(class="flex flex-row",
        div(class="text-sm", l.said.slice(0, from)),
        div(class="text-sm", bg=Marked, shaded(l.said, from, upto)),
        div(class="text-sm", l.said.slice(upto, l.said.length())))
}

shaded(said: str, from: int, upto: int) -> str =>
    from == upto ? " " : said.slice(from, upto)

spans_row(said: str) -> Element =>
    div(class="flex flex-row", line_spans(said).map(sp => span_bit(sp)))

span_bit(sp: Span) -> Element =>
    div(class="text-sm", fg=sp.hue, sp.said)

/** The cursor line keeps its colours: the spans are cut around the cursor,
 * which sits as a block over its character or a thin bar before it.
 */
cursor_row(ide: Ide, said: str) -> Element {
    if ide.thin {
        return div(class="flex flex-row",
                   spans_row(said.slice(0, ide.col)),
                   div(class="w-1", bg=Cursor, ""),
                   spans_row(said.slice(ide.col, said.length())))
    }

    div(class="flex flex-row",
        spans_row(said.slice(0, ide.col)),
        div(class="text-sm", bg=Cursor, fg=Paper, under_cursor(ide, said)),
        spans_row(ide.col < said.length()
                      ? said.slice(ide.col + 1, said.length())
                      : ""))
}

under_cursor(ide: Ide, said: str) -> str =>
    ide.col < said.length() ? said.slice(ide.col, ide.col + 1) : " "

/** Ctrl+P: the buffer becomes the quick menu until a file is chosen. */
seeker(ide: Ide) -> Element =>
    div(class="flex flex-col grow",
        div(class="px-4 py-2 border-b-1 text-xs", bg=Shade, edge=Edge,
            "OPEN  {ide.seek}_"),
        sought(ide).length() == 0
            ? div(class="px-4 py-2 text-xs", fg=Dim, t(ide, "empty"))
            : gone(),
        div(class="flex flex-col py-2",
            sought(ide).map(h => hit_row(ide, h))))

hit_row(ide: Ide, h: Hit) -> Element =>
    div(id="hit-{str(h.at)}", click=(i => chosen_at(i, h.at)),
        class="px-4 py-1 text-xs cursor-pointer",
        bg=(h.at == ide.pick ? Marked : Paper), hover_bg=Hover,
        tail(h.path))

/** A `@param` in a doc comment is a control, drawn beside the buffer that asked
 * for it.
 */
asked_controls(ide: Ide) -> Element {
    got = knobs(ide)

    if got.length() == 0 {
        return div(class="h-0")
    }

    div(class="flex flex-col gap-1 px-4 py-2 border-t-1", bg=Shade, edge=Edge,
        div(class="text-xs", fg=Dim, "{str(got.length())} asked for"),
        control(got.get(0)))
}

/** What the panel shows follows the target the source itself names, so nothing
 * has to be chosen.
 */
panel(ide: Ide) -> Element =>
    div(id="panel",
        class="flex flex-col w-80 overflow-y-scroll border-l-1",
        bg=Shade, edge=Edge,
        div(class="px-3 py-2 border-b-1 text-xs", fg=Dim, edge=Edge,
            "TARGET   {ide.target} via {panel_for(ide.target)}"),
        div(class="flex flex-col px-3 py-2", font=face(ide),
            shown(ide).split("\n").map(s => panel_line(s))))

panel_line(s: str) -> Element =>
    div(class="text-xs", s)

/** The terminal strip under the columns: what the last command said, and the
 * line being typed.
 */
terminal(ide: Ide) -> Element =>
    div(class="flex flex-col h-64 border-t-1", bg=Shade, edge=Edge,
        div(class="px-4 py-1 text-xs", fg=Dim, "TERMINAL   Ctrl+`"),
        div(id="term-out", class="flex flex-col grow px-4 overflow-y-scroll",
            font=face(ide),
            ide.shell.split("\n").map(l => panel_line(l))),
        div(class="px-4 py-2 text-xs", font=face(ide), "$ {ide.cmd}_"))

files_said(ide: Ide) -> str {
    word = t(ide, "files")

    "{str(ide.files.length())} {word}"
}

footer(ide: Ide) -> Element =>
    div(class="flex flex-row items-center gap-6 px-4 py-1 border-t-1",
        bg=Shade, edge=Edge,
        div(class="text-xs",
            ide.open == "" ? t(ide, "no-file")
                           : (ide.dirty ? "{tail(ide.open)} *"
                                        : tail(ide.open))),
        div(class="text-xs", fg=Dim,
            "ln {str(ide.line + 1)}, col {str(ide.col + 1)}"),
        div(class="text-xs", fg=Dim, files_said(ide)),
        div(class="text-xs", fg=Dim,
            "{ide.target} via {panel_for(ide.target)}"))

/** A control a doc comment asked for, drawn the way the tag syntax draws
 * anything else.
 */
control(t: Tag) -> Element =>
    div(class="flex flex-row gap-2",
        div(class="w-24 text-xs", bound_name(t)),
        knob(bound_call(t)))

/** The control the comment named, or its own text when it named one nobody
 * draws.
 */
knob(call: str) -> Element {
    if call.starts_with("slider(") {
        return div(class="flex flex-row grow gap-1",
                   div(class="text-xs", span_lo(call)),
                   div(class="grow h-1"),
                   div(class="text-xs", span_hi(call)))
    }

    if call.starts_with("toggle(") {
        return div(class="text-sm", "[ ]")
    }

    div(class="text-xs", call == "" ? "no control" : call)
}

/** `slider(1..10)` names its ends with the range Maca already writes half-open.
 */
span_lo(call: str) -> str =>
    between(call, "(", "..")

span_hi(call: str) -> str =>
    between(call, "..", ")")
