import { index_of_from, last_index_of } from std/text
import { basename } from std/path
import { command, rest } from cli/spec
import { parse, from } from cli/parse
import { help } from cli/help
import { ok, bad, dim } from cli/style

is_ident_char(c: str) -> bool =>
    c.is_alpha() || c.is_ascii_digit() || c == "_"

strip_blocks(s: str) -> str {
    open = s.index_of("/*")
    close = if open < 0 { -1 } else { index_of_from(s, "*/", open) }

    if close < 0 {
        s
    } else {
        s.substr(0, open) ++ " "
            ++ strip_blocks(s.substr(close + 2, s.length() - close - 2))
    }
}

strip_lines(lines: str[], i: int, acc: str) -> str {
    if i >= lines.length() {
        acc
    } else {
        strip_lines(lines, i + 1, acc ++ clean_line(lines.get(i)) ++ "\n")
    }
}

clean_line(line: str) -> str {
    cut = line.index_of("//")
    body = if cut < 0 { line } else { line.substr(0, cut) }

    if body.trim().starts_with("#") {
        ""
    } else {
        body
    }
}

strip(src: str) -> str =>
    strip_lines(strip_blocks(src).split("\n"), 0, "")

map_type(c: str) -> str {
    t = c.trim()

    if !t.contains("*") {
        scalar_type(t)
    } else if t.contains("char") && !t.contains("char**") {
        "str"
    } else {
        "int"
    }
}

scalar_type(t: str) -> str {
    if t.contains("double") || t.contains("float") {
        "float"
    } else {
        "int"
    }
}

is_c_type_word(w: str) -> bool =>
    w == "void" || w == "int" || w == "char" || w == "short" || w == "long"
        || w == "float" || w == "double" || w == "unsigned" || w == "signed"
        || w == "size_t" || w == "bool"
        || w == "int8_t" || w == "int16_t" || w == "int32_t" || w == "int64_t"
        || w == "uint8_t" || w == "uint16_t"
        || w == "uint32_t" || w == "uint64_t"

last_ident(s: str) -> str {
    t = trim_trailing(s.trim())
    start = ident_start(t, t.length())
    id = t.substr(start, t.length() - start)

    if id.length() == 0 || id.at(0).is_ascii_digit() {
        ""
    } else {
        id
    }
}

trim_trailing(s: str) -> str {
    trailing = s.ends_with("*") || s.ends_with(" ") || s.ends_with("\t")

    if s.length() == 0 || !trailing {
        s
    } else {
        trim_trailing(s.substr(0, s.length() - 1))
    }
}

ident_start(s: str, at: int) -> int {
    if at <= 0 || !is_ident_char(s.at(at - 1)) {
        at
    } else {
        ident_start(s, at - 1)
    }
}

map_params(params: str) -> str {
    p = params.trim()

    if p.length() == 0 || p == "void" {
        ""
    } else {
        join_params(p.split(","), 0)
    }
}

join_params(ps: str[], i: int) -> str {
    if i >= ps.length() {
        ""
    } else if i == ps.length() - 1 {
        one_param(ps.get(i), i)
    } else {
        one_param(ps.get(i), i) ++ ", " ++ join_params(ps, i + 1)
    }
}

one_param(raw_in: str, i: int) -> str {
    raw = raw_in.trim()
    id = last_ident(raw)
    named = id.length() > 0 && !is_c_type_word(id)

    if !named {
        "a" ++ str(i) ++ ": " ++ map_type(raw)
    } else {
        id ++ ": " ++ map_type(raw.substr(0, raw.length() - id.length()))
    }
}

skip_decl(head: str, params: str, decl: str) -> bool =>
    head.contains("typedef") || head.contains("struct") || head.contains("enum")
        || head.contains("union") || params.contains("(*") || decl.contains("=")

prototype(chunk: str) -> str {
    decl = chunk.trim()
    open = decl.index_of("(")
    close = last_index_of(decl, ")")
    unbalanced = open < 0 || close < 0 || close < open

    if decl.length() == 0 || unbalanced {
        ""
    } else {
        proto_parts(decl, open, close)
    }
}

proto_parts(decl: str, open: int, close: int) -> str {
    head = decl.substr(0, open)
    params = decl.substr(open + 1, close - open - 1)
    name = last_ident(head)

    if skip_decl(head, params, decl) || name.length() == 0 {
        ""
    } else {
        ret = map_type(head.substr(0, head.length() - name.length()))
        name ++ "(" ++ map_params(params) ++ ") -> " ++ ret
    }
}

decls(chunks: str[], i: int, acc: str) -> str {
    if i >= chunks.length() {
        acc
    } else {
        line = prototype(chunks.get(i))
        if line.length() == 0 {
            decls(chunks, i + 1, acc)
        } else {
            decls(chunks, i + 1, acc ++ line ++ "\n")
        }
    }
}

generate(src: str, header_name: str) -> str {
    found = decls(strip(src).split(";"), 0, "")
    body = if found.length() == 0 {
        "// (no function prototypes found)\n"
    } else {
        found
    }

    "// Generated by `bindgen " ++ header_name
        ++ "`: Maca FFI declarations.\n"
        ++ "// Pointers become opaque `int` handles; `char*` becomes `str`.\n"
        ++ "import \"" ++ header_name ++ "\"\n\n"
        ++ body
}

sample_header() -> str =>
    "/* a sample C header */\n"
        ++ "#include <stddef.h>\n"
        ++ "typedef struct sqlite3 sqlite3;\n"
        ++ "const char* sqlite3_libversion(void);\n"
        ++ "int sqlite3_open(const char *filename, sqlite3 **ppDb);\n"
        ++ "double sqlite3_column_double(sqlite3_stmt*, int iCol);\n"
        ++ "int sqlite3_close(sqlite3*);\n"

Spec = command("bindgen", "a C header, as Maca FFI declarations")
    .rest("path", "the header to read, then where to write the module")

main(argv: str[]) -> int {
    got = parse(Spec, argv)
    paths = from(got, 0)

    if got.wants_help {
        info(help(Spec))
        0
    } else if got.error != "" {
        err(bad(got.error))
        1
    } else if paths.length() > 2 {
        err(bad("bindgen takes a header and a destination, got "
                ++ paths.join(", ")))
        1
    } else {
        emit(paths)
    }
}

emit(paths: str[]) -> int {
    dest = paths.length() > 1 ? paths.get(1) : ""

    if paths.length() == 0 {
        deliver(generate(sample_header(), "sqlite3.h"), dest)
    } else if !file_exists(paths.get(0)) {
        err(bad("bindgen: cannot read " ++ paths.get(0)))
        1
    } else {
        deliver(generate(read_file(paths.get(0)), basename(paths.get(0))),
                dest)
    }
}

deliver(text: str, dest: str) -> int {
    if dest == "" {
        print(text)
        0
    } else {
        write_file(dest, text)
        info(ok("wrote " ++ dim(dest)))
        0
    }
}
