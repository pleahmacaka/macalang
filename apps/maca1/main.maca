import maca/token
import maca/lexer
import maca/parser
import maca/check
import maca/emit_c
import maca/emit_rust
import maca/emit_js
import maca/emit_nix
import maca/emit_embedded
import maca/emit_jvm
import maca/print
import { Span, trace } from profile/trace
import { flame_svg_in, percent } from profile/flame
import std/json

Unit = {
    seen:    str[]
    names:   str[]
    owners:  str[]
    asks:    str[]
    toks:    Token[]
    errs:    str[]
    unknown: str[]
}

main(args: str[]) -> int {
    if args.length() >= 1 && args.get(0) == "build" {
        build_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "run" {
        run_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "test" {
        test_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "check" {
        check_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "fix" {
        fix_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "spec" {
        spec_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "fmt" {
        fmt_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "watch" {
        watch_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "profile" {
        profile_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "dev" {
        dev_cmd(args)
    } else if args.length() >= 1 && module_asked(args.get(0)) {
        module_cmd(args)
    } else if args.length() >= 1 && tooled(args.get(0)) {
        run_file(tool_path(args.get(0)), args.slice(1, args.length()))
    } else if args.length() >= 1 && args.get(0) == "add" {
        add_cmd(args)
    } else if args.length() >= 1 && args.get(0) == "install" {
        install_cmd()
    } else if args.length() >= 1 && args.get(0) == "update" {
        update_cmd()
    } else if args.length() >= 1 && args.get(0) == "upgrade" {
        upgrade_cmd()
    } else if args.length() >= 1 && args.get(0) == "init" {
        init_project(args.length() >= 2 ? args.get(1) : ".")
    } else if args.length() >= 1 && version_asked(args.get(0)) {
        info("maca {Version}")

        0
    } else if args.length() >= 1 && help_asked(args.get(0)) {
        usage()
    } else if args.length() >= 2 && args.get(0).ends_with(".maca") {
        compile_file(args)
    } else if args.length() >= 1 {
        unknown_cmd(args.get(0))
    } else {
        demo()
    }
}

version_asked(a: str) -> bool =>
    a == "--version" || a == "-V" || a == "version"

help_asked(a: str) -> bool =>
    a == "--help" || a == "-h" || a == "help"

/// The commands this binary serves, which is the first thing anyone reads.
usage() -> int {
    info("maca {Version}\n"
         ++ "\nusage: maca <command> [args]\n"
         ++ "\ncommands:\n"
         ++ "  init  [dir]                  scaffold a new project (maca.toml, main.maca)\n"
         ++ "  build [file.maca] [-o out]   compile (native | --target nix|js|rust|wasm)\n"
         ++ "  run   [file.maca] [args..]   compile and run\n"
         ++ "  -m <module>[.<fn>] [args..]  run one function out of a module\n"
         ++ "  watch <file.maca> [args..]   rebuild and rerun it on every change\n"
         ++ "  fmt   <file.maca>... [--check]  format in place\n"
         ++ "  lint  [path...]              Maca style rules, over a file or a tree\n"
         ++ "  doc   <dir> <file.maca>...   an API reference, rendered from /// lines\n"
         ++ "  test  [file.maca]            every `test_...` in the file, or every suite\n"
         ++ "  profile <file.maca> [-o s]   where the run spent its instructions\n"
         ++ "  dev   [dev.maca] [-o out]    the flake `nix develop` enters\n"
         ++ "  add   <spec>...              add a dependency, and fetch it\n"
         ++ "  install                      fetch what maca.toml names, at the locked version\n"
         ++ "  update                       re-resolve every dependency to its newest match\n"
         ++ "  upgrade                      replace this toolchain with the latest release\n"
         ++ "  bindgen <header.h> <out>     a C header, as Maca FFI declarations\n"
         ++ "  check [file.maca]            diagnostics, one line each\n"
         ++ "  fix   <file.maca>...         delete the keywords Maca has "
         ++ "no word for\n"
         ++ "  spec  [--package <name>]     the language, as one document\n"
         ++ "  --version                    print the toolchain version\n"
         ++ "  --help                       this\n"
         ++ "\nwith no file, build/run/test/check are about the package the directory holds:\n"
         ++ "  its [[bin]], chosen with --bin <name> or [build] bin\n"
         ++ "\nbuild targets: native (default), --target nix | js | rust "
         ++ "| jvm | tauri | wasm | embedded\n"
         ++ "\n[build] in maca.toml declares target, out, mcu, classpath, cflags and\n"
         ++ "  bin, so a project builds by\n"
         ++ "  saying `maca build`; a flag on the line still wins\n"
         ++ "\na [scripts] name in maca.toml is a command of its own, so `maca <name>`\n"
         ++ "  runs the line that table gives it")

    0
}

/// A `[scripts]` name in the manifest here is a command, so `maca <name>` runs what it names.
unknown_cmd(name: str) -> int {
    script = chain_value(here_chain(), 0, "[scripts]", name)

    if script != "" {
        run_script(script)
    } else {
        err("maca: unknown command `{name}`")
        usage()

        2
    }
}

run_script(cmd: str) -> int {
    if env("OS") == "Windows_NT" {
        exec("cmd", ["/C", cmd])
    } else {
        exec("sh", ["-c", cmd])
    }
}

Version = "0.3.3"

check_only(src: str, target: str) -> int {
    unit = unit_of(src)
    scanned = end_run(lexed(unit.toks, unit.errs), 0, 0)
    parsed = parse_module(scanned.tokens, 0, [])
    raw = desugared(parsed, src)

    early = report_all("import", unit.unknown, 0) +
        report_all("scan", scanned.errors, 0) +
        report_all("parse", parsed.errors, 0) +
        report_all("embed", raw.errors, 0)

    early > 0 ? early : report_all("check", check_errors_on(raw, target), 0)
}

init_project(root: str) -> int {
    name = leaf_of(root)

    make_dir(root)
    write_absent("{root}/maca.toml",
                 "[package]\nname = \"{name}\"\n\n[[bin]]\n"
                     ++ "path = \"main.maca\"\n")
    write_absent("{root}/main.maca",
                 "main() -> int \{\n    info(\"hello\")\n    0\n\}\n")
    info("initialized Maca project `{name}` in {root}")

    0
}

write_absent(path: str, text: str) -> bool {
    if file_exists(path) {
        false
    } else {
        write_file(path, text)
    }
}

leaf_of(root: str) -> str {
    cut = sep_after(root.chars(), root.length() - 1)
    tail = root.slice(cut, root.length())

    if tail == "" || tail == "." {
        "app"
    } else {
        tail
    }
}

/// `[format]` says what one level of indentation is written with.
indent_unit(chain: str[]) -> str {
    size = chain_value(chain, 0, "[format]", "indent_size")
    wide = size == "" ? 4 : int(size)

    chain_value(chain, 0, "[format]", "indent_style") == "tab"
        ? "\t"
        : space_run(wide)
}

space_run(n: int) -> str =>
    n <= 0 ? "" : " " ++ space_run(n - 1)

/// The file states its own step by the narrowest indent it uses, and the declared unit replaces it.
reindent(text: str, unit: str) -> str {
    lines = text.split("\n")
    step = indent_step(lines)
    out: str[] = []
    raw = false
    i = 0

    while i < lines.length() {
        line = lines.get(i)
        fences = fence_count(line)

        if raw {
            out = out.push(line)
            raw = fences % 2 == 0
        } else {
            raw = fences % 2 == 1
            out = out.push(reindent_line(line, unit, step))
        }

        i = i + 1
    }

    out.join("\n")
}

indent_step(lines: str[]) -> int {
    best = 0
    raw = false
    i = 0

    while i < lines.length() {
        line = lines.get(i)
        fences = fence_count(line)

        if raw {
            raw = fences % 2 == 0
        } else {
            raw = fences % 2 == 1
            lead = indent_width(line, 0)
            narrow = line.trim() != "" && lead > 0 && (best == 0 || lead < best)
            best = narrow ? lead : best
        }

        i = i + 1
    }

    best == 0 ? 4 : best
}

/// A line the step does not divide was aligned by hand, and stays where it was put.
reindent_line(line: str, unit: str, step: int) -> str {
    lead = indent_width(line, 0)

    if line.trim() == "" {
        ""
    } else if lead % step != 0 {
        line
    } else {
        unit_times(unit, lead / step) ++ line.slice(lead, line.length())
    }
}

fence_count(line: str) -> int {
    cs = line.chars()
    hits = 0
    j = 0

    while j + 2 < cs.length() {
        if cs.get(j) == "\"" && cs.get(j + 1) == "\"" && cs.get(j + 2) == "\"" {
            hits = hits + 1
            j = j + 3
        } else {
            j = j + 1
        }
    }

    hits
}

unit_times(unit: str, n: int) -> str =>
    n <= 0 ? "" : unit ++ unit_times(unit, n - 1)

indent_width(line: str, i: int) -> int =>
    i < line.length() && line.at(i) == " " ? indent_width(line, i + 1) : i

format_file(src: str, only_check: bool) -> int {
    before = read_file(src)
    unit = indent_unit(chain_of(src))
    after = reindent(before, unit)

    if after != reindent(after, unit) {
        err("{src}: left as it is, the formatter cannot write it back")

        1
    } else if before == after {
        0
    } else if only_check {
        info("{src}: not formatted")

        1
    } else {
        write_file(src, after)

        0
    }
}

/// `fmt` formats every file it is given, and `--check` reports instead.
fmt_cmd(args: str[]) -> int {
    files = fix_files(args, 1, [])

    if files.length() == 0 {
        err("usage: maca fmt <file.maca>... [--check]")

        2
    } else {
        fmt_each(files, 0, args.index_of("--check") >= 0, 0)
    }
}

fmt_each(files: str[], i: int, only_check: bool, acc: int) -> int {
    if i >= files.length() {
        acc
    } else {
        fmt_each(files, i + 1, only_check,
                 acc + format_file(files.get(i), only_check))
    }
}

/// `fix` deletes a keyword Maca has no word for, the one edit safe unread.
fix_cmd(args: str[]) -> int {
    files = fix_files(args, 1, [])

    if files.length() == 0 {
        err("usage: maca fix <file.maca>... [--dry-run]")

        2
    } else {
        fix_each(files, 0, args.index_of("--dry-run") >= 0, 0)
    }
}

fix_files(args: str[], i: int, acc: str[]) -> str[] {
    if i >= args.length() {
        acc
    } else if args.get(i).starts_with("--") {
        fix_files(args, i + 1, acc)
    } else {
        fix_files(args, i + 1, acc ++ [args.get(i)])
    }
}

fix_each(files: str[], i: int, dry: bool, bad: int) -> int {
    if i >= files.length() {
        bad
    } else {
        fix_each(files, i + 1, dry, bad + fix_one(files.get(i), dry))
    }
}

fix_one(path: str, dry: bool) -> int {
    if !file_exists(path) {
        err("fix: cannot read {path}")

        1
    } else {
        fix_lexed(path, read_file(path), dry)
    }
}

fix_lexed(path: str, src: str, dry: bool) -> int {
    ts = lex(src)
    n = phantom_count(ts, 0, 0)

    if n > 0 && !dry {
        write_file(path, cut_all(src.chars(), ts, ts.length() - 1).join(""))
    }

    info("{path}: {fix_said(dry)} {n}, left the rest to be read")

    0
}

fix_said(dry: bool) -> str =>
    dry ? "would delete" : "deleted"

/// A word from another language, with a name of its own on the line behind it.
phantom_at(ts: Token[], i: int) -> bool =>
    i + 1 < ts.length() && phantom_word(ts.get(i))
        && ts.get(i + 1).kind == TIdent && !ts.get(i + 1).fresh

phantom_word(t: Token) -> bool =>
    (t.kind == TIdent || t.kind == KwLet) && phantom_spelling(t.text)

phantom_spelling(w: str) -> bool =>
    w == "let" || w == "var" || w == "fn" || w == "func" || w == "def"
        || w == "type" || w == "async"

phantom_count(ts: Token[], i: int, n: int) -> int {
    seen = n
    at = i

    while at < ts.length() {
        seen = phantom_at(ts, at) ? seen + 1 : seen
        at = at + 1
    }

    seen
}

/// Cutting from the back is what leaves every position ahead of it still true.
cut_all(cs: str[], ts: Token[], i: int) -> str[] {
    if i < 0 {
        cs
    } else if phantom_at(ts, i) {
        cut_all(cut_one(cs, ts.get(i)), ts, i - 1)
    } else {
        cut_all(cs, ts, i - 1)
    }
}

cut_one(cs: str[], t: Token) -> str[] =>
    cs.slice(0, t.pos)
        ++ cs.slice(space_end(cs, t.pos + t.text.length()), cs.length())

space_end(cs: str[], i: int) -> int {
    if i < cs.length() && cs.get(i) == " " {
        space_end(cs, i + 1)
    } else {
        i
    }
}

WatchPollMs = 300

/// `watch` rebuilds and reruns a file every time it changes, until the shell stops it.
watch_cmd(args: str[]) -> int {
    src = first_named(args)

    if src == "" {
        err("watch: expected a .maca file")

        2
    } else if !file_exists(src) {
        err("watch: {src} is not a file")

        2
    } else {
        info("watching {src}; Ctrl-C to stop")

        watched(src, args.slice(2, args.length()))
    }
}

watched(src: str, rest: str[]) -> int {
    files = unit_of(src).seen
    seen = 0

    while true {
        now = newest_ms(files, 0, 0)

        if now > seen {
            seen = now

            info("── {src} changed, rebuilding ──")
            info("── exited {str(run_file(src, rest))} ──")
        }

        sleep_ms(WatchPollMs)
    }

    0
}

/// An imported file is part of the program, so a change there rebuilds too.
newest_ms(files: str[], i: int, best: int) -> int {
    if i >= files.length() {
        best
    } else {
        at = modified_ms(files.get(i))

        newest_ms(files, i + 1, at > best ? at : best)
    }
}

module_asked(a: str) -> bool =>
    a == "-m" || a == "--module"

Entry = {
    module: str
    named:  str
    path:   str
}

/// `maca -m std.text.lines` runs one function of a module, found the way an import finds it.
module_cmd(args: str[]) -> int {
    if args.length() < 2 {
        err("-m: expected a module, e.g. `maca -m http.serve`")

        2
    } else {
        module_spec(args.get(1), args.slice(2, args.length()))
    }
}

module_spec(spec: str, rest: str[]) -> int {
    why = spec_refusal(spec)

    if why != "" {
        err("-m: {why}")

        2
    } else {
        module_found(module_entry(spec), rest)
    }
}

spec_refusal(spec: str) -> str {
    if spec.starts_with("/") {
        "`{spec}` is an absolute path, not a module"
    } else if empty_segment(spec.replace(".", "/").split("/"), 0) {
        "`{spec}` has an empty path segment"
    } else {
        ""
    }
}

empty_segment(ps: str[], i: int) -> bool {
    if i >= ps.length() {
        false
    } else if ps.get(i) == "" {
        true
    } else {
        empty_segment(ps, i + 1)
    }
}

/// The last dot names a function, unless the whole spec is itself a module.
module_entry(spec: str) -> Entry {
    cut = last_of(spec.chars(), ".", spec.length() - 1)
    head = cut <= 0 ? "" : spec.slice(0, cut).replace(".", "/")
    found = head == "" ? "" : module_path(head)

    if found != "" {
        Entry { module = head, named = spec.slice(cut + 1, spec.length()),
                path = found }
    } else {
        whole_entry(spec.replace(".", "/"))
    }
}

whole_entry(whole: str) -> Entry =>
    Entry { module = whole, named = "", path = module_path(whole) }

module_path(name: str) -> str =>
    resolved("", name)

module_found(at: Entry, rest: str[]) -> int {
    if at.path == "" {
        err("-m: no module `{at.module}`; looked for {at.module}.maca under "
            ++ "the package roots this directory reaches")

        2
    } else {
        module_entered(at, rest)
    }
}

module_entered(at: Entry, rest: str[]) -> int {
    items = parse_module(lex(read_file(at.path)), 0, []).items
    own = leaf_of(at.module)
    want = at.named == "" ? entry_fn(items, own) : at.named
    def = fn_at(items, want, 0)

    if want == "" {
        err("-m: `{at.module}` defines no `main` and no `{own}`; name the "
            ++ "function, as in `maca -m {at.module}.something`")

        2
    } else if def < 0 {
        err("-m: `{at.module}` defines no function `{want}`")

        2
    } else {
        module_calling(at, items.get(def), want, rest)
    }
}

/// `main` is what a module is run by, and a module with none is run by its own name.
entry_fn(items: Stmt[], own: str) -> str {
    if fn_at(items, "main", 0) >= 0 {
        "main"
    } else if fn_at(items, own, 0) >= 0 {
        own
    } else {
        ""
    }
}

fn_at(items: Stmt[], want: str, i: int) -> int {
    if i >= items.length() {
        -1
    } else if items.get(i).kind == SFn && items.get(i).name == want {
        i
    } else {
        fn_at(items, want, i + 1)
    }
}

module_calling(at: Entry, def: Stmt, want: str, rest: str[]) -> int {
    shape = call_shape(def)

    if shape == "" {
        err("-m: `{want}` takes ({param_list(def.params, 0, "")}); an entry "
            ++ "point takes either nothing or one `str[]`")

        2
    } else if want == "main" {
        run_file(at.path, rest)
    } else {
        module_shimmed(at, want ++ shape, def.ret, rest)
    }
}

/// An entry point takes nothing, or the leftover command line as one `str[]`.
call_shape(def: Stmt) -> str {
    if def.params.length() == 0 {
        "()"
    } else if def.params.length() == 1 && def.params.get(0).ty == "str[]" {
        "(args)"
    } else {
        ""
    }
}

param_list(ps: Expr[], i: int, acc: str) -> str {
    if i >= ps.length() {
        acc
    } else if acc == "" {
        param_list(ps, i + 1, "{ps.get(i).text}: {ps.get(i).ty}")
    } else {
        param_list(ps, i + 1, acc ++ ", {ps.get(i).text}: {ps.get(i).ty}")
    }
}

EntryDir = ".maca"

module_shimmed(at: Entry, call: str, ret: str, rest: str[]) -> int {
    shim = "{EntryDir}/maca1-entry-{str(now_ms())}.maca"

    make_dir(EntryDir)
    write_file(shim, entry_source(at.module, call, ret))

    code = run_file(shim, rest)

    remove_file(shim)

    code
}

entry_source(module: str, call: str, ret: str) -> str =>
    "import {module}\n\nmain(args: str[]) -> int \{\n"
        ++ entry_body(call, ret) ++ "\}\n"

/// A declared `int` is the exit status itself, a `bool` is the shell's 0 and 1.
entry_body(call: str, ret: str) -> str {
    if ret == "int" {
        "    {call}\n"
    } else if ret == "bool" {
        "    {call} ? 0 : 1\n"
    } else {
        "    {call}\n    0\n"
    }
}

flag_after(args: str[], name: str) -> str {
    at = args.index_of(name)

    if at < 0 || at + 1 >= args.length() {
        ""
    } else {
        args.get(at + 1)
    }
}

/// The jvm target compiles what it emits, so `-o` names the directory the class files land in.
build_classes(src: str, out: str, cp: str) -> int {
    name = jvm_class(src)
    java = "{out}/{name}.java"

    make_dir(out)

    errs = compile_file([src, java, "jvm", name])

    if errs > 0 {
        errs
    } else if !javac_here() {
        err("maca: no javac on PATH, so {java} was written but not compiled.")

        2
    } else {
        write_file(java, java_imports(src) ++ read_file(java))

        exec("javac", javac_line(java, out, cp))
    }
}

/// The JVM looks a class up under the name of its file, so the public class carries the source's stem.
jvm_class(src: str) -> str {
    stem = stem_of(src)

    stem == "" ? "Main" : stem.at(0).upper() ++ stem.slice(1, stem.length())
}

/// Java resolves no name by itself, so every class a Java import named is imported into the emitted unit.
java_imports(src: str) -> str =>
    java_named(unit_of(src).seen, 0, "")

java_named(files: str[], i: int, acc: str) -> str {
    if i >= files.length() {
        acc == "" ? "" : acc ++ "\n"
    } else {
        got = lex_all(read_file(files.get(i))).tokens

        java_named(files, i + 1, acc ++ java_in(got, 0, ""))
    }
}

java_in(ts: Token[], i: int, acc: str) -> str {
    out = acc
    at = i

    while ts.get(at).kind != Eof {
        if foreign_at(ts, at, "java") {
            out = out ++ "import {ts.get(at + 1).text};\n"
            at = at + 2
        } else {
            at = at + 1
        }
    }

    out
}

javac_line(java: str, out: str, cp: str) -> str[] =>
    cp == "" ? [java, "-d", out] : [java, "-d", out, "-cp", cp]

javac_here() -> bool =>
    on_path("javac")

on_path(cmd: str) -> bool =>
    capture("sh", ["-c", "command -v " ++ cmd]).trim() != ""

CargoName = "maca_app"

/// The rust target compiles what it emits, so `-o` names the binary and the source lands beside it.
build_rust(src: str, out: str) -> int {
    rs = out ++ ".rs"
    errs = compile_file([src, rs, "rust"])
    deps = manifest_keys(chain_of(src), "[rust-dependencies]", 0)

    if errs > 0 {
        errs
    } else if deps.length() > 0 {
        cargo_built(src, rs, out, deps)
    } else if !on_path("rustc") {
        err("maca: no rustc on PATH, so {rs} was written but not compiled.")

        2
    } else {
        exec("rustc", [rs, "--edition", "2021", "-O", "-o", out])
    }
}

/// A program that names a crate is built as a Cargo project beside the binary, because Cargo is what resolves a dependency.
cargo_built(src: str, rs: str, out: str, deps: str[]) -> int {
    chain = chain_of(src)
    proj = out ++ "-cargo"

    make_dir(proj ++ "/src")
    write_file("{proj}/Cargo.toml",
               cargo_toml(chain, deps, manifest_keys(chain, "[rust-patch]",
                                                     0)))
    write_file("{proj}/src/main.rs", read_file(rs))

    if !on_path("cargo") {
        err("maca: no cargo on PATH, so {rs} was written but its "
            ++ "[rust-dependencies] could not be built.")

        2
    } else {
        cargo_built_at(proj, out)
    }
}

cargo_built_at(proj: str, out: str) -> int {
    code = exec("cargo", ["build", "--release", "--quiet",
                          "--manifest-path", "{proj}/Cargo.toml"])

    code != 0 ? code : exec("cp", ["{proj}/target/release/{CargoName}", out])
}

cargo_toml(chain: str[], deps: str[], patch: str[]) -> str =>
    "[package]\nname = \"{CargoName}\"\nversion = \"0.0.0\"\n"
        ++ "edition = \"2021\"\n\n[[bin]]\nname = \"{CargoName}\"\n"
        ++ "path = \"src/main.rs\"\n\n[dependencies]\n"
        ++ cargo_entries(chain, "[rust-dependencies]", deps, 0, "")
        ++ cargo_patch(chain, patch)

cargo_patch(chain: str[], patch: str[]) -> str =>
    patch.length() == 0
        ? ""
        : "\n[patch.crates-io]\n"
              ++ cargo_entries(chain, "[rust-patch]", patch, 0, "")

cargo_entries(chain: str[], table: str, ks: str[], i: int, acc: str) -> str {
    if i >= ks.length() {
        acc
    } else {
        rhs = cargo_value(chain_value(chain, 0, table, ks.get(i)))

        cargo_entries(chain, table, ks, i + 1, acc ++ "{ks.get(i)} = {rhs}\n")
    }
}

/// An inline table reaches Cargo as it was written, and anything else is a version string.
cargo_value(v: str) -> str =>
    v.starts_with("{{") ? v : "\"{v}\""

/// The keys of one manifest table, off the nearest manifest on the chain that states it.
manifest_keys(chain: str[], table: str, i: int) -> str[] {
    if i >= chain.length() {
        []
    } else {
        here = table_keys(read_file(chain.get(i) ++ Manifest), table)

        here.length() > 0 ? here : manifest_keys(chain, table, i + 1)
    }
}

/// `lint`, `doc` and `bindgen` are tools of the toolchain rather than targets.
tooled(name: str) -> bool =>
    name == "lint" || name == "doc" || name == "bindgen"

/// The tools are Maca programs of their own, so the CLI runs them rather than linking them.
tool_path(name: str) -> str {
    if name == "lint" {
        "apps/lint/lint.maca"
    } else if name == "doc" {
        "apps/macadoc/macadoc.maca"
    } else {
        "apps/bindgen/bindgen.maca"
    }
}

build_out(src: str, out: str, target: str, mcu: str, cp: str) -> int {
    if target == "" || target == "native" || target == "c" {
        build_binary(src, out)
    } else if target == "embedded" {
        build_firmware(src, out, mcu)
    } else if target == "wasm" {
        build_wasm(src, out)
    } else if target == "js" {
        build_page(src, out)
    } else if target == "tauri" {
        build_tauri(src, out)
    } else if target == "rust" {
        build_rust(src, out)
    } else if target == "nix" {
        compile_file([src, out, target])
    } else if target == "jvm" {
        build_classes(src, out, cp)
    } else {
        err("maca: no target `{target}`. Try native, rust, js, nix, "
            ++ "tauri, wasm, embedded or jvm.")

        2
    }
}

/// The js and tauri targets are a directory, and every other target is a name.
default_out(src: str, target: str) -> str {
    if target == "js" {
        stem_of(src) ++ "-web"
    } else if target == "tauri" {
        stem_of(src) ++ "-tauri"
    } else {
        stem_of(src)
    }
}

PageAsset = {
    kind:  str
    spec:  str
    names: str
    text:  str
}

Found = {
    kind: str
    file: str
    why:  str
}

NpmPrefix = "npm:"
PackageJson = "package.json"

/// `[page]` in `maca.toml` says what the page is, as against what its file is called.
page_keys() -> str[] =>
    ["title", "lang", "description"]

/// A misspelled `[page]` key is silently nothing, so it is named instead.
stray_page_key(chain: str[], i: int) -> str {
    if i >= chain.length() {
        ""
    } else {
        here = stray_of(table_keys(read_file(chain.get(i) ++ Manifest),
                                   "[page]"), page_keys(), 0)

        here != "" ? here : stray_page_key(chain, i + 1)
    }
}

page_setting(chain: str[], key: str, dflt: str) -> str {
    got = chain_value(chain, 0, "[page]", key)

    got == "" ? dflt : got
}

/// The js target is a directory that opens with no server: an `index.html` carrying every asset the program named, beside the `app.js` it was built from.
build_page(src: str, dir: str) -> int {
    chain = chain_of(src)
    stray = stray_page_key(chain, 0)

    if stray != "" {
        err("maca.toml [page]: unknown key `{stray}` (known: "
            ++ page_keys().join(", ") ++ ")")

        2
    } else {
        make_dir(dir)
        errs = compile_file([src, "{dir}/app.js", "js"])

        errs > 0 ? errs : page_written(src, dir, chain)
    }
}

page_written(src: str, dir: str, chain: str[]) -> int {
    assets = page_assets(unit_of(src).seen, 0, [])
    found = resolved_assets(src, assets, 0, [])
    bad = asset_errors(found, 0, [])

    if bad.length() > 0 {
        report_all("asset", bad, 0)
    } else {
        js = read_file("{dir}/app.js")

        write_file("{dir}/app.css", "")
        write_file("{dir}/index.html",
                   page_html(src, chain, assets, found, js))

        0
    }
}

/// Every asset the files of a program import, in the order the page inlines them.
page_assets(files: str[], i: int, acc: PageAsset[]) -> PageAsset[] {
    if i >= files.length() {
        acc
    } else {
        text = read_file(files.get(i))

        page_assets(files, i + 1,
                    acc ++ assets_in(text, lex_all(text).tokens, 0, []))
    }
}

assets_in(src: str, ts: Token[], i: int, acc: PageAsset[]) -> PageAsset[] {
    out = acc
    at = i

    while ts.get(at).kind != Eof {
        if ts.get(at).kind == KwImport {
            out = out ++ asset_at(src, ts, at + 1)
            at = import_end(ts, at + 1)
        } else {
            at = at + 1
        }
    }

    out
}

/// A quoted import is a file the page carries, a tagged block is source the page carries as written, and a selective one from a script binds the names it asked that script for.
asset_at(src: str, ts: Token[], i: int) -> PageAsset[] {
    at = ts.get(i).kind == LBrace ? selection_end(ts, i + 1) + 2 : i

    if ts.get(i).kind == TStr && raw_block_at(src, ts, i + 1) {
        [PageAsset { kind = asset_kind(ts.get(i).text), spec = "", names = "",
                     text = raw_block(src, ts.get(i + 1).pos) }]
    } else if ts.get(i).kind == TStr {
        [PageAsset { kind = asset_kind(ts.get(i).text),
                     spec = ts.get(i).text, names = "", text = "" }]
    } else if ts.get(i).kind == LBrace && ts.get(at).kind == TStr {
        [PageAsset { kind = "script", spec = ts.get(at).text,
                     names = asked_names(ts, i + 1, []).join(" "), text = "" }]
    } else {
        []
    }
}

/// A named import is a block when what follows the name opens with `"""`.
raw_block_at(src: str, ts: Token[], i: int) -> bool =>
    ts.get(i).kind == TStr
        && src.slice(ts.get(i).pos, ts.get(i).pos + 3) == "\"\"\""

/// The block as it was written, taken off the source rather than the token, whose text is escaped for a string literal.
raw_block(src: str, at: int) -> str {
    rest = src.slice(at + 3, src.length())
    ends = rest.index_of("\"\"\"")

    ends < 0 ? rest : rest.slice(0, ends)
}

asked_names(ts: Token[], i: int, acc: str[]) -> str[] {
    if ts.get(i).kind == RBrace || ts.get(i).kind == Eof {
        acc
    } else if ts.get(i).kind == TIdent {
        asked_names(ts, i + 1, acc ++ [ts.get(i).text])
    } else {
        asked_names(ts, i + 1, acc)
    }
}

/// What slot of the page a name asks for, which its extension is what says.
asset_kind(spec: str) -> str {
    path = spec.split("?").get(0).split("#").get(0)

    if path.ends_with(".css") {
        "stylesheet"
    } else if path.ends_with(".js") || path.ends_with(".mjs")
              || path.ends_with(".cjs") {
        "script"
    } else if path.ends_with(".wasm") {
        "wasm"
    } else if path.starts_with(NpmPrefix) {
        "package"
    } else {
        ""
    }
}

resolved_assets(src: str, xs: PageAsset[], i: int, acc: Found[]) -> Found[] {
    if i >= xs.length() {
        acc
    } else {
        resolved_assets(src, xs, i + 1,
                        acc ++ [resolved_asset(src, xs.get(i))])
    }
}

asset_errors(xs: Found[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else if xs.get(i).why == "" {
        asset_errors(xs, i + 1, acc)
    } else {
        asset_errors(xs, i + 1, acc ++ [xs.get(i).why])
    }
}

/// The file an asset import names: a package's own entry point after `npm:`, and otherwise a path beside the program.
resolved_asset(src: str, a: PageAsset) -> Found {
    file = dir_of(src) ++ a.spec

    if a.text != "" {
        Found { kind = a.kind, file = "", why = "" }
    } else if a.spec.starts_with(NpmPrefix) {
        package_found(src, a.spec.slice(NpmPrefix.length(), a.spec.length()),
                      a.kind)
    } else if a.kind == "" {
        Found { kind = "", file = "", why = "" }
    } else if file_exists(file) {
        Found { kind = a.kind, file = file, why = "" }
    } else {
        Found { kind = a.kind, file = "",
                why = "import \"{a.spec}\": {file} is not there" }
    }
}

package_found(src: str, spec: str, kind: str) -> Found {
    name = package_name(spec)
    sub = package_sub(spec)
    dir = installed_at(dir_of(src), name)
    said = "import \"{NpmPrefix}{spec}\": "

    if name == "" {
        Found { kind = kind, file = "", why = said ++ "no package named" }
    } else if dir == "" {
        Found { kind = kind, file = "",
                why = said ++ "`{name}` is not installed; run "
                    ++ "`maca add {NpmPrefix}{name}`" }
    } else if sub == "" {
        package_entry(dir, name, said)
    } else if file_exists("{dir}/{sub}") {
        Found { kind = kind, file = "{dir}/{sub}", why = "" }
    } else {
        Found { kind = kind, file = "",
                why = said ++ "`{name}` has no `{sub}`" }
    }
}

/// The entry point a package states, best first, which is the one it leads with.
package_entry(dir: str, name: str, said: str) -> Found {
    entry = first_entry(read_file("{dir}/{PackageJson}"), entry_keys(), 0)
    file = "{dir}/" ++ (entry.starts_with("./")
                            ? entry.slice(2, entry.length()) : entry)

    if entry == "" {
        Found { kind = "", file = "",
                why = said ++ "`{name}` states no entry point ("
                    ++ entry_keys().join("/") ++ " names no file of a kind a "
                    ++ "page can carry); name the file, as in `import "
                    ++ "\"{NpmPrefix}{name}/dist/…\"`" }
    } else if !file_exists(file) {
        Found { kind = "", file = "",
                why = said ++ "`{name}` states \"{entry}\", which is not "
                    ++ "there" }
    } else {
        Found { kind = asset_kind(entry), file = file, why = "" }
    }
}

/// The `package.json` keys a package states an entry point under, best first.
entry_keys() -> str[] =>
    ["style", "browser", "module", "main"]

first_entry(text: str, keys: str[], i: int) -> str {
    if i >= keys.length() {
        ""
    } else {
        got = pkg_entry(text, keys.get(i))

        asset_kind(got) != "" ? got : first_entry(text, keys, i + 1)
    }
}

/// One string value of a `package.json`, which is as much JSON as an entry is.
pkg_entry(text: str, key: str) -> str {
    cs = text.chars()
    at = text.index_of("\"{key}\"")
    from = at < 0 ? -1 : next_quote(cs, at + key.length() + 2)

    from < 0 ? "" : quoted_upto(cs, from + 1, [])
}

next_quote(cs: str[], i: int) -> int {
    if i >= cs.length() || cs.get(i) == "," || cs.get(i) == "\}" {
        -1
    } else if cs.get(i) == "\"" {
        i
    } else {
        next_quote(cs, i + 1)
    }
}

quoted_upto(cs: str[], i: int, acc: str[]) -> str {
    if i >= cs.length() || cs.get(i) == "\"" {
        acc.join("")
    } else {
        quoted_upto(cs, i + 1, acc ++ [cs.get(i)])
    }
}

/// The directory `maca add` left a package in, found from the file importing it.
installed_at(dir: str, name: str) -> str {
    at = "{dir}{DepsDir}/{name}"

    if is_dir(at) {
        at
    } else if dir == "" {
        ""
    } else {
        installed_at(parent_of(dir), name)
    }
}

/// A package is installed under the name `maca add` gave it, which drops the scope.
package_name(spec: str) -> str =>
    unscoped(spec).split("/").get(0)

package_sub(spec: str) -> str {
    rest = unscoped(spec)
    at = rest.index_of("/")

    at < 0 ? "" : rest.slice(at + 1, rest.length())
}

unscoped(spec: str) -> str {
    at = spec.index_of("/")

    if !spec.starts_with("@") {
        spec
    } else if at < 0 {
        ""
    } else {
        spec.slice(at + 1, spec.length())
    }
}

page_html(src: str, chain: str[], assets: PageAsset[], found: Found[],
          js: str) -> str {
    title = html_text(page_setting(chain, "title", stem_of(src)))
    lang = page_setting(chain, "lang", "")
    desc = page_setting(chain, "description", "")
    opened = lang == "" ? "<html>" : "<html lang=\"{html_text(lang)}\">"
    meta = desc == "" ? ""
        : "<meta name=\"description\" content=\"{html_text(desc)}\">\n"

    "<!doctype html>\n{opened}\n<head>\n<meta charset=\"utf-8\">\n"
        ++ "<meta name=\"viewport\" content=\"width=device-width,"
        ++ "initial-scale=1\">\n{meta}<title>{title}</title>\n"
        ++ inlined(assets, found, 0, [], true)
        ++ "<style>\n\n</style>\n</head>\n<body>\n<div id=\"app\"></div>\n"
        ++ MacaBridge
        ++ inlined(assets, found, 0, [], false)
        ++ "<script>\n{js}\n</script>\n</body>\n</html>\n"
}

/// A block a module supplies runs before the program, so the registry it writes to has to exist first.
MacaBridge = "<script>\nglobalThis.maca = globalThis.maca || {{\n"
    ++ "  _hosts: Object.create(null),\n"
    ++ "  provide(fns) {{ for (const k of Object.keys(fns))"
    ++ " this._hosts[k] = fns[k]; }},\n}};\n</script>\n"

/// A stylesheet belongs in the head, and a script after the element it mounts into.
inlined(assets: PageAsset[], found: Found[], i: int, acc: str[],
        head: bool) -> str {
    if i >= assets.length() {
        acc.join("")
    } else if head == (found.get(i).kind == "stylesheet") {
        inlined(assets, found, i + 1,
                acc ++ [one_inlined(assets.get(i), found.get(i))], head)
    } else {
        inlined(assets, found, i + 1, acc, head)
    }
}

one_inlined(a: PageAsset, f: Found) -> str {
    body = close_safe(a.text != "" ? a.text : read_file(f.file))

    if f.kind == "stylesheet" {
        "<style>\n" ++ body ++ "\n</style>\n"
    } else if f.kind == "wasm" {
        "<script id=\"wasm-b64\" type=\"application/octet-stream\">"
            ++ base64_of(f.file) ++ "</script>\n"
    } else if f.kind == "script" && a.names != "" {
        script_open(a, f) ++ body ++ "\n</script>\n<script>\n"
            ++ named_bindings(a.names.split(" "), 0, []) ++ "</script>\n"
    } else if f.kind == "script" {
        script_open(a, f) ++ body ++ "\n</script>\n"
    } else {
        ""
    }
}

/// A block written in the program is a plain script; a file is whatever node would call it.
script_open(a: PageAsset, f: Found) -> str =>
    a.text == "" && es_module(f.file) ? "<script type=\"module\">\n"
        : "<script>\n"

/// Node's own rule for what a script is: the extension, and otherwise the `type` the nearest `package.json` declares.
es_module(path: str) -> bool {
    if path.ends_with(".mjs") {
        true
    } else if path.ends_with(".cjs") {
        false
    } else {
        module_package(dir_of(path))
    }
}

module_package(dir: str) -> bool {
    text = read_file("{dir}{PackageJson}")

    if text != "" {
        pkg_entry(text, "type") == "module"
    } else if dir == "" {
        false
    } else {
        module_package(parent_of(dir))
    }
}

/// Text inlined into a `<style>` or a `<script>`, with what would end that element early escaped.
close_safe(text: str) -> str {
    parts = text.split("</")

    rejoined(parts, 1, [parts.get(0)])
}

rejoined(parts: str[], i: int, acc: str[]) -> str {
    if i >= parts.length() {
        acc.join("")
    } else {
        lead = parts.get(i).slice(0, 6).lower()
        mark = lead.starts_with("style") || lead.starts_with("script")
            ? "<\\/" : "</"

        rejoined(parts, i + 1, acc ++ [mark, parts.get(i)])
    }
}

/// A manifest value escaped for HTML text or for an attribute value.
html_text(s: str) -> str =>
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        .replace("\"", "&quot;").replace("'", "&#39;")

/// `const x = <the first spelling the script exposes>;` for each name asked for.
named_bindings(names: str[], i: int, acc: str[]) -> str {
    if i >= names.length() {
        acc.join("")
    } else {
        bound = "const {names.get(i)} = "
            ++ first_there(spellings(names.get(i)), 0, []) ++ ";\n"

        named_bindings(names, i + 1, acc ++ [bound])
    }
}

first_there(ss: str[], i: int, acc: str[]) -> str {
    if i >= ss.length() {
        acc.join(" ?? ")
    } else {
        first_there(ss, i + 1, acc ++ ["globalThis[\"{ss.get(i)}\"]"])
    }
}

/// Maca is snake_case and JavaScript is camelCase, so a named import tries the name as written, then camelCase, then kebab-case.
spellings(name: str) -> str[] {
    camel = camel_of(name.chars(), 0, [], false)
    kebab = name.replace("_", "-")
    held = camel == name ? [name] : [name, camel]

    kebab == name ? held : held ++ [kebab]
}

camel_of(cs: str[], i: int, acc: str[], up: bool) -> str {
    if i >= cs.length() {
        acc.join("")
    } else if cs.get(i) == "_" {
        camel_of(cs, i + 1, acc, true)
    } else if up {
        camel_of(cs, i + 1, acc ++ [cs.get(i).upper()], false)
    } else {
        camel_of(cs, i + 1, acc ++ [cs.get(i)], false)
    }
}

/// A Maca string stops at a NUL, so a wasm module's bytes are encoded before read.
base64_of(file: str) -> str =>
    capture("sh", ["-c", "base64 \"$0\" | tr -d '\\n'", file]).trim()

/// The wasm target is the C back end linked by `zig cc` against wasi-libc.
build_wasm(src: str, out: str) -> int {
    wasm = out.ends_with(".wasm") ? out : out ++ ".wasm"
    cfile = wasm ++ ".c"
    errs = compile_file([src, cfile])

    if errs > 0 {
        errs
    } else if read_file(cfile).index_of("\n#include <setjmp.h>\n") >= 0 {
        err("maca: the wasm target cannot carry `try` yet, because "
            ++ "wasi-libc has no setjmp; {cfile} is written")

        1
    } else {
        built = exec("zig", ["cc", "-target", "wasm32-wasi", "-Os",
                             cfile, "-o", wasm])

        if built != 0 {
            err("maca: zig did not link the wasm; {cfile} is written")

            built
        } else {
            info("built {wasm}")

            0
        }
    }
}

/// Firmware is three files: the freestanding C, the memory map it is placed by, and the image clang links from the two.
build_firmware(src: str, dir: str, mcu: str) -> int {
    m = emb_mcu(mcu)

    if m.name == "" {
        err("maca: no --mcu `{mcu}`. Try cortex-m0, cortex-m3, cortex-m4 "
            ++ "or riscv32.")

        2
    } else {
        make_dir(dir)

        errs = compile_file([src, "{dir}/firmware.c", "embedded"])

        if errs > 0 {
            errs
        } else {
            write_file("{dir}/link.ld", emb_linker_script(m))

            cross_compile(m, dir)
        }
    }
}

cross_compile(m: Mcu, dir: str) -> int {
    built = exec("clang", ["--target={m.triple}", "-mcpu={m.cpu}",
                           "-ffreestanding", "-nostdlib", "-Os",
                           "-ffunction-sections", "-fdata-sections",
                           "-fuse-ld=lld", "-Wl,-T,{dir}/link.ld",
                           "-Wl,--gc-sections", "-o", "{dir}/firmware.elf",
                           "{dir}/firmware.c"])

    if built != 0 {
        err("maca: clang did not link the firmware; {dir}/firmware.c and "
            ++ "{dir}/link.ld are written")

        built
    } else {
        exec("llvm-objcopy", ["-O", "binary", "{dir}/firmware.elf",
                              "{dir}/firmware.bin"])

        info("built firmware for {m.name} → {dir}/firmware.elf")

        0
    }
}

/// The tauri target is the built page beside the Rust shell that hosts it in a desktop window.
build_tauri(src: str, dir: str) -> int {
    built = build_page(src, "{dir}/dist")

    built > 0 ? built : tauri_shell(src, dir)
}

/// The shell is a webview and a bridge, so the whole app is the Maca page it loads and the Maca binary it invokes.
tauri_shell(src: str, dir: str) -> int {
    st = "{dir}/src-tauri"
    index = "{dir}/dist/index.html"
    name = crate_ident(stem_of(src))

    write_file("{dir}/dist/bridge.js", tauri_bridge())
    write_file(index,
               read_file(index)
                   .replace("</body>",
                            "<script src=\"bridge.js\"></script>\n</body>"))
    make_dir("{st}/src")
    write_file("{st}/Cargo.toml", tauri_cargo(name))
    write_file("{st}/build.rs", "fn main() {{\n    tauri_build::build()\n}}\n")
    write_file("{st}/tauri.conf.json",
               tauri_conf(name, page_setting(chain_of(src), "title",
                                             stem_of(src))))
    write_file("{st}/src/main.rs", tauri_main_rs())

    built = tauri_backend(src, st)

    built > 0 ? built : tauri_scaffolded(src, dir, st)
}

/// The `backend.maca` beside the page is the native command the bridge invokes, so a desktop app's back end is Maca too.
tauri_backend(src: str, st: str) -> int {
    backend = dir_of(src) ++ "backend.maca"

    if file_exists(backend) {
        make_dir("{st}/bin")

        build_binary(backend, "{st}/bin/backend")
    } else {
        0
    }
}

/// This compiler writes the scaffold and stops there, because turning it into a desktop app is `cargo tauri build`, which needs the Tauri CLI and a system webview.
tauri_scaffolded(src: str, dir: str, st: str) -> int {
    note = file_exists(dir_of(src) ++ "backend.maca") ? ""
        : " (no backend.maca beside it, so `maca_run` has nothing to run)"

    info("scaffolded {dir}{note}\n  cd {st} && cargo tauri build   "
         ++ "# needs the Tauri CLI and a system webview")

    0
}

tauri_bridge() -> str =>
    "globalThis.macaInvoke = async (arg) => {{\n"
        ++ "  const t = globalThis.__TAURI__;\n"
        ++ "  if (t && t.core && t.core.invoke) {{\n"
        ++ "    return t.core.invoke('maca_run', {{ arg: String(arg) }});\n"
        ++ "  }}\n"
        ++ "  if (t && t.invoke) {{\n"
        ++ "    return t.invoke('maca_run', {{ arg: String(arg) }});\n"
        ++ "  }}\n"
        ++ "  return '(no tauri runtime)';\n"
        ++ "}};\n"

tauri_cargo(name: str) -> str =>
    "[package]\nname = \"{name}\"\nversion = \"0.1.0\"\n"
        ++ "edition = \"2021\"\n\n[build-dependencies]\n"
        ++ "tauri-build = {{ version = \"2\", features = [] }}\n\n"
        ++ "[dependencies]\ntauri = {{ version = \"2\", features = [] }}\n\n"
        ++ "[[bin]]\nname = \"{name}\"\npath = \"src/main.rs\"\n"

tauri_conf(name: str, title: str) -> str =>
    "{{\n  \"productName\": \"{title}\",\n  \"version\": \"0.1.0\",\n"
        ++ "  \"identifier\": \"dev.maca.{name}\",\n"
        ++ "  \"build\": {{ \"frontendDist\": \"../dist\" }},\n"
        ++ "  \"app\": {{\n    \"windows\": [{{ \"title\": \"{title}\", "
        ++ "\"width\": 900, \"height\": 640, \"resizable\": true }}],\n"
        ++ "    \"security\": {{ \"csp\": null }}\n  }},\n"
        ++ "  \"bundle\": {{ \"active\": true, \"targets\": \"all\" }}\n}}\n"

tauri_main_rs() -> str =>
    "#![cfg_attr(not(debug_assertions), windows_subsystem = \"windows\")]\n"
        ++ "use std::process::Command;\n\n#[tauri::command]\n"
        ++ "fn maca_run(arg: String) -> String {{\n"
        ++ "    let exe = std::env::current_exe()\n"
        ++ "        .ok()\n"
        ++ "        .and_then(|p| p.parent()"
        ++ ".map(|d| d.join(\"bin\").join(\"backend\")))\n"
        ++ "        .unwrap_or_else(|| "
        ++ "std::path::PathBuf::from(\"backend\"));\n"
        ++ "    match Command::new(&exe).arg(&arg).output() {{\n"
        ++ "        Ok(o) => "
        ++ "String::from_utf8_lossy(&o.stdout).trim().to_string(),\n"
        ++ "        Err(e) => format!(\"error: {{e}}\"),\n"
        ++ "    }}\n}}\n\nfn main() {{\n"
        ++ "    tauri::Builder::default()\n"
        ++ "        .invoke_handler(tauri::generate_handler![maca_run])\n"
        ++ "        .run(tauri::generate_context!())\n"
        ++ "        .expect(\"error while running tauri application\");\n}}\n"

/// A crate name is the file stem with every character but a letter or a digit turned into `_`.
crate_ident(stem: str) -> str {
    id = ident_chars(stem.chars(), 0, [])

    if id == "" {
        "app"
    } else if id.at(0).is_ascii_digit() {
        "_" ++ id
    } else {
        id
    }
}

ident_chars(cs: str[], i: int, acc: str[]) -> str {
    if i >= cs.length() {
        acc.join("")
    } else if cs.get(i).is_alpha() || cs.get(i).is_ascii_digit() {
        ident_chars(cs, i + 1, acc ++ [cs.get(i).lower()])
    } else {
        ident_chars(cs, i + 1, acc ++ ["_"])
    }
}

/// A program built before and unchanged since is copied out of the cache instead of compiled again.
build_binary(src: str, out: str) -> int {
    key = cache_key(src)
    hit = key == "" ? "" : "{cache_dir()}/{key}"

    if hit != "" && file_exists(hit) && cache_take(hit, out) {
        0
    } else {
        built = build_fresh(src, out)

        if built == 0 && key != "" {
            cache_store(key, out)
        }

        built
    }
}

cache_home() -> str {
    given = env("MACA_CACHE")
    xdg = env("XDG_CACHE_HOME")
    home = env("HOME")

    if given != "" {
        given
    } else if xdg != "" {
        "{xdg}/maca"
    } else if home != "" {
        "{home}/.cache/maca"
    } else {
        "/tmp/maca"
    }
}

/// The cache is `$MACA_CACHE`, else the XDG cache directory, else `~/.cache/maca`.
cache_dir() -> str {
    given = env("MACA_CACHE")
    xdg = env("XDG_CACHE_HOME")
    home = env("HOME")

    if given != "" {
        "{given}/build/bin"
    } else if xdg != "" {
        "{xdg}/maca/build/bin"
    } else if home != "" {
        "{home}/.cache/maca/build/bin"
    } else {
        "/tmp/maca/build/bin"
    }
}

/// A digest of every file the program is made of, of the compiler about to build it and of the flags it will be linked with.
cache_key(src: str) -> str {
    off = env("MACA_NO_CACHE")

    if off == "1" || off == "true" {
        ""
    } else {
        unit = unit_of(src)

        capture("sh", ["-c", cache_probe(), "maca",
                       "native " ++ cc_flags().join(" ")]
                    ++ unit.seen ++ embedded_files(src, unit.toks)).trim()
    }
}

/// Every file `data(...)` reads while the program is built, and the `.local` name that would shadow it.
embedded_files(src: str, ts: Token[]) -> str[] {
    names: str[] = []
    texts: str[] = []
    out: str[] = []
    i = 0

    while i + 2 < ts.length() {
        if ts.get(i).kind == TIdent && ts.get(i + 1).kind == Eq
                && ts.get(i + 2).kind == TStr {
            names = names.push(ts.get(i).text)
            texts = texts.push(ts.get(i + 2).text)
        }

        i = i + 1
    }

    at = Assets { base = embed_dir(src), names, texts }
    i = 0

    while i + 2 < ts.length() {
        spec = data_spec(ts, i, at)

        if spec != "" {
            out = out.push(at.base ++ spec)
            out = out.push(at.base ++ local_spec(spec))
        }

        i = i + 1
    }

    out
}

data_spec(ts: Token[], i: int, at: Assets) -> str {
    if ts.get(i).kind == TIdent && ts.get(i).text == "data"
            && ts.get(i + 1).kind == LParen {
        spec_token(ts.get(i + 2), at)
    } else {
        ""
    }
}

/// The path a `data(...)` argument names, written out or bound to a constant beside it.
spec_token(t: Token, at: Assets) -> str {
    if t.kind == TStr {
        t.text
    } else if t.kind == TIdent && at.names.index_of(t.text) >= 0 {
        at.texts.get(at.names.index_of(t.text))
    } else {
        ""
    }
}

/// No digest without sha512sum and without the compiler's own timestamp, because a key that answers for neither would serve a stale binary.
cache_probe() -> str =>
    "command -v sha512sum >/dev/null || exit 0; "
        ++ "exe=$(stat -Lc %Y /proc/$PPID/exe 2>/dev/null); "
        ++ "[ -n \"$exe\" ] || exit 0; ( printf %s \"$exe $1\"; shift; "
        ++ "sha512sum \"$@\" 2>/dev/null | cut -d\" \" -f1 ) "
        ++ "| sha512sum | cut -d\" \" -f1"

/// A cached binary is copied out with the executable bit a fresh build would have left on it.
cache_take(from: str, out: str) -> bool =>
    copy_bytes(from, out) && exec("chmod", ["755", out]) == 0

/// A copy and then a rename, so a build interrupted half way cannot leave a truncated binary under a good key.
cache_store(key: str, out: str) -> bool {
    dir = cache_dir()
    tmp = "{dir}/{key}.{str(now_ms())}.tmp"

    make_dir(dir)

    copy_bytes(out, tmp) && exec("mv", [tmp, "{dir}/{key}"]) == 0
}

/// Which foreign header the emitted C reaches for is which library the link is told about.
link_flags(code: str) -> str[] {
    sq = code.index_of("#include <sqlite3.h>") >= 0
    py = code.index_of("#include <Python.h>") >= 0

    if sq && py {
        cc_flags() ++ sqlite_flags() ++ python_flags()
    } else if sq {
        cc_flags() ++ sqlite_flags()
    } else if py {
        cc_flags() ++ python_flags()
    } else {
        cc_flags()
    }
}

/// `pkg-config` describes a library where there is one, and `nix` on a machine that keeps its libraries out of the compiler's path.
sqlite_flags() -> str[] {
    pkg = capture("pkg-config", ["--cflags", "--libs", "sqlite3"]).trim()
    dev = pkg != "" ? "" : nix_path("nixpkgs#sqlite.dev")
    lib = dev == "" ? "" : nix_path("nixpkgs#sqlite.out")

    if pkg != "" {
        nonempty(pkg.split(" "), 0, []) ++ ["-lpthread"]
    } else if lib != "" {
        ["-I{dev}/include", "-L{lib}/lib", "-lsqlite3",
         "-Wl,-rpath,{lib}/lib", "-lpthread"]
    } else {
        ["-lsqlite3", "-lpthread"]
    }
}

nix_path(attr: str) -> str =>
    capture("nix", ["build", "--no-link", "--print-out-paths", attr]).trim()

/// `python3-config` is what a Python installation says about its own headers and library.
python_flags() -> str[] {
    inc = capture("python3-config", ["--includes"]).trim()
    embed = capture("python3-config", ["--ldflags", "--embed"]).trim()
    ld = embed != "" ? embed : capture("python3-config", ["--ldflags"]).trim()

    nonempty(inc.split(" ") ++ ld.split(" "), 0, [])
}

build_fresh(src: str, out: str) -> int {
    cfile = out ++ ".c"
    errs = compile_file([src, cfile])

    if errs > 0 {
        errs
    } else {
        cc_run([cfile] ++ link_flags(read_file(cfile)) ++ ["-o", out])
    }
}

/// The C compiler is `$MACA_CC`, else `cc`, which is what lets one machine build for another.
cc_run(args: str[]) -> int {
    named = env("MACA_CC")
    argv = named == "" ? ["cc"] : nonempty(named.split(" "), 0, [])

    exec(argv.get(0), argv.slice(1, argv.length()) ++ args)
}

/// `[build] cflags` in the manifest here, the flags a program needs to link.
cc_flags() -> str[] =>
    nonempty(chain_value(here_chain(), 0, "[build]", "cflags").split(" "),
             0, [])

build_cmd(args: str[]) -> int {
    named = build_src(args, 1, "")
    src = named != "" ? named : declared_bin("build", flag_after(args, "--bin"))
    chain: str[] = src == "" ? [] : chain_of(src)
    stray = stray_build_key(chain, 0)

    if src == "" {
        2
    } else if stray != "" {
        err("maca.toml [build]: unknown key `{stray}` (known: "
            ++ build_keys().join(", ") ++ ")")

        2
    } else if named != "" && !workspace_ok(chain) {
        1
    } else {
        out = build_setting(args, chain, "-o", "out")
        target = sniffed(src, build_setting(args, chain, "--target", "target"))

        build_out(src, out == "" ? default_out(src, target) : out, target,
                  build_setting(args, chain, "--mcu", "mcu"),
                  declared_cp(args, chain))
    }
}

/// `--cp` names the same jars as `--classpath`, and either beats what `[build]` declared.
declared_cp(args: str[], chain: str[]) -> str {
    short = flag_after(args, "--cp")

    short != "" ? short : build_setting(args, chain, "--classpath", "classpath")
}

/// A flag on the line wins, and `[build]` is what the project declares without one.
build_setting(args: str[], chain: str[], flag: str, key: str) -> str {
    given = flag_after(args, flag)

    if given != "" {
        given
    } else if key == "out" {
        declared_out(chain, 0)
    } else {
        chain_value(chain, 0, "[build]", key)
    }
}

/// `out` names a path the manifest that declared it is the root of, not the directory the command was typed in.
declared_out(chain: str[], i: int) -> str {
    if i >= chain.length() {
        ""
    } else {
        got = toml_value(read_file(chain.get(i) ++ Manifest), "[build]", "out")

        got != "" ? chain.get(i) ++ got : declared_out(chain, i + 1)
    }
}

build_keys() -> str[] =>
    ["target", "out", "mcu", "classpath", "cflags", "bin"]

/// A misspelled `[build]` key is silently nothing, so it is named instead.
stray_build_key(chain: str[], i: int) -> str {
    if i >= chain.length() {
        ""
    } else {
        here = stray_of(table_keys(read_file(chain.get(i) ++ Manifest),
                                   "[build]"), build_keys(), 0)

        here != "" ? here : stray_build_key(chain, i + 1)
    }
}

stray_of(keys: str[], known: str[], i: int) -> str {
    if i >= keys.length() {
        ""
    } else if known.index_of(keys.get(i)) >= 0 {
        stray_of(keys, known, i + 1)
    } else {
        keys.get(i)
    }
}

/// Whatever is left once the flags and their values are taken out is the file to build.
build_src(args: str[], i: int, held: str) -> str {
    if i >= args.length() {
        held
    } else if takes_value(args.get(i)) {
        build_src(args, i + 2, held)
    } else {
        build_src(args, i + 1, args.get(i))
    }
}

takes_value(a: str) -> bool =>
    a == "-o" || a == "--target" || a == "--bin"
        || a == "--mcu" || a == "--cp" || a == "--classpath"

/// A target nobody named is read off the source, and the note says how to override that.
sniffed(src: str, asked: str) -> str {
    found = asked != "" ? "" : detected_target(src)

    if found != "" {
        err("note: {why_target(found)}; building --target {found} "
            ++ "(pass --target to override)")
    }

    found != "" ? found : asked
}

/// A source that imports nixpkgs is config, and one whose view answers an Element is a page.
detected_target(src: str) -> str {
    ts = lex(read_file(src))

    if imports_nixpkgs(imports_in(ts, 0, []), 0) {
        "nix"
    } else if answers_element(ts, 0) {
        "js"
    } else {
        ""
    }
}

why_target(found: str) -> str =>
    found == "nix" ? "source imports nixpkgs (config mode)"
                   : "a view returns Element (reactive-UI mode)"

imports_nixpkgs(paths: str[], i: int) -> bool {
    if i >= paths.length() {
        false
    } else if paths.get(i) == "nixpkgs" || paths.get(i).ends_with("/nixpkgs") {
        true
    } else {
        imports_nixpkgs(paths, i + 1)
    }
}

answers_element(ts: Token[], i: int) -> bool {
    at = i

    while ts.get(at).kind != Eof {
        if ts.get(at).kind == Arrow && ts.get(at + 1).text == "Element" {
            return true
        }

        at = at + 1
    }

    false
}

run_cmd(args: str[]) -> int {
    named = first_named(args)

    if named != "" && !workspace_ok(chain_of(named)) {
        1
    } else if named != "" {
        run_file(named, args.slice(2, args.length()))
    } else {
        src = declared_bin("run", flag_after(args, "--bin"))

        src == "" ? 2 : run_file(src, [])
    }
}

test_cmd(args: str[]) -> int {
    named = first_named(args)

    named != "" ? test_file(named) : test_package(here_chain())
}

/// `maca test` with no file is every suite the package's test directory holds.
test_package(chain: str[]) -> int {
    if chain.length() == 0 {
        err("test: no maca.toml here, so there is no package to test; "
            ++ "name a .maca file")

        2
    } else {
        dir = chain.get(0) ++ tests_dir(chain)
        suites = suite_files(dir, list_dir(dir), 0, [])

        if suites.length() == 0 {
            no_suites(dir)
        } else {
            info(package_heading(chain) ++ ": {suites.length()} suites")

            ran_suites(suites, 0, 0)
        }
    }
}

/// The package a bare `maca test` is testing, and the version it carries.
package_heading(chain: str[]) -> str {
    got = chain_value(chain, 0, "[package]", "version")

    got == "" ? package_of(chain) : package_of(chain) ++ " " ++ got
}

/// `[package] tests` renames the directory the suites live in.
tests_dir(chain: str[]) -> str {
    named = chain_value(chain, 0, "[package]", "tests")

    named == "" ? "tests" : named
}

suite_files(dir: str, names: str[], i: int, acc: str[]) -> str[] {
    if i >= names.length() {
        acc
    } else if names.get(i).ends_with(".maca") {
        suite_files(dir, names, i + 1, acc ++ [dir ++ "/" ++ names.get(i)])
    } else {
        suite_files(dir, names, i + 1, acc)
    }
}

no_suites(dir: str) -> int {
    err("test: {dir} holds no .maca suite; name a file, or set "
        ++ "[package] tests")

    2
}

ran_suites(suites: str[], i: int, failed: int) -> int {
    n = suites.length()

    if i >= n {
        ok = n - failed
        info("{ok} of {n} suites passed")

        failed
    } else {
        one = suites.get(i)
        info("== {one}")

        ran_suites(suites, i + 1, failed + (test_file(one) == 0 ? 0 : 1))
    }
}

/// A file nobody named a target for is checked as what building it would pick.
checked_target(src: str, asked: str) -> str {
    found = asked != "" || src == "" ? "" : detected_target(src)

    if asked != "" {
        asked
    } else if found != "" {
        found
    } else {
        "native"
    }
}

check_cmd(args: str[]) -> int {
    src = entry_of("check", args)
    asked = flag_after(args, "--target")
    held = checked_target(src, asked)

    if src == "" {
        2
    } else if !is_known_target(held) {
        err("maca check: no target `{held}`; built targets are"
                ++ " native, c, js, jvm, rust, tauri, embedded, nix, or"
                ++ " `all` for what every program target shares")
        2
    } else if args.index_of("--json") >= 0 {
        check_json(src, held)
    } else {
        check_only(src, held)
    }
}

/// `maca check <file> --json`: the diagnostics, shaped as check-json.schema.json promises.
check_json(path: str, target: str) -> int {
    unit = unit_of(path)
    scanned = end_run(lexed(unit.toks, unit.errs), 0, 0)
    parsed = parse_module(scanned.tokens, 0, [])
    raw = desugared(parsed, path)
    broke = unit.unknown ++ scanned.errors ++ parsed.errors
    said = broke.length() > 0
        ? unparsed(broke, 0, [])
        : unread(raw.errors, 0, []) ++ check_diagnostics_on(raw, target)
    body = diag_list(path, read_file(path), said, 0, [])

    info("\{\"format\":1,\"diagnostics\":[" ++ body.join(",") ++ "]\}")

    said.length() == 0 ? 0 : 1
}

/// A file the program embeds that the build could not read is its own defect.
unread(xs: str[], i: int, acc: Diagnostic[]) -> Diagnostic[] {
    if i >= xs.length() {
        acc
    } else {
        said = Diagnostic { code = "M0008", message = xs.get(i), pos = 0,
                            note = "the file is read from beside the program"
                                ++ " while it is being built" }

        unread(xs, i + 1, acc.push(said))
    }
}

/// Nothing after a scan or parse failure was checked, and the note says so.
unparsed(xs: str[], i: int, acc: Diagnostic[]) -> Diagnostic[] {
    if i >= xs.length() {
        acc
    } else {
        said = Diagnostic { code = "M0001", message = xs.get(i), pos = 0,
                            note = "the file did not parse, so nothing"
                                ++ " after this was checked" }

        unparsed(xs, i + 1, acc.push(said))
    }
}

diag_list(path: str, text: str, ds: Diagnostic[], i: int,
          acc: str[]) -> str[] {
    if i >= ds.length() {
        acc
    } else {
        one = diag_json(path, text, ds.get(i))

        diag_list(path, text, ds, i + 1, acc.push(one))
    }
}

diag_json(path: str, text: str, d: Diagnostic) -> str {
    name = quoted_name(d.message)
    at = anchor_at(text, name, d.pos)
    lo = at < 0 ? at_or_zero(text, d.pos) : at
    hi = at < 0 ? lo : lo + name.length()

    "\{\"code\":" ++ json_text(d.code)
        ++ ",\"severity\":\"error\",\"message\":" ++ json_text(d.message)
        ++ ",\"explain\":" ++ json_text(diag_explain(d.code))
        ++ ",\"note\":" ++ note_json(d.note)
        ++ ",\"file\":" ++ json_text(path)
        ++ ",\"span\":" ++ spot_json(text, lo, hi)
        ++ ",\"suggestions\":" ++ fix_suggestions(text, d, lo, hi)
        ++ "\}"
}

note_json(note: str) -> str =>
    note == "" ? "null" : json_text(note)

/// The one edit `maca fix` makes unread, so a reader of the JSON sees it too.
fix_suggestions(text: str, d: Diagnostic, lo: int, hi: int) -> str {
    name = quoted_name(d.message)

    if !d.message.starts_with("no expression starts at ")
           || !phantom_spelling(name) {
        "[]"
    } else {
        "[\{\"message\":" ++ json_text("delete `" ++ name ++ "`")
            ++ ",\"span\":" ++ spot_json(text, lo, hi)
            ++ ",\"replacement\":\"\",\"applicability\":"
            ++ "\"machine-applicable\"\}]"
    }
}

spot_json(text: str, lo: int, hi: int) -> str =>
    "\{\"start\":" ++ str(lo) ++ ",\"end\":" ++ str(hi)
        ++ ",\"start_line\":" ++ str(line_at(text, lo))
        ++ ",\"start_column\":" ++ str(col_at(text, lo))
        ++ ",\"end_line\":" ++ str(line_at(text, hi))
        ++ ",\"end_column\":" ++ str(col_at(text, hi)) ++ "\}"

json_text(s: str) -> str =>
    "\"" ++ s.replace("\\", "\\\\")
             .replace("\"", "\\\"")
             .replace("\n", "\\n")
             .replace("\r", "\\r")
             .replace("\t", "\\t") ++ "\""

line_at(text: str, at: int) -> int =>
    text.slice(0, at).split("\n").length()

col_at(text: str, at: int) -> int {
    before = text.slice(0, at).split("\n")

    before.get(before.length() - 1).length() + 1
}

/// The name a message is about, which is the first thing it puts in backticks.
quoted_name(msg: str) -> str {
    open = msg.index_of("`")
    rest = open < 0 ? "" : msg.slice(open + 1, msg.length())
    shut = rest.index_of("`")

    shut < 0 ? "" : rest.slice(0, shut)
}

/// The name's first whole word at or after the statement it came from, or -1 when this file has none.
anchor_at(text: str, name: str, from: int) -> int {
    ahead = name == "" ? -1 : word_from(text, name, at_or_zero(text, from))

    if ahead >= 0 {
        ahead
    } else if name == "" {
        -1
    } else {
        word_from(text, name, 0)
    }
}

at_or_zero(text: str, at: int) -> int =>
    at > 0 && at < text.length() ? at : 0

word_from(text: str, name: str, from: int) -> int {
    n = name.length()
    last = text.length() - n
    i = from < 0 ? 0 : from
    found = -1

    while i <= last {
        if word_here(text, name, i, n) {
            found = i
            break
        }
        i = i + 1
    }

    found
}

word_here(text: str, name: str, at: int, n: int) -> bool {
    if text.at(at) != name.at(0) {
        false
    } else if word_char(text.at(at - 1)) || word_char(text.at(at + n)) {
        false
    } else {
        text.slice(at, at + n) == name
    }
}

word_char(c: str) -> bool =>
    c != "" && (c.is_alpha() || c.is_ascii_digit() || c == "_")

entry_of(cmd: str, args: str[]) -> str {
    named = first_named(args)

    named != "" ? named : declared_bin(cmd, flag_after(args, "--bin"))
}

first_named(args: str[]) -> str {
    if args.length() < 2 || args.get(1).starts_with("--") {
        ""
    } else {
        args.get(1)
    }
}

stem_of(src: str) -> str {
    leaf = src.slice(sep_after(src.chars(), src.length() - 1), src.length())

    leaf.ends_with(".maca") ? leaf.slice(0, leaf.length() - 5) : leaf
}

Manifest = "maca.toml"

/// Every directory at or above `from` holding a manifest, nearest first, ending at the workspace root.
manifest_chain(from: str) -> str[] {
    dirs = manifest_dirs(rooted(from), [])

    upto(dirs, workspace_at(dirs, dirs.length() - 1), 0, [])
}

/// A relative directory has no ancestors, so the walk starts from the real one.
rooted(from: str) -> str {
    at = real_path(from == "" ? "." : from)

    at == "" ? "" : at ++ "/"
}

manifest_dirs(dir: str, acc: str[]) -> str[] {
    if dir == "" {
        acc
    } else if file_exists(dir ++ Manifest) {
        manifest_dirs(parent_of(dir), acc ++ [dir])
    } else {
        manifest_dirs(parent_of(dir), acc)
    }
}

/// The chain ends at the outermost `[workspace]`, and at the nearest manifest when no workspace holds it.
workspace_at(dirs: str[], i: int) -> int {
    if i < 0 {
        dirs.length() == 0 ? -1 : 0
    } else if declares_workspace(read_file(dirs.get(i) ++ Manifest)) {
        i
    } else {
        workspace_at(dirs, i - 1)
    }
}

declares_workspace(toml: str) -> bool =>
    heads(toml.split("\n"), 0, "[workspace]")

heads(lines: str[], i: int, want: str) -> bool {
    if i >= lines.length() {
        false
    } else if lines.get(i).trim() == want {
        true
    } else {
        heads(lines, i + 1, want)
    }
}

upto(dirs: str[], stop: int, i: int, acc: str[]) -> str[] {
    if stop < 0 || i > stop {
        acc
    } else {
        upto(dirs, stop, i + 1, acc ++ [dirs.get(i)])
    }
}

here_chain() -> str[] =>
    manifest_chain(".")

chain_of(src: str) -> str[] =>
    manifest_chain(dir_of(src))

/// One key, off the nearest manifest on the chain that states it.
chain_value(chain: str[], i: int, table: str, key: str) -> str {
    if i >= chain.length() {
        ""
    } else {
        got = toml_value(read_file(chain.get(i) ++ Manifest), table, key)

        got != "" ? got : chain_value(chain, i + 1, table, key)
    }
}

/// A workspace whose list and whose tree disagree is a wrong answer waiting to happen, so it is refused first.
workspace_ok(chain: str[]) -> bool {
    why = workspace_problem(chain)

    if why == "" {
        true
    } else {
        err("maca: {why}")

        false
    }
}

workspace_problem(chain: str[]) -> str =>
    each_workspace(chain, 0)

/// Every workspace on the chain answers for its own members, so one may hold another.
each_workspace(chain: str[], i: int) -> str {
    if i >= chain.length() {
        ""
    } else if !declares_workspace(read_file(chain.get(i) ++ Manifest)) {
        each_workspace(chain, i + 1)
    } else {
        at = chain.get(i)
        found = members_problem(at, members_of(read_file(at ++ Manifest)))

        found != "" ? found : each_workspace(chain, i + 1)
    }
}

members_problem(root: str, ms: str[]) -> str {
    listed = member_refusal(root, ms, 0)

    listed != "" ? listed : stray_in(root, ms, parents_of(ms, 0, []), 0)
}

/// A member says what it is, in a manifest of its own.
member_refusal(root: str, ms: str[], i: int) -> str {
    if i >= ms.length() {
        ""
    } else if read_file("{root}{ms.get(i)}/{Manifest}") == "" {
        "{root}{Manifest}: [workspace] member `{ms.get(i)}` has no {Manifest}"
    } else if named_package("{root}{ms.get(i)}/{Manifest}") {
        member_refusal(root, ms, i + 1)
    } else {
        "{root}{ms.get(i)}/{Manifest}: a workspace member states its own "
            ++ "[package] name"
    }
}

named_package(file: str) -> bool =>
    toml_value(read_file(file), "[package]", "name") != ""

/// The directories the member list reaches into, which is where a package it forgot would sit.
parents_of(ms: str[], i: int, acc: str[]) -> str[] {
    if i >= ms.length() {
        acc
    } else {
        up = dir_of(ms.get(i))

        parents_of(ms, i + 1, acc.index_of(up) >= 0 ? acc : acc ++ [up])
    }
}

stray_in(root: str, ms: str[], parents: str[], i: int) -> str {
    if i >= parents.length() {
        ""
    } else {
        found = stray_at(root, ms, parents.get(i),
                         list_dir(root ++ parents.get(i)), 0)

        found != "" ? found : stray_in(root, ms, parents, i + 1)
    }
}

stray_at(root: str, ms: str[], parent: str, names: str[], i: int) -> str {
    if i >= names.length() {
        ""
    } else if file_exists("{root}{parent}{names.get(i)}/{Manifest}")
            && ms.index_of(parent ++ names.get(i)) < 0 {
        "{root}{Manifest}: `{parent}{names.get(i)}` holds a {Manifest} but is "
            ++ "not a [workspace] member; list it or delete it"
    } else {
        stray_at(root, ms, parent, names, i + 1)
    }
}

/// `members = ["a", "b"]`, however many lines the list is written across.
members_of(toml: str) -> str[] {
    lines = toml.split("\n")
    at = key_line(lines, 0, "", "[workspace]", "members")

    at < 0 ? [] : cleaned(bracketed(list_body(lines, at, "")).split(","),
                          0, [])
}

key_line(lines: str[], i: int, at: str, table: str, key: str) -> int {
    if i >= lines.length() {
        -1
    } else if toml_head(lines.get(i)) != "" {
        key_line(lines, i + 1, toml_head(lines.get(i)), table, key)
    } else if at == table && toml_key(lines.get(i)) == key {
        i
    } else {
        key_line(lines, i + 1, at, table, key)
    }
}

list_body(lines: str[], i: int, acc: str) -> str {
    if i >= lines.length() || acc.index_of("]") >= 0 {
        acc
    } else {
        list_body(lines, i + 1, acc ++ lines.get(i).trim())
    }
}

bracketed(s: str) -> str {
    a = s.index_of("[")
    b = s.index_of("]")

    a < 0 || b <= a ? "" : s.slice(a + 1, b)
}

cleaned(xs: str[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else {
        one = unquoted(xs.get(i).trim())

        cleaned(xs, i + 1, one == "" ? acc : acc ++ [one])
    }
}

Bin = {
    name: str
    path: str
}

/// The file a command works on when the command line named none: a `[[bin]]` of the package here.
declared_bin(cmd: str, want: str) -> str {
    chain = here_chain()

    if chain.length() == 0 {
        err("{cmd}: expected a .maca file, and there is no {Manifest} here to name one")

        ""
    } else if !workspace_ok(chain) {
        ""
    } else {
        chosen_bin(cmd, chain, want)
    }
}

chosen_bin(cmd: str, chain: str[], want: str) -> str {
    own = chain.get(0)
    pkg = package_of(chain)
    bins = bins_of(read_file(own ++ Manifest).split("\n"), 0, [])
    asked = want == "" ? chain_value(chain, 0, "[build]", "bin") : want
    at = bin_pick(bins, asked)
    n = bins.length()
    names = bin_names(bins, 0, "")

    if n == 0 {
        err("{cmd}: package `{pkg}` declares no [[bin]] in {Manifest}; name a .maca file")

        ""
    } else if at < 0 {
        err("{cmd}: package `{pkg}` declares {n} binaries; pass --bin <name>, "
            ++ "or declare [build] bin (one of {names})")

        ""
    } else {
        bin_file(cmd, own, bins.get(at))
    }
}

bin_file(cmd: str, dir: str, b: Bin) -> str {
    at = dir ++ b.path

    if file_exists(at) {
        at
    } else {
        err("{cmd}: [[bin]] `{b.name}` names {at}, which is not a file")

        ""
    }
}

bin_pick(bins: Bin[], want: str) -> int {
    if want != "" {
        bin_at(bins, want, 0)
    } else if bins.length() == 1 {
        0
    } else {
        -1
    }
}

bin_at(bins: Bin[], want: str, i: int) -> int {
    if i >= bins.length() {
        -1
    } else if bins.get(i).name == want {
        i
    } else {
        bin_at(bins, want, i + 1)
    }
}

bin_names(bins: Bin[], i: int, acc: str) -> str {
    if i >= bins.length() {
        acc
    } else if acc == "" {
        bin_names(bins, i + 1, bins.get(i).name)
    } else {
        bin_names(bins, i + 1, acc ++ ", " ++ bins.get(i).name)
    }
}

package_of(chain: str[]) -> str {
    got = chain_value(chain, 0, "[package]", "name")

    got == "" ? "this package" : got
}

bins_of(lines: str[], i: int, acc: Bin[]) -> Bin[] {
    if i >= lines.length() {
        acc
    } else if toml_head(lines.get(i)) == "[[bin]]" {
        bins_of(lines, i + 1, with_bin(acc, one_bin(lines, i + 1)))
    } else {
        bins_of(lines, i + 1, acc)
    }
}

/// A `[[bin]]` that names no path is not a binary anyone can build, so it is not one.
with_bin(acc: Bin[], b: Bin) -> Bin[] =>
    b.path == "" ? acc : acc ++ [b]

one_bin(lines: str[], i: int) -> Bin {
    path = block_value(lines, i, "path")
    name = block_value(lines, i, "name")

    Bin { name = name == "" ? path : name, path = path }
}

block_value(lines: str[], i: int, key: str) -> str {
    if i >= lines.length() || toml_head(lines.get(i)) != "" {
        ""
    } else if toml_key(lines.get(i)) == key {
        toml_val(lines.get(i))
    } else {
        block_value(lines, i + 1, key)
    }
}

table_keys(toml: str, table: str) -> str[] =>
    keys_in(toml.split("\n"), 0, "", table, [])

keys_in(lines: str[], i: int, at: str, table: str, acc: str[]) -> str[] {
    if i >= lines.length() {
        acc
    } else if toml_head(lines.get(i)) != "" {
        keys_in(lines, i + 1, toml_head(lines.get(i)), table, acc)
    } else if at == table && toml_key(lines.get(i)) != "" {
        keys_in(lines, i + 1, at, table, acc ++ [toml_key(lines.get(i))])
    } else {
        keys_in(lines, i + 1, at, table, acc)
    }
}

/// One `key = value` of one table, which is as much TOML as a manifest is asked for.
toml_value(toml: str, table: str, key: str) -> str =>
    table_value(toml.split("\n"), 0, "", table, key)

table_value(lines: str[], i: int, at: str, table: str, key: str) -> str {
    if i >= lines.length() {
        ""
    } else if toml_head(lines.get(i)) != "" {
        table_value(lines, i + 1, toml_head(lines.get(i)), table, key)
    } else if at == table && toml_key(lines.get(i)) == key {
        toml_val(lines.get(i))
    } else {
        table_value(lines, i + 1, at, table, key)
    }
}

toml_head(line: str) -> str {
    t = line.trim()

    t.starts_with("[") ? t : ""
}

toml_key(line: str) -> str {
    t = line.trim()

    if t.starts_with("#") || t.index_of("=") < 0 {
        ""
    } else {
        t.slice(0, t.index_of("=")).trim()
    }
}

toml_val(line: str) -> str {
    t = line.trim()

    unquoted(t.slice(t.index_of("=") + 1, t.length()).trim())
}

unquoted(v: str) -> str {
    if v.length() >= 2 && v.starts_with("\"") && v.ends_with("\"") {
        v.slice(1, v.length() - 1)
    } else {
        v
    }
}

nonempty(xs: str[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else if xs.get(i) == "" {
        nonempty(xs, i + 1, acc)
    } else {
        nonempty(xs, i + 1, acc ++ [xs.get(i)])
    }
}

shell_pid() -> str =>
    capture("sh", ["-c", "echo $$"]).trim()

scratch_path(kind: str) -> str {
    root = env("TMPDIR")
    dir = root == "" ? "/tmp" : root

    "{dir}/maca1-{kind}-{str(now_ms())}-{shell_pid()}"
}

run_file(src: str, rest: str[]) -> int {
    out = scratch_path("run")
    built = build_binary(src, out)

    if built != 0 {
        built
    } else {
        code = exec(out, rest)

        remove_file(out)
        remove_file("{out}.c")

        code
    }
}

test_file(src: str) -> int {
    unit = unit_of(src)
    scanned = end_run(lexed(unit.toks, unit.errs), 0, 0)
    raw = parse_module(scanned.tokens, 0, [])
    names = test_names(raw.items, 0, [])

    if names.length() == 0 {
        info("no test_ functions in {src}")

        0
    } else {
        run_tests(src, names)
    }
}

test_names(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if items.get(i).kind == SFn
            && items.get(i).name.starts_with("test_") {
        test_names(items, i + 1, acc ++ [items.get(i).name])
    } else {
        test_names(items, i + 1, acc)
    }
}

run_tests(src: str, names: str[]) -> int {
    driver = "{dir_of(src)}maca1-test-{str(now_ms())}.maca"

    write_file(driver,
               without_main(read_file(src)) ++ test_main(names, 0, ""))

    code = run_file(driver, [])

    remove_file(driver)

    code
}

/// A suite supplies its tests, and the runner supplies the entry point, so an own `main` is dropped.
without_main(src: str) -> str {
    items = parse_module(lex(src), 0, []).items
    at = main_item(items, 0)

    at < 0 ? src : cut_out(src, items.get(at).pos, item_start(items, at + 1))
}

main_item(items: Stmt[], i: int) -> int {
    if i >= items.length() {
        0 - 1
    } else if items.get(i).kind == SFn && items.get(i).name == "main" {
        i
    } else {
        main_item(items, i + 1)
    }
}

item_start(items: Stmt[], i: int) -> int =>
    i >= items.length() ? 0 - 1 : items.get(i).pos

cut_out(src: str, from: int, upto: int) -> str {
    cs = src.chars()
    tail: str[] = upto < 0 ? [] : cs.slice(upto, cs.length())

    cs.slice(0, from).join("") ++ tail.join("")
}

test_main(names: str[], i: int, acc: str) -> str {
    if i >= names.length() {
        "\nmain() -> int \{\n" ++ acc ++ "    failures()\n\}\n"
    } else {
        call = "    info(\"  " ++ names.get(i) ++ "\")\n    "
            ++ names.get(i) ++ "()\n"

        test_main(names, i + 1, acc ++ call)
    }
}

compile_file(args: str[]) -> int {
    unit = unit_of(args.get(0))
    scanned = end_run(lexed(unit.toks, unit.errs), 0, 0)
    parsed = parse_module(scanned.tokens, 0, [])
    raw = desugared(parsed, args.get(0))
    bad = report_all("import", unit.unknown, 0) +
        report_all("scan", scanned.errors, 0) +
        report_all("parse", parsed.errors, 0) +
        report_all("embed", raw.errors, 0)
    stubbed = raw with { items = raw.items ++ tag_stubs(unit.toks, 0, []) }
    asked = args.length() >= 3 ? args.get(2) : ""
    errs = bad +
        report_all("check", checked_with_foreign(stubbed, unit.toks), 0) +
        report_all("check", target_notes(stubbed, asked), 0)
    m = unstubbed(annotated_on(monomorphic(lifted_on(annotated_on(stubbed,
                                                                  asked),
                                                     asked)),
                               asked),
                  unit.toks)
    emitted = if asked == "rust" {
        rust_prelude(unit.toks, 0, "") ++ remit_module(rust_borrows(m))
    } else if asked == "" || asked == "native" || asked == "c" {
        emit_module(m) ++ c_prelude_blocks(read_file(args.get(0)), unit.toks,
                                           0, "")
    } else if asked == "js" {
        jemit_module(m)
    } else if asked == "nix" {
        nemit_module(m)
    } else if asked == "embedded" {
        eemit_module(m)
    } else if asked == "jvm" {
        jvmemit_module(m, args.length() >= 4 ? args.get(3) : "Main")
    } else {
        emit_module(m)
    }

    wrong = errs + refused_here(asked, m) +
        report_all("import", foreign_errors(asked, args.get(0), unit), 0)

    if wrong == 0 {
        write_file(args.get(1), emitted)
    }

    wrong
}

/// A target names what it cannot lower rather than emitting a file that pretends.
refused_here(asked: str, m: Module) -> int {
    if asked == "embedded" {
        report_all("embedded", eemit_errors(m), 0)
    } else if asked == "jvm" {
        report_all("jvm", jvmemit_errors(m), 0) +
            report_all("jvm", ported_errors(m.items, 0, "jvm", []), 0)
    } else if asked == "rust" {
        report_all("rust", ported_errors(m.items, 0, "rust", []), 0) +
            report_all("rust", kept_borrow_notes(m), 0)
    } else {
        0
    }
}

target_notes(m: Module, asked: str) -> str[] =>
    target_errors(m, asked == "" ? "native" : asked).map(diag_message)

/// The rust and jvm targets have no C ABI bridge and no function pointer, so each is named here.
ported_errors(items: Stmt[], i: int, target: str, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else {
        ported_errors(items, i + 1, target,
                      acc ++ ported_error(items.get(i), target))
    }
}

ported_error(s: Stmt, target: str) -> str[] {
    if s.kind == SFn && s.body.length() == 0 {
        ["`{s.name}` is declared with no body, which is an FFI declaration, "
             ++ "and --target {target} has no C ABI bridge to reach it; supply "
             ++ "a body, or write the function in a raw block"]
    } else if s.kind == SRecord {
        fn_fields(s.name, s.params, 0, target, [])
    } else {
        []
    }
}

fn_fields(rec: str, fs: Expr[], i: int, target: str, acc: str[]) -> str[] {
    if i >= fs.length() {
        acc
    } else if is_fn_type(fs.get(i).ty) {
        fn_fields(rec, fs, i + 1, target,
                  acc ++ ["`{rec}.{fs.get(i).text}` holds a function, which "
                              ++ "--target {target} cannot carry; the native "
                              ++ "and js targets can"])
    } else {
        fn_fields(rec, fs, i + 1, target, acc)
    }
}

/// A foreign import the target cannot honour is named rather than emitted.
foreign_errors(asked: str, src: str, u: Unit) -> str[] {
    js = browser_errors(asked, u)

    if asked != "rust" {
        js
    } else {
        js ++ rust_import_errors(u.toks, 0,
                                 manifest_keys(chain_of(src),
                                               "[rust-dependencies]", 0),
                                 [])
    }
}

/// A module implemented by a JavaScript block reaches a browser and nothing else, so every other target names it.
browser_errors(asked: str, u: Unit) -> str[] {
    if asked == "js" || !js_import_in(u.toks, 0) {
        []
    } else {
        [browser_error(asked, browser_file(u.seen, 0))]
    }
}

browser_error(asked: str, name: str) -> str =>
    "`{name}` runs in a browser: what implements it is a JavaScript block, "
        ++ "and the {target_named(asked)} target has no JavaScript to run it "
        ++ "in; build the page with `maca build --target js`"

target_named(asked: str) -> str =>
    asked == "" ? "native" : asked

js_import_in(ts: Token[], i: int) -> bool =>
    foreign_first(ts, i, "js") >= 0

/// Where the first `import <lang>` block is, or -1 when the file carries none.
foreign_first(ts: Token[], i: int, lang: str) -> int {
    at = i

    while at + 2 < ts.length() {
        if foreign_at(ts, at, lang) {
            return at
        }

        at = at + 1
    }

    0 - 1
}

/// The two tokens a foreign import is written in, as in `import "gpui::div"`.
foreign_at(ts: Token[], i: int, lang: str) -> bool =>
    ts.get(i).kind == KwImport && ts.get(i + 1).kind == TStr
        && foreign_lang(ts.get(i + 1).text) == lang

/// A body written where the name was quoted, as in `import "shim.c" """…"""`.
foreign_body_at(ts: Token[], i: int) -> bool =>
    i + 2 < ts.length() && ts.get(i + 2).kind == TStr
        && !ts.get(i + 2).fresh

/// How far past a foreign import the next one starts.
foreign_step(ts: Token[], i: int) -> int =>
    foreign_body_at(ts, i) ? 3 : 2

/// The language a foreign import names, which its own string says and no keyword repeats.
foreign_lang(spec: str) -> str {
    ext = spec.split("?").get(0).split("#").get(0)

    if ext.ends_with(".h") || ext.ends_with(".c") {
        "c"
    } else if ext.ends_with(".rs") {
        "rust"
    } else if ext.ends_with(".mjs") || ext.ends_with(".js") {
        "js"
    } else if ext.ends_with(".css") {
        "css"
    } else if ext.ends_with(".nix") {
        "nix"
    } else if ext.ends_with(".py") {
        "py"
    } else if ext.ends_with(".java") {
        "java"
    } else if ext.ends_with(".ex") || ext.ends_with(".exs") {
        "elixir"
    } else if spec.index_of("::") >= 0 || crate_named(spec) {
        "rust"
    } else if jvm_named(spec) {
        "java"
    } else {
        ""
    }
}

/// A dotted name ending in a capital is a JVM class, which no extension spells.
jvm_named(spec: str) -> bool {
    parts = spec.split(".")

    parts.length() > 1 && spec.index_of("/") < 0
        && leads_capital(parts.get(parts.length() - 1))
}

/// A crate is written as its bare name, and it is the only foreign import that is.
crate_named(spec: str) -> bool =>
    spec != "" && crate_chars(spec.chars(), 0)

crate_chars(cs: str[], i: int) -> bool {
    at = i

    while at < cs.length() {
        c = cs.get(at)

        if !c.is_ascii_digit() && !is_lower(c) && c != "_" && c != "-" {
            return false
        }

        at = at + 1
    }

    true
}

is_lower(c: str) -> bool =>
    ord(c) >= ord("a") && ord(c) <= ord("z")

leads_capital(w: str) -> bool =>
    w != "" && ord(w.at(0)) >= ord("A") && ord(w.at(0)) <= ord("Z")

browser_file(files: str[], i: int) -> str {
    if i >= files.length() {
        ""
    } else if js_import_in(lex_all(read_file(files.get(i))).tokens, 0) {
        module_named(files.get(i))
    } else {
        browser_file(files, i + 1)
    }
}

/// A module file as an import writes it: the path under the search root that answers for it.
module_named(path: str) -> str {
    stem = path.ends_with(".maca") ? path.slice(0, path.length() - 5) : path
    parts = stem.split("/")

    parts.slice(last_root(parts, 0, parts.length() - 1),
                parts.length()).join("/")
}

last_root(ps: str[], i: int, acc: int) -> int {
    if i >= ps.length() {
        acc
    } else if ps.get(i) == "modules" || ps.get(i) == "src"
            || ps.get(i) == DepsDir {
        last_root(ps, i + 1, i + 1)
    } else {
        last_root(ps, i + 1, acc)
    }
}

/// A foreign value a method takes belongs to its caller, so the call site lends it rather than handing it over.
rust_borrows(m: Module) -> Module {
    own = declared_types(m.items, 0, [])

    m with { items = borrow_stmts(m.items, borrow_marks(m.items, own, 0, []),
                                  0, []) }
}

borrow_marks(items: Stmt[], own: str[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if is_impl_block(items.get(i)) {
        borrow_marks(items, own, i + 1,
                     acc ++ method_marks(items.get(i).value.children, own, 0,
                                         []))
    } else {
        borrow_marks(items, own, i + 1, acc)
    }
}

method_marks(fs: Expr[], own: str[], i: int, acc: str[]) -> str[] {
    if i >= fs.length() {
        acc
    } else {
        method_marks(fs, own, i + 1, acc ++ param_marks(fs.get(i), own))
    }
}

param_marks(f: Expr, own: str[]) -> str[] {
    lam = f.children.get(1)
    ps = lam.children.slice(0, lam.children.length() - 1)

    mark_at(f.children.get(0).text, ps, own, 0, [])
}

mark_at(name: str, ps: Expr[], own: str[], i: int, acc: str[]) -> str[] {
    if i >= ps.length() {
        acc
    } else if foreign_type(ps.get(i).ty, own) {
        mark_at(name, ps, own, i + 1, acc ++ ["{name}#{str(i)}"])
    } else {
        mark_at(name, ps, own, i + 1, acc)
    }
}

borrow_stmts(xs: Stmt[], marks: str[], i: int, acc: Stmt[]) -> Stmt[] {
    if i >= xs.length() {
        acc
    } else {
        borrow_stmts(xs, marks, i + 1, acc ++ [borrow_stmt(xs.get(i), marks)])
    }
}

borrow_stmt(s: Stmt, marks: str[]) -> Stmt =>
    s with { value = borrow_expr(s.value, marks),
             body = borrow_stmts(s.body, marks, 0, []) }

borrow_expr(e: Expr, marks: str[]) -> Expr {
    kids = borrow_kids(e.children, marks, 0, [])

    e with { children = e.kind == EMethod
                            ? borrowed_args(e.text, kids, marks, 0, [])
                            : kids,
             stmts = borrow_stmts(e.stmts, marks, 0, []) }
}

borrow_kids(cs: Expr[], marks: str[], i: int, acc: Expr[]) -> Expr[] {
    if i >= cs.length() {
        acc
    } else {
        borrow_kids(cs, marks, i + 1, acc ++ [borrow_expr(cs.get(i), marks)])
    }
}

borrowed_args(name: str, cs: Expr[], marks: str[], i: int,
              acc: Expr[]) -> Expr[] {
    if i >= cs.length() {
        acc
    } else if marks.index_of("{name}#{str(i)}") >= 0 {
        borrowed_args(name, cs, marks, i + 1,
                      acc ++ [e_call("maca_borrow", [cs.get(i)])])
    } else {
        borrowed_args(name, cs, marks, i + 1, acc ++ [cs.get(i)])
    }
}

/// A tag a raw Rust block declares as a function is that function, so check sees the declaration and no back end does.
tag_stubs(ts: Token[], i: int, acc: Stmt[]) -> Stmt[] {
    out = acc
    at = i

    while at + 2 < ts.length() {
        if foreign_at(ts, at, "rust") && foreign_body_at(ts, at) {
            out = out ++ block_stubs(rust_source(ts.get(at + 2).text))
            at = at + 3
        } else {
            at = at + 1
        }
    }

    out
}

unstubbed(m: Module, ts: Token[]) -> Module =>
    m with { items = kept_items(m.items, tag_stubs(ts, 0, []), 0, []) }

kept_items(xs: Stmt[], stubs: Stmt[], i: int, acc: Stmt[]) -> Stmt[] {
    if i >= xs.length() {
        acc
    } else if xs.get(i).body.length() == 0
            && stub_named(stubs, xs.get(i).name, 0) {
        kept_items(xs, stubs, i + 1, acc)
    } else {
        kept_items(xs, stubs, i + 1, acc ++ [xs.get(i)])
    }
}

stub_named(stubs: Stmt[], name: str, i: int) -> bool {
    if i >= stubs.length() {
        false
    } else if stubs.get(i).name == name {
        true
    } else {
        stub_named(stubs, name, i + 1)
    }
}

block_stubs(text: str) -> Stmt[] =>
    stub_parts(text.split("fn "), 1, [])

stub_parts(ps: str[], i: int, acc: Stmt[]) -> Stmt[] {
    if i >= ps.length() {
        acc
    } else {
        stub_parts(ps, i + 1, acc ++ stub_of(ps.get(i)))
    }
}

stub_of(part: str) -> Stmt[] {
    open = part.index_of("(")
    name = open < 0 ? "" : part.slice(0, open).trim()
    said = open < 0 ? "" : stub_ret(part)

    if open < 0 || said == "" || !is_element_tag(name) {
        []
    } else {
        [s_fn(name, said,
              stub_params(stub_arity(part.chars(), open + 1, 1, 0), 0, []), [])]
    }
}

/// What a Rust signature answers, which is the only thing a caller of it can be told.
stub_ret(part: str) -> str {
    body = part.index_of("{{")
    head = body < 0 ? part : part.slice(0, body)
    arrow = head.index_of("->")

    arrow < 0 ? "" : head.slice(arrow + 2, head.length()).trim()
}

stub_params(n: int, i: int, acc: Expr[]) -> Expr[] {
    if i >= n {
        acc
    } else {
        stub_params(n, i + 1, acc ++ [e_param("a{str(i)}", "")])
    }
}

/// How many parameters a Rust signature declares, counting the commas no nesting hides.
stub_arity(cs: str[], i: int, depth: int, seen: int) -> int {
    if i >= cs.length() || (cs.get(i) == ")" && depth == 1) {
        seen
    } else if cs.get(i) == "(" || cs.get(i) == "[" {
        stub_arity(cs, i + 1, depth + 1, seen)
    } else if cs.get(i) == ")" || cs.get(i) == "]" {
        stub_arity(cs, i + 1, depth - 1, seen)
    } else if cs.get(i) == "," && depth == 1 {
        stub_arity(cs, i + 1, depth, seen + 1)
    } else if cs.get(i) == " " {
        stub_arity(cs, i + 1, depth, seen)
    } else {
        stub_arity(cs, i + 1, depth, seen == 0 ? 1 : seen)
    }
}

/// A name a raw Rust block declares is not a name this file forgot to write.
checked_with_foreign(m: Module, ts: Token[]) -> str[] {
    ds = check_diagnostics(m)

    rust_import_in(ts, 0) ? written_names(ds, 0, []) : ds.map(diag_message)
}

written_names(ds: Diagnostic[], i: int, acc: str[]) -> str[] {
    if i >= ds.length() {
        acc
    } else if ds.get(i).code == "M0006" {
        written_names(ds, i + 1, acc)
    } else {
        written_names(ds, i + 1, acc ++ [diag_message(ds.get(i))])
    }
}

rust_import_in(ts: Token[], i: int) -> bool =>
    foreign_first(ts, i, "rust") >= 0

/// Rust resolves no name by itself, so every Rust import is written into the emitted unit.
rust_prelude(ts: Token[], i: int, acc: str) -> str {
    if i + 1 >= ts.length() {
        acc == "" ? "" : acc ++ "\n"
    } else if foreign_at(ts, i, "rust") {
        said = foreign_body_at(ts, i) ? ts.get(i + 2).text : ts.get(i + 1).text

        rust_prelude(ts, i + foreign_step(ts, i), acc ++ rust_item(said))
    } else {
        rust_prelude(ts, i + 1, acc)
    }
}

/// `import "shim.c" """…"""` is C the emitted file carries as written, after everything Maca declared, which is how a foreign ABI is met.
c_prelude_blocks(src: str, ts: Token[], i: int, acc: str) -> str {
    out = acc
    at = i

    while at + 2 < ts.length() {
        if foreign_at(ts, at, "c") && raw_block_at(src, ts, at + 2) {
            out = out ++ rust_source(ts.get(at + 2).text) ++ "\n"
            at = at + 3
        } else {
            at = at + 1
        }
    }

    out == "" ? "" : out
}

/// A spec that is a path names a crate item to use, where a block is Rust as written.
rust_item(spec: str) -> str {
    text = rust_source(spec)

    path_like(text.chars(), 0) ? "use {text};\n" : text ++ "\n"
}

/// A raw block is held as a Maca literal, so what it stood for is written back.
rust_source(spec: str) -> str =>
    raw_text(spec).replace("{{{{", "{{").replace("}}}}", "}}").trim()

raw_text(s: str) -> str =>
    s.replace("\\n", "\n")
     .replace("\\r", "\r")
     .replace("\\t", "\t")
     .replace("\\\"", "\"")
     .replace("\\\\", "\\")

/// A crate the rust target calls must be one the manifest declared, and no other language reaches that target at all.
rust_import_errors(ts: Token[], i: int, deps: str[], acc: str[]) -> str[] {
    if i + 2 >= ts.length() {
        acc
    } else if ts.get(i).kind == KwImport && ts.get(i + 1).kind == TStr
            && foreign_lang(ts.get(i + 1).text) != "" {
        said = ts.get(i + 1).text

        rust_import_errors(ts, i + foreign_step(ts, i), deps,
                           acc ++ rust_import_error(foreign_lang(said), said,
                                                    deps))
    } else {
        rust_import_errors(ts, i + 1, deps, acc)
    }
}

rust_import_error(lang: str, spec: str, deps: str[]) -> str[] {
    krate = crate_of(spec)

    if lang != "rust" {
        ["`import \"{spec}\"` names {lang}, which --target rust cannot reach "
             ++ "(there is no C ABI bridge on the Rust path); name a Rust "
             ++ "path like \"krate::item\" and declare the crate under "
             ++ "[rust-dependencies] instead"]
    } else if krate == "" || rust_builtin(krate)
            || deps.index_of(krate) >= 0 {
        []
    } else {
        ["import \"{spec}\" refers to crate `{krate}`, which isn't "
             ++ "declared; add `{krate} = \"…\"` under [rust-dependencies] "
             ++ "in maca.toml"]
    }
}

rust_builtin(name: str) -> bool =>
    name == "std" || name == "core" || name == "alloc" || name == "crate"
        || name == "self" || name == "super"

/// A spec that is a path names a crate, where a block of Rust names none.
crate_of(spec: str) -> str {
    s = spec.trim()
    cut = s.index_of("::")
    head = cut < 0 ? s : s.slice(0, cut)

    path_like(s.chars(), 0) ? unprefixed(head) : ""
}

unprefixed(name: str) -> str =>
    name.starts_with("r#") ? name.slice(2, name.length()) : name

path_like(cs: str[], i: int) -> bool {
    if i >= cs.length() {
        cs.length() > 0
    } else if path_char(cs.get(i)) {
        path_like(cs, i + 1)
    } else {
        false
    }
}

path_char(c: str) -> bool =>
    c.is_alpha() || c.is_ascii_digit() || c == "_" || c == ":" || c == "#"

unit_of(entry: str) -> Unit =>
    load_unit(entry, Unit { seen = [], names = [], owners = [],
                            asks = asks_of(entry), toks = [], errs = [],
                            unknown = [] })

Asked = {
    walked: str[]
    pairs:  str[]
}

/// Every name some `import { … } from p` asks the file `p` for, gathered before a line of it is spliced.
asks_of(entry: str) -> str[] =>
    walk_asks(entry, Asked { walked = [], pairs = [] }).pairs

walk_asks(path: str, a: Asked) -> Asked {
    if a.walked.index_of(path) >= 0 {
        a
    } else {
        got = lex_all(read_file(path))

        asks_in(path, got.tokens, 0, a with { walked = a.walked ++ [path] })
    }
}

asks_in(by: str, ts: Token[], i: int, a: Asked) -> Asked {
    held = a
    at = i

    while ts.get(at).kind != Eof {
        if ts.get(at).kind == KwImport {
            held = asks_at(by, ts, at + 1, held)
            at = import_end(ts, at + 1)
        } else {
            at = at + 1
        }
    }

    held
}

asks_at(by: str, ts: Token[], i: int, a: Asked) -> Asked {
    paths = import_names(ts, i)
    at = paths.length() == 0 ? "" : resolved(by, paths.get(0))

    if at == "" {
        a
    } else if ts.get(i).kind == LBrace {
        walk_asks(at, a with { pairs = a.pairs ++ selected(ts, i + 1, at, []) })
    } else {
        walk_asks(at, a)
    }
}

selected(ts: Token[], i: int, at: str, acc: str[]) -> str[] {
    if ts.get(i).kind == RBrace || ts.get(i).kind == Eof {
        acc
    } else if ts.get(i).kind == TIdent {
        selected(ts, i + 1, at, acc ++ ["{at} {ts.get(i).text}"])
    } else {
        selected(ts, i + 1, at, acc)
    }
}

/// `import "f.nix"` binds what that file evaluates to, under the name it is called.
nix_valued(path: str, src: str) -> str =>
    src.index_of(".nix\"") < 0
        ? src
        : nix_bound(dir_of(path), lex_all(src).tokens, 0, "") ++ src

nix_bound(dir: str, ts: Token[], i: int, acc: str) -> str {
    if ts.get(i).kind == Eof {
        acc
    } else if foreign_at(ts, i, "nix") {
        nix_bound(dir, ts, i + 2, acc ++ nix_binding(dir, ts.get(i + 1).text))
    } else {
        nix_bound(dir, ts, i + 1, acc)
    }
}

nix_binding(dir: str, spec: str) -> str {
    got = capture("nix-instantiate", ["--eval", dir ++ spec]).trim()

    if got != "" {
        "{nix_name(spec)} = {got}\n"
    } else {
        err("maca: no Nix value in {spec}; is nix-instantiate"
            ++ " on PATH?")

        ""
    }
}

nix_name(spec: str) -> str {
    leaf = spec.slice(sep_after(spec.chars(), spec.length() - 1),
                      spec.length())

    leaf.ends_with(".nix") ? leaf.slice(0, leaf.length() - 4) : leaf
}

load_unit(path: str, u: Unit) -> Unit {
    if u.seen.index_of(path) >= 0 {
        u
    } else {
        got = lex_all(nix_valued(path, read_file(path)))
        marked = u with { seen = u.seen ++ [path] }
        deps = load_deps(path, imports_in(got.tokens, 0, []), 0, marked)

        spliced(deps, path, got.tokens, got.errors)
    }
}

/// A name two files define stays with the one an import asked for it by name, and the loser moves.
spliced(deps: Unit, path: str, whole: Token[], errs: str[]) -> Unit {
    mine = fn_names(parse_module(whole, 0, []).items, 0, [])
    clash = clashing(mine, deps.names, 0, [])
    held = holding(deps, path, clash, 0, [])
    taken = without_names(clash, held, 0, [])
    tag = str(deps.seen.index_of(path))
    toks = without_eof(whole)
    kept = taken.length() == 0 ? toks : renamed(toks, taken, tag, 0)
    base = held.length() == 0 ? deps.toks : renamed(deps.toks, held, tag, 0)

    deps with { toks = base ++ kept,
                names = deps.names ++ mine,
                owners = deps.owners ++ owned_by(mine, path, 0, []),
                errs = deps.errs ++ errs }
}

holding(u: Unit, path: str, clash: str[], i: int, acc: str[]) -> str[] {
    if i >= clash.length() {
        acc
    } else if keeps(u, path, clash.get(i)) {
        holding(u, path, clash, i + 1, acc ++ [clash.get(i)])
    } else {
        holding(u, path, clash, i + 1, acc)
    }
}

/// The program's own file keeps every name it writes, and so does the file an import named.
keeps(u: Unit, path: str, name: str) -> bool =>
    path == u.seen.get(0)
        || (wanted(u.asks, path, name)
            && !wanted(u.asks, owner_of(u, name, 0, ""), name))

wanted(asks: str[], path: str, name: str) -> bool =>
    asks.index_of("{path} {name}") >= 0

owner_of(u: Unit, name: str, i: int, held: str) -> str {
    if i >= u.names.length() {
        held
    } else if u.names.get(i) == name {
        owner_of(u, name, i + 1, u.owners.get(i))
    } else {
        owner_of(u, name, i + 1, held)
    }
}

without_names(xs: str[], drop: str[], i: int, acc: str[]) -> str[] {
    if i >= xs.length() {
        acc
    } else if drop.index_of(xs.get(i)) >= 0 {
        without_names(xs, drop, i + 1, acc)
    } else {
        without_names(xs, drop, i + 1, acc ++ [xs.get(i)])
    }
}

owned_by(mine: str[], path: str, i: int, acc: str[]) -> str[] {
    if i >= mine.length() {
        acc
    } else {
        owned_by(mine, path, i + 1, acc ++ [path])
    }
}

fn_names(items: Stmt[], i: int, acc: str[]) -> str[] {
    if i >= items.length() {
        acc
    } else if items.get(i).name != "" {
        fn_names(items, i + 1, acc ++ [items.get(i).name])
    } else {
        fn_names(items, i + 1, acc)
    }
}

clashing(mine: str[], taken: str[], i: int, acc: str[]) -> str[] {
    if i >= mine.length() {
        acc
    } else if taken.index_of(mine.get(i)) >= 0 {
        clashing(mine, taken, i + 1, acc ++ [mine.get(i)])
    } else {
        clashing(mine, taken, i + 1, acc)
    }
}

renamed(ts: Token[], taken: str[], tag: str, i: int) -> Token[] {
    out: Token[] = []
    recs: bool[] = []
    at = i

    while at < ts.length() {
        kind = ts.get(at).kind

        if kind == LBrace {
            recs = recs.push(opens_a_record(ts, at, recs.length()))
        } else if kind == RBrace && recs.length() > 0 {
            recs = recs.slice(0, recs.length() - 1)
        }

        out = out.push(names_a_field(ts, at, recs)
                       ? ts.get(at)
                       : one_renamed(ts.get(at), taken, tag))
        at = at + 1
    }

    out
}

/// A brace holds fields when the name after it is given a type or a value, and a block's never is.
opens_a_record(ts: Token[], j: int, depth: int) -> bool {
    if j == 0 || j + 2 >= ts.length() || ts.get(j + 1).kind != TIdent {
        false
    } else if ts.get(j - 1).kind == KwWith {
        true
    } else if depth == 0 && ts.get(j - 1).kind == Eq
            && ts.get(j + 2).kind == Colon {
        true
    } else if ts.get(j - 1).kind != TIdent || block_head(ts, j - 1) {
        false
    } else if j > 1 && ts.get(j - 2).kind == Arrow {
        false
    } else {
        after = ts.get(j + 2).kind

        after == Eq || after == Comma
    }
}

/// A field belongs to its record, not to the module, so a clash between modules never reaches it.
names_a_field(ts: Token[], at: int, recs: bool[]) -> bool {
    held = recs.length()

    if at == 0 {
        false
    } else if ts.get(at - 1).kind == Dot {
        true
    } else if held == 0 || at + 1 >= ts.length() {
        false
    } else if !recs.get(held - 1) || ts.get(at).kind != TIdent {
        false
    } else {
        after = ts.get(at + 1).kind
        before = ts.get(at - 1).kind
        keyed = after == Colon || after == Eq

        keyed && (before == LBrace || before == Comma || ts.get(at).fresh)
    }
}

one_renamed(t: Token, taken: str[], tag: str) -> Token {
    if t.kind == TIdent && taken.index_of(t.text) >= 0 {
        t with { text = "{t.text}__{tag}" }
    } else if t.kind == TStr && interp_mentions(t.text, taken) {
        t with { text = renamed_interp(t.text, taken, tag) }
    } else {
        t
    }
}

interp_mentions(raw: str, taken: str[]) -> bool {
    if raw.index_of("{{") < 0 {
        return false
    }

    i = 0
    while i < taken.length() {
        if raw.index_of(taken.get(i)) >= 0 {
            return true
        }
        i = i + 1
    }

    false
}

/// An interpolation holds code, so a name that moved has to move inside the string too.
renamed_interp(raw: str, taken: str[], tag: str) -> str {
    cs = raw.chars()
    out = ""
    j = 0
    depth = 0

    while j < cs.length() {
        c = cs.get(j)

        if c == "\\" && j + 1 < cs.length() {
            out = out ++ c ++ cs.get(j + 1)
            j = j + 2
        } else if depth == 0 && (doubled(cs, j, "{{") || doubled(cs, j, "}}")) {
            out = out ++ c ++ c
            j = j + 2
        } else if c == "{{" {
            depth = depth + 1
            out = out ++ c
            j = j + 1
        } else if c == "}}" && depth > 0 {
            depth = depth - 1
            out = out ++ c
            j = j + 1
        } else if depth > 0 && c == "\"" {
            shut = quoted_end(cs, j + 1)
            out = out ++ span(cs, j, shut + 1)
            j = shut + 1
        } else if depth > 0 && name_starts(cs, j) {
            shut = name_end(cs, j)
            word = span(cs, j, shut)
            out = out ++ moved_name(cs, j, word, taken, tag)
            j = shut
        } else {
            out = out ++ c
            j = j + 1
        }
    }

    out
}

moved_name(cs: str[], j: int, word: str, taken: str[], tag: str) -> str {
    reached = j > 0 && cs.get(j - 1) == "."

    !reached && taken.index_of(word) >= 0 ? "{word}__{tag}" : word
}

name_starts(cs: str[], j: int) -> bool {
    c = cs.get(j)

    c.is_alpha() || c == "_"
}

name_end(cs: str[], j: int) -> int {
    k = j

    while k < cs.length() && name_holds(cs.get(k)) {
        k = k + 1
    }

    k
}

name_holds(c: str) -> bool =>
    c.is_alpha() || c.is_ascii_digit() || c == "_"

without_eof(ts: Token[]) -> Token[] =>
    ts.slice(0, live_end(ts, ts.length()))

live_end(ts: Token[], n: int) -> int {
    if n <= 0 {
        0
    } else if ts.get(n - 1).kind == Eof {
        live_end(ts, n - 1)
    } else {
        n
    }
}

load_deps(by: str, wants: str[], i: int, u: Unit) -> Unit {
    if i >= wants.length() {
        u
    } else {
        load_deps(by, wants, i + 1, one_dep(by, wants.get(i), u))
    }
}

one_dep(by: str, want: str, u: Unit) -> Unit {
    at = resolved(by, want)

    if at != "" {
        load_unit(at, u)
    } else if want.index_of("/") < 0 {
        u
    } else {
        u with { unknown = u.unknown ++ ["{want}, imported by {by}"] }
    }
}

imports_in(ts: Token[], i: int, acc: str[]) -> str[] {
    out = acc
    at = i

    while ts.get(at).kind != Eof {
        if ts.get(at).kind == KwImport {
            out = out ++ import_names(ts, at + 1)
            at = import_end(ts, at + 1)
        } else {
            at = at + 1
        }
    }

    out
}

import_names(ts: Token[], i: int) -> str[] {
    if ts.get(i).kind == LBrace {
        import_names(ts, selection_end(ts, i + 1) + 2)
    } else if ts.get(i).kind == TStr {
        []
    } else {
        [import_path(ts, i, "")]
    }
}

import_path(ts: Token[], i: int, acc: str) -> str {
    if ts.get(i + 1).kind == Slash {
        import_path(ts, i + 2, acc ++ ts.get(i).text ++ "/")
    } else {
        acc ++ ts.get(i).text
    }
}

resolved(by: str, want: str) -> str {
    here = search_up(dir_of(by), want ++ ".maca")

    here != "" ? here : carried(want ++ ".maca")
}

/// The last place asked is what `MACA_STDLIB` names, else the library the compiler carries.
carried(want: str) -> str {
    root = env("MACA_STDLIB")

    if root != "" {
        return found(root ++ "/" ++ want)
    }

    found(carried_root() ++ "/" ++ want)
}

CarriedPackages = ["std", "cli", "web", "http", "signal", "profile"]

/// The library the compiler travels with, written out once so an import finds a file like any other.
carried_root() -> str {
    root = "{cache_home()}/stdlib/{Version}"

    if read_file(root ++ "/.stamp") == "" {
        write_carried(root)
        write_file(root ++ "/.stamp", Version)
    }

    root
}

write_carried(root: str) {
    make_dir(root)

    for pkg in CarriedPackages {
        make_dir("{root}/{pkg}")
    }

    std_csv: str = data("../../modules/std/csv.maca")
    write_file("{root}/std/csv.maca", std_csv)

    std_fs: str = data("../../modules/std/fs.maca")
    write_file("{root}/std/fs.maca", std_fs)

    std_json: str = data("../../modules/std/json.maca")
    write_file("{root}/std/json.maca", std_json)

    std_list: str = data("../../modules/std/list.maca")
    write_file("{root}/std/list.maca", std_list)

    std_path: str = data("../../modules/std/path.maca")
    write_file("{root}/std/path.maca", std_path)

    std_proc: str = data("../../modules/std/proc.maca")
    write_file("{root}/std/proc.maca", std_proc)

    std_text: str = data("../../modules/std/text.maca")
    write_file("{root}/std/text.maca", std_text)

    cli_help: str = data("../../modules/cli/help.maca")
    write_file("{root}/cli/help.maca", cli_help)

    cli_parse: str = data("../../modules/cli/parse.maca")
    write_file("{root}/cli/parse.maca", cli_parse)

    cli_show: str = data("../../modules/cli/show.maca")
    write_file("{root}/cli/show.maca", cli_show)

    cli_spec: str = data("../../modules/cli/spec.maca")
    write_file("{root}/cli/spec.maca", cli_spec)

    cli_style: str = data("../../modules/cli/style.maca")
    write_file("{root}/cli/style.maca", cli_style)

    web_file: str = data("../../modules/web/file.maca")
    write_file("{root}/web/file.maca", web_file)

    web_format: str = data("../../modules/web/format.maca")
    write_file("{root}/web/format.maca", web_format)

    web_storage: str = data("../../modules/web/storage.maca")
    write_file("{root}/web/storage.maca", web_storage)

    web_time: str = data("../../modules/web/time.maca")
    write_file("{root}/web/time.maca", web_time)

    http_dev: str = data("../../modules/http/dev.maca")
    write_file("{root}/http/dev.maca", http_dev)

    http_request: str = data("../../modules/http/request.maca")
    write_file("{root}/http/request.maca", http_request)

    http_response: str = data("../../modules/http/response.maca")
    write_file("{root}/http/response.maca", http_response)

    http_serve: str = data("../../modules/http/serve.maca")
    write_file("{root}/http/serve.maca", http_serve)

    http_server: str = data("../../modules/http/server.maca")
    write_file("{root}/http/server.maca", http_server)

    http_status: str = data("../../modules/http/status.maca")
    write_file("{root}/http/status.maca", http_status)

    signal_dom: str = data("../../modules/signal/dom.maca")
    write_file("{root}/signal/dom.maca", signal_dom)

    signal_store: str = data("../../modules/signal/store.maca")
    write_file("{root}/signal/store.maca", signal_store)

    profile_flame: str = data("../../modules/profile/flame.maca")
    write_file("{root}/profile/flame.maca", profile_flame)

    profile_play: str = data("../../modules/profile/play.maca")
    write_file("{root}/profile/play.maca", profile_play)

    profile_record: str = data("../../modules/profile/record.maca")
    write_file("{root}/profile/record.maca", profile_record)

    profile_report: str = data("../../modules/profile/report.maca")
    write_file("{root}/profile/report.maca", profile_report)

    profile_trace: str = data("../../modules/profile/trace.maca")
    write_file("{root}/profile/trace.maca", profile_trace)
}


search_up(dir: str, want: str) -> str {
    here = in_base(dir, want)

    if here != "" {
        here
    } else if dir == "" {
        ""
    } else {
        search_up(parent_of(dir), want)
    }
}

in_base(dir: str, want: str) -> str {
    own = found(dir ++ want)
    mods = found(dir ++ "modules/" ++ want)
    src = found(dir ++ "src/" ++ want)

    if own != "" {
        own
    } else if mods != "" {
        mods
    } else if src != "" {
        src
    } else {
        found(dir ++ DepsDir ++ "/" ++ want)
    }
}

found(cand: str) -> str {
    if read_file(cand) == "" {
        ""
    } else {
        cand
    }
}

dir_of(path: str) -> str =>
    path.slice(0, sep_after(path.chars(), path.length() - 1))

parent_of(dir: str) -> str =>
    dir_of(dir.slice(0, dir.length() - 1))

sep_after(cs: str[], i: int) -> int {
    if i < 0 {
        0
    } else if cs.get(i) == "/" {
        i + 1
    } else {
        sep_after(cs, i - 1)
    }
}

report_all(stage: str, msgs: str[], i: int) -> int {
    if i >= msgs.length() {
        msgs.length()
    } else {
        info("{stage} error: {msgs.get(i)}")

        report_all(stage, msgs, i + 1)
    }
}

SpecDoc = "docs/SPEC.md"
SpecHeading = "## Language cheatsheet"
SpecBudget = 15000
Carried = "a package this tree carries"

/// `spec` prints the language as one document, sized for a model's context.
spec_cmd(args: str[]) -> int {
    if args.index_of("--help") >= 0 || args.index_of("-h") >= 0 {
        info("usage: maca spec --llm [--package <name>]\n"
             ++ "\n  --llm       the whole specification, as one document"
             ++ "\n  --package   that one package's index, in the same form")

        0
    } else if args.index_of("--package") >= 0
            && flag_after(args, "--package") == "" {
        err("spec: --package wants a name")

        2
    } else {
        spec_asked(spec_root(), flag_after(args, "--package"))
    }
}

spec_asked(root: str, pkg: str) -> int {
    if root == "" {
        err("spec: no {SpecDoc} above this directory")

        1
    } else if pkg != "" {
        package_index(root, pkg)
    } else {
        printed_spec(llm_spec(root))
    }
}

/// The tree the document is read out of, found by walking up as an import does.
spec_root() -> str =>
    root_above(cwd() ++ "/")

root_above(dir: str) -> str {
    if found(dir ++ SpecDoc) != "" {
        dir
    } else if dir == "" {
        ""
    } else {
        root_above(parent_of(dir))
    }
}

/// The document is only useful if it fits beside the code a model is writing.
printed_spec(text: str) -> int {
    used = (text.length() + 2) / 3

    if used > SpecBudget {
        err("spec: {used} tokens, over the {SpecBudget} budget")

        1
    } else {
        info(text)

        0
    }
}

package_index(root: str, name: str) -> int {
    body = indexed(root ++ "modules/" ++ name, name, true)

    if body == "" {
        err("spec: no package `{name}` under {root}modules")

        1
    } else {
        info("# `{name}`\n{body}")

        0
    }
}

llm_spec(root: str) -> str =>
    "# Maca {Version}\n"
        ++ "\nOne typed language for programs and infrastructure config. "
        ++ "Everything you write is `.maca` or `maca.toml`.\n"
        ++ "\nThe language section is `{SpecDoc}` verbatim and the indexes are "
        ++ "read out of the packages beside it, so neither can drift from the "
        ++ "tree this was run in.\n"
        ++ "\n## The language\n\n{cheatsheet(read_file(root ++ SpecDoc))}\n"
        ++ "\n## Whole programs\n\nEach compiles and runs as written.\n"
        ++ examples(root)
        ++ "\n## Mistakes to avoid\n" ++ mistakes()
        ++ "\n## Targets\n" ++ targets_table()
        ++ "\n## The standard library\n\nCarried beside the compiler, so "
        ++ "`import std/json` resolves anywhere. Every item below is one "
        ++ "`import` away.\n"
        ++ builtin_methods()
        ++ indexed(root ++ "modules/std", "std", false)
        ++ other_packages(root)

/// The one normative section, up to the next heading of its own depth.
cheatsheet(spec: str) -> str {
    at = spec.index_of(SpecHeading)
    rest = at < 0 ? "" : spec.slice(at + SpecHeading.length(), spec.length())
    end = rest.index_of("\n## ")
    cut = end < 0 ? rest.length() : end

    rest.slice(0, cut).trim()
}

examples(root: str) -> str =>
    example(root, "a whole program", "tour")
        ++ example(root, "sum types and match", "payload_sum")
        ++ example(root, "errors, without exceptions", "catch")
        ++ example(root, "concurrency, with no `async` keyword", "async")
        ++ example(root, "a generic function", "generic")
        ++ example(root, "config mode, which compiles to Nix", "ffi_nix")

example(root: str, what: str, name: str) -> str =>
    "\n### {what}\n\n```maca\n"
        ++ read_file("{root}apps/examples/{name}.maca") ++ "```\n"

/// Every `///` item of a package, by file, summary only when asked.
indexed(dir: str, pkg: str, full: bool) -> str =>
    index_files(dir, pkg, list_dir(dir), 0, full, "")

index_files(dir: str, pkg: str, names: str[], i: int, full: bool,
            acc: str) -> str {
    if i >= names.length() {
        acc
    } else if !names.get(i).ends_with(".maca") {
        index_files(dir, pkg, names, i + 1, full, acc)
    } else {
        index_files(dir, pkg, names, i + 1, full,
                    acc ++ index_file(dir, pkg, names.get(i), full))
    }
}

index_file(dir: str, pkg: str, name: str, full: bool) -> str {
    body = documented(read_file("{dir}/{name}").split("\n"), 0, "", full, "")
    stem = name.slice(0, name.length() - 5)

    if body == "" {
        ""
    } else if full {
        "\n### `{pkg}/{stem}`\n\n{body}"
    } else {
        "\n`{pkg}/{stem}`\n\n{body}"
    }
}

/// One `///` line and the item under it, which is what marks that item as API.
documented(lines: str[], i: int, doc: str, full: bool, acc: str) -> str {
    if i >= lines.length() {
        acc
    } else if lines.get(i).trim().starts_with("///") {
        documented(lines, i + 1, summary_of(lines.get(i)), full, acc)
    } else if doc == "" {
        documented(lines, i + 1, "", full, acc)
    } else {
        documented(lines, i + 1, "", full,
                   acc ++ item_line(signature_of(lines.get(i)), doc, full))
    }
}

summary_of(line: str) -> str {
    t = line.trim()

    t.slice(3, t.length()).trim()
}

signature_of(line: str) -> str {
    t = line.trim()
    at = t.index_of("\{")

    at < 0 ? t : t.slice(0, at).trim()
}

item_line(sig: str, doc: str, full: bool) -> str {
    if sig == "" {
        ""
    } else if full {
        "- `{sig}` {doc}\n"
    } else {
        "- `{sig}`\n"
    }
}

other_packages(root: str) -> str =>
    "\nBeside `std`, the packages under `modules` ride in the same tree. Run "
        ++ "`maca spec --package <name>` for one of their indexes.\n\n"
        ++ package_lines(root, list_dir(root ++ "modules"), 0, "")

package_lines(root: str, names: str[], i: int, acc: str) -> str {
    if i >= names.length() {
        acc
    } else if names.get(i) == "std"
            || !is_dir("{root}modules/{names.get(i)}") {
        package_lines(root, names, i + 1, acc)
    } else {
        package_lines(root, names, i + 1,
                      acc ++ "- `{names.get(i)}`: "
                          ++ blurb_of(root, names.get(i)) ++ "\n")
    }
}

blurb_of(root: str, pkg: str) -> str {
    dir = "{root}modules/{pkg}"
    first = first_maca(list_dir(dir), 0)

    first == "" ? Carried : blurb(read_file("{dir}/{first}"))
}

first_maca(names: str[], i: int) -> str {
    if i >= names.length() {
        ""
    } else if names.get(i).ends_with(".maca") {
        names.get(i)
    } else {
        first_maca(names, i + 1)
    }
}

/// The first `//` line of a module file, which is the blurb its index prints.
blurb(src: str) -> str {
    lines = src.split("\n")
    head = lines.length() == 0 ? "" : lines.get(0).trim()

    if head.starts_with("//") && !head.starts_with("///") {
        head.slice(2, head.length()).trim()
    } else {
        Carried
    }
}

/// The forms a reader reaches for that Maca does not have.
mistakes() -> str =>
    "\nThese are the five the checker sees most, and it rejects each by "
        ++ "name.\n\n"
        ++ "- **No `let`.** write `x = e` for a variable, `const x = e` for a "
        ++ "constant; no `let`/`var` keyword.\n"
        ++ "- **No `fn`.** write the signature straight out: "
        ++ "`name(arg: T) -> R \{ … \}` or `name(arg: T) -> R => e`; no `fn` "
        ++ "keyword.\n"
        ++ "- **No `type`.** declare a type by binding it: "
        ++ "`Name = \{ field: T \}` for a record, `Name = A | B` for a sum; no "
        ++ "`type` keyword.\n"
        ++ "- **No `async`.** async is an inferred effect, so any function can "
        ++ "`spawn` and `await`; no `async` keyword to write.\n"
        ++ "- **No `null`.** a sum type with an empty variant says what the "
        ++ "absence means, and `match` makes you handle it; Maca has no null.\n"
        ++ "\nTwo more that parse but mean something else:\n\n"
        ++ "- **`lo..hi` excludes `hi`.** `0..xs.length()` is every index of "
        ++ "`xs`. Writing `0..xs.length() - 1` misses the last element.\n"
        ++ "- **A block after `=>` is a record literal.** `f() => \{ a = 1 \}` "
        ++ "builds a record. Use `f() \{ … \}` when you meant a body.\n"

/// What each target carries, which is what `--target` is checked against.
targets_table() -> str =>
    "\n`maca check --target <t>` refuses a program that performs an effect "
        ++ "its target cannot carry. With no `--target` a program is held to "
        ++ "`native`, which is what `maca build` produces.\n\n"
        ++ "| target | flag | carries |\n|---|---|---|\n"
        ++ "| native | (default) | io, net, os, async, exn |\n"
        ++ "| js | `--target js` | io, net, async, exn |\n"
        ++ "| jvm | `--target jvm` | io, net, os, async, exn |\n"
        ++ "| rust | `--target rust` | io, net, os, async, exn |\n"
        ++ "| embedded | `--target embedded` | exn |\n"
        ++ "| nix | `--target nix` | nothing: config mode is data |\n"
        ++ "\nThere is no BEAM target, by design.\n\n"
        ++ "Two differences are not effects, and are the back end's own error: "
        ++ "`int / int` truncates natively and does not on `js`, and a "
        ++ "function-typed record field is refused on `rust` and `jvm`.\n"

/// The methods a receiver accepts, which are builtins rather than exports.
builtin_methods() -> str =>
    "\nThese are builtins on the receiver, not module exports: write "
        ++ "`s.trim()`, never `import \{ trim \} from std/text`.\n\n"
        ++ "- **`str`**: `length`, `split`, `trim`, `upper`, `lower`, "
        ++ "`contains`, `starts_with`, `ends_with`, `replace`, `substr`, "
        ++ "`slice`, `index_of`, `repeat`, `pad_start`, `pad_end`, "
        ++ "`pad_center`, `chars`, `at`, `is_whitespace`, `is_ascii_digit`, "
        ++ "`is_alpha`\n"
        ++ "- **`T[]`**: `map`, `filter`, `reduce`, `fold`, `sort`, `sort_by`, "
        ++ "`reverse`, `push`, `pop`, `set`, `insert`, `remove`, `slice`, "
        ++ "`contains`, `index_of`, `index_of_by`, `enumerate`, `sum`, `min`, "
        ++ "`max`, `first`, `last`, `get`, `length`, `parallel`, `join`\n"
        ++ "- **`Map k v`**: `set`, `get`, `has`, `remove`, `keys`, `length`\n"

ProfileWidth = 1080

ProfileDepth = 40

ProfileRows = 12

/// `profile` runs the program under callgrind and says where its instructions went.
profile_cmd(args: str[]) -> int {
    src = build_src(args, 1, "")
    out = flag_after(args, "-o")

    if src == "" {
        err("profile: expected a .maca file")

        2
    } else {
        profile_built(src, out == "" ? "{stem_of(src)}.svg" : out)
    }
}

profile_built(src: str, svg: str) -> int {
    bin = scratch_path("profile")
    built = build_binary(src, bin)

    built != 0 ? built : profile_measured(src, bin, svg)
}

/// Callgrind counts every instruction the run executes, so it is slow and exactly repeatable.
profile_measured(src: str, bin: str, svg: str) -> int {
    cg = "{bin}.callgrind"

    info("profiling {src} under callgrind, which is slower than a plain run")
    exec("valgrind", ["--tool=callgrind", "--callgrind-out-file={cg}", bin])

    dump = read_file(cg)

    remove_file(bin)
    remove_file("{bin}.c")
    remove_file(cg)

    if dump == "" {
        err("profile: callgrind wrote nothing; valgrind has to be on PATH")

        2
    } else {
        profile_reported(src, costs_in(dump), svg)
    }
}

profile_reported(src: str, d: Dump, svg: str) -> int {
    info(cost_table(d))
    write_file(svg, flame_svg_in(trace(src, frames_of(d)), ProfileWidth, "Ir"))
    info("flame graph -> {svg}")

    0
}

Dump = {
    fns:   str[]
    own:   int[]
    edges: str[]
    costs: int[]
    total: int
}

Scan = {
    d:      Dump
    here:   str
    callee: str
}

/// A callgrind dump: what each function spent on itself, and what every call it makes carries.
costs_in(text: str) -> Dump {
    lines = text.split("\n")
    table = name_table(lines)
    s = Scan { d = Dump { fns = [], own = [], edges = [], costs = [],
                          total = 0 },
               here = "", callee = "" }
    i = 0

    while i < lines.length() {
        s = one_line(table, lines.get(i), s)
        i = i + 1
    }

    s.d with { total = s.d.total < 1 ? 1 : s.d.total }
}

one_line(table: str[], line: str, s: Scan) -> Scan {
    if line.starts_with("fn=") {
        s with { here = spec_name(table, line.slice(3, line.length())),
                 callee = "" }
    } else if line.starts_with("cfn=") {
        s with { callee = spec_name(table, line.slice(4, line.length())) }
    } else if s.here == "" || !is_cost_line(line) {
        s
    } else if s.callee != "" {
        s with { d = charged(s.d, "{s.here}\n{s.callee}", cost_in(line)),
                 callee = "" }
    } else {
        s with { d = owned(s.d, s.here, cost_in(line)) }
    }
}

charged(d: Dump, key: str, ir: int) -> Dump {
    at = d.edges.index_of(key)

    if at < 0 {
        d with { edges = d.edges.push(key), costs = d.costs.push(ir) }
    } else {
        d with { costs = d.costs.set(at, d.costs.get(at) + ir) }
    }
}

owned(d: Dump, name: str, ir: int) -> Dump {
    at = d.fns.index_of(name)

    if at < 0 {
        d with { fns = d.fns.push(name), own = d.own.push(ir),
                 total = d.total + ir }
    } else {
        d with { own = d.own.set(at, d.own.get(at) + ir),
                 total = d.total + ir }
    }
}

/// A cost line opens with a position: a number, or a `*`/`+`/`-` step from the last one.
is_cost_line(line: str) -> bool {
    c = line.slice(0, 1)

    c.is_ascii_digit() || c == "*" || c == "+" || c == "-"
}

cost_in(line: str) -> int {
    fs = nonempty(line.split(" "), 0, [])

    fs.length() < 2 ? 0 : int(fs.get(1))
}

/// Callgrind writes each name once as `(id) name` and then refers back to it by `(id)`.
name_table(lines: str[]) -> str[] {
    acc: str[] = []
    i = 0

    while i < lines.length() {
        acc = with_spec(acc, name_spec(lines.get(i)))
        i = i + 1
    }

    acc
}

with_spec(acc: str[], spec: str) -> str[] =>
    spec == "" ? acc : acc.push(spec)

name_spec(line: str) -> str {
    body = fn_spec(line)
    close = body.index_of(")")
    tail = close < 0 ? "" : body.slice(close + 1, body.length()).trim()

    if !body.starts_with("(") || tail == "" {
        ""
    } else {
        "{body.slice(1, close)}\n{tail}"
    }
}

fn_spec(line: str) -> str {
    if line.starts_with("fn=") {
        line.slice(3, line.length()).trim()
    } else if line.starts_with("cfn=") {
        line.slice(4, line.length()).trim()
    } else {
        ""
    }
}

spec_name(table: str[], spec: str) -> str {
    s = spec.trim()
    close = s.index_of(")")
    tail = close < 0 ? "" : s.slice(close + 1, s.length()).trim()

    if !s.starts_with("(") || close < 0 {
        s
    } else if tail != "" {
        tail
    } else {
        table_name(table, s.slice(1, close), 0)
    }
}

table_name(table: str[], id: str, i: int) -> str {
    if i >= table.length() {
        ""
    } else if table.get(i).split("\n").get(0) == id {
        table.get(i).slice(id.length() + 1, table.get(i).length())
    } else {
        table_name(table, id, i + 1)
    }
}

/// The heaviest functions by self cost, which is what a profile is read for.
cost_table(d: Dump) -> str =>
    cost_rows(d, own_order(d, 0, []), 0,
              ["  self%  " ++ "Ir".pad_start(9) ++ "  function"]).join("\n")

cost_rows(d: Dump, order: int[], i: int, acc: str[]) -> str[] {
    if i >= order.length() || i >= ProfileRows
            || d.own.get(order.get(i)) == 0 {
        acc
    } else {
        cost_rows(d, order, i + 1, acc ++ [cost_row(d, order.get(i))])
    }
}

cost_row(d: Dump, at: int) -> str {
    share = percent(d.own.get(at), d.total)

    "  {share:.1}".pad_end(9) ++ str(d.own.get(at)).pad_start(9) ++ "  "
        ++ d.fns.get(at)
}

own_order(d: Dump, i: int, acc: int[]) -> int[] {
    if i >= d.fns.length() {
        acc
    } else {
        own_order(d, i + 1, ranked(d, acc, i))
    }
}

ranked(d: Dump, acc: int[], at: int) -> int[] {
    cut = rank_in(d, acc, d.own.get(at), 0)

    acc.slice(0, cut).push(at) ++ acc.slice(cut, acc.length())
}

rank_in(d: Dump, acc: int[], own: int, i: int) -> int {
    if i >= acc.length() {
        i
    } else if d.own.get(acc.get(i)) < own {
        i
    } else {
        rank_in(d, acc, own, i + 1)
    }
}

Call = {
    to: str
    ir: int
}

Frame = {
    depth:  int
    x:      int
    parent: int
}

/// The call graph as flame graph frames, laid out from the entry point outwards.
frames_of(d: Dump) -> Span[] {
    root = root_name(d)

    if root == "" {
        []
    } else {
        frames_at(d, Call { to = root, ir = inclusive_of(d, root) },
                  Frame { depth = 0, x = 0, parent = -1 }, [], [])
    }
}

frames_at(d: Dump, f: Call, at: Frame, path: str[], acc: Span[]) -> Span[] {
    mine = acc.length()
    kids: Call[] = at.depth + 1 >= ProfileDepth ? [] : calls_of(d, f.to)
    box = Span { name = f.to, start = at.x, end = at.x + f.ir,
                 depth = at.depth, parent = at.parent, closed = true }

    laid_out(d, kids, 0, at.x + f.ir,
             Frame { depth = at.depth + 1, x = at.x, parent = mine },
             path ++ [f.to], acc.push(box))
}

/// Each call gets the width its cost asks for, or whatever is left of its caller.
laid_out(d: Dump, kids: Call[], i: int, stop: int, at: Frame, path: str[],
         acc: Span[]) -> Span[] {
    if i >= kids.length() || at.x >= stop {
        acc
    } else if kids.get(i).ir <= 0 || path.index_of(kids.get(i).to) >= 0 {
        laid_out(d, kids, i + 1, stop, at, path, acc)
    } else {
        wide = kids.get(i).ir < stop - at.x ? kids.get(i).ir : stop - at.x

        laid_out(d, kids, i + 1, stop, at with { x = at.x + wide }, path,
                 frames_at(d, Call { to = kids.get(i).to, ir = wide }, at,
                           path, acc))
    }
}

/// The entry point, or the heaviest function when the run had no `main`.
root_name(d: Dump) -> str {
    if d.fns.index_of("main") >= 0 {
        "main"
    } else if d.fns.length() == 0 {
        ""
    } else {
        d.fns.get(heaviest(d, 0, 0))
    }
}

heaviest(d: Dump, i: int, best: int) -> int {
    if i >= d.fns.length() {
        best
    } else if d.own.get(i) > d.own.get(best) {
        heaviest(d, i + 1, i)
    } else {
        heaviest(d, i + 1, best)
    }
}

/// What a function costs in full: its own instructions, plus what its calls carry.
inclusive_of(d: Dump, name: str) -> int =>
    own_of(d, name) + edge_sum(d, "{name}\n", 0, 0)

own_of(d: Dump, name: str) -> int {
    at = d.fns.index_of(name)

    at < 0 ? 0 : d.own.get(at)
}

edge_sum(d: Dump, from: str, i: int, acc: int) -> int {
    if i >= d.edges.length() {
        acc
    } else if d.edges.get(i).starts_with(from) {
        edge_sum(d, from, i + 1, acc + d.costs.get(i))
    } else {
        edge_sum(d, from, i + 1, acc)
    }
}

calls_of(d: Dump, from: str) -> Call[] =>
    heavy_first(calls_in(d, "{from}\n", 0, []), 0, [])

calls_in(d: Dump, from: str, i: int, acc: Call[]) -> Call[] {
    if i >= d.edges.length() {
        acc
    } else if d.edges.get(i).starts_with(from) {
        calls_in(d, from, i + 1, acc.push(one_call(d, from, i)))
    } else {
        calls_in(d, from, i + 1, acc)
    }
}

one_call(d: Dump, from: str, i: int) -> Call =>
    Call { to = d.edges.get(i).slice(from.length(), d.edges.get(i).length()),
           ir = d.costs.get(i) }

heavy_first(cs: Call[], i: int, acc: Call[]) -> Call[] {
    if i >= cs.length() {
        acc
    } else {
        heavy_first(cs, i + 1, call_ranked(acc, cs.get(i)))
    }
}

call_ranked(acc: Call[], c: Call) -> Call[] {
    cut = call_rank(acc, c.ir, 0)

    acc.slice(0, cut).push(c) ++ acc.slice(cut, acc.length())
}

call_rank(acc: Call[], ir: int, i: int) -> int {
    if i >= acc.length() {
        i
    } else if acc.get(i).ir < ir {
        i
    } else {
        call_rank(acc, ir, i + 1)
    }
}

DevFile = "dev.maca"

StarterDev = "    import nixpkgs\n\n    dev.name     = \"myapp\"\n"
    ++ "    dev.packages = rustc, cargo\n"
    ++ "    dev.env      = \{ RUST_BACKTRACE = \"1\" \}\n"

/// `dev` turns the `dev.*` bindings of a config file into the flake `nix develop` enters.
dev_cmd(args: str[]) -> int {
    named = build_src(args, 1, "")
    src = named == "" ? DevFile : named
    out = flag_after(args, "-o")

    if !file_exists(src) {
        err("dev: no {src} here. It describes the dev shell, in Maca:\n\n"
            ++ StarterDev
            ++ "\nThen `maca dev` writes it and `nix develop` enters it.")

        2
    } else {
        dev_written(src, out == "" ? "flake.nix" : out)
    }
}

dev_written(src: str, out: str) -> int {
    raw = parse_module(lex(read_file(src)), 0, [])
    bad = report_all("parse", raw.errors, 0)

    bad > 0 ? bad : dev_flake_out(raw, out)
}

dev_flake_out(m: Module, out: str) -> int {
    write_file(out, dev_flake(m))
    info("wrote {out}; run `nix develop` to enter the shell")

    0
}

dev_flake(m: Module) -> str =>
    flake_text(dev_name(m.items),
               dev_packages(m.items) ++ dev_env(m.items) ++ dev_hook(m.items))

dev_at(items: Stmt[], name: str, i: int) -> int {
    if i >= items.length() {
        -1
    } else if items.get(i).kind == SBind && items.get(i).name == name {
        i
    } else {
        dev_at(items, name, i + 1)
    }
}

dev_name(items: Stmt[]) -> str {
    at = dev_at(items, "dev.name", 0)

    at < 0 || items.get(at).value.kind != EStr
        ? "dev"
        : items.get(at).value.text
}

dev_packages(items: Stmt[]) -> str {
    at = dev_at(items, "dev.packages", 0)
    ps = at < 0 ? "[ ]" : nix_pkg_list(items.get(at).value)

    "          packages = {ps};\n"
}

dev_env(items: Stmt[]) -> str {
    at = dev_at(items, "dev.env", 0)

    if at < 0 || items.get(at).value.kind != ERecord {
        ""
    } else {
        dev_lines(nix_fields(items.get(at).value.children, 0, []), 0, "")
    }
}

dev_lines(ls: str[], i: int, acc: str) -> str {
    if i >= ls.length() {
        acc
    } else {
        dev_lines(ls, i + 1, acc ++ "          " ++ ls.get(i) ++ "\n")
    }
}

dev_hook(items: Stmt[]) -> str {
    at = dev_at(items, "dev.shellHook", 0)
    fell = at < 0 ? dev_at(items, "dev.shell_hook", 0) : at

    if fell < 0 || items.get(fell).value.kind != EStr {
        ""
    } else {
        "          shellHook = {nix_string(items.get(fell).value.text)};\n"
    }
}

flake_text(name: str, shell: str) -> str =>
    "\{\n  description = \"{name} dev environment, written by `maca dev`\";\n\n"
        ++ "  inputs.nixpkgs.url = \"github:NixOS/nixpkgs/nixos-unstable\";\n\n"
        ++ "  outputs = \{ self, nixpkgs \}:\n    let\n"
        ++ "      systems = [ \"x86_64-linux\" \"aarch64-linux\" "
        ++ "\"x86_64-darwin\" \"aarch64-darwin\" ];\n"
        ++ "      forAllSystems = f: nixpkgs.lib.genAttrs systems "
        ++ "(system: f nixpkgs.legacyPackages.$\{system\});\n"
        ++ "    in \{\n      devShells = forAllSystems (pkgs: \{\n"
        ++ "        default = pkgs.mkShell \{\n" ++ shell
        ++ "        \};\n      \});\n    \};\n\}\n"

DepsDir = "maca_modules"
LockFile = "maca.lock"
NpmRegistry = "https://registry.npmjs.org"
MacaRegistry = "https://registry.maca.dev"
Releases = "https://api.github.com/repos/pleahmacaka/macalang/releases/latest"
ReleasePage = "https://github.com/pleahmacaka/macalang/releases/latest"

Spec = {
    name: str
    kind: str
    pkg:  str
    req:  str
}

Pin = {
    version:   str
    tarball:   str
    integrity: str
    commit:    str
    why:       str
}

Dep = {
    name: str
    spec: str
}

Pkg = {
    name:  str
    block: str
}

Ver = {
    major: int
    minor: int
    patch: int
    ok:    bool
}

/// `maca add <spec>…`: add one or more dependencies to the manifest and fetch them.
add_cmd(args: str[]) -> int {
    specs = nonflags(args, 1, [])

    if specs.length() == 0 {
        err("usage: maca add <spec>...\n  e.g. maca add npm:axios\n"
            ++ "       maca add git+https://github.com/u/lib#main\n"
            ++ "       maca add utils@^1.2.0")

        2
    } else {
        write_absent(Manifest, "[package]\nname = \"app\"\n\n[dependencies]\n")

        added(specs, 0, registry_url(), 0)
    }
}

added(specs: str[], i: int, registry: str, bad: int) -> int {
    if i >= specs.length() {
        bad > 0 ? 1 : 0
    } else {
        added(specs, i + 1, registry, bad + add_one(specs.get(i), registry))
    }
}

add_one(spec: str, registry: str) -> int {
    s = parse_spec(spec)
    p = bad_name(s.name) ? failed("`{spec}` names no package")
                         : brought(s, spec, registry, unpinned())

    if p.why != "" {
        err("maca add {spec}: {p.why}")

        1
    } else {
        manifest_put(s.name, spec)
        info("added {s.name}@{p.version} -> {DepsDir}/{s.name}")

        0
    }
}

/// `maca install`: put every dependency the manifest names where the compiler looks for it, at the version the lock pinned.
install_cmd() -> int {
    deps = manifest_deps()

    if deps.length() == 0 {
        info("no dependencies in {Manifest}")

        0
    } else {
        install_all(deps, 0, registry_url(), 0)
    }
}

install_all(deps: Dep[], i: int, registry: str, bad: int) -> int {
    if i >= deps.length() {
        bad > 0 ? 1 : 0
    } else {
        install_all(deps, i + 1, registry,
                    bad + install_one(deps.get(i), registry))
    }
}

install_one(d: Dep, registry: str) -> int {
    if is_dir("{DepsDir}/{d.name}") {
        info("{d.name} is already there")

        0
    } else {
        installed(d, brought(parse_spec(d.spec), d.spec, registry,
                             pinned(lock_read(), d.name, d.spec)))
    }
}

installed(d: Dep, p: Pin) -> int {
    if p.why != "" {
        err("maca install {d.name}: {p.why}")

        1
    } else {
        info("installed {d.name}@{p.version} -> {DepsDir}/{d.name}")

        0
    }
}

/// `maca update`: re-resolve every dependency, ignoring what the lock pinned.
update_cmd() -> int {
    deps = manifest_deps()

    if deps.length() == 0 {
        info("no dependencies in {Manifest}")

        0
    } else {
        update_all(deps, 0, registry_url(), 0)
    }
}

update_all(deps: Dep[], i: int, registry: str, bad: int) -> int {
    if i >= deps.length() {
        bad > 0 ? 1 : 0
    } else {
        update_all(deps, i + 1, registry,
                   bad + update_one(deps.get(i), registry))
    }
}

update_one(d: Dep, registry: str) -> int {
    p = brought(parse_spec(d.spec), d.spec, registry, unpinned())

    if p.why != "" {
        err("maca update {d.name}: {p.why}")

        1
    } else {
        info("{d.name} -> {p.version}")

        0
    }
}

/// One dependency resolved, unpacked under `maca_modules`, and written back to the lock.
brought(s: Spec, spec: str, registry: str, want: Pin) -> Pin {
    p = want.version == "" ? resolve_dep(s, registry) : want

    p.why != "" ? p : landed(s, spec, p)
}

landed(s: Spec, spec: str, p: Pin) -> Pin {
    why = fetch(s, p)

    if why != "" {
        failed(why)
    } else {
        lock_put(s, spec, p)

        p
    }
}

/// `maca upgrade`: replace this toolchain with the newest published release.
upgrade_cmd() -> int {
    doc = http_get(Releases)
    tag = json_str(doc, "tag_name")
    want = tag.starts_with("v") ? tag.slice(1, tag.length()) : tag

    if doc == "" {
        err("maca upgrade: cannot reach GitHub releases\n  install by hand: "
            ++ ReleasePage)

        1
    } else if want == "" {
        err("maca upgrade: no published release yet\n  build from a checkout: "
            ++ "maca build apps/maca1/main.maca -o maca")

        1
    } else if want == Version {
        info("maca {Version} is already the latest release")

        0
    } else {
        replaced(want, asset_url(doc, "maca-{host_triple()}"))
    }
}

/// The download URL of the asset the platform asks for, found by name because a release asset URL ends in it.
asset_url(doc: str, want: str) -> str {
    key = "\"browser_download_url\""
    at = doc.index_of(key)

    at < 0 ? "" : asset_pick(doc.slice(at + key.length(), doc.length()), want)
}

asset_pick(rest: str, want: str) -> str {
    url = quoted_at(rest.slice(0, JsonWindow).chars(), 0)

    seg_after(url, "/").starts_with(want) ? url : asset_url(rest, want)
}

replaced(want: str, url: str) -> int {
    exe = capture("sh", ["-c", "command -v maca"]).trim()

    if url == "" {
        err("maca upgrade: release v{want} has no asset for {host_triple()}\n"
            ++ "  build from a checkout: maca build apps/maca1/main.maca -o maca")

        1
    } else if exe == "" {
        err("maca upgrade: no `maca` on PATH to replace; take it by hand:\n  {url}")

        1
    } else {
        swapped(exe, url, want)
    }
}

swapped(exe: str, url: str, want: str) -> int {
    tmp = "{exe}.new"

    if exec("curl", ["-fsSL", "-o", tmp, url]) != 0 {
        err("maca upgrade: download failed: {url}")

        1
    } else if exec("chmod", ["755", tmp]) != 0 || exec("mv", [tmp, exe]) != 0 {
        err("maca upgrade: cannot replace {exe}")

        1
    } else {
        info("upgraded maca {Version} -> {want}")

        0
    }
}

/// The platform a release asset is named after, read from `uname` rather than from how this binary was built.
host_triple() -> str {
    named = capture("uname", ["-sm"]).trim()
    machine = named.index_of("arm64") >= 0 || named.index_of("aarch64") >= 0
        ? "aarch64" : "x86_64"

    if named.starts_with("Darwin") {
        "{machine}-macos"
    } else if named.starts_with("Linux") {
        "{machine}-linux"
    } else {
        "x86_64-windows"
    }
}

JsonWindow = 512

/// The string `key` names in a registry or release answer, read without a parser because both documents are flat and every value wanted is short.
json_str(src: str, key: str) -> str {
    at = src.index_of("\"{key}\"")
    from = at + key.length() + 2

    at < 0 ? "" : quoted_at(src.slice(from, from + JsonWindow).chars(), 0)
}

quoted_at(cs: str[], i: int) -> str {
    if i >= cs.length() || cs.get(i) == "," {
        ""
    } else if cs.get(i) == "\"" {
        upto_quote(cs, i + 1, "")
    } else {
        quoted_at(cs, i + 1)
    }
}

upto_quote(cs: str[], i: int, acc: str) -> str {
    if i >= cs.length() || cs.get(i) == "\"" {
        acc
    } else {
        upto_quote(cs, i + 1, acc ++ cs.get(i))
    }
}

nonflags(args: str[], i: int, acc: str[]) -> str[] {
    if i >= args.length() {
        acc
    } else if args.get(i).starts_with("-") {
        nonflags(args, i + 1, acc)
    } else {
        nonflags(args, i + 1, acc ++ [args.get(i)])
    }
}

/// `npm:<pkg>[@<req>]` is the npm registry, `git+<url>[#<ref>]` any git remote, and a bare `<name>[@<req>]` the maca registry.
parse_spec(spec: str) -> Spec {
    s = spec.trim()

    if s.starts_with("npm:") {
        npm_spec(s.slice(4, s.length()))
    } else if s.starts_with("git+") {
        git_spec(s.slice(4, s.length()))
    } else {
        reg_spec(s)
    }
}

npm_spec(rest: str) -> Spec {
    cut = version_cut(rest)
    pkg = cut < 0 ? rest : rest.slice(0, cut)

    Spec { name = seg_after(pkg, "/"), kind = "npm", pkg = pkg,
           req = cut < 0 ? "latest" : rest.slice(cut + 1, rest.length()) }
}

git_spec(rest: str) -> Spec {
    at = rest.index_of("#")
    url = at < 0 ? rest : rest.slice(0, at)

    Spec { name = git_name(url), kind = "git", pkg = url,
           req = at < 0 ? "" : rest.slice(at + 1, rest.length()) }
}

reg_spec(s: str) -> Spec {
    cut = version_cut(s)
    name = cut < 0 ? s : s.slice(0, cut)

    Spec { name = name, kind = "registry", pkg = name,
           req = cut < 0 ? "latest" : s.slice(cut + 1, s.length()) }
}

/// The `@` that opens a version, which is never the `@` a scoped npm name starts with.
version_cut(s: str) -> int {
    at = last_of(s.chars(), "@", s.length() - 1)

    at > 0 ? at : -1
}

last_of(cs: str[], want: str, i: int) -> int {
    if i < 0 {
        -1
    } else if cs.get(i) == want {
        i
    } else {
        last_of(cs, want, i - 1)
    }
}

seg_after(s: str, sep: str) -> str =>
    s.slice(last_of(s.chars(), sep, s.length() - 1) + 1, s.length())

git_name(url: str) -> str {
    whole = url.ends_with("/") ? url.slice(0, url.length() - 1) : url
    tail = seg_after(seg_after(whole, "/"), ":")

    tail.ends_with(".git") ? tail.slice(0, tail.length() - 4) : tail
}

/// A dependency is unpacked into a directory of its own, so its name has to be one path segment.
bad_name(name: str) -> bool =>
    name == "" || name == "." || name == ".." || name.index_of("/") >= 0

ver_of(text: str) -> Ver {
    t = text.trim()
    s = t.starts_with("v") ? t.slice(1, t.length()) : t
    parts = s.slice(0, core_end(s.chars(), 0)).split(".")

    parts.length() > 3 ? bad_ver() : ver_parts(parts)
}

bad_ver() -> Ver =>
    Ver { major = 0, minor = 0, patch = 0, ok = false }

core_end(cs: str[], i: int) -> int {
    if i >= cs.length() || cs.get(i) == "-" || cs.get(i) == "+" {
        i
    } else {
        core_end(cs, i + 1)
    }
}

ver_parts(parts: str[]) -> Ver {
    a = parts.get(0)
    b = parts.length() > 1 ? parts.get(1) : "0"
    c = parts.length() > 2 ? parts.get(2) : "0"

    if !digits(a) || !digits(b) || !digits(c) {
        bad_ver()
    } else {
        Ver { major = int(a), minor = int(b), patch = int(c), ok = true }
    }
}

digits(s: str) -> bool =>
    s != "" && all_digits(s.chars(), 0)

all_digits(cs: str[], i: int) -> bool {
    if i >= cs.length() {
        true
    } else if !cs.get(i).is_ascii_digit() {
        false
    } else {
        all_digits(cs, i + 1)
    }
}

ver_cmp(a: Ver, b: Ver) -> int {
    if a.major != b.major {
        a.major < b.major ? -1 : 1
    } else if a.minor != b.minor {
        a.minor < b.minor ? -1 : 1
    } else if a.patch != b.patch {
        a.patch < b.patch ? -1 : 1
    } else {
        0
    }
}

/// Does a published version answer the range the manifest wrote, in the dialect npm speaks?
satisfies(version: str, range: str) -> bool {
    v = ver_of(version)

    v.ok && any_clause(v, range.split("||"), 0)
}

any_clause(v: Ver, clauses: str[], i: int) -> bool {
    if i >= clauses.length() {
        false
    } else if clause_holds(v, clauses.get(i).trim()) {
        true
    } else {
        any_clause(v, clauses, i + 1)
    }
}

clause_holds(v: Ver, clause: str) -> bool =>
    clause == "" || clause == "*"
        || every_part(v, nonempty(clause.split(" "), 0, []), 0)

every_part(v: Ver, parts: str[], i: int) -> bool {
    if i >= parts.length() {
        true
    } else if !comparator(v, parts.get(i)) {
        false
    } else {
        every_part(v, parts, i + 1)
    }
}

comparator(v: Ver, part: str) -> bool {
    c = part.trim()

    if c.starts_with("^") {
        caret(v, ver_of(c.slice(1, c.length())))
    } else if c.starts_with("~") {
        tilde(v, ver_of(c.slice(1, c.length())))
    } else if c.starts_with(">=") || c.starts_with("<=") {
        cmp_op(v, c.slice(2, c.length()), c.slice(0, 2))
    } else if c.starts_with(">") || c.starts_with("<") || c.starts_with("=") {
        cmp_op(v, c.slice(1, c.length()), c.slice(0, 1))
    } else if c == "*" || c == "x" {
        true
    } else if c.index_of("x") >= 0 || c.index_of("*") >= 0 {
        wild(v, c.split("."))
    } else {
        exact_ver(v, ver_of(c))
    }
}

caret(v: Ver, lo: Ver) -> bool =>
    lo.ok && ver_cmp(v, lo) >= 0 && ver_cmp(v, caret_hi(lo)) < 0

/// `^0.9.1` allows 0.9.x and `^1.2.3` allows 1.x, because before 1.0.0 a minor is a breaking change.
caret_hi(lo: Ver) -> Ver {
    if lo.major > 0 {
        Ver { major = lo.major + 1, minor = 0, patch = 0, ok = true }
    } else if lo.minor > 0 {
        Ver { major = 0, minor = lo.minor + 1, patch = 0, ok = true }
    } else {
        Ver { major = 0, minor = 0, patch = lo.patch + 1, ok = true }
    }
}

tilde(v: Ver, lo: Ver) -> bool =>
    lo.ok && ver_cmp(v, lo) >= 0
        && ver_cmp(v, Ver { major = lo.major, minor = lo.minor + 1,
                            patch = 0, ok = true }) < 0

cmp_op(v: Ver, text: str, op: str) -> bool {
    w = ver_of(text)

    if !w.ok {
        false
    } else if op == ">=" {
        ver_cmp(v, w) >= 0
    } else if op == "<=" {
        ver_cmp(v, w) <= 0
    } else if op == ">" {
        ver_cmp(v, w) > 0
    } else if op == "<" {
        ver_cmp(v, w) < 0
    } else {
        ver_cmp(v, w) == 0
    }
}

exact_ver(v: Ver, w: Ver) -> bool =>
    w.ok && ver_cmp(v, w) == 0

wild(v: Ver, parts: str[]) -> bool =>
    wild_part(parts.get(0), v.major)
        && (parts.length() < 2 || wild_part(parts.get(1), v.minor))

wild_part(part: str, have: int) -> bool =>
    part == "x" || part == "*" || (digits(part) && int(part) == have)

/// The maca registry, which `[registry] url` in the manifest replaces.
registry_url() -> str {
    named = toml_value(read_file(Manifest), "[registry]", "url")

    named == "" ? MacaRegistry : named
}

resolve_dep(s: Spec, registry: str) -> Pin {
    if s.kind == "git" {
        git_pin(s)
    } else if s.kind == "npm" {
        registry_pin(NpmRegistry, s.pkg, s.req)
    } else {
        registry_pin(registry, s.pkg, s.req)
    }
}

git_pin(s: Spec) -> Pin {
    want = s.req == "" ? "HEAD" : s.req
    sha = first_sha(capture("git", ["ls-remote", s.pkg, want]))

    if sha == "" {
        failed("no ref `{want}` in {s.pkg}")
    } else {
        Pin { version = s.req == "" ? sha.slice(0, 12) : s.req, tarball = "",
              integrity = "", commit = sha, why = "" }
    }
}

first_sha(out: str) -> str {
    t = out.trim()
    tab = t.index_of("\t")

    tab < 0 ? t : t.slice(0, tab)
}

/// A tag or an exact version is one small document; a range is answered by `latest` alone, because the whole packument is more than this reads.
registry_pin(base: str, pkg: str, req: str) -> Pin {
    tag = req == "" ? "latest" : req
    ranged = tag != "latest" && !ver_of(tag).ok
    asked = ranged ? "latest" : tag
    p = pin_of(http_get("{base}/{pkg}/{asked}"))

    if p.version == "" {
        failed("no `{tag}` of `{pkg}` at {base}")
    } else if !ranged || satisfies(p.version, req) {
        p
    } else {
        failed("the newest `{pkg}` is {p.version}, which does not satisfy "
               ++ "`{req}`; name a version this registry publishes")
    }
}

pin_of(doc: str) -> Pin =>
    Pin { version = json_str(doc, "version"), tarball = json_str(doc, "tarball"),
          integrity = json_str(doc, "integrity"), commit = "", why = "" }

http_get(url: str) -> str =>
    capture("curl", ["-fsSL", "-A", "maca-cli", url])

failed(why: str) -> Pin =>
    Pin { version = "", tarball = "", integrity = "", commit = "", why = why }

unpinned() -> Pin =>
    failed("")

fetch(s: Spec, p: Pin) -> str {
    dir = "{DepsDir}/{s.name}"

    remove_dir(dir)
    make_dir(dir)

    if s.kind == "git" {
        git_into(s.pkg, p.commit, dir)
    } else if p.tarball == "" {
        "the registry named no tarball for `{s.name}`"
    } else {
        tgz_into(p.tarball, p.integrity, dir)
    }
}

git_into(url: str, sha: str, dir: str) -> str {
    if exec("git", ["clone", "--quiet", url, dir]) != 0 {
        "git clone {url} failed"
    } else if sha != "" && exec("git", ["-C", dir, "checkout", "--quiet",
                                        sha]) != 0 {
        "git checkout {sha} failed"
    } else {
        remove_dir("{dir}/.git")

        ""
    }
}

/// An npm tarball wraps everything in `package/`, which is the directory level `--strip-components` drops.
tgz_into(url: str, integrity: str, dir: str) -> str {
    tgz = "{dir}/.pkg.tgz"

    if exec("curl", ["-fsSL", "-o", tgz, url]) != 0 {
        "download failed: {url}"
    } else {
        unpacked(tgz, integrity, dir)
    }
}

unpacked(tgz: str, integrity: str, dir: str) -> str {
    why = integrity == "" ? "" : mismatch(tgz, integrity)

    if why != "" {
        remove_file(tgz)

        why
    } else if exec("tar", ["-xzf", tgz, "-C", dir,
                           "--strip-components=1"]) != 0 {
        "cannot unpack {tgz}"
    } else {
        remove_file(tgz)

        ""
    }
}

/// What `integrity` in the lockfile promises about the bytes, checked before anything is unpacked.
mismatch(file: str, want: str) -> str {
    if !want.starts_with("sha512-") {
        "integrity `{want}` is not a sha512 digest; delete {LockFile} to "
            ++ "re-resolve"
    } else {
        digested(file, want.slice(7, want.length()))
    }
}

digested(file: str, want: str) -> str {
    got = digest_of(file)
    hex = hex_of(want)

    if got == "" {
        "cannot take a sha512 of {file}; is sha512sum, shasum or openssl there?"
    } else if hex == "" {
        "the integrity `sha512-{want}` in {LockFile} is not base64"
    } else if got == hex {
        ""
    } else {
        "the download does not match what {LockFile} pinned\n"
            ++ "  expected sha512 {hex}\n  got      sha512 {got}"
    }
}

/// A sha512 in hex, out of whichever of the three tools this machine has.
digest_of(file: str) -> str {
    tools = "if command -v sha512sum >/dev/null; then sha512sum -b \"$0\";"
        ++ " elif command -v shasum >/dev/null; then shasum -a 512 -b \"$0\";"
        ++ " else openssl dgst -sha512 -r \"$0\"; fi"

    capture("sh", ["-c", "{tools} | cut -d\" \" -f1", file]).trim()
}

/// The base64 digest the lock wrote, in the hex those tools print.
hex_of(b64: str) -> str =>
    capture("sh", ["-c", "printf %s \"$0\" | base64 -d 2>/dev/null"
                             ++ " | od -An -tx1 | tr -d \"[:space:]\"",
                   b64]).trim()

/// Every `name = "spec"` under `[dependencies]`, which is what `install` and `update` are about.
manifest_deps() -> Dep[] {
    lines = read_file(Manifest).split("\n")
    at = table_at(lines, 0, "[dependencies]")

    at < 0 ? [] : deps_in(lines, at + 1, block_end(lines, at + 1), [])
}

deps_in(lines: str[], i: int, end: int, acc: Dep[]) -> Dep[] {
    if i >= end {
        acc
    } else if toml_key(lines.get(i)) == "" || toml_val(lines.get(i)) == "" {
        deps_in(lines, i + 1, end, acc)
    } else {
        deps_in(lines, i + 1, end,
                acc ++ [Dep { name = toml_key(lines.get(i)),
                              spec = toml_val(lines.get(i)) }])
    }
}

/// Insert or replace one `name = "spec"` inside `[dependencies]`, writing the table when it is not there yet.
manifest_put(name: str, spec: str) -> bool {
    lines = read_file(Manifest).split("\n")

    write_file(Manifest,
               put_line(lines, name, "{name} = \"{spec}\"").join("\n"))
}

put_line(lines: str[], name: str, line: str) -> str[] {
    at = table_at(lines, 0, "[dependencies]")

    if at < 0 {
        started(lines) ++ ["[dependencies]", line, ""]
    } else {
        replaced_line(lines, at + 1, name, line)
    }
}

started(lines: str[]) -> str[] {
    n = lines.length()

    n > 0 && lines.get(n - 1).trim() == "" ? lines.slice(0, n - 1) : lines
}

replaced_line(lines: str[], from: int, name: str, line: str) -> str[] {
    end = tight_end(lines, from, block_end(lines, from))
    hit = key_at(lines, from, end, name)
    cut = hit < 0 ? end : hit
    past = hit < 0 ? end : hit + 1

    lines.slice(0, cut) ++ [line] ++ lines.slice(past, lines.length())
}

table_at(lines: str[], i: int, table: str) -> int {
    if i >= lines.length() {
        -1
    } else if toml_head(lines.get(i)) == table {
        i
    } else {
        table_at(lines, i + 1, table)
    }
}

block_end(lines: str[], i: int) -> int {
    if i >= lines.length() {
        lines.length()
    } else if toml_head(lines.get(i)) != "" {
        i
    } else {
        block_end(lines, i + 1)
    }
}

/// A blank line before the next table belongs to the file rather than to the table, so a new key lands above it.
tight_end(lines: str[], from: int, end: int) -> int {
    if end <= from || lines.get(end - 1).trim() != "" {
        end
    } else {
        tight_end(lines, from, end - 1)
    }
}

key_at(lines: str[], i: int, end: int, name: str) -> int {
    if i >= end {
        -1
    } else if toml_key(lines.get(i)) == name {
        i
    } else {
        key_at(lines, i + 1, end, name)
    }
}

lock_read() -> Pkg[] =>
    lock_lines(read_file(LockFile).split("\n"), 0, "", "", [])

lock_lines(lines: str[], i: int, name: str, block: str, acc: Pkg[]) -> Pkg[] {
    if i >= lines.length() {
        flushed(acc, name, block)
    } else if toml_head(lines.get(i)) == "[[package]]" {
        lock_lines(lines, i + 1, "", "", flushed(acc, name, block))
    } else if noise(lines.get(i)) {
        lock_lines(lines, i + 1, name, block, acc)
    } else {
        lock_lines(lines, i + 1, lock_name(lines.get(i), name),
                   block ++ lines.get(i).trim() ++ "\n", acc)
    }
}

flushed(acc: Pkg[], name: str, block: str) -> Pkg[] =>
    name == "" ? acc : acc ++ [Pkg { name = name, block = block }]

noise(line: str) -> bool {
    t = line.trim()

    t == "" || t.starts_with("#")
}

lock_name(line: str, held: str) -> str =>
    toml_key(line) == "name" ? toml_val(line) : held

/// What the lock pinned for one dependency, and only while it still answers the request the manifest makes.
pinned(entries: Pkg[], name: str, spec: str) -> Pin {
    at = pkg_at(entries, name, 0)
    block = at < 0 ? "" : entries.get(at).block

    if toml_value(block, "", "request") != spec {
        unpinned()
    } else {
        Pin { version = toml_value(block, "", "version"),
              tarball = toml_value(block, "", "resolved"),
              integrity = toml_value(block, "", "integrity"),
              commit = toml_value(block, "", "commit"), why = "" }
    }
}

pkg_at(entries: Pkg[], name: str, i: int) -> int {
    if i >= entries.length() {
        -1
    } else if entries.get(i).name == name {
        i
    } else {
        pkg_at(entries, name, i + 1)
    }
}

lock_put(s: Spec, spec: str, p: Pin) -> bool {
    entry = Pkg { name = s.name, block = lock_block(s, spec, p) }

    write_file(LockFile,
               lock_text(inserted(lock_read(), entry, 0, []), 0,
                         "# {LockFile}: generated by `maca add`/`maca update`;"
                             ++ " do not edit.\n"))
}

lock_block(s: Spec, spec: str, p: Pin) -> str =>
    "name = \"{s.name}\"\nversion = \"{p.version}\"\nrequest = \"{spec}\"\n"
        ++ "source = \"{lock_source(s)}\"\n"
        ++ lock_line("resolved", p.tarball)
        ++ lock_line("integrity", p.integrity)
        ++ lock_line("commit", p.commit)

lock_source(s: Spec) -> str {
    if s.kind == "npm" {
        "npm:{s.name}"
    } else if s.kind == "git" {
        "git+{s.pkg}"
    } else {
        "registry"
    }
}

lock_line(key: str, value: str) -> str =>
    value == "" ? "" : "{key} = \"{value}\"\n"

lock_text(entries: Pkg[], i: int, acc: str) -> str {
    if i >= entries.length() {
        acc
    } else {
        lock_text(entries, i + 1,
                  acc ++ "\n[[package]]\n" ++ entries.get(i).block)
    }
}

/// The lock stays sorted by name, so which dependency was added first is not a diff.
inserted(xs: Pkg[], p: Pkg, i: int, acc: Pkg[]) -> Pkg[] {
    if i >= xs.length() {
        acc ++ [p]
    } else if xs.get(i).name == p.name {
        inserted(xs, p, i + 1, acc)
    } else if xs.get(i).name > p.name {
        acc ++ [p] ++ xs.slice(i, xs.length())
    } else {
        inserted(xs, p, i + 1, acc ++ [xs.get(i)])
    }
}

demo() -> int {
    sample = "add(1) + 2 - 3"
    toks = lex(sample)
    info("scanned {toks.length()} tokens from {sample.length()} chars")
    tree = parse_expr(toks, 0)
    info("parsed: {show(tree.node)}")
    prec = parse_expr(lex("2 + 3 * 4"), 0)
    info("precedence: {show(prec.node)}")
    info("checked: type {type_of(tree.node)}, {count_errors(tree.node)} errors")
    info("emitted: {emit_unit(tree.node)}")

    bad = e_binary("+", e_str("hi"), e_int(1))
    info("checked: {show(bad)} → type {type_of(bad)}, {count_errors(bad)} errors")

    fnsrc = "add(x: int, y: int) -> int => x + y"
    fst = parse_fn(lex(fnsrc), 0)
    info("fn: {emit_fn(fst.snode)}")

    prog = "inc(n: int) -> int => n + 1 dbl(n: int) -> int => n * 2"
    mod = parse_module(lex(prog), 0, [])
    info("module ({mod.items.length()} fns):")
    info(emit_module(mod))

    prog2 = "ok() -> int => 1 + 2 bad() -> int => 1 + \"x\""
    mod2 = parse_module(lex(prog2), 0, [])
    info("module check: {check_module(mod2)} type errors")

    blk = "sq(n: int) -> int {{ t = n * n t }}"
    bfn = parse_fn(lex(blk), 0)
    info("block fn: {emit_fn(bfn.snode)}")

    two = parse_expr(lex("add(1, 2)"), 0)
    info("multi-arg: {show(two.node)}")

    tern = parse_expr(lex("a > b ? a : b"), 0)
    info("ternary: {show(tern.node)}")

    neg = parse_expr(lex("0 - -n"), 0)
    info("unary: {show(neg.node)}")

    md = parse_expr(lex("a % b + 1"), 0)
    info("modulo: {show(md.node)}")

    logic = parse_expr(lex("a < b && c || d"), 0)
    info("logic: {show(logic.node)}")

    sig = parse_fn(lex("tag(s: str, n: int) -> int => n"), 0)
    info("typed sig C:    {emit_fn(sig.snode)}")
    info("typed sig Rust: {remit_fn(sig.snode)}")

    bo = parse_fn(lex("flag() -> bool => true"), 0)
    info("bool fn C:    {emit_fn(bo.snode)}")
    info("bool fn Rust: {remit_fn(bo.snode)}")

    ffn = parse_fn(lex("scale(x: float) -> float => x * 2.0"), 0)
    info("float fn C:    {emit_fn(ffn.snode)}")
    info("float fn Rust: {remit_fn(ffn.snode)}")

    rec = parse_module(lex("Point = {{ x: int, y: int }} sum(p: Point) -> int => p.x + p.y"), 0, [])
    info("record C:    {emit_module(rec)}")
    info("record Rust: {remit_module(rec)}")

    su = parse_module(lex("Color = Red | Green | Blue rank(c: Color) -> int => c == Green ? 42 : 0"), 0, [])
    info("sum C:    {emit_module(su)}")
    info("sum Rust: {remit_module(su)}")

    mt = parse_fn(lex("code(c: Color) -> int => match c {{ Red => 1 Green => 42 Blue => 3 }}"), 0)
    info("match C:    {emit_fn(mt.snode)}")
    info("match Rust: {remit_fn(mt.snode)}")

    se = parse_fn(lex("kw(w: str) -> int => w == \"let\" ? 1 : 0"), 0)
    info("streq C:    {emit_fn(se.snode)}")
    info("streq Rust: {remit_fn(se.snode)}")

    ip = parse_fn(lex("label(n: int) -> str => \"n = \{n\}!\""), 0)
    info("interp C:    {emit_fn(ip.snode)}")
    info("interp Rust: {remit_fn(ip.snode)}")

    ip2 = parse_expr(lex("\"sum \{a + b\} done\""), 0)
    info("interp expr: {show(ip2.node)}")

    info("check arity: {check_module(parse_module(lex("add(a: int, b: int) -> int => a + b use() -> int => add(1)"), 0, []))}")
    info("check return: {check_module(parse_module(lex("bad() -> str => 1 + 2"), 0, []))}")
    info("check calls: {check_module(parse_module(lex("n() -> int => 1 s() -> str => \"a\" mix() -> int => s() + 1"), 0, []))}")
    info("check clean: {check_module(parse_module(lex("add(a: int, b: int) -> int => a + b use() -> int => add(1, 2)"), 0, []))}")

    sm = parse_module(lex("Shape = Circle(int) | Rect(int, int)"), 0, [])
    info("payload C:    {emit_module(sm)}")
    info("payload Rust: {remit_module(sm)}")

    ar = parse_fn(lex("area(s: Shape) -> int => match s {{ Circle(r) => r * r Rect(w, h) => w * h }}"), 0)
    info("bind C:    {emit_fn(ar.snode)}")
    info("bind Rust: {remit_fn(ar.snode)}")

    cc = parse_fn(lex("wrap(s: str) -> str => \"[\" ++ s ++ \"]\""), 0)
    info("concat C:    {emit_fn(cc.snode)}")
    info("concat Rust: {remit_fn(cc.snode)}")

    st = parse_fn(lex("numbered(n: int) -> str => \"#\" ++ str(n)"), 0)
    info("str C:    {emit_fn(st.snode)}")
    info("str Rust: {remit_fn(st.snode)}")

    lm = parse_fn(lex("slen(s: str) -> int => s.length()"), 0)
    info("method C:    {emit_fn(lm.snode)}")
    info("method Rust: {remit_fn(lm.snode)}")

    at = parse_fn(lex("first(s: str) -> int => s.at(0)"), 0)
    info("at C:    {emit_fn(at.snode)}")
    info("at Rust: {remit_fn(at.snode)}")

    arr = parse_fn(lex("total(xs: int[]) -> int => xs.get(0) + xs.get(1) + xs.count()"), 0)
    info("array C:    {emit_fn(arr.snode)}")
    info("array Rust: {remit_fn(arr.snode)}")

    real = "import std/str import maca/token Kind = TInt | TStr classify(k: Kind) -> int => match k {{ TInt => 1 TStr => 2 }}"
    rm = parse_module(lex(real), 0, [])
    info("real file: {rm.items.length()} items after skipping imports")

    program = "Point = {{ x: int, y: int }} Color = Red | Green | Blue fld(p: Point) -> int => p.x code(c: Color) -> int => match c {{ Red => 1 Green => 2 Blue => 3 }} Shape = Circle(int) | Rect(int, int) area(sh: Shape) -> int => match sh {{ Circle(r) => r * r Rect(w, h) => w * h }} hi(a: str, b: str) -> int => (a ++ b) == \"hello\" ? 1 : 0 chk(n: int) -> int => (\"v\" ++ str(n)) == \"v42\" ? 1 : 0 slen(s: str) -> int => s.length() head(xs: int[]) -> int => xs.get(0) el(s: str) -> int => div(class = \"w\", s).length() == 22 ? 1 : 0 main() -> int {{ q = Point {{ x = 40, y = 9 }} ys = [1, 99] info(\"self-hosted!\") (fld(q) + code(Green)) * hi(\"hel\", \"lo\") * chk(42) * slen(\"z\") * head(ys) * area(Rect(1, 1)) * el(\"x\") }}"
    prog_mod = annotated(parse_module(lex(program), 0, []))
    info("=== emitted program ===")
    info(emit_module(prog_mod))
    info("=== end program ===")

    info("=== emitted rust ===")
    info(remit_module(prog_mod))
    info("=== end rust ===")
    0
}
