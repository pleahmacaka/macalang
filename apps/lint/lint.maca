import { command, rest } from cli/spec
import { parse, from } from cli/parse
import { help } from cli/help
import { bad } from cli/style
import { lint } from lint/rules

Spec = command("lint", "Maca's style rules, over a file or a whole tree")
    .rest("path", "what to lint (the repository's own sources by default)")

main(argv: str[]) -> int {
    got = parse(Spec, argv)

    if got.wants_help {
        info(help(Spec))
        0
    } else if got.error != "" {
        err(bad(got.error))
        1
    } else {
        lint(from(got, 0))
    }
}
