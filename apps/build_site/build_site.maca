import { conf_value } from apps/tomo/conf
import std/proc
import std/fs
import std/path
import std/list
import std/text
import { command, rest } from cli/spec
import { parse, from } from cli/parse
import { help } from cli/help
import { bold, dim, grey, ok, bad } from cli/style

maca() -> str =>
    env_or("MACA", "target/release/maca")

OutDefault = "_site"

Spec = command("build-site", "build and check the published site")
    .rest("outdir", "where to assemble the site ({OutDefault} by default)")

main(argv: str[]) -> int {
    got = parse(Spec, argv)
    where = from(got, 0)

    if got.wants_help {
        info(help(Spec))
        0
    } else if got.error != "" {
        err(bad(got.error))
        1
    } else if where.length() > 1 {
        err(bad("build-site assembles one directory, got " +
                where.join(", ")))
        1
    } else if !file_exists(maca()) {
        err(bad("no maca at {maca()}: cc -O1 -o bootstrap/maca bootstrap/maca.c"))
        1
    } else {
        build(where.length() == 0 ? OutDefault : where.get(0))
    }
}

build(out: str) -> int {
    build_handbook()
    announce("fonts")
    install_fonts("apps/tomo/site")
    build_front_page()
    build_api_reference()
    build_playground()
    assemble(out)
    check(out)
}

announce(what: str) -> bool {
    err(grey("==>") + " " + bold(what))
    true
}

build_handbook() -> bool {
    announce("handbook")
    run(maca(), ["run", "apps/tomo/tomo.maca"])
}

install_fonts(into: str) -> bool =>
    copy_tree("apps/tomo/fonts", join(into, "fonts")) > 0

build_front_page() -> bool {
    announce("front page")
    drop_landings(landing_pages(), 0)
    run(maca(), ["run", "apps/site/home.maca", "apps/tomo/site"])
}

landing_pages() -> str[] =>
    ["apps/tomo/site/index.html"] +
        book_languages().map(c => "apps/tomo/site/" + c + "/home.html")

book_languages() -> str[] {
    toml = read_file("apps/tomo/book.toml")
    codes = conf_value(toml, "languages").split(",").map(c => c.trim())
        .filter(c => c != "")

    if codes.length() == 0 {
        fail "apps/tomo/book.toml declares no `languages = [...]`"
    } else {
        codes
    }
}

drop_landings(paths: str[], i: int) -> bool {
    if i >= paths.length() {
        true
    } else {
        remove_file(paths.get(i))
        drop_landings(paths, i + 1)
    }
}

std_modules() -> str[] =>
    module_paths(read_lines("modules/std/README.md"), 0, [])

module_paths(ls: str[], i: int, acc: str[]) -> str[] {
    if i >= ls.length() {
        acc
    } else if ls.get(i).starts_with("| `std/") {
        name = between(ls.get(i), "| `std/", "`")
        module_paths(ls, i + 1, acc.push("modules/std/" + name + ".maca"))
    } else {
        module_paths(ls, i + 1, acc)
    }
}

build_api_reference() -> bool {
    announce("api reference")
    run(maca(), ["run", "apps/macadoc/macadoc.maca", "apps/tomo/site/api"] +
              std_modules())
}

/** The compiler as `apps/playground` reaches it, which an absolute path already
 * is.
 */
from_playground(bin: str) -> str =>
    bin.starts_with("/") ? bin : "../../" + bin

build_playground() -> bool {
    announce("playground")
    run_in("apps/playground", from_playground(maca()),
           ["build", "--target", "js", "playground.maca", "-o", "out"])
}

assemble(out: str) -> bool {
    announce("assembling " + dim(out))
    remove_dir(out)
    make_dir(out)
    copy_tree("apps/tomo/site", out)
    copy_tree("apps/playground/out", join(out, "play"))
    copy_bytes("llms.txt", join(out, "llms.txt"))
    copy_bytes("apps/site/install.sh", join(out, "install"))
    copy_bytes("apps/site/install.ps1", join(out, "install.ps1"))

    write_file(join(out, ".nojekyll"), "")
}

check(out: str) -> int {
    announce("checking")

    require_pages(out)
    default_lang = book_languages().get(0)
    chapters = find(join(out, default_lang), ".html").length()

    if chapters < 20 {
        fail "only {chapters} pages in {default_lang}"
    }

    require_root_links(out)
    require_embedded_wasm(out)
    require_fonts(out)
    require_llms_txt(out)
    require_live_css(out)

    info(ok("{chapters} {default_lang} pages," +
            " {tree_size(out) / 1024} KiB total"))
    0
}

require_live_css(out: str) -> bool {
    pages = find(out, ".html")
    dead = str_unique(dead_in_pages(pages, 0, []))

    if dead.length() > 0 {
        named = dead.join(", ")
        fail "{dead.length()} classes with no CSS rule: {named}"
    } else {
        info(ok("every utility on {pages.length()} pages has a rule"))
        true
    }
}

dead_in_pages(pages: str[], i: int, acc: str[]) -> str[] {
    if i >= pages.length() {
        acc
    } else {
        dead_in_pages(pages, i + 1, acc + dead_in_page(pages.get(i)))
    }
}

dead_in_page(path: str) -> str[] {
    src = read_file(path)
    sheet = stylesheets(src, 0, "")

    if sheet == "" {
        []
    } else {
        unruled(classes_in(src), 0, sheet, [])
    }
}

stylesheets(src: str, at: int, acc: str) -> str {
    rest = src.slice(at, src.length())
    open = rest.index_of("<style")

    if open < 0 {
        acc
    } else {
        body = between(rest.slice(open, rest.length()), ">", "</style>")
        stylesheets(src, at + open + 6, acc + body)
    }
}

unruled(cs: str[], i: int, sheet: str, acc: str[]) -> str[] {
    if i >= cs.length() {
        acc
    } else if has_rule(sheet, cs.get(i)) {
        unruled(cs, i + 1, sheet, acc)
    } else {
        unruled(cs, i + 1, sheet, acc.push(cs.get(i)))
    }
}

has_rule(sheet: str, class: str) -> bool {
    sel = "." + css_escape(class)

    class.starts_with("language-") || sheet.contains(sel + " ")
        || sheet.contains(sel + ":") || sheet.contains(sel + "[")
}

css_escape(class: str) -> str =>
    escape_chars(class.chars(), 0, "")

escape_chars(cs: str[], i: int, out: str) -> str {
    if i >= cs.length() {
        out
    } else if needs_escape(cs.get(i)) {
        escape_chars(cs, i + 1, out + "\\" + cs.get(i))
    } else {
        escape_chars(cs, i + 1, out + cs.get(i))
    }
}

needs_escape(c: str) -> bool =>
    "/.:[]()," .contains(c) || "#%'\"!$&*+;<=>?@^`\{|\}~".contains(c)

/** Every class named on the page, which is what the stylesheet has to answer
 * for.
 *
 * A class attribute that ends in a space splits into an empty token, and an
 * empty token has no rule, so the gate used to fail while naming nothing.
 */
classes_in(src: str) -> str[] =>
    str_unique(str_flatten(attr_values(without_scripts(src))
                               .map(v => v.split(" "))))
        .filter(c => c.trim().length() > 0)

attr_values(src: str) -> str[] =>
    tag_classes(src.split("<"), 0, [])

tag_classes(frags: str[], i: int, acc: str[]) -> str[] {
    if i >= frags.length() {
        acc
    } else {
        tag_classes(frags, i + 1, acc + class_in_tag(frags.get(i)))
    }
}

class_in_tag(frag: str) -> str[] {
    end = frag.index_of(">")

    if end < 0 {
        []
    } else {
        class_of(frag.slice(0, end))
    }
}

class_of(tag: str) -> str[] {
    at = tag.index_of(" class=\"")

    if at < 0 {
        []
    } else {
        [split_once(tag.slice(at + 8, tag.length()), "\"").get(0)]
    }
}

without_scripts(src: str) -> str =>
    drop_blocks(src, "<script", "</script>", "")

drop_blocks(src: str, open: str, close: str, out: str) -> str {
    at = src.index_of(open)

    if at < 0 {
        out + src
    } else {
        rest = src.slice(at, src.length())
        end = rest.index_of(close)

        if end < 0 {
            out + src.slice(0, at)
        } else {
            drop_blocks(src.slice(at + end + close.length(), src.length()),
                        open, close, out + src.slice(0, at))
        }
    }
}

required_pages() -> str[] =>
    ["index.html", "en/index.html", "ko/index.html",
     "en/search-index.js", "ko/search-index.js", "play/index.html",
     "api/index.html"] + api_pages(std_modules(), 0, [])

api_pages(ms: str[], i: int, acc: str[]) -> str[] {
    if i >= ms.length() {
        acc
    } else {
        api_pages(ms, i + 1, acc.push("api/" + stem(ms.get(i)) + ".html"))
    }
}

require_pages(out: str) -> bool =>
    all_present(required_pages(), 0, out)

all_present(pages: str[], i: int, out: str) -> bool {
    if i >= pages.length() {
        true
    } else if file_size(join(out, pages.get(i))) <= 0 {
        fail "missing or empty: {pages.get(i)}"
    } else {
        all_present(pages, i + 1, out)
    }
}

require_root_links(out: str) -> bool {
    root = read_file(join(out, "index.html"))

    if !root.contains("href=\"en/index.html\"") {
        fail "root page doesn't link the handbook"
    } else if !root.contains("href=\"ko/home.html\"") {
        fail "root page doesn't offer the Korean landing"
    } else if !root.contains("href=\"play/index.html\"") {
        fail "root page doesn't link the playground"
    } else {
        true
    }
}

require_llms_txt(out: str) -> bool {
    served = join(out, "llms.txt")

    if file_size(served) != file_size("llms.txt") {
        fail "llms.txt is not served whole at the site root"
    } else {
        info(ok("llms.txt is at the site root, {file_size(served)} bytes"))
        true
    }
}

require_fonts(out: str) -> bool {
    sheet = join(out, "fonts/fonts.css")

    if file_size(sheet) <= 0 {
        fail "no fonts/fonts.css: every page links it"
    }

    css = read_file(sheet)
    mono = join(dirname(sheet), between(css, "src: url(./jetbrains-mono/", ")"))
    prose = join(dirname(sheet), between(css, "src: url(./pretendard-gov/", ")"))

    if file_size(join(dirname(sheet), "jetbrains-mono/" +
                      between(css, "url(./jetbrains-mono/", ")"))) <= 0 {
        fail "fonts.css names a mono file that is not there: {mono}"
    } else if file_size(join(dirname(sheet), "pretendard-gov/" +
                             between(css, "url(./pretendard-gov/", ")"))) <= 0 {
        fail "fonts.css names a prose file that is not there: {prose}"
    } else {
        info(ok("both families are served, and the first file each names is there"))
        true
    }
}

require_embedded_wasm(out: str) -> bool {
    size = file_size(join(out, "play/index.html"))

    if size <= 200000 {
        fail "playground is only {size} bytes. Lost its embedded wasm?"
    } else {
        true
    }
}
