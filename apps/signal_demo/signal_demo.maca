// signal_demo: a counter, a label derived from it, and the single node that
// each change touches.
//
//   maca run apps/signal_demo/signal_demo.maca
//
// This renders the page once and then prints the patch it *would* apply, which
// is what makes the wiring testable without a browser. The `js:` line is the
// call a browser would run against the same markup. Send it down however the
// page gets its updates, next to the runtime `runtime_script()` puts in the
// page. Do not reach for `--target js`: that backend drops an imported
// module's definitions without saying so, and the page loads and throws.
//
// The page has four bound-looking nodes: two bound to keys that change, one
// bound to `theme`, which does not, and one bound to nothing at all. Watch
// which of them the patches name.

import { store, set_num, num, computed, refresh, derived } from signal/store
import { clear_changed, set } from signal/store
import { text_node, class_node, patch, describe_all } from signal/dom
import { patch_script, runtime_script, static_note } from signal/dom

say(vs: str[]) -> str => "clicked {vs.get(0)} times"

page(s: Store) -> str =>
    div(
        runtime_script()
        h1("Signal demo")
        class_node(s, "section", "theme", "a counter")
        text_node(s, "span", "count")
        text_node(s, "p", "label")
        p("Bound to nothing, so no patch will ever name it.")
        static_note())

// Bring every computed up to date. `refresh` does nothing at all for one whose
// inputs stood still, so this is safe after any write at all; walking
// `derived()` rather than naming "label" here is what keeps it from needing an
// edit every time the page grows a computed. A page with more than one compute
// function dispatches on `k` inside the loop.
settle(s: Store) -> Store {
    out = s

    for k in s.derived() {
        out = out.refresh(k, say)
    }
    out
}

// One click: the atom moves, and everything derived from it follows.
tick(s: Store) -> Store =>
    settle(s.set_num("count", s.num("count", 0) + 1))

// What a browser would do, printed instead of done, and then the render queue
// emptied so the next change starts from nothing.
report(s: Store) -> Store {
    ops = patch(s)

    if ops.length() == 0 {
        info("  nothing to patch")
    } else {
        for line in describe_all(ops) {
            info("  " ++ line)
        }
        info("  js: " ++ patch_script(s))
    }

    s.clear_changed()
}

main() -> int {
    s = store().set_num("count", 0).set("theme", "panel")
    s = s.computed("label", ["count"]).refresh("label", say)

    info("--- the page, rendered once ---")
    info(page(s))
    s = s.clear_changed()

    info("")
    info("--- click: count 0 -> 1 ---")
    s = report(tick(s))

    info("")
    info("--- click: count 1 -> 2 ---")
    s = report(tick(s))

    info("")
    info("--- a write of the value the key already had ---")
    s = report(settle(s.set_num("count", s.num("count", 0))))

    0
}
