import { store, set_num, num, computed, refresh, derived } from signal/store
import { clear_changed, set } from signal/store
import { text_node, class_node, patch, describe_all } from signal/dom
import { patch_script, runtime_script, static_note } from signal/dom

say(vs: str[]) -> str => "clicked {vs.get(0)} times"

page(s: Store) -> str =>
    div(
        runtime_script()
        h1("Signal demo")
        class_node(s, "section", "theme", "a counter")
        text_node(s, "span", "count")
        text_node(s, "p", "label")
        p("Bound to nothing, so no patch will ever name it.")
        static_note())

settle(s: Store) -> Store {
    out = s

    for k in s.derived() {
        out = out.refresh(k, say)
    }
    out
}

tick(s: Store) -> Store =>
    settle(s.set_num("count", s.num("count", 0) + 1))

report(s: Store) -> Store {
    ops = patch(s)

    if ops.length() == 0 {
        info("  nothing to patch")
    } else {
        for line in describe_all(ops) {
            info("  " ++ line)
        }
        info("  js: " ++ patch_script(s))
    }

    s.clear_changed()
}

main() -> int {
    s = store().set_num("count", 0).set("theme", "panel")
    s = s.computed("label", ["count"]).refresh("label", say)

    info("--- the page, rendered once ---")
    info(page(s))
    s = s.clear_changed()

    info("")
    info("--- click: count 0 -> 1 ---")
    s = report(tick(s))

    info("")
    info("--- click: count 1 -> 2 ---")
    s = report(tick(s))

    info("")
    info("--- a write of the value the key already had ---")
    s = report(settle(s.set_num("count", s.num("count", 0))))

    0
}
