// profile_demo — a small program that measures itself.
//
//   maca run apps/profile_demo/profile_demo.maca
//
// It does three real pieces of work — builds a paragraph, sorts its words, and
// walks a directory tree — with a span around each, then prints the flame
// chart and the summary table and writes the trace out as JSON and SVG.
//
// The recorder is a value carried through the program. That is the whole
// convention: a function that wants to be measured takes it and gives it back.
// Where a function also has a result, the pair gets a name (`Scan` below),
// because Maca has no tuple and a second traversal to collect the same numbers
// would be measured too.

import profile/record
import profile/flame
import profile/report
import profile/play

Out = "/tmp/maca-profile-demo"

main() -> int {
    r = recorder("profile demo").start("everything")

    r = r.start("build text")
    prose = paragraph(1200, "")
    r = r.stop()

    r = r.start("sort words")
    r = r.start("split")
    tokens = prose.split(" ")
    r = r.stop()
    r = r.start("order")
    ranked = tokens.sort()
    r = r.stop()
    r = r.stop()

    r = r.mark("work done")

    found = scan(r, is_dir("modules") ? "modules" : ".")
    t = finish(found.rec.stop())

    info(flame(t, 74))
    // One span per directory means the full table is mostly names that cost
    // nothing. The eight heaviest are the report; the rest is the trace file.
    info(stats_table(summary(t).slice(0, 8)))
    report_on(t, prose, ranked, found)
    0
}

report_on(t: Trace, prose: str, ranked: str[], found: Scan) {
    info("")
    counted = "{found.files} .maca files, {found.rows} lines"
    info("{ranked.length()} words, {prose.length()} bytes; " ++ counted)

    make_dir(Out)
    write_file(Out ++ "/trace.json", to_json(t))
    write_file(Out ++ "/flame.svg", flame_svg(t, 1000))
    back = from_json(read_file(Out ++ "/trace.json"))

    info("wrote {Out}/trace.json and {Out}/flame.svg")
    info("read back {span_count(back)} spans, {wall(back)}ms — same run")
    info("")
    info("the first four moments of it:")
    for line in narrate(t).slice(0, 4) {
        info("  " ++ line)
    }
}

// ---- the work being measured ----------------------------------------------

// Enough string building to take a measurable number of milliseconds. Each
// step concatenates onto the whole paragraph, so the cost grows with it —
// which is exactly the shape a profile is supposed to make visible.
paragraph(n: int, acc: str) -> str {
    if n <= 0 {
        acc
    } else {
        paragraph(n - 1, acc ++ "the quick brown fox jumps over {n} lazy dogs ")
    }
}

/// What a walk of one directory found, and the recorder that watched it.
Scan = {
    rec: Rec,
    files: int,
    bytes: int,
    rows: int,
}

// One span per directory, nested the way the tree is. The span is named for
// the directory's own segment rather than its whole path: a chart labelled
// with `modules/profile/tests` in every bar has no room left for the numbers.
scan(r: Rec, dir: str) -> Scan {
    opened = r.start(last_segment(dir))
    walked = scan_entries(opened, dir, list_dir(dir), 0, 0, 0, 0)

    walked with { rec = walked.rec.stop() }
}

scan_entries(r: Rec, dir: str, names: str[], i: int, files: int,
             bytes: int, rows: int) -> Scan {
    if i >= names.length() {
        Scan { rec = r, files = files, bytes = bytes, rows = rows }
    } else {
        got = scan_one(r, dir ++ "/" ++ names.get(i))

        scan_entries(got.rec, dir, names, i + 1, files + got.files,
                     bytes + got.bytes, rows + got.rows)
    }
}

scan_one(r: Rec, path: str) -> Scan {
    if is_dir(path) {
        scan(r, path)
    } else if path.ends_with(".maca") {
        Scan {
            rec = r,
            files = 1,
            bytes = file_size(path),
            rows = read_file(path).split("\n").length(),
        }
    } else {
        Scan { rec = r, files = 0, bytes = 0, rows = 0 }
    }
}

last_segment(path: str) -> str {
    parts = path.split("/")

    parts.get(parts.length() - 1)
}
