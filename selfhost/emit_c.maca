// selfhost/emit_c — a C emitter over the AST, written in Maca.
//
// Turns an `Expr` into C source, mirroring the stage-0 C backend on the slice
// the stage-1 parser covers: integer/string literals, idents, calls, and
// binary operators. This is the back end of the self-hosted pipeline — with
// lexer + parser + checker in front of it, `emit_c` closes lex → parse → check
// → emit, all in Maca. It grows into the full `maca-backend-c` port.

import selfhost/token
import selfhost/ast

// A double-quoted C string literal for `s` (kept out of interpolation so the
// quoting stays legible).
quoted(s: str) -> str =>
    "\"" ++ s ++ "\""

// Emit a C expression for one AST node.
emit_expr(e: Expr) -> str =>
    match e.kind {
        EInt    => str(e.ival)
        EFloat  => e.text
        EStr    => quoted(e.text)
        EBool   => e.text == "true" ? "1" : "0"
        EIdent  => e.text
        ECall   => emit_call(e)
        EBinary => emit_binary(e)
        ETernary => "({emit_expr(e.children.get(0))} ? {emit_expr(e.children.get(1))} : {emit_expr(e.children.get(2))})"
        EUnary  => "({e.text}{emit_expr(e.children.get(0))})"
        ERecord => "({e.text}){{ {emit_lit_fields(e.children, 0)} }}"
        EField  => "{emit_expr(e.children.get(0))}.{e.text}"
        EMatch  => emit_match(e)
        EMethod => emit_method(e)
        _       => "0"
    }

// A UFCS method call. `.length()` on a string is `strlen`; any other method
// falls back to C member-call syntax (valid only where the receiver truly has
// it — the runtime for lists/strings grows here).
emit_method(e: Expr) -> str =>
    e.text == "length"
        ? "((int)strlen({emit_expr(e.children.get(0))}))"
        : e.text == "at"
            ? "((int){emit_expr(e.children.get(0))}[{emit_expr(e.children.get(1))}])"
            : "{emit_expr(e.children.get(0))}.{e.text}({emit_args(e.children, 1)})"

// A call. `info`/`print` are the output builtins — a string argument prints
// with a trailing newline (`info`) or without (`print`); every other call is a
// plain `name(args)`.
emit_call(e: Expr) -> str =>
    e.text == "info"
        ? "printf(\"%s\\n\", {emit_args(e.children, 0)})"
        : e.text == "print"
            ? "printf(\"%s\", {emit_args(e.children, 0)})"
            : e.text == "str"
                ? "maca_int_to_str({emit_args(e.children, 0)})"
                : "{e.text}({emit_args(e.children, 0)})"

// A binary operator. `++` is string concatenation (→ the `maca_cat` runtime
// helper); `==`/`!=` with a string operand goes through `strcmp` (C `==` on
// `char*` compares pointers); every other operator is emitted directly.
emit_binary(e: Expr) -> str {
    l = e.children.get(0)
    r = e.children.get(1)
    is_str_eq = (e.text == "==" || e.text == "!=") && (l.kind == EStr || r.kind == EStr)
    e.text == "++"
        ? "maca_cat({emit_expr(l)}, {emit_expr(r)})"
        : is_str_eq
            ? "(strcmp({emit_expr(l)}, {emit_expr(r)}) {e.text} 0)"
            : "({emit_expr(l)} {e.text} {emit_expr(r)})"
}

// A `match` lowers to a right-nested ternary chain: `scrut == Pat ? body : …`.
// A `_` arm (or running out of arms) is the final else.
emit_match(e: Expr) -> str =>
    emit_arms(emit_expr(e.children.get(0)), e.children, 1)

emit_arms(scrut: str, cs: Expr[], i: int) -> str =>
    i + 1 >= cs.length()
        ? "0"
        : cs.get(i).text == "_"
            ? emit_expr(cs.get(i + 1))
            : "({scrut} == {cs.get(i).text} ? {emit_expr(cs.get(i + 1))} : {emit_arms(scrut, cs, i + 2)})"

// Designated initializers `.x = 40, .y = 2` for a C compound literal. Each field
// rides as an `EBinary("=", EIdent(name), value)`.
emit_lit_fields(fs: Expr[], i: int) -> str =>
    i >= fs.length()
        ? ""
        : i == fs.length() - 1
            ? ".{fs.get(i).children.get(0).text} = {emit_expr(fs.get(i).children.get(1))}"
            : ".{fs.get(i).children.get(0).text} = {emit_expr(fs.get(i).children.get(1))}, {emit_lit_fields(fs, i + 1)}"

// Comma-join the emitted arguments from index `i` on.
emit_args(xs: Expr[], i: int) -> str =>
    i >= xs.length()
        ? ""
        : i == xs.length() - 1
            ? emit_expr(xs.get(i))
            : "{emit_expr(xs.get(i))}, {emit_args(xs, i + 1)}"

// A whole translation unit: a `main` that returns the expression's value.
// (Literal C braces are written `{{`/`}}` so they aren't read as Maca string
// interpolation.)
emit_unit(e: Expr) -> str =>
    "int main(void) {{ return {emit_expr(e)}; }}"

// ---- function emission ----------------------------------------------------

// Map a Maca type name to its C spelling. Scalars map directly (`bool` needs no
// <stdbool.h> here, so it stays `int`); an empty type defaults to `int`; any
// other name is a user type (record or sum), emitted verbatim because it is
// `typedef`'d, so no `struct`/`enum` keyword is needed at the use site.
type_c(ty: str) -> str =>
    ty == "float"
        ? "double"
        : ty == "str"
            ? "const char*"
            : ty == "" || ty == "int" || ty == "bool"
                ? "int"
                : ty

// Emit a C function definition from an `SFn` statement. Parameter and return
// types come from the parsed signature (via `type_c`). The body is a statement
// sequence: bindings become locals and the final expression the `return`.
emit_fn(s: Stmt) -> str =>
    "{type_c(s.ret)} {s.name}({emit_params(s.params, 0)}) {{ {emit_stmts(s.body, 0)} }}"

// `int a, const char* b` from the typed parameter ident nodes.
emit_params(ps: Expr[], i: int) -> str =>
    i >= ps.length()
        ? ""
        : i == ps.length() - 1
            ? "{type_c(ps.get(i).ty)} {ps.get(i).text}"
            : "{type_c(ps.get(i).ty)} {ps.get(i).text}, {emit_params(ps, i + 1)}"

emit_stmts(body: Stmt[], i: int) -> str =>
    i >= body.length()
        ? ""
        : "{emit_stmt(body.get(i), i == body.length() - 1)} {emit_stmts(body, i + 1)}"

// The C type of a local binding, inferred from the value's shape — a string /
// float / bool literal picks its own type; anything else defaults to `int`.
// (Rust's `let` infers this on its own, so only C needs it.)
local_c_type(e: Expr) -> str =>
    match e.kind {
        EStr    => "const char*"
        EFloat  => "double"
        ERecord => e.text
        EBinary => e.text == "++" ? "const char*" : "int"
        _       => "int"
    }

// A binding is a local `<type> x = e;`; the last expression statement is the
// `return`, any earlier one is a bare expression statement.
emit_stmt(s: Stmt, is_last: bool) -> str =>
    s.kind == SBind
        ? "{local_c_type(s.value)} {s.name} = {emit_expr(s.value)};"
        : is_last
            ? "return {emit_expr(s.value)};"
            : "{emit_expr(s.value)};"

// A whole module: a preamble (headers plus the `maca_cat` string-concat helper
// that `++` lowers to), then record `struct` declarations and function
// definitions, one item per line (records appear first in source order, so a
// struct is declared before a function uses it).
c_preamble() -> str =>
    "#include <string.h>\n#include <stdlib.h>\n#include <stdio.h>\n" ++
    "static char* maca_cat(const char* a, const char* b) {{ char* r = malloc(strlen(a) + strlen(b) + 1); strcpy(r, a); strcat(r, b); return r; }}\n" ++
    "static char* maca_int_to_str(int n) {{ char* r = malloc(16); snprintf(r, 16, \"%d\", n); return r; }}\n"

emit_module(m: Module) -> str =>
    c_preamble() ++ emit_items(m.items, 0)

emit_items(items: Stmt[], i: int) -> str =>
    i >= items.length()
        ? ""
        : i == items.length() - 1
            ? emit_item(items.get(i))
            : "{emit_item(items.get(i))}\n{emit_items(items, i + 1)}"

emit_item(s: Stmt) -> str =>
    s.kind == SRecord
        ? emit_struct(s)
        : s.kind == SSum
            ? emit_sum(s)
            : emit_fn(s)

// `typedef struct { int x; int y; } Point;` from a record's typed fields — the
// typedef lets `Point` be used as a type name without the `struct` keyword.
emit_struct(s: Stmt) -> str =>
    "typedef struct {{ {emit_struct_fields(s.params, 0)} }} {s.name};"

emit_struct_fields(fs: Expr[], i: int) -> str =>
    i >= fs.length()
        ? ""
        : "{type_c(fs.get(i).ty)} {fs.get(i).text}; {emit_struct_fields(fs, i + 1)}"

// `typedef enum { Red, Green, Blue } Color;` from a nullary sum's variants.
emit_sum(s: Stmt) -> str =>
    "typedef enum {{ {emit_variants(s.params, 0)} }} {s.name};"

emit_variants(vs: Expr[], i: int) -> str =>
    i >= vs.length()
        ? ""
        : i == vs.length() - 1
            ? vs.get(i).text
            : "{vs.get(i).text}, {emit_variants(vs, i + 1)}"
