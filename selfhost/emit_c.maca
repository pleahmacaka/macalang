// selfhost/emit_c: a C emitter over the AST, written in Maca.
//
// The back end of the self-hosted pipeline: with lexer, parser and checker in
// front of it, this closes lex → parse → check → emit, all in Maca. It mirrors
// the stage-0 C backend over whatever the stage-1 parser can read, and grows
// into the full `maca-backend-c` port one construct at a time.
//
// Nothing here reports an error. A node it does not recognise emits `0`, which
// is wrong but compiles. Stage-0 is what rejects a program, and a second
// diagnostic here would only be a second thing to keep in agreement.

import selfhost/token
import selfhost/ast

// Concatenated rather than interpolated: `"\"{s}\""` is three escapes deep and
// unreadable at the point where the quoting is what matters.
quoted(s: str) -> str =>
    "\"" ++ s ++ "\""

emit_expr(e: Expr) -> str =>
    match e.kind {
        EInt     => str(e.ival)
        EFloat   => e.text
        EStr     => quoted(e.text)
        EBool    => emit_bool(e)
        EIdent   => e.text
        ECall    => emit_call(e)
        EBinary  => emit_binary(e)
        ETernary => emit_ternary(e)
        EUnary   => "({e.text}{emit_expr(e.children.get(0))})"
        ERecord  => "({e.text}){{ {emit_lit_fields(e.children, 0)} }}"
        EField   => "{emit_expr(e.children.get(0))}.{e.text}"
        EMatch   => emit_match(e)
        EMethod  => emit_method(e)
        EList    => emit_list(e)
        _        => "0"
    }

emit_bool(e: Expr) -> str {
    if e.text == "true" {
        "1"
    } else {
        "0"
    }
}

emit_ternary(e: Expr) -> str {
    cond = emit_expr(e.children.get(0))
    then = emit_expr(e.children.get(1))
    els = emit_expr(e.children.get(2))

    "({cond} ? {then} : {els})"
}

// Elements are widened to the `long` cell type the variadic `maca_listv` reads.
emit_list(e: Expr) -> str {
    n = e.children.length()

    "maca_listv({str(n)}, {e.children.map(emit_cell).join(", ")})"
}

emit_cell(e: Expr) -> str =>
    "(long)({emit_expr(e)})"

// A string's length and a list's are two names here (`length` and `count`),
// because the receiver's type is not known at this point and C will not
// overload. The unknown method falls through to member-call syntax rather than
// failing, which keeps the emitter usable while the slice is still growing.
emit_method(e: Expr) -> str {
    recv = emit_expr(e.children.get(0))

    if e.text == "length" {
        "((int)strlen({recv}))"
    } else if e.text == "count" {
        "({recv}.len)"
    } else if e.text == "at" {
        "((int){recv}[{emit_expr(e.children.get(1))}])"
    } else if e.text == "get" {
        "((int){recv}.data[{emit_expr(e.children.get(1))}])"
    } else {
        "{recv}.{e.text}({emit_args(e.children, 1)})"
    }
}

// A builtin is matched by name *before* the ordinary-call fallback, so a user
// function called `info`, `print` or `str` is never the one emitted. Stage-0
// resolves those names the same way, which is why the two agree about them.
emit_call(e: Expr) -> str {
    args = emit_args(e.children, 0)

    if e.text == "info" {
        "printf(\"%s\\n\", {args})"
    } else if e.text == "print" {
        "printf(\"%s\", {args})"
    } else if e.text == "str" {
        "maca_int_to_str({args})"
    } else {
        "{e.text}({args})"
    }
}

// A string comparison has to go through `strcmp`: C's `==` on `char*` compares
// pointers, so `w == "let"` would be false for every string but a literal the
// compiler happened to intern. One operand being a literal is the only signal
// available here, which is why the test looks at the operands' kinds.
emit_binary(e: Expr) -> str {
    l = e.children.get(0)
    r = e.children.get(1)
    is_cmp = e.text == "==" || e.text == "!="
    is_str_eq = is_cmp && (l.kind == EStr || r.kind == EStr)

    if e.text == "++" {
        "maca_cat({emit_expr(l)}, {emit_expr(r)})"
    } else if is_str_eq {
        "(strcmp({emit_expr(l)}, {emit_expr(r)}) {e.text} 0)"
    } else {
        "({emit_expr(l)} {e.text} {emit_expr(r)})"
    }
}

// A ternary chain rather than a `switch`: `match` is an expression in Maca, and
// a C `switch` is a statement. Running out of arms is the final else, so a
// match with no `_` still produces a valid expression.
emit_match(e: Expr) -> str =>
    emit_arms(emit_expr(e.children.get(0)), e.children, 1)

// A match is over one sum, so one arm carrying binders means every arm in it
// tests a tag rather than the value itself.
emit_arms(scrut: str, cs: Expr[], i: int) -> str =>
    emit_arms_at(scrut, cs, i, any_bound(cs, 1))

emit_arms_at(scrut: str, cs: Expr[], i: int, tagged: bool) -> str {
    if i + 1 >= cs.length() {
        "0"
    } else if cs.get(i).text == "_" {
        emit_expr(cs.get(i + 1))
    } else {
        cond = test(scrut, cs.get(i), tagged)
        body = arm_body(scrut, cs.get(i), cs.get(i + 1))
        rest = emit_arms_at(scrut, cs, i + 2, tagged)
        "({cond} ? {body} : {rest})"
    }
}

any_bound(cs: Expr[], i: int) -> bool {
    if i >= cs.length() {
        false
    } else if cs.get(i).children.length() > 0 {
        true
    } else {
        any_bound(cs, i + 2)
    }
}

test(scrut: str, pat: Expr, tagged: bool) -> str {
    if tagged {
        "{scrut}.tag == {pat.text}_tag"
    } else {
        "{scrut} == {pat.text}"
    }
}

// A pattern with binders opens a scope that names the payload slots, so the
// arm body can read them.
arm_body(scrut: str, pat: Expr, body: Expr) -> str {
    if pat.children.length() == 0 {
        emit_expr(body)
    } else {
        "({{ {bind_slots(scrut, pat.children, 0)}{emit_expr(body)}; }})"
    }
}

bind_slots(scrut: str, bs: Expr[], i: int) -> str {
    if i >= bs.length() {
        ""
    } else {
        "long {bs.get(i).text} = {scrut}._{i}; {bind_slots(scrut, bs, i + 1)}"
    }
}

// Designated initializers, so a record literal does not have to be written in
// field-declaration order to compile.
emit_lit_fields(fs: Expr[], i: int) -> str =>
    fs.map(emit_lit_field).join(", ")

emit_lit_field(f: Expr) -> str =>
    ".{f.children.get(0).text} = {emit_expr(f.children.get(1))}"

// `i` is 1 for a method call, whose first child is the receiver.
emit_args(xs: Expr[], i: int) -> str =>
    xs.slice(i, xs.length()).map(emit_expr).join(", ")

// Literal C braces are written `{{`/`}}` so they aren't read as Maca string
// interpolation. Every emitted brace in this file is doubled for that reason.
emit_unit(e: Expr) -> str =>
    "int main(void) {{ return {emit_expr(e)}; }}"

// ---- function emission ----------------------------------------------------

// `bool` becomes `int` rather than pulling in <stdbool.h>, and an unwritten
// type defaults to `int` because a signature with no return type is the common
// case. Any other name is a user type, emitted verbatim: `emit_struct` and
// `emit_sum` `typedef` theirs, so no `struct`/`enum` keyword is needed here.
type_c(ty: str) -> str {
    if ty.ends_with("[]") {
        "MacaList"
    } else if ty == "float" {
        "double"
    } else if ty == "str" {
        "const char*"
    } else if ty == "" || ty == "int" || ty == "bool" {
        "int"
    } else {
        ty
    }
}

emit_fn(s: Stmt) -> str {
    params = s.params.map(emit_param).join(", ")

    "{type_c(s.ret)} {s.name}({params}) {{ {emit_stmts(s.body, 0)} }}"
}

emit_param(p: Expr) -> str =>
    "{type_c(p.ty)} {p.text}"

emit_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        here = emit_stmt(body.get(i), i == body.length() - 1)
        "{here} {emit_stmts(body, i + 1)}"
    }
}

// A local's type is guessed from the value's *shape*, not from the checker: C
// has no `auto` worth using here and the emitter runs without an environment.
// Rust's `let` infers it, which is why only this back end carries this.
local_c_type(e: Expr) -> str =>
    match e.kind {
        EStr    => "const char*"
        EFloat  => "double"
        ERecord => e.text
        EList   => "MacaList"
        EBinary => concat_c_type(e)
        _       => "int"
    }

concat_c_type(e: Expr) -> str {
    if e.text == "++" {
        "const char*"
    } else {
        "int"
    }
}

// Maca's last expression is the value, so the caller has to say which statement
// that is. The emitter cannot see the end of the body from inside one.
emit_stmt(s: Stmt, is_last: bool) -> str {
    if s.kind == SBind {
        "{local_c_type(s.value)} {s.name} = {emit_expr(s.value)};"
    } else if is_last {
        "return {emit_expr(s.value)};"
    } else {
        "{emit_expr(s.value)};"
    }
}

// The runtime this back end needs, small enough to inline: `++`, `str(n)` and
// list literals each lower to one of these helpers.
c_preamble() -> str =>
    "#include <string.h>\n#include <stdlib.h>\n#include <stdio.h>\n#include <stdarg.h>\n" ++
    "static char* maca_cat(const char* a, const char* b) {{ char* r = malloc(strlen(a) + strlen(b) + 1); strcpy(r, a); strcat(r, b); return r; }}\n" ++
    "static char* maca_int_to_str(int n) {{ char* r = malloc(16); snprintf(r, 16, \"%d\", n); return r; }}\n" ++
    "typedef struct {{ long* data; int len; }} MacaList;\n" ++
    "static MacaList maca_listv(int n, ...) {{ MacaList l; l.data = malloc(n * sizeof(long)); l.len = n; va_list ap; va_start(ap, n); for (int i = 0; i < n; i++) l.data[i] = va_arg(ap, long); va_end(ap); return l; }}\n"

// Items keep source order, and C needs a type declared before it is used. That
// holds because a Maca file declares its records above the functions that take
// them; there is no forward-declaration pass to fall back on if one doesn't.
emit_module(m: Module) -> str =>
    c_preamble() ++ m.items.map(emit_item).join("\n")

emit_item(s: Stmt) -> str {
    if s.kind == SRecord {
        emit_struct(s)
    } else if s.kind == SSum {
        emit_sum(s)
    } else {
        emit_fn(s)
    }
}

// `typedef`, not a bare `struct`, so `type_c` can emit a user type's name on
// its own and nothing has to remember which names need the `struct` keyword.
emit_struct(s: Stmt) -> str {
    fields = s.params.map(emit_struct_field).join(" ")

    "typedef struct {{ {fields} }} {s.name};"
}

emit_struct_field(f: Expr) -> str =>
    "{type_c(f.ty)} {f.text};"

// A sum. With no payloads it is a plain C enum, which is what a nullary sum
// wants and costs nothing.
//
// With payloads it is a tag plus a flat row of `long` slots, wide enough for
// the widest variant, the same integer cell the list literals use. Each
// variant also gets a constructor *named after itself*, so an ordinary call
// `Circle(2)` in the source compiles with no call-site knowledge of which
// names are variants.
emit_sum(s: Stmt) -> str {
    if payload_arity(s.params, 0) == 0 {
        variants = s.params.map(variant_name).join(", ")
        "typedef enum {{ {variants} }} {s.name};"
    } else {
        emit_tagged_sum(s)
    }
}

variant_name(v: Expr) -> str =>
    v.text

emit_tagged_sum(s: Stmt) -> str {
    tags = s.params.map(tag_name).join(", ")
    slots = emit_slots(payload_arity(s.params, 0), 0)

    "typedef enum {{ {tags} }} {s.name}_tag;\n"
        ++ "typedef struct {{ {s.name}_tag tag; {slots}}} {s.name};\n"
        ++ emit_ctors(s.name, s.params, 0)
}

tag_name(v: Expr) -> str =>
    "{v.text}_tag"

payload_arity(vs: Expr[], i: int) -> int {
    if i >= vs.length() {
        0
    } else {
        wider(vs.get(i).children.length(), payload_arity(vs, i + 1))
    }
}

wider(a: int, b: int) -> int {
    if a > b {
        a
    } else {
        b
    }
}

emit_slots(n: int, i: int) -> str {
    if i >= n {
        ""
    } else {
        "long _{i}; {emit_slots(n, i + 1)}"
    }
}

emit_ctors(sum: str, vs: Expr[], i: int) -> str {
    if i >= vs.length() {
        ""
    } else {
        emit_ctor(sum, vs.get(i)) ++ emit_ctors(sum, vs, i + 1)
    }
}

emit_ctor(sum: str, v: Expr) -> str =>
    "static inline {sum} {v.text}({ctor_params(v.children, 0)}) "
        ++ "{{ {sum} _v; _v.tag = {v.text}_tag; "
        ++ ctor_assigns(v.children, 0) ++ "return _v; }}\n"

// A nullary variant's constructor takes `void`, not an empty parameter list:
// in C the empty list means "unspecified", not "none".
ctor_params(ps: Expr[], i: int) -> str {
    if ps.length() == 0 {
        "void"
    } else if i >= ps.length() {
        ""
    } else if i == ps.length() - 1 {
        "long _{i}"
    } else {
        "long _{i}, {ctor_params(ps, i + 1)}"
    }
}

ctor_assigns(ps: Expr[], i: int) -> str {
    if i >= ps.length() {
        ""
    } else {
        "_v._{i} = _{i}; {ctor_assigns(ps, i + 1)}"
    }
}
