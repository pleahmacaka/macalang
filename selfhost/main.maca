// selfhost/main — the stage-1 driver entry.
//
// `maca build selfhost/main.maca` resolves these imports to the sibling
// modules (the stage-0 driver inlines local imports in dependency order), so
// the whole front-end builds from this one entry point. Toward the bootstrap:
//   maca build selfhost/main.maca -o maca1     # stage-0 (Rust) builds stage-1
//   ./maca1 build selfhost/main.maca -o maca2  # stage-1 builds itself
//   diff maca1-output maca2-output             # fixed point ⇒ self-hosted
//
// `main` runs the full pipeline — lex → parse → check → emit — over a sample.

import selfhost/lexer
import selfhost/parser
import selfhost/check
import selfhost/emit_c

main() -> int {
    sample = "add(1) + 2 - 3"
    toks = lex(sample)
    info("scanned {toks.length()} tokens from {sample.length()} chars")
    tree = parse_expr(toks, 0)
    info("parsed: {show(tree.node)}")
    // precedence: `*` binds tighter than `+`.
    prec = parse_expr(lex("2 + 3 * 4"), 0)
    info("precedence: {show(prec.node)}")
    info("checked: type {type_of(tree.node)}, {count_errors(tree.node)} errors")
    info("emitted: {emit_unit(tree.node)}")

    // a deliberately ill-typed expression the checker must reject: `str + int`.
    bad = e_binary("+", e_str("hi"), e_int(1))
    info("checked: {show(bad)} → type {type_of(bad)}, {count_errors(bad)} errors")

    // a whole function definition through lex → parse → emit.
    fnsrc = "add(x: int, y: int) -> int => x + y"
    fst = parse_fn(lex(fnsrc), 0)
    info("fn: {emit_fn(fst.snode)}")

    // a whole module (several functions) → a complete C translation unit.
    prog = "inc(n: int) -> int => n + 1 dbl(n: int) -> int => n * 2"
    mod = parse_module(lex(prog), 0, [])
    info("module ({mod.items.length()} fns):")
    info(emit_module(mod))
    0
}
