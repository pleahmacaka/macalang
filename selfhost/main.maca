// selfhost/main — the stage-1 driver entry.
//
// `maca build selfhost/main.maca` resolves these imports to the sibling
// modules (the stage-0 driver inlines local imports in dependency order), so
// the whole front-end builds from this one entry point. Toward the bootstrap:
//   maca build selfhost/main.maca -o maca1     # stage-0 (Rust) builds stage-1
//   ./maca1 build selfhost/main.maca -o maca2  # stage-1 builds itself
//   diff maca1-output maca2-output             # fixed point ⇒ self-hosted
//
// `main` runs the full pipeline — lex → parse → check → emit — over a sample.

import selfhost/lexer
import selfhost/parser
import selfhost/check
import selfhost/emit_c
import selfhost/emit_rust

// The stage-1 driver.
//
// With arguments it is a compiler: `maca1 <in.maca> <out.c> [rust]` reads a
// source file, runs it through the Maca-written lexer, parser and checker, and
// writes the emitted C — or Rust, with a third argument. That is what makes a
// differential test possible: the same source through stage-0 and stage-1, and
// the two programs must agree.
//
// With no arguments it runs the demonstration below, which is what the gate
// reads its assertions from.
main(args: str[]) -> int {
    if args.length() >= 2 {
        compile_file(args)
    } else {
        demo()
    }
}

compile_file(args: str[]) -> int {
    src = read_file(args.get(0))
    m = parse_module(lex(src), 0, [])
    errs = check_module(m)
    want_rust = args.length() >= 3 && args.get(2) == "rust"
    emitted = if want_rust { remit_module(m) } else { emit_module(m) }

    write_file(args.get(1), emitted)
    errs
}

demo() -> int {
    sample = "add(1) + 2 - 3"
    toks = lex(sample)
    info("scanned {toks.length()} tokens from {sample.length()} chars")
    tree = parse_expr(toks, 0)
    info("parsed: {show(tree.node)}")
    // precedence: `*` binds tighter than `+`.
    prec = parse_expr(lex("2 + 3 * 4"), 0)
    info("precedence: {show(prec.node)}")
    info("checked: type {type_of(tree.node)}, {count_errors(tree.node)} errors")
    info("emitted: {emit_unit(tree.node)}")

    // a deliberately ill-typed expression the checker must reject: `str + int`.
    bad = e_binary("+", e_str("hi"), e_int(1))
    info("checked: {show(bad)} → type {type_of(bad)}, {count_errors(bad)} errors")

    // a whole function definition through lex → parse → emit.
    fnsrc = "add(x: int, y: int) -> int => x + y"
    fst = parse_fn(lex(fnsrc), 0)
    info("fn: {emit_fn(fst.snode)}")

    // a whole module (several functions) → a complete C translation unit.
    prog = "inc(n: int) -> int => n + 1 dbl(n: int) -> int => n * 2"
    mod = parse_module(lex(prog), 0, [])
    info("module ({mod.items.length()} fns):")
    info(emit_module(mod))

    // whole-module type checking: one clean function, one `int + str` clash.
    prog2 = "ok() -> int => 1 + 2 bad() -> int => 1 + \"x\""
    mod2 = parse_module(lex(prog2), 0, [])
    info("module check: {check_module(mod2)} type errors")

    // a block-bodied function: a local binding plus a returned expression.
    blk = "sq(n: int) -> int {{ t = n * n t }}"
    bfn = parse_fn(lex(blk), 0)
    info("block fn: {emit_fn(bfn.snode)}")

    // multi-argument calls: `add(1, 2)` parses to a two-arg call node.
    two = parse_expr(lex("add(1, 2)"), 0)
    info("multi-arg: {show(two.node)}")

    // ternary: `a > b ? a : b` parses to a conditional node.
    tern = parse_expr(lex("a > b ? a : b"), 0)
    info("ternary: {show(tern.node)}")

    // unary minus: `-n` parses to a negation node (prefix, binds tight).
    neg = parse_expr(lex("0 - -n"), 0)
    info("unary: {show(neg.node)}")

    // modulo: `a % b` binds like `*` / `/` (precedence 5).
    md = parse_expr(lex("a % b + 1"), 0)
    info("modulo: {show(md.node)}")

    // boolean operators: `&&` binds tighter than `||`, both looser than a
    // comparison — so `a < b && c || d` groups as `((a < b && c) || d)`.
    logic = parse_expr(lex("a < b && c || d"), 0)
    info("logic: {show(logic.node)}")

    // type threading: parameter and return types now flow from the signature to
    // the emitted code. `tag` takes a `str` (→ `const char*` in C, `String` in
    // Rust) and an `int`; its call passes a string literal, and the whole
    // program still exits `42`, proving non-`int` parameter types compile
    // through both back ends.
    sig = parse_fn(lex("tag(s: str, n: int) -> int => n"), 0)
    info("typed sig C:    {emit_fn(sig.snode)}")
    info("typed sig Rust: {remit_fn(sig.snode)}")

    // bool: a `-> bool` function returning a literal, consumed by a ternary. In
    // C `true`/`false` lower to `1`/`0`; in Rust they stay keywords and the
    // return type is `bool`.
    bfn = parse_fn(lex("flag() -> bool => true"), 0)
    info("bool fn C:    {emit_fn(bfn.snode)}")
    info("bool fn Rust: {remit_fn(bfn.snode)}")

    // float: the lexer scans `2.0` as one float token; the type threads to
    // `double` (C) / `f64` (Rust), and the literal keeps its spelling (Rust
    // suffixes `_f64`).
    ffn = parse_fn(lex("scale(x: float) -> float => x * 2.0"), 0)
    info("float fn C:    {emit_fn(ffn.snode)}")
    info("float fn Rust: {remit_fn(ffn.snode)}")

    // records: a type declaration parses to a struct, a field access to member
    // access, and a literal to a struct initializer.
    rec = parse_module(lex("Point = {{ x: int, y: int }} sum(p: Point) -> int => p.x + p.y"), 0, [])
    info("record C:    {emit_module(rec)}")
    info("record Rust: {remit_module(rec)}")

    // sum types: a `A | B | C` declaration parses to a C/Rust enum; a bare
    // variant reference stays bare (Rust glob-imports the variants).
    su = parse_module(lex("Color = Red | Green | Blue rank(c: Color) -> int => c == Green ? 42 : 0"), 0, [])
    info("sum C:    {emit_module(su)}")
    info("sum Rust: {remit_module(su)}")

    // match: deconstruct a nullary sum. C lowers it to a right-nested ternary
    // chain (`c == Red ? … : …`), Rust to a native `match` (bare variant
    // patterns resolve via `use Color::*`).
    mt = parse_fn(lex("code(c: Color) -> int => match c {{ Red => 1 Green => 42 Blue => 3 }}"), 0)
    info("match C:    {emit_fn(mt.snode)}")
    info("match Rust: {remit_fn(mt.snode)}")

    // string equality: `w == "let"` compares by value — `strcmp(w, "let") == 0`
    // in C (with the `<string.h>` preamble), a native `==` in Rust. This is what
    // real Maca keyword/operator matching leans on.
    se = parse_fn(lex("kw(w: str) -> int => w == \"let\" ? 1 : 0"), 0)
    info("streq C:    {emit_fn(se.snode)}")
    info("streq Rust: {remit_fn(se.snode)}")

    // string concatenation: `a ++ b` → the `maca_cat` heap helper in C, a
    // `format!` in Rust (what `quoted(s) => "\"" ++ s ++ "\""` compiles to).
    // string interpolation: `"n = {x}"` desugars in the parser to the concat
    // and `str` forms both back ends already emit, so neither needed changing.
    ip = parse_fn(lex("label(n: int) -> str => \"n = \{n\}!\""), 0)
    info("interp C:    {emit_fn(ip.snode)}")
    info("interp Rust: {remit_fn(ip.snode)}")

    // an interpolation holds a whole expression, not just a name
    ip2 = parse_expr(lex("\"sum \{a + b\} done\""), 0)
    info("interp expr: {show(ip2.node)}")

    // The checker carries an environment now, so it sees more than arithmetic:
    // a declared function's arity and return type, a record's fields, and the
    // locals a body introduces as it goes.
    info("check arity: {check_module(parse_module(lex("add(a: int, b: int) -> int => a + b use() -> int => add(1)"), 0, []))}")
    info("check return: {check_module(parse_module(lex("bad() -> str => 1 + 2"), 0, []))}")
    info("check calls: {check_module(parse_module(lex("n() -> int => 1 s() -> str => \"a\" mix() -> int => s() + 1"), 0, []))}")
    info("check clean: {check_module(parse_module(lex("add(a: int, b: int) -> int => a + b use() -> int => add(1, 2)"), 0, []))}")

    // payload sum variants: `Circle(int) | Rect(int, int)`. In C a tag plus a
    // row of cells wide enough for the widest variant, with a constructor named
    // after each variant so `Circle(2)` needs no call-site knowledge; in Rust
    // the native enum, where `Circle(2)` is already a constructor.
    sm = parse_module(lex("Shape = Circle(int) | Rect(int, int)"), 0, [])
    info("payload C:    {emit_module(sm)}")
    info("payload Rust: {remit_module(sm)}")

    // and a match that binds the payload
    ar = parse_fn(lex("area(s: Shape) -> int => match s {{ Circle(r) => r * r Rect(w, h) => w * h }}"), 0)
    info("bind C:    {emit_fn(ar.snode)}")
    info("bind Rust: {remit_fn(ar.snode)}")

    cc = parse_fn(lex("wrap(s: str) -> str => \"[\" ++ s ++ \"]\""), 0)
    info("concat C:    {emit_fn(cc.snode)}")
    info("concat Rust: {remit_fn(cc.snode)}")

    // int-to-string: `str(n)` → the `maca_int_to_str` helper in C, a `format!`
    // in Rust. With `++` this is the desugared form of interpolation and what
    // real Maca's `str(e.ival)` compiles to.
    st = parse_fn(lex("numbered(n: int) -> str => \"#\" ++ str(n)"), 0)
    info("str C:    {emit_fn(st.snode)}")
    info("str Rust: {remit_fn(st.snode)}")

    // UFCS method call: `s.length()` → `strlen` in C, `.len() as i64` in Rust
    // (the string method the self-hosted lexer scans with).
    lm = parse_fn(lex("slen(s: str) -> int => s.length()"), 0)
    info("method C:    {emit_fn(lm.snode)}")
    info("method Rust: {remit_fn(lm.snode)}")

    // `s.at(i)` → the byte at an index (C `s[i]`, Rust `as_bytes()[i]`), the
    // character access the lexer uses. `"*".at(0)` is ASCII 42.
    at = parse_fn(lex("first(s: str) -> int => s.at(0)"), 0)
    info("at C:    {emit_fn(at.snode)}")
    info("at Rust: {remit_fn(at.snode)}")

    // dynamic arrays: an `int[]` parameter (a heap `MacaList` in C, a `Vec<i64>`
    // in Rust), `[a, b]` literals built on the heap so they survive being
    // returned/passed, `.get(i)` indexing, and `.count()` length.
    ar = parse_fn(lex("total(xs: int[]) -> int => xs.get(0) + xs.get(1) + xs.count()"), 0)
    info("array C:    {emit_fn(ar.snode)}")
    info("array Rust: {remit_fn(ar.snode)}")

    // a realistic file shape: leading `import` lines (skipped — the driver
    // resolves modules), then a sum type and a function. This is the structure
    // of every real selfhost source, now parsed by the stage-1 parser.
    real = "import std/str import selfhost/token Kind = TInt | TStr classify(k: Kind) -> int => match k {{ TInt => 1 TStr => 2 }}"
    rm = parse_module(lex(real), 0, [])
    info("real file: {rm.items.length()} items after skipping imports")

    // a COMPLETE program compiled end to end exercising a record, a sum, field
    // access, and a `match`: a `Point`, a `Color`, `fld` reading a field, `code`
    // matching a variant, and a `main` composing them. C lowers the types to a
    // `typedef struct` / `typedef enum` and `match` to a ternary chain; Rust to a
    // `struct` / `enum` and a native `match`. Compiled and run, exit
    // `(fld(Point{40,9}) + code(Green)) * hi("hel", "lo")` = `(40 + 2) * 1` =
    // `42`, where `hi` concatenates then compares — `(a ++ b) == "hello"`. `main`
    // also prints a greeting via the `info` builtin (`printf` / `println!`).
    program = "Point = {{ x: int, y: int }} Color = Red | Green | Blue fld(p: Point) -> int => p.x code(c: Color) -> int => match c {{ Red => 1 Green => 2 Blue => 3 }} Shape = Circle(int) | Rect(int, int) area(sh: Shape) -> int => match sh {{ Circle(r) => r * r Rect(w, h) => w * h }} hi(a: str, b: str) -> int => (a ++ b) == \"hello\" ? 1 : 0 chk(n: int) -> int => (\"v\" ++ str(n)) == \"v42\" ? 1 : 0 slen(s: str) -> int => s.length() head(xs: int[]) -> int => xs.get(0) main() -> int {{ q = Point {{ x = 40, y = 9 }} ys = [1, 99] info(\"self-hosted!\") (fld(q) + code(Green)) * hi(\"hel\", \"lo\") * chk(42) * slen(\"z\") * head(ys) * area(Rect(1, 1)) }}"
    prog_mod = parse_module(lex(program), 0, [])
    info("=== emitted program ===")
    info(emit_module(prog_mod))
    info("=== end program ===")

    // The same program through the Maca-written Rust back end (emit_rust.maca):
    // the emitted Rust between the markers compiles with `rustc` and runs, its
    // exit code again `sq(9) == 81` — the Rust backend written in Maca produces a
    // working executable, alongside the C one.
    info("=== emitted rust ===")
    info(remit_module(prog_mod))
    info("=== end rust ===")
    0
}
