// selfhost/emit_rust — a Rust emitter over the AST, written in Maca.
//
// The Maca-written sibling of emit_c: it turns the stage-1 AST into Rust source
// (the `--target rust` back end), so the Rust backend itself is written in Maca
// rather than living only in the stage-0 crate. Mirrors `maca-backend-rust` on
// the slice the stage-1 parser covers: integer/string literals, idents, calls,
// binary operators, function definitions, bindings, and a `main` that exits
// with its returned value. It grows into the full backend the way emit_c does.

import selfhost/token
import selfhost/ast

// A Rust integer literal carries an `i64` suffix, so it isn't inferred as `i32`
// and then clash with Maca's `int` = `i64` in arithmetic.
rust_int(n: int) -> str =>
    "{str(n)}i64"

// An owned Rust string literal (`"…".to_string()`), kept out of interpolation
// so the quoting stays legible.
rust_str(s: str) -> str =>
    "\"" ++ s ++ "\".to_string()"

// Emit a Rust expression for one AST node.
remit_expr(e: Expr) -> str =>
    match e.kind {
        EInt    => rust_int(e.ival)
        EFloat  => "{e.text}_f64"
        EStr    => rust_str(e.text)
        EBool   => e.text
        EIdent  => e.text
        ECall   => remit_call(e)
        EBinary => remit_binary(e)
        ETernary => "(if {remit_expr(e.children.get(0))} {{ {remit_expr(e.children.get(1))} }} else {{ {remit_expr(e.children.get(2))} }})"
        EUnary  => "({e.text}{remit_expr(e.children.get(0))})"
        ERecord => "{e.text} {{ {remit_lit_fields(e.children, 0)} }}"
        EField  => "{remit_expr(e.children.get(0))}.{e.text}"
        EMatch  => "match {remit_expr(e.children.get(0))} {{ {remit_arms(e.children, 1)} }}"
        EMethod => remit_method(e)
        _       => "0i64"
    }

// A UFCS method call. `.length()` maps to Rust's `.len()` (as `i64`); any other
// method passes through as-is.
remit_method(e: Expr) -> str =>
    e.text == "length"
        ? "(({remit_expr(e.children.get(0))}).len() as i64)"
        : e.text == "at"
            ? "(({remit_expr(e.children.get(0))}).as_bytes()[({remit_expr(e.children.get(1))}) as usize] as i64)"
            : "{remit_expr(e.children.get(0))}.{e.text}({remit_args(e.children, 1)})"

// A call. `info`/`print` are the output builtins → `println!`/`print!`; every
// other call is a plain `name(args)`.
remit_call(e: Expr) -> str =>
    e.text == "info"
        ? "println!(\"{{}}\", {remit_args(e.children, 0)})"
        : e.text == "print"
            ? "print!(\"{{}}\", {remit_args(e.children, 0)})"
            : e.text == "str"
                ? "format!(\"{{}}\", {remit_args(e.children, 0)})"
                : "{e.text}({remit_args(e.children, 0)})"

// A binary operator. `++` is string concatenation → `format!("{}{}", a, b)`;
// every other operator is emitted directly.
remit_binary(e: Expr) -> str =>
    e.text == "++"
        ? "format!(\"{{}}{{}}\", {remit_expr(e.children.get(0))}, {remit_expr(e.children.get(1))})"
        : "({remit_expr(e.children.get(0))} {e.text} {remit_expr(e.children.get(1))})"

// Rust match arms `Red => 1, _ => 0,` — a bare variant pattern resolves through
// the enum's `use Color::*;`.
remit_arms(cs: Expr[], i: int) -> str =>
    i + 1 >= cs.length()
        ? ""
        : "{cs.get(i).text} => {remit_expr(cs.get(i + 1))}, {remit_arms(cs, i + 2)}"

// Rust struct-literal fields `x: 40, y: 2`. Each rides as `EBinary("=", name, value)`.
remit_lit_fields(fs: Expr[], i: int) -> str =>
    i >= fs.length()
        ? ""
        : i == fs.length() - 1
            ? "{fs.get(i).children.get(0).text}: {remit_expr(fs.get(i).children.get(1))}"
            : "{fs.get(i).children.get(0).text}: {remit_expr(fs.get(i).children.get(1))}, {remit_lit_fields(fs, i + 1)}"

// Comma-join the emitted arguments from index `i` on.
remit_args(xs: Expr[], i: int) -> str =>
    i >= xs.length()
        ? ""
        : i == xs.length() - 1
            ? remit_expr(xs.get(i))
            : "{remit_expr(xs.get(i))}, {remit_args(xs, i + 1)}"

// ---- function emission ----------------------------------------------------

// Map a Maca type name to its Rust spelling. Scalars map directly; an empty
// type defaults to `i64`; any other name is a record type used verbatim.
rtype(ty: str) -> str =>
    ty == "float"
        ? "f64"
        : ty == "str"
            ? "String"
            : ty == "bool"
                ? "bool"
                : ty == "" || ty == "int"
                    ? "i64"
                    : ty

// A function definition. `main` returns an exit code, so it is wrapped the way
// `maca-backend-rust` does: the body becomes `__maca_main`, and a real `main`
// exits with it. Every other function carries its declared parameter and return
// types (via `rtype`). (Literal Rust braces are written `{{`/`}}` so they aren't
// read as Maca string interpolation.)
remit_fn(s: Stmt) -> str =>
    s.name == "main"
        ? "fn __maca_main() -> i64 {{ {remit_stmts(s.body, 0)} }}\nfn main() {{ std::process::exit(__maca_main() as i32); }}"
        : "fn {s.name}({remit_params(s.params, 0)}) -> {rtype(s.ret)} {{ {remit_stmts(s.body, 0)} }}"

// `a: i64, b: String` from the typed parameter ident nodes.
remit_params(ps: Expr[], i: int) -> str =>
    i >= ps.length()
        ? ""
        : i == ps.length() - 1
            ? "{ps.get(i).text}: {rtype(ps.get(i).ty)}"
            : "{ps.get(i).text}: {rtype(ps.get(i).ty)}, {remit_params(ps, i + 1)}"

remit_stmts(body: Stmt[], i: int) -> str =>
    i >= body.length()
        ? ""
        : "{remit_stmt(body.get(i), i == body.length() - 1)} {remit_stmts(body, i + 1)}"

// A binding is a local `let x = e;`; the last expression is the block's tail
// value (no semicolon — Rust returns it), any earlier one a statement.
remit_stmt(s: Stmt, is_last: bool) -> str =>
    s.kind == SBind
        ? "let {s.name} = {remit_expr(s.value)};"
        : is_last
            ? remit_expr(s.value)
            : "{remit_expr(s.value)};"

// A whole module: record `struct` declarations and function definitions, one
// item per line.
remit_module(m: Module) -> str =>
    remit_items(m.items, 0)

remit_items(items: Stmt[], i: int) -> str =>
    i >= items.length()
        ? ""
        : i == items.length() - 1
            ? remit_item(items.get(i))
            : "{remit_item(items.get(i))}\n{remit_items(items, i + 1)}"

remit_item(s: Stmt) -> str =>
    s.kind == SRecord
        ? remit_struct(s)
        : s.kind == SSum
            ? remit_sum(s)
            : remit_fn(s)

// `#[derive(Clone)] struct Point { x: i64, y: i64 }` from a record declaration.
remit_struct(s: Stmt) -> str =>
    "#[derive(Clone)]\nstruct {s.name} {{ {remit_struct_fields(s.params, 0)} }}"

remit_struct_fields(fs: Expr[], i: int) -> str =>
    i >= fs.length()
        ? ""
        : i == fs.length() - 1
            ? "{fs.get(i).text}: {rtype(fs.get(i).ty)}"
            : "{fs.get(i).text}: {rtype(fs.get(i).ty)}, {remit_struct_fields(fs, i + 1)}"

// `#[derive(Clone, PartialEq)] enum Color { Red, Green, Blue }` plus a
// `use Color::*;` so a bare variant reference (`Green`) resolves without
// qualification — matching how the emitter leaves variant idents bare.
remit_sum(s: Stmt) -> str =>
    "#[derive(Clone, PartialEq)]\nenum {s.name} {{ {remit_variants(s.params, 0)} }}\nuse {s.name}::*;"

remit_variants(vs: Expr[], i: int) -> str =>
    i >= vs.length()
        ? ""
        : i == vs.length() - 1
            ? vs.get(i).text
            : "{vs.get(i).text}, {remit_variants(vs, i + 1)}"
