// selfhost/emit_rust: a Rust emitter over the AST, written in Maca.
//
// The Maca-written sibling of emit_c: the `--target rust` back end, written in
// Maca rather than living only in the stage-0 crate. It mirrors
// `maca-backend-rust` over whatever the stage-1 parser can read, and grows the
// way emit_c does.
//
// Both back ends are held to one answer: the gate compiles the *same* emitted
// program with `cc` and with `rustc` and checks the two exit alike. A back end
// tested only against its own output can agree with nothing but itself.

import selfhost/token
import selfhost/ast

// A Rust integer literal carries an `i64` suffix, so it isn't inferred as `i32`
// and then clash with Maca's `int` = `i64` in arithmetic.
rust_int(n: int) -> str =>
    "{str(n)}i64"

// Owned, not `&'static str`: `++` produces a `String` and a signature says
// `String`, so a literal that stayed borrowed would need a cast at every use.
rust_str(s: str) -> str =>
    "\"" ++ s ++ "\".to_string()"

remit_expr(e: Expr) -> str =>
    match e.kind {
        EInt     => rust_int(e.ival)
        EFloat   => "{e.text}_f64"
        EStr     => rust_str(e.text)
        EBool    => e.text
        EIdent   => e.text
        ECall    => remit_call(e)
        EBinary  => remit_binary(e)
        ETernary => remit_ternary(e)
        EUnary   => "({e.text}{remit_expr(e.children.get(0))})"
        ERecord  => "{e.text} {{ {remit_lit_fields(e.children)} }}"
        EField   => "{remit_expr(e.children.get(0))}.{e.text}"
        EMatch   => remit_match(e)
        EMethod  => remit_method(e)
        EList    => "vec![{remit_args(e.children, 0)}]"
        _        => "0i64"
    }

// Rust has no ternary; `if` is already an expression there.
remit_ternary(e: Expr) -> str {
    cond = remit_expr(e.children.get(0))
    then = remit_expr(e.children.get(1))
    els = remit_expr(e.children.get(2))

    "(if {cond} {{ {then} }} else {{ {els} }})"
}

remit_match(e: Expr) -> str =>
    "match {remit_expr(e.children.get(0))} {{ {remit_arms(e.children, 1)} }}"

// Maca's `length` and `count` collapse back into one `len()` here. The split
// exists for C's sake (see emit_c), not for Rust's.
remit_method(e: Expr) -> str {
    recv = remit_expr(e.children.get(0))

    if e.text == "length" || e.text == "count" {
        "(({recv}).len() as i64)"
    } else if e.text == "at" {
        idx = remit_expr(e.children.get(1))
        "(({recv}).as_bytes()[({idx}) as usize] as i64)"
    } else if e.text == "get" {
        "{recv}[({remit_expr(e.children.get(1))}) as usize]"
    } else {
        "{recv}.{e.text}({remit_args(e.children, 1)})"
    }
}

// Matched by name before the fallback, exactly as `emit_call` does it, so both
// back ends shadow a user `info`/`print`/`str` the same way rather than one
// target quietly calling something the other does not.
remit_call(e: Expr) -> str {
    args = remit_args(e.children, 0)

    if e.text == "info" {
        "println!(\"{{}}\", {args})"
    } else if e.text == "print" {
        "print!(\"{{}}\", {args})"
    } else if e.text == "str" {
        "format!(\"{{}}\", {args})"
    } else {
        "{e.text}({args})"
    }
}

// `++` goes through `format!` rather than `+`: Rust's `+` on strings consumes
// its left operand, and the AST gives no way to know whether that is safe.
remit_binary(e: Expr) -> str {
    l = remit_expr(e.children.get(0))
    r = remit_expr(e.children.get(1))

    if e.text == "++" {
        "format!(\"{{}}{{}}\", {l}, {r})"
    } else {
        "({l} {e.text} {r})"
    }
}

// A bare variant pattern resolves through the `use Color::*;` that `remit_sum`
// emits, so nothing here has to know which enum the scrutinee belongs to.
remit_arms(cs: Expr[], i: int) -> str {
    if i + 1 >= cs.length() {
        ""
    } else {
        arm = "{remit_pat(cs.get(i))} => {remit_expr(cs.get(i + 1))}, "
        arm ++ remit_arms(cs, i + 2)
    }
}

// `Circle(r)`: the binders go straight through, because Rust's own pattern
// syntax is the one Maca borrowed.
remit_pat(p: Expr) -> str {
    if p.children.length() == 0 {
        p.text
    } else {
        "{p.text}({p.children.map(binder_name).join(", ")})"
    }
}

binder_name(b: Expr) -> str =>
    b.text

remit_lit_fields(fs: Expr[]) -> str =>
    fs.map(remit_lit_field).join(", ")

remit_lit_field(f: Expr) -> str =>
    "{f.children.get(0).text}: {remit_expr(f.children.get(1))}"

// `i` is 1 for a method call, whose first child is the receiver.
remit_args(xs: Expr[], i: int) -> str =>
    xs.slice(i, xs.length()).map(remit_expr).join(", ")

// ---- function emission ----------------------------------------------------

// An unwritten type defaults to `i64` because a signature with no return type
// is the common case. `int` is `i64`, not `i32`, so it cannot silently narrow.
rtype(ty: str) -> str {
    if ty.ends_with("[]") {
        "Vec<i64>"
    } else if ty == "float" {
        "f64"
    } else if ty == "str" {
        "String"
    } else if ty == "bool" {
        "bool"
    } else if ty == "" || ty == "int" {
        "i64"
    } else {
        ty
    }
}

// Maca's `main` returns an exit code and Rust's returns nothing, so the body
// moves to `__maca_main` and a real `main` exits with it, the same wrapping
// `maca-backend-rust` does. Literal Rust braces are written `{{`/`}}` so they
// aren't read as Maca string interpolation.
remit_fn(s: Stmt) -> str {
    body = remit_stmts(s.body, 0)

    if s.name == "main" {
        "fn __maca_main() -> i64 {{ {body} }}\n"
            ++ "fn main() {{ std::process::exit(__maca_main() as i32); }}"
    } else {
        params = s.params.map(remit_param).join(", ")
        "fn {s.name}({params}) -> {rtype(s.ret)} {{ {body} }}"
    }
}

remit_param(p: Expr) -> str =>
    "{p.text}: {rtype(p.ty)}"

remit_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        here = remit_stmt(body.get(i), i == body.length() - 1)
        "{here} {remit_stmts(body, i + 1)}"
    }
}

// The last expression drops its semicolon so it becomes the block's tail value.
// Maca's last-expression-is-the-value rule is Rust's too, which is why this
// back end needs no `return` and no inferred local types.
remit_stmt(s: Stmt, is_last: bool) -> str {
    if s.kind == SBind {
        "let {s.name} = {remit_expr(s.value)};"
    } else if is_last {
        remit_expr(s.value)
    } else {
        "{remit_expr(s.value)};"
    }
}

remit_module(m: Module) -> str =>
    m.items.map(remit_item).join("\n")

remit_item(s: Stmt) -> str {
    if s.kind == SRecord {
        remit_struct(s)
    } else if s.kind == SSum {
        remit_sum(s)
    } else {
        remit_fn(s)
    }
}

// `Clone` on every record, because Maca records are values and a field access
// or a `with` update reads as a copy at the source level.
remit_struct(s: Stmt) -> str {
    fields = s.params.map(remit_struct_field).join(", ")

    "#[derive(Clone)]\nstruct {s.name} {{ {fields} }}"
}

remit_struct_field(f: Expr) -> str =>
    "{f.text}: {rtype(f.ty)}"

// `use Color::*;` follows the enum so a bare `Green` in the emitted body
// resolves. The AST keeps variant references bare, with no enum to qualify by.
// `PartialEq` is for `==` on a variant, which `remit_binary` passes straight
// through to Rust; a `match` needs no derive at all.
remit_sum(s: Stmt) -> str {
    variants = s.params.map(remit_variant).join(", ")

    "#[derive(Clone, PartialEq)]\nenum {s.name} {{ {variants} }}\n"
        ++ "use {s.name}::*;"
}

// A payload variant is native here (`Circle(i64)`), so `Circle(2)` in the
// source is already a valid constructor call and needs no shim.
remit_variant(v: Expr) -> str {
    if v.children.length() == 0 {
        v.text
    } else {
        "{v.text}({v.children.map(payload_type).join(", ")})"
    }
}

payload_type(p: Expr) -> str =>
    rtype(p.ty)
