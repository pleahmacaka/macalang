// selfhost/emit_rust — a Rust emitter over the AST, written in Maca.
//
// The Maca-written sibling of emit_c: it turns the stage-1 AST into Rust source
// (the `--target rust` back end), so the Rust backend itself is written in Maca
// rather than living only in the stage-0 crate. Mirrors `maca-backend-rust` on
// the slice the stage-1 parser covers: integer/string literals, idents, calls,
// binary operators, function definitions, bindings, and a `main` that exits
// with its returned value. It grows into the full backend the way emit_c does.

import selfhost/token
import selfhost/ast

// A Rust integer literal carries an `i64` suffix, so it isn't inferred as `i32`
// and then clash with Maca's `int` = `i64` in arithmetic.
rust_int(n: int) -> str =>
    "{str(n)}i64"

// An owned Rust string literal (`"…".to_string()`), kept out of interpolation
// so the quoting stays legible.
rust_str(s: str) -> str =>
    "\"" ++ s ++ "\".to_string()"

// Emit a Rust expression for one AST node.
remit_expr(e: Expr) -> str =>
    match e.kind {
        EInt     => rust_int(e.ival)
        EFloat   => "{e.text}_f64"
        EStr     => rust_str(e.text)
        EBool    => e.text
        EIdent   => e.text
        ECall    => remit_call(e)
        EBinary  => remit_binary(e)
        ETernary => remit_ternary(e)
        EUnary   => "({e.text}{remit_expr(e.children.get(0))})"
        ERecord  => "{e.text} {{ {remit_lit_fields(e.children)} }}"
        EField   => "{remit_expr(e.children.get(0))}.{e.text}"
        EMatch   => remit_match(e)
        EMethod  => remit_method(e)
        EList    => "vec![{remit_args(e.children, 0)}]"
        _        => "0i64"
    }

// Rust has no ternary; `if` is already an expression there.
remit_ternary(e: Expr) -> str {
    cond = remit_expr(e.children.get(0))
    then = remit_expr(e.children.get(1))
    els = remit_expr(e.children.get(2))

    "(if {cond} {{ {then} }} else {{ {els} }})"
}

remit_match(e: Expr) -> str =>
    "match {remit_expr(e.children.get(0))} {{ {remit_arms(e.children, 1)} }}"

// A UFCS method call. `.length()` (string) / `.count()` (list) → `.len()`;
// `.get(i)` indexes a `Vec`; `.at(i)` indexes a string's bytes; any other
// method passes through.
remit_method(e: Expr) -> str {
    recv = remit_expr(e.children.get(0))

    if e.text == "length" || e.text == "count" {
        "(({recv}).len() as i64)"
    } else if e.text == "at" {
        idx = remit_expr(e.children.get(1))
        "(({recv}).as_bytes()[({idx}) as usize] as i64)"
    } else if e.text == "get" {
        "{recv}[({remit_expr(e.children.get(1))}) as usize]"
    } else {
        "{recv}.{e.text}({remit_args(e.children, 1)})"
    }
}

// A call. `info`/`print` are the output builtins → `println!`/`print!`; every
// other call is a plain `name(args)`.
remit_call(e: Expr) -> str {
    args = remit_args(e.children, 0)

    if e.text == "info" {
        "println!(\"{{}}\", {args})"
    } else if e.text == "print" {
        "print!(\"{{}}\", {args})"
    } else if e.text == "str" {
        "format!(\"{{}}\", {args})"
    } else {
        "{e.text}({args})"
    }
}

// A binary operator. `++` is string concatenation → `format!("{}{}", a, b)`;
// every other operator is emitted directly.
remit_binary(e: Expr) -> str {
    l = remit_expr(e.children.get(0))
    r = remit_expr(e.children.get(1))

    if e.text == "++" {
        "format!(\"{{}}{{}}\", {l}, {r})"
    } else {
        "({l} {e.text} {r})"
    }
}

// Rust match arms `Red => 1, _ => 0,` — a bare variant pattern resolves through
// the enum's `use Color::*;`.
remit_arms(cs: Expr[], i: int) -> str {
    if i + 1 >= cs.length() {
        ""
    } else {
        arm = "{remit_pat(cs.get(i))} => {remit_expr(cs.get(i + 1))}, "
        arm ++ remit_arms(cs, i + 2)
    }
}

// `Circle(r)` — the binders go straight through, because Rust's own pattern
// syntax is the one Maca borrowed.
remit_pat(p: Expr) -> str {
    if p.children.length() == 0 {
        p.text
    } else {
        "{p.text}({p.children.map(binder_name).join(", ")})"
    }
}

binder_name(b: Expr) -> str =>
    b.text

// Rust struct-literal fields `x: 40, y: 2`. Each rides as
// `EBinary("=", name, value)`.
remit_lit_fields(fs: Expr[]) -> str =>
    fs.map(remit_lit_field).join(", ")

remit_lit_field(f: Expr) -> str =>
    "{f.children.get(0).text}: {remit_expr(f.children.get(1))}"

// Comma-join the emitted arguments from index `i` on.
remit_args(xs: Expr[], i: int) -> str =>
    xs.slice(i, xs.length()).map(remit_expr).join(", ")

// ---- function emission ----------------------------------------------------

// Map a Maca type name to its Rust spelling. Scalars map directly; an empty
// type defaults to `i64`; any other name is a record type used verbatim.
rtype(ty: str) -> str {
    if ty.ends_with("[]") {
        "Vec<i64>"
    } else if ty == "float" {
        "f64"
    } else if ty == "str" {
        "String"
    } else if ty == "bool" {
        "bool"
    } else if ty == "" || ty == "int" {
        "i64"
    } else {
        ty
    }
}

// A function definition. `main` returns an exit code, so it is wrapped the way
// `maca-backend-rust` does: the body becomes `__maca_main`, and a real `main`
// exits with it. Every other function carries its declared parameter and return
// types (via `rtype`). (Literal Rust braces are written `{{`/`}}` so they aren't
// read as Maca string interpolation.)
remit_fn(s: Stmt) -> str {
    body = remit_stmts(s.body, 0)

    if s.name == "main" {
        "fn __maca_main() -> i64 {{ {body} }}\n"
            ++ "fn main() {{ std::process::exit(__maca_main() as i32); }}"
    } else {
        params = s.params.map(remit_param).join(", ")
        "fn {s.name}({params}) -> {rtype(s.ret)} {{ {body} }}"
    }
}

// `a: i64, b: String` from the typed parameter ident nodes.
remit_param(p: Expr) -> str =>
    "{p.text}: {rtype(p.ty)}"

remit_stmts(body: Stmt[], i: int) -> str {
    if i >= body.length() {
        ""
    } else {
        here = remit_stmt(body.get(i), i == body.length() - 1)
        "{here} {remit_stmts(body, i + 1)}"
    }
}

// A binding is a local `let x = e;`; the last expression is the block's tail
// value (no semicolon — Rust returns it), any earlier one a statement.
remit_stmt(s: Stmt, is_last: bool) -> str {
    if s.kind == SBind {
        "let {s.name} = {remit_expr(s.value)};"
    } else if is_last {
        remit_expr(s.value)
    } else {
        "{remit_expr(s.value)};"
    }
}

// A whole module: record `struct` declarations and function definitions, one
// item per line.
remit_module(m: Module) -> str =>
    m.items.map(remit_item).join("\n")

remit_item(s: Stmt) -> str {
    if s.kind == SRecord {
        remit_struct(s)
    } else if s.kind == SSum {
        remit_sum(s)
    } else {
        remit_fn(s)
    }
}

// `#[derive(Clone)] struct Point { x: i64, y: i64 }` from a record declaration.
remit_struct(s: Stmt) -> str {
    fields = s.params.map(remit_struct_field).join(", ")

    "#[derive(Clone)]\nstruct {s.name} {{ {fields} }}"
}

remit_struct_field(f: Expr) -> str =>
    "{f.text}: {rtype(f.ty)}"

// `#[derive(Clone, PartialEq)] enum Color { Red, Green, Blue }` plus a
// `use Color::*;` so a bare variant reference (`Green`) resolves without
// qualification — matching how the emitter leaves variant idents bare.
remit_sum(s: Stmt) -> str {
    variants = s.params.map(remit_variant).join(", ")

    "#[derive(Clone, PartialEq)]\nenum {s.name} {{ {variants} }}\n"
        ++ "use {s.name}::*;"
}

// A payload variant is native here — `Circle(i64)` — so `Circle(2)` in the
// source is already a valid constructor call and needs no shim.
remit_variant(v: Expr) -> str {
    if v.children.length() == 0 {
        v.text
    } else {
        "{v.text}({v.children.map(payload_type).join(", ")})"
    }
}

payload_type(p: Expr) -> str =>
    rtype(p.ty)
