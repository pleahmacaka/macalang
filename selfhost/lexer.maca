// selfhost/lexer — a character-level scanner for Maca, written in Maca.
//
// Recursive/functional (Maca surface has no `while`): `scan` walks a character
// array by index, appending tokens. The `str` primitives it leans on
// (`chars`, `length`, `get`, `slice`, and the `is_*` predicates) are the
// stdlib contract the stage-1 compiler builds on — see std/README.md.

import std/str
import selfhost/token

// ---- character classes ----------------------------------------------------

is_space(c: str) -> bool => c.is_whitespace()
is_digit(c: str) -> bool => c.is_ascii_digit()
is_alpha(c: str) -> bool => c.is_alpha() || c == "_"
is_alnum(c: str) -> bool => is_alpha(c) || is_digit(c)

// ---- span helpers ---------------------------------------------------------

// Consume a run of characters matching `pred` starting at `i`; return the end
// index (exclusive). `pred` is a higher-order parameter (a predicate
// `str -> bool`): the stage-0 backend recognizes an unannotated parameter that
// is called and lowers it as a first-class function value.
run_end(cs: str[], i: int, pred) -> int =>
    i < cs.length() && pred(cs.get(i))
        ? run_end(cs, i + 1, pred)
        : i

// The source text between two indices, as a single string.
span(cs: str[], i: int, j: int) -> str =>
    cs.slice(i, j).join("")

// ---- the scanner ----------------------------------------------------------

lex(src: str) -> Token[] {
    cs = src.chars()
    scan(cs, 0, [])
}

scan(cs: str[], i: int, out: Token[]) -> Token[] =>
    i >= cs.length()
        ? out ++ [mk_token(Eof, "", i)]
        : step(cs, i, out)

step(cs: str[], i: int, out: Token[]) -> Token[] {
    c = cs.get(i)
    match true {
        _ if is_space(c)  => scan(cs, i + 1, out)
        _ if c == "\""    => lex_string(cs, i, out)
        _ if is_digit(c)  => lex_number(cs, i, out)
        _ if is_alpha(c)  => lex_word(cs, i, out)
        _                 => lex_punct(cs, i, out, c)
    }
}

// A double-quoted string literal. `i` sits on the opening quote; the token text
// is the content between the quotes (escapes are left verbatim in this slice).
lex_string(cs: str[], i: int, out: Token[]) -> Token[] {
    j = string_end(cs, i + 1)
    text = span(cs, i + 1, j)
    scan(cs, j + 1, out ++ [mk_token(TStr, text, i)])
}

string_end(cs: str[], i: int) -> int =>
    i < cs.length() && cs.get(i) != "\""
        ? string_end(cs, i + 1)
        : i

lex_word(cs: str[], i: int, out: Token[]) -> Token[] {
    j = run_end(cs, i, is_alnum)
    text = span(cs, i, j)
    scan(cs, j, out ++ [mk_token(keyword_kind(text), text, i)])
}

// A number: integer digits, and — when a `.` is immediately followed by another
// digit — a fractional part, making it a float (`1.5`). A trailing dot with no
// digit after it (`1.`) stays an int and leaves the `.` for the next token.
lex_number(cs: str[], i: int, out: Token[]) -> Token[] {
    j = run_end(cs, i, is_digit)
    is_float = j + 1 < cs.length() && cs.get(j) == "." && is_digit(cs.get(j + 1))
    is_float
        ? lex_float(cs, i, j, out)
        : scan(cs, j, out ++ [mk_token(TInt, span(cs, i, j), i)])
}

lex_float(cs: str[], i: int, dot: int, out: Token[]) -> Token[] {
    k = run_end(cs, dot + 1, is_digit)   // fractional digits after the '.'
    scan(cs, k, out ++ [mk_token(TFloat, span(cs, i, k), i)])
}

// A punctuator: try a two-character operator (`->`, `=>`, `==`, …) first, then
// fall back to a single character. `is_two_char` gates the two-char consume so
// we never mis-read `a - b` as one token.
lex_punct(cs: str[], i: int, out: Token[], c: str) -> Token[] {
    n = cs.length()
    nxt = i + 1 < n ? cs.get(i + 1) : ""
    two = c ++ nxt
    is_two_char(two)
        ? scan(cs, i + 2, out ++ [mk_token(two_char_kind(two), two, i)])
        : scan(cs, i + 1, out ++ [mk_token(punct_kind(c), c, i)])
}

is_two_char(s: str) -> bool =>
    s == "->" || s == "=>" || s == "==" || s == "!=" ||
    s == "<=" || s == ">=" || s == "++" || s == "&&" || s == "||"

two_char_kind(s: str) -> Kind =>
    match s {
        "->" => Arrow
        "=>" => FatArrow
        "==" => EqEq
        "!=" => NotEq
        "<=" => Le
        ">=" => Ge
        "++" => PlusPlus
        "&&" => AmpAmp
        "||" => PipePipe
        _    => TIdent
    }

punct_kind(c: str) -> Kind =>
    match c {
        "(" => LParen
        ")" => RParen
        "[" => LBracket
        "]" => RBracket
        "{{" => LBrace
        "}}" => RBrace
        "," => Comma
        ":" => Colon
        "." => Dot
        "=" => Eq
        "+" => Plus
        "-" => Minus
        "*" => Star
        "/" => Slash
        "%" => Percent
        "|" => Bar
        "?" => Question
        "!" => Bang
        "<" => Lt
        ">" => Gt
        _   => TIdent
    }
