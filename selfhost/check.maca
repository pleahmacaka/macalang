import selfhost/token
import selfhost/ast

Env = {
    names:  str[]
    types:  str[]
    fns:    str[]
    rets:   str[]
    arity:  int[]
    fields: str[]
    ftypes: str[]
    ctors:  str[]
    owners: str[]
}

empty_env() -> Env =>
    Env { names = [], types = [], fns = [], rets = [], arity = [],
          fields = [], ftypes = [], ctors = [], owners = [] }

bind(env: Env, name: str, ty: str) -> Env =>
    env with { names = env.names ++ [name], types = env.types ++ [ty] }

lookup(env: Env, name: str) -> str {
    at = env.names.index_of(name)

    if at < 0 {
        ""
    } else {
        env.types.get(at)
    }
}

env_of_module(m: Module) -> Env =>
    collect_items(m.items, 0, empty_env())

collect_items(items: Stmt[], i: int, env: Env) -> Env {
    if i >= items.length() {
        env
    } else {
        collect_items(items, i + 1, collect_item(items.get(i), env))
    }
}

collect_item(s: Stmt, env: Env) -> Env {
    if s.kind == SFn {
        add_fn(env, s.name, s.ret, s.params.length())
    } else if s.kind == SRecord {
        add_fields(env, s.name, s.params, 0)
    } else if s.kind == SSum {
        add_ctors(env, s.name, s.params, 0)
    } else {
        env
    }
}

add_fn(env: Env, name: str, ret: str, n: int) -> Env =>
    env with { fns = env.fns ++ [name], rets = env.rets ++ [ret],
               arity = env.arity ++ [n] }

add_fields(env: Env, rec: str, fs: Expr[], i: int) -> Env {
    if i >= fs.length() {
        env
    } else {
        key = rec ++ "." ++ fs.get(i).text
        add_fields(add_field(env, key, fs.get(i).ty), rec, fs, i + 1)
    }
}

add_field(env: Env, key: str, ty: str) -> Env =>
    env with { fields = env.fields ++ [key], ftypes = env.ftypes ++ [ty] }

add_ctors(env: Env, sum: str, vs: Expr[], i: int) -> Env {
    if i >= vs.length() {
        env
    } else {
        add_ctors(add_ctor(env, vs.get(i).text, sum), sum, vs, i + 1)
    }
}

add_ctor(env: Env, v: str, sum: str) -> Env =>
    env with { ctors = env.ctors ++ [v], owners = env.owners ++ [sum] }

type_in(e: Expr, env: Env) -> str =>
    match e.kind {
        EInt     => "int"
        EFloat   => "float"
        EStr     => "str"
        EBool    => "bool"
        EIdent   => ident_type(e, env)
        ECall    => call_type(e, env)
        EBinary  => binop_in(e, env)
        ETernary => type_in(e.children.get(1), env)
        EUnary   => type_in(e.children.get(0), env)
        ERecord  => e.text
        EField   => field_type(e, env)
        EMatch   => match_type(e, env)
        EList    => "list"
        _        => "any"
    }

ident_type(e: Expr, env: Env) -> str {
    local = lookup(env, e.text)
    variant = env.ctors.index_of(e.text)

    if local != "" {
        local
    } else if variant >= 0 {
        env.owners.get(variant)
    } else {
        "any"
    }
}

call_type(e: Expr, env: Env) -> str {
    declared = env.fns.index_of(e.text)
    variant = env.ctors.index_of(e.text)

    if declared >= 0 {
        ret_or_any(env.rets.get(declared))
    } else if variant >= 0 {
        env.owners.get(variant)
    } else {
        builtin_type(e.text)
    }
}

ret_or_any(r: str) -> str {
    if r == "" {
        "any"
    } else {
        r
    }
}

builtin_type(name: str) -> str {
    if name == "str" {
        "str"
    } else if name == "int" {
        "int"
    } else if name == "info" || name == "print" {
        "unit"
    } else {
        "any"
    }
}

field_type(e: Expr, env: Env) -> str {
    recv = type_in(e.children.get(0), env)
    at = env.fields.index_of(recv ++ "." ++ e.text)

    if at < 0 {
        "any"
    } else {
        env.ftypes.get(at)
    }
}

match_type(e: Expr, env: Env) -> str {
    if e.children.length() >= 3 {
        type_in(e.children.get(2), env)
    } else {
        "any"
    }
}

binop_in(e: Expr, env: Env) -> str {
    is_cmp = e.text == "==" || e.text == "!=" || e.text == "<"
        || e.text == ">" || e.text == "<=" || e.text == ">="

    if e.text == "++" {
        "str"
    } else if is_cmp {
        "bool"
    } else {
        arith_type(type_in(e.children.get(0), env),
                   type_in(e.children.get(1), env))
    }
}

arith_type(lt: str, rt: str) -> str {
    if lt == "any" || rt == "any" {
        "int"
    } else if lt == rt && (lt == "int" || lt == "float") {
        lt
    } else {
        "error"
    }
}

errors_in(e: Expr, env: Env) -> int {
    mismatch = if type_in(e, env) == "error" { 1 } else { 0 }

    mismatch + arity_error(e, env) + child_errors(e.children, 0, env)
}

child_errors(xs: Expr[], i: int, env: Env) -> int {
    if i >= xs.length() {
        0
    } else {
        errors_in(xs.get(i), env) + child_errors(xs, i + 1, env)
    }
}

arity_error(e: Expr, env: Env) -> int {
    if e.kind != ECall {
        0
    } else {
        declared = env.fns.index_of(e.text)
        wrong_arity(env, declared, e.children.length())
    }
}

wrong_arity(env: Env, declared: int, given: int) -> int {
    if declared < 0 || env.arity.get(declared) == given {
        0
    } else {
        1
    }
}

check_fn_in(s: Stmt, env: Env) -> int {
    inner = bind_params(env, s.params, 0)

    check_body(s.body, 0, inner) + return_error(s, inner)
}

bind_params(env: Env, ps: Expr[], i: int) -> Env {
    if i >= ps.length() {
        env
    } else {
        bound = bind(env, ps.get(i).text, param_ty(ps.get(i).ty))
        bind_params(bound, ps, i + 1)
    }
}

param_ty(ty: str) -> str {
    if ty == "" {
        "any"
    } else {
        ty
    }
}

check_body(stmts: Stmt[], i: int, env: Env) -> int {
    if i >= stmts.length() {
        0
    } else {
        here = errors_in(stmts.get(i).value, env)
        here + check_body(stmts, i + 1, extend(env, stmts.get(i)))
    }
}

extend(env: Env, s: Stmt) -> Env {
    if s.kind == SBind {
        bind(env, s.name, type_in(s.value, env))
    } else {
        env
    }
}

return_error(s: Stmt, env: Env) -> int {
    actual = body_type(s, env)

    if disagrees(s.ret, actual) {
        1
    } else {
        0
    }
}

body_type(s: Stmt, env: Env) -> str {
    if s.body.length() == 0 {
        "any"
    } else {
        last = s.body.get(s.body.length() - 1)
        type_in(last.value, scope_of(s, env))
    }
}

scope_of(s: Stmt, env: Env) -> Env =>
    fold_binds(s.body, 0, s.body.length() - 1, env)

fold_binds(stmts: Stmt[], i: int, stop: int, env: Env) -> Env {
    if i >= stop {
        env
    } else {
        fold_binds(stmts, i + 1, stop, extend(env, stmts.get(i)))
    }
}

disagrees(declared: str, actual: str) -> bool {
    if declared == "" || declared == "any" || actual == "any" {
        false
    } else if actual == "error" {
        false
    } else {
        declared != actual
    }
}

check_module(m: Module) -> int =>
    check_items(m.items, 0, env_of_module(m))

check_items(items: Stmt[], i: int, env: Env) -> int {
    if i >= items.length() {
        0
    } else {
        here = check_item(items.get(i), env)
        here + check_items(items, i + 1, env)
    }
}

check_item(s: Stmt, env: Env) -> int {
    if s.kind == SFn {
        check_fn_in(s, env)
    } else {
        0
    }
}

type_of(e: Expr) -> str =>
    type_in(e, empty_env())

count_errors(e: Expr) -> int =>
    errors_in(e, empty_env())
