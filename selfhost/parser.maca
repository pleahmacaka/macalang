// selfhost/parser — a recursive-descent parser slice, written in Maca.
//
// Consumes the `Token[]` from lexer.maca and produces `Expr` nodes from
// ast.maca. Maca surface has no tuples, so a parse step threads its result as a
// `PExpr { node, next }` record — the parsed node plus the next token index.
//
// This slice covers primaries (int / str / ident / parenthesized), a
// single-argument call, and left-associative `+`/`-`. It is the seed the
// stage-1 parser grows from; gated by the stage-0 front-end.

import selfhost/token
import selfhost/ast

// Result of a parse step: the node plus the next index to read.
PExpr = {
    node: Expr
    next: int
}

mk_pexpr(node: Expr, next: int) -> PExpr =>
    PExpr { node, next }

// Result of parsing a statement / a parameter list (node + next index).
PStmt = {
    snode: Stmt
    snext: int
}
mk_pstmt(snode: Stmt, snext: int) -> PStmt =>
    PStmt { snode, snext }

PParams = {
    params: Expr[]
    pnext: int
}
mk_pparams(params: Expr[], pnext: int) -> PParams =>
    PParams { params, pnext }

// ---- function definitions -------------------------------------------------

// `name(p [: T], …) -> R => expr` — an arrow-bodied top-level function. Types
// are skipped for now (the AST carries params as ident nodes); the body is one
// expression. Grows into full block bodies + typed params.
parse_fn(ts: Token[], i: int) -> PStmt {
    name = ts.get(i).text
    pp = parse_params(ts, i + 2, [])   // i+1 is '(' ; params start at i+2
    afterp = pp.pnext + 1              // skip ')'
    afterret = ts.get(afterp).kind == Arrow ? afterp + 2 : afterp  // skip '-> R'
    body_start = afterret + 1          // skip '=>'
    be = parse_expr(ts, body_start)
    mk_pstmt(s_fn(name, pp.params, [s_expr(be.node)]), be.next)
}

// A whole module: parse top-level function definitions until `Eof`. Whitespace
// (including newlines) is skipped by the lexer, so functions sit back-to-back
// in the token stream and each `parse_fn` returns where the next one begins.
parse_module(ts: Token[], i: int, acc: Stmt[]) -> Module =>
    ts.get(i).kind == Eof
        ? Module { items = acc }
        : parse_module_step(ts, i, acc)

parse_module_step(ts: Token[], i: int, acc: Stmt[]) -> Module {
    ps = parse_fn(ts, i)
    parse_module(ts, ps.snext, acc ++ [ps.snode])
}

// Parse a comma-separated parameter list up to the closing `)`.
parse_params(ts: Token[], i: int, acc: Expr[]) -> PParams =>
    ts.get(i).kind == RParen
        ? mk_pparams(acc, i)
        : parse_one_param(ts, i, acc)

parse_one_param(ts: Token[], i: int, acc: Expr[]) -> PParams {
    pname = ts.get(i).text
    nacc = acc ++ [e_ident(pname)]
    after = ts.get(i + 1).kind == Colon ? i + 3 : i + 1   // skip optional ': T'
    ts.get(after).kind == Comma
        ? parse_params(ts, after + 1, nacc)
        : parse_params(ts, after, nacc)
}

// expr := precedence-climbing over primaries. `prec_of` gives each binary
// operator its binding power (0 = not an operator); `parse_bin` consumes
// operators of at least `min_prec`, recursing at `p + 1` for left-associative
// binding — so `a + b * c` parses correctly as `a + (b * c)`.
prec_of(k: Kind) -> int =>
    k == Star || k == Slash
        ? 3
        : k == Plus || k == Minus || k == PlusPlus
            ? 2
            : k == EqEq || k == NotEq || k == Lt || k == Gt || k == Le || k == Ge
                ? 1
                : 0

parse_expr(ts: Token[], i: int) -> PExpr =>
    parse_bin(ts, parse_primary(ts, i), 1)

parse_bin(ts: Token[], lhs: PExpr, min_prec: int) -> PExpr {
    p = prec_of(ts.get(lhs.next).kind)
    p < min_prec
        ? lhs
        : climb(ts, lhs, p, min_prec)
}

climb(ts: Token[], lhs: PExpr, p: int, min_prec: int) -> PExpr {
    op = ts.get(lhs.next).text
    rhs = parse_bin(ts, parse_primary(ts, lhs.next + 1), p + 1)
    node = e_binary(op, lhs.node, rhs.node)
    parse_bin(ts, mk_pexpr(node, rhs.next), min_prec)
}

// primary := int | str | ident [call] | '(' expr ')'
parse_primary(ts: Token[], i: int) -> PExpr {
    t = ts.get(i)
    match t.kind {
        TInt   => mk_pexpr(e_int(int(t.text)), i + 1)
        TStr   => mk_pexpr(e_str(t.text), i + 1)
        TIdent => parse_call_or_ident(ts, i)
        LParen => parse_paren(ts, i)
        _      => mk_pexpr(e_ident("?"), i + 1)
    }
}

parse_paren(ts: Token[], i: int) -> PExpr {
    inner = parse_expr(ts, i + 1)
    mk_pexpr(inner.node, inner.next + 1)   // skip the closing ')'
}

parse_call_or_ident(ts: Token[], i: int) -> PExpr {
    name = ts.get(i).text
    ts.get(i + 1).kind == LParen
        ? parse_call(ts, i, name)
        : mk_pexpr(e_ident(name), i + 1)
}

// `name ( arg )` — one argument in this slice
parse_call(ts: Token[], i: int, name: str) -> PExpr {
    arg = parse_expr(ts, i + 2)
    mk_pexpr(e_call(name, [arg.node]), arg.next + 1)
}
