// selfhost/token — the token model for the Maca-in-Maca compiler (stage 1).
//
// Written in Maca. Compiled by the stage-0 Rust `maca` today; the goal is for a
// built stage-1 to compile this same source. Gated in CI by the stage-0
// parser + checker (see crates/driver/tests/selfhost.rs).

// Nullary variants only, so this lowers to a plain C enum and a token stays a
// value the emitters can compare with `==`.
Kind =
    TInt | TFloat | TIdent | TStr | TPath
    | KwLet | KwIf | KwElse | KwFor | KwIn | KwMatch
    | KwImport | KwFrom | KwWith | KwFail | KwTry | KwAlias
    | KwTrue | KwFalse
    | LParen | RParen | LBracket | RBracket | LBrace | RBrace
    | Comma | Colon | Dot | Arrow | FatArrow
    | Eq | EqEq | NotEq | Lt | Gt | Le | Ge | AmpAmp | PipePipe
    | Plus | Minus | Star | Slash | Percent | PlusPlus | Bar
    | Question | QuestionPost | Bang
    | Newline | Eof

Token = {
    kind: Kind
    text: str
    pos:  int
}

keyword_kind(w: str) -> Kind =>
    match w {
        "let"    => KwLet
        "if"     => KwIf
        "else"   => KwElse
        "for"    => KwFor
        "in"     => KwIn
        "match"  => KwMatch
        "import" => KwImport
        "from"   => KwFrom
        "with"   => KwWith
        "fail"   => KwFail
        "try"    => KwTry
        "alias"  => KwAlias
        "true"   => KwTrue
        "false"  => KwFalse
        _        => TIdent
    }


mk_token(kind: Kind, text: str, pos: int) -> Token =>
    Token { kind, text, pos }
