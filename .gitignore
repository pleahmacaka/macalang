/target

# generated dev-shell flake; regenerate locally with `maca dev` (source is dev.maca)
/flake.nix

# generated build artifacts (compiler/toolchain outputs never live in the repo)
apps/playground/maca_wasm.wasm
apps/npm/maca_wasm.wasm

# per-file build outputs from `maca build --target js|jvm|embedded` run in-tree
*.js/
*-jvm/
*-fw/
/maca_modules/
__pycache__/

# Tomo's generated book output (rebuild with `maca run apps/tomo/tomo.maca`)
apps/tomo/site/

# `maca build --target js playground.maca -o out` output (built by CI for Pages)
apps/playground/out/

# `apps/build_site` output
_site/

# scratch space the toolchain writes in a project: the dev-shell scripts from
# `maca dev`, and the entry module `maca -m` generates and removes.
/.maca/

# corpus outputs: other people's source, and this repository's to generate
# rather than to carry.
apps/corpus/collected/
apps/corpus/corpus.jsonl
apps/corpus/failures.jsonl
