// Nested array types are emitted in dependency order.
//
// `IntArrArr`'s element is `IntArr`, so the inner type has to be complete
// first. The element set is a hash set, so before it was sorted whether
// `int[][]` compiled at all depended on the iteration order.

main() -> int {
    grid: int[][] = []
    for i in 1..3 {
        row = []
        for j in 1..3 {
            row = row.push(i * j)
        }
        grid = grid.push(row)
    }

    assert_eq(str(grid.length()), "3", "three rows")
    assert_eq(str(grid.get(2).get(2)), "9", "the last cell of the last row")

    failures()
}
