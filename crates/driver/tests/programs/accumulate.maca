Box = { items: int[] }

size_of(xs: int[]) -> int => xs.length()

add_all(dst: int[], src: int[]) -> int[] {
    for v in src {
        dst = dst.push(v)
    }
    dst
}

build(n: int) -> int[] {
    out: int[] = []
    for i in 1..n {
        out = out.push(i)
    }
    out
}

split_evens(n: int) -> int {
    evens: int[] = []
    odds: int[] = []
    for i in 1..n {
        if i % 2 == 0 {
            evens = evens.push(i)
        } else {
            odds = odds.push(i)
        }
    }
    evens.length() * 100 + odds.length()
}

test_an_accumulator_does_not_rebuild_itself_every_round() {
    before = alloc_count() + reuse_count()
    big = build(2000)
    spent = alloc_count() + reuse_count() - before

    assert_eq(str(big.length()), "2000", "every round is in it")
    assert(spent < 40, "grew in place: {spent} allocations for 2000 elements")
}

test_a_second_holder_costs_a_copy_a_round() {
    base: int[] = []
    keep = base
    before = alloc_count() + reuse_count()
    for i in 1..200 {
        base = base.push(i)
    }
    spent = alloc_count() + reuse_count() - before

    assert_eq(str(base.length()), "200", "still correct")
    assert_eq(str(keep.length()), "0", "and the other name did not move")
    assert(spent > 200, "copied every round: {spent} allocations for 200 elements")
}

test_an_accumulator_collects_every_value() {
    out = build(6)

    assert_eq(str(out.length()), "6", "one per round")
    assert_eq(str(out.get(0)), "1", "the first")
    assert_eq(str(out.get(5)), "6", "and the last")
}

test_two_accumulators_do_not_mix() {
    assert_eq(str(split_evens(10)), "505", "five even, five odd")
}

test_a_copy_is_kept_when_another_name_holds_the_list() {
    a = [1, 2]
    b = a
    a = a.push(3)

    assert_eq(str(a.length()), "3", "the one appended to grew")
    assert_eq(str(b.length()), "2", "and the other did not")
}

test_a_copy_is_kept_after_the_list_is_passed_to_a_function() {
    c = [1, 2]
    n = size_of(c)
    c = c.push(3)

    assert_eq(str(n), "2", "what the function saw")
    assert_eq(str(c.length()), "3", "and what the caller has now")
}

test_a_copy_is_kept_when_a_record_holds_the_list() {
    d = [1, 2]
    held = Box { items = d }
    d = d.push(3)

    assert_eq(str(d.length()), "3", "the local grew")
    assert_eq(str(held.items.length()), "2", "the record did not")
}

test_appending_to_the_list_being_iterated_reads_the_original() {
    f: int[] = []
    for i in 1..8 {
        f = f.push(i)
    }
    seen = 0
    for x in f {
        f = f.push(x)
        seen = seen + x
    }

    assert_eq("{seen}", "36", "the loop saw one through eight, and nothing else")
    assert_eq("{f.length()}", "16", "eight appended, from the eight there were")
    assert_eq("{f.get(8)}", "1", "and they are the originals, in order")
}

test_a_parameter_is_the_callers_list() {
    a = [1, 2, 3, 4]
    b = [7, 8]
    c = add_all(a, b)

    assert_eq("{c.length()}", "6", "the helper built the whole thing")
    assert_eq("{a.get(0)}", "1", "and the caller's list is untouched")
    assert_eq("{a.get(3)}", "4", "all of it")
}

test_a_copy_is_kept_when_the_accumulator_started_as_an_alias() {
    base = [1, 2]
    g = base
    for i in 1..40 {
        g = g.push(i)
    }

    assert_eq("{g.length()}", "42", "the copy grew")
    assert_eq("{base.get(0)}", "1", "the original still reads")
    assert_eq("{base.get(1)}", "2", "both of it")
}

test_strings_accumulate_the_same_way() {
    words: str[] = []
    for i in 1..4 {
        words = words.push("w{i}")
    }

    assert_eq(words.join(","), "w1,w2,w3,w4", "every one, in order")
}

test_a_list_literal_may_hold_a_list() {
    e = [1, 2]
    nested = [e]

    assert_eq("{nested.length()}", "1", "one row")
    assert_eq("{nested.get(0).length()}", "2", "holding two")
}

test_a_list_of_lists_accumulates() {
    rows: int[][] = []
    for i in 1..3 {
        row: int[] = []
        for j in 1..3 {
            row = row.push(i * j)
        }
        rows = rows.push(row)
    }

    assert_eq(str(rows.length()), "3", "three rows")
    assert_eq(str(rows.get(2).get(2)), "9", "and the last cell")
}

main() -> int {
    test_an_accumulator_does_not_rebuild_itself_every_round()
    test_a_second_holder_costs_a_copy_a_round()
    test_an_accumulator_collects_every_value()
    test_two_accumulators_do_not_mix()
    test_a_copy_is_kept_when_another_name_holds_the_list()
    test_a_copy_is_kept_after_the_list_is_passed_to_a_function()
    test_a_copy_is_kept_when_a_record_holds_the_list()
    test_appending_to_the_list_being_iterated_reads_the_original()
    test_a_parameter_is_the_callers_list()
    test_a_copy_is_kept_when_the_accumulator_started_as_an_alias()
    test_strings_accumulate_the_same_way()
    test_a_list_literal_may_hold_a_list()
    test_a_list_of_lists_accumulates()

    failures()
}
