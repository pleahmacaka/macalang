import std/proc
import { join } from std/path
import { between, split_once } from std/text
import { Result, median_ms } from bench/time
import { load, find } from bench/store
import { kernels, langs, params, case_name } from apps/bench/run
import { bar_width, ms_text, ratio, standing, timing } from apps/site/home
import { Standing, losses, verified, all_verified } from apps/site/home
import { timed_runs, StartChapter, BenchData, BenchReport } from apps/site/home
import { chip_tone, is_behind, mine_tone } from apps/site/home
import { copies, english, korean } from apps/site/home

maca() -> str =>
    env_or("MACA", "target/release/maca")

Out = "/tmp/maca-site-home"

built() -> str {
    remove_dir(Out)
    make_dir(Out)
    run(maca(), ["run", "apps/site/home.maca", Out])
    Out
}

root() -> str =>
    read_file(join(built(), "index.html"))

/// The benchmark argument is its own document now, so the assertions about it describe that page.
bench_page() -> str =>
    read_file(join(join(built(), "en"), "benchmarks.html"))

runs() -> Result[] =>
    load(BenchData)

Kernel = "fib"

pair(mine: int, base: int) -> Result[] =>
    [sample(case_name(Kernel, "Maca"), mine, 42),
     sample(case_name(Kernel, "C"), base, 42)]

sample(name: str, ms: int, answer: int) -> Result =>
    Result { name = name, size = 1, iters = 1, samples = [ms],
             checksum = answer }

word(rs: Result[]) -> str =>
    match standing(rs, Kernel) {
        Ahead  => "ahead"
        Level  => "level"
        Behind => "behind"
        Absent => "absent"
    }

test_a_difference_under_the_tolerance_is_not_a_difference() {
    assert_eq(word(pair(104, 100)), "level", "4% behind is noise")
    assert_eq(word(pair(96, 100)), "level", "so is 4% ahead")
    assert_eq(word(pair(108, 100)), "behind", "8% behind is not")
    assert_eq(word(pair(92, 100)), "ahead", "nor 8% ahead")
}

test_the_ratio_is_over_c() {
    assert_eq("{ratio(pair(200, 100), Kernel):.1}", "2.0", "twice C's time")
    assert_eq("{ratio(pair(50, 100), Kernel):.1}", "0.5", "half of it")
    assert_eq("{ratio(pair(100, 100), Kernel):.1}", "1.0", "level")
}

test_a_bar_is_the_share_of_the_slower_time() {
    assert_eq(str(bar_width(259.0, 259.0)), "100", "the slower bar fills")
    assert_eq(str(bar_width(97.0, 259.0)), "37", "the faster one is its share")
    assert_eq(str(bar_width(1.0, 200.0)), "2", "a tiny share still draws")
    assert_eq(str(bar_width(-1.0, 200.0)), "0", "a missing time draws nothing")
    assert_eq(str(bar_width(200.0, 0.0)), "0", "nor does one over nothing")
}

test_a_toolchain_the_host_lacked_is_a_hole_not_a_zero() {
    lonely = [sample(case_name(Kernel, "Maca"), 100, 42)]

    assert_eq(word(lonely), "absent", "no C, no comparison")
    assert(timing(lonely, Kernel, "C") < 0.0, "and no time to draw")
    assert_eq(ms_text(timing(lonely, Kernel, "C")), "n/a", "which it says")
    assert_eq(ms_text(168.0), "168 ms", "against a time it has")
}

test_columns_that_disagree_are_not_verified() {
    disagreeing = [sample(case_name(Kernel, "Maca"), 100, 42),
                   sample(case_name(Kernel, "C"), 100, 43)]

    assert(verified(pair(100, 100), Kernel), "one answer, verified")
    assert(!verified(disagreeing, Kernel), "two answers, not")
    assert(all_verified(runs()), "and the stored run agrees with itself")
}

test_every_measured_number_is_on_the_page() {
    page = bench_page()
    rs = runs()

    assert_eq(absent_cells(page, rs, kernels(), 0, []).join(", "), "",
              "every kernel in every language, as measured")
}

absent_cells(page: str, rs: Result[], ks: str[], i: int,
             acc: str[]) -> str[] {
    if i >= ks.length() {
        acc
    } else {
        absent_cells(page, rs, ks, i + 1,
                     acc ++ absent_langs(page, rs, ks.get(i), langs(), 0, []))
    }
}

absent_langs(page: str, rs: Result[], algo: str, ls: str[], i: int,
             acc: str[]) -> str[] {
    if i >= ls.length() {
        acc
    } else if page.contains(cell(rs, algo, ls.get(i))) {
        absent_langs(page, rs, algo, ls, i + 1, acc)
    } else {
        absent_langs(page, rs, algo, ls, i + 1,
                     acc.push(case_name(algo, ls.get(i))))
    }
}

cell(rs: Result[], algo: str, lang: str) -> str {
    ms = timing(rs, algo, lang)
    base = timing(rs, algo, "C")

    "{ms:.0} (×{ms / base:.1})"
}

test_each_column_is_under_its_own_language() {
    page = bench_page()
    rs = runs()
    want = [english().tbl_kernel, english().tbl_workload] ++ langs()

    assert_eq(column_labels(page).join(" | "), want.join(" | "),
              "the header names the kernel, the workload, then each language")
    assert_eq(misplaced(page, rs, kernels(), 0, []).join("; "), "",
              "and every measurement sits under its own language")
}

column_labels(page: str) -> str[] =>
    row_cells(between(bench_table(page), "<thead>", "</thead>"))

bench_table(page: str) -> str =>
    between(page, "<table", "</table>")

row_cells(row: str) -> str[] =>
    but_last(row.replace("</th>", "</td>").split("</td>"), 0, [])

but_last(parts: str[], i: int, acc: str[]) -> str[] {
    if i + 1 >= parts.length() {
        acc
    } else {
        but_last(parts, i + 1, acc.push(after_tag(parts.get(i))))
    }
}

after_tag(frag: str) -> str {
    parts = frag.split(">")

    parts.get(parts.length() - 1)
}

kernel_cells(page: str, algo: str) -> str[] =>
    row_for(between(bench_table(page), "<tbody>", "</tbody>").split("<tr>"),
            0, algo)

row_for(rows: str[], i: int, algo: str) -> str[] {
    if i >= rows.length() {
        []
    } else if first_cell(rows.get(i)) == algo {
        row_cells(rows.get(i))
    } else {
        row_for(rows, i + 1, algo)
    }
}

first_cell(row: str) -> str {
    cs = row_cells(row)

    if cs.length() == 0 {
        ""
    } else {
        cs.get(0)
    }
}

misplaced(page: str, rs: Result[], ks: str[], i: int, acc: str[]) -> str[] {
    if i >= ks.length() {
        acc
    } else {
        misplaced(page, rs, ks, i + 1,
                  acc ++ off_column(rs, ks.get(i),
                                    kernel_cells(page, ks.get(i)),
                                    langs(), 0, []))
    }
}

off_column(rs: Result[], algo: str, cs: str[], ls: str[], j: int,
           acc: str[]) -> str[] {
    if j >= ls.length() {
        acc ++ off_workload(algo, cs)
    } else if at(cs, j + 2) == cell(rs, algo, ls.get(j)) {
        off_column(rs, algo, cs, ls, j + 1, acc)
    } else {
        off_column(rs, algo, cs, ls, j + 1,
                   acc.push("{case_name(algo, ls.get(j))} column holds"
                            ++ " \"{at(cs, j + 2)}\""))
    }
}

off_workload(algo: str, cs: str[]) -> str[] {
    if at(cs, 1) == params(algo) {
        []
    } else {
        ["{algo}'s workload column holds \"{at(cs, 1)}\""]
    }
}

at(cs: str[], i: int) -> str {
    if i >= cs.length() {
        ""
    } else {
        cs.get(i)
    }
}

test_the_bars_are_drawn_from_the_measurements() {
    page = bench_page()
    rs = runs()
    mine = timing(rs, "sieve", "Maca")
    base = timing(rs, "sieve", "C")
    worst = mine > base ? mine : base

    assert(mine > base, "sieve is the row where the two differ")
    assert(page.contains("style=\"width:{bar_width(mine, worst)}%\""),
           "maca's bar is its share of the row")
    assert(page.contains("style=\"width:{bar_width(base, worst)}%\""),
           "and c's is its own")
    assert(page.contains(ms_text(mine)), "the slower label")
    assert(page.contains(ms_text(base)), "and the faster one")
}

test_the_page_says_where_maca_loses() {
    page = bench_page()
    rs = runs()
    lost = losses(rs)

    assert(lost.length() > 0, "there is a kernel behind C to own up to")
    assert_eq(str(occurrences(page, "slower than C")), str(lost.length()),
              "every one of them is marked slower")
    assert(all_named(page, lost, 0), "and named in the note")
    assert_eq(worst_of(rs, lost, 0, ""), Explained,
              "the one the note explains is still the largest of them")
    assert(only_trailing(rs, lost, 0), "and the rest still only trail")
    assert(page.contains("bound by memory bandwidth"), "the note says why")
}

all_named(page: str, ks: str[], i: int) -> bool {
    if i >= ks.length() {
        true
    } else if !page.contains(">" ++ ks.get(i) ++ "</code>") {
        false
    } else {
        all_named(page, ks, i + 1)
    }
}

worst_of(rs: Result[], ks: str[], i: int, worst: str) -> str {
    if i >= ks.length() {
        worst
    } else if worst == "" || ratio(rs, ks.get(i)) > ratio(rs, worst) {
        worst_of(rs, ks, i + 1, ks.get(i))
    } else {
        worst_of(rs, ks, i + 1, worst)
    }
}

Explained = "sieve"

only_trailing(rs: Result[], ks: str[], i: int) -> bool {
    if i >= ks.length() {
        true
    } else if ks.get(i) == Explained || ratio(rs, ks.get(i)) < 1.2 {
        only_trailing(rs, ks, i + 1)
    } else {
        false
    }
}

occurrences(haystack: str, needle: str) -> int =>
    haystack.split(needle).length() - 1

test_a_kernel_behind_c_is_drawn_unlike_one_that_is_not() {
    page = bench_page()
    rs = runs()
    lost = losses(rs)
    same = not_behind(rs, kernels(), 0)

    assert(lost.length() > 0, "there is a kernel behind C")
    assert(same != "", "and one that is not")
    assert(mine_tone(rs, lost.get(0)) != mine_tone(rs, same),
           "their bars are not drawn the same")
    assert(chip_tone(rs, lost.get(0)) != chip_tone(rs, same),
           "nor are their verdicts")
    assert_eq(str(occurrences(page, mine_tone(rs, lost.get(0)))),
              str(lost.length()),
              "and the page draws that accent once per loss")
}

not_behind(rs: Result[], ks: str[], i: int) -> str {
    if i >= ks.length() {
        ""
    } else if is_behind(rs, ks.get(i)) {
        not_behind(rs, ks, i + 1)
    } else {
        ks.get(i)
    }
}

test_every_kernel_and_language_is_named() {
    page = bench_page()

    assert(all_present(page, kernels(), 0), "every kernel")
    assert(all_present(page, workloads(kernels(), 0, []), 0), "its workload")
    assert(all_present(page, langs(), 0), "and every contender")
}

workloads(ks: str[], i: int, acc: str[]) -> str[] {
    if i >= ks.length() {
        acc
    } else {
        workloads(ks, i + 1, acc.push(params(ks.get(i))))
    }
}

all_present(page: str, wanted: str[], i: int) -> bool {
    if i >= wanted.length() {
        true
    } else if !page.contains(escaped(wanted.get(i))) {
        false
    } else {
        all_present(page, wanted, i + 1)
    }
}

escaped(text: str) -> str =>
    text

test_the_page_states_where_the_numbers_came_from() {
    page = bench_page()
    host = between(read_file(BenchReport), "_Host: ", ". Times")

    assert(host != "", "the harness recorded a host")
    assert(page.contains(host), "and the page names that one")
    assert(page.contains("{timed_runs(runs())} per language"),
           "how many runs each contender got")
    assert(page.contains("maca run apps/bench/run.maca"), "how to re-run it")
    assert(page.contains("cc -O2"), "and the flags C was built at")
}

test_get_started_leads_into_the_handbook() {
    dir = built()
    page = read_file(join(dir, "index.html"))
    ko = read_file(join(dir, "ko/home.html"))

    assert(page.contains("href=\"en/{StartChapter}.html\""),
           "the english button opens the english chapter")
    assert(ko.contains("href=\"../ko/{StartChapter}.html\""),
           "and the korean one the korean chapter")
    assert(!page.contains("href=\"#install\""),
           "nothing points down the page any more")
    assert(page.contains("id=\"install\""),
           "though the band with the one command is still there")
}

test_the_chapter_it_opens_is_published_in_every_language() {
    toml = read_file("apps/tomo/book.toml")

    assert(toml.contains("\"{StartChapter}\""), "the book lists the chapter")
    assert(chapters_exist(copies(), 0), "and has it in every language")
    assert(read_file(chapter("en")).contains("maca-install"),
           "and it is the chapter that says how to install")
}

chapters_exist(cs: Copy[], i: int) -> bool {
    if i >= cs.length() {
        true
    } else if file_size(chapter(cs.get(i).lang)) <= 0 {
        false
    } else {
        chapters_exist(cs, i + 1)
    }
}

chapter(lang: str) -> str =>
    "apps/tomo/book/" ++ lang ++ "/" ++ StartChapter ++ ".md"

test_the_korean_page_carries_the_same_benchmark() {
    ko = read_file(join(built(), "ko/benchmarks.html"))

    assert(ko.contains(korean().bench_title), "the heading, in Korean")
    assert(ko.contains(korean().tbl_note), "the table's unit note too")
    assert(ko.contains("C보다 느림"), "and it says where Maca is slower")
    assert(ko.contains(cell(runs(), "sieve", "Maca")),
           "over the same measurement")
}

test_every_utility_on_the_page_has_a_rule() {
    page = root()
    sheet = between(page, "<style>", "</style>").replace("\\", "")

    assert(sheet.length() > 0, "the page carries a stylesheet")
    assert_eq(unruled(sheet, mentioned(page), 0, []).join(", "), "",
              "every class on the page has a rule")
}

mentioned(page: str) -> str[] =>
    named(page.split(" class=\""), 1, [])

named(parts: str[], i: int, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else {
        named(parts, i + 1, acc ++ split_once(parts.get(i), "\"").get(0)
                                      .split(" "))
    }
}

unruled(sheet: str, cs: str[], i: int, acc: str[]) -> str[] {
    if i >= cs.length() {
        acc
    } else if has_rule(sheet, cs.get(i)) {
        unruled(sheet, cs, i + 1, acc)
    } else {
        unruled(sheet, cs, i + 1, acc.push(cs.get(i)))
    }
}

has_rule(sheet: str, class: str) -> bool {
    sel = "." ++ class

    class.starts_with("language-") || sheet.contains(sel ++ " ")
        || sheet.contains(sel ++ ":") || sheet.contains(sel ++ "[")
}

test_the_examples_on_the_front_page_are_highlighted() {
    page = root()

    assert(page.contains("<span class=\"tok-kw\">"),
           "a keyword is a token, not escaped text")
    assert(page.contains("<span class=\"tok-str\">"),
           "and so is a string literal")
    assert(between(page, "code-dark", "</pre>").contains("tok-kw"),
           "the hero panel is highlighted")
    assert(between(page, "language-maca", "</pre>").contains("tok-kw"),
           "and so is the first feature card")
}

test_the_always_dark_panel_gets_the_dark_palette() {
    page = root()

    assert(page.contains(".code-dark .tok-str \{ color: #a5d6ff \}"),
           "the dark palette is emitted for the always-dark surface")
    assert(between(page, "<pre class=\"", "\"").contains("code-dark"),
           "and the hero panel asks for it")
}

test_the_wide_table_scrolls_inside_its_own_box() {
    page = bench_page()

    assert(page.contains("overflow-x-auto\"><table"),
           "the table is inside a scroller")
    assert(between(page, "<table", "</table>").contains("whitespace-nowrap"),
           "and its cells do not wrap out of it")
}
