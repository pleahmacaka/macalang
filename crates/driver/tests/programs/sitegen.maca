// The front page and the API reference, run and inspected.
//
// Both are Maca programs that write HTML, so the thing to assert is the HTML
// they wrote. This runs each into a temporary directory and reads it back.
//
// Run from the repository root, which is where `maca` and the sources are:
//
//   maca test crates/driver/tests/programs/sitegen.maca

import std/fs
import std/path
import std/text
import std/list
import std/proc
// The site's own font installer, so the layout assembled here is the layout
// the build produces rather than a second copy of it.
import { install_fonts } from tools/build-site
// The handbook renderer, so the pages checked below are the pages the book
// publishes. `tomo.maca`'s own `main` writes into `apps/tomo/site`, which is
// the tree `crates/driver/tests/tomo.rs` builds and reads: calling `build_book`
// puts this suite's copy somewhere of its own.
import { build_book } from apps/tomo/tomo

// The compiler these programs are run with. The Rust runner passes the one
// `cargo test` just built; running this file by hand picks up the release
// binary. Hardcoding `target/release/maca` made the whole suite skip in CI,
// where the test job has no reason to have built one.
maca() -> str =>
    env_or("MACA", "target/release/maca")

Out = "/tmp/maca-sitegen"

// ---- the front page ---------------------------------------------------------

front_page_dir() -> str {
    dir = join(Out, "home")
    remove_dir(dir)
    run(maca(), ["run", "apps/site/home.maca", dir])
    dir
}

test_front_page_writes_every_language() {
    dir = front_page_dir()

    assert(file_size(join(dir, "index.html")) > 0, "root page")
    assert(file_size(join(dir, "en/home.html")) > 0, "english landing")
    assert(file_size(join(dir, "ko/home.html")) > 0, "korean landing")
}

// The three links `tools/build-site.maca` requires of a root page. They are
// asserted there against the assembled site; asserted here against the page
// that produces them, so a broken link is caught before a full site build.
test_root_page_links_the_site() {
    root = read_file(join(front_page_dir(), "index.html"))

    assert(root.contains("href=\"en/index.html\""), "handbook link")
    assert(root.contains("href=\"ko/home.html\""), "korean landing link")
    assert(root.contains("href=\"play/index.html\""), "playground link")
    assert(root.contains("href=\"api/index.html\""), "api link")
}

// The page exists to answer three questions a reader asks before anything
// else (statically or dynamically typed, garbage collected or not,
// interpreted or compiled), and to answer them where they can be read rather
// than inferred. Each has to be stated in words on the page itself.
test_the_page_puts_the_language_in_a_box() {
    root = read_file(join(front_page_dir(), "index.html"))

    assert(root.contains("Statically typed"), "says whether it is typed")
    assert(root.contains("no garbage collector"), "says whether it collects")
    assert(root.contains("native binary"), "says what it compiles to")
    assert(root.contains("Static, inferred"), "and again in the spec strip")
    assert(root.contains("Refcounted at compile time"), "how memory is freed")
}

// The same three answers, in Korean. A translated page that dropped them would
// leave a Korean reader with the pitch and none of the decisions.
test_the_korean_page_answers_the_same_questions() {
    ko = read_file(join(front_page_dir(), "ko/home.html"))

    assert(ko.contains("정적 타입"), "typed")
    assert(ko.contains("가비지 컬렉터 없음"), "not collected")
    assert(ko.contains("네이티브 바이너리"), "compiled to a binary")
}

// A landing page with no code on it is a brochure. This one shows a whole
// program, marked as Maca for a highlighter, plus one sample per claim.
test_the_page_shows_code() {
    root = read_file(join(front_page_dir(), "index.html"))

    assert(root.contains("language-maca"), "a Maca sample")
    assert(root.contains("language-sh"), "and the install line is shell")
    assert(root.contains("Shape = Circle(float)"), "the hero program")
    assert_eq(str(count(root, "<pre class=")), "6", "hero + 4 cards + install")
}

// A `<title>` was being derived by `sub.slice(0, 60)`, which cuts a UTF-8
// sequence in half: the Korean page's tab title ended in a replacement
// character. Every title is written out in full now, in its own language.
test_titles_are_whole_and_translated() {
    dir = front_page_dir()
    en = title_of(read_file(join(dir, "index.html")))
    ko = title_of(read_file(join(dir, "ko/home.html")))

    assert(en.starts_with("Maca: "), "english title")
    assert(ko.starts_with("Maca: "), "korean title")
    assert(en != ko, "titles differ")
    assert(!en.ends_with("…"), "title not truncated")
    assert(ko.ends_with("언어"), "korean title is whole")
}

title_of(page: str) -> str =>
    between(page, "<title>", "</title>")

// The install line is piped into a shell, so the URL it names has to be one
// that exists. `install.sh` states the canonical form; the page must agree.
test_install_line_matches_install_sh() {
    root = read_file(join(front_page_dir(), "index.html"))
    url = install_url(read_lines("install.sh"), 0)

    assert(url != "", "install.sh names a url")
    assert(root.contains(url), "page names the same url")
}

// The `curl … | bash` line in the script's own header comment.
install_url(ls: str[], i: int) -> str {
    if i >= ls.length() {
        ""
    } else if ls.get(i).contains("https://raw.githubusercontent.com") {
        between(ls.get(i), "https://", " ")
    } else {
        install_url(ls, i + 1)
    }
}

// Both languages carry every card. The checker enforces it: `Topic`, `Spec`
// and `Caveat` are sum types and each language answers a `match`, so this is
// the executed form of that claim.
test_both_languages_carry_every_card() {
    dir = front_page_dir()
    en = read_file(join(dir, "index.html"))
    ko = read_file(join(dir, "ko/home.html"))

    assert_eq(str(count(en, "<article class=")), "4", "en cards")
    assert_eq(str(count(ko, "<article class=")), "4", "ko cards")
    assert_eq(str(count(en, "<li class=")), "3", "en caveats")
    assert_eq(str(count(ko, "<li class=")), "3", "ko caveats")
}

// ---- the code on the page ---------------------------------------------------
//
// `apps/site/home.maca` says of its samples "each is a program that compiles".
// Nothing checked it, and three of the five are fragments (a function with no
// `main`, a call to a `get` defined nowhere), so the claim was only true of the
// two that happened to be whole programs. Each is compiled here with the
// context a reader would supply, which is what the claim actually means.

Samples = "/tmp/maca-sitegen/samples"

test_the_hero_program_runs() {
    src = sample_source("HeroSample")

    assert(src.contains("Shape = Circle(float)"), "found the sample")
    assert_eq(run_sample("hero", src), "floor plan: 15.14 m²", "it runs")
}

// What a reader supplies around each fragment: the function it calls, the
// record it updates, and the `main` that runs it.
AsyncContext = """

get(url: str) -> int => url.length()

main() -> int {
    n = fetch_both("ab", "cde")
    info("{n}")
    0
}
"""

MarkupContext = """

main() -> int {
    info(card("Hi"))
    0
}
"""

ValuePreamble = """Point = { x: int, y: int }

"""

ValueContext = """

main() -> int {
    q = shift(Point { x = 1, y = 2 }, 4)
    info("{q.x}")
    0
}
"""

test_every_sample_compiles_with_its_context() {
    assert(compiles("async", sample_source("AsyncSample") ++ AsyncContext),
           "the async sample")
    assert(compiles("markup", sample_source("MarkupSample") ++ MarkupContext),
           "the markup sample")
    assert(compiles("value", ValuePreamble ++ sample_source("ValueSample")
                             ++ ValueContext),
           "the record-update sample")
}

// The config sample is the one that needs the flag the card beside it names.
test_the_config_sample_emits_nix() {
    make_dir(Samples)
    path = join(Samples, "config.maca")
    out = join(Samples, "config.nix")
    write_file(path, sample_source("ConfigSample") ++ "\n")

    assert(try_run(maca(), ["build", "--target", "nix", path, "-o", out]),
           "`--target nix` builds it")
    assert(read_file(out).contains("rigel"), "and the hostname survives")
}

// A `Name = \"\"\"…\"\"\"` constant in the page's source.
sample_source(name: str) -> str =>
    between(read_file("apps/site/home.maca"), name ++ " = \"\"\"", "\"\"\"")

compiles(name: str, src: str) -> bool {
    make_dir(Samples)
    path = join(Samples, name ++ ".maca")
    write_file(path, src)

    try_run(maca(), ["build", path, "-o", join(Samples, name)])
}

run_sample(name: str, src: str) -> str {
    make_dir(Samples)
    path = join(Samples, name ++ ".maca")
    write_file(path, src ++ "\n")

    output(maca(), ["run", path]).trim()
}

// ---- the font ---------------------------------------------------------------
//
// `font-sans` has named Pretendard first for as long as the site has existed
// and no page ever fetched it, so every reader without it installed silently
// got system-ui. On the Korean half of the handbook that is the whole book.
//
// A test that greps a page for "pretendard" would have passed then too, so
// these follow the href instead: to the sheet, and from the sheet to a shard.

Site = "/tmp/maca-sitegen/site"

// The published layout, assembled the way `tools/build-site.maca` assembles
// it: the handbook, then the front page over the landings tomo wrote, then the
// API reference, then the playground, then the fonts. `index.html` at the
// root, `en/`, `api/` and `play/` one level down, `fonts/` beside them.
//
// All four generators, because each writes its own `<head>` and the href is
// relative: what a page needs is not the same string on each level, and one
// directory's worth of `../` is exactly the mistake this catches.
site_dir() -> str {
    remove_dir(Site)
    build_book("apps/tomo", Site)
    run(maca(), ["run", "apps/site/home.maca", Site])
    run(maca(), ["run", "tools/macadoc.maca", join(Site, "api")]
                ++ std_modules())
    build_playground(join(Site, "play"))
    install_fonts(Site)
    Site
}

// The playground, built the way `tools/build-site.maca` builds it, but with a
// stand-in for the compiler it embeds.
//
// `import wasm` names a build artifact under `target/` that the `cargo test`
// job has no reason to have produced, and 1.4 MB of base64 has nothing to do
// with which stylesheet the page links. The path is relative to the source, so
// the source is copied into a tree that has one where it looks. Copied byte
// for byte, not read and rewritten: the js glue separates two strings with a
// literal NUL, and `read_file` stops there.
build_playground(into: str) -> bool {
    root = "/tmp/maca-sitegen/pg"
    src = join(root, "apps/playground/playground.maca")
    stub = join(root, "target/wasm32-unknown-unknown/release/maca_wasm.wasm")

    copy_file("apps/playground/playground.maca", src)
    make_dir(dirname(stub))
    write_file(stub, "not the compiler")

    run(maca(), ["build", "--target", "js", src, "-o", into])
}

// One page per generator, over both levels the site has. A page that names the
// sheet with the wrong number of `../` still contains the word "pretendard";
// it just does not contain the font.
test_every_page_links_a_stylesheet_that_is_there() {
    dir = site_dir()

    assert(font_resolves(dir, "index.html"), "the root page")
    assert(font_resolves(dir, "en/index.html"), "a handbook page")
    assert(font_resolves(dir, "en/home.html"), "a language landing")
    assert(font_resolves(dir, "api/index.html"), "an api page")
    assert(font_resolves(dir, "play/index.html"), "the playground")
}

// Resolve the href the way a browser does: against the page's own directory.
font_resolves(dir: str, page: str) -> bool {
    at = join(dir, page)
    href = stylesheet_href(read_file(at))

    href != "" && file_exists(normalize(join(dirname(at), href)))
}

// The stylesheet a page asks for, however that page spells it.
//
// Four of the five are HTML a generator wrote, so the link is a tag. The
// playground's document belongs to the js back end, which mounts the view into
// an empty body, so the same link arrives as an `_attr` call in the script the
// page carries, with its value in backticks. Either way the href is the thing
// to follow.
stylesheet_href(page: str) -> str {
    if page.contains("rel=\"stylesheet\"") {
        between(split_once(page, "rel=\"stylesheet\"").get(1), "href=\"", "\"")
    } else {
        between(page, "\"href\", `", "`")
    }
}

// The sheet is 92 `@font-face` rules naming 92 files beside it, and a copy
// that brought the 55 KB of rules and none of the files reads as a success.
test_the_sheet_names_shards_that_are_there() {
    sheet = join(site_dir(), "fonts/pretendard.css")
    src = between(read_file(sheet), "src: url(", ")")

    assert(src != "", "the sheet has a src at all")
    assert(file_exists(normalize(join(dirname(sheet), src))),
           "the first shard it names")
}

// The family the sheet defines has to be the family the pages ask for.
//
// `font-sans` asked for `Pretendard`; the sheet declares `Pretendard
// Variable`, which is a different family name and matches nothing. Linking the
// font would have downloaded it and still left every page in system-ui: a fix
// that changes nothing on screen and looks done.
test_the_pages_ask_for_the_family_the_sheet_defines() {
    dir = site_dir()
    family = between(read_file(join(dir, "fonts/pretendard.css")),
                     "font-family: '", "'")

    assert(family != "", "the sheet declares a family")
    assert(read_file(join(dir, "index.html")).contains("'" ++ family ++ "'"),
           "and `font-sans` names it")
}

// ---- the API reference ------------------------------------------------------

api_dir() -> str {
    dir = join(Out, "api")
    remove_dir(dir)
    run(maca(), ["run", "tools/macadoc.maca", dir] ++ std_modules())
    dir
}

// Read from the README's table, the same place `tools/build-site.maca` reads
// it. A second copy here would let the site build and the test that checks it
// disagree about which modules exist.
std_modules() -> str[] =>
    module_paths(read_lines("modules/std/README.md"), 0, [])

module_paths(ls: str[], i: int, acc: str[]) -> str[] {
    if i >= ls.length() {
        acc
    } else if ls.get(i).starts_with("| `std/") {
        name = between(ls.get(i), "| `std/", "`")
        module_paths(ls, i + 1, acc.push("modules/std/" ++ name ++ ".maca"))
    } else {
        module_paths(ls, i + 1, acc)
    }
}

// What MacaDoc lists has to be what `std/README.md` advertises: no more, no
// less. Before `///` marked a doc comment, "any comment above an item" was the
// rule, and it listed nine internal helpers while dropping nine public
// functions. Neither is visible by reading the output; both are visible here.
test_reference_matches_the_advertised_api() {
    dir = api_dir()

    assert_eq(documented(dir, "text"), advertised("text"), "modules/std/text")
    assert_eq(documented(dir, "list"), advertised("list"), "modules/std/list")
    assert_eq(documented(dir, "path"), advertised("path"), "modules/std/path")
    assert_eq(documented(dir, "json"), advertised("json"), "modules/std/json")
    assert_eq(documented(dir, "csv"), advertised("csv"), "modules/std/csv")
    assert_eq(documented(dir, "fs"), advertised("fs"), "modules/std/fs")
    assert_eq(documented(dir, "proc"), advertised("proc"), "modules/std/proc")
}

// Handbook ch. 17 makes four claims about what a doc comment renders as. Each
// one is a line of `tools/macadoc.maca` that can be deleted without the name
// set changing by one character, so each one is executed here.
test_a_doc_comment_renders_as_documented() {
    page = read_file(join(api_dir(), "text.html"))
    doc = article_of(page, "split_once")

    // a backtick span is code, and an HTML metacharacter inside one is escaped
    assert(doc.contains("<code"), "backtick span became code")
    assert(doc.contains("&quot;a=b=c&quot;") || doc.contains("a=b=c"),
           "the span carries its text")
    // a `*starred*` run is emphasis
    assert(doc.contains("<em>first</em>"), "starred run became emphasis")
    // an indented run in the module blurb is a code block, not a sentence
    assert(page.contains("<pre class="), "the blurb's import example is code")
    // and it is code all the way: the same scanner the signature above it went
    // through, so the `import` in it is a keyword and not grey text
    assert(page.contains("<span class=\"tok-kw\">import</span>"),
           "the example is tokenized, not escaped and left alone")
    assert(pre_block(page, 0).contains("text"), "and it kept its text")
}

// The claim the whole page rests on: a code block in a doc body is the same
// language as the signature above it, whatever fence it arrived under.
//
// `docfixture.maca` carries one of each shape. An indented run has nowhere to
// write a tag, a fence names one, and a fence can name one no scanner claims,
// which has to come back as plain escaped text rather than coloured by rules
// written for a different language.
test_a_doc_body_code_block_is_highlighted() {
    doc = article_of(read_file(join(fixture_dir(), "docfixture.html")),
                     "exampled")

    assert(pre_block(doc, 1).contains("<span class=\"tok-ty\">Roomy</span>"),
           "an indented run is read as the language of the file")
    assert(pre_block(doc, 1).contains("<span class=\"tok-str\">&quot;bc&quot;"),
           "and its string is a string")
    assert(pre_block(doc, 2).contains("<span class=\"tok-kw\">done</span>"),
           "a fence is read as the language it names")
    assert(!pre_block(doc, 3).contains("<span class=\"tok-"),
           "a tag no scanner claims stays plain")
    assert(pre_block(doc, 3).contains("a &lt; b"),
           "and arrives escaped rather than as markup")
}

// The hover card is the one thing on the page a reader cannot see in the
// markup, so what is asserted is the data it reads. A cross-linked name says
// which item it names, and the sidebar row for that item carries the signature
// and the sentence the card shows. Break either half and the card comes up
// empty, which looks exactly like a card that never opened.
test_a_cross_linked_name_carries_its_card() {
    page = read_file(join(fixture_dir(), "docfixture.html"))
    sig = sig_of(page, "widen")
    row = row_of(page, "Roomy")

    assert(sig.contains("data-mod=\"docfixture\" data-item=\"Roomy\""),
           "the type in a signature says which item it names")
    assert(row.contains("second: str"), "the row carries the whole signature")
    assert(row.contains("data-brief=\"A record written the usual way.\""),
           "and the sentence the card reads")
    assert(page.contains("id=\"macadoc-card\""),
           "and the card itself is markup, so its classes get rules")
}

// The kind is said twice: as `data-kind`, which is structure, and as the word
// a reader knows it by. Reading the badge's class string instead was a test of
// how the badge is painted, which is not what the badge is for.
test_the_kind_badge_says_what_an_item_is() {
    page = read_file(join(fixture_dir(), "docfixture.html"))

    assert_eq(kinds_of(page), "fn record record sum const fn fn fn fn",
              "each is labelled for what it is")
    assert_eq(badge_word(page, "Roomy"), "record", "a record says so")
    assert_eq(badge_word(page, "Choice"), "sum type", "and a sum type")
    assert_eq(badge_word(page, "widen"), "function", "and a function")
}

// `str[]` in a signature has to survive as text. Deleting `esc` entirely was
// invisible to a test that only compared name sets. A documentation generator
// that stops escaping HTML is the one bug it must not have.
test_signatures_are_escaped() {
    page = read_file(join(api_dir(), "text.html"))

    assert(page.contains("-&gt; str[]"), "the arrow is escaped")
    assert(!page.contains("-> str[]"), "and not left raw")
    assert(sig_of(page, "lines").contains("lines(s: str) -&gt; str[]"),
           "the whole signature is published")
}

sig_of(page: str, name: str) -> str =>
    between(article_of(page, name), "<pre", "</pre>")

// One item's section, and one sidebar row, addressed by name. Every assertion
// below is about one item, and reading the whole page for a fragment of it
// finds the same fragment in the item after it.
article_of(page: str, name: str) -> str =>
    between(page, "<article id=\"" ++ name ++ "\"", "</article>")

row_of(page: str, name: str) -> str =>
    between(page, "<li data-item=\"" ++ name ++ "\"", "</li>")

// The `n`th `<pre>` block of a fragment, contents included. An item's own is
// number 0, so a doc body's first example is number 1.
pre_block(html: str, n: int) -> str =>
    between(html.split("<pre").get(n + 1), ">", "</pre>")

// Every jump link has to land on something. A `#anchor` with no `id` is a
// click that does nothing, and there is one per item on every page.
test_every_jump_link_resolves() {
    page = read_file(join(api_dir(), "list.html"))
    names = ids_after(page.split("<article id=\""), 1, [])

    assert(names.length() > 10, "the page has items at all")
    assert(all_anchored(page, names, 0), "every #anchor has its id")
}

all_anchored(page: str, names: str[], i: int) -> bool {
    if i >= names.length() {
        true
    } else if !page.contains("href=\"#" ++ names.get(i) ++ "\"") {
        false
    } else {
        all_anchored(page, names, i + 1)
    }
}

// A module card carries the first sentence of the blurb. It came out empty for
// any module whose header had no blank line, because `str_find_index` answers
// -1 and `str_take` clamps that to zero.
test_module_cards_say_what_the_module_is() {
    index = read_file(join(api_dir(), "index.html"))

    assert(index.contains("string work that sits one level above"),
           "modules/std/text's blurb")
    assert(index.contains("running other programs"), "modules/std/proc's blurb")
    assert(index.contains("14 items"), "and how many things it documents")
}

// ---- the awkward module -----------------------------------------------------
//
// std is written carefully, so running MacaDoc only on std tests the happy
// path. `docfixture.maca` is written the awkward ways instead. Every shape
// below produced wrong output at some point.

fixture_dir() -> str {
    dir = join(Out, "fixture")
    remove_dir(dir)
    run(maca(), ["run", "tools/macadoc.maca", dir,
                 "crates/driver/tests/programs/docfixture.maca"])
    dir
}

test_four_slashes_are_not_a_doc_comment() {
    page = read_file(join(fixture_dir(), "docfixture.html"))

    assert(!page.contains("undocumented_helper"),
           "a slash rule published a private helper")
    assert(page.contains("wrapped"), "and the real items are still there")
}

// Each of these was published wrong: a signature cut at the first line, a
// one-line record mislabelled `const` with the rest of the file as its body.
test_awkward_declarations_are_read_whole() {
    page = read_file(join(fixture_dir(), "docfixture.html"))

    assert(sig_of(page, "wrapped")
               .contains("wrapped(alpha: int, beta: int) -&gt; int"),
           "a wrapped parameter list is joined back up")
    assert(sig_of(page, "Compact").contains("Compact = \{ a: int, b: int \}"),
           "a one-line record keeps its fields and stops there")
    assert(sig_of(page, "Roomy").contains("second: str"),
           "a multi-line record keeps all of them")
}

// Each item's kind, in page order. Read from `data-kind`, which is what the
// page says an item *is*; the badge's class string, which this read before, is
// what the page says it looks like.
kinds_of(page: str) -> str =>
    tagged(page.split("<span data-kind=\""), 1, []).join(" ")

tagged(parts: str[], i: int, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else {
        tagged(parts, i + 1, acc.push(split_once(parts.get(i), "\"").get(0)))
    }
}

// The word the badge shows, which is the one a reader knows the kind by.
badge_word(page: str, name: str) -> str =>
    split_once(between(article_of(page, name), "<span data-kind=", "</span>"),
               ">").get(1)

// A `*` between spaces is multiplication and a lone backtick is a typo. Both
// used to swallow the rest of the paragraph into `<em>` or `<code>`.
test_stray_markup_stays_text() {
    doc = doc_of(read_file(join(fixture_dir(), "docfixture.html")),
                 "punctuated")

    assert(doc.contains("a * b is a product"), "multiplication is left alone")
    assert(doc.contains("use `foo for that"), "an unclosed backtick too")
    assert(doc.contains("<em>this</em>"), "but real emphasis still renders")
    assert(doc.contains(">this</code>"), "and a real code span")
}

// The one bug a documentation generator must not have.
test_markup_in_a_doc_comment_is_escaped() {
    doc = doc_of(read_file(join(fixture_dir(), "docfixture.html")),
                 "metacharacters")

    assert(doc.contains("&lt;b&gt;"), "a tag arrives as text")
    assert(doc.contains("&amp;amp;"), "and an entity is not decoded")
    assert(!doc.contains("<b>"), "nothing reaches the page as markup")
}

// The blurb here is one paragraph with no blank line, which is what made
// `str_find_index` answer -1 and `str_take` clamp it to an empty card.
test_a_blurb_without_a_blank_line_still_summarises() {
    index = read_file(join(fixture_dir(), "index.html"))

    assert(index.contains("A module written the awkward ways"),
           "the card says what the module is")
}

// Everything after the signature block: the inner `between` has already cut
// the article's own `</article>`, so there is no closing marker left to look
// for: the rest of the body *is* the prose.
doc_of(page: str, name: str) -> str =>
    split_once(between(page, "<article id=\"" ++ name ++ "\"", "</article>"),
               "</pre>").get(1)

// The names MacaDoc gave a page section to, sorted.
documented(dir: str, module: str) -> str =>
    ids(read_file(join(dir, module ++ ".html")).split("<article id=\""), 1, [])
        .sort().join(" ")

ids_after(parts: str[], i: int, acc: str[]) -> str[] =>
    ids(parts, i, acc)

ids(parts: str[], i: int, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else {
        ids(parts, i + 1, acc.push(split_once(parts.get(i), "\"").get(0)))
    }
}

// The names `std/README.md`'s table row for this module puts in backticks.
advertised(module: str) -> str =>
    str_unique(backticked(row_for(module).split("`"), 1, []))
        .sort().join(" ")

backticked(parts: str[], i: int, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else if i % 2 == 0 {
        backticked(parts, i + 1, acc)
    } else {
        backticked(parts, i + 1, acc ++ names_in(parts.get(i)))
    }
}

// A cell names one function (`walk`) or a pair (`strip_prefix`/`strip_suffix`).
// The row's own label is `std/text`, and a cell may be a type like `str[]`.
// Neither of those is an item.
names_in(cell: str) -> str[] {
    if cell.starts_with("std/") {
        []
    } else {
        keep_identifiers(cell.split("/"), 0, [])
    }
}

keep_identifiers(parts: str[], i: int, acc: str[]) -> str[] {
    if i >= parts.length() {
        acc
    } else if is_identifier(parts.get(i).chars(), 0) {
        keep_identifiers(parts, i + 1, acc.push(parts.get(i)))
    } else {
        keep_identifiers(parts, i + 1, acc)
    }
}

is_identifier(cs: str[], i: int) -> bool {
    if cs.length() == 0 {
        false
    } else if i >= cs.length() {
        true
    } else if cs.get(i).is_alpha() || cs.get(i).is_ascii_digit() {
        is_identifier(cs, i + 1)
    } else if cs.get(i) == "_" {
        is_identifier(cs, i + 1)
    } else {
        false
    }
}

row_for(module: str) -> str =>
    matching_row(read_lines("modules/std/README.md"), 0, "| `std/" ++ module ++ "`")

matching_row(ls: str[], i: int, prefix: str) -> str {
    if i >= ls.length() {
        ""
    } else if ls.get(i).starts_with(prefix) {
        ls.get(i)
    } else {
        matching_row(ls, i + 1, prefix)
    }
}

