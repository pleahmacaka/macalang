// A generic function that names its own element type.
//
// `first(xs: a[]) -> a` is the most natural generic signature there is, and
// two things had to be true before it worked. A call has to bind `a` by looking
// *into* the argument's type rather than only at a parameter written as a bare
// variable. And the body has to be lowered knowing what `a` turned out to be,
// or a local declared `a[]` is the fallback array and nothing can be put in it.

Row = { name: str, size: int }

label(r: Row) -> str => r.name

size_key(r: Row) -> str => str(r.size).pad_start(6, "0")

// The shape that needed both fixes: a type variable inside the parameter's
// type, a local of that type, and a function parameter over it.
sort_by(xs: a[], key: (a) -> str) -> a[] {
    ranked: str[] = []
    for x in xs {
        ranked = ranked.push(key(x))
    }
    out: a[] = []
    for want in ranked.sort() {
        out = out.push(pick(xs, key, want, 0))
    }
    out
}

pick(xs: a[], key: (a) -> str, want: str, i: int) -> a {
    if i >= xs.length() {
        xs.get(0)
    } else if key(xs.get(i)) == want {
        xs.get(i)
    } else {
        pick(xs, key, want, i + 1)
    }
}

first_of(xs: a[]) -> a => xs.get(0)

// A local whose type mentions the variable and is a *container* — the pass that
// instantiates array and map types runs long before this is specialized, so the
// C type it names has to be defined late or not at all.
group_pairs(xs: a[]) -> a[][] {
    out: a[][] = []
    for x in xs {
        row: a[] = []
        row = row.push(x)
        out = out.push(row)
    }
    out
}

index_by(xs: a[], key: (a) -> str) -> Map str a {
    m: Map str a = map()
    for x in xs {
        m = m.set(key(x), x)
    }
    m
}

// The same generic at two different return types: the mangled name has to tell
// them apart or the C compiler is handed one symbol with two signatures.
apply_to(x: a, f: (a) -> b) -> b => f(x)

size_of(r: Row) -> int => r.size

count_of(xs: a[]) -> int => xs.length()

pair_up(a: a, b: a) -> a[] => [a, b]

test_a_type_variable_binds_from_inside_a_parameters_type() {
    rows = [Row { name = "c", size = 3 }, Row { name = "a", size = 1 }]

    assert_eq(first_of(rows).name, "c", "the element type came back, not an int")
    assert_eq(str(count_of(rows)), "2", "and the list was read as a list")
}

test_a_generic_local_gets_the_concrete_element_type() {
    rows = [Row { name = "c", size = 3 },
            Row { name = "a", size = 1 },
            Row { name = "b", size = 2 }]
    sorted = sort_by(rows, label)

    assert_eq(sorted.get(0).name, "a", "first by name")
    assert_eq(sorted.get(1).name, "b", "second")
    assert_eq(sorted.get(2).name, "c", "third")
}

test_the_same_function_specialises_per_key() {
    rows = [Row { name = "c", size = 3 },
            Row { name = "a", size = 1 },
            Row { name = "b", size = 2 }]
    by_size = sort_by(rows, size_key)

    assert_eq(str(by_size.get(0).size), "1", "smallest first")
    assert_eq(str(by_size.get(2).size), "3", "largest last")
}

test_a_generic_works_on_a_primitive_too() {
    words = ["pear", "apple"]

    assert_eq(first_of(words), "pear", "a str list")
    assert_eq(first_of([7, 8]), "7", "and an int list")
    assert_eq(pair_up("a", "b").join("-"), "a-b", "two of the same type")
}

test_a_generic_local_may_be_a_container_of_the_element_type() {
    rows = [Row { name = "a", size = 1 }, Row { name = "b", size = 2 }]
    grouped = group_pairs(rows)
    indexed = index_by(rows, label)

    assert_eq(str(grouped.length()), "2", "one row each")
    assert_eq(grouped.get(1).get(0).name, "b", "and the element survived")
    assert_eq(indexed.get("a", Row { name = "?", size = 0 }).name, "a", "keyed by name")
}

// A lambda, not a named function — which is the whole point of taking a key.
test_a_lambda_may_be_passed_where_a_function_type_is_declared() {
    rows = [Row { name = "c", size = 3 }, Row { name = "a", size = 1 }]
    sorted = sort_by(rows, r => r.name)

    assert_eq(sorted.get(0).name, "a", "the lambda read a field, not an address")
    assert_eq(sorted.get(1).name, "c", "and ordered by it")
}

test_one_generic_at_two_return_types_stays_two_functions() {
    r = Row { name = "z", size = 9 }

    assert_eq(apply_to(r, label), "z", "the str instantiation")
    assert_eq(str(apply_to(r, size_of)), "9", "and the int one")
}

main() -> int {
    test_a_generic_local_may_be_a_container_of_the_element_type()
    test_a_lambda_may_be_passed_where_a_function_type_is_declared()
    test_one_generic_at_two_return_types_stays_two_functions()
    test_a_type_variable_binds_from_inside_a_parameters_type()
    test_a_generic_local_gets_the_concrete_element_type()
    test_the_same_function_specialises_per_key()
    test_a_generic_works_on_a_primitive_too()

    failures()
}
