// Control flow that has to survive the trip through a back end.
//
// Every function here puts an `if`, a `match` or a block where a *statement*
// goes, and then does something from inside it that only works if the branch
// is still part of the enclosing function: leaves a loop, skips an iteration,
// or writes a name the function above it owns.
//
// The JS back end used to lower each of those to an IIFE, and both halves of
// that were wrong. `break` and `continue` cannot cross a function boundary, so
// `maca build --target js apps/site/home.maca` emitted an `app.js` that node
// refused to parse, naming `bench/stat`'s `descend`; `isqrt` below is that
// shape. A `var` written inside the IIFE declared a fresh local instead of
// assigning the enclosing one, which is worse: no error, just an answer
// computed from a variable that never changed.
//
// This file is run twice. `crates/driver/tests/js_target.rs` runs it natively,
// which is what makes the answers below the *native* backend's answers rather
// than a guess; `crates/backend_js/tests/control_flow_run.rs` emits it and runs
// the same assertions under node. A back end that disagrees turns one of them
// red.

// ---- leaving a loop from inside a statement-position `if` -----------------

first_over(xs: int[], limit: int) -> int {
    i = 0

    while i < xs.length() {
        if xs.get(i) > limit {
            break
        }
        i = i + 1
    }
    i
}

sum_odd(xs: int[]) -> int {
    i = 0
    total = 0

    while i < xs.length() {
        v = xs.get(i)
        i = i + 1
        if v % 2 == 0 {
            continue
        }
        total = total + v
    }
    total
}

// The shape that found the defect: a search that stops when the next step
// would not improve on the one before it. `bench/stat`'s `descend` is this
// loop, written as Newton's method over floats.
//
// The step here is a multiplication rather than a division on purpose. `int /
// int` truncates natively and does not in JS, which is a real divergence and a
// separate one; a fixture shared by both back ends must not depend on it.
isqrt(v: int) -> int {
    at = 1
    step = 0

    while step < 100 {
        next = at + 1
        if next * next > v {
            break
        }
        at = next
        step = step + 1
    }
    at
}

// ---- the same, in a `for` loop, which the back end has to emit at all -----

count_until(xs: int[], limit: int) -> int {
    seen = 0

    for v in xs {
        if v > limit {
            break
        }
        seen = seen + 1
    }
    seen
}

sum_non_negative(xs: int[]) -> int {
    total = 0

    for v in xs {
        if v < 0 {
            continue
        }
        total = total + v
    }
    total
}

// The loop variable is an ordinary local: a body may write it, and what the
// next pass binds is unaffected.
bump_all(xs: int[]) -> int {
    total = 0

    for v in xs {
        v = v + 1
        total = total + v
    }
    total
}

triangle(n: int) -> int {
    total = 0

    for i in 1..n {
        total = total + i
    }
    total
}

// A `break` leaves the loop it is in and no other.
grid_hits(rows: int) -> int {
    hits = 0

    for r in 1..rows {
        for c in 1..3 {
            if c > r {
                break
            }
            hits = hits + 1
        }
    }
    hits
}

// ---- leaving a loop from inside a statement-position `match` --------------

scan_to_zero(xs: int[]) -> int {
    i = 0

    while i < xs.length() {
        match xs.get(i) {
            0 => { break }
            _ => { i = i + 1 }
        }
    }
    i
}

sum_but_ones(xs: int[]) -> int {
    i = 0
    total = 0

    while i < xs.length() {
        v = xs.get(i)
        i = i + 1
        match v {
            1 => { continue }
            _ => { total = total + v }
        }
    }
    total
}

// An arm that binds a name and then writes it. The binding is the arm's own
// local, so the write is a write and not a second declaration of a name the
// host language has already fixed.
grown(x: int) -> int {
    out = 0

    match x {
        v => {
            v = v + 1
            out = v
        }
    }
    out
}

// A local may be named anything Maca allows, including whatever a back end
// might have picked for its own scrutinee temporary.
odd_name(x: int) -> int {
    out = 0

    match x {
        1 => {
            _s = 41
            out = _s + 1
        }
        _ => { out = 0 }
    }
    out
}

// Two `match`es in one body: neither may answer for the other's scrutinee.
pair_words(a: int, b: int) -> str {
    first = "?"
    second = "?"

    match a {
        1 => { first = "one" }
        _ => { first = "other" }
    }
    match b {
        2 => { second = "two" }
        _ => { second = "other" }
    }
    "{first}+{second}"
}

// A `match` inside another's arm, which is the same question one level down.
nested_word(a: int, b: int) -> str {
    word = "?"

    match a {
        1 => {
            match b {
                2 => { word = "one-two" }
                _ => { word = "one-other" }
            }
        }
        _ => { word = "other" }
    }
    word
}

// ---- writing a name the enclosing function owns ---------------------------

size_of(x: int) -> str {
    tag = "small"

    if x > 10 {
        tag = "big"
    }
    tag
}

band_of(x: int) -> str {
    tag = "?"

    if x > 100 {
        tag = "huge"
    } else if x > 10 {
        tag = "big"
    } else {
        tag = "small"
    }
    tag
}

named(x: int) -> str {
    name = "?"

    match x {
        1 => { name = "one" }
        2 => { name = "two" }
        _ => { name = "many" }
    }
    name
}

// A `match` arm with more than one statement is a block, and a block in
// statement position is the same case again.
step_word(x: int) -> str {
    n = 0
    word = "?"

    match x {
        1 => {
            n = n + 1
            word = "once"
        }
        _ => {
            n = n + 2
            word = "twice"
        }
    }
    "{word}:{n}"
}

// ---- `if` is still an expression ------------------------------------------

// The value of the chosen branch is the value of the `if`, and a branch that
// also writes an enclosing local does both.
report(x: int) -> str {
    seen = "no"

    word = if x > 0 {
        seen = "yes"
        "positive"
    } else {
        "negative"
    }
    seen ++ "/" ++ word
}

// An `if` as the whole body: the branch's value is what the function returns.
sign_word(x: int) -> str {
    if x > 0 {
        "positive"
    } else if x < 0 {
        "negative"
    } else {
        "zero"
    }
}

// A `match` in value position, bound to a name.
roman(x: int) -> str {
    word = match x {
        1 => "i"
        2 => "ii"
        _ => "many"
    }
    word ++ "!"
}

// ---- the assertions -------------------------------------------------------

test_break_leaves_the_loop_from_inside_an_if() {
    assert_eq(first_over([1, 2, 30, 4], 10), 2, "stops at the first over")
    assert_eq(first_over([1, 2, 3], 10), 3, "runs to the end when none is")
}

test_continue_skips_the_rest_of_the_iteration() {
    assert_eq(sum_odd([1, 2, 3, 4, 5]), 9, "the evens are skipped")
    assert_eq(sum_odd([2, 4]), 0, "every one skipped")
}

test_a_descent_stops_when_it_stops_improving() {
    assert_eq(isqrt(81), 9, "an exact square")
    assert_eq(isqrt(1), 1, "the first guess is already the answer")
    assert_eq(isqrt(50), 7, "the integer root below")
}

test_a_for_loop_runs_its_body() {
    assert_eq(triangle(4), 10, "1 + 2 + 3 + 4")
    assert_eq(triangle(1), 1, "one pass")
    assert_eq(bump_all([1, 2]), 5, "the loop variable is writable")
}

test_break_and_continue_work_in_a_for_loop() {
    assert_eq(count_until([1, 2, 30, 4], 10), 2, "counts up to the break")
    assert_eq(sum_non_negative([1, -5, 2, -1, 3]), 6, "the negatives skipped")
}

test_break_leaves_only_the_loop_it_is_in() {
    assert_eq(grid_hits(3), 6, "the outer loop keeps going")
}

test_break_and_continue_work_from_a_match_arm() {
    assert_eq(scan_to_zero([3, 4, 0, 5]), 2, "stops at the zero")
    assert_eq(scan_to_zero([3, 4]), 2, "no zero to stop at")
    assert_eq(sum_but_ones([1, 2, 1, 3]), 5, "the ones are skipped")
}

test_an_arm_may_write_the_name_its_pattern_bound() {
    assert_eq(grown(5), 6, "the binding is a local, not a fixed name")
    assert_eq(odd_name(1), 42, "a local named like a temporary is still a local")
    assert_eq(odd_name(2), 0, "and the other arm still runs")
}

test_two_matches_in_one_body_keep_their_own_scrutinee() {
    assert_eq(pair_words(1, 2), "one+two", "both arms hit")
    assert_eq(pair_words(2, 1), "other+other", "neither does")
    assert_eq(nested_word(1, 2), "one-two", "the inner match decides")
    assert_eq(nested_word(1, 9), "one-other", "its other arm")
    assert_eq(nested_word(9, 2), "other", "the outer match decides")
}

test_a_branch_writes_the_name_the_function_above_it_owns() {
    assert_eq(size_of(20), "big", "the branch taken")
    assert_eq(size_of(2), "small", "the branch not taken")
    assert_eq(band_of(200), "huge", "the first arm of the chain")
    assert_eq(band_of(20), "big", "the middle arm")
    assert_eq(band_of(2), "small", "the last arm")
    assert_eq(named(1), "one", "a match arm writes it too")
    assert_eq(named(2), "two", "a later arm")
    assert_eq(named(9), "many", "the wildcard")
    assert_eq(step_word(1), "once:1", "a multi-statement arm is a block")
    assert_eq(step_word(9), "twice:2", "its other arm")
}

test_an_if_is_still_a_value() {
    assert_eq(report(3), "yes/positive", "the branch's value and its effect")
    assert_eq(report(0 - 3), "no/negative", "the other branch")
    assert_eq(sign_word(5), "positive", "an if as the whole body")
    assert_eq(sign_word(0 - 5), "negative", "the middle arm")
    assert_eq(sign_word(0), "zero", "the last arm")
    assert_eq(roman(2), "ii!", "a match in value position")
    assert_eq(roman(7), "many!", "its wildcard")
}

main() -> int => 0
