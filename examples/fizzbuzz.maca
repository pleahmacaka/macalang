code(n: int) -> int {
    by3 = n % 3 == 0
    by5 = n % 5 == 0
    if by3 {
        if by5 {
            3
        } else {
            1
        }
    } else {
        if by5 {
            2
        } else {
            0
        }
    }
}

run(upto: int) -> int {
    hits = 0
    i = 1
    while i <= upto {
        if code(i) > 0 {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

main() -> int {
    info("{run(15)}")
    0
}
