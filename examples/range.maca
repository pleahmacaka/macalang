// Inclusive integer ranges: `lo..hi` counts lo, lo+1, …, hi (both ends).
main() -> int {
    let sum = 0
    for i in 1..100 {
        sum = sum + i
    }
    info("sum 1..100 = {sum}")

    // ranges are `int[]` values too — usable anywhere a list is
    let xs = 1..5
    info("1..5 has {len(xs)} elements, last {xs[len(xs) - 1]}")
    0
}
