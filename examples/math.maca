main() -> int {
    info("sqrt(144)={sqrt(144.0)} floor(3.9)={floor(3.9)} ceil(3.1)={ceil(3.1)}")
    info("pow(2,10)={pow(2.0, 10.0)} round(2.5)={round(2.5)}")

    a = 0 - 7
    info("abs={abs(a)} sign={sign(a)}")
    info("min={min(4, 9)} max={max(4, 9)} clamp={clamp(42, 0, 10)}")
    info("gcd(54,24)={gcd(54, 24)}")
    0
}
