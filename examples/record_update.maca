// Functional record update: `base with { field = value }` yields a copy of the
// record with the named fields overwritten; the original binding is unchanged.

Config = {
    host: str
    port: int
    tls: bool
}

with_port(c: Config, p: int) -> Config => c with { port = p }

main() -> int {
    let base = Config { host = "localhost", port = 80, tls = false }
    let secure = base with { port = 443, tls = true }
    let moved = with_port(base, 8080)
    info("{base.host}:{base.port} tls={base.tls}")
    info("{secure.host}:{secure.port} tls={secure.tls}")
    info("{moved.host}:{moved.port} tls={moved.tls}")
    0
}
