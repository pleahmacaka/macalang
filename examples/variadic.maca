total(...rest: int) -> int {
    n = 0
    for v in rest {
        n = n + v
    }
    n
}

labelled(name: str, ...rest: int) -> str {
    n = 0
    for v in rest {
        n = n + v
    }
    "{name}={n}"
}

main() -> int {
    info("{total()}")
    info("{total(1, 2, 3)}")
    info("{labelled("sum", 4, 5)}")
    0
}
