// List and string subscripting with `xs[i]`, plus element and field
// assignment through an lvalue (`xs[i] = v`, `p.field = v`).

Point = {
    x: int
    y: int
}

main() -> int {
    let xs = 10, 20, 30
    info("{xs[0]} {xs[2]}")
    info("{len(xs)}")

    let s = "maca"
    info(s[0])
    info("{len(s)}")

    xs[1] = 99
    info("{xs[1]}")

    let p = Point { x = 1, y = 2 }
    p.x = 42
    info("{p.x} {p.y}")
    0
}
